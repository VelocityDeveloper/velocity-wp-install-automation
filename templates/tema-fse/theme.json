{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "primary", "color": "#1f2a44", "name": "Utama" },
				{ "slug": "primary-gelap", "color": "#141c2e", "name": "Utama gelap" },
				{ "slug": "aksen", "color": "#f59e0b", "name": "Aksen" },
				{ "slug": "aksen-teks", "color": "#a15c00", "name": "Aksen untuk teks" },
				{ "slug": "aksen-di-primary", "color": "#f59e0b", "name": "Aksen di atas warna utama" },
				{ "slug": "di-primary", "color": "#ffffff", "name": "Teks di atas warna utama" },
				{ "slug": "di-aksen", "color": "#14171f", "name": "Teks di atas aksen" },
				{ "slug": "ink", "color": "#14171f", "name": "Judul" },
				{ "slug": "teks", "color": "#454b57", "name": "Teks" },
				{ "slug": "abu", "color": "#5f6570", "name": "Teks redup" },
				{ "slug": "latar", "color": "#f7f8fa", "name": "Latar abu" },
				{ "slug": "garis", "color": "#e3e6ec", "name": "Garis" },
				{ "slug": "putih", "color": "#ffffff", "name": "Putih" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"name": "Plus Jakarta Sans",
					"slug": "jakarta",
					"fontFamily": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-normal.woff2" ]
						},
						{
							"fontFamily": "Plus Jakarta Sans",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/plus-jakarta-sans-italic.woff2" ]
						}
					]
				},
				{
					"name": "Outfit",
					"slug": "outfit",
					"fontFamily": "Outfit, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Outfit",
							"fontStyle": "normal",
							"fontWeight": "300 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/outfit-normal.woff2" ]
						}
					]
				},
				{
					"name": "Montserrat",
					"slug": "montserrat",
					"fontFamily": "Montserrat, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/montserrat-normal.woff2" ]
						}
					]
				},
				{
					"name": "PT Serif",
					"slug": "pt-serif",
					"fontFamily": "\"PT Serif\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "PT Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-serif-400.woff2" ]
						},
						{
							"fontFamily": "PT Serif",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-serif-700.woff2" ]
						},
						{
							"fontFamily": "PT Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/pt-serif-italic-400.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "kecil", "size": "0.875rem", "name": "Kecil", "fluid": false },
				{ "slug": "normal", "size": "1rem", "name": "Normal", "fluid": false },
				{ "slug": "sedang", "size": "1.2rem", "name": "Sedang", "fluid": { "min": "1.1rem", "max": "1.25rem" } },
				{ "slug": "besar", "size": "1.6rem", "name": "Besar", "fluid": { "min": "1.35rem", "max": "1.75rem" } },
				{ "slug": "judul", "size": "2.1rem", "name": "Judul seksi", "fluid": { "min": "1.6rem", "max": "2.25rem" } },
				{ "slug": "raksasa", "size": "3rem", "name": "Judul besar", "fluid": { "min": "2rem", "max": "3.2rem" } }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "size": "0.5rem", "name": "1" },
				{ "slug": "30", "size": "1rem", "name": "2" },
				{ "slug": "40", "size": "1.5rem", "name": "3" },
				{ "slug": "50", "size": "clamp(2rem, 4vw, 2.5rem)", "name": "4" },
				{ "slug": "60", "size": "clamp(2.5rem, 6vw, 4rem)", "name": "5" },
				{ "slug": "70", "size": "clamp(3.5rem, 8vw, 5.5rem)", "name": "6" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|putih",
			"text": "var:preset|color|teks"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|jakarta",
			"fontSize": "var:preset|font-size|normal",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": { "left": "1.25rem", "right": "1.25rem" }
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|primary" },
				":hover": { "color": { "text": "var:preset|color|aksen-teks" } }
			},
			"heading": {
				"color": { "text": "var:preset|color|ink" },
				"typography": { "fontWeight": "800", "lineHeight": "1.3" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|raksasa" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|judul" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|besar" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|sedang" } },
			"button": {
				"color": { "background": "var:preset|color|aksen", "text": "var:preset|color|di-aksen" },
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "800", "fontSize": "var:preset|font-size|normal" },
				"spacing": { "padding": { "top": "0.7rem", "bottom": "0.7rem", "left": "1.5rem", "right": "1.5rem" } },
				":hover": { "color": { "background": "var:preset|color|primary-gelap", "text": "var:preset|color|di-primary" } }
			}
		},
		"blocks": {
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var:preset|color|ink" },
						":hover": { "color": { "text": "var:preset|color|aksen-teks" } }
					}
				}
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|abu" }
			},
			"core/navigation": {
				"typography": { "fontSize": "0.98rem", "fontWeight": "600" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" },
		{ "name": "sidebar", "title": "Kolom Samping", "area": "uncategorized" }
	],
	"customTemplates": [
		{ "name": "halaman-lebar", "title": "Halaman lebar (tanpa judul)", "postTypes": [ "page" ] }
	]
}
