{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "velocity/simulasi-kredit",
	"title": "Simulasi Kredit",
	"category": "widgets",
	"icon": "calculator",
	"description": "Hitung estimasi cicilan: pilih unit, uang muka, tenor, dan bunga. Hasilnya dihitung di peramban pengunjung.",
	"attributes": {
		"bunga": {
			"type": "number",
			"default": 6
		},
		"dp": {
			"type": "number",
			"default": 20
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorScript": "velocity-fse-blok",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
