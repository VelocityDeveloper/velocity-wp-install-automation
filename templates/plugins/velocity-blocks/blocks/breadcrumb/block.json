{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "vb/breadcrumb",
 "title": "Remah Halaman",
 "category": "velocity-blocks",
 "icon": "arrow-right-alt2",
 "description": "Jejak halaman: Beranda › halaman induk › halaman ini. Terisi otomatis.",
