{
 "$schema": "https://schemas.wp.org/trunk/block.json",
 "apiVersion": 3,
 "name": "vb/card",
 "title": "Kartu Gambar",
 "category": "velocity-blocks",
 "icon": "format-image",
 "description": "Foto + judul + teks + tautan.",
 "attributes": {
  "imageUrl": {
   "type": "string",
   "default": ""
  },
  "imageId": {
   "type": "number",
   "default": 0
  },
  "title": {
   "type": "string",
   "default": "Card title"
  },
  "text": {
   "type": "string",
   "default": ""
  },
  "url": {
   "type": "string",
   "default": ""
  },
  "newTab": {
   "type": "boolean",
   "default": false
  },
  "linkLabel": {
   "type": "string",
   "default": ""
  },
  "ratio": {
   "type": "string",
   "default": "4/3"
  },
  "cardStyle": {
   "type": "string",
   "default": "below"
  }
 },
 "supports": {
  "anchor": true,
  "html": false
 },
 "textdomain": "velocity-blocks",
 "editorScript": "vb-editor",
 "editorStyle": "vb-editor",
 "style": "vb-blok",
 "render": "file:./render.php"
}