# Tujuan produksi untuk /root/{{SLUG}}/deploy-prod.sh. Isi sebelum deploy pertama.
# Server harus sudah punya: PHP sesuai composer.json, database + .env produksi di PROD_PATH/shared/.env.
PROD_DOMAIN={{DOMAIN}}
PROD_SSH=            # mis. user@1.2.3.4
PROD_PORT=22
PROD_PATH=           # mis. /home/user/app  (document root domain diarahkan ke PROD_PATH/current/public)
PROD_PHP=php         # binari PHP di server (mis. /usr/local/bin/php83 atau ea-php83)
