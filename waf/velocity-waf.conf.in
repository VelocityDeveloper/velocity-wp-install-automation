# Velocity WAF — ruleset ModSecurity pengganti aturan cPGuard/Malware.Expert di server hosting.
# DIBUAT OTOMATIS oleh scripts/velocity-waf-build dari waf/velocity-waf.conf.in — jangan disunting di server.
# Mode: @MODE@   (deteksi = hanya dicatat sebagai "ModSecurity: Warning"; blokir = request ditolak)
# Versi: @VERSI@
#
# ID 7700000–7709999, tag 'velocity-waf'. Berkas data di @DIR@/. Pengecualian IP: ip-putih.txt.
# Log: error log LiteSpeed (dibaca halaman Server > Proteksi > WAF), audit log tidak dipakai (noauditlog).

# ---- 0. IP tepercaya: lewati semua aturan Velocity ----
SecRule REMOTE_ADDR "@ipMatchFromFile @DIR@/ip-putih.txt" \
    "id:7700001,phase:1,pass,nolog,t:none,ctl:ruleRemoveByTag=velocity-waf"

# ---- 1. Bot & crawler (User-Agent) ----
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-jahat.txt" \
    "id:7700101,phase:1,t:none,t:lowercase,@AKSI429@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Scanner/bot jahat'"
@SEO@SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-seo.txt" \
@SEO@    "id:7700102,phase:1,t:none,t:lowercase,@AKSI429@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Crawler SEO'"
# Scraper tanpa nama lewat proxy residensial (UA persis ini, ±2 hit per IP). Aturan terpisah (bukan bot-seo.txt, lihat
# catatan di sana) dan nolog: tak dihitung BFM agar IP rumahan/CGNAT pengunjung asli tak ikut diblokir CSF.
@SEO@SecRule REQUEST_HEADERS:User-Agent "@streq mozilla/5.0 (compatible; crawler)" \
@SEO@    "id:7700109,phase:1,t:none,t:lowercase,@AKSI429@,nolog,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Scraper UA generik (compatible; crawler)'"
# Crawler AI Meta: IP-nya dipakai bersama facebookexternalhit (pratinjau link FB/WA) → hanya ditolak di WAF,
# id terpisah agar tidak dihitung Brute Force (blokir IP CSF akan mematikan pratinjau share).
@AI@SecRule REQUEST_HEADERS:User-Agent "@contains meta-externalagent" \
@AI@    "id:7700107,phase:1,t:none,t:lowercase,@AKSI429@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Crawler AI Meta (tanpa blokir IP)'"
@AI@SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-ai.txt" \
@AI@    "id:7700103,phase:1,t:none,t:lowercase,@AKSI429@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Crawler AI'"
# Bot AI pencarian PALSU: UA ChatGPT-User/OAI-SearchBot/PerplexityBot dari IP di luar daftar resmi (probe .env dsb.).
# Sebelum 7700104 supaya tetap ditolak walau bot AI pencarian asli hanya dicatat. Daftar: scripts/velocity-waf-ip-ai.
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-ai-pencarian.txt" \
    "id:7700106,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Bot AI pencarian palsu (IP bukan milik OpenAI/Perplexity)',chain"
    SecRule REMOTE_ADDR "!@ipMatchFromFile @DIR@/ip-ai-pencarian.txt" "t:none"
# Bot AI pencarian asli tak butuh REST API/oEmbed (±1.300 request PHP/hari di detikperkara) → ditolak tanpa log:
# nolog agar tak dihitung BFM (IP OpenAI dipakai juga untuk ChatGPT-User membuka halaman) dan tak meramaikan log.
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-ai-pencarian.txt" \
    "id:7700108,phase:1,t:none,t:lowercase,@AKSI403@,nolog,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Bot AI pencarian ke REST API/oEmbed (tanpa log)',chain"
    SecRule REQUEST_FILENAME "@beginsWith /wp-json/" "t:none,t:lowercase"
# Mode catat: lolos tanpa log (request sah, hanya meramaikan log); mode blokir: ditolak dan dicatat.
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/bot-ai-pencarian.txt" \
    "id:7700104,phase:1,t:none,t:lowercase,@AKSIAICARI@,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Bot AI pencarian'"
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/klien-skrip.txt" \
    "id:7700105,phase:1,t:none,t:lowercase,pass,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Klien HTTP skrip (dicatat)'"

# PHP tanpa User-Agent (probe webshell/brute force otomatis; cron WordPress & curl/wget tetap mengirim UA)
SecRule REQUEST_FILENAME "@rx \.php$" \
    "id:7700110,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Akses PHP tanpa User-Agent',chain"
    SecRule &REQUEST_HEADERS:User-Agent "@eq 0" "t:none"
SecRule REQUEST_HEADERS:User-Agent "@rx ^\s*$" \
    "id:7700111,phase:1,t:none,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Akses PHP dengan User-Agent kosong',chain"
    SecRule REQUEST_FILENAME "@rx \.php$" "t:none,t:lowercase"
# Klien skrip (Go-http-client dkk.) ke berkas PHP selain titik masuk WordPress = probe webshell/brute force
# (136.80.167.62 18 Okt: 3.040 request/75 dtk ke 64 domain di Farnaz). Callback sah (Duitku dkk.) lewat /wp-json/
# atau index.php/admin-ajax.php, jadi tetap lolos. Tag eksploit → dihitung BFM (blokir IP).
SecRule REQUEST_HEADERS:User-Agent "@pmFromFile @DIR@/klien-skrip.txt" \
    "id:7700112,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Klien skrip ke berkas PHP non-WordPress (probe webshell)',chain"
    SecRule REQUEST_FILENAME "@rx \.php$" "t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,chain"
    SecRule REQUEST_FILENAME "!@rx /(?:index|wp-cron|xmlrpc|admin-ajax)\.php$" "t:none,t:urlDecodeUni,t:normalizePath,t:lowercase"

# ---- 2. Berkas sensitif & probe ----
SecRule REQUEST_FILENAME "@rx (?:^|/)\.(?:env(?:\.[\w.-]*)?|git|svn|hg|bzr|aws|ssh|docker|npmrc|bash_history|htpasswd|ds_store)(?:/|$)" \
    "id:7700201,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Akses berkas tersembunyi/rahasia (.env, .git, dll.)'"
SecRule REQUEST_FILENAME "@rx /wp-config\.(?:php[\w.~-]+|php|bak|old|orig|save|txt|swp|zip)$" \
    "id:7700202,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Akses langsung wp-config / salinannya'"
SecRule REQUEST_FILENAME "@rx (?:\.(?:sql|sql\.gz|sql\.zip|mysql|bak|old|swp|save)|/(?:phpinfo|php_info)\.php|/vendor/phpunit/.*eval-stdin\.php|/(?:adminer|phpminiadmin)\.php|/wp-content/debug\.log)$" \
    "id:7700203,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Akses dump database/berkas cadangan/alat debug'"

# PHP dijalankan dari folder unggahan / berkas PHP tersembunyi (ciri webshell)
SecRule REQUEST_FILENAME "@rx /wp-content/uploads/.*\.(?:php\d?|phtml|phar|pht|shtml)$" \
    "id:7700210,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Menjalankan PHP di wp-content/uploads'"
# Folder cache plugin & upgrade WordPress tak pernah berisi PHP yang dipanggil langsung (webshell Podlove, a4tech.php dkk.)
SecRule REQUEST_FILENAME "@rx /wp-content/(?:cache|upgrade|upgrade-temp-backup)/.*\.(?:php\d?|phtml|phar|pht|shtml)$" \
    "id:7700213,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Menjalankan PHP di wp-content/cache atau upgrade'"
# Eksploit Podlove Podcast Publisher image cache (unduh berkas PHP dari URL luar)
SecRule ARGS_NAMES "@streq podlove_image_cache_url" \
    "id:7700214,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Eksploit Podlove image cache'"
SecRule REQUEST_FILENAME "@rx /\.[^/]+\.php\d?$" \
    "id:7700211,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Berkas PHP tersembunyi'"
# URL berisi /wp-content/uploads/ ≥3 kali (scraper rusak membaca srcset)
SecRule REQUEST_URI "@rx (?:/wp-content/uploads/.*?){3,}" \
    "id:7700212,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - URL berisi banyak /wp-content/uploads/ (scraper rusak)'"
# /<tahun>/<bln>/<tgl>/<slug>/page/N = halaman artikel yang tak ada (WordPress tetap menjawab 200 + query berat);
# (+ /page/N/tel:… dari tautan relatif) botnet IP residensial memutar N ribuan (sepindonesia 19 Okt: 62 rb/hari, 7 rb IP). Dikecualikan BFM: IP-nya bisa dipakai pengunjung asli.
SecRule REQUEST_FILENAME "@rx ^/\d{4}/\d{2}/\d{2}/[^/]+/page/\d+(?:/.*)?$" \
    "id:7700215,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI410@,log,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Halaman /page/N di artikel (tidak ada)'"
# REST API konten/oEmbed dari UA browser TANPA Referer, tanpa login/Authorization = scraper (20 Okt Wulan: beritanew,
# pintas1, timesmuba… ±7,6 rb/hari, IP Tencent/BytePlus/Alibaba + proxy residensial, 1 request/IP, UA Chrome berputar).
# Browser asli memanggil REST dari halaman (ada Referer); klien sah (oEmbed WordPress, aplikasi, Discord) ber-UA non-browser.
# nolog: tak dihitung BFM agar IP residensial pengunjung asli tak diblokir CSF (hasil terlihat sebagai 403 di access log).
SecRule REQUEST_FILENAME "@rx ^/wp-json/(?:wp/v2/(?:posts|pages|users|media|categories|tags|comments|search)|oembed/)" \
    "id:7700216,phase:1,t:none,t:urlDecodeUni,t:normalizePath,t:lowercase,@AKSI403@,nolog,noauditlog,tag:'velocity-waf',tag:'bot',msg:'Velocity WAF - Scraper REST API/oEmbed (UA browser tanpa Referer)',chain"
    SecRule &REQUEST_HEADERS:Referer "@eq 0" "t:none,chain"
    SecRule REQUEST_HEADERS:User-Agent "@rx (?:chrome|firefox|safari)/" "t:none,t:lowercase,chain"
    SecRule REQUEST_HEADERS:User-Agent "!@rx bot|crawl|spider|compatible;" "t:none,t:lowercase,chain"
    SecRule &REQUEST_HEADERS:Authorization "@eq 0" "t:none,chain"
    SecRule &REQUEST_COOKIES_NAMES:/^wordpress_logged_in/ "@eq 0" "t:none"

# ---- 3. Traversal, wrapper PHP, null byte ----
SecRule REQUEST_URI_RAW "@rx %00" \
    "id:7700301,phase:1,t:none,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Null byte di URL'"
SecRule REQUEST_URI|ARGS "@rx (?:\.\./){2,}|/etc/(?:passwd|shadow|group)\b|(?:php|phar|zip|expect|glob|file)://" \
    "id:7700302,phase:2,t:none,t:urlDecodeUni,t:replaceComments,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Path traversal / wrapper PHP',chain"
    SecRule REQUEST_FILENAME "!@beginsWith /wp-admin/" "t:none,t:lowercase"

# ---- 4. Enumerasi user WordPress (tanpa login) ----
SecRule ARGS_GET:author "@rx ^\d+$" \
    "id:7700401,phase:1,t:none,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Enumerasi user WordPress (?author=)',chain"
    SecRule &REQUEST_COOKIES_NAMES:/^wordpress_logged_in/ "@eq 0" "t:none"

# ---- 5. Rate limit per IP: xmlrpc.php & wp-login.php (brute force) ----
SecAction "id:7700500,phase:1,pass,nolog,t:none,initcol:ip=%{REMOTE_ADDR}"
# Blokir hanya di berkas yang disalahgunakan (bukan seluruh situs): banyak pengunjung sah berbagi IP (CGNAT seluler)
SecRule IP:VW_XMLRPC_BLOK "@eq 1" \
    "id:7700501,phase:1,t:none,@AKSI406@,log,noauditlog,tag:'velocity-waf',tag:'ddos',msg:'Velocity WAF - Rate limit xmlrpc.php (brute force)',chain"
    SecRule REQUEST_FILENAME "@endsWith /xmlrpc.php" "t:none,t:lowercase"
SecRule REQUEST_FILENAME "@endsWith /xmlrpc.php" \
    "id:7700502,phase:1,pass,nolog,t:none,t:lowercase,chain"
    SecRule REQUEST_METHOD "@streq POST" "t:none,setvar:ip.vw_xmlrpc=+1,expirevar:ip.vw_xmlrpc=60"
SecRule IP:VW_XMLRPC "@gt @XMLRPC_MAKS@" \
    "id:7700503,phase:1,pass,nolog,t:none,setvar:ip.vw_xmlrpc_blok=1,expirevar:ip.vw_xmlrpc_blok=600"
# system.multicall = ratusan tebakan password dalam satu request, lolos rate limit per IP. Klien sah (Jetpack dari
# WordPress.com, aplikasi WP) memanggil metode tunggal, jadi ditolak di semua mode tanpa ambang.
# REQUEST_BODY hanya terisi lewat prosesor URLENCODED (bukan untuk text/xml), maka prosesor dipaksa di xmlrpc saja.
SecRule REQUEST_FILENAME "@endsWith /xmlrpc.php" \
    "id:7700504,phase:1,pass,nolog,t:none,t:lowercase,ctl:requestBodyProcessor=URLENCODED"
SecRule REQUEST_FILENAME "@endsWith /xmlrpc.php" \
    "id:7700505,phase:2,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - xmlrpc system.multicall (brute force massal)',chain"
    SecRule REQUEST_BODY "@rx <methodname>\s*system\.multicall\s*</methodname>" "t:none,t:lowercase"
# POST xmlrpc hanya dari Jetpack asli (IP Automattic 192.0.64.0/18); IP kantor lewat ip-putih. Botnet ber-UA Jetpack
# palsu dari ratusan IP seluler (±2/mnt per IP, di bawah rate limit) = ±10 rb/jam di Farnaz 17 Okt, 0 dari Automattic.
# Id 77005xx → BFM kategori login (blokir IP 1 jam). Aplikasi WP mobile/posting jarak jauh ikut ditolak.
SecRule REQUEST_FILENAME "@endsWith /xmlrpc.php" \
    "id:7700506,phase:1,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'ddos',msg:'Velocity WAF - xmlrpc POST bukan dari Jetpack (Automattic)',chain"
    SecRule REQUEST_METHOD "@streq POST" "t:none,chain"
    SecRule REMOTE_ADDR "!@ipMatch 192.0.64.0/18" "t:none"
SecRule IP:VW_LOGIN_BLOK "@eq 1" \
    "id:7700511,phase:1,t:none,@AKSI406@,log,noauditlog,tag:'velocity-waf',tag:'ddos',msg:'Velocity WAF - Rate limit wp-login.php (brute force)',chain"
    SecRule REQUEST_FILENAME "@endsWith /wp-login.php" "t:none,t:lowercase"
SecRule REQUEST_FILENAME "@endsWith /wp-login.php" \
    "id:7700512,phase:1,pass,nolog,t:none,t:lowercase,chain"
    SecRule REQUEST_METHOD "@streq POST" "t:none,setvar:ip.vw_login=+1,expirevar:ip.vw_login=300"
SecRule IP:VW_LOGIN "@gt @LOGIN_MAKS@" \
    "id:7700513,phase:1,pass,nolog,t:none,setvar:ip.vw_login_blok=1,expirevar:ip.vw_login_blok=900"

# ---- 6. Injeksi (HANYA DICATAT di kedua mode; dinilai dulu sebelum dipakai memblokir) ----
SecRule ARGS|REQUEST_URI "@rx \bunion\b[\s/*()]+(?:all[\s/*()]+)?select\b|\binformation_schema\b|\bsleep\s*\(\s*\d|\bbenchmark\s*\(|\bwaitfor\s+delay\b|\b(?:extractvalue|updatexml)\s*\(" \
    "id:7700601,phase:2,t:none,t:urlDecodeUni,t:replaceComments,t:compressWhitespace,t:lowercase,pass,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Indikasi SQL injection (dicatat)',chain"
    SecRule REQUEST_FILENAME "!@beginsWith /wp-admin/" "t:none,t:lowercase"
SecRule ARGS_GET|REQUEST_URI "@rx <script[\s>/]|javascript:|\bon(?:error|load|mouseover|focus)\s*=" \
    "id:7700602,phase:2,t:none,t:urlDecodeUni,t:htmlEntityDecode,t:lowercase,pass,log,noauditlog,tag:'velocity-waf',tag:'eksploit',msg:'Velocity WAF - Indikasi XSS (dicatat)',chain"
    SecRule REQUEST_FILENAME "!@beginsWith /wp-admin/" "t:none,t:lowercase"

# ---- 7. Spam judi online ----
# Tidak dihitung Brute Force (server_bfm_agent): Googlebot ikut mengakses link spam ?s=slot+gacor.
SecRule ARGS_GET "@rx (?:slot\s*(?:gacor|online|88|777|thailand|dana|pulsa|zeus)|situs\s*(?:slot|judi|toto|togel)|togel\s*online|judi\s*slot|maxwin|scatter\s*hitam|rtp\s*(?:live|slot)|bandar\s*(?:togel|slot|judi)|toto\s*(?:togel|macau|slot)|sbobet|mahjong\s*ways|bocoran\s*(?:slot|rtp)|pola\s*gacor|agen\s*(?:slot|judi|togel)|pkv\s*games)" \
    "id:7700701,phase:1,t:none,t:urlDecodeUni,t:compressWhitespace,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'judi',msg:'Velocity WAF - Spam judi online di URL (?s= / parameter)'"
SecRule REQUEST_FILENAME "@endsWith /wp-comments-post.php" \
    "id:7700702,phase:2,t:none,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'judi',msg:'Velocity WAF - Komentar spam judi online',chain"
    SecRule ARGS_POST:comment|ARGS_POST:url|ARGS_POST:author "@rx (?:slot\s*(?:gacor|online|88|777|thailand|dana|pulsa|zeus)|situs\s*(?:slot|judi|toto|togel)|togel\s*online|judi\s*(?:online|slot|bola)|maxwin|scatter\s*hitam|rtp\s*(?:live|slot)|bandar\s*(?:togel|slot|judi)|toto\s*(?:togel|macau|slot)|sbobet|mahjong\s*ways|bocoran\s*(?:slot|rtp)|pola\s*gacor|agen\s*(?:slot|judi|togel)|pkv\s*games)" \
        "t:none,t:urlDecodeUni,t:htmlEntityDecode,t:compressWhitespace,t:lowercase"
SecRule ARGS_POST:newcontent "@rx (?:slot\s*gacor|situs\s*(?:slot|judi|toto|togel)|togel\s*online|maxwin|scatter\s*hitam|rtp\s*(?:live|slot)|sbobet|mahjong\s*ways|pola\s*gacor|pkv\s*games)" \
    "id:7700703,phase:2,t:none,t:htmlEntityDecode,t:compressWhitespace,t:lowercase,@AKSI403@,log,noauditlog,tag:'velocity-waf',tag:'judi',msg:'Velocity WAF - Sisipan judi lewat editor berkas tema/plugin'"
