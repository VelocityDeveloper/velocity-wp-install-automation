[Unit]
Description=Sync Google Drive On Progress (%i)
After=network-online.target installer-status.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/velocity-wp-install-automation/scripts/onprogress-sync
Nice=10
IOSchedulingClass=idle
# Hanya folder antrean installer, biasanya beberapa menit. Batas ini mencegah
# proses menggantung selamanya kalau Drive macet.
TimeoutStartSec=1h
