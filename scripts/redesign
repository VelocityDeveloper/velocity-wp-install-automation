        'post_name' => $p['slug'], 'post_content' => $ganti($p['isi']), 'post_date' => $p['tanggal'],
        'post_category' => $kats)), true);
    if (is_wp_error($id)) { $hasil['gagal'][] = 'post:' . $p['slug']; continue; }
    update_post_meta($id, '_velocity_redesign_impor', 1);
    $utama($id, isset($p['gambar_utama']) ? $p['gambar_utama'] : null);
