    update_option('page_on_front', $depan);
}
if (!empty($d['nama'])) { update_option('blogname', $d['nama']); }
update_option('blogdescription', (string) $d['slogan']);
if ($d['logo'] !== null && isset($media[(string) $d['logo']])) {
    update_option('site_logo', $media[(string) $d['logo']]['id']);
    $hasil['logo'] = $media[(string) $d['logo']]['id'];
}
if ($d['ikon'] !== null && isset($media[(string) $d['ikon']])) {
    update_option('site_icon', $media[(string) $d['ikon']]['id']);
}
flush_rewrite_rules(false);
echo 'VRD:' . wp_json_encode($hasil);
'''


def kecilkan(data, logo=False):
    """(bytes, ekstensi) gambar ≤ GAMBAR_MAKS_BYTE, atau None (bukan gambar / terlalu kecil)."""
    from PIL import Image, ImageOps
    try:
        im = Image.open(io.BytesIO(data))
        im.load()
        im = ImageOps.exif_transpose(im)
    except Exception:  # noqa: BLE001 — PIL melempar banyak jenis galat untuk berkas rusak
        return None
    if min(im.size) < (16 if logo else 48):
        return None
    alfa = im.mode in ('RGBA', 'LA') or (im.mode == 'P' and 'transparency' in im.info)
    lebar = 600 if logo else 1200
    if im.width > lebar:
        im = im.resize((lebar, max(1, round(im.height * lebar / im.width))), Image.LANCZOS)
    for _ in range(4):
        if alfa:
            im = im.convert('RGBA')
            for x in (im, im.quantize(256, method=Image.FASTOCTREE)):
                b = io.BytesIO()
                x.save(b, 'PNG', optimize=True)
                if b.tell() <= GAMBAR_MAKS_BYTE:
                    return b.getvalue(), '.png'
        else:
            im = im.convert('RGB')
            for q in range(82, 34, -8):
                b = io.BytesIO()
                im.save(b, 'JPEG', quality=q, optimize=True, progressive=True)
                if b.tell() <= GAMBAR_MAKS_BYTE:
                    return b.getvalue(), '.jpg'
        im = im.resize((max(1, round(im.width * .75)), max(1, round(im.height * .75))), Image.LANCZOS)
    return None


def unduh_gambar(konten, tujuan):
    """{indeks: nama berkas} gambar konten publik yang berhasil diunduh & diperkecil di `tujuan`."""
    hasil = {}
    tujuan.mkdir(parents=True, exist_ok=True)
    khusus = {konten.get('logo'), konten.get('ikon')}
    urut = sorted(konten['gambar'].items(), key=lambda x: (int(x[0]) not in khusus, int(x[0])))
    sudah = {}  # berkas asli yang sama dalam beberapa ukuran turunan cukup sekali
    for n, u in urut[:PUBLIK_MAKS_GAMBAR]:
        data = None
        asli = re.sub(r'-\d{2,4}x\d{2,4}(?=\.\w{3,4}$)', '', u.split('?')[0])  # ukuran turunan WP → berkas asli
        if asli in sudah:
            hasil[n] = sudah[asli]
            continue
        for calon in dict.fromkeys([asli, u]):
            kode, _, isi, _ = ambil(calon, timeout=30, maks=15_000_000)
            if kode == 200 and len(isi) > 200:
                data = isi
                break
        kecil = kecilkan(data, logo=int(n) in khusus) if data else None
        if not kecil:
            continue
        dasar = re.sub(r'[^a-z0-9]+', '-', Path(urllib.parse.urlparse(asli).path).stem.lower()).strip('-')[:50] or 'gambar'
        nama = f'{int(n):03d}-{dasar}{kecil[1]}'
        (tujuan / nama).write_bytes(kecil[0])
        hasil[n] = sudah[asli] = nama
    return hasil


def pasang_baru(domain, info, inv, konten, ulang=False):
    """WordPress baru di staging velocitydeveloper.co/<domain> lewat installer dasar yang sama dengan
    instalasi staging biasa (website-install-from-manifest), lalu konten publik situs lama diimpor.
    Situs lama tidak disentuh sama sekali. Kembalian sama dengan duplikat()."""
    s = Server(STAGING)
    da_user, docroot, url = STAGING['da_user'], f"{STAGING['akar']}/{domain}", f"{STAGING['url']}/{domain}"
    q = shlex.quote(docroot)
    ada = s.keluar(f'[ -e {q} ] && {{ [ -f {q}/{TANDA} ] && echo milik || echo asing; }} || echo kosong').strip()
    if ada == 'asing':
        raise RuntimeError(f'folder_tujuan_sudah_ada_bukan_salinan:{docroot}')
    if ada == 'milik' and not ulang:
        raise RuntimeError('salinan_sudah_ada (pakai --ulang untuk membuat ulang; desain di salinan akan hilang)')
    st = status_baca(domain)
    if ada == 'milik':
        s.keluar(f'rm -rf --one-file-system {q}')
        db_lama = (st.get('salinan') or {}).get('db', '')
        if re.match(rf'^{da_user}_\w+$', db_lama):
            s.sql(f'DROP DATABASE IF EXISTS `{db_lama}`')
    db = _nama_db(s, da_user, re.sub(r'[^a-z0-9]', '', domain.split('.')[0])[:10] + '_rd')
    sandi_db = secrets.token_urlsafe(18).replace('-', 'x').replace('_', 'y')
    user, sandi = akun_salinan(domain)
    salinan = {'tempat': 'staging', 'server': STAGING['name'], 'target_host': STAGING['host'],
               'ssh_port': STAGING['port'], 'ssh_user': STAGING['user'], 'da_user': da_user, 'docroot': docroot,
               'url': url, 'db': db, 'db_password': sandi_db, 'admin_user': user}
    # Manifest menunjuk staging lebih dulu: installer dasar membaca docroot=/site_url= dari sana.
    tulis_manifest(domain, info, salinan, inv)
    manifest_set(domain, redesign_sumber=f"publik_{konten['sumber']}")
    log(f'wp_baru: WordPress baru → {url} (db {db})')
    sandi_f = folder(domain) / 'admin-sandi.tmp'
    sandi_f.write_text(sandi + '\n')
    os.chmod(sandi_f, 0o600)
    try:
        subprocess.run([sys.executable, str(HERE / 'sinkron-paket')], capture_output=True, timeout=180)
    except (subprocess.TimeoutExpired, OSError):
        pass
    # paket-g-konten di installer dasar menulis isi contoh dari form/folder klien (bahan pembuatan
    # pertama). Redesign memakai konten lama (keputusan user 2026-09-29): isi contoh baru dibuang
    # sesudah instalasi supaya `persiapan` menyusunnya dari situs lama (isi_contoh_lama).
    tema = GENERATED / f'{domain}-tema.json'
    tema_ada = tema.exists()
    env = dict(os.environ, INSTALL_MODE='apply', MANIFEST=str(PROJECT / domain / f'{domain}.txt'),
               WP_INSTALL_DB_PASSWORD_FILE=str(SECRETS / f'db_password_{domain}.txt'),
               WP_INSTALL_ADMIN_PASSWORD_FILE=str(sandi_f))
    try:
        run = subprocess.run([str(HERE / 'website-install-from-manifest')], env=env, capture_output=True, text=True,
                             timeout=2400)
    finally:
        sandi_f.unlink(missing_ok=True)
    akhir = next((b for b in reversed(run.stdout.splitlines()) if b.startswith('{')), '')
    try:
        hasil_pasang = json.loads(akhir)
    except ValueError:
        hasil_pasang = {}
    if run.returncode or hasil_pasang.get('status') != 'applied':
        raise RuntimeError('wp_baru_gagal: ' + (akhir or re.sub(r'\s+', ' ', run.stdout + run.stderr)[-300:])[:400])
    log(f"wp_baru: terpasang ({hasil_pasang.get('status')})")
    if not tema_ada and tema.exists():
        tema.unlink()
    # Pengaman salinan + penanda milik redesign (sama dengan duplikat).
    mu = MU_PLUGIN.replace('__DOMAIN__', domain)
    s.keluar(
        f'echo {shlex.quote(json.dumps({"domain": domain, "dibuat": time.time(), "sumber": "publik"}))} > {q}/{TANDA}\n'
        f'chmod 600 {q}/{TANDA}\n'
        f'mkdir -p {q}/wp-content/mu-plugins\n'
        f"cat > {q}/wp-content/mu-plugins/velocity-redesign.php <<'VELOCITY_REDESIGN_MU'\n{mu}\nVELOCITY_REDESIGN_MU\n"
        f'{WP} option update blog_public 0 --path={q} --quiet\n'
        f'chown -R {da_user}:{da_user} {q}/{TANDA} {q}/wp-content/mu-plugins\n')
    impor = impor_konten(domain, s, docroot, da_user, konten)
    log(f"impor: {impor['halaman']} halaman, {impor['post']} post, {impor['kategori']} kategori, "
        f"{impor['gambar']} gambar (≤100 KB){', gagal ' + ','.join(impor['gagal'][:8]) if impor.get('gagal') else ''}"
        f"{', logo ' + str(impor['logo']) if impor.get('logo') else ', logo tidak ada'}")
    login_salinan(domain, s, docroot)
    home = s.keluar(f'{WP} option get home --path={q}').strip().rstrip('/')
    if home != url:
        raise RuntimeError(f'home_salinan_salah:{home}')
    kode, akhir_url, isi = http_get(url + '/')
    return dict(salinan, http=kode, http_akhir=akhir_url, noindex='noindex' in isi.lower(), impor=impor)


def impor_konten(domain, s, docroot, da_user, konten):
    kerja = folder(domain) / 'impor-gambar'
    shutil.rmtree(kerja, ignore_errors=True)
    berkas = unduh_gambar(konten, kerja)
    log(f"impor: {len(berkas)}/{min(len(konten['gambar']), PUBLIK_MAKS_GAMBAR)} gambar diunduh & diperkecil")
    data = {k: konten[k] for k in ('nama', 'slogan', 'permalink', 'basis_kategori', 'halaman', 'post', 'kategori',
                                   'logo', 'ikon')}
    data['berkas'] = berkas
    (kerja / 'impor.json').write_text(json.dumps(data, ensure_ascii=False))
    # Satu arsip berisi berkas saja (tanpa entri "."), dibongkar ke folder sementara baru.
    b = io.BytesIO()
    with tarfile.open(fileobj=b, mode='w') as tar:
        for p in sorted(kerja.iterdir()):
            tar.add(p, arcname=p.name)
    tmp = s.keluar('mktemp -d /tmp/velocity-redesign-impor.XXXXXX').strip()
    try:
        run = subprocess.run(s.ssh + [f'tar -xf - -C {shlex.quote(tmp)}'], input=b.getvalue(), capture_output=True,
                             timeout=1800)
        if run.returncode:
            raise RuntimeError('unggah_impor_gagal: ' + run.stderr.decode('utf-8', 'replace')[-300:])
        hasil = s.php(docroot, PHP_IMPOR.replace('__BERKAS__', f'{tmp}/impor.json'), timeout=3600)
    finally:
        s.bash(f'rm -rf {shlex.quote(tmp)}')
        shutil.rmtree(kerja, ignore_errors=True)
    s.keluar(f'chown -R {da_user}:{da_user} {shlex.quote(docroot)}/wp-content\n'
             f'{WP} cache flush --path={shlex.quote(docroot)} --quiet 2>/dev/null; true')
    return hasil


HTACCESS = """# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase __DASAR__
RewriteRule ^index\\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . __DASAR__index.php [L]
</IfModule>
# END WordPress
"""


MU_PLUGIN = r'''<?php
/**
 * Salinan Redesign __DOMAIN__ (installer Velocity) — BUKAN situs live.
 * Tidak diindeks mesin pencari dan tidak mengirim email (form, notifikasi, WooCommerce)
 * supaya klien & pengunjungnya tidak menerima apa pun dari salinan ini.
 * Dihapus saat salinan dipindah ke live.
 */
add_filter('pre_wp_mail', '__return_false', 1);
add_filter('pre_option_blog_public', function () { return '0'; });
add_filter('wp_robots', 'wp_robots_no_robots');
add_action('send_headers', function () { header('X-Robots-Tag: noindex, nofollow', true); });
'''


def telegram():
    tg = muat('notify_telegram', HERE / 'notify-telegram.py')
    tg.MANIFEST_ROOT = PROJECT
    return tg


def login(domain):
    """Sumber login sama dengan laporan instalasi (notify-telegram.wp_login)."""
    user, sandi = telegram().wp_login(domain)
    if not sandi:
        try:
            sandi = (SECRETS / f'admin_password_{domain}.txt').read_text().strip()
        except OSError:
            pass
    return user, sandi


def akun_salinan(domain):
    """User & sandi admin salinan = yang dikirim laporan Telegram (sumber sama dengan installer)."""
    user, sandi = login(domain)
    if not user:
        user = re.sub(r'[^a-z0-9]', '', domain.split('.')[0])[:12] or 'velocity'
    if not sandi:
        # Belum ada sumber sandi sama sekali: buat, lalu simpan di tempat yang dibaca laporan.
        sandi = secrets.token_urlsafe(14)
        p = SECRETS / f'admin_password_{domain}.txt'
        p.write_text(sandi + '\n')
        os.chmod(p, 0o600)
    return user, sandi


def login_salinan(domain, s, docroot):
    """Admin installer di salinan (bukan di situs asli): user & sandi yang sama dengan laporan Telegram."""
    user, sandi = akun_salinan(domain)
    q = shlex.quote(docroot)
    email = f'redesign+{user}@velocitydeveloper.com'
    s.keluar(
        f'if {WP} user get {shlex.quote(user)} --path={q} --field=ID >/dev/null 2>&1; then\n'
        f'  {WP} user update {shlex.quote(user)} --user_pass={shlex.quote(sandi)} --role=administrator --path={q} --quiet '
        '--skip-email\n'
        f'else {WP} user create {shlex.quote(user)} {shlex.quote(email)} --role=administrator '
        f'--user_pass={shlex.quote(sandi)} --path={q} --quiet; fi\n')
    return user, sandi


def tulis_manifest(domain, info, salinan, inv):
    """Manifest menunjuk SALINAN; aslinya disimpan .sebelum-redesign (sekali saja)."""
    p = PROJECT / domain / f'{domain}.txt'
    p.parent.mkdir(parents=True, exist_ok=True)
    asli = p.with_name(p.name + '.sebelum-redesign')
    if p.exists() and not asli.exists():
        shutil.copy2(p, asli)
    baris, kunci = [], set()
    ganti = {
        'target_host': salinan['target_host'], 'ssh_port': salinan['ssh_port'], 'ssh_user': salinan['ssh_user'],
        'da_user': salinan['da_user'], 'domain': domain, 'db_name': salinan['db'], 'db_user': salinan['db'],
        'admin_user': salinan['admin_user'], 'docroot': salinan['docroot'], 'site_url': salinan['url'],
        'tema_desain': 'fse', 'redesign': salinan['tempat'], 'redesign_asli_url': info.get('url', ''),
        'redesign_asli_docroot': info.get('docroot', ''),
    }
    lama = p.read_text().splitlines() if p.exists() else []
    for b in lama:
        k = b.partition('=')[0].strip()
        if k in ganti:
            if k not in kunci:
                baris.append(f'{k}={ganti[k]}')
                kunci.add(k)
        else:
            baris.append(b)
    for k, v in ganti.items():
        if k not in kunci:
            baris.append(f'{k}={v}')
    if not any(b.startswith('site_title=') for b in baris):
        judul = re.sub(r'[\r\n=]', ' ', inv.get('nama') or domain)
        baris.append(f'site_title={judul}')
    if not any(b.startswith('admin_email=') for b in baris):
        baris.append(f"admin_email={inv.get('email_admin') or 'admin@' + domain}")
    tmp = p.with_suffix('.txt.tmp')
    tmp.write_text('\n'.join(baris) + '\n')
    os.chmod(tmp, 0o640)
    os.replace(tmp, p)
    sec = SECRETS / f'db_password_{domain}.txt'
    if sec.exists() and not sec.with_name(sec.name + '.sebelum-redesign').exists():
        shutil.copy2(sec, sec.with_name(sec.name + '.sebelum-redesign'))
    sec.write_text(salinan['db_password'] + '\n')
    os.chmod(sec, 0o600)


def manual(domain, alasan, **isi):
    status_tulis(domain, tahap='manual', galat=alasan, **isi)
    log(f'berhenti: {alasan}')
    return 3


def siapkan(domain, coba=False, paksa_lokasi='', ulang=False, sumber=None, luar=None):
    status_tulis(domain, tahap='cek', mulai=datetime.now().astimezone().isoformat(timespec='seconds'), galat='')
    # Alur redesign otomatis khusus Paket G (keputusan user 2026-10-07); paket lain dikerjakan tim.
    cfg = baca_manifest(domain)
    paket = cfg.get('paket', '')
    if not re.fullmatch(r'paket\s*g', paket.strip(), re.I):
        return manual(domain, f"bukan_paket_g:{paket or '-'}")
    # Uji lewat installer-runner (domain .test): sama dengan --luar.
    if domain.endswith('.test') and re.match(r'^https?://', cfg.get('redesign_uji_luar', '')):
        luar = luar or cfg['redesign_uji_luar']
    info = cek(domain, sumber, luar)
    terjangkau = info['jenis'] in ('wp_tertaut', 'tertaut_bukan_wp')
    log(f"cek: {info['jenis']}" + (f" di {info['server']['name']} ({info['da_user']}) {info.get('url', '')}"
                                  if terjangkau else f" http={info.get('http')} {info.get('url', '')}"))
    if info.get('server_tak_terjangkau'):
        log(f"cek: server tertaut tak terjangkau: {', '.join(info['server_tak_terjangkau'])} — domain dianggap hosting luar")
    if info['jenis'] == 'tidak_aktif':
        return manual(domain, 'situs_lama_tidak_aktif', jenis=info['jenis'])
    # Hosting bisa diakses server kantor → tahap 2 (cadangan) dijalankan; tidak → dilewati.
    log('cek: hosting terjangkau dari server kantor → cadangan' if terjangkau
        else 'cek: hosting tidak terjangkau dari server kantor → cadangan dilewati, konten dari halaman publik')
    if info['jenis'] == 'wp_tertaut':
        inv, konten = inventaris(domain, info), None
    else:
        inv, konten = inventaris_publik(domain, info)
    log(f"inventaris: {len(inv['halaman'])} halaman, {inv['jumlah_post']} post, {len(inv['cpt'])} CPT, "
        f"{len(inv['menu'])} menu, {len(inv['plugin'])} plugin aktif, tema {inv['tema']['slug']}, "
        f"{len(inv['url_lama'])} URL lama" + (f", sumber {inv['sumber']}" if inv.get('sumber') else ''))
    b = brief(domain)
    log(f"brief: {b['folder'] or 'subfolder redesign tidak ada'} — referensi {b['referensi'].get('url') or '-'}"
        f", paket tujuan {b['paket_tujuan'] or '-'}, {len(b['gambar'])} gambar")
    status_tulis(domain, brief={'folder': b['folder'], 'referensi': b['referensi'].get('url', ''),
                                'paket_tujuan': b['paket_tujuan'], 'gambar': len(b['gambar'])})
    tempat, alasan, rinci = lokasi(domain, info)
    if paksa_lokasi in ('new', 'staging') and info['jenis'] == 'wp_tertaut':
        alasan = f'dipaksa ({alasan})'
        tempat = paksa_lokasi
    log(f'lokasi: {tempat} — {alasan} {json.dumps(rinci)}')
    ringkas = {k: info[k] for k in ('jenis', 'da_user', 'docroot', 'url', 'db', 'versi_wp') if k in info}
    status_tulis(domain, tahap='lokasi', asli=dict(ringkas, server=(info.get('server') or {}).get('name', '')),
                 lokasi={'tempat': tempat, 'alasan': alasan, **rinci}, terjangkau=terjangkau)
    if coba:
        return 0
    if terjangkau:
        status_tulis(domain, tahap='cadangan')
        cad = cadangan(domain, info)
        log(f"cadangan: {cad['folder']} (db {cad['db_mb']} MB gz, berkas {cad['berkas_mb']} MB gz, "
            f"{cad['tabel']} tabel) OK")
    else:
        cad = {'dilewati': 'hosting_tidak_terjangkau'}
        log('cadangan: dilewati (hosting tidak terjangkau dari server kantor)')
    status_tulis(domain, tahap='duplikat', cadangan=cad)
    if info['jenis'] == 'wp_tertaut':
        sal = duplikat(domain, info, tempat, cad, ulang=ulang)
        log(f"duplikat: {sal['url']} (http {sal['http']}, noindex={sal['noindex']}, db {sal['db']})")
    else:
        sal = pasang_baru(domain, info, inv, konten, ulang=ulang)
        log(f"wp_baru: {sal['url']} (http {sal['http']}, noindex={sal['noindex']}, db {sal['db']})")
    if sal['http'] != 200:
        raise RuntimeError(f"salinan_tidak_200:{sal['http']} {sal['http_akhir']}")
    tulis_manifest(domain, info, sal, inv)
    log(f'manifest: {PROJECT / domain / (domain + ".txt")} menunjuk salinan (asli: .sebelum-redesign)')
    status_tulis(domain, tahap='salinan_siap', salinan={k: v for k, v in sal.items() if k != 'db_password'})
    return 0

# ── Tahap 5–6: persiapan & perapian salinan di sekitar langkah desain FSE ────
# Dipanggil installer-runner INSTALL_MODE=redesign (lihat urutannya di sana). Keduanya hanya
# menulis ke SALINAN (manifest sudah menunjuk salinan, dicek ulang di salinan_server).
# Konten lama dipertahankan (keputusan user 2026-09-29): halaman target fse-apply yang berisi
# tulisan lama diberi _velocity_fse_md5 yang sengaja tidak cocok → fse-apply menganggapnya
# "sudah disunting orang" dan tidak menimpanya. Beranda dibuat baru (keputusan user): halaman
# `beranda` lama berganti slug `beranda-lama` (tetap disimpan), fse-apply membuat beranda baru,
# lalu `rapikan` menjadikannya halaman depan.
TARGET_FSE = ('tentang-kami', 'galeri', 'hubungi-kami', 'berita', 'layanan', 'pemesanan', 'produk')
KUNCI_LAMA = 'redesign-konten-lama'

PHP_PERSIAPAN = r'''
$d = json_decode(base64_decode('__DATA__'), true);
$cari = function ($slug) {
    $p = get_posts(array('name' => $slug, 'post_type' => 'page', 'post_status' => array('publish', 'private', 'draft'),
        'numberposts' => 1));
    return $p ? $p[0] : null;
};
$teks = function ($isi) {
    $isi = preg_replace('/\[[^\]]*\]/', ' ', (string) $isi);
    return trim(preg_replace('/\s+/', ' ', html_entity_decode(wp_strip_all_tags($isi), ENT_QUOTES)));
};
$hasil = array('ada' => array(), 'kunci' => array(), 'beranda_lama' => 0,
    'depan_lama' => array('tampil' => get_option('show_on_front'), 'halaman' => (int) get_option('page_on_front')),
    'blog' => (int) get_option('page_for_posts'), 'post' => (int) wp_count_posts('post')->publish,
    'tentang' => '', 'layanan' => array());
foreach ($d['target'] as $s) {
    $p = $cari($s);
    if (!$p) { continue; }
    $hasil['ada'][] = $s;
    // Berisi tulisan lama (bukan sekadar shortcode tema lama/placeholder) → dikunci.
    if (str_word_count($teks($p->post_content)) >= 15 && !get_post_meta($p->ID, '_velocity_fse_md5', true)) {
        if (empty($d['coba'])) { update_post_meta($p->ID, '_velocity_fse_md5', $d['kunci']); }
        $hasil['kunci'][] = $s;
    } elseif (get_post_meta($p->ID, '_velocity_fse_md5', true) === $d['kunci']) {
        $hasil['kunci'][] = $s;
    }
}
$tentang = $cari('tentang-kami') ?: $cari('tentang') ?: $cari('about') ?: $cari('about-us') ?: $cari('profil');
if ($tentang) { $hasil['tentang'] = mb_substr($teks($tentang->post_content), 0, 900); }
$induk = $cari('layanan') ?: $cari('produk') ?: $cari('services');
$anak = $induk ? get_posts(array('post_type' => 'page', 'post_parent' => $induk->ID, 'numberposts' => 8,
    'orderby' => 'menu_order title', 'order' => 'ASC')) : array();
if (!$anak) {
    foreach (get_post_types(array('public' => true, '_builtin' => false)) as $t) {
        $anak = get_posts(array('post_type' => $t, 'numberposts' => 8));
        if ($anak) { break; }
    }
}
foreach ($anak as $p) {
    $hasil['layanan'][] = array('slug' => $p->post_name, 'judul' => get_the_title($p),
        'teks' => wp_trim_words($teks($p->post_content), 28, '…'), 'rincian' => array());
}
if (empty($d['coba']) && !$d['sudah']) {
    $b = $cari('beranda');
    if ($b) {
        wp_update_post(array('ID' => $b->ID, 'post_name' => 'beranda-lama',
            'post_title' => $b->post_title . ' (lama)'));
        $hasil['beranda_lama'] = $b->ID;
    } elseif ($hasil['depan_lama']['halaman']) {
        $hasil['beranda_lama'] = $hasil['depan_lama']['halaman'];
    }
    // Kosong = beranda baru dibuat fse-apply --isi; `rapikan` menjadikannya halaman depan.
    update_option('page_on_front', 0);
}
echo 'VRD:' . wp_json_encode($hasil);
'''


def salinan_server(domain):
    """Server + docroot salinan dari status.json, dicocokkan dengan manifest (pengaman situs asli)."""
    st = status_baca(domain)
    sal = st.get('salinan') or {}
    cfg = baca_manifest(domain)
    if not sal.get('docroot') or cfg.get('docroot') != sal['docroot'] or not cfg.get('redesign'):
        raise RuntimeError('salinan_tidak_cocok_manifest')
    if sal['docroot'] == (st.get('asli') or {}).get('docroot'):
        raise RuntimeError('salinan_sama_dengan_asli')
    s = Server({'name': sal.get('server', ''), 'host': sal['target_host'], 'port': sal.get('ssh_port') or 22,
                'user': sal.get('ssh_user') or 'root'})
    return s, sal, st


def php_data(kode, data):
    return kode.replace('__DATA__', base64.b64encode(json.dumps(data).encode()).decode())


def isi_contoh_lama(domain, inv, hasil, cfg):
    """<domain>-tema.json dari konten lama bila belum ada (situs buatan installer sudah punya; tidak ditimpa)."""
    p = GENERATED / f'{domain}-tema.json'
    if p.exists():
        return 'ada'
    warna = inv.get('warna') or []
    nama = inv.get('nama') or domain
    tema = {
        'jenis': 'berita' if 'berita' in (cfg.get('paket') or '').lower() else 'perusahaan',
        'nama_tampil': nama, 'slogan': inv.get('slogan') or '',
        'hero_judul': nama, 'hero_teks': inv.get('meta_deskripsi') or inv.get('slogan') or '',
        'hero_poin': [], 'layanan': hasil.get('layanan') or [], 'produk': [], 'keunggulan': [], 'alur': [],
        'galeri': [], 'foto_umum': [], 'judul_seksi': {}, 'profil': hasil.get('tentang') or '', 'visi': '',
        'misi': [], 'moto': '', 'struktur': [], 'customer': [], 'legalitas': [], 'target': [],
        'warna': {'utama': warna[0] if warna else '', 'aksen': warna[1] if len(warna) > 1 else ''},
        'sumber': 'redesign_konten_lama',
    }
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(tema, ensure_ascii=False, indent=1))
    return 'dibuat'


def manifest_set(domain, **isi):
    """Tambah/ganti kunci manifest (salinan). Nilai kosong = kunci dihapus."""
    p = PROJECT / domain / f'{domain}.txt'
    baris = [b for b in p.read_text().splitlines() if b.partition('=')[0].strip() not in isi]
    baris += [f'{k}={v}' for k, v in isi.items() if v]
    tmp = p.with_suffix('.txt.tmp')
    tmp.write_text('\n'.join(baris) + '\n')
    os.chmod(tmp, 0o640)
    os.replace(tmp, p)


def persiapan(domain, coba=False):
    s, sal, st = salinan_server(domain)
    inv = json.loads((folder(domain) / 'inventaris.json').read_text())
    cfg = baca_manifest(domain)
    sudah = bool((st.get('persiapan') or {}).get('selesai'))
    hasil = s.php(sal['docroot'], php_data(PHP_PERSIAPAN, {'target': TARGET_FSE, 'kunci': KUNCI_LAMA,
                                                           'coba': coba, 'sudah': sudah}))
    # Halaman target yang tidak ada di situs lama tidak dibuat (kecuali Hubungi Kami); arsip Berita
    # hanya bila situs lama bertulisan tanpa halaman blog lain.
    ada = set(hasil['ada'])
    tanpa = [t for t in TARGET_FSE if t not in ada and t != 'hubungi-kami'
             and not (t == 'berita' and hasil['post'] and not hasil['blog'])]
    log(f"persiapan: halaman lama dikunci {','.join(hasil['kunci']) or '-'}; tanpa_halaman {','.join(tanpa) or '-'}; "
        f"beranda lama id {hasil['beranda_lama'] or '-'}")
    if coba:
        return 0
    contoh = isi_contoh_lama(domain, inv, hasil, cfg)
    ubah = {'tanpa_halaman': ','.join(tanpa)}
    # Kontak publik dari situs lama bila manifest belum punya (form tidak berlaku untuk situs lama).
    kontak = inv.get('kontak') or {}
    if not cfg.get('wa_publik') and kontak.get('wa'):
        ubah['wa_publik'] = kontak['wa'][0]
    if not cfg.get('email_publik') and kontak.get('email'):
        ubah['email_publik'] = kontak['email'][0]
    manifest_set(domain, **ubah)
    log(f"persiapan: isi contoh {contoh}, manifest {', '.join(f'{k}={v}' for k, v in ubah.items())}")
    per = st.get('persiapan') or {}
    status_tulis(domain, tahap='desain', persiapan={
        'selesai': True, 'kunci': hasil['kunci'], 'tanpa_halaman': tanpa,
        'beranda_lama': per.get('beranda_lama') or hasil['beranda_lama'],
        'depan_lama': per.get('depan_lama') or hasil['depan_lama']})
    return 0


PHP_RAPIKAN = r'''
$d = json_decode(base64_decode('__DATA__'), true);
$hasil = array();
$b = get_posts(array('name' => 'beranda', 'post_type' => 'page', 'post_status' => 'publish', 'numberposts' => 1));
if ($b && get_post_meta($b[0]->ID, '_velocity_fse_md5', true) && get_post_meta($b[0]->ID, '_velocity_fse_md5', true) !== $d['kunci']) {
    update_option('show_on_front', 'page');
    update_option('page_on_front', $b[0]->ID);
    $hasil['depan'] = 'beranda_baru:' . $b[0]->ID;
} else {
    // Beranda baru gagal dibuat: halaman depan lama dikembalikan, salinan tidak dibiarkan tanpa beranda.
    $lama = $d['depan_lama'];
    update_option('show_on_front', $lama['tampil'] ?: 'posts');
    update_option('page_on_front', (int) ($d['beranda_lama'] ?: $lama['halaman']));
    $hasil['depan'] = 'dikembalikan_lama';
}
if (!empty($d['menu'])) {
    $nav = null;
    foreach (get_posts(array('post_type' => 'wp_navigation', 'post_status' => 'publish', 'numberposts' => 20,
        'orderby' => 'date', 'order' => 'DESC')) as $n) {
        if (get_post_meta($n->ID, '_velocity_fse_md5', true)) { $nav = $n; break; }
    }
    if ($nav) {
        wp_update_post(array('ID' => $nav->ID, 'post_content' => wp_slash($d['menu'])));
        // Sengaja tidak sama dengan md5 isi: fse-apply berikutnya membiarkan menu lama ini.
        update_post_meta($nav->ID, '_velocity_fse_md5', 'redesign-menu-lama');
        $hasil['menu'] = 'ditulis:' . $nav->ID;
    } else {
        $hasil['menu'] = 'tidak_ada_menu_installer';
    }
}
echo 'VRD:' . wp_json_encode($hasil);
'''


def menu_lama(inv, asal, tujuan):
    """Menu utama situs lama (beserta submenu) sebagai markup wp_navigation, URL → salinan."""
    menu = next((m for m in inv.get('menu') or [] if set(m.get('lokasi') or []) & {'primary', 'main', 'menu-1',
                                                                                     'primary-menu', 'header'}),
                None) or next(iter(inv.get('menu') or []), None)
    if not menu or not menu.get('item'):
        return ''
    item = menu['item']
    anak = {}
    for i in item:
        # Inventaris lama tanpa ID item: submenu tidak bisa disusun, semua item jadi tingkat atas.
        anak.setdefault((i.get('induk') or 0) if all(x.get('id') for x in item) else 0, []).append(i)
    alih = lambda u: tujuan + u[len(asal):] if u.startswith(asal) else u

    def blok(i):
        label = json.dumps(html.unescape(i['judul']), ensure_ascii=False)
        dasar = f'"label":{label},"url":{json.dumps(alih(i["url"]))},"kind":"custom","isTopLevelLink":true'
        sub = anak.get(i.get('id'), []) if i.get('id') else []
        if sub:
            return (f'<!-- wp:navigation-submenu {{{dasar}}} -->\n' + '\n'.join(blok(x) for x in sub)
                    + '\n<!-- /wp:navigation-submenu -->')
        return f'<!-- wp:navigation-link {{{dasar}}} /-->'
    return '\n'.join(blok(i) for i in anak.get(0, []))


def cek_url_lama(inv, asal, tujuan):
    hidup, mati = 0, []
    for u in inv.get('url_lama') or []:
        if not u.startswith(asal):
            continue
        kode, akhir, _ = http_get(tujuan + u[len(asal):], timeout=20)
        if kode == 200:
            hidup += 1
        else:
            mati.append(f'{u[len(asal):] or "/"}={kode}')
    return hidup, mati


def rapikan(domain):
    s, sal, st = salinan_server(domain)
    inv = json.loads((folder(domain) / 'inventaris.json').read_text())
    per = st.get('persiapan') or {}
    asal = (st.get('asli') or {}).get('url', '').rstrip('/')
    tujuan = sal['url'].rstrip('/')
    menu = menu_lama(inv, asal, tujuan)
    hasil = s.php(sal['docroot'], php_data(PHP_RAPIKAN, {
        'kunci': KUNCI_LAMA, 'menu': menu, 'beranda_lama': per.get('beranda_lama') or 0,
        'depan_lama': per.get('depan_lama') or {'tampil': 'posts', 'halaman': 0}}))
    s.bash(f'{WP} cache flush --path={shlex.quote(sal["docroot"])} --quiet 2>/dev/null; true')
    log(f"rapikan: halaman depan {hasil.get('depan')}, menu {hasil.get('menu', 'tanpa_menu_lama')}")
    hidup, mati = cek_url_lama(inv, asal, tujuan)
    ringkas = f'{hidup}/{hidup + len(mati)} hidup' + (f" — gagal: {', '.join(mati[:6])}" if mati else '')
    log(f'rapikan: URL lama {ringkas}')
    status_tulis(domain, tahap='rapikan', url_lama=ringkas, rapikan=hasil)
    return 0 if hasil.get('depan', '').startswith('beranda_baru') else 1


def laporan(domain):
    """Tahap 7: link salinan + login WP, tanpa tombol (keputusan user 2026-09-29)."""
    st = status_baca(domain)
    sal = st.get('salinan') or {}
    if not sal.get('url'):
        log('laporan: salinan belum ada')
        return 1
    tg = telegram()
    token, chats = tg.load_config()
    user, sandi = login(domain)
    e = html.escape
    lok = st.get('lokasi') or {}
    tempat = ('salinan di folder <code>/new</code> hosting klien (situs asli tidak diubah)' if sal.get('tempat') == 'new'
              else 'staging velocitydeveloper.co (' + e(str(lok.get('alasan', ''))) + ')')
    cad = st.get('cadangan') or {}
    impor = sal.get('impor') or {}
    if cad.get('dilewati'):
        cadangan_teks = ('Cadangan: dilewati — hosting tidak bisa diakses server kantor. WordPress baru + konten '
                         f"publik situs lama ({impor.get('halaman', 0)} halaman, {impor.get('post', 0)} post, "
                         f"{impor.get('gambar', 0)} gambar)")
    else:
        cadangan_teks = (f"Cadangan: {e(str(cad.get('db_mb', '')))} MB DB + {e(str(cad.get('berkas_mb', '')))} MB "
                         'berkas di server installer')
        if impor:
            cadangan_teks += (f"; situs lama bukan WordPress — konten publik dipindahkan ({impor.get('halaman', 0)} "
                              f"halaman, {impor.get('gambar', 0)} gambar)")
    teks = [f'🎨 <b>REDESIGN SIAP DICEK</b> — {e(domain)}', '',
            f'Link redesign: {e(sal["url"])}/',
            f'Login: {e(sal["url"])}/wp-admin/',
            f'User: <code>{e(user)}</code>', f'Password: <code>{e(sandi)}</code>', '',
            f'Lokasi: {tempat}',
            f'Situs lama: {e((st.get("asli") or {}).get("url", ""))} — tetap live, tidak disentuh',
            cadangan_teks]
    if (st.get('brief') or {}).get('referensi'):
        teks.append(f"Referensi desain: {e(st['brief']['referensi'])} (subfolder redesign)")
    if st.get('qa'):
        teks.append(f'QA: {e(str(st["qa"]))}')
    if st.get('url_lama'):
        teks.append(f'URL lama: {e(str(st["url_lama"]))}')
    teks += ['', 'Salinan tidak diindeks Google & tidak mengirim email. Pindah ke live menunggu persetujuan klien '
                 '(lewat permintaan terpisah).']
    if not token or not chats:
        log('laporan: token/chat telegram belum diset')
        return 1
    gagal = 0
    for chat in chats:
        try:
            ok, mid = tg.send(token, chat, '\n'.join(teks))
            if ok and mid:
                tg.record_sent(domain, 'REDESIGN', chat, mid)
            else:
                gagal += 1
        except (urllib.error.URLError, OSError, ValueError) as ex:
            log(f'laporan: gagal kirim ke {chat} ({ex})')
            gagal += 1
    status_tulis(domain, laporan=datetime.now().astimezone().isoformat(timespec='seconds'))
    log(f'laporan: terkirim ke {len(chats) - gagal}/{len(chats)} chat')
    return 1 if gagal == len(chats) else 0


def main():
    arg = [a for a in sys.argv[1:] if not a.startswith('--')]
    opsi = dict(a[2:].partition('=')[::2] for a in sys.argv[1:] if a.startswith('--'))
    if len(arg) != 2 or arg[0] not in ('siapkan', 'persiapan', 'rapikan', 'laporan', 'status'):
        print(__doc__, file=sys.stderr)
        return 2
    perintah, domain = arg[0], arg[1].lower().strip()
    if not re.match(r'^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$', domain):
        print('domain tidak sah', file=sys.stderr)
        return 2
    if perintah == 'status':
        print(json.dumps(status_baca(domain), ensure_ascii=False, indent=1))
        return 0
    if perintah == 'laporan':
        if 'qa' in opsi:
            status_tulis(domain, qa=opsi['qa'] or 'bersih')
        return laporan(domain)
    if perintah in ('persiapan', 'rapikan'):
        try:
            return persiapan(domain, coba='coba' in opsi) if perintah == 'persiapan' else rapikan(domain)
        except (RuntimeError, subprocess.TimeoutExpired, OSError, ValueError, KeyError) as e:
            status_tulis(domain, galat=f'{perintah}: {e}'[:500])
            log(f'GAGAL {perintah}: {e}')
            return 1
    sumber = tuple(opsi['sumber'].split(':', 2)) if opsi.get('sumber') else None
    if sumber and len(sumber) != 3:
        print('--sumber=<server>:<docroot>:<url>', file=sys.stderr)
        return 2
    luar = opsi.get('luar') or None
    if luar and not re.match(r'^https?://[^/\s]+', luar):
        print('--luar=<url situs publik>', file=sys.stderr)
        return 2
    try:
        return siapkan(domain, coba='coba' in opsi, paksa_lokasi=opsi.get('lokasi', ''), ulang='ulang' in opsi,
                       sumber=sumber, luar=luar)
    except (RuntimeError, subprocess.TimeoutExpired, OSError, ValueError) as e:
        status_tulis(domain, galat=str(e)[:500])
        log(f'GAGAL: {e}')
        return 1


if __name__ == '__main__':
    sys.exit(main())
