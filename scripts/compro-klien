#!/usr/bin/env python3
"""Ambil identitas visual & susunan dari company profile (compro) PDF kiriman klien.

Pemakaian: compro-klien <domain> [--segar]

Keputusan user 2026-09-13: permintaan "desain disesuaikan dengan compro" berarti
tampilan situs mengikuti PDF itu — warna, logo, foto, DAN urutan/tata letak
bagiannya — dan semua yang dikirim klien boleh tampil kecuali ada tulisan untuk
tidak ditampilkan.

Hasil di /var/lib/velocity/compro/<domain>/:
  compro.json    warna (utama, aksen, sorot), warna latar halaman, slogan,
                 subjudul, alamat, email, prakata, daftar seksi berurutan
                 (jenis + judul + foto), logo, daftar foto
  logo.png       logo dengan latar transparan, dipotong dari gambar kepala halaman
  foto-*.jpg|png foto tertanam (≥300x250), tanpa duplikat & tanpa hiasan; foto
                 bermask (potongan produk) disimpan PNG transparan

Semua bagian bersifat "sebisanya": PDF tanpa foto/logo tetap menghasilkan JSON
dengan kolom kosong, dan kegagalan tidak boleh menghentikan instalasi.
"""
import colorsys
import hashlib
import json
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import zlib
from collections import Counter
from pathlib import Path

ON_PROGRESS = Path('/home/On Progress')
OUT_ROOT = Path('/var/lib/velocity/compro')
PROFIL_RE = re.compile(r'profil|profile|compro|company', re.I)
EMAIL_RE = re.compile(r'[\w.+-]+@[\w-]+\.[\w.-]+')
# Naikkan bila bentuk compro.json berubah: hasil tersimpan versi lama dibaca ulang
# otomatis (versi 2 menambah seksi, prakata, alamat, latar, sorot, foto transparan).
VERSI = 2


# ---------- PNG minimal (tanpa PIL: tidak terpasang di server installer) ----------

def baca_png(path):
    data = Path(path).read_bytes()
    if data[:8] != b'\x89PNG\r\n\x1a\n':
        raise ValueError('bukan PNG')
    pos, idat, lebar, tinggi, kedalaman, tipe = 8, b'', 0, 0, 8, 2
    while pos < len(data):
        panjang, jenis = struct.unpack('>I4s', data[pos:pos + 8])
        isi = data[pos + 8:pos + 8 + panjang]
        if jenis == b'IHDR':
            lebar, tinggi, kedalaman, tipe = struct.unpack('>IIBB', isi[:10])
        elif jenis == b'IDAT':
            idat += isi
        pos += 12 + panjang
    if kedalaman != 8 or tipe not in (0, 2, 6):
        raise ValueError(f'format PNG tidak didukung (depth={kedalaman}, tipe={tipe})')
    kanal = {0: 1, 2: 3, 6: 4}[tipe]
    mentah, stride = zlib.decompress(idat), lebar * kanal
    baris, sebelum = [], bytearray(stride)
    for y in range(tinggi):
        f = mentah[y * (stride + 1)]
        cur = bytearray(mentah[y * (stride + 1) + 1:(y + 1) * (stride + 1)])
        if f == 2:
            cur = bytearray((c + s) & 255 for c, s in zip(cur, sebelum))
        elif f:
            for x in range(stride):
                a = cur[x - kanal] if x >= kanal else 0
                b = sebelum[x]
                c = sebelum[x - kanal] if x >= kanal else 0
                if f == 1:
                    cur[x] = (cur[x] + a) & 255
                elif f == 3:
                    cur[x] = (cur[x] + (a + b) // 2) & 255
                elif f == 4:
                    p = a + b - c
                    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
                    cur[x] = (cur[x] + (a if pa <= pb and pa <= pc else b if pb <= pc else c)) & 255
        baris.append(bytes(cur))
        sebelum = cur
    return lebar, tinggi, kanal, baris


def tulis_png_rgba(path, lebar, tinggi, baris_rgba):
    def potongan(jenis, isi):
        return struct.pack('>I', len(isi)) + jenis + isi + struct.pack('>I', zlib.crc32(jenis + isi) & 0xffffffff)
    mentah = b''.join(b'\x00' + r for r in baris_rgba)
    Path(path).write_bytes(b'\x89PNG\r\n\x1a\n' + potongan(b'IHDR', struct.pack('>IIBBBBB', lebar, tinggi, 8, 6, 0, 0, 0))
                           + potongan(b'IDAT', zlib.compress(mentah, 9)) + potongan(b'IEND', b''))


def heks(rgb):
    return '#%02x%02x%02x' % tuple(rgb)


def hls(nilai):
    nilai = nilai.lstrip('#')
    return colorsys.rgb_to_hls(*(int(nilai[i:i + 2], 16) / 255 for i in (0, 2, 4)))


# ---------- teks halaman ----------

def jalankan(perintah, **kw):
    return subprocess.run(perintah, capture_output=True, text=True, timeout=kw.pop('timeout', 180), **kw)


def pdf_berteks(pdf):
    """PDF yang isinya teks/vektor sungguhan, bukan hasil pindai per halaman.

    bumiairchemitech.com (2026-09-16) mengirim dua berkas: deck asli 24 halaman
    (teks + logo bertransparansi) dan ekspor 42MB yang tiap halamannya SATU gambar
    penuh. Yang kedua terpilih karena lebih besar, dan akibatnya logo tidak ketemu,
    warna merek kosong, dan 'foto'-nya berupa halaman utuh — sampulnya dipakai jadi
    latar hero sehingga tulisan hero bertumpuk dengan tulisan di gambar."""
    try:
        teks = jalankan(['pdftotext', '-f', '1', '-l', '3', str(pdf), '-']).stdout or ''
        font = jalankan(['pdffonts', str(pdf)]).stdout or ''
    except (OSError, subprocess.SubprocessError):
        return False
    # Font tertanam + teks yang bisa disalin = halaman masih punya objek sendiri.
    return len(re.sub(r'\s', '', teks)) >= 200 and len(font.splitlines()) > 2


def cari_compro(domain):
    folder = ON_PROGRESS / domain
    if not folder.is_dir():
        return None
    pdf = [p for p in folder.iterdir() if p.suffix.lower() == '.pdf' and not p.name.upper().startswith('FORM ISIAN')]
    # Berteks dulu (logo & warna merek hanya bisa diambil dari situ), baru nama yang
    # menyebut profil, baru yang paling besar.
    pdf.sort(key=lambda p: (not pdf_berteks(p), not PROFIL_RE.search(p.name), -p.stat().st_size))
    return pdf[0] if pdf else None


def teks_per_halaman(pdf, jumlah):
    halaman = []
    for i in range(1, jumlah + 1):
        halaman.append(jalankan(['pdftotext', '-f', str(i), '-l', str(i), '-layout', str(pdf), '-']).stdout)
    return halaman


def rapi(baris):
    return re.sub(r'\s+', ' ', baris).strip()


def baris_berulang(halaman):
    """Baris yang muncul di banyak halaman: kepala/kaki halaman (nama, tagline)."""
    hitung = Counter()
    for t in halaman:
        hitung.update({rapi(b) for b in t.splitlines() if b.strip()})
    batas = max(3, len(halaman) * 0.4)
    return {b for b, n in hitung.items() if n >= batas}


def segmen(baris):
    """Potongan teks satu baris layout beserta kolom tengahnya.

    pdftotext -layout menggabungkan kolom yang sejajar dalam satu baris
    ("PACKAGING JUMBO BAG CUSTOM   JASA LAYANAN   06"); jarak ≥2 spasi = pemisah."""
    return [(m.group(0).strip(), m.start() + len(m.group(0).strip()) / 2)
            for m in re.finditer(r'\S+(?: \S+)*', baris)]


def bukan_isi(teks, berulang):
    """Kepala/kaki halaman, nomor halaman, alamat, atau email — bukan isi bagian."""
    return (teks in berulang or any(len(r) >= 8 and r in teks for r in berulang)
            or re.fullmatch(r'\d{1,3}', teks) or EMAIL_RE.search(teks))


def judul_halaman(teks, berulang):
    """Judul bagian halaman beserta baris lanjutannya.

    Judul panjang di compro dipatah dua baris rata tengah ("TARGET PENCAPAIAN" /
    "PERUSAHAAN"); versi pertama hanya mengambil baris pertama sehingga dua
    halaman "MARKING AREA & FINISH" dan "MARKING AREA AND" tampak beda bagian.
    Baris berikutnya dianggap lanjutan hanya bila titik tengahnya sejajar (±6
    kolom; "GOOD" di bawah "MARKING AREA & FINISH" meleset 4,5 kolom) —
    "JASA LAYANAN" tidak boleh menelan subjudul kolom "KARUNG SAK" di sebelahnya."""
    baris = teks.splitlines()
    for i, b in enumerate(baris):
        for isi, tengah in segmen(b):
            if bukan_isi(isi, berulang):
                continue
            if 4 <= len(isi) <= 45 and isi.upper() == isi and re.search('[A-Z]{3}', isi):
                judul = isi
                for lanjut in baris[i + 1:i + 3]:
                    cocok = [s for s, t in segmen(lanjut) if abs(t - tengah) <= 6 and s.upper() == s
                             and len(s.split()) <= 3 and re.search('[A-Z]{3}', s) and not bukan_isi(s, berulang)]
                    if not cocok:
                        break
                    judul += ' ' + cocok[0]
                return judul
            # Baris isi pertama bukan judul huruf besar: halaman tanpa judul.
            if len(isi) > 45:
                return ''
    return ''


ALAMAT_RE = re.compile(r'\b(jl|jalan|kabupaten|kab|kecamatan|kec|desa|kelurahan|kota|provinsi|rt|rw|'
                       r'blok|perumahan|komplek|kompleks|kode ?pos|gedung|lantai)\b', re.I)


# Judul kolom daftar proyek terbaca sebagai kalimat biasa: deck BACh memuat baris
# "No Name Of Project Year Costumer" di beberapa slide, dan itu sempat terbit sebagai
# slogan di hero situs (bumiairchemitech.com 2026-09-16).
KATA_TABEL = re.compile(r'\b(no|name|nama|year|tahun|customer|costumer|client|klien|project|proyek|'
                        r'qty|quantity|jumlah|date|tanggal|description|keterangan|item|total|unit|'
                        r'price|harga|location|lokasi|status|periode|period)\b', re.I)


def kepala_tabel(baris):
    """Baris yang isinya cuma nama-nama kolom, bukan kalimat."""
    return len(KATA_TABEL.findall(baris)) >= 3


def cari_slogan(halaman, nama):
    """Slogan: kalimat ber-huruf campuran di sampul atau yang berulang, bukan alamat.

    Versi pertama memilih "Kabupaten Bekasi" karena baris alamat di kaki halaman
    paling sering berulang, sedangkan slogan asli hanya ada di beberapa halaman.
    """
    hitung = Counter()
    for t in halaman:
        hitung.update({rapi(b) for b in t.splitlines() if rapi(b)})
    sampul = {rapi(b) for b in (halaman[0] if halaman else '').splitlines() if rapi(b)}
    calon = [b for b in hitung
             if 12 <= len(b) <= 70 and b != b.upper() and len(b.split()) >= 3
             and not re.search(r'\d|@|www\.', b) and not ALAMAT_RE.search(b)
             and not kepala_tabel(b)
             and (not nama or nama.lower().replace('.', '') not in b.lower().replace('.', ''))]
    calon.sort(key=lambda b: (b not in sampul, -hitung[b], len(b)))
    if calon and (calon[0] in sampul or hitung[calon[0]] >= 2):
        return calon[0]
    return ''


def identitas_kaki(halaman, berulang, nama):
    """(subjudul, alamat, email) dari kepala & kaki halaman yang berulang.

    Alamat di compro adalah alamat usaha yang memang untuk publik; alamat di
    biodata FORM ISIAN adalah data administrasi pemilik."""
    urut = []
    for t in halaman:
        for b in t.splitlines():
            for isi, _ in segmen(b):
                if isi in berulang and isi not in urut:
                    urut.append(isi)
    subjudul = next((b for b in urut if b != nama and b.upper() == b and len(b.split()) >= 2
                     and not ALAMAT_RE.search(b) and not re.search(r'\d|@', b)), '')
    alamat = [b for b in urut if ALAMAT_RE.search(b) and not EMAIL_RE.search(b)]
    email = next((m for b in urut for m in EMAIL_RE.findall(b)), '')
    if not email:
        email = next((m for t in halaman for m in EMAIL_RE.findall(t)), '')
    return subjudul, ', '.join(alamat), email


def isi_prakata(teks, berulang, judul, slogan):
    """Paragraf sambutan + penanda tangan, disalin apa adanya dari halaman prakata."""
    baris = teks.splitlines()
    mulai = next((i for i, b in enumerate(baris) if judul.split()[0] in b), -1)
    akhir = next((i for i, b in enumerate(baris) if re.search(r'hormat kami|salam', b, re.I)), len(baris))
    if mulai < 0 or akhir <= mulai:
        return {}
    buang = lambda s: bukan_isi(s, berulang) or s == slogan or ALAMAT_RE.search(s) and s in berulang
    isi = [' '.join(s for s, _ in segmen(b) if not buang(s)) for b in baris[mulai + 1:akhir]]
    isi = [rapi(b) for b in isi if rapi(b)]
    if not isi:
        return {}
    panjang = max(len(b) for b in isi)
    paragraf, kini = [], []
    for b in isi:
        kini.append(b)
        # Baris yang berakhir titik dan lebih pendek dari lebar kolom = akhir paragraf.
        if b.endswith('.') and len(b) < panjang * 0.85:
            paragraf.append(' '.join(kini))
            kini = []
    if kini:
        paragraf.append(' '.join(kini))
    tanda = []
    for b in baris[akhir + 1:]:
        potong = [s for s, _ in segmen(b) if not buang(s)]
        if potong:
            tanda.append(potong[-1])
    perusahaan = next((t for t in tanda if re.match(r'^(PT|CV|UD)\b', t, re.I)), '')
    orang = [t for t in tanda if t != perusahaan and len(t) <= 40]
    return {'paragraf': paragraf, 'salam': rapi(baris[akhir]) if akhir < len(baris) else '',
            'perusahaan': perusahaan, 'nama': orang[0] if orang else '',
            'jabatan': orang[1] if len(orang) > 1 else ''}


# ---------- warna ----------

def warna_logo(path):
    """(utama, aksen) dari piksel logo: sinyal warna merek paling tepercaya.

    Menghitung warna halaman compro memberi bobot pada warna TEKS — slogan kuning
    di kaki halaman terhitung per huruf dan mengalahkan bidang merah — sedangkan
    logo hanya berisi warna merek itu sendiri."""
    try:
        lebar, tinggi, kanal, baris = baca_png(path)
    except (ValueError, OSError, zlib.error):
        return '', ''
    ember, sampel = Counter(), {}
    for y in range(tinggi):
        for x in range(lebar):
            o = x * kanal
            if kanal == 4 and baris[y][o + 3] < 200:
                continue
            r, g, b = baris[y][o], baris[y][o + 1], baris[y][o + 2]
            h, l, sat = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
            if sat < 0.4 or not 0.12 <= l <= 0.72:
                continue
            rona = round(h * 24) % 24
            ember[rona] += 1
            kumpulan = sampel.setdefault(rona, [])
            if len(kumpulan) < 500:
                kumpulan.append((r, g, b))
    utama_dua = [h for h, n in ember.most_common(4) if n >= lebar * tinggi * 0.03]
    if not utama_dua:
        return '', ''

    def rata(rona):
        px = sampel[rona]
        return tuple(sum(p[k] for p in px) // len(px) for k in range(3))

    def terang(rgb):
        return colorsys.rgb_to_hls(*(c / 255 for c in rgb))[1]

    warna = [rata(h) for h in utama_dua]
    if len(warna) == 1:
        return heks(warna[0]), ''
    jarak = lambda a, b: min(abs(a - b), 24 - abs(a - b))
    pasangan = next(((a, b) for i, a in enumerate(utama_dua) for b in utama_dua[i + 1:] if jarak(a, b) >= 3), None)
    if not pasangan:
        return heks(warna[0]), ''
    a, b = rata(pasangan[0]), rata(pasangan[1])
    # Warna yang lebih gelap jadi warna utama (latar bertulisan putih), yang lain aksen.
    return (heks(a), heks(b)) if terang(a) <= terang(b) else (heks(b), heks(a))


def warna_compro(pdf, jumlah, tmp):
    """(utama, aksen, rincian) dari warna isian teks & bentuk di lapisan vektor PDF.

    Menghitung piksel halaman ikut menghitung foto: di compro MAS, rona zaitun
    dari foto karung sempat mengalahkan navy judul. Lapisan vektor (pdftocairo
    -svg) hanya berisi teks, garis, dan bidang warna buatan desainer — foto
    menjadi elemen <image> yang tidak ikut dihitung.
    """
    hitung = Counter()
    for i in range(1, min(jumlah, 20) + 1):
        tujuan = tmp / f'v-{i}.svg'
        jalankan(['pdftocairo', '-svg', '-f', str(i), '-l', str(i), str(pdf), str(tujuan)], timeout=120)
        try:
            svg = tujuan.read_text(errors='replace')
        except OSError:
            continue
        # pdftocairo menulis warna di atribut style ("fill:rgb(3.5%,11.8%,41.2%)"),
        # kadang di atribut fill — keduanya dibaca.
        for r, g, b in re.findall(r'fill[:=]"?\s*rgb\(([\d.]+)%,\s*([\d.]+)%,\s*([\d.]+)%\)', svg):
            rgb = tuple(round(float(x) * 2.55) for x in (r, g, b))
            hitung[rgb] += 1

    def ciri(rgb):
        h, l, sat = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
        return round(h * 24) % 24, l, sat

    def jarak(a, b):
        return min(abs(a - b), 24 - abs(a - b))

    jenuh = [(rgb, n) for rgb, n in hitung.most_common() if ciri(rgb)[2] >= 0.35 and 0.08 <= ciri(rgb)[1] <= 0.75]
    rincian = {heks(rgb): n for rgb, n in jenuh[:6]}
    # Utama: warna jenuh gelap (cocok untuk latar bertulisan putih) yang paling sering dipakai.
    utama = next(((rgb, n) for rgb, n in jenuh if ciri(rgb)[1] <= 0.42), None)
    aksen = None
    if utama:
        aksen = next(((rgb, n) for rgb, n in jenuh
                      if rgb != utama[0] and jarak(ciri(rgb)[0], ciri(utama[0])[0]) >= 3), None)
    return heks(utama[0]) if utama else '', heks(aksen[0]) if aksen else '', rincian


def warna_sorot(rincian, utama, aksen):
    """Warna ketiga & keempat desainer compro (mis. biru muda subjudul, kuning slogan).

    Biru muda berona dekat dengan navy utama, jadi pembedanya boleh berupa
    kecerahan, bukan hanya rona."""
    def rona(h):
        return round(hls(h)[0] * 24) % 24

    def beda(a, b):
        jarak = min(abs(rona(a) - rona(b)), 24 - abs(rona(a) - rona(b)))
        return jarak >= 3 or abs(hls(a)[1] - hls(b)[1]) >= 0.2

    dipilih = []
    for warna in rincian:
        if hls(warna)[1] < 0.45 or hls(warna)[2] < 0.5:
            continue
        if all(beda(warna, x) for x in [w for w in (utama, aksen) if w] + dipilih):
            dipilih.append(warna)
    return (dipilih + ['', ''])[:2]


def warna_latar(pdf, jumlah, tmp):
    """Warna dasar halaman compro (krem, abu, dsb.) dari render beresolusi rendah."""
    jalankan(['pdftoppm', '-r', '12', '-png', '-l', str(min(jumlah, 20)), str(pdf), str(tmp / 'latar')], timeout=180)
    ember, contoh = Counter(), {}
    for berkas in sorted(tmp.glob('latar-*.png')):
        try:
            lebar, tinggi, kanal, baris = baca_png(berkas)
        except (ValueError, OSError, zlib.error):
            continue
        for y in range(tinggi):
            for x in range(lebar):
                rgb = tuple(baris[y][x * kanal:x * kanal + 3])
                if colorsys.rgb_to_hls(*(c / 255 for c in rgb))[1] < 0.8:
                    continue
                kunci = tuple(c // 8 for c in rgb)
                ember[kunci] += 1
                contoh.setdefault(kunci, rgb)
    if not ember:
        return ''
    return heks(contoh[ember.most_common(1)[0][0]])


# ---------- gambar ----------

def ekstrak_gambar(pdf, jumlah, tmp):
    """Daftar gambar tertanam: halaman, urutan di halaman, ukuran, berkas."""
    daftar = []
    keluaran = jalankan(['pdfimages', '-list', str(pdf)]).stdout.splitlines()[2:]
    jalankan(['pdfimages', '-all', str(pdf), str(tmp / 'img')], timeout=300)
    berkas = sorted(tmp.glob('img-*'))
    per_halaman = Counter()
    for baris, path in zip(keluaran, berkas):
        kolom = baris.split()
        if len(kolom) < 5:
            continue
        halaman = int(kolom[0])
        daftar.append({'halaman': halaman, 'urut': per_halaman[halaman], 'jenis': kolom[2],
                       'lebar': int(kolom[3]), 'tinggi': int(kolom[4]), 'path': path})
        per_halaman[halaman] += 1
    return daftar


def rgb_terurai(pdf, g, tmp):
    """Piksel RGB gambar ke-`urut` di halamannya (JPEG diurai poppler ke PNG)."""
    if g['path'].suffix.lower() == '.png':
        return baca_png(g['path'])
    folder = tmp / f"png-{g['halaman']}"
    if not folder.is_dir():
        folder.mkdir()
        jalankan(['pdfimages', '-png', '-f', str(g['halaman']), '-l', str(g['halaman']), str(pdf),
                  str(folder / 'p')], timeout=180)
    berkas = sorted(folder.glob('p-*.png'))
    return baca_png(berkas[g['urut']])


def hiasan(baris, kanal, alpha, lebar, tinggi):
    """Grafis hiasan (panah, bentuk polos) — bukan foto.

    Compro MAS memuat panah merah bermask di halaman layanan; tanpa saringan ini
    panah itu dipasang sebagai foto kartu "Karung Sak"."""
    tampak, rona = 0, Counter()
    for y in range(0, tinggi, 3):
        for x in range(0, lebar, 3):
            if alpha[y][x] < 128:
                continue
            tampak += 1
            o = x * kanal
            h, l, s = colorsys.rgb_to_hls(*(c / 255 for c in baris[y][o:o + 3]))
            if s >= 0.45 and 0.15 <= l <= 0.85:
                rona[round(h * 24) % 24] += 1
    total = len(range(0, tinggi, 3)) * len(range(0, lebar, 3))
    if not tampak:
        return True
    satu_warna = rona.most_common(1)[0][1] / tampak if rona else 0
    return tampak / total < 0.6 and satu_warna >= 0.6


def polos(baris, kanal, lebar, tinggi):
    """Bidang warna/gradien latar slide — bukan foto.

    Deck bumiairchemitech.com (2026-09-16) menaruh latar abu 1536x864 di tiap slide.
    Rasionya 1.78 sehingga lolos syarat hero dan sempat jadi latar hero yang kosong."""
    # Yang membedakan bukan jumlah warnanya (gradien halus tetap punya banyak nilai),
    # melainkan detail antar piksel bertetangga: latar slide ini 0.0045, foto aslinya
    # di deck yang sama 0.13-0.14, logo 0.04.
    langkah_y = max(1, tinggi // 40)
    langkah_x = max(1, lebar // 40)
    beda = []
    for y in range(0, tinggi, langkah_y):
        seri = []
        for x in range(0, lebar, langkah_x):
            o = x * kanal
            rgb = baris[y][o:o + 3] if kanal >= 3 else bytes([baris[y][o]] * 3)
            seri.append(colorsys.rgb_to_hls(*(c / 255 for c in rgb))[1])
        beda += [abs(seri[i + 1] - seri[i]) for i in range(len(seri) - 1)]
    if not beda:
        return True
    return sum(beda) / len(beda) < 0.02


def potong_logo(gambar, tujuan):
    """Logo dari gambar kepala halaman 1: gambar lebar ber-smask, gumpalan paling kiri."""
    for i, g in enumerate(gambar):
        if not (g['halaman'] == 1 and g['jenis'] == 'image' and i + 1 < len(gambar)
                and gambar[i + 1]['jenis'] == 'smask' and g['lebar'] < 1400 and g['tinggi'] <= 400):
            continue
        try:
            lebar, tinggi, kanal, rgb = baca_png(g['path'])
            _, _, _, alpha = baca_png(gambar[i + 1]['path'])
        except (ValueError, OSError, zlib.error):
            continue
        # Kolom berisi (alpha > 40) dari kiri; berhenti di celah kosong.
        berisi = [any(alpha[y][x] > 40 for y in range(tinggi)) for x in range(lebar)]
        mulai = next((x for x, v in enumerate(berisi) if v), None)
        if mulai is None:
            continue
        # Celah pemisah diukur dari TINGGI gambar: logo MAS dan garis kepala
        # halaman hanya berjarak ±25px pada gambar selebar 705px, sehingga ambang
        # berbasis lebar (6% = 42px) menyambungkan keduanya jadi satu "strip".
        akhir, celah = mulai, 0
        for x in range(mulai, lebar):
            if berisi[x]:
                akhir, celah = x, 0
            else:
                celah += 1
                if celah > max(6, int(tinggi * 0.12)):
                    break
        baris_isi = [y for y in range(tinggi) if any(alpha[y][x] > 40 for x in range(mulai, akhir + 1))]
        if not baris_isi or (akhir - mulai) < 40:
            continue
        atas, bawah = baris_isi[0], baris_isi[-1]
        keluar = []
        for y in range(atas, bawah + 1):
            b = bytearray()
            for x in range(mulai, akhir + 1):
                o = x * kanal
                b += bytes(rgb[y][o:o + 3] if kanal == 3 else [rgb[y][o]] * 3) + bytes([alpha[y][x]])
            keluar.append(bytes(b))
        lebar_logo, tinggi_logo = akhir - mulai + 1, bawah - atas + 1
        # Logo wajar kira-kira persegi atau mendatar; strip kepala utuh bukan logo.
        if tinggi_logo < 40 or lebar_logo / tinggi_logo > 4:
            continue
        tulis_png_rgba(tujuan, lebar_logo, tinggi_logo, keluar)
        return {'berkas': str(tujuan), 'lebar': lebar_logo, 'tinggi': tinggi_logo}
    return None


def ambil_foto(pdf, gambar, keluar, tmp):
    """Foto tertanam ≥300x250 tanpa duplikat. Yang bermask dijadikan PNG transparan.

    Batas lama 400x300 membuang foto karung sak (364x360) di halaman layanan,
    dan foto bermask disalin tanpa mask sehingga latar transparannya jadi hitam."""
    foto, sidik = [], set()
    for i, g in enumerate(gambar):
        if g['jenis'] != 'image' or g['lebar'] < 300 or g['tinggi'] < 250:
            continue
        mentah = g['path'].read_bytes()
        kunci = hashlib.md5(mentah).hexdigest()
        if kunci in sidik:
            continue
        sidik.add(kunci)
        mask = gambar[i + 1] if (i + 1 < len(gambar) and gambar[i + 1]['jenis'] == 'smask'
                                 and gambar[i + 1]['lebar'] == g['lebar']
                                 and gambar[i + 1]['tinggi'] == g['tinggi']) else None
        data = {'halaman': g['halaman'], 'lebar': g['lebar'], 'tinggi': g['tinggi'],
                'transparan': False, 'banner': g['lebar'] >= g['tinggi'] * 4}
        nomor = len(foto) + 1
        try:
            alpha = baca_png(mask['path'])[3] if mask else None
        except (ValueError, OSError, zlib.error):
            alpha = None
        tembus = 0
        puncak = max(max(r) for r in alpha[::8]) if alpha else 0
        if alpha and (puncak - min(min(r) for r in alpha[::8]) < 40 or puncak < 160):
            if puncak < 230:
                # Situs meniru opasitas yang sama di atas warna latar halaman.
                data['opasitas'] = round(puncak / 255, 2)
            # Mask seragam atau serba redup = opasitas (foto sampul MAS ditaruh
            # tembus pandang di bawah kotak lavender), bukan bentuk potongan:
            # fotonya dipakai utuh.
            alpha = None
        if alpha:
            langkah = range(0, g['tinggi'], 4), range(0, g['lebar'], 4)
            tembus = sum(1 for y in langkah[0] for x in langkah[1] if alpha[y][x] < 200) / (
                len(langkah[0]) * len(langkah[1]))
        if alpha and tembus > 0.03:
            try:
                lebar, tinggi, kanal, rgb = rgb_terurai(pdf, g, tmp)
            except (ValueError, OSError, IndexError, zlib.error):
                continue
            if (lebar, tinggi) != (g['lebar'], g['tinggi']) or hiasan(rgb, kanal, alpha, lebar, tinggi):
                continue
            # Potongan bermask juga bisa nyaris kosong (bidang putih dengan sedikit
            # tepi tembus pandang): di kartu beranda hasilnya kotak putih tanpa isi
            # — solusicerdasconsulting.com foto-04.png, 2026-09-18. Jalur foto biasa
            # sudah menyaringnya dengan `polos`; jalur potongan belum.
            if polos(rgb, kanal, lebar, tinggi):
                continue
            baris = []
            for y in range(tinggi):
                b = bytearray()
                for x in range(lebar):
                    o = x * kanal
                    # Alpha tipis di tepi potongan tampak sebagai bintik di atas kartu putih.
                    a = alpha[y][x]
                    b += bytes(rgb[y][o:o + 3] if kanal >= 3 else [rgb[y][o]] * 3) + bytes([a if a >= 64 else 0])
                baris.append(bytes(b))
            nama = f'foto-{nomor:02d}.png'
            tulis_png_rgba(keluar / nama, lebar, tinggi, baris)
            data['transparan'] = True
        else:
            ekstensi = g['path'].suffix.lower()
            if ekstensi not in ('.jpg', '.jpeg', '.png'):
                continue
            try:
                lebar, tinggi, kanal, rgb = rgb_terurai(pdf, g, tmp)
            except (ValueError, OSError, IndexError, zlib.error):
                rgb = None
            if rgb is not None and polos(rgb, kanal, lebar, tinggi):
                continue
            nama = f'foto-{nomor:02d}{ekstensi}'
            (keluar / nama).write_bytes(mentah)
        data['berkas'] = str(keluar / nama)
        foto.append(data)
    return foto


# ---------- susunan bagian ----------

JENIS_SEKSI = (
    ('prakata', r'PRAKATA|SAMBUTAN|KATA PENGANTAR'),
    ('struktur', r'STRUKTUR'),
    ('visimisi', r'\bVISI\b|\bMISI\b'),
    ('profil', r'INFORMASI PERUSAHAAN|TENTANG|PROFIL PERUSAHAAN|SEJARAH'),
    ('layanan', r'LAYANAN|\bJASA\b'),
    # Inggris ikut: compro solusicerdasconsulting.com memakai "Our Partner" &
    # "Our Client", tidak tertangkap lalu logo mitranya dipakai sebagai foto kartu
    # beranda (2026-09-18).
    ('customer', r'CUSTOMER|KLIEN|PELANGGAN|CLIENTS?\b|PARTNERS?\b|MITRA'),
    ('legalitas', r'LEGALITAS|PERIZINAN|SERTIFIKAT'),
    ('target', r'TARGET|PENCAPAIAN'),
    ('penutup', r'PENUTUP|TERIMA KASIH'),
)


def judul_rapi(judul):
    kecil = {'DAN': 'dan', 'AND': 'dan', '&': '&', 'DI': 'di', 'KE': 'ke'}
    kata = judul.strip(' :.-').split()
    return ' '.join(kecil.get(k, k.capitalize()) if i else k.capitalize() for i, k in enumerate(kata))


def susun_seksi(halaman, berulang, foto):
    """Urutan bagian compro: [{jenis, judul, kunci, halaman, foto}].

    Beranda situs disusun mengikuti urutan ini. Halaman berjudul sama yang
    berurutan ("GAMBAR & REFERENSI" lima halaman; "MARKING AREA & FINISH GOOD" /
    "MARKING AREA AND FINISH GOOD") digabung jadi satu bagian."""
    seksi = []
    for nomor, teks in enumerate(halaman, 1):
        judul = judul_halaman(teks, berulang)
        milik = [Path(f['berkas']).name for f in foto if f['halaman'] == nomor]
        if nomor == 1:
            jenis = 'sampul'
        else:
            jenis = next((j for j, pola in JENIS_SEKSI if judul and re.search(pola, judul)), '')
            if not jenis and re.search(r'\bpenutup\b|terima kasih', teks, re.I) and not milik:
                jenis = 'penutup'
            if not jenis:
                jenis = 'foto' if milik and judul else ''
        if not jenis:
            continue
        normal = re.sub(r'[^A-Z0-9]', '', re.sub(r'\bAND\b', '&', judul.upper()))
        if seksi and seksi[-1]['jenis'] == jenis and seksi[-1]['_normal'] == normal:
            seksi[-1]['halaman'].append(nomor)
            seksi[-1]['foto'] += milik
            continue
        kunci = jenis if jenis != 'foto' else re.sub(r'[^a-z0-9]+', '-', judul.lower()).strip('-')[:40]
        seksi.append({'jenis': jenis, 'judul': judul_rapi(judul) if judul else '', 'kunci': kunci,
                      'halaman': [nomor], 'foto': milik, '_normal': normal})
    for s in seksi:
        s.pop('_normal')
    return seksi


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    if len(args) != 1:
        print('usage: compro-klien <domain> [--segar]', file=sys.stderr)
        return 2
    domain = args[0].lower()
    keluar = OUT_ROOT / domain
    hasil_json = keluar / 'compro.json'
    if hasil_json.is_file() and '--segar' not in sys.argv:
        try:
            versi = json.loads(hasil_json.read_text()).get('versi', 1)
        except (OSError, ValueError):
            versi = 0
        if versi >= VERSI:
            print(f'compro: memakai hasil tersimpan {hasil_json}')
            return 0
        print(f'compro: hasil tersimpan versi {versi} (sekarang {VERSI}), dibaca ulang')
    pdf = cari_compro(domain)
    if not pdf:
        print('compro: tidak ada company profile PDF di folder klien')
        return 0
    for alat in ('pdftoppm', 'pdfimages', 'pdftotext', 'pdfinfo', 'pdftocairo'):
        if not shutil.which(alat):
            print(f'compro: {alat} tidak ada (paket poppler-utils)')
            return 1
    jumlah = int(re.search(r'Pages:\s+(\d+)', jalankan(['pdfinfo', str(pdf)]).stdout or 'Pages: 0').group(1))
    if keluar.exists():
        shutil.rmtree(keluar)
    keluar.mkdir(parents=True)

    with tempfile.TemporaryDirectory() as tmp:
        tmp = Path(tmp)
        halaman = teks_per_halaman(pdf, jumlah)
        berulang = baris_berulang(halaman)
        nama = next((b for b in berulang if re.match(r'^(PT|CV|UD)\b', b, re.I)), '')
        gambar = ekstrak_gambar(pdf, jumlah, tmp)
        logo = potong_logo(gambar, keluar / 'logo.png')
        utama, aksen, rincian_warna = warna_compro(pdf, jumlah, tmp)
        sumber_warna = 'vektor'
        if logo:
            utama_logo, aksen_logo = warna_logo(logo['berkas'])
            if utama_logo:
                utama, aksen = utama_logo, aksen_logo or aksen
                sumber_warna = 'logo'
        sorot, sorot_2 = warna_sorot(rincian_warna, utama, aksen)
        latar = warna_latar(pdf, jumlah, tmp)
        foto = ambil_foto(pdf, gambar, keluar, tmp)

    slogan = cari_slogan(halaman, nama)
    subjudul, alamat, email = identitas_kaki(halaman, berulang, nama)
    for f in foto:
        f['judul_halaman'] = judul_halaman(halaman[f['halaman'] - 1], berulang)
    seksi = susun_seksi(halaman, berulang, foto)
    prakata = {}
    for s in seksi:
        if s['jenis'] == 'prakata':
            prakata = isi_prakata(halaman[s['halaman'][0] - 1], berulang,
                                  judul_halaman(halaman[s['halaman'][0] - 1], berulang), slogan)
            break
    data = {'versi': VERSI, 'pdf': str(pdf), 'halaman': jumlah, 'nama': nama, 'slogan': slogan,
            'subjudul': subjudul, 'alamat': alamat, 'email': email, 'latar': latar,
            'warna': {'utama': utama, 'aksen': aksen, 'sorot': sorot, 'sorot_2': sorot_2,
                      'sumber': sumber_warna, 'rincian': rincian_warna},
            'logo': logo, 'prakata': prakata, 'seksi': seksi, 'foto': foto}
    hasil_json.write_text(json.dumps(data, indent=2, ensure_ascii=False))
    print(f"compro: {pdf.name} — {len(foto)} foto, {len(seksi)} bagian, logo {'ada' if logo else 'tidak ada'}, "
          f"warna {utama or '-'} / {aksen or '-'} / {sorot or '-'}, latar {latar or '-'}, "
          f"slogan \"{slogan or '-'}\"")
    return 0


if __name__ == '__main__':
    sys.exit(main())
