#!/usr/bin/env node
/*
 * screenshot.jpg tema WordPress (aturan user 2026-09-16, berlaku untuk tema FSE
 * maupun child theme): 1200x900, latar polos gelap, tulisan putih berisi nama tema.
 * Tanpa berkas ini tema tampil sebagai kotak kosong di Tampilan → Tema.
 *
 * Pemakaian: tema-screenshot <nama tema> <keluaran.jpg> [warna latar hex]
 * Modul Playwright dibaca dari VELOCITY_BLOCKVAL (bawaan /var/lib/velocity/tools/blockval);
 * JPEG dikodekan Chromium karena server installer tidak punya PIL/ImageMagick.
 * Kode keluar: 0 berhasil, 1 gagal, 3 playwright-core belum terpasang.
 */
const fs = require('fs');
const path = require('path');

const [nama, keluaran, latar = '#14161c'] = process.argv.slice(2);
if (!nama || !keluaran) {
  console.log('usage: tema-screenshot <nama tema> <keluaran.jpg> [warna latar hex]');
  process.exit(1);
}
const akar = process.env.VELOCITY_BLOCKVAL || '/var/lib/velocity/tools/blockval';
const modul = path.join(akar, 'node_modules', 'playwright-core');
if (!fs.existsSync(modul)) {
  console.log('screenshot:playwright_tidak_ada');
  process.exit(3);
}
const { chromium } = require(modul);
const chrome = process.env.VELOCITY_CHROME
  || fs.readdirSync('/root/.cache/ms-playwright').filter((d) => d.startsWith('chromium-')).sort().reverse()
    .map((d) => `/root/.cache/ms-playwright/${d}/chrome-linux64/chrome`).find((p) => fs.existsSync(p));

const aman = (teks) => String(teks).replace(/[&<>"']/g, (c) => (
  { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const warna = /^#[0-9a-fA-F]{6}$/.test(latar) ? latar : '#14161c';

// Tulisan memenuhi lebar aman kanvas; nama panjang turun sendiri ke baris berikutnya.
const html = `<!DOCTYPE html><html lang="id"><head><meta charset="utf-8"><style>
  html, body { margin: 0; height: 100%; }
  body { display: flex; align-items: center; justify-content: center;
    background: ${warna}; color: #fff;
    font-family: -apple-system, "Segoe UI", Roboto, Arial, Helvetica, sans-serif; }
  p { margin: 0; padding: 0 90px; max-width: 1020px; text-align: center;
    font-weight: 700; font-size: 96px; line-height: 1.15; letter-spacing: -.01em;
    overflow-wrap: break-word; }
</style></head><body><p id="nama">${aman(nama)}</p></body></html>`;

(async () => {
  const browser = await chromium.launch({ executablePath: chrome, args: ['--no-sandbox'] });
  const berhenti = setTimeout(() => { console.log('screenshot:timeout'); process.exit(1); }, 60000);
  try {
    const page = await browser.newPage({ viewport: { width: 1200, height: 900 }, deviceScaleFactor: 1 });
    await page.setContent(html, { waitUntil: 'load' });
    // Nama tema panjang: ukuran huruf diturunkan sampai muat di kanvas.
    await page.evaluate(() => {
      const p = document.getElementById('nama');
      for (let ukuran = 96; ukuran >= 28; ukuran -= 4) {
        p.style.fontSize = ukuran + 'px';
        if (p.scrollHeight <= 640) { break; }
      }
    });
    await page.screenshot({ path: keluaran, type: 'jpeg', quality: 88 });
    clearTimeout(berhenti);
    await browser.close();
    const ukuran = fs.statSync(keluaran).size;
    console.log(`screenshot:ok ${keluaran} ${ukuran} byte`);
    process.exit(ukuran > 1000 ? 0 : 1);
  } catch (e) {
    clearTimeout(berhenti);
    console.log('screenshot:gagal ' + String(e.message).slice(0, 160));
    await browser.close().catch(() => {});
    process.exit(1);
  }
})();
