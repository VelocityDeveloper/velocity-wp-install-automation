#!/usr/bin/env python3
"""Halaman & menu untuk situs Paket G.

Pemakaian: paket-g-setup <manifest>   (butuh WP_INSTALL_SSH_KEY_FILE)

Child theme Paket G membawa blok desain berupa shortcode; halaman-halaman yang
memakainya dibuat di sini supaya PM tidak perlu menyusunnya manual:

  Layanan, Produk, Pemesanan  -> halaman baru berisi teks pembuka + shortcode
  Galeri, Hubungi Kami        -> blok desain ditambahkan di bawah teks yang ada

Menu utama disusun ulang sekali (penanda opsi `velocity_paket_g_menu`) supaya
susunan yang kemudian diatur PM tidak pernah diacak lagi.
"""
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CHILD_THEME = HERE / 'velocity-child-theme'

# slug -> (judul halaman, judul di menu, isi). {P} diganti awalan shortcode tema.
HALAMAN = (
    ('layanan', 'Layanan', 'Layanan', (
        '<p>Kebutuhan Anda ditangani satu tim — mulai dari peninjauan, penawaran '
        'tertulis, pengerjaan, sampai serah terima.</p>'
        '[{P}_layanan]<h2>Alur Kerja</h2>[{P}_alur]')),
    ('produk', 'Produk', 'Produk', (
        '<p>Pekerjaan yang paling sering diminta pelanggan.</p>[{P}_produk]')),
    ('pemesanan', 'Pemesanan', 'Pemesanan', (
        '<p>Isi formulir di bawah ini untuk mengajukan pemesanan atau konsultasi. '
        'Permintaan Anda kami terima langsung melalui email.</p>[{P}_pemesanan]')),
)
# Halaman yang sudah dibuat installer, cukup ditambahi blok desain di bawahnya.
# Profil memuat data perusahaan dari company profile klien; shortcode-nya tidak
# mencetak apa pun kalau datanya kosong, jadi aman dipasang di semua situs.
TAMBAHAN = (
    ('tentang-kami', '[{P}_profil][{P}_struktur][{P}_customer][{P}_legalitas]'),
    ('galeri', '[{P}_galeri]'),
    ('hubungi-kami', '[{P}_kontak]<h2>Ajukan Pemesanan</h2>[{P}_pemesanan]'),
)
# Portal berita custom (keputusan user 2026-09-14): halaman Redaksi, form "Kirim
# Pesan" di Hubungi Kami, rubrik jadi kategori, dan menu berisi rubrik.
HALAMAN_BERITA = (
    ('redaksi', 'Redaksi', 'Redaksi', '[{P}_redaksi]'),
)
TAMBAHAN_BERITA = (
    ('hubungi-kami', '[{P}_kontak]<h2>Kirim Pesan ke Redaksi</h2>[{P}_pemesanan]'),
)

# Urutan menu, mengikuti susunan yang ditulis klien di FORM ISIAN.
MENU = (
    ('beranda', 'Beranda'),
    ('tentang-kami', 'Profil'),
    ('layanan', 'Layanan'),
    ('produk', 'Produk'),
    ('pemesanan', 'Pemesanan'),
    ('galeri', 'Galeri Foto'),
    ('berita', 'Berita'),
    ('hubungi-kami', 'Kontak Kami'),
)

REMOTE = r'''
set -e
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done
[[ -n "$WP_BIN" ]] || { echo "wp-cli_missing"; exit 10; }
wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root; }

id_halaman() { wp post list --post_type=page --name="$1" --post_status=any --field=ID --format=ids | tr -d ' '; }

# --- halaman berisi blok desain ---
for baris in "${HALAMAN[@]}"; do
  slug=${baris%%|*}; sisa=${baris#*|}; judul=${sisa%%|*}; isi=${sisa#*|}
  id=$(id_halaman "$slug")
  if [[ -n "$id" ]]; then
    # Jangan timpa halaman yang sudah disunting orang; cukup pastikan terbit.
    if wp post get "$id" --field=post_content | grep -q '\['; then
      echo "halaman_dibiarkan:$slug"
    else
      wp post update "$id" --post_content="$isi" --post_status=publish >/dev/null
      echo "halaman_diisi:$slug:$id"
    fi
  else
    id=$(wp post create --post_type=page --post_status=publish --post_title="$judul" \
      --post_name="$slug" --post_content="$isi" --porcelain)
    echo "halaman_dibuat:$slug:$id"
  fi
done

# --- buang blok desain berawalan salah ---
# Pernah terjadi: awalan ditebak dari nama domain (jasa_) padahal tema memakai
# awalan lain (jki_), sehingga halaman berisi shortcode tanpa fungsi yang
# tercetak apa adanya ke pengunjung.
cat > /tmp/velocity-sc.php <<'PHP'
<?php
global $shortcode_tags;
$blok = 'layanan|produk|galeri|alur|pemesanan|kontak|redaksi';
$bersih = 0;
foreach (get_pages(array('post_status' => 'publish,draft,private')) as $p) {
    $isi = (string) $p->post_content;
    $baru = preg_replace_callback('/\[([a-z0-9]+)_(' . $blok . ')\]/', function ($m) use ($shortcode_tags) {
        return isset($shortcode_tags[$m[0 + 1] . '_' . $m[2]]) ? $m[0] : '';
    }, $isi);
    if ($baru !== $isi) {
        wp_update_post(array('ID' => $p->ID, 'post_content' => $baru));
        echo 'shortcode_nyasar_dibuang:' . $p->post_name . PHP_EOL;
        $bersih++;
    }
}
if (!$bersih) { echo 'shortcode_nyasar:tidak ada' . PHP_EOL; }
PHP
wp eval-file /tmp/velocity-sc.php
rm -f /tmp/velocity-sc.php

# --- blok desain di halaman yang sudah ada ---
for baris in "${TAMBAHAN[@]}"; do
  slug=${baris%%|*}; blok=${baris#*|}
  id=$(id_halaman "$slug")
  [[ -n "$id" ]] || { echo "halaman_tidak_ada:$slug"; continue; }
  isi=$(wp post get "$id" --field=post_content)
  penanda=${blok%%]*}]
  if [[ "$isi" == *"$penanda"* ]]; then
    echo "blok_sudah_ada:$slug"
  else
    wp post update "$id" --post_content="${isi}${blok}" >/dev/null
    echo "blok_ditambahkan:$slug"
  fi
done

# --- Tentang Kami: bagian tulisan AI yang kini dicetak shortcode data perusahaan ---
# Tanpa ini Visi/Misi/Struktur tampil dua kali: sekali dari teks AI, sekali dari
# data company profile. Bagian hanya dibuang kalau shortcode-nya benar-benar
# menghasilkan isi, jadi situs tanpa compro tetap memakai teks AI.
cat > /tmp/velocity-profil.php <<'PHP'
<?php
global $shortcode_tags;
$prefix = '';
foreach (array_keys($shortcode_tags) as $t) {
    if (preg_match('/^([a-z0-9]+)_pemesanan$/', $t, $m)) { $prefix = $m[1]; break; }
}
$p = get_page_by_path('tentang-kami');
if (!$prefix || !$p) { echo 'profil_dobel:lewati' . PHP_EOL; return; }
$topik = array(
    'visimisi'  => '/\b(visi|misi|moto|motto|target)\b/i',
    'struktur'  => '/struktur|organisasi|manajemen|tim kami/i',
    'customer'  => '/customer|pelanggan|klien kami/i',
    'legalitas' => '/legalitas|perizinan|dokumen legal/i',
);
$aktif = array();
foreach ($topik as $f => $re) {
    $fn = $prefix . '_render_' . $f;
    if (function_exists($fn) && trim((string) call_user_func($fn)) !== '') { $aktif[] = $re; }
}
$isi = (string) $p->post_content;
$dibuang = array();
$baru = preg_replace_callback('#<h2\b[^>]*>(.*?)</h2>.*?(?=<h2\b|</section>|\[|$)#is',
    function ($m) use ($aktif, &$dibuang) {
        $judul = trim(wp_strip_all_tags($m[1]));
        foreach ($aktif as $re) {
            if (preg_match($re, $judul)) { $dibuang[] = $judul; return ''; }
        }
        return $m[0];
    }, $isi);
$baru = preg_replace('#<section\b[^>]*>\s*</section>#i', '', $baru);
if ($baru !== $isi) {
    wp_update_post(array('ID' => $p->ID, 'post_content' => $baru));
    echo 'profil_dobel_dibuang:' . implode(', ', $dibuang) . PHP_EOL;
} else {
    echo 'profil_dobel:tidak ada' . PHP_EOL;
}
PHP
wp eval-file /tmp/velocity-profil.php
rm -f /tmp/velocity-profil.php

# --- rubrik portal berita -> kategori (slug sama dengan theme-data) ---
for baris in "${RUBRIK[@]}"; do
  slug=${baris%%|*}; sisa=${baris#*|}; judul=${sisa%%|*}; teks=${sisa#*|}
  tid=$(wp term list category --slug="$slug" --field=term_id 2>/dev/null | head -1)
  if [[ -z "$tid" ]]; then
    tid=$(wp term list category --name="$judul" --field=term_id 2>/dev/null | head -1)
    [[ -n "$tid" ]] && wp term update category "$tid" --slug="$slug" >/dev/null 2>&1 || true
  fi
  if [[ -z "$tid" ]]; then
    tid=$(wp term create category "$judul" --slug="$slug" --description="$teks" --porcelain 2>/dev/null || true)
    echo "rubrik_dibuat:$slug:$tid"
  else
    echo "rubrik_ada:$slug:$tid"
  fi
done

# --- menu utama ---
if [[ -n "$(wp option get velocity_paket_g_menu 2>/dev/null || true)" ]]; then
  echo "menu_skip:sudah_pernah_disusun"
else
  lokasi=$(wp menu location list --field=location 2>/dev/null | head -1)
  menu_id=$(wp menu list --fields=term_id,locations --format=json 2>/dev/null \
    | python3 -c 'import json,sys
try:
    for m in json.load(sys.stdin):
        if m.get("locations"):
            print(m["term_id"]); break
except Exception:
    pass')
  if [[ -z "$menu_id" ]]; then
    menu_id=$(wp menu create "Primary Menu" --porcelain)
    [[ -n "$lokasi" ]] && wp menu location assign "$menu_id" "$lokasi" >/dev/null
  fi
  # `wp menu item list` di WP-CLI ini hanya mengenal --fields (jamak); memakai
  # --field membuat perintah gagal dan daftarnya jadi teks error, sehingga item
  # lama tidak pernah terhapus dan menu menumpuk.
  for id in $(wp menu item list "$menu_id" --fields=db_id --format=csv 2>/dev/null | tail -n +2); do
    [[ "$id" =~ ^[0-9]+$ ]] || continue
    wp menu item delete "$id" >/dev/null 2>&1 || true
  done
  for baris in "${MENU[@]}"; do
    slug=${baris%%|*}; judul=${baris#*|}
    if [[ "$slug" == cat:* ]]; then
      tid=$(wp term list category --slug="${slug#cat:}" --field=term_id 2>/dev/null | head -1)
      [[ -n "$tid" ]] || { echo "menu_lewati:$slug"; continue; }
      wp menu item add-term "$menu_id" category "$tid" --title="$judul" >/dev/null && echo "menu_item:$judul"
      continue
    fi
    id=$(id_halaman "$slug")
    [[ -n "$id" ]] || { echo "menu_lewati:$slug"; continue; }
    wp menu item add-post "$menu_id" "$id" --title="$judul" >/dev/null && echo "menu_item:$judul"
  done
  wp option update velocity_paket_g_menu "$(date -Is)" >/dev/null
fi
echo "paket_g_setup_selesai"
'''


def read_manifest(path):
    cfg = {}
    for line in Path(path).read_text(errors='replace').splitlines():
        key, sep, value = line.partition('=')
        if sep and re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key.strip()):
            cfg[key.strip()] = value.strip()
    return cfg


def prefix_tema(domain, cfg):
    """Awalan shortcode menurut generator — cadangan kalau situs belum menjawab."""
    run = subprocess.run([sys.executable, str(CHILD_THEME), domain, '--no-download',
                          '--paket', cfg.get('paket', ''),
                          '--prefix', cfg.get('velocity_child_prefix', '')],
                         capture_output=True, text=True, timeout=120)
    for line in run.stdout.splitlines():
        key, sep, value = line.partition('=')
        if sep and key.strip() == 'prefix' and re.match(r'^[a-z][a-z0-9]{1,11}$', value.strip()):
            return value.strip()
    return ''


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    if len(args) != 1:
        print('usage: paket-g-setup <manifest>', file=sys.stderr)
        return 2
    cfg = read_manifest(args[0])
    domain = cfg.get('domain', '').lower()
    da_user = cfg.get('da_user', '')
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain) or not re.match(r'^[a-z][a-z0-9]*$', da_user):
        print('paket_g: manifest tidak valid')
        return 2
    if not key or not Path(key).is_file():
        print('paket_g: kunci SSH tidak ada')
        return 2
    docroot = f'/home/{da_user}/domains/{domain}/public_html'
    ssh = ['ssh', '-i', key, '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
           '-o', 'ConnectTimeout=15', '-p', str(cfg.get('ssh_port') or 22),
           f"{cfg.get('ssh_user') or 'root'}@{cfg['target_host']}"]
    # Utamakan awalan milik tema yang terpasang; tebakan generator hanya cadangan.
    # Sekalian dibaca jenis situs & rubrik dari theme-data (portal berita).
    php = ('<?php global $shortcode_tags; foreach (array_keys($shortcode_tags) as $t) {'
           ' if (preg_match("/^([a-z0-9]+)_pemesanan$/", $t, $m)) { $f = $m[1] . "_data";'
           ' echo wp_json_encode(array("prefix" => $m[1],'
           ' "jenis" => function_exists($f) ? call_user_func($f, "jenis") : "",'
           ' "rubrik" => function_exists($f) ? call_user_func($f, "rubrik") : array())); break; } }')
    tanya = (f'cat > /tmp/velocity-jenis.php && php -d memory_limit=512M /usr/local/bin/wp eval-file '
             f'/tmp/velocity-jenis.php --path={shlex.quote(docroot)} --allow-root 2>/dev/null; rm -f /tmp/velocity-jenis.php')
    jawab = subprocess.run(ssh + [tanya], input=php, capture_output=True, text=True, timeout=120)
    try:
        situs = json.loads((jawab.stdout.strip().splitlines() or ['{}'])[-1])
    except ValueError:
        situs = {}
    prefix = str(situs.get('prefix') or '')
    berita = situs.get('jenis') == 'berita'
    rubrik = [r for r in (situs.get('rubrik') or []) if isinstance(r, dict) and r.get('slug') and r.get('judul')]
    if not re.match(r'^[a-z][a-z0-9]{1,11}$', prefix):
        prefix = prefix_tema(domain, cfg)
        print(f'paket_g: awalan dari situs tidak terbaca, memakai tebakan generator: {prefix or "-"}')
    else:
        print(f'paket_g: awalan shortcode dari tema terpasang: {prefix}')
    if not prefix:
        print('paket_g: awalan child theme tidak diketahui, langkah dilewati')
        return 0

    def baris(items):
        return '(' + ' '.join(shlex.quote(i) for i in items) + ')'

    if berita:
        print(f"paket_g: portal berita, rubrik: {', '.join(r['judul'] for r in rubrik) or '-'}")
        halaman, tambahan = HALAMAN_BERITA, TAMBAHAN_BERITA
        menu = ([('beranda', 'Home')] + [(f"cat:{r['slug']}", r['judul']) for r in rubrik]
                + [('redaksi', 'Redaksi'), ('hubungi-kami', 'Kontak Kami')])
    else:
        halaman, tambahan, menu, rubrik = HALAMAN, TAMBAHAN, MENU, []
    header = '\n'.join([
        f'DOCROOT={shlex.quote(docroot)}',
        'HALAMAN=' + baris([f'{s}|{j}|{isi.format(P=prefix)}' for s, j, _, isi in halaman]),
        'TAMBAHAN=' + baris([f'{s}|{b.format(P=prefix)}' for s, b in tambahan]),
        'RUBRIK=' + baris([f"{r['slug']}|{r['judul']}|{r.get('teks', '')}" for r in rubrik]),
        'MENU=' + baris([f'{s}|{j}' for s, j in menu]),
    ])
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE,
                         capture_output=True, text=True, timeout=300)
    for line in (run.stdout + '\n' + run.stderr).splitlines():
        if line.strip() and not line.startswith('Warning:'):
            print(f'paket_g: {line.strip()[:200]}')
    return 0 if run.returncode == 0 else 1


if __name__ == '__main__':
    sys.exit(main())
