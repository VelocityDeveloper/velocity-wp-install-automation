#!/usr/bin/env python3
"""Paket Marketplace Biasa: VD Marketplace + beranda velocity-marketplace-child (permintaan user 2026-10-04).

Pemakaian: marketplace-biasa --plugin <manifest>    pasang & aktifkan plugin VD Marketplace
           marketplace-biasa --beranda <manifest>   isi beranda tema velocity-marketplace-child
           --paksa   jalankan juga di situs yang sudah ter-deploy (HANYA dengan persetujuan user)
(butuh WP_INSTALL_SSH_KEY_FILE; VELOCITY_LOKAL_SSH/DOCROOT untuk rig uji)

Alur paket ini di installer-runner (contoh pengerjaan manual: ghaffara.com 2026-10-04):
  child theme dari referensi form (mp1 -> velocity-marketplace-child, REF_SLUG velocity-child-theme)
  -> VD Store + pengaturan + halaman toko (vd-store, vd-store-settings) -> --plugin
  -> isi contoh & konten AI -> site-finish -> produk (toko-biasa --produk: folder produk / 8 contoh)
  -> tampilan klasik (theme-paket-biasa melewati adaptor AI tema ini) -> --beranda
  -> warna VD Store (vd-store-warna)

--plugin: zip VD Marketplace dari API plugin Velocity (slug vd-marketplace), ditembolok di
  /var/lib/velocity/packages/vd-marketplace-<versi>.zip. Plugin yang sudah ada tidak ditimpa.
  VD Marketplace butuh VD Store aktif, jadi dijalankan sesudah vd-store.
  Pendaftaran pengunjung dinyalakan (users_can_register=1, tautan Register di wp-login seperti demo mp1).

--beranda (hanya bila tema aktif velocity-marketplace-child; tema lain dilewati):
  - halaman depan = template "Marketplace: Home Page" (page-home.php)
  - Slider (aturan user 2026-10-04: minimal 2): 2-3 banner 1200x400 seperti demo mp1 — foto hero/layanan/
    foto situs (tembolok langkah tampilan) + gradasi gelap + judul, subjudul & tombol; slide 1-2 ke arsip
    produk, slide 3 ke Hubungi Kami. Foto kurang dari 2 = banner polos. Diisi bila slide < 2.
  - Promo & Terlaris > Gambar Blok Kiri (aturan user 2026-10-04): banner 670x280 dari foto produk contoh
    (cadangan: foto situs lain) "Katalog <kategori>" -> arsip produk. Produk tanpa meta `hit` diberi hit=0
    supaya "Banyak Dilihat" tampil di samping blok kiri (seperti demo), bukan blok kiri selebar halaman.
    Semua banner JPEG < 100 KB, ditembolok di /var/lib/velocity/tampilan/<domain>/mp-*.jpg, media diimpor
    sekali (meta _velocity_mp_banner = md5 berkas).
  - Kategori Chips: kategori produk berisi (maks 6) + ikon Bootstrap dari nama kategori;
    kategori produk kosong tanpa anak dihapus (kategori form yang tidak dipakai produk contoh)
  - judul Produk Terbaru = "Produk <kategori produk di form>", Tentang Kami = paragraf awal halaman Tentang Kami
  - menu utama: "Produk" (arsip store_product) sesudah Beranda
  - CSS tambahan: batas tinggi logo .vmc-brand img (logo memakai img-fluid induk, batas .custom-logo tema tidak kena)
  Pengaturan Customizer yang sudah terisi tidak ditimpa; run ulang idempoten.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from client_form import read_client_form  # noqa: E402
from folder_klien import folder_klien  # noqa: E402
from paket_toko import marketplace_biasa  # noqa: E402

SLUG = 'vd-marketplace'
TEMA = 'velocity-marketplace-child'
TEMBOLOK = Path('/var/lib/velocity/tampilan')
PRODUK_KERJA = Path('/var/lib/velocity/toko-produk')
FONT = HERE.parent / 'templates' / 'fonts'
# Ukuran gambar demo mp1.velocitydeveloper.com: slide s1/s2/s3 1200x400, blok kiri ads 670x280.
SLIDE = (1200, 400)
PROMO = (670, 280)
BATAS_BYTE = 100 * 1024
# True begitu skrip mengirim perubahan ke situs; hanya saat itu pemilik wp-content dirapikan.
DIUBAH = False


def muat(nama, berkas):
    loader = importlib.machinery.SourceFileLoader(nama, str(HERE / berkas))
    modul = importlib.util.module_from_spec(importlib.util.spec_from_loader(nama, loader))
    loader.exec_module(modul)
    return modul


finish = muat('site_finish', 'site-finish')


def log(pesan):
    print(f'marketplace: {pesan}', flush=True)


def jalankan(cfg, skrip, masukan=None, waktu=600):
    global DIUBAH
    DIUBAH = True
    ssh = finish.ssh_command(cfg, os.environ.get('WP_INSTALL_SSH_KEY_FILE', ''))
    kepala = ('set -u\nexport PATH="/usr/local/bin:/usr/bin:/bin:$PATH"\n'
              'WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done\n'
              '[[ -n "$WP_BIN" ]] || { echo "wp-cli_missing"; exit 10; }\n'
              f'DOCROOT={shlex.quote(finish.docroot(cfg["domain"].lower(), cfg.get("da_user", "")))}\n'
              'wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root; }\n')
    run = subprocess.run(ssh + ['bash', '-s'], input=kepala + skrip, capture_output=True, text=True, timeout=waktu)
    keluaran = run.stdout + '\n' + run.stderr
    for baris in keluaran.splitlines():
        if baris.strip() and not baris.startswith('Warning:'):
            log(baris.strip()[:200])
    return run.returncode, keluaran


# ---------- plugin ----------

def plugin(cfg):
    vd = muat('vd_store_pkg', 'vd-store')
    vd.SLUG = SLUG  # ambil_paket/zip_valid membaca SLUG modul: API + tembolok yang sama
    zip_path, versi = vd.ambil_paket()
    if not zip_path:
        log('plugin_gagal:paket_tidak_tersedia')
        return 1
    ssh = finish.ssh_command(cfg, os.environ.get('WP_INSTALL_SSH_KEY_FILE', ''))
    remote = f'/tmp/pkg-{SLUG}.zip'
    with open(zip_path, 'rb') as f:
        up = subprocess.run(ssh + [f'cat > {shlex.quote(remote)} && chmod 644 {shlex.quote(remote)}'],
                            stdin=f, capture_output=True, text=True, timeout=180)
    if up.returncode != 0:
        log(f'plugin_gagal:kirim:{up.stderr.strip()[-160:]}')
        return 1
    skrip = f'''
ZIP={shlex.quote(remote)}
if ! wp plugin is-active vd-store >/dev/null 2>&1; then rm -f "$ZIP"; echo "plugin_gagal:vd_store_tidak_aktif"; exit 12; fi
if [[ -d "$DOCROOT/wp-content/plugins/{SLUG}" ]]; then
  echo "plugin_dipertahankan:$(wp plugin get {SLUG} --field=version 2>/dev/null)"
else
  wp plugin install "$ZIP" 2>&1 | grep -v '^Warning:' | tail -1
fi
rm -f "$ZIP"
wp plugin is-active {SLUG} >/dev/null 2>&1 || wp plugin activate {SLUG} 2>&1 | grep -v '^Warning:' | tail -1
if wp plugin is-active {SLUG} >/dev/null 2>&1; then echo "plugin_aktif:$(wp plugin get {SLUG} --field=version 2>/dev/null)"
else echo "plugin_gagal:tidak_aktif"; exit 12; fi
# Pengunjung harus bisa daftar (tautan Register di wp-login, seperti demo mp1; user 2026-10-16 proraya.com);
# pendaftar baru dijadikan vd_member oleh VD Marketplace (hook user_register).
if [[ "$(wp option get users_can_register 2>/dev/null)" != "1" ]]; then wp option update users_can_register 1 >/dev/null 2>&1; fi
echo "registrasi:$(wp option get users_can_register 2>/dev/null)"
'''
    _, keluaran = jalankan(cfg, skrip)
    # Kode keluar bisa 0 walau WP-CLI gagal diam-diam: yang dipercaya penanda aktif.
    return 0 if re.search(r'^plugin_aktif:', keluaran, re.M) else 1


# ---------- beranda ----------

