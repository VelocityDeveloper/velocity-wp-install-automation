def kategori_form(domain):
    """Isian "Kategori Produk" di form (bukan titik-titik), mis. "Alat kesehatan"; '' bila kosong."""
    try:
        teks = read_client_form(folder_klien(domain))['text']
    except Exception:
        return ''
    m = re.search(r'kategori\s+produk\s*:\s*([^\n]+)', teks, re.I)
    nilai = re.sub(r'\s+', ' ', m.group(1)).strip(' .:-') if m else ''
    if not nilai or re.fullmatch(r'[.\s…_-]*', nilai) or len(nilai) > 40:
        return ''
    return nilai


def judul_kapital(teks):
    return ' '.join(w if w.isupper() else w.capitalize() for w in teks.split())


def judul_produk(domain):
    """'Produk <Kategori Produk di form>' bila klien mengisinya."""
    kategori = kategori_form(domain)
    return 'Produk ' + judul_kapital(kategori) if kategori else ''


# ---------- banner slider & blok kiri ----------

def huruf(nama, besar):
    from PIL import ImageFont
    for f in (FONT / f'{nama}.ttf', Path('/usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf')):
        try:
            return ImageFont.truetype(str(f), besar)
        except OSError:
            continue
    return ImageFont.load_default()


def foto_sumber(domain):
    """(foto situs untuk slide, foto produk untuk blok kiri) — hanya foto yang terbaca & cukup lebar."""
    from PIL import Image

    def layak(f):
        try:
            with Image.open(f) as im:
                return im.width >= 500 and im.height >= 300
        except Exception:
            return False
    def sidik(f):
        with Image.open(f) as im:
            g = list(im.convert('L').resize((9, 8)).getdata())
        return [g[r * 9 + c] > g[r * 9 + c + 1] for r in range(8) for c in range(8)]

    def unik(daftar):
        # Foto layanan sering potongan foto yang sama: yang mirip (dhash beda < 12 dari 64) dilewati.
        hasil, sidik_ada = [], []
        for f in daftar:
            h = sidik(f)
            if all(sum(x != y for x, y in zip(h, lain)) >= 12 for lain in sidik_ada):
                hasil.append(f)
                sidik_ada.append(h)
        return hasil
    simpan = TEMBOLOK / domain
    situs = [simpan / 'hero.jpg', *sorted(simpan.glob('layanan-*.jpg')), *[simpan / f'foto{i}.jpg' for i in (1, 2, 3)],
             simpan / 'tentang.jpg']
    # Foto produk (toko-biasa --produk): folder produk klien (produk.json), atau produk contoh Pexels.
    produk = []
    try:
        produk = [Path(p['gambar'][0]) for p in json.loads((PRODUK_KERJA / domain / 'produk.json').read_text())['produk']
                  if isinstance(p, dict) and p.get('gambar')]
    except (OSError, ValueError, TypeError, KeyError):
        pass
    produk += sorted((PRODUK_KERJA / domain / 'contoh').glob('contoh-*.jpg'))
    return unik([f for f in situs if f.is_file() and layak(f)]), unik([f for f in produk if f.is_file() and layak(f)])


def kiri_ke_kanan(ukuran):
    """Topeng L: 0 di tepi kiri -> 255 di tepi kanan."""
    from PIL import Image
    return Image.linear_gradient('L').rotate(90).resize(ukuran)


def potong(sumber, ukuran):
    """Foto dipotong menutup ukuran (object-fit: cover); tanpa foto = gradasi biru gelap polos."""
    from PIL import Image, ImageOps
    if not sumber:
        gelap, terang = Image.new('RGB', ukuran, (24, 33, 56)), Image.new('RGB', ukuran, (52, 72, 110))
        return Image.composite(terang, gelap, kiri_ke_kanan(ukuran))
    with Image.open(sumber) as im:
        return ImageOps.fit(ImageOps.exif_transpose(im).convert('RGB'), ukuran, Image.LANCZOS, centering=(0.5, 0.45))


def bungkus(teks, font, lebar, d):
    kata, baris, kini = teks.split(), [], ''
    for k in kata:
        uji = (kini + ' ' + k).strip()
        if d.textlength(uji, font=font) <= lebar or not kini:
            kini = uji
        else:
            baris.append(kini)
            kini = k
    return baris + ([kini] if kini else [])


def buat_banner(sumber, ukuran, judul, sub, tombol, tujuan):
    """Banner gaya demo mp1: foto + gradasi gelap dari kiri + judul, subjudul & tombol putih."""
    from PIL import Image, ImageDraw, ImageOps
    w, h = ukuran
    im = potong(sumber, ukuran)
    gelap = Image.new('RGB', ukuran, (12, 18, 30))
    # Gelap 80% di separuh kiri (tempat teks, tetap terbaca di foto terang), memudar habis di 90% lebar.
    topeng = kiri_ke_kanan(ukuran).point(lambda v: int(204 * min(1.0, max(0.0, (0.9 - v / 255) / 0.4))))
    im = Image.composite(gelap, im, topeng)
    d = ImageDraw.Draw(im)
    skala = h / 400
    tepi, lebar = int(64 * skala * (w / h) / 3), int(w * 0.55)
    for besar in (52, 46, 40, 34):
        fj = huruf('poppins-bold', int(besar * skala))
        baris = bungkus(judul, fj, lebar, d)
        if len(baris) <= 2:
            break
    fs, ft = huruf('poppins-semibold', int(22 * skala)), huruf('poppins-semibold', int(19 * skala))
    tj = int(fj.size * 1.18)
    tinggi = len(baris) * tj + int(14 * skala) + int(fs.size * 1.4) + int(22 * skala) + int(46 * skala)
    y = (h - tinggi) // 2
    for b in baris:
        d.text((tepi, y), b, font=fj, fill='white')
        y += tj
    y += int(14 * skala)
    sub = bungkus(sub, fs, lebar, d)[0]
    d.text((tepi, y), sub, font=fs, fill=(230, 236, 245))
    y += int(fs.size * 1.4) + int(22 * skala)
    tw = d.textlength(tombol, font=ft)
    pw, ph = int(tw + 44 * skala), int(46 * skala)
    d.rounded_rectangle((tepi, y, tepi + pw, y + ph), radius=ph // 2, fill='white')
    d.text((tepi + pw / 2, y + ph / 2), tombol, font=ft, fill=(17, 24, 39), anchor='mm')
    simpan_jpeg(im, tujuan)


def simpan_jpeg(im, tujuan, batas=BATAS_BYTE):
    for mutu in (84, 78, 72, 66, 60, 54, 48):
        im.save(tujuan, 'JPEG', quality=mutu, optimize=True, progressive=True)
        if tujuan.stat().st_size < batas:
            return
    im.resize((int(im.width * 0.85), int(im.height * 0.85))).save(tujuan, 'JPEG', quality=60, optimize=True)


def siapkan_banner(cfg, stage):
    """Berkas banner di stage + datanya untuk PHP: {'slides': [...], 'promo': {...}}."""
    domain = cfg['domain'].lower()
    kategori = kategori_form(domain)
    kecil = kategori.lower() if kategori else 'produk pilihan'
    besar = judul_kapital(kategori) if kategori else 'Produk'
    nama = cfg.get('site_title') or domain
    situs, produk = foto_sumber(domain)
    slide = [(f'Belanja {kecil} jadi lebih mudah', nama, 'Belanja Sekarang', 'katalog'),
             (f'{besar} pilihan untuk Anda', 'Lihat katalog lengkap dan pesan secara online', 'Lihat Katalog', 'katalog'),
             ('Butuh bantuan memilih produk?', 'Hubungi kami untuk konsultasi kebutuhan Anda', 'Hubungi Kami', 'kontak')]
    # Foto slide: hero langkah tampilan (lebar), lalu foto produk (relevan & beragam; foto layanan di
    # tembolok sering berulang/persegi kecil), lalu foto situs lain. Blok kiri = foto produk berikutnya.
    hero = [f for f in situs if f.name == 'hero.jpg']
    urutan = hero + produk + [f for f in situs if f.name != 'hero.jpg']
    # Minimal 2 slide; slide ke-3 hanya bila ada foto ketiga. Foto kurang = banner polos.
    slide = slide[:max(2, min(3, len(urutan)))]
    foto_slide = urutan[:len(slide)]
    promo_foto = next((f for f in produk + urutan if f not in foto_slide), (urutan or [None])[0])
    simpan = TEMBOLOK / domain
    simpan.mkdir(parents=True, exist_ok=True)
    data = {'slides': [], 'promo': {}}
    for i, (judul, sub, tombol, tujuan) in enumerate(slide, 1):
        berkas = f'mp-slide-{i}.jpg'
        buat_banner(foto_slide[i - 1] if i <= len(foto_slide) else None, SLIDE, judul, sub, tombol, simpan / berkas)
        data['slides'].append({'berkas': berkas, 'judul': judul, 'tujuan': tujuan})
    buat_banner(promo_foto, PROMO, f'Katalog {besar}', 'Temukan produk yang Anda butuhkan', 'Lihat Produk', simpan / 'mp-promo.jpg')
    data['promo'] = {'berkas': 'mp-promo.jpg', 'judul': f'Katalog {besar}', 'tujuan': 'katalog'}
    for b in data['slides'] + [data['promo']]:
        (Path(stage) / b['berkas']).write_bytes((simpan / b['berkas']).read_bytes())
    log(f"banner: slide={len(data['slides'])} foto_situs={len(situs)} foto_produk={len(produk)} "
        f"ukuran_kb={','.join(str((simpan / b['berkas']).stat().st_size // 1024) for b in data['slides'] + [data['promo']])}")
    return data


def beranda(cfg):
    import shutil
    import tempfile
    domain = cfg['domain'].lower()
    stage = Path(tempfile.mkdtemp(prefix='marketplace-banner-'))
    try:
        try:
            data = siapkan_banner(cfg, stage)
        except Exception as e:  # banner gagal tidak boleh menahan pengisian beranda lainnya
            log(f'banner_gagal:{type(e).__name__}:{str(e)[:120]}')
            data = {}
        data['judul_produk'] = judul_produk(domain)
        (stage / 'skrip.php').write_text(BERANDA_PHP)
        global DIUBAH
        DIUBAH = True
        ssh = finish.ssh_command(cfg, os.environ.get('WP_INSTALL_SSH_KEY_FILE', ''))
        remote = f'/tmp/velocity-marketplace-{domain}'
        tar = subprocess.Popen(['tar', '-czf', '-', '-C', str(stage), '.'], stdout=subprocess.PIPE)
        up = subprocess.run(ssh + [f'rm -rf {shlex.quote(remote)} && mkdir -p {shlex.quote(remote)} && tar -xzf - -C {shlex.quote(remote)}'],
                            stdin=tar.stdout, capture_output=True, text=True, timeout=300)
        tar.wait()
        if up.returncode != 0:
            log(f'gagal_kirim:{up.stderr.strip()[:200]}')
            return 1
        skrip = (f'MP_DIR={shlex.quote(remote)} MP_DATA={shlex.quote(json.dumps(data, ensure_ascii=False))} '
                 f'wp eval-file {shlex.quote(remote + "/skrip.php")} --user=1 2>&1 | grep -v "^Warning:" || true\n'
                 f'rm -rf {shlex.quote(remote)}\nwp cache flush >/dev/null 2>&1 || true\n')
        _, keluaran = jalankan(cfg, skrip)
        return 0 if re.search(r'^(selesai|dilewati):', keluaran, re.M) else 1
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    mode = '--plugin' if '--plugin' in sys.argv else '--beranda' if '--beranda' in sys.argv else ''
    if not mode or len(args) != 1:
        print(__doc__)
        return 2
    cfg = finish.read_manifest(args[0])
    domain = cfg.get('domain', '').lower()
    if not marketplace_biasa(cfg.get('paket', '')):
        log(f'dilewati:bukan_marketplace_biasa:{cfg.get("paket", "")}')
        return 0
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain) or not re.match(r'^[a-z][a-z0-9]*$', cfg.get('da_user', '')):
        log('manifest_tidak_valid')
        return 2
    # Situs yang sudah ter-deploy tidak diubah tanpa persetujuan (aturan user 2026-09-23).
    if '--paksa' not in sys.argv:
        import cari_logo
        if cari_logo.sudah_terpasang(domain):
            log('dilewati:situs_sudah_terpasang (pakai --paksa setelah disetujui user)')
            return 0
    return plugin(cfg) if mode == '--plugin' else beranda(cfg)


if __name__ == '__main__':
    kode = 1
    try:
        kode = main()
    finally:
        if DIUBAH:
            import pemilik_wp
            pemilik_wp.rapikan()
    sys.exit(kode)
