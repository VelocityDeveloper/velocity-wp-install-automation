// 6c. Header Image (user 2026-10-01, bintanglasjayakontruksi.com): tema klasik Velocity menampilkan judul
// halaman dalam di banner get_header_image(); kosong = halaman dalam tanpa banner & judul. Diisi foto
// banner beranda sekali; kalau orang menggantinya sesudah itu, dibiarkan.
// Portal berita tidak diisi (user 2026-10-06, cybernasional24.com: "Current header tidak usah di isi").
// Tema anak yang membuang seksi Customizer header_image juga tidak diisi (user 2026-10-06, oklaundryexpress.com):
// perusahaan2/property2 memakainya sebagai gambar di atas menu (tidak ada di demo) dan tak bisa dihapus dari wp-admin.
$header_disembunyikan = false;
foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator(get_stylesheet_directory(), FilesystemIterator::SKIP_DOTS)) as $berkas) {
    if ($berkas->getExtension() === 'php'
        && preg_match('#remove_section\(\s*[\'"]header_image[\'"]#', (string) file_get_contents($berkas->getPathname()))) {
        $header_disembunyikan = true; break;
    }
}
if ($header_disembunyikan && !empty($d['situs_baru']) && empty($st['header_image'])) echo "tampilan: header_image:dilewati:seksi_disembunyikan_tema\n";
if (!empty($d['situs_baru']) && empty($d['berita']) && empty($st['header_image']) && !$header_disembunyikan
    && current_theme_supports('custom-header') && !get_header_image() && !empty($media['hero'])) {
    $hid = (int) $media['hero']; $hurl = (string) wp_get_attachment_url($hid); $hm = wp_get_attachment_metadata($hid) ?: [];
    if ($hurl !== '') {
        set_theme_mod('header_image', $hurl);
        set_theme_mod('header_image_data', (object) ['attachment_id' => $hid, 'url' => $hurl, 'thumbnail_url' => $hurl,
                                                     'width' => (int) ($hm['width'] ?? 0), 'height' => (int) ($hm['height'] ?? 0)]);
        update_post_meta($hid, '_wp_attachment_is_custom_header', get_stylesheet());
        $st['header_image'] = gmdate('c');
        echo "tampilan: header_image:$hid\n";
    }
}
// 6d. Kolom kontak di Customizer tema aktif (velocity-perusahaan2 notel/email di bar atas header, dst.)
// diisi dari data klien bila belum pernah disimpan (user 2026-10-07, solomerchandiseapparel.com: bar
// kontak header kosong). Kolom dikenali dari id setting Customizer + Kirki; hanya instalasi baru.
if (!empty($d['situs_baru']) && empty($st['kontak_customizer'])) {
    $kc = (array) ($d['kontak_customizer'] ?? []);
    // Id setting dibaca dari sumber PHP tema anak + induk: customize_register di CLI gagal karena kelas
    // kontrol kustom tema (VelocityChild_Customize_Editor_Control) hanya dimuat di Customizer.
    $id_set = [];
    foreach (array_unique([get_stylesheet_directory(), get_template_directory()]) as $dir) {
        $it = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($dir, FilesystemIterator::SKIP_DOTS));
        foreach ($it as $f) {
            if ($f->getExtension() !== 'php' || strpos($f->getPathname(), '/vendor/') !== false) { continue; }
            $src = (string) file_get_contents($f->getPathname());
            if (strpos($src, 'add_setting') === false && strpos($src, "'settings'") === false && strpos($src, '"settings"') === false) { continue; }
            // Pola ketiga: daftar field yang di-loop ke add_setting($setting_id) — velocity-spa
            // 'nowa' => array('section' => ...) (tombol Booking tanpa nomor, ainakajeepmerapiadventure.com 2026-10-15).
            preg_match_all('/add_setting\(\s*[\'"]([A-Za-z0-9_\-]+)[\'"]|[\'"]settings[\'"]\s*=>\s*[\'"]([A-Za-z0-9_\-]+)[\'"]'
                . '|[\'"]([A-Za-z0-9_\-]+)[\'"]\s*=>\s*(?:array\(|\[)\s*[\'"]section[\'"]/', $src, $m, PREG_SET_ORDER);
            foreach ($m as $x) { $id_set[($x[1] ?? '') !== '' ? $x[1] : (($x[2] ?? '') !== '' ? $x[2] : $x[3])] = ''; }
        }
    }
    if (class_exists('Kirki') && !empty(Kirki::$all_fields)) {
        foreach (Kirki::$all_fields as $id => $f) {
            if (($f['option_type'] ?? 'theme_mod') === 'theme_mod') { $id_set[$id] = (string) ($f['type'] ?? ''); }
        }
    }
    $isi_kc = [];
    foreach ($id_set as $id => $jenis) {
        $k = strtolower((string) $id);
        if (strpos($k, '[') !== false || preg_match('/link|url|icon|ikon|label|title|judul|color|warna|show|enable|tampil|aktif|posisi|position|size|image|gambar|font|desc/', $k)
            || in_array($jenis, ['checkbox', 'toggle', 'switch', 'color', 'image', 'cropped_image', 'select', 'radio', 'repeater'], true)) { continue; }
        $nilai = '';
        if (preg_match('/e-?mail/', $k)) { $nilai = $kc['email'] ?? ''; }
        elseif (preg_match('/whats_?app|(^|_)wa($|_)|no_?wa/', $k)) { $nilai = $kc['wa'] ?? ''; }
        elseif (preg_match('/notel|no_?telp?($|_)|telp|telepon|phone|(^|_)hp($|_)|no_?hp|handphone/', $k)) { $nilai = $kc['telp'] ?? ''; }
        elseif (preg_match('/address|alamat/', $k)) { $nilai = $kc['alamat'] ?? ''; }
        $tersimpan = ((array) get_theme_mods())[$id] ?? '';
        if ((string) $nilai === '' || !is_scalar($tersimpan) || trim((string) $tersimpan) !== '') { continue; }
        set_theme_mod($id, $nilai); $isi_kc[] = $id;
    }
    $st['kontak_customizer'] = gmdate('c');
    echo 'tampilan: kontak_customizer:' . ($isi_kc ? implode(',', $isi_kc) : 'tidak_ada_kolom') . "\n";
}
// 6e. Beranda tema yang membaca CPT (velocity-spa: kartu "layanan" + slider "team"). CPT kosong = seksi hilang
// dan page-home.php mencetak isi halaman Beranda sebagai teks polos (ainakajeepmerapiadventure.com 2026-10-15).
// Hanya instalasi baru, sekali per tipe, hanya tipe yang di-query template beranda, dan hanya kalau belum punya isi.
$tpl_depan = (int) get_option('page_on_front') ? (string) get_post_meta((int) get_option('page_on_front'), '_wp_page_template', true) : '';
$src_depan = $tpl_depan && is_file(get_stylesheet_directory() . "/$tpl_depan") ? (string) file_get_contents(get_stylesheet_directory() . "/$tpl_depan") : '';
foreach ((array) ($d['cpt_isi'] ?? []) as $pt => $daftar) {
    if (!is_array($daftar) || !$daftar || empty($d['situs_baru']) || !post_type_exists($pt) || !empty($st["cpt_$pt"])) { continue; }
    if (!preg_match('/[\'"]post_type[\'"]\s*=>\s*[\'"]' . preg_quote($pt, '/') . '[\'"]/', $src_depan)) { continue; }
    if (get_posts(['post_type' => $pt, 'post_status' => 'any', 'numberposts' => 1, 'fields' => 'ids'])) { continue; }
    $t = time(); $n = 0;
    foreach ($daftar as $i => $it) {
        $rincian = array_values(array_filter(array_map('trim', (array) ($it['rincian'] ?? []))));
        $isi_pt = '<p>' . esc_html($it['teks'] ?? '') . '</p>' . ($rincian ? '<ul><li>' . implode('</li><li>', array_map('esc_html', $rincian)) . '</li></ul>' : '');
        // Tanggal mundur per butir: tema mengurutkan terbaru dulu, jadi urutan tampil = urutan data.
        $id = wp_insert_post(['post_type' => $pt, 'post_status' => 'publish', 'post_title' => $it['judul'], 'post_content' => $isi_pt,
            'post_date' => wp_date('Y-m-d H:i:s', $t - $i * 60)], true);
        if (is_wp_error($id)) { continue; }
        if ($rincian) { update_post_meta($id, 'fasilitas', $rincian); }
        if ($g = (int) $ganti($it['gambar'] ?? '')) { set_post_thumbnail($id, $g); }
        $n++;
    }
    if ($pt === 'team' && $n && get_theme_mod('title_team', null) === null) { set_theme_mod('title_team', $d['cpt_isi']['judul_team']); }
    $st["cpt_$pt"] = gmdate('c');
    echo "tampilan: cpt_diisi:$pt:$n\n";
}
// 7. Statistik pengunjung (sekali; kalau orang mematikannya sesudah itu, dibiarkan)
if (empty($st['statistik'])) {
    if ((string) get_option('statistik_velocity', '1') !== '1') { update_option('statistik_velocity', '1'); echo "tampilan: statistik_dinyalakan\n"; }
    $st['statistik'] = gmdate('c');
}
$st['diperbarui'] = gmdate('c');
update_option('velocity_tampilan_klasik', $st, false);
$logo_id = (int) get_theme_mod('custom_logo');
echo 'tampilan: logo=' . ($logo_id ? basename((string) get_attached_file($logo_id)) : '-') . ' tema=' . get_stylesheet() . "\n";
echo "tampilan: selesai\n";
'''


KEMBALIKAN_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
$st = get_option('velocity_tampilan_klasik', []);
$t = (string) ($d['tema'] ?? '');
$c = $st['cadangan'][$t] ?? null;
if (!$t || !is_array($c) || get_stylesheet() !== $t) { echo "kembalikan: tidak_ada_cadangan\n"; return; }
foreach ((array) $c['mods'] as $k => $v) { if ($v === null) { remove_theme_mod($k); } else { set_theme_mod($k, $v); } }
$depan = (int) get_option('page_on_front');
if ($depan) {
    if ((string) $c['tpl'] === '') { delete_post_meta($depan, '_wp_page_template'); }
    else { update_post_meta($depan, '_wp_page_template', $c['tpl']); }
}
unset($st['mods'][$t], $st['cadangan'][$t]);
update_option('velocity_tampilan_klasik', $st, false);
echo "kembalikan: selesai\n";
'''


SLOT_IKLAN_PHP = r'''<?php
// Daftar slot gambar iklan/banner tema aktif (Customizer inti & Kirki) beserta ukurannya.
require_once ABSPATH . WPINC . '/class-wp-customize-manager.php';
$slot = [];
try {
    $wpc = new WP_Customize_Manager(); $GLOBALS['wp_customize'] = $wpc; do_action('customize_register', $wpc);
    foreach ($wpc->controls() as $c) {
        if (!is_object($c->setting)) { continue; }
        $gambar = $c instanceof WP_Customize_Media_Control || preg_match('/image|upload|media/i', (string) $c->type);
        $sek = $c->section ? $wpc->get_section($c->section) : null;
        $teks = implode(' ', [$c->setting->id, $c->label, $c->description, $c->section, $sek ? $sek->title : '', $sek && $sek->panel ? $sek->panel : '']);
        if (!$gambar || !preg_match('/banner|iklan|\bads?\b|_ads?_|advert/i', $teks) || preg_match('/logo|favicon|background|latar/i', $c->setting->id)) { continue; }
        $k = $c->setting->id;
        if (preg_match('/(\d{2,4})\s*[x×]\s*(\d{2,4})/u', $c->label . ' ' . $c->description, $m)) { $ukuran = "$m[1]x$m[2]"; }
        else {
            // Tanpa keterangan ukuran (velocity-beritab1): ukuran gambar di demo tema.
            $ukuran = preg_match('/float|kiri|kanan|left|right/i', $k) ? '200x800'
                    : (preg_match('/single_?1/i', $k) ? '500x65' : (preg_match('/header_?2|home_?1/i', $k) ? '970x250' : '970x90'));
        }
        [$w, $h] = array_map('intval', explode('x', $ukuran));
        if ($w < 60 || $h < 40 || $w > 2000 || $h > 2000) { continue; }
        // Image/Upload control & Kirki (save_as url bawaan) menyimpan URL; Media/Cropped & save_as=id menyimpan ID.
        $simpan = ($c instanceof WP_Customize_Upload_Control && !($c instanceof WP_Customize_Cropped_Image_Control))
                  || (!($c instanceof WP_Customize_Media_Control) && (($c->choices['save_as'] ?? 'url') === 'url')) ? 'url' : 'id';
        $slot[$k] = ['ukuran' => "{$w}x{$h}", 'simpan' => $simpan];
    }
} catch (Throwable $t) { echo 'slot_iklan_gagal: ' . $t->getMessage() . "\n"; }
echo 'slot_iklan: ' . wp_json_encode($slot) . "\n";
// Warna utama tema aktif (primary_color Velocity: velocitytheme_option = theme_mod atau bawaan tema),
// lalu kontrol warna Customizer bernama primary/utama/tema (tema berita Kirki) beserta bawaannya.
$warna = sanitize_hex_color((string) (function_exists('velocitytheme_option') ? velocitytheme_option('primary_color', '') : get_theme_mod('primary_color', '')));
// velocity-berita-8 mewarnai situs lewat Kirki color_theme (bawaan #740106); primary_color induk tidak
// tampil, dulu banner faktualekonomi.com jadi biru #1e73be di tema merah (2026-10-07).
// Sejak 1.3.0 (tanpa Kirki, 2026-10-08) color_theme kosong mengikuti primary_color: pakai fungsi temanya.
if (function_exists('velocity_berita8_warna')) { $warna = sanitize_hex_color((string) velocity_berita8_warna()) ?: $warna; }
// velocity-berita10 1.1.0 (tanpa Kirki, 2026-10-08): pola sama, bawaan #67AB01.
elseif (function_exists('velocity_berita10_warna')) { $warna = sanitize_hex_color((string) velocity_berita10_warna()) ?: $warna; }
// velocity-berita14 1.1.0 (tanpa Kirki, 2026-10-08): pola sama, bawaan #740106.
elseif (function_exists('velocity_berita14_warna')) { $warna = sanitize_hex_color((string) velocity_berita14_warna()) ?: $warna; }
// velocity-berita16 1.1.0 (tanpa Kirki, 2026-10-08): pola sama, bawaan #44AB68.
elseif (function_exists('velocity_berita16_warna')) { $warna = sanitize_hex_color((string) velocity_berita16_warna()) ?: $warna; }
// velocity-berita17 1.1.0 (tanpa Kirki, 2026-10-08): pola sama, bawaan #20c1eb.
elseif (function_exists('velocity_berita17_warna')) { $warna = sanitize_hex_color((string) velocity_berita17_warna()) ?: $warna; }
elseif (get_stylesheet() === 'velocity-berita-8') { $warna = sanitize_hex_color((string) get_theme_mod('color_theme', '#740106')); }
// Begitu pula 16 tema anak lain ber-Kirki color_theme (berita16 bawaan #44AB68): suarapurwakarta.com
// 2026-10-07 banner biru #1e73be di tema hijau. Mod kosong = bawaan field Kirki.
elseif (class_exists('Kirki') && isset(Kirki::$all_fields['color_theme'])) {
    $warna = sanitize_hex_color((string) get_theme_mod('color_theme', '')) ?: sanitize_hex_color((string) (Kirki::$all_fields['color_theme']['default'] ?? '')) ?: $warna;
}
// velocity-berita5 1.2.0 (tanpa Kirki): color_theme kosong mengikuti primary_color, dan bila itu masih
// bawaan #1e73be tema tampil hijau demo; fungsi tema velocity_berita5_warna() = warna yang benar-benar tampil.
elseif (function_exists('velocity_berita5_warna')) { $warna = sanitize_hex_color((string) velocity_berita5_warna()) ?: $warna; }
// Kirki color_theme: "kosong" = masih bawaan (langkah 2b boleh mengisinya), "isi" = sudah dipilih.
if (class_exists('Kirki') && isset(Kirki::$all_fields['color_theme'])) {
    echo 'color_theme_kirki: ' . (get_theme_mod('color_theme', '') === '' ? 'kosong' : 'isi') . "\n";
}
if (!$warna && isset($wpc)) {
    foreach ($wpc->controls() as $c) {
        if (!is_object($c->setting) || !preg_match('/colou?r/i', (string) $c->type . ' ' . get_class($c))
            || !preg_match('/primary|utama|color_?theme|theme_?colou?r|warna_?tema/i', $c->setting->id)) { continue; }
        if ($warna = sanitize_hex_color((string) get_theme_mod($c->setting->id, $c->setting->default))) { break; }
    }
}
echo 'warna_tema: ' . ($warna ?: '-') . "\n";
'''


FOTO_ARTIKEL_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
require_once ABSPATH . 'wp-admin/includes/file.php';
require_once ABSPATH . 'wp-admin/includes/media.php';
require_once ABSPATH . 'wp-admin/includes/image.php';
$admins = get_users(['role' => 'administrator', 'number' => 1, 'orderby' => 'ID']);
wp_set_current_user($admins ? $admins[0]->ID : 1);
$kosong = get_posts(['post_type' => 'post', 'post_status' => 'publish', 'numberposts' => -1, 'orderby' => 'date', 'order' => 'ASC',
                     'meta_query' => [['key' => '_thumbnail_id', 'compare' => 'NOT EXISTS']]]);
$media = function ($kunci) use ($d, $dir) {
    $a = $d['aset'][$kunci];
    $ada = get_posts(['post_type' => 'attachment', 'post_status' => 'inherit', 'numberposts' => 1, 'fields' => 'ids',
                      'meta_key' => '_velocity_tampilan_aset', 'meta_value' => $a['sidik']]);
    if ($ada) { return (int) $ada[0]; }
    $tmp = wp_tempnam($a['file']); copy("$dir/{$a['file']}", $tmp);
    $id = media_handle_sideload(['name' => $a['file'], 'tmp_name' => $tmp], 0, $a['judul'], ['post_excerpt' => $a['caption']]);
    if (is_wp_error($id)) { return 0; }
    update_post_meta($id, '_velocity_tampilan_aset', $a['sidik']);
    update_post_meta($id, '_wp_attachment_image_alt', $a['judul']);
    return (int) $id;
};
$putar = 0; $isi = 0;
foreach ($kosong as $p) {
    if ($d['klien']) {
        $kunci = $d['klien'][$putar++ % count($d['klien'])];
    } else {
        $kat = get_the_category($p->ID);
        $kunci = $d['sampul'][$kat ? $kat[0]->name : ''] ?? ($d['sampul']['*'] ?? '');
    }
    $id = $kunci ? $media($kunci) : 0;
    if ($id) { set_post_thumbnail($p->ID, $id); $isi++; echo "foto_artikel: {$p->ID} <- $kunci\n"; }
}
echo 'foto_artikel: ' . $isi . '/' . count($kosong) . " diisi\n";
'''


def slot_iklan(cfg, domain):
    """({setting: {'ukuran': 'WxH', 'simpan': 'url'|'id'}}, warna_tema, color_theme_kirki) slot gambar iklan tema aktif, dibaca
    dari Customizer situs (ukuran dari keterangan kontrol tema, mis. "Iklan Header 728x90"), dan warna
    utama tema (#rrggbb atau '')."""
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-slot-{domain}-'))
    SEMENTARA.append(kerja)
    keluar = kirim(cfg, kerja, SLOT_IKLAN_PHP, domain) or ''
    m = re.search(r'^slot_iklan: (\{.*\}|\[\])\s*$', keluar, re.M)
    w = re.search(r'^warna_tema: (#[0-9a-fA-F]{6})\s*$', keluar, re.M)
    k = re.search(r'^color_theme_kirki: (\w+)\s*$', keluar, re.M)
    try:
        slot = (json.loads(m.group(1)) or {}) if m else {}
    except ValueError:
        slot = {}
    return slot, (w.group(1) if w else ''), (k.group(1) if k else '')


def kirim(cfg, kerja, php, domain):
    """Kirim folder kerja + skrip PHP lewat satu koneksi SSH lalu jalankan dengan wp eval-file."""
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not key or not Path(key).is_file():
        print('tampilan: kunci SSH tidak ada')
        return None
    (kerja / 'terapkan.php').write_text(php)
    finish = muat('site_finish', HERE / 'site-finish')
    ssh = finish.ssh_command(cfg, key)
    docroot = finish.docroot(domain, cfg.get('da_user', ''))
    user = cfg.get('da_user', '')
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode='w:gz') as tar:
        for f in kerja.iterdir():
            tar.add(f, arcname=f.name)
    wp = 'php -d memory_limit=512M /usr/local/bin/wp eval-file "$T/terapkan.php" "$T"'
    jalankan = (f'set -e; T=$(mktemp -d /tmp/velocity-tampilan.XXXXXX); tar xzf - -C "$T"; chmod 755 "$T"; chmod 644 "$T"/*; '
                f'cd {shlex.quote(docroot)}; '
                f'if id {shlex.quote(user)} >/dev/null 2>&1; then runuser -u {shlex.quote(user)} -- {wp} 2>&1 | grep -v Deprecated || true; '
                f'else {wp} --allow-root 2>&1 | grep -v Deprecated || true; fi; rm -rf "$T"')
    hasil = subprocess.run(ssh + [jalankan], input=buf.getvalue(), capture_output=True, timeout=600)
    keluar = hasil.stdout.decode(errors='replace')
    print(keluar.strip())
    if hasil.returncode != 0:
        print(f"tampilan: ssh_gagal (kode {hasil.returncode}) {hasil.stderr.decode(errors='replace').strip()[:300]}")
        return None
    return keluar


def foto_artikel(manifest, cfg, domain):
    try:
        isi = json.loads((GENERATED_DIR / f'{domain}-tema.json').read_text())
    except (OSError, ValueError):
        isi = {}
    nama = cfg.get('site_title') or domain
    warna = (isi.get('warna') or {}).get('utama')
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-foto-{domain}-'))
    SEMENTARA.append(kerja)
    aset, klien, sampul = {}, [], {}
    for i, (p, _, _) in enumerate(foto_klien(domain)[:8], 1):
        kunci = f'klien-{i}'
        try:
            potong(p, 1200, 800, kerja / f'{kunci}.jpg')
        except Exception:
            continue
        aset[kunci] = {'judul': f'Foto {nama}', 'caption': f'Foto: {nama}'}
        klien.append(kunci)
    if not klien:
        kategori = [l['judul'] for l in isi.get('layanan') or [] if l.get('judul')] or ['Artikel']
        for i, k in enumerate(kategori, 1):
            kunci = f'sampul-{i}'
            sampul_kategori(k, nama, warna, kerja / f'{kunci}.jpg')
            aset[kunci] = {'judul': f'Ilustrasi {k}', 'caption': f'Ilustrasi: {k} — {nama}'}
            sampul[k] = kunci
        sampul['*'] = next(iter(sampul.values()))
    for kunci, a in aset.items():
        a.update(file=f'{kunci}.jpg', sidik=f"{domain}:{kunci}:{hashlib.md5((kerja / f'{kunci}.jpg').read_bytes()).hexdigest()}")
    (kerja / 'data.json').write_text(json.dumps({'aset': aset, 'klien': klien, 'sampul': sampul}, ensure_ascii=False))
    print(f"foto_artikel: sumber={'foto_klien:' + str(len(klien)) if klien else 'sampul:' + str(len(sampul) - 1)}")
    if '--coba' in sys.argv:
        print(f'foto_artikel: folder={kerja}')
        return 0
    keluar = kirim(cfg, kerja, FOTO_ARTIKEL_PHP, domain)
    return 0 if keluar and 'diisi' in keluar else 1


GALERI_MAKS = 8


LOGO_CSS_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
$c = (string) wp_get_custom_css();
$c = preg_replace('#\s*/\* velocity-logo-header \*/.*?/\* /velocity-logo-header \*/#s', '', $c);
if ((string) ($d['css'] ?? '') !== '') {
    $c = rtrim($c) . "\n/* velocity-logo-header */\n" . $d['css'] . "\n/* /velocity-logo-header */\n";
}
wp_update_custom_css_post($c);
echo "tampilan: logo_css_ok\n";
'''


def rapikan_logo(cfg, manifest, domain, keluar_php, logo_panduan=None):
    """Logo header terbaca, tidak melewati latarnya, dan tidak memanjangkan header (user 2026-10-02):
    potret area logo (scripts/logo-header-cek) -> CSS perbaikan di Additional CSS -> ukur ulang.
    Dua putaran: ukuran dulu (logo yang dikecilkan sering sudah muat di latarnya), lalu kontras.

    logo_panduan: {lebar, tinggi, latar_putih} dari child-theme-data-setup.md (Paket F, mis. 226x65
    velocity-perusahaan1): ukuran render itu dipasang sejak putaran pertama dan jadi batas pemeriksaan;
    latar_putih = pelat putih untuk logo yang tidak kontras."""
    lh = muat('logo_header', HERE / 'logo_header.py')
    warna_pelat = None
    if logo_panduan:
        for r in lh.TINGGI_MAKS:
            lh.TINGGI_MAKS[r] = min(lh.TINGGI_MAKS[r], logo_panduan['tinggi'])
            lh.LEBAR_MAKS[r] = min(lh.LEBAR_MAKS[r], logo_panduan['lebar'])
        warna_pelat = '#ffffff' if logo_panduan.get('latar_putih') else None
    m = re.search(r'tampilan: logo=(\S+) tema=(\S+)', keluar_php or '')
    if not m or m.group(1) == '-':
        print('tampilan: logo_cek_dilewati:tanpa_logo')
        return
    nama_logo, tema = m.group(1), m.group(2)
    url = muat('adaptor_tema', HERE / 'adaptor_tema.py').situs_url(domain) + '/'
    cookie, hapus = None, None
    try:
        dca = muat('desain_claude_alat', HERE / 'desain-claude-alat')
        cookie, hapus = dca.cookie_admin(dca.FA.read_manifest(manifest), domain)
    except Exception as e:
        print(f'tampilan: logo_cek_cookie_gagal:{type(e).__name__}')
    folder = Path(tempfile.mkdtemp(prefix='theme-paket-biasa-logo-'))
    SEMENTARA.append(folder)
    try:
        css = ''
        for putaran in (1, 2, 3):
            hasil, pemilih = lh.ukur(url, folder / str(putaran), nama_logo, cookie)
            if not hasil:
                print('tampilan: logo_cek_dilewati:tidak_terpotret')
                return
            soal = lh.masalah(hasil)
            print(f"tampilan: logo_cek{putaran}: {lh.ringkas(hasil)} masalah={','.join(f'{r}:{j}' for r, j in soal) or '-'}")
            # Ukuran panduan berlaku walau logo lolos batas umum; !important supaya CSS_TEMA (250x80) tidak menang.
            dasar = (f"{pemilih}{{width:auto!important;height:auto!important;max-width:min(100%,{logo_panduan['lebar']}px)!important;"
                     f"max-height:{logo_panduan['tinggi']}px!important;object-fit:contain}}"
                     if putaran == 1 and logo_panduan and pemilih else '')
            if (not soal and not dasar) or putaran == 3:
                break
            baru = lh.susun_css(tema, pemilih, hasil, css, warna_pelat) if soal else css
            if dasar:
                baru = '\n'.join(x for x in (dasar, baru) if x)
                print(f"tampilan: logo_ukuran_panduan:{logo_panduan['lebar']}x{logo_panduan['tinggi']}")
            if baru == css:
                break
            css = baru
            kerja = folder / f'css{putaran}'
            kerja.mkdir()
            (kerja / 'data.json').write_text(json.dumps({'css': css}))
            if 'tampilan: logo_css_ok' not in (kirim(cfg, kerja, LOGO_CSS_PHP, domain) or ''):
                print('tampilan: logo_css_gagal')
                return
            print(f'tampilan: logo_css_putaran{putaran}')
    finally:
        if hapus:
            try:
                hapus()
            except Exception:
                pass


def konteks_adaptor(cfg, domain, isi, kontak, galeri=0, klien=()):
    """Data untuk penanda adaptor AI (lihat adaptor_tema.PENANDA)."""
    nama = cfg.get('site_title') or domain
    js = isi.get('judul_seksi') or {}
    return {
        'teks': {
            'nama': nama, 'slogan': isi.get('slogan') or '',
            'hero_judul': pendek(isi.get('hero_judul') or nama, 60),
            'hero_teks': pendek(isi.get('hero_teks'), 260), 'hero_teks_pendek': pendek(isi.get('hero_teks'), 130),
            'profil': isi.get('profil') or isi.get('hero_teks') or '',
            'tentang_judul': js.get('tentang') or f'Tentang {nama}',
            'layanan_judul': js.get('layanan') or 'Layanan Kami', 'layanan_sub': js.get('layanan_sub') or '',
            'keunggulan_judul': js.get('keunggulan') or 'Keunggulan Kami',
            # Telepon dikosongkan di data kontak kalau sama dengan WhatsApp; kolom telepon tema tetap diisi.
            'telp': kontak['telp'] or kontak['wa_tampil'], 'wa': kontak['wa'], 'wa_tampil': kontak['wa_tampil'],
            'wa_link': f"https://wa.me/{kontak['wa']}" if kontak['wa'] else '',
            'email': kontak['email'], 'alamat': kontak['alamat'],
            'link_kontak': '/hubungi-kami/', 'link_layanan': '/layanan/', 'link_berita': '/berita/',
        },
        'daftar': {
            'layanan': [{'slug': l['slug'], 'judul': l['judul'], 'teks': l.get('teks') or '',
                         'teks_pendek': pendek(l.get('teks'), 110), 'rincian': ', '.join(l.get('rincian') or []),
                         'ikon': ikon_layanan(l),
                         'link': f"/layanan/#{l['slug']}"} for l in kartu_beranda([l for l in isi.get('layanan') or [] if l.get('judul')])],
            'keunggulan': [{'judul': k['judul'], 'teks': k.get('teks') or ''}
                           for k in isi.get('keunggulan') or [] if k.get('judul')],
            # Galeri hanya dari foto klien sendiri (galeri-<n>.jpg), bukan foto bank.
            'galeri': [{'slug': str(i), 'judul': f'Foto {nama} {i}'} for i in range(1, galeri + 1)],
            # Logo klien/mitra: asli dari folder klien, atau logo contoh (lihat logo_klien_asli).
            'klien': [{'slug': str(i), 'judul': j} for i, j in enumerate(klien, 1)],
        },
    }


def muat_gen(manifest):
    """ai-content-generator.py sebagai modul (pemanggil AI + pemilih model)."""
    argv_lama = sys.argv
    sys.argv = [argv_lama[0], str(manifest)]
    try:
        return muat('acg_tema', HERE / 'ai-content-generator.py')
    finally:
        sys.argv = argv_lama


def panduan_paket_f(manifest, cfg, info):
    """Aturan dari child-theme-data-setup.md repo tema (scripts/panduan_tema.py), atau None.

    Permintaan user 2026-10-02: hanya child theme Paket F dan hanya instalasi baru — situs yang
    sudah ter-deploy tidak berubah karena panduan yang ditambahkan belakangan."""
    if re.sub(r'\s', '', cfg.get('paket', '').lower()) != 'paketf':
        return None
    if SITUS_LAMA:
        print('tampilan: panduan_tema:dilewati:situs_sudah_terpasang')
        return None
    import panduan_tema as pt
    tema = info['tema']
    teks, sha = pt.ambil(tema)
    if not teks:
        print(f'tampilan: panduan_tema:tidak_ada:{tema}')
        return None
    gen = muat_gen(manifest)
    aturan, alasan = pt.aturan(gen, gen.get_model('tema'), tema, teks, sha, info)
    if not aturan:
        print(f"tampilan: panduan_tema:gagal:{tema}:{','.join(alasan)}")
        return None
    sb = ','.join(w['id_base'] for w in aturan['sidebar'] or []) or '-'
    lg = f"{aturan['logo']['lebar']}x{aturan['logo']['tinggi']}" if aturan['logo'] else '-'
    print(f"tampilan: panduan_tema:dibaca:{tema}@{sha[:7]} sidebar={sb} logo={lg} "
          f"galeri_min={aturan['galeri_min'] or '-'} layanan_min={aturan['layanan_min'] or '-'}")
    for a in alasan:
        print(f'tampilan: panduan_tema_ditolak:{a}')
    for m in aturan['manual']:
        print(f'tampilan: panduan_tema_manual: {m}')
    return aturan


def adaptor_ai(manifest, at, info, panduan=''):
    """Adaptor tersimpan untuk tema+versi ini, atau minta AI membacanya dari file tema.

    panduan: petunjuk Customizer dari child-theme-data-setup.md, dipakai saat adaptor BARU dibuat;
    adaptor yang sudah terverifikasi tidak dibuat ulang karena panduan."""
    catatan = at.muat_adaptor(info) or {}
    if catatan.get('status') in ('terverifikasi', 'belum_diperiksa') and catatan.get('adaptor'):
        print(f"tampilan: adaptor_ai_tersimpan:{catatan['status']}")
        return catatan
    if catatan.get('status') == 'gagal' and int(catatan.get('percobaan') or 0) >= 3:
        print(f"tampilan: adaptor_ai_menyerah:{catatan.get('alasan')}")
        return None
    gen = muat_gen(manifest)
    model = gen.get_model('tema')
    if not model:
        print('tampilan: adaptor_ai_tanpa_model')
        return None
    print(f"tampilan: adaptor_ai_membaca_tema:{info['tema']} {info.get('versi')} ({len(info['file'])} file)")
    adaptor = at.minta_ai(gen, model, info, catatan.get('alasan', '') if catatan.get('status') == 'gagal' else '', panduan)
    if not adaptor:
        at.simpan_adaptor(info, {**catatan, 'status': 'gagal', 'alasan': 'ai_tidak_menghasilkan_adaptor_valid',
                                 'percobaan': int(catatan.get('percobaan') or 0) + 1})
        print('tampilan: adaptor_ai_gagal_dibuat')
        return None
    catatan = {'tema': info['tema'], 'versi': info.get('versi'), 'status': 'belum_diperiksa', 'adaptor': adaptor,
               'percobaan': int(catatan.get('percobaan') or 0) + 1, 'model': model.get('id')}
    at.simpan_adaptor(info, catatan)
    print(f"tampilan: adaptor_ai_dibuat: template={adaptor.get('template')} mods={','.join(adaptor['mods'])}")
    return catatan


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    coba = '--coba' in sys.argv
    if len(args) != 1:
        print('usage: theme-paket-biasa [--foto-artikel] <manifest> [--coba]', file=sys.stderr)
        return 2
    manifest = Path(args[0])
    cfg = read_manifest(manifest)
    domain = cfg.get('domain', '').lower()
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain):
        print('tampilan: manifest_tidak_valid')
        return 2
    if '--foto-artikel' in sys.argv:
        return foto_artikel(manifest, cfg, domain)
    global SITUS_LAMA
    SITUS_LAMA = muat('cari_logo', HERE / 'cari_logo.py').sudah_terpasang(domain) and '--paksa' not in sys.argv
    if re.sub(r'\s', '', cfg.get('paket', '').lower()) in PAKET_CUSTOM or cfg.get('tema_fse'):
        print('tampilan: dilewati:paket_custom_atau_tema_fse')
        return 0
    # Landing Page Biasa baru: tema velocity-landing diisi scripts/landing-konten (keputusan user
    # 2026-09-30). Landing lama yang sudah ter-deploy masih memakai child theme klasiknya.
    if re.sub(r'\s', '', cfg.get('paket', '').lower()) == 'paketlandingpagebiasa' and not SITUS_LAMA:
        print('tampilan: dilewati:landing_page (landing-konten)')
        return 0
    simpanan = GENERATED_DIR / f'{domain}-tema.json'
    if not simpanan.is_file():
        subprocess.run([sys.executable, str(HERE / 'paket-g-konten'), str(manifest)], check=False)
    try:
        isi = json.loads(simpanan.read_text())
    except (OSError, ValueError):
        print('tampilan: isi_contoh_tidak_ada, langkah dilewati')
        return 1
    if isi.get('jenis') == 'berita':
        isi = {**isi, 'layanan': []}
    vct = muat('velocity_child_theme', HERE / 'velocity-child-theme')
    dk = vct.data_klien(domain, cfg.get('site_title', ''))
    wa = dk.get('WA', '')
    kontak = {'alamat': dk.get('ALAMAT', ''), 'telp': dk.get('TELP', ''), 'wa': wa,
              'wa_tampil': dk.get('TELP', '') or ('0' + wa[2:] if wa else ''), 'email': dk.get('EMAIL_PUBLIK', ''),
              'area': dk.get('AREA', ''),
              # Nomor kedua klien (user 2026-10-01); situs yang sudah ter-deploy tetap satu nomor.
              'wa2': '' if SITUS_LAMA else dk.get('WA2', ''),
              'wa2_tampil': '' if SITUS_LAMA else (dk.get('TELP2', '') or ('0' + dk['WA2'][2:] if dk.get('WA2') else ''))}
    if kontak['telp'] and wa and re.sub(r'\D', '', kontak['telp']).lstrip('0') in (wa[2:], kontak['wa2'][2:]):
        kontak['telp'] = ''  # nomor yang sama cukup tampil sebagai WhatsApp
    print(f"tampilan: kontak alamat={'ya' if kontak['alamat'] else '-'} wa={'ya' if wa else '-'} "
          f"email={'publik' if kontak['email'] else 'tidak_ada'}")
    logo_klien = logo_klien_asli(domain)
    klien_judul = ([re.sub(r'[-_]+', ' ', p.stem).strip().title() or f'Logo klien {i}' for i, p in enumerate(logo_klien, 1)]
                   or [f'Logo klien {i} (contoh)' for i in range(1, KLIEN_CONTOH + 1)])
    print(f"tampilan: logo_klien={'asli:' + str(len(logo_klien)) if logo_klien else 'contoh:' + str(KLIEN_CONTOH)}")
    data = susun(domain, cfg, isi, kontak, len(klien_judul))
    data['berita'] = isi.get('jenis') == 'berita'
    data['template'] = {}

    # Tema aktif dibaca dari server: adaptor buatan tangan dulu, AI untuk tema yang belum dikenal.
    sys.path.insert(0, str(HERE))
    import adaptor_tema as at
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    finish = muat('site_finish', HERE / 'site-finish')
    klien = foto_klien(domain)
    simpan = TEMBOLOK / domain
    galeri = [f'galeri-{i}' for i in range(1, GALERI_MAKS + 1)
              if i <= len(klien) or (simpan / f'galeri-{i}.jpg').is_file()]
    info, catatan_ai, ctx = None, None, konteks_adaptor(cfg, domain, isi, kontak, len(galeri), klien_judul)
    if key and Path(key).is_file():
        try:
            info = at.baca_tema(finish.ssh_command(cfg, key), finish.docroot(domain, cfg.get('da_user', '')), cfg.get('da_user', ''))
        except Exception as e:
            print(f'tampilan: baca_tema_gagal:{e}')
    tema = (info or {}).get('tema', '')
    # Panduan pembuat tema (Paket F): widget sidebar, ukuran logo, jumlah galeri, petunjuk adaptor.
    panduan = None
    if info and tema not in at.BUKAN_ANAK:
        try:
            panduan = panduan_paket_f(manifest, cfg, info)
        except Exception as e:  # panduan tidak boleh menggagalkan langkah tampilan
            print(f'tampilan: panduan_tema:gagal:{type(e).__name__}:{str(e)[:120]}')
    if panduan:
        data['panduan'] = {'sidebar': panduan['sidebar']}
        if panduan['galeri_min'] and len(galeri) < panduan['galeri_min']:
            # Foto klien kurang dari minimal panduan: sisanya foto contoh bebas lisensi (di bawah).
            galeri = [f'galeri-{i}' for i in range(1, panduan['galeri_min'] + 1)]
            ctx = konteks_adaptor(cfg, domain, isi, kontak, len(galeri), klien_judul)
            print(f"tampilan: panduan_galeri_min:{panduan['galeri_min']} foto_klien={len(klien)}")
        n_layanan = len([l for l in isi.get('layanan') or [] if l.get('judul')])
        if panduan['layanan_min'] and n_layanan < panduan['layanan_min']:
            print(f"tampilan: panduan_layanan_kurang:{n_layanan}/{panduan['layanan_min']}")
    maks = LAYANAN_BERANDA_MAKS.get(tema)
    if maks and not SITUS_LAMA and len(ctx['daftar']['layanan']) > maks:
        print(f"tampilan: layanan_beranda_maks:{len(ctx['daftar']['layanan'])}->{maks}")
        ctx['daftar']['layanan'] = ctx['daftar']['layanan'][:maks]
    paksa_ai = '--paksa-ai' in sys.argv
    if tema in BERANDA_LANGKAH_SENDIRI:
        print(f'tampilan: adaptor_dilewati:beranda_oleh_{BERANDA_LANGKAH_SENDIRI[tema]}')
    elif info and tema not in at.BUKAN_ANAK and (tema not in data['mods'] or paksa_ai):
        catatan_ai = adaptor_ai(manifest, at, info, (panduan or {}).get('adaptor', ''))
        if catatan_ai:
            ad = catatan_ai['adaptor']
            data['mods'][tema] = at.isi_nilai(ad['mods'], ctx)
            if not SITUS_LAMA:
                ikon_per_layanan(data['mods'][tema], ctx['daftar']['layanan'])
            data['bawaan'][tema] = ad.get('bawaan') or {}
            data['template'][tema] = ad.get('template') or ''
            data['cadangan'] = True

    # Gambar: foto klien dulu, lalu foto contoh bank foto, lalu banner polos.
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-{domain}-'))
    SEMENTARA.append(kerja)
    layanan = [l for l in isi.get('layanan') or [] if l.get('judul')]
    pendamping = ['foto1', 'foto2', 'foto3']
    kunci_perlu = ['hero', 'tentang'] + [f'layanan-{l["slug"]}' for l in layanan] + pendamping + galeri
    if all((simpan / f'{k}.jpg').is_file() for k in kunci_perlu):
        klien = []  # semua gambar sudah pernah disiapkan
        sumber = {k: simpan / f'{k}.jpg' for k in kunci_perlu}
        print('tampilan: gambar_tembolok')
    else:
        sumber = {}
    if klien:
        # Foto klien dipakai bergilir untuk semua slot: foto bank yang mengisi sisa slot pernah
        # berupa pindaian arsip tua di situs yang punya lima foto armada sendiri.
        for i, kunci in enumerate(k for k in kunci_perlu if k not in galeri):
            sumber[kunci] = klien[i % len(klien)][0]
        for i, kunci in enumerate(galeri[:len(klien)]):
            sumber[kunci] = klien[i][0]
    for kunci in galeri:
        if kunci not in sumber and (simpan / f'{kunci}.jpg').is_file():
            sumber[kunci] = simpan / f'{kunci}.jpg'
    slot = []
    if 'hero' in sumber and 'tentang' in sumber and all(k in sumber for k in kunci_perlu):
        pass
    elif 'hero' not in sumber:
        slot.append(('hero', isi.get('hero_foto') or '', 'Banner beranda'))
    if 'tentang' not in sumber:
        slot.append(('tentang', isi.get('tentang_foto') or '', 'Foto tentang kami'))
    slot += [(f'layanan-{l["slug"]}', l.get('foto') or l['judul'], l['judul'])
             for l in layanan if f'layanan-{l["slug"]}' not in sumber]
    slot += [(k, isi.get('hero_foto') or '', f'Foto {i}') for i, k in enumerate(pendamping, 1) if k not in sumber]
    if panduan and panduan['galeri_min']:
        # Galeri minimal panduan (Paket F): slot yang tidak terisi foto klien/tembolok pakai kata kunci isi contoh.
        kata = [g for g in isi.get('galeri') or [] if isinstance(g, dict)]
        slot += [(k, (kata[i]['foto'] if i < len(kata) and kata[i].get('foto') else isi.get('hero_foto') or ''),
                  kata[i].get('judul') or f'Galeri {i + 1}' if i < len(kata) else f'Galeri {i + 1}')
                 for i, k in enumerate(galeri) if k not in sumber]
    slot = [s for s in slot if s[1]]
    if klien:
        print(f'tampilan: foto_klien={len(klien)}')
    slot = [s for s in slot if s[0] not in sumber]
    sumber.update({k: v for k, v in foto_contoh(manifest, isi, slot).items() if k not in sumber})
    aset = {}
    ukuran = {'hero': (1800, 800), 'tentang': (800, 900), **{k: (800, 800) for k in pendamping + galeri}}
    for kunci, berkas in sumber.items():
        w, h = ukuran.get(kunci, (600, 600))
        try:
            if Path(berkas).parent == simpan:
                tujuan = kerja / f'{kunci}.jpg'
                tujuan.write_bytes(Path(berkas).read_bytes())
            else:
                tujuan = potong(berkas, w, h, kerja / f'{kunci}.jpg')
        except Exception as e:
            print(f'tampilan: gambar_gagal:{kunci}:{type(e).__name__}')
            continue
        aset[kunci] = tujuan
    if 'hero' not in aset:
        aset['hero'] = banner_polos(data['nama'], (isi.get('warna') or {}).get('utama'), kerja / 'hero.jpg')
        print('tampilan: banner_polos')
    for i, kunci in enumerate(pendamping):
        cadangan = [k for k in ['tentang'] + [f'layanan-{l["slug"]}' for l in layanan] + ['hero'] if k in aset]
        if kunci not in aset and cadangan:
            aset[kunci] = potong(aset[cadangan[i % len(cadangan)]], 800, 800, kerja / f'{kunci}.jpg')
    # Logo klien asli, atau logo contoh. Hasilnya selalu sama per sumber, jadi sidik md5-nya tetap
    # dan run ulang memakai lampiran yang sudah ada (tanpa tembolok: logo asli yang dikirim
    # belakangan langsung menggantikan contoh).
    for i in range(1, len(klien_judul) + 1):
        kunci = f'klien-{i}'
        try:
            if logo_klien:
                aset[kunci] = kanvas_logo(logo_klien[i - 1], kerja / f'{kunci}.jpg')
            else:
                aset[kunci] = logo_contoh(i, kerja / f'{kunci}.jpg')
        except Exception as e:
            print(f'tampilan: logo_klien_gagal:{kunci}:{type(e).__name__}')
    if not coba:
        simpan.mkdir(parents=True, exist_ok=True)
        for kunci, berkas in aset.items():
            if Path(berkas).parent != simpan:
                (simpan / f'{kunci}.jpg').write_bytes(Path(berkas).read_bytes())
    judul = {'hero': f"Banner {data['nama']}", 'tentang': f"Tentang {data['nama']}"}
    judul.update({f'layanan-{l["slug"]}': l['judul'] for l in layanan})
    judul.update({k: f"Foto {data['nama']}" for k in pendamping})
    judul.update({k: f"Galeri {data['nama']} {k.split('-')[1]}" for k in galeri})
    judul.update({f'klien-{i}': j for i, j in enumerate(klien_judul, 1)})
    iklan = []
    if data['berita']:
        # Halaman Redaksi & Pedoman Media Siber untuk semua tema berita (user 2026-09-30).
        # Berkas redaksi di folder klien (REDAKSI.docx dsb.) -> susunan asli (user 2026-09-30).
        susunan = muat('redaksi_klien', HERE / 'redaksi-klien').susunan(domain)
        data['berita_halaman'] = halaman_berita(data['nama'], kontak['email'], susunan)
    if data['berita'] and not coba:
        # Banner "Ruang Iklan" untuk setiap ukuran slot iklan tema berita aktif.
        data['berita_iklan'], warna_tema, warna_kirki = slot_iklan(cfg, domain)
        data['berita_blok_semua'] = BLOK_SEMUA_KATEGORI.get(tema, [])
        # Banner Ruang Iklan berwarna utama tema situs (user 2026-10-06, cybernasional24.com); dulu warna
        # form klien saja, kosong -> navy bawaan yang tidak sama dengan tema.
        warna_banner = warna_tema or (isi.get('warna') or {}).get('utama')
        if tema.startswith('velocity-berita') and not SITUS_LAMA:
            # Customizer tema berita (Warna, tautan Iklan, Sosial Media, blok Home) diisi di langkah PHP 2b.
            # color_theme (bila tema memakainya & masih kosong) diisi warna klien, jadi banner memakai warna itu.
            data['berita8'] = berita8_customizer(domain, isi)
            if data['berita8']['warna'] and (warna_kirki == 'kosong' or tema == 'velocity-berita-8'):
                warna_banner = data['berita8']['warna']
            print(f"tampilan: berita_customizer warna={data['berita8']['warna'] or 'bawaan_tema'} "
                  f"sosmed={','.join(k for k, v in data['berita8']['sosmed'].items() if v != BERITA8_SOSMED[k][1]) or 'bawaan'}")
        print(f"tampilan: warna_banner={warna_banner or 'bawaan'}:{'tema' if warna_tema else 'form' if warna_banner else '-'}")
        ukuran = {v['ukuran'] for v in data['berita_iklan'].values()}
        data['widget_demo'] = widget_demo(tema)
        data['latar_demo'] = latar_demo(tema)
        data['mod_demo'] = mod_demo(tema)
        ukuran |= {i['ukuran'] for daftar in data['widget_demo'].values() for i in daftar if i.get('jenis') == 'iklan'}
        if data['widget_demo']:
            print(f"tampilan: widget_demo={tema} area={','.join(data['widget_demo'])}")
        for u in sorted(ukuran):
            w, h = (int(x) for x in u.split('x'))
            kunci = f'iklan-{u}'
            aset[kunci] = banner_iklan(w, h, data['nama'], warna_banner,
                                       kontak['email'] or (f"WA {kontak['wa_tampil']}" if kontak['wa_tampil'] else ''),
                                       kerja / f'{kunci}.jpg')
            judul[kunci] = f"Ruang iklan {u} {data['nama']}"
            iklan.append(kunci)
        print(f"tampilan: slot_iklan={len(data['berita_iklan'])} ukuran={','.join(sorted(ukuran)) or '-'}")
    # Hanya slot yang dirujuk pengaturan tema yang diunggah, dan potongan yang isinya sama
    # diunggah sekali: wisesayasatidar.com (Paket E, 2026-09-18) mendapat 16 lampiran dari
    # 7 foto klien, padahal velocity-pakete hanya memakai hero, tentang, dan gambar layanan.
    # Tema yang tidak terbaca: semua adaptor dipindai, karena server memilih mods dari tema aktifnya.
    if data['berita'] and data.get('berita_iklan'):
        # Slot iklan diisi banner "Ruang Iklan": rujukan adaptor ke foto (beritab1 banner_home1/2 =
        # hero/foto1) dibuang, kalau tidak foto itu diunggah tanpa pernah tampil (cybernasional24.com
        # 2026-10-06, "Foto <domain>" yatim di Media).
        for m in [data['mods'], data['bawaan']]:
            for isi_mods in ([m.get(tema)] if tema in m else list(m.values())):
                if isinstance(isi_mods, dict):
                    for k in data['berita_iklan']:
                        isi_mods.pop(k, None)
    rujukan = json.dumps([data['mods'].get(tema), data['bawaan'].get(tema)] if tema in data['mods']
                         else [data['mods'], data['bawaan']], ensure_ascii=False)
    dipakai = set(re.findall(r'\{\{(?:id|url):([a-z0-9-]+)\}\}', rujukan)) | set(iklan)
    if data['situs_baru'] and not data['berita']:
        dipakai.add('hero')  # Header Image tema (banner halaman dalam), lihat langkah 6c PHP
    data['aset'], per_md5 = {}, {}
    for k, p in aset.items():
        if k not in dipakai:
            continue
        md5 = hashlib.md5(p.read_bytes()).hexdigest()
        data['aset'][k] = {'file': f'{k}.jpg', 'judul': judul.get(k, k), 'sidik': f'{domain}:{k}:{md5}'}
        if md5 in per_md5:
            data['aset'][k]['sama'] = per_md5[md5]
        else:
            per_md5[md5] = k
    (kerja / 'data.json').write_text(json.dumps(data, ensure_ascii=False))
    print(f"tampilan: siap aset={','.join(sorted(aset))} layanan={len(layanan)} folder={kerja}")
    print(f"tampilan: aset_dipakai={','.join(sorted(data['aset'])) or '-'} unggah={len(per_md5)}")
    if coba:
        (kerja / 'mods.json').write_text(json.dumps(data['mods'].get(tema), indent=1, ensure_ascii=False))
        return 0
    keluar = kirim(cfg, kerja, REMOTE_PHP, domain)
    if not keluar or 'tampilan: selesai' not in keluar:
        print('tampilan: gagal')
        return 1
    if catatan_ai and 'tampilan: beranda_diisi' in keluar:
        slug = (re.search(r'tampilan: beranda_slug=(\S*)', keluar) or [None, ''])[1]
        lulus, alasan = at.periksa_beranda(domain, slug, ctx, catatan_ai['adaptor'])
        if lulus:
            at.simpan_adaptor(info, {**catatan_ai, 'status': 'terverifikasi', 'alasan': ''})
            print('tampilan: adaptor_ai_terverifikasi')
        elif lulus is None:
            # Beranda tak terjangkau (SSL/jaringan/maintenance) bukan bukti adaptornya salah:
            # hasil dibiarkan terpasang, status adaptor tidak diubah.
            print(f'tampilan: adaptor_ai_tidak_bisa_diperiksa:{alasan}')
        else:
            print(f'tampilan: adaptor_ai_gagal_diperiksa:{alasan}')
            (kerja / 'data.json').write_text(json.dumps({'tema': tema}))
            for f in kerja.glob('*.jpg'):
                f.unlink()
            kirim(cfg, kerja, KEMBALIKAN_PHP, domain)
            at.simpan_adaptor(info, {**catatan_ai, 'status': 'gagal', 'alasan': alasan})
    if not SITUS_LAMA:
        try:
            rapikan_logo(cfg, manifest, domain, keluar, (panduan or {}).get('logo'))
        except Exception as e:  # pemeriksaan tampilan tidak boleh menggagalkan langkah ini
            print(f'tampilan: logo_cek_gagal:{type(e).__name__}:{str(e)[:120]}')
    return 0


if __name__ == '__main__':
    try:
        kode = main()
    finally:
        # WP-CLI di langkah ini berjalan sebagai root: kembalikan pemilik wp-content (scripts/pemilik_wp.py).
        import pemilik_wp
        pemilik_wp.rapikan()
    if '--coba' not in sys.argv:
        import shutil
        for folder in SEMENTARA:
            shutil.rmtree(folder, ignore_errors=True)
    sys.exit(kode)
