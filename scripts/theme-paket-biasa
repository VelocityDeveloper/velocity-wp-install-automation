REMOTE_PHP = r'''<?php
// Dijalankan theme-paket-biasa lewat wp eval-file <file> <folder>.
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
if (!$d) { echo "tampilan: data_tidak_terbaca\n"; return; }
require_once ABSPATH . 'wp-admin/includes/file.php';
require_once ABSPATH . 'wp-admin/includes/media.php';
require_once ABSPATH . 'wp-admin/includes/image.php';
require_once ABSPATH . 'wp-admin/includes/nav-menu.php';
$admins = get_users(['role' => 'administrator', 'number' => 1, 'orderby' => 'ID']);
wp_set_current_user($admins ? $admins[0]->ID : 1);
kses_remove_filters();
$st = get_option('velocity_tampilan_klasik', []); if (!is_array($st)) { $st = []; }
$tema = get_stylesheet();
echo "tampilan: tema=$tema\n";
$milik_installer = function ($id) {
    $m = get_post_meta($id, '_velocity_content_md5', true);
    return $m && $m === md5(get_post_field('post_content', $id) . "\n");
};
$tandai = function ($id) { update_post_meta($id, '_velocity_content_md5', md5(get_post_field('post_content', $id) . "\n")); };

// 1. Media (dipakai ulang lewat sidik berkas)
$media = [];
// Logo klien hanya diunggah bila pengaturan tema aktif merujuknya. Tema yang tidak dikenal sisi
// Python membuat semua adaptor dipindai, sehingga cepadtl.org (tema velocity saat instalasi,
// 2026-09-30) mendapat 6 logo contoh yang tidak tampil di mana pun.
$rujukan_tema = wp_json_encode([$d['mods'][$tema] ?? null, $d['bawaan'][$tema] ?? null]);
foreach ($d['aset'] as $kunci => $a) {
    if (strpos($kunci, 'klien-') === 0 && strpos($rujukan_tema, ":$kunci}}") === false) { continue; }
    // Potongan yang isinya sama persis dengan slot lain memakai lampiran slot itu.
    if (!empty($a['sama']) && isset($media[$a['sama']])) { $media[$kunci] = $media[$a['sama']]; continue; }
    $ada = get_posts(['post_type' => 'attachment', 'post_status' => 'inherit', 'numberposts' => 1, 'fields' => 'ids',
                      'meta_key' => '_velocity_tampilan_aset', 'meta_value' => $a['sidik']]);
    if ($ada) { $media[$kunci] = (int) $ada[0]; continue; }
    $tmp = wp_tempnam($a['file']); copy("$dir/{$a['file']}", $tmp);
    $id = media_handle_sideload(['name' => $a['file'], 'tmp_name' => $tmp], 0, $a['judul']);
    if (is_wp_error($id)) { echo "tampilan: media_gagal:$kunci\n"; continue; }
    update_post_meta($id, '_velocity_tampilan_aset', $a['sidik']);
    update_post_meta($id, '_wp_attachment_image_alt', $a['judul']);
    $media[$kunci] = (int) $id;
    $baru_media = ($baru_media ?? 0) + 1;
}
echo 'tampilan: media=' . count($media) . ' baru=' . ($baru_media ?? 0) . "\n";
$ganti = function ($v) use (&$ganti, $media) {
    if (is_array($v)) { return array_map($ganti, $v); }
    if (!is_string($v)) { return $v; }
    if ($v === '{{id:logo}}') { return (int) get_theme_mod('custom_logo'); }
    if ($v === '{{url:logo}}') { return (string) wp_get_attachment_url((int) get_theme_mod('custom_logo')); }
    if (preg_match('/^\{\{id:([a-z0-9-]+)\}\}$/', $v, $m)) { return $media[$m[1]] ?? 0; }
    if (preg_match('/^\{\{url:([a-z0-9-]+)\}\}$/', $v, $m)) { return isset($media[$m[1]]) ? wp_get_attachment_url($media[$m[1]]) : ''; }
    if (strpos($v, '/') === 0 && strpos($v, '//') !== 0) { return home_url($v); }
    return $v;
};
// Tautan berjalur akar ("/layanan/#...") di HTML widget/beranda ikut home_url: situs staging di
// subfolder (velocitydeveloper.co/<domain>) kalau tidak menunjuk ke halaman milik situs lain.
$akar = function ($h) {
    return preg_replace_callback('#href="(/(?!/)[^"]*)"#', function ($m) { return 'href="' . esc_url(home_url($m[1])) . '"'; }, (string) $h);
};

// 2. Halaman Layanan + menu
$lokasi = get_nav_menu_locations(); $menu_id = (int) ($lokasi['primary'] ?? 0);
if ($d['halaman_layanan'] !== '') {
    $hal = get_page_by_path('layanan', OBJECT, 'page');
    if (!$hal) {
        $id = wp_insert_post(['post_type' => 'page', 'post_status' => 'publish', 'post_title' => 'Layanan', 'post_name' => 'layanan',
                              'post_content' => $akar($d['halaman_layanan'])], true);
        if (!is_wp_error($id)) { $tandai($id); echo "tampilan: layanan_dibuat:$id\n"; $hal = get_post($id); }
    } elseif ($milik_installer($hal->ID) && $hal->post_content !== $akar($d['halaman_layanan'])) {
        wp_update_post(['ID' => $hal->ID, 'post_content' => $akar($d['halaman_layanan'])]); $tandai($hal->ID); echo "tampilan: layanan_diperbarui\n";
    } elseif (!$milik_installer($hal->ID)) { echo "tampilan: layanan_dibiarkan:disunting\n"; }
    // Menu toko online biasa disusun scripts/toko-biasa (opsi velocity_menu_toko): Layanan tidak disisipkan.
    if ($hal && $menu_id && get_option('velocity_menu_toko')) { echo "tampilan: menu_layanan_dilewati:menu_toko\n"; }
    elseif ($hal && $menu_id) {
        $items = wp_get_nav_menu_items($menu_id) ?: [];
        $ada = false; $posisi = count($items) + 1;
        foreach ($items as $it) {
            if ((int) $it->object_id === $hal->ID) { $ada = true; }
            if ($it->object === 'page' && get_post_field('post_name', $it->object_id) === 'tentang-kami') { $posisi = $it->menu_order + 1; }
        }
        if (!$ada) {
            foreach ($items as $it) { if ($it->menu_order >= $posisi) { wp_update_post(['ID' => $it->ID, 'menu_order' => $it->menu_order + 1]); } }
            wp_update_nav_menu_item($menu_id, 0, ['menu-item-object-id' => $hal->ID, 'menu-item-object' => 'page', 'menu-item-type' => 'post_type',
                'menu-item-title' => 'Layanan', 'menu-item-status' => 'publish', 'menu-item-position' => $posisi]);
            echo "tampilan: menu_layanan\n";
        }
    }
}

// 2b. Portal berita (mulawarmantv.com 2026-09-18). Tema berita klasik (velocity-berita*) menaruh
// seluruh desain beranda (slider, grid, blok per kategori) di index.php/home.php, yang hanya
// dipakai bila beranda = tulisan terbaru. Installer memasang halaman statis "Beranda", jadi yang
// tampil cuma teks halaman. Pola situs berita buatan webmaster: show_on_front=posts, menu utama
// Home + kategori, halaman profil di menu secondary, blok berita diisi kategori, banner iklan kosong.
$sd = get_stylesheet_directory();
$berita_depan = !empty($d['berita']) && !is_file("$sd/front-page.php") && (is_file("$sd/index.php") || is_file("$sd/home.php"));
if ($berita_depan) {
    $pof = (int) get_option('page_on_front');
    if (get_option('show_on_front') !== 'posts' || $pof) {
        if (!$pof || $milik_installer($pof)) {
            update_option('show_on_front', 'posts'); update_option('page_on_front', 0); update_option('page_for_posts', 0);
            echo "tampilan: berita_beranda_tulisan_terbaru\n";
        } else { echo "tampilan: berita_beranda_dibiarkan:disunting\n"; }
    }
    // Terbanyak artikel dulu; sama banyak -> urutan dibuat (= urutan kategori di form klien).
    $kategori = get_categories(['hide_empty' => true, 'exclude' => [(int) get_option('default_category')]]);
    usort($kategori, fn($a, $b) => [$b->count, $a->term_id] <=> [$a->count, $b->term_id]);
    // Blok berita: kontrol customizer bertipe select yang pilihannya kategori (cat_berita1..n).
    // Nama pengaturannya dirangkai di kode tema ('cat_' . $id), jadi dibaca dari customizer.
    require_once ABSPATH . WPINC . '/class-wp-customize-manager.php';
    $blok_kat = [];
    try {
        // Kirki (tema berita1–18) mendaftarkan kontrolnya lewat global $wp_customize.
        $wpc = new WP_Customize_Manager(); $GLOBALS['wp_customize'] = $wpc; do_action('customize_register', $wpc);
        $id_kat = array_map('strval', wp_list_pluck(get_categories(['hide_empty' => false]), 'term_id'));
        foreach ($wpc->controls() as $c) {
            $pilih = array_diff(array_map('strval', array_keys((array) $c->choices)), ['']);
            if ($c->type === 'select' && count($pilih) > 1 && !array_diff($pilih, $id_kat) && $c->setting) { $blok_kat[] = $c->setting->id; }
        }
    } catch (Throwable $t) { echo 'tampilan: berita_customizer_gagal:' . $t->getMessage() . "\n"; }
    $isi_kat = []; $i = 0;
    foreach ($blok_kat as $k) {
        $kini = (string) get_theme_mod($k, '');
        if ($kini !== '' && $kini !== (string) ($st['berita_kat'][$k] ?? '')) { continue; }  // dipilih orang
        if (!isset($kategori[$i])) { break; }
        set_theme_mod($k, (string) $kategori[$i]->term_id); $st['berita_kat'][$k] = (string) $kategori[$i]->term_id;
        $isi_kat[] = "$k=" . $kategori[$i]->slug; $i++;
    }
    if ($isi_kat) { echo 'tampilan: berita_blok_kategori:' . implode(',', $isi_kat) . "\n"; }
    // Slot banner iklan (955x90 dsb.) untuk gambar iklan, bukan foto klien yang dipasang adaptor:
    // dikosongkan hanya bila isinya aset installer (_velocity_tampilan_aset), bukan unggahan orang.
    foreach ((array) get_theme_mods() as $k => $v) {
        if (!preg_match('/^image_iklan/', (string) $k) || !is_string($v) || $v === '') { continue; }
        $aid = attachment_url_to_postid($v);
        $sidik = $aid ? (string) get_post_meta($aid, '_velocity_tampilan_aset', true) : '';
        if ($sidik !== '' && strpos($sidik, ':iklan-') === false) {
            remove_theme_mod($k); remove_theme_mod(preg_replace('/^image_/', 'link_', $k));
            echo "tampilan: berita_iklan_dikosongkan:$k\n";
        }
    }
    // Setiap slot iklan tema (dibaca sisi Python dari Customizer, ukuran dari keterangan kontrolnya)
    // diisi banner "Ruang Iklan" seukuran slot. Slot yang diisi orang dibiarkan.
    $isi_iklan = [];
    foreach ((array) ($d['berita_iklan'] ?? []) as $k => $slot) {
        $aid = $media['iklan-' . $slot['ukuran']] ?? 0;
        if (!$aid) { continue; }
        $nilai = $slot['simpan'] === 'id' ? (string) $aid : (string) wp_get_attachment_url($aid);
        $kini = (string) get_theme_mod($k, '');
        if ($kini !== '' && $kini !== (string) ($st['berita_iklan'][$k] ?? '')) { continue; }
        if ($kini !== $nilai) { set_theme_mod($k, $nilai); }
        $st['berita_iklan'][$k] = $nilai; $isi_iklan[] = "$k={$slot['ukuran']}";
    }
    if ($isi_iklan) { echo 'tampilan: berita_iklan:' . implode(',', $isi_iklan) . "\n"; }
    // Artikel tanpa meta 'hit' tidak ikut query "Populer" (meta_key hit) widget & tab tema: diberi 0,
    // velocity-addons menaikkannya tiap kunjungan. Semua tema berita memakai meta yang sama.
    $tanpa_hit = get_posts(['post_type' => 'post', 'post_status' => 'publish', 'numberposts' => -1, 'fields' => 'ids',
                            'meta_query' => [['key' => 'hit', 'compare' => 'NOT EXISTS']]]);
    foreach ($tanpa_hit as $pid) { add_post_meta($pid, 'hit', 0, true); }
    if ($tanpa_hit) { echo 'tampilan: berita_hit_awal:' . count($tanpa_hit) . "\n"; }
    // Menu: hanya menu buatan installer (halaman baku) yang disusun ulang.
    $baku = ['beranda', 'home', 'tentang kami', 'galeri', 'berita', 'hubungi kami', 'kontak', 'layanan', 'redaksi',
             'pedoman media siber', 'privacy policy', 'kebijakan privasi'];
    $lokasi = get_nav_menu_locations(); $utama_id = (int) ($lokasi['primary'] ?? 0);
    $item_utama = $utama_id ? (wp_get_nav_menu_items($utama_id) ?: []) : [];
    $menu_baku = $item_utama && !array_filter($item_utama, fn($it) => !in_array(strtolower(trim($it->title)), $baku, true)
                                                              || !in_array($it->type, ['post_type', 'custom'], true));
    $kat_menu = array_slice($kategori, 0, 8);
    if ($menu_baku && $kat_menu && empty($st['berita_menu'])) {
        $obj = wp_get_nav_menu_object('Menu Berita');
        $mb = $obj ? (int) $obj->term_id : (int) wp_create_nav_menu('Menu Berita');
        if ($mb && !$obj) {
            wp_update_nav_menu_item($mb, 0, ['menu-item-title' => 'Home', 'menu-item-url' => home_url('/'),
                'menu-item-type' => 'custom', 'menu-item-status' => 'publish', 'menu-item-position' => 1]);
            $n = 2;
            foreach ($kat_menu as $k) {
                wp_update_nav_menu_item($mb, 0, ['menu-item-title' => $k->name, 'menu-item-object-id' => $k->term_id,
                    'menu-item-object' => 'category', 'menu-item-type' => 'taxonomy', 'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
            }
        }
        if ($mb) {
            $lokasi['primary'] = $mb; set_theme_mod('nav_menu_locations', $lokasi);
            $st['berita_menu'] = $mb;
            echo 'tampilan: berita_menu:' . count($kat_menu) . "_kategori\n";
        }
    } elseif (!$menu_baku && empty($st['berita_menu'])) { echo "tampilan: berita_menu_dibiarkan:disunting\n"; }
    // Halaman Redaksi & Pedoman Media Siber (demo beritab1): isi contoh bila klien belum mengirim
    // materinya; halaman yang sudah disunting orang dibiarkan.
    foreach ((array) ($d['berita_halaman'] ?? []) as $h) {
        $ada = get_posts(['post_type' => 'page', 'name' => $h['slug'], 'post_status' => 'any', 'numberposts' => 1]);
        if (!$ada) {
            $id = wp_insert_post(['post_type' => 'page', 'post_status' => 'publish', 'post_title' => $h['judul'],
                                  'post_name' => $h['slug'], 'post_content' => $h['isi']], true);
            if (!is_wp_error($id)) { $tandai($id); echo "tampilan: berita_halaman_dibuat:{$h['slug']}:$id\n"; }
        } elseif ($milik_installer($ada[0]->ID) && $ada[0]->post_content !== $h['isi']) {
            wp_update_post(['ID' => $ada[0]->ID, 'post_content' => $h['isi']]); $tandai($ada[0]->ID);
            echo "tampilan: berita_halaman_diperbarui:{$h['slug']}\n";
        }
    }
    // Menu sekunder semua tema berita (demo beritab1: Tentang Kami, Redaksi, Kontak, Pedoman Media Siber).
    // Lokasinya 'secondary-menu' di beritab1, 'secondary' di tema berita lain; dulu hanya menu lama
    // (halaman profil tanpa Redaksi/Pedoman) yang dipindah ke 'secondary', dan bar atas sidoarjopos.id
    // kosong. Tema tanpa lokasi sekunder (berita6/15/17) dilewati. Lokasi yang diisi orang dibiarkan.
    $lok2 = array_values(array_intersect(['secondary-menu', 'secondary'], array_keys(get_registered_nav_menus())))[0] ?? '';
    $lokasi = get_nav_menu_locations();
    // Hanya diisi selama lokasinya kosong: menu yang sudah terpasang (termasuk item yang sengaja dibuang
    // orang, sidoarjopos.id 2026-09-30) tidak dilengkapi ulang.
    if ($lok2 && empty($lokasi[$lok2])) {
        $obj = wp_get_nav_menu_object('Menu Profil');
        $m2 = $obj ? (int) $obj->term_id : (int) wp_create_nav_menu('Menu Profil');
        $ada_id = array_map(fn($it) => (int) $it->object_id, array_filter(wp_get_nav_menu_items($m2) ?: [], fn($it) => $it->object === 'page'));
        $n = count(wp_get_nav_menu_items($m2) ?: []) + 1; $tambah = [];
        foreach (['tentang-kami', 'redaksi', 'galeri', 'hubungi-kami', 'pedoman-media-siber', 'kebijakan-privasi', 'privacy-policy'] as $slug) {
            $p = get_posts(['post_type' => 'page', 'name' => $slug, 'post_status' => 'publish', 'numberposts' => 1]);
            if (!$p || in_array($p[0]->ID, $ada_id, true)) { continue; }
            if ($slug === 'privacy-policy' && get_posts(['post_type' => 'page', 'name' => 'kebijakan-privasi', 'post_status' => 'publish', 'numberposts' => 1])) { continue; }
            wp_update_nav_menu_item($m2, 0, ['menu-item-object-id' => $p[0]->ID, 'menu-item-object' => 'page', 'menu-item-type' => 'post_type',
                'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
            $ada_id[] = $p[0]->ID; $tambah[] = $slug;
        }
        $lokasi[$lok2] = $m2; set_theme_mod('nav_menu_locations', $lokasi);
        echo "tampilan: berita_menu_sekunder:$lok2" . ($tambah ? ':' . implode(',', $tambah) : '') . "\n";
    } elseif ($lok2) { echo "tampilan: berita_menu_sekunder_dibiarkan:terpasang\n"; }
    else {
        // Tema tanpa lokasi menu sekunder (berita6/15/17): Tentang Kami, Redaksi, Pedoman Media Siber
        // masuk menu primary buatan installer sesudah kategori (user 2026-09-30). Sekali saja, supaya
        // item yang dibuang orang tidak kembali.
        $mb = (int) ($st['berita_menu'] ?? 0);
        if ($mb && empty($st['berita_menu_profil']) && (int) (get_nav_menu_locations()['primary'] ?? 0) === $mb) {
            $items = wp_get_nav_menu_items($mb) ?: [];
            $ada_id = array_map(fn($it) => (int) $it->object_id, array_filter($items, fn($it) => $it->object === 'page'));
            $n = count($items) + 1; $tambah = [];
            foreach (['tentang-kami', 'redaksi', 'pedoman-media-siber'] as $slug) {
                $p = get_posts(['post_type' => 'page', 'name' => $slug, 'post_status' => 'publish', 'numberposts' => 1]);
                if (!$p || in_array($p[0]->ID, $ada_id, true)) { continue; }
                wp_update_nav_menu_item($mb, 0, ['menu-item-object-id' => $p[0]->ID, 'menu-item-object' => 'page', 'menu-item-type' => 'post_type',
                    'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
                $tambah[] = $slug;
            }
            $st['berita_menu_profil'] = gmdate('c');
            echo 'tampilan: berita_menu_profil_di_primary:' . (implode(',', $tambah) ?: '-') . "\n";
        }
    }
}

// 3. Beranda: template + pengaturan tema
$depan = $berita_depan ? 0 : (int) get_option('page_on_front');
if ($berita_depan) {
    echo "tampilan: beranda_tema_berita\n";
} elseif (isset($d['mods'][$tema]) && $depan) {
    $tpl = get_post_meta($depan, '_wp_page_template', true);
    echo 'tampilan: beranda_slug=' . get_post_field('post_name', $depan) . "\n";
    $file = '';
    if (array_key_exists($tema, $d['template'] ?? [])) {
        // Adaptor AI menyebut templatenya sendiri ('' = beranda tema tidak memakai template halaman).
        $file = (string) $d['template'][$tema];
        if ($file !== '' && !is_file(get_stylesheet_directory() . '/' . $file)) { $file = ''; }
    } else {
        foreach (glob(get_stylesheet_directory() . '/*.php') as $f) {
            if (preg_match('/Template Name:\s*Home Template/i', (string) file_get_contents($f, false, null, 0, 600))) { $file = basename($f); break; }
        }
    }
    if ($file && in_array($tpl, ['', 'default', $file], true)) {
        update_post_meta($depan, '_wp_page_template', $file); echo "tampilan: template_beranda:$file\n";
    }
    $mods = $ganti($d['mods'][$tema]);
    // Kolom alamat header (address/alamat) memakai alamat ringkas; alamat lengkap tetap di footer & kontak.
    if (!empty($d['situs_baru']) && (string) ($d['alamat_pendek'] ?? '') !== '' && $d['alamat_pendek'] !== $d['alamat']) {
        foreach ($mods as $k => $v) {
            if (is_string($v) && preg_match('/address|alamat/i', (string) $k) && trim($v) === trim((string) $d['alamat'])) {
                $mods[$k] = $d['alamat_pendek']; echo "tampilan: alamat_ringkas:$k\n";
            }
        }
    }
    $kini = []; foreach (array_keys($mods) as $k) { $kini[$k] = get_theme_mod($k, null); }
    $bawaan = $d['bawaan'][$tema] ?? [];
    $sama = fn($x, $y) => (is_scalar($x) || $x === null) && (is_scalar($y) || $y === null) ? (string) $x === (string) $y : wp_json_encode($x) === wp_json_encode($y);
    $kosong = !array_filter($kini, fn($v, $k) => $v !== null && $v !== '' && $v !== [] && !(array_key_exists($k, $bawaan) && $sama($v, $bawaan[$k])),
                            ARRAY_FILTER_USE_BOTH);
    $sidik_kini = md5(wp_json_encode($kini));
    if ($kosong || ($st['mods'][$tema] ?? '') === $sidik_kini) {
        if (!empty($d['cadangan']) && empty($st['cadangan'][$tema])) {
            // Keadaan sebelum adaptor AI pertama kali menulis: dipulihkan kalau beranda gagal diperiksa.
            $st['cadangan'][$tema] = ['mods' => $kini, 'tpl' => $tpl];
        }
        foreach ($mods as $k => $v) { set_theme_mod($k, $v); }
        $baca = []; foreach (array_keys($mods) as $k) { $baca[$k] = get_theme_mod($k, null); }
        $st['mods'][$tema] = md5(wp_json_encode($baca));
        echo 'tampilan: beranda_diisi:' . implode(',', array_keys($mods)) . "\n";
    } else { echo "tampilan: beranda_dibiarkan:pengaturan_tema_disunting\n"; }
} else {
    echo "tampilan: beranda_tema_belum_didukung:$tema\n";
}
$tanpa_template = !isset($d['mods'][$tema]) || (array_key_exists($tema, $d['template'] ?? []) && (string) $d['template'][$tema] === '');
if ($depan && $tanpa_template && $d['beranda_blok'] !== '') {
    if (!$milik_installer($depan)) { echo "tampilan: beranda_blok_dibiarkan:disunting\n"; }
    else {
        $isi_b = get_post_field('post_content', $depan);
        $blok_b = "<!-- velocity-beranda -->\n" . $akar($d['beranda_blok']) . "\n<!-- /velocity-beranda -->";
        $baru_b = strpos($isi_b, '<!-- velocity-beranda -->') !== false
            ? preg_replace('#<!-- velocity-beranda -->.*?<!-- /velocity-beranda -->#s', str_replace('$', '\\$', $blok_b), $isi_b)
            : rtrim($isi_b) . "\n" . $blok_b;
        if ($baru_b !== $isi_b) { wp_update_post(['ID' => $depan, 'post_content' => $baru_b]); $tandai($depan); echo "tampilan: beranda_blok_ditulis\n"; }
    }
}

// 4. Blok kontak di Hubungi Kami
$kontak = get_page_by_path('hubungi-kami', OBJECT, 'page');
if ($kontak) {
    $isi = $kontak->post_content;
    $blok = "<!-- velocity-kontak -->\n" . $d['blok_kontak'] . "\n<!-- /velocity-kontak -->";
    if (!$milik_installer($kontak->ID)) { echo "tampilan: kontak_dibiarkan:disunting\n"; }
    else {
        if (strpos($isi, '<!-- velocity-kontak -->') !== false) {
            $baru = preg_replace('#<!-- velocity-kontak -->.*?<!-- /velocity-kontak -->#s', str_replace('$', '\\$', $blok), $isi);
        } elseif (strpos($isi, '<!-- velocity-map -->') !== false) {
            $baru = str_replace('<!-- velocity-map -->', $blok . "\n<!-- velocity-map -->", $isi);
        } else { $baru = rtrim($isi) . "\n" . $blok; }
        if ($baru !== $isi) { wp_update_post(['ID' => $kontak->ID, 'post_content' => $baru]); $tandai($kontak->ID); echo "tampilan: kontak_ditulis\n"; }
    }
}

// 5. Widget
global $wp_registered_sidebars;
$sb = wp_get_sidebars_widgets();
$blok_w = get_option('widget_block', []); if (!is_array($blok_w)) { $blok_w = []; }
$ch = get_option('widget_custom_html', []); if (!is_array($ch)) { $ch = []; }
$tx = get_option('widget_text', []); if (!is_array($tx)) { $tx = []; }
$rp = get_option('widget_recent-posts', []); if (!is_array($rp)) { $rp = []; }
$sr = get_option('widget_search', []); if (!is_array($sr)) { $sr = []; }
$bawaan = function ($w) use ($blok_w) {
    if (!preg_match('/^block-(\d+)$/', $w, $m)) { return false; }
    $c = (string) ($blok_w[(int) $m[1]]['content'] ?? '');
    $sisa = preg_replace('#<!-- /?wp:(search|latest-posts|latest-comments|archives|categories|group|heading)\b.*?-->#s', '', $c);
    return trim(wp_strip_all_tags($sisa)) === '' || preg_match('/^(Recent Posts|Recent Comments|Archives|Categories)$/m', trim(wp_strip_all_tags($sisa)));
};
$milik = (array) ($st['widget'] ?? []);
$boleh = function ($daftar) use ($bawaan, $milik) {
    $daftar = array_values((array) $daftar);
    if (!$daftar || $daftar === array_values((array) ($milik['__daftar'][md5(wp_json_encode($daftar))] ?? []))) { return true; }
    foreach ($daftar as $w) { if (!$bawaan($w) && !in_array($w, (array) ($milik['__semua'] ?? []), true)) { return false; } }
    return true;
};
$nomor = 300;
$buat_html = function ($judul, $isi) use (&$ch, &$nomor, $akar) {
    while (isset($ch[$nomor])) { $nomor++; }
    $ch[$nomor] = ['title' => $judul, 'content' => $akar($isi)]; return 'custom_html-' . $nomor++;
};
// Jenis widget lain (media_image, velocity_posts_widget, categories) dimuat saat dipakai.
$lain = [];
$opsi_lain = function ($jenis) use (&$lain) {
    if (!isset($lain[$jenis])) { $o = get_option("widget_$jenis", []); $lain[$jenis] = is_array($o) ? $o : []; }
};
$buat_lain = function ($jenis, $opsi) use (&$lain, $opsi_lain) {
    $opsi_lain($jenis);
    $n = 300; while (isset($lain[$jenis][$n])) { $n++; }
    $lain[$jenis][$n] = $opsi; return "$jenis-$n";
};
// Widget dari panduan pembuat tema (child-theme-data-setup.md, Paket F — scripts/panduan_tema.py, user
// 2026-10-02). Widget lama (wp_register_sidebar_widget, mis. vrp-widget velocity-perusahaan1) menyimpan
// pengaturannya di option sendiri, bukan widget_<id_base>.
$panduan_sb = (array) ($d['panduan']['sidebar'] ?? []);
$nama_pd = []; $opsi_pd = [];
foreach ($panduan_sb as $it) {
    if (($it['opsi_option'] ?? '') !== '' && $it['opsi_option'] !== 'widget_' . $it['id_base']) { $nama_pd[$it['id_base']] = $it['opsi_option']; }
}
$muat_pd = function ($base) use (&$opsi_pd, $nama_pd) {
    if (!isset($opsi_pd[$base])) { $o = get_option($nama_pd[$base], []); $opsi_pd[$base] = is_array($o) ? $o : []; }
};
$panduan_sb = array_values(array_filter($panduan_sb, function ($it) use ($nama_pd) {
    $base = (string) ($it['id_base'] ?? '');
    $ada = false;
    if (isset($nama_pd[$base])) {
        foreach (array_keys($GLOBALS['wp_registered_widgets']) as $id) { if (strpos($id, "$base-") === 0) { $ada = true; break; } }
    } else {
        foreach ($GLOBALS['wp_widget_factory']->widgets as $o) { if ($o->id_base === $base) { $ada = true; break; } }
    }
    if (!$ada) { echo "tampilan: panduan_widget_tidak_terdaftar:$base\n"; }
    return $ada;
}));
$hapus_bawaan = function ($daftar) use (&$blok_w, $bawaan, &$ch, &$tx, &$rp, &$sr, &$lain, $opsi_lain, $milik, &$opsi_pd, $nama_pd, $muat_pd) {
    foreach ((array) $daftar as $w) {
        if ($bawaan($w)) { unset($blok_w[(int) substr($w, 6)]); }
        elseif (in_array($w, (array) ($milik['__semua'] ?? []), true)) {
            [$jenis, $n] = [substr($w, 0, strrpos($w, '-')), (int) substr($w, strrpos($w, '-') + 1)];
            if ($jenis === 'custom_html') { unset($ch[$n]); } elseif ($jenis === 'text') { unset($tx[$n]); } elseif ($jenis === 'recent-posts') { unset($rp[$n]); } elseif ($jenis === 'search') { unset($sr[$n]); }
            elseif (isset($nama_pd[$jenis])) { $muat_pd($jenis); unset($opsi_pd[$jenis][$n]); }
            else { $opsi_lain($jenis); unset($lain[$jenis][$n]); }
        }
    }
};
$W = $d['widget']; $semua = []; $ubah = [];
// Tema bersidebar kiri (velocity-pakete mencetak secondary-sidebar sebagai kolom kiri): isinya
// seperti demo pakete.velocitydeveloper.com — Cari, Artikel Terbaru, Pengunjung. Dulu kosong di
// semua situs Paket E (trimurtiekapaksi.com, permintaan user 2026-09-30); Artikel Terbaru pindah
// ke kiri supaya tidak tampil dobel di sidebar kanan.
$kiri = (get_stylesheet() === 'velocity-pakete' && isset($wp_registered_sidebars['secondary-sidebar'])) ? 'secondary-sidebar' : '';
$utama = isset($wp_registered_sidebars['main-sidebar']) ? 'main-sidebar' : (isset($wp_registered_sidebars['sidebar-1']) ? 'sidebar-1' : '');
// Tema yang membawa susunan widget acuannya sendiri (velocity-toko21: Kategori, Cari Produk, Bank,
// Ekspedisi, Sosial Media, Hubungi Kami — sama dengan demo toko21.velocitydeveloper.com, keputusan
// user 2026-09-24) memakai susunan itu, bukan widget umum konsultasi/layanan/artikel.
$acuan = function_exists('velocity_tema_widget_sidebar') ? (array) velocity_tema_widget_sidebar() : [];
// Portal berita: sidebar, footer & area widget lain disusun seperti demo <tema>.velocitydeveloper.com
// (templates/portal-berita/widget-demo.json, dipilih sisi Python per tema aktif) — widget Posts/Tabs
// tema, shortcode di widget Text, banner "Ruang Iklan" seukuran iklan demo. Kategori demo diganti
// kategori klien ke-N terbanyak artikelnya. Dulu memakai susunan umum (Hubungi Kami, Artikel Terbaru,
// Kontak): velocity-beritab1 dulu (sidoarjopos.id), lalu semua tema berita (user 2026-09-30).
// berita4 & berita11 berberanda page-home.php (bukan index.php), jadi cukup syarat situs berita.
$demo_w = !empty($d['berita']) ? (array) ($d['widget_demo'] ?? []) : [];
$iklan_w = function ($ukuran) use ($media, $buat_lain) {
    $aid = $media["iklan-$ukuran"] ?? 0;
    if (!$aid) { return null; }
    [$w, $h] = array_map('intval', explode('x', $ukuran));
    return $buat_lain('media_image', ['attachment_id' => $aid, 'url' => wp_get_attachment_url($aid), 'title' => '', 'size' => 'full',
        'width' => $w, 'height' => $h, 'caption' => '', 'alt' => 'Ruang iklan', 'link_type' => 'custom', 'link_url' => home_url('/hubungi-kami/'),
        'image_classes' => '', 'link_classes' => '', 'link_rel' => '', 'link_target_blank' => false, 'image_title' => '']);
};
if ($demo_w) {
    $base_ada = [];
    foreach ($GLOBALS['wp_widget_factory']->widgets as $o) { $base_ada[$o->id_base] = true; }
    $kat_w = get_categories(['hide_empty' => true, 'exclude' => [(int) get_option('default_category')]]);
    usort($kat_w, fn($a, $b) => [$b->count, $a->term_id] <=> [$a->count, $b->term_id]);
    $logo = (int) get_theme_mod('custom_logo');
    $teks_w = function ($judul, $isi, $visual = false) use (&$tx) {
        $n = 300; while (isset($tx[$n])) { $n++; }
        $tx[$n] = ['title' => $judul, 'text' => $isi, 'filter' => $visual ? 'content' : false, 'visual' => $visual];
        return "text-$n";
    };
    $demo_item = function ($it) use ($kat_w, $logo, $base_ada, $W, $iklan_w, $teks_w, $buat_html, $buat_lain, &$rp, &$sr) {
        // Widget berkategori (kategori ke-N) dilewati bila klien punya kategori lebih sedikit.
        $k = null;
        if (!empty($it['kategori_ke']) && !($k = $kat_w[(int) $it['kategori_ke'] - 1] ?? null)) { return null; }
        $isi = fn($s) => is_string($s) && $k ? strtr($s, ['{kat_id}' => $k->term_id, '{kat_slug}' => $k->slug, '{kat_nama}' => $k->name]) : $s;
        $opsi = array_map($isi, (array) ($it['opsi'] ?? []));
        switch ($it['jenis'] ?? '') {
            case 'iklan': return $iklan_w($it['ukuran']);
            case 'logo':
                if (!$logo) { return null; }
                $meta = wp_get_attachment_metadata($logo) ?: [];
                return $buat_lain('media_image', ['attachment_id' => $logo, 'url' => wp_get_attachment_url($logo), 'title' => '', 'size' => 'full',
                    'width' => (int) ($meta['width'] ?? 0), 'height' => (int) ($meta['height'] ?? 0), 'caption' => '', 'alt' => get_bloginfo('name'),
                    'link_type' => 'custom', 'link_url' => home_url('/'), 'image_classes' => '', 'link_classes' => '', 'link_rel' => '',
                    'link_target_blank' => false, 'image_title' => '']);
            case 'tentang':
                if (empty($W['footer_tentang'])) { return null; }
                // Judul kosong (logo di atasnya): tanpa logo, nama situs yang jadi judul.
                $judul = $it['judul'] ?? $W['footer_tentang'][0];
                return $buat_html($judul === '' && !$logo ? $W['footer_tentang'][0] : $judul, $W['footer_tentang'][1]);
            case 'statistik': return $teks_w($it['judul'] ?? 'Pengunjung', '[velocity-statistics style="list"]', true);
            case 'text': return $teks_w($isi($it['judul'] ?? ''), $isi($it['isi'] ?? ''));
            case 'widget':
            case 'core':
                $base = (string) ($it['base'] ?? '');
                if (empty($base_ada[$base])) { return null; }
                if ($k && !empty($it['kunci_kategori'])) {
                    $f = $it['format_kategori'] ?? 'id';
                    $opsi[$it['kunci_kategori']] = $f === 'slug' ? $k->slug : ($f === 'nama' ? $k->name : (string) $k->term_id);
                }
                // recent-posts & search disimpan lewat $rp/$sr (ditulis ulang di akhir langkah ini).
                if ($base === 'recent-posts') { $n = 300; while (isset($rp[$n])) { $n++; } $rp[$n] = $opsi; return "recent-posts-$n"; }
                if ($base === 'search') { $n = 300; while (isset($sr[$n])) { $n++; } $sr[$n] = $opsi; return "search-$n"; }
                return $buat_lain($base, $opsi);
        }
        return null;
    };
    foreach ($demo_w as $area => $daftar) {
        if (!isset($wp_registered_sidebars[$area]) || !$boleh($sb[$area] ?? [])) { continue; }
        $hapus_bawaan($sb[$area] ?? []);
        $baru = array_values(array_filter(array_map($demo_item, (array) $daftar)));
        $sb[$area] = $baru; $ubah[] = $area; $semua = array_merge($semua, $baru);
        echo "tampilan: widget_demo_berita:$area:" . count($baru) . "\n";
    }
}
if ($utama && in_array($utama, $ubah, true)) {
    // Sidebar utama sudah disusun seperti demo tema berita.
} elseif ($utama && $panduan_sb && $boleh($sb[$utama] ?? [])) {
    // Panduan pembuat tema menang atas susunan umum (konsultasi, layanan, artikel terbaru).
    $hapus_bawaan($sb[$utama] ?? []);
    $baru = [];
    foreach ($panduan_sb as $it) {
        $base = (string) $it['id_base']; $opsi = (array) ($it['opsi'] ?? []);
        if (isset($nama_pd[$base])) {
            $muat_pd($base); $n = 300; while (isset($opsi_pd[$base][$n])) { $n++; }
            $opsi_pd[$base][$n] = $opsi; $baru[] = "$base-$n";
        } elseif ($base === 'recent-posts') { $n = 300; while (isset($rp[$n])) { $n++; } $rp[$n] = $opsi; $baru[] = "recent-posts-$n"; }
        elseif ($base === 'search') { $n = 300; while (isset($sr[$n])) { $n++; } $sr[$n] = $opsi; $baru[] = "search-$n"; }
        else { $baru[] = $buat_lain($base, $opsi); }
    }
    $sb[$utama] = $baru; $ubah[] = $utama; $semua = array_merge($semua, $baru);
    echo 'tampilan: widget_sidebar_panduan:' . implode(',', $baru) . "\n";
} elseif ($utama && $acuan && $boleh($sb[$utama] ?? [])) {
    $hapus_bawaan($sb[$utama] ?? []);
    $baru = [];
    foreach ($acuan as [$judul, $isi]) {
        $n = 300; while (isset($tx[$n])) { $n++; }
        $tx[$n] = ['title' => $judul, 'text' => $isi, 'filter' => false, 'visual' => false];
        $baru[] = "text-$n";
    }
    $sb[$utama] = $baru; $ubah[] = $utama; $semua = array_merge($semua, $baru);
    echo 'tampilan: widget_sidebar_acuan_tema:' . count($baru) . "\n";
} elseif ($utama && $boleh($sb[$utama] ?? [])) {
    $hapus_bawaan($sb[$utama] ?? []);
    $baru = empty($W['konsultasi']) ? [] : [$buat_html($W['konsultasi'][0], $W['konsultasi'][1])];
    if (!empty($W['layanan'])) { $baru[] = $buat_html($W['layanan'][0], $W['layanan'][1]); }
    if (!$kiri) {
        $n = 300; while (isset($rp[$n])) { $n++; } $rp[$n] = ['title' => 'Artikel Terbaru', 'number' => 5, 'show_date' => false];
        $baru[] = "recent-posts-$n";
    }
    $sb[$utama] = $baru; $ubah[] = $utama; $semua = array_merge($semua, $baru);
}
// Area widget tambahan acuan tema (keputusan user 2026-09-26, velocity-toko14: sidebar kiri = main-sidebar di atas,
// sidebar kanan = secondary-sidebar) lewat velocity_tema_widget_area() = ['<id area>' => [[judul, isi], ...]].
// Aturan sama dengan sidebar utama: area yang sudah disunting orang dibiarkan.
foreach (function_exists('velocity_tema_widget_area') ? (array) velocity_tema_widget_area() : [] as $area => $daftar_acuan) {
    if (!isset($wp_registered_sidebars[$area]) || !$daftar_acuan || !$boleh($sb[$area] ?? [])) { continue; }
    $hapus_bawaan($sb[$area] ?? []);
    $baru = [];
    foreach ((array) $daftar_acuan as [$judul, $isi]) {
        $n = 300; while (isset($tx[$n])) { $n++; }
        $tx[$n] = ['title' => $judul, 'text' => $isi, 'filter' => false, 'visual' => false];
        $baru[] = "text-$n";
    }
    $sb[$area] = $baru; $ubah[] = $area; $semua = array_merge($semua, $baru);
    echo "tampilan: widget_area_acuan_tema:$area:" . count($baru) . "\n";
}
if ($kiri && !in_array($kiri, $ubah, true) && $boleh($sb[$kiri] ?? [])) {
    $hapus_bawaan($sb[$kiri] ?? []);
    $n = 300; while (isset($sr[$n])) { $n++; } $sr[$n] = ['title' => 'Cari'];
    $baru = ["search-$n"];
    $n = 300; while (isset($rp[$n])) { $n++; } $rp[$n] = ['title' => 'Artikel Terbaru', 'number' => 5, 'show_date' => false];
    $baru[] = "recent-posts-$n";
    $n = 300; while (isset($tx[$n])) { $n++; }
    $tx[$n] = ['title' => 'Pengunjung', 'text' => '[velocity-statistics style="list"]', 'filter' => 'content', 'visual' => true];
    $baru[] = "text-$n";
    $sb[$kiri] = $baru; $ubah[] = $kiri; $semua = array_merge($semua, $baru);
}
$kaki = [['footer-widget-1', 'footer_tentang'], ['footer-widget-2', 'footer_kontak'], ['footer-widget-3', 'footer_statistik']];
// Tema dengan acuan footer sendiri (velocity-toko21: kosong, persis demo — keputusan user 2026-09-24):
// widget footer buatan installer/bawaan WordPress dicabut, footer hanya hak cipta dari tema.
if (function_exists('velocity_tema_widget_footer') && !velocity_tema_widget_footer()) {
    foreach (['footer-widget-1', 'footer-widget-2', 'footer-widget-3', 'footer-widget-4'] as $id) {
        if (!isset($wp_registered_sidebars[$id]) || empty($sb[$id]) || !$boleh($sb[$id])) { continue; }
        $hapus_bawaan($sb[$id]); $sb[$id] = []; $ubah[] = $id;
    }
    echo "tampilan: footer_acuan_tema:kosong\n";
    $kaki = [];
} elseif ($demo_w) {
    // Footer tema berita mengikuti demonya (disusun di atas); demo tanpa widget footer = footer kosong.
    $kaki = [];
}
foreach ($kaki as [$id, $k]) {
    if (!isset($wp_registered_sidebars[$id]) || !$boleh($sb[$id] ?? [])) { continue; }
    if (empty($W[$k])) {
        // Tanpa isi (mis. kontak publik tidak ada): widget buatan installer sebelumnya dicabut.
        if (!empty($sb[$id])) { $hapus_bawaan($sb[$id]); $sb[$id] = []; $ubah[] = $id; echo "tampilan: widget_dikosongkan:$id\n"; }
        continue;
    }
    $hapus_bawaan($sb[$id] ?? []);
    if ($k === 'footer_statistik') {
        $n = 300; while (isset($tx[$n])) { $n++; }
        $tx[$n] = ['title' => $W[$k][0], 'text' => $W[$k][1], 'filter' => 'content', 'visual' => true];
        $sb[$id] = ["text-$n"];
    } else { $sb[$id] = [$buat_html($W[$k][0], $W[$k][1])]; }
    $ubah[] = $id; $semua = array_merge($semua, $sb[$id]);
}
foreach (['_multiwidget'] as $x) { $ch[$x] = 1; $tx[$x] = 1; $rp[$x] = 1; $sr[$x] = 1; $blok_w[$x] = 1; }
update_option('widget_block', $blok_w); update_option('widget_custom_html', $ch); update_option('widget_text', $tx); update_option('widget_recent-posts', $rp); update_option('widget_search', $sr);
foreach ($lain as $jenis => $o) { $o['_multiwidget'] = 1; update_option("widget_$jenis", $o); }
foreach ($opsi_pd as $base => $o) { update_option($nama_pd[$base], $o); }
wp_set_sidebars_widgets($sb);
$daftar_milik = [];
foreach ($ubah as $id) { $daftar_milik[md5(wp_json_encode(array_values($sb[$id])))] = array_values($sb[$id]); }
$st['widget'] = ['__semua' => array_values(array_unique(array_merge((array) ($milik['__semua'] ?? []), $semua))), '__daftar' => $daftar_milik];
echo 'tampilan: widget=' . ($ubah ? implode(',', $ubah) : 'dibiarkan') . "\n";

// 6. CSS di antara penanda
$css = wp_get_custom_css();
$tanpa = trim(preg_replace('#/\* velocity-tampilan-klasik \*/.*?/\* /velocity-tampilan-klasik \*/#s', '', $css));
$baru = trim($tanpa . "\n\n" . $d['css']);
if ($baru !== trim($css)) { wp_update_custom_css_post($baru, ['stylesheet' => $tema]); echo "tampilan: css_ditulis\n"; }

// 6c. Header Image (user 2026-10-01, bintanglasjayakontruksi.com): tema klasik Velocity menampilkan judul
// halaman dalam di banner get_header_image(); kosong = halaman dalam tanpa banner & judul. Diisi foto
// banner beranda sekali; kalau orang menggantinya sesudah itu, dibiarkan.
if (!empty($d['situs_baru']) && empty($st['header_image']) && current_theme_supports('custom-header')
    && !get_header_image() && !empty($media['hero'])) {
    $hid = (int) $media['hero']; $hurl = (string) wp_get_attachment_url($hid); $hm = wp_get_attachment_metadata($hid) ?: [];
    if ($hurl !== '') {
        set_theme_mod('header_image', $hurl);
        set_theme_mod('header_image_data', (object) ['attachment_id' => $hid, 'url' => $hurl, 'thumbnail_url' => $hurl,
                                                     'width' => (int) ($hm['width'] ?? 0), 'height' => (int) ($hm['height'] ?? 0)]);
        update_post_meta($hid, '_wp_attachment_is_custom_header', get_stylesheet());
        $st['header_image'] = gmdate('c');
        echo "tampilan: header_image:$hid\n";
    }
}
// 7. Statistik pengunjung (sekali; kalau orang mematikannya sesudah itu, dibiarkan)
if (empty($st['statistik'])) {
    if ((string) get_option('statistik_velocity', '1') !== '1') { update_option('statistik_velocity', '1'); echo "tampilan: statistik_dinyalakan\n"; }
    $st['statistik'] = gmdate('c');
}
$st['diperbarui'] = gmdate('c');
update_option('velocity_tampilan_klasik', $st, false);
$logo_id = (int) get_theme_mod('custom_logo');
echo 'tampilan: logo=' . ($logo_id ? basename((string) get_attached_file($logo_id)) : '-') . ' tema=' . get_stylesheet() . "\n";
echo "tampilan: selesai\n";
'''


KEMBALIKAN_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
$st = get_option('velocity_tampilan_klasik', []);
$t = (string) ($d['tema'] ?? '');
$c = $st['cadangan'][$t] ?? null;
if (!$t || !is_array($c) || get_stylesheet() !== $t) { echo "kembalikan: tidak_ada_cadangan\n"; return; }
foreach ((array) $c['mods'] as $k => $v) { if ($v === null) { remove_theme_mod($k); } else { set_theme_mod($k, $v); } }
$depan = (int) get_option('page_on_front');
if ($depan) {
    if ((string) $c['tpl'] === '') { delete_post_meta($depan, '_wp_page_template'); }
    else { update_post_meta($depan, '_wp_page_template', $c['tpl']); }
}
unset($st['mods'][$t], $st['cadangan'][$t]);
update_option('velocity_tampilan_klasik', $st, false);
echo "kembalikan: selesai\n";
'''


SLOT_IKLAN_PHP = r'''<?php
// Daftar slot gambar iklan/banner tema aktif (Customizer inti & Kirki) beserta ukurannya.
require_once ABSPATH . WPINC . '/class-wp-customize-manager.php';
$slot = [];
try {
    $wpc = new WP_Customize_Manager(); $GLOBALS['wp_customize'] = $wpc; do_action('customize_register', $wpc);
    foreach ($wpc->controls() as $c) {
        if (!is_object($c->setting)) { continue; }
        $gambar = $c instanceof WP_Customize_Media_Control || preg_match('/image|upload|media/i', (string) $c->type);
        $sek = $c->section ? $wpc->get_section($c->section) : null;
        $teks = implode(' ', [$c->setting->id, $c->label, $c->description, $c->section, $sek ? $sek->title : '', $sek && $sek->panel ? $sek->panel : '']);
        if (!$gambar || !preg_match('/banner|iklan|\bads?\b|_ads?_|advert/i', $teks) || preg_match('/logo|favicon|background|latar/i', $c->setting->id)) { continue; }
        $k = $c->setting->id;
        if (preg_match('/(\d{2,4})\s*[x×]\s*(\d{2,4})/u', $c->label . ' ' . $c->description, $m)) { $ukuran = "$m[1]x$m[2]"; }
        else {
            // Tanpa keterangan ukuran (velocity-beritab1): ukuran gambar di demo tema.
            $ukuran = preg_match('/float|kiri|kanan|left|right/i', $k) ? '200x800'
                    : (preg_match('/single_?1/i', $k) ? '500x65' : (preg_match('/header_?2|home_?1/i', $k) ? '970x250' : '970x90'));
        }
        [$w, $h] = array_map('intval', explode('x', $ukuran));
        if ($w < 60 || $h < 40 || $w > 2000 || $h > 2000) { continue; }
        // Image/Upload control & Kirki (save_as url bawaan) menyimpan URL; Media/Cropped & save_as=id menyimpan ID.
        $simpan = ($c instanceof WP_Customize_Upload_Control && !($c instanceof WP_Customize_Cropped_Image_Control))
                  || (!($c instanceof WP_Customize_Media_Control) && (($c->choices['save_as'] ?? 'url') === 'url')) ? 'url' : 'id';
        $slot[$k] = ['ukuran' => "{$w}x{$h}", 'simpan' => $simpan];
    }
} catch (Throwable $t) { echo 'slot_iklan_gagal: ' . $t->getMessage() . "\n"; }
echo 'slot_iklan: ' . wp_json_encode($slot) . "\n";
'''


FOTO_ARTIKEL_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
require_once ABSPATH . 'wp-admin/includes/file.php';
require_once ABSPATH . 'wp-admin/includes/media.php';
require_once ABSPATH . 'wp-admin/includes/image.php';
$admins = get_users(['role' => 'administrator', 'number' => 1, 'orderby' => 'ID']);
wp_set_current_user($admins ? $admins[0]->ID : 1);
$kosong = get_posts(['post_type' => 'post', 'post_status' => 'publish', 'numberposts' => -1, 'orderby' => 'date', 'order' => 'ASC',
                     'meta_query' => [['key' => '_thumbnail_id', 'compare' => 'NOT EXISTS']]]);
$media = function ($kunci) use ($d, $dir) {
    $a = $d['aset'][$kunci];
    $ada = get_posts(['post_type' => 'attachment', 'post_status' => 'inherit', 'numberposts' => 1, 'fields' => 'ids',
                      'meta_key' => '_velocity_tampilan_aset', 'meta_value' => $a['sidik']]);
    if ($ada) { return (int) $ada[0]; }
    $tmp = wp_tempnam($a['file']); copy("$dir/{$a['file']}", $tmp);
    $id = media_handle_sideload(['name' => $a['file'], 'tmp_name' => $tmp], 0, $a['judul'], ['post_excerpt' => $a['caption']]);
    if (is_wp_error($id)) { return 0; }
    update_post_meta($id, '_velocity_tampilan_aset', $a['sidik']);
    update_post_meta($id, '_wp_attachment_image_alt', $a['judul']);
    return (int) $id;
};
$putar = 0; $isi = 0;
foreach ($kosong as $p) {
    if ($d['klien']) {
        $kunci = $d['klien'][$putar++ % count($d['klien'])];
    } else {
        $kat = get_the_category($p->ID);
        $kunci = $d['sampul'][$kat ? $kat[0]->name : ''] ?? ($d['sampul']['*'] ?? '');
    }
    $id = $kunci ? $media($kunci) : 0;
    if ($id) { set_post_thumbnail($p->ID, $id); $isi++; echo "foto_artikel: {$p->ID} <- $kunci\n"; }
}
echo 'foto_artikel: ' . $isi . '/' . count($kosong) . " diisi\n";
'''


def slot_iklan(cfg, domain):
    """{setting: {'ukuran': 'WxH', 'simpan': 'url'|'id'}} slot gambar iklan tema aktif, dibaca dari
    Customizer situs (ukuran dari keterangan kontrol tema, mis. "Iklan Header 728x90")."""
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-slot-{domain}-'))
    SEMENTARA.append(kerja)
    keluar = kirim(cfg, kerja, SLOT_IKLAN_PHP, domain) or ''
    m = re.search(r'^slot_iklan: (\{.*\}|\[\])\s*$', keluar, re.M)
    try:
        return (json.loads(m.group(1)) or {}) if m else {}
    except ValueError:
        return {}


def kirim(cfg, kerja, php, domain):
    """Kirim folder kerja + skrip PHP lewat satu koneksi SSH lalu jalankan dengan wp eval-file."""
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not key or not Path(key).is_file():
        print('tampilan: kunci SSH tidak ada')
        return None
    (kerja / 'terapkan.php').write_text(php)
    finish = muat('site_finish', HERE / 'site-finish')
    ssh = finish.ssh_command(cfg, key)
    docroot = finish.docroot(domain, cfg.get('da_user', ''))
    user = cfg.get('da_user', '')
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode='w:gz') as tar:
        for f in kerja.iterdir():
            tar.add(f, arcname=f.name)
    wp = 'php -d memory_limit=512M /usr/local/bin/wp eval-file "$T/terapkan.php" "$T"'
    jalankan = (f'set -e; T=$(mktemp -d /tmp/velocity-tampilan.XXXXXX); tar xzf - -C "$T"; chmod 755 "$T"; chmod 644 "$T"/*; '
                f'cd {shlex.quote(docroot)}; '
                f'if id {shlex.quote(user)} >/dev/null 2>&1; then runuser -u {shlex.quote(user)} -- {wp} 2>&1 | grep -v Deprecated || true; '
                f'else {wp} --allow-root 2>&1 | grep -v Deprecated || true; fi; rm -rf "$T"')
    hasil = subprocess.run(ssh + [jalankan], input=buf.getvalue(), capture_output=True, timeout=600)
    keluar = hasil.stdout.decode(errors='replace')
    print(keluar.strip())
    if hasil.returncode != 0:
        print(f"tampilan: ssh_gagal (kode {hasil.returncode}) {hasil.stderr.decode(errors='replace').strip()[:300]}")
        return None
    return keluar


def foto_artikel(manifest, cfg, domain):
    try:
        isi = json.loads((GENERATED_DIR / f'{domain}-tema.json').read_text())
    except (OSError, ValueError):
        isi = {}
    nama = cfg.get('site_title') or domain
    warna = (isi.get('warna') or {}).get('utama')
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-foto-{domain}-'))
    SEMENTARA.append(kerja)
    aset, klien, sampul = {}, [], {}
    for i, (p, _, _) in enumerate(foto_klien(domain)[:8], 1):
        kunci = f'klien-{i}'
        try:
            potong(p, 1200, 800, kerja / f'{kunci}.jpg')
        except Exception:
            continue
        aset[kunci] = {'judul': f'Foto {nama}', 'caption': f'Foto: {nama}'}
        klien.append(kunci)
    if not klien:
        kategori = [l['judul'] for l in isi.get('layanan') or [] if l.get('judul')] or ['Artikel']
        for i, k in enumerate(kategori, 1):
            kunci = f'sampul-{i}'
            sampul_kategori(k, nama, warna, kerja / f'{kunci}.jpg')
            aset[kunci] = {'judul': f'Ilustrasi {k}', 'caption': f'Ilustrasi: {k} — {nama}'}
            sampul[k] = kunci
        sampul['*'] = next(iter(sampul.values()))
    for kunci, a in aset.items():
        a.update(file=f'{kunci}.jpg', sidik=f"{domain}:{kunci}:{hashlib.md5((kerja / f'{kunci}.jpg').read_bytes()).hexdigest()}")
    (kerja / 'data.json').write_text(json.dumps({'aset': aset, 'klien': klien, 'sampul': sampul}, ensure_ascii=False))
    print(f"foto_artikel: sumber={'foto_klien:' + str(len(klien)) if klien else 'sampul:' + str(len(sampul) - 1)}")
    if '--coba' in sys.argv:
        print(f'foto_artikel: folder={kerja}')
        return 0
    keluar = kirim(cfg, kerja, FOTO_ARTIKEL_PHP, domain)
    return 0 if keluar and 'diisi' in keluar else 1


GALERI_MAKS = 8


LOGO_CSS_PHP = r'''<?php
$dir = rtrim($args[0] ?? '', '/');
$d = json_decode(file_get_contents("$dir/data.json"), true);
$c = (string) wp_get_custom_css();
$c = preg_replace('#\s*/\* velocity-logo-header \*/.*?/\* /velocity-logo-header \*/#s', '', $c);
if ((string) ($d['css'] ?? '') !== '') {
    $c = rtrim($c) . "\n/* velocity-logo-header */\n" . $d['css'] . "\n/* /velocity-logo-header */\n";
}
wp_update_custom_css_post($c);
echo "tampilan: logo_css_ok\n";
'''


def rapikan_logo(cfg, manifest, domain, keluar_php, logo_panduan=None):
    """Logo header terbaca, tidak melewati latarnya, dan tidak memanjangkan header (user 2026-10-02):
    potret area logo (scripts/logo-header-cek) -> CSS perbaikan di Additional CSS -> ukur ulang.
    Dua putaran: ukuran dulu (logo yang dikecilkan sering sudah muat di latarnya), lalu kontras.

    logo_panduan: {lebar, tinggi, latar_putih} dari child-theme-data-setup.md (Paket F, mis. 226x65
    velocity-perusahaan1): ukuran render itu dipasang sejak putaran pertama dan jadi batas pemeriksaan;
    latar_putih = pelat putih untuk logo yang tidak kontras."""
    lh = muat('logo_header', HERE / 'logo_header.py')
    warna_pelat = None
    if logo_panduan:
        for r in lh.TINGGI_MAKS:
            lh.TINGGI_MAKS[r] = min(lh.TINGGI_MAKS[r], logo_panduan['tinggi'])
            lh.LEBAR_MAKS[r] = min(lh.LEBAR_MAKS[r], logo_panduan['lebar'])
        warna_pelat = '#ffffff' if logo_panduan.get('latar_putih') else None
    m = re.search(r'tampilan: logo=(\S+) tema=(\S+)', keluar_php or '')
    if not m or m.group(1) == '-':
        print('tampilan: logo_cek_dilewati:tanpa_logo')
        return
    nama_logo, tema = m.group(1), m.group(2)
    url = muat('adaptor_tema', HERE / 'adaptor_tema.py').situs_url(domain) + '/'
    cookie, hapus = None, None
    try:
        dca = muat('desain_claude_alat', HERE / 'desain-claude-alat')
        cookie, hapus = dca.cookie_admin(dca.FA.read_manifest(manifest), domain)
    except Exception as e:
        print(f'tampilan: logo_cek_cookie_gagal:{type(e).__name__}')
    folder = Path(tempfile.mkdtemp(prefix='theme-paket-biasa-logo-'))
    SEMENTARA.append(folder)
    try:
        css = ''
        for putaran in (1, 2, 3):
            hasil, pemilih = lh.ukur(url, folder / str(putaran), nama_logo, cookie)
            if not hasil:
                print('tampilan: logo_cek_dilewati:tidak_terpotret')
                return
            soal = lh.masalah(hasil)
            print(f"tampilan: logo_cek{putaran}: {lh.ringkas(hasil)} masalah={','.join(f'{r}:{j}' for r, j in soal) or '-'}")
            # Ukuran panduan berlaku walau logo lolos batas umum; !important supaya CSS_TEMA (250x80) tidak menang.
            dasar = (f"{pemilih}{{width:auto!important;height:auto!important;max-width:min(100%,{logo_panduan['lebar']}px)!important;"
                     f"max-height:{logo_panduan['tinggi']}px!important;object-fit:contain}}"
                     if putaran == 1 and logo_panduan and pemilih else '')
            if (not soal and not dasar) or putaran == 3:
                break
            baru = lh.susun_css(tema, pemilih, hasil, css, warna_pelat) if soal else css
            if dasar:
                baru = '\n'.join(x for x in (dasar, baru) if x)
                print(f"tampilan: logo_ukuran_panduan:{logo_panduan['lebar']}x{logo_panduan['tinggi']}")
            if baru == css:
                break
            css = baru
            kerja = folder / f'css{putaran}'
            kerja.mkdir()
            (kerja / 'data.json').write_text(json.dumps({'css': css}))
            if 'tampilan: logo_css_ok' not in (kirim(cfg, kerja, LOGO_CSS_PHP, domain) or ''):
                print('tampilan: logo_css_gagal')
                return
            print(f'tampilan: logo_css_putaran{putaran}')
    finally:
        if hapus:
            try:
                hapus()
            except Exception:
                pass


def konteks_adaptor(cfg, domain, isi, kontak, galeri=0, klien=()):
    """Data untuk penanda adaptor AI (lihat adaptor_tema.PENANDA)."""
    nama = cfg.get('site_title') or domain
    js = isi.get('judul_seksi') or {}
    return {
        'teks': {
            'nama': nama, 'slogan': isi.get('slogan') or '',
            'hero_judul': pendek(isi.get('hero_judul') or nama, 60),
            'hero_teks': pendek(isi.get('hero_teks'), 260), 'hero_teks_pendek': pendek(isi.get('hero_teks'), 130),
            'profil': isi.get('profil') or isi.get('hero_teks') or '',
            'tentang_judul': js.get('tentang') or f'Tentang {nama}',
            'layanan_judul': js.get('layanan') or 'Layanan Kami', 'layanan_sub': js.get('layanan_sub') or '',
            'keunggulan_judul': js.get('keunggulan') or 'Keunggulan Kami',
            # Telepon dikosongkan di data kontak kalau sama dengan WhatsApp; kolom telepon tema tetap diisi.
            'telp': kontak['telp'] or kontak['wa_tampil'], 'wa': kontak['wa'], 'wa_tampil': kontak['wa_tampil'],
            'wa_link': f"https://wa.me/{kontak['wa']}" if kontak['wa'] else '',
            'email': kontak['email'], 'alamat': kontak['alamat'],
            'link_kontak': '/hubungi-kami/', 'link_layanan': '/layanan/', 'link_berita': '/berita/',
        },
        'daftar': {
            'layanan': [{'slug': l['slug'], 'judul': l['judul'], 'teks': l.get('teks') or '',
                         'teks_pendek': pendek(l.get('teks'), 110), 'rincian': ', '.join(l.get('rincian') or []),
                         'link': f"/layanan/#{l['slug']}"} for l in kartu_beranda([l for l in isi.get('layanan') or [] if l.get('judul')])],
            'keunggulan': [{'judul': k['judul'], 'teks': k.get('teks') or ''}
                           for k in isi.get('keunggulan') or [] if k.get('judul')],
            # Galeri hanya dari foto klien sendiri (galeri-<n>.jpg), bukan foto bank.
            'galeri': [{'slug': str(i), 'judul': f'Foto {nama} {i}'} for i in range(1, galeri + 1)],
            # Logo klien/mitra: asli dari folder klien, atau logo contoh (lihat logo_klien_asli).
            'klien': [{'slug': str(i), 'judul': j} for i, j in enumerate(klien, 1)],
        },
    }


def muat_gen(manifest):
    """ai-content-generator.py sebagai modul (pemanggil AI + pemilih model)."""
    argv_lama = sys.argv
    sys.argv = [argv_lama[0], str(manifest)]
    try:
        return muat('acg_tema', HERE / 'ai-content-generator.py')
    finally:
        sys.argv = argv_lama


def panduan_paket_f(manifest, cfg, info):
    """Aturan dari child-theme-data-setup.md repo tema (scripts/panduan_tema.py), atau None.

    Permintaan user 2026-10-02: hanya child theme Paket F dan hanya instalasi baru — situs yang
    sudah ter-deploy tidak berubah karena panduan yang ditambahkan belakangan."""
    if re.sub(r'\s', '', cfg.get('paket', '').lower()) != 'paketf':
        return None
    if SITUS_LAMA:
        print('tampilan: panduan_tema:dilewati:situs_sudah_terpasang')
        return None
    import panduan_tema as pt
    tema = info['tema']
    teks, sha = pt.ambil(tema)
    if not teks:
        print(f'tampilan: panduan_tema:tidak_ada:{tema}')
        return None
    gen = muat_gen(manifest)
    aturan, alasan = pt.aturan(gen, gen.get_model('tema'), tema, teks, sha, info)
    if not aturan:
        print(f"tampilan: panduan_tema:gagal:{tema}:{','.join(alasan)}")
        return None
    sb = ','.join(w['id_base'] for w in aturan['sidebar'] or []) or '-'
    lg = f"{aturan['logo']['lebar']}x{aturan['logo']['tinggi']}" if aturan['logo'] else '-'
    print(f"tampilan: panduan_tema:dibaca:{tema}@{sha[:7]} sidebar={sb} logo={lg} "
          f"galeri_min={aturan['galeri_min'] or '-'} layanan_min={aturan['layanan_min'] or '-'}")
    for a in alasan:
        print(f'tampilan: panduan_tema_ditolak:{a}')
    for m in aturan['manual']:
        print(f'tampilan: panduan_tema_manual: {m}')
    return aturan


def adaptor_ai(manifest, at, info, panduan=''):
    """Adaptor tersimpan untuk tema+versi ini, atau minta AI membacanya dari file tema.

    panduan: petunjuk Customizer dari child-theme-data-setup.md, dipakai saat adaptor BARU dibuat;
    adaptor yang sudah terverifikasi tidak dibuat ulang karena panduan."""
    catatan = at.muat_adaptor(info) or {}
    if catatan.get('status') in ('terverifikasi', 'belum_diperiksa') and catatan.get('adaptor'):
        print(f"tampilan: adaptor_ai_tersimpan:{catatan['status']}")
        return catatan
    if catatan.get('status') == 'gagal' and int(catatan.get('percobaan') or 0) >= 3:
        print(f"tampilan: adaptor_ai_menyerah:{catatan.get('alasan')}")
        return None
    gen = muat_gen(manifest)
    model = gen.get_model('tema')
    if not model:
        print('tampilan: adaptor_ai_tanpa_model')
        return None
    print(f"tampilan: adaptor_ai_membaca_tema:{info['tema']} {info.get('versi')} ({len(info['file'])} file)")
    adaptor = at.minta_ai(gen, model, info, catatan.get('alasan', '') if catatan.get('status') == 'gagal' else '', panduan)
    if not adaptor:
        at.simpan_adaptor(info, {**catatan, 'status': 'gagal', 'alasan': 'ai_tidak_menghasilkan_adaptor_valid',
                                 'percobaan': int(catatan.get('percobaan') or 0) + 1})
        print('tampilan: adaptor_ai_gagal_dibuat')
        return None
    catatan = {'tema': info['tema'], 'versi': info.get('versi'), 'status': 'belum_diperiksa', 'adaptor': adaptor,
               'percobaan': int(catatan.get('percobaan') or 0) + 1, 'model': model.get('id')}
    at.simpan_adaptor(info, catatan)
    print(f"tampilan: adaptor_ai_dibuat: template={adaptor.get('template')} mods={','.join(adaptor['mods'])}")
    return catatan


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    coba = '--coba' in sys.argv
    if len(args) != 1:
        print('usage: theme-paket-biasa [--foto-artikel] <manifest> [--coba]', file=sys.stderr)
        return 2
    manifest = Path(args[0])
    cfg = read_manifest(manifest)
    domain = cfg.get('domain', '').lower()
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain):
        print('tampilan: manifest_tidak_valid')
        return 2
    if '--foto-artikel' in sys.argv:
        return foto_artikel(manifest, cfg, domain)
    global SITUS_LAMA
    SITUS_LAMA = muat('cari_logo', HERE / 'cari_logo.py').sudah_terpasang(domain) and '--paksa' not in sys.argv
    if re.sub(r'\s', '', cfg.get('paket', '').lower()) in PAKET_CUSTOM or cfg.get('tema_fse'):
        print('tampilan: dilewati:paket_custom_atau_tema_fse')
        return 0
    simpanan = GENERATED_DIR / f'{domain}-tema.json'
    if not simpanan.is_file():
        subprocess.run([sys.executable, str(HERE / 'paket-g-konten'), str(manifest)], check=False)
    try:
        isi = json.loads(simpanan.read_text())
    except (OSError, ValueError):
        print('tampilan: isi_contoh_tidak_ada, langkah dilewati')
        return 1
    if isi.get('jenis') == 'berita':
        isi = {**isi, 'layanan': []}
    vct = muat('velocity_child_theme', HERE / 'velocity-child-theme')
    dk = vct.data_klien(domain, cfg.get('site_title', ''))
    wa = dk.get('WA', '')
    kontak = {'alamat': dk.get('ALAMAT', ''), 'telp': dk.get('TELP', ''), 'wa': wa,
              'wa_tampil': dk.get('TELP', '') or ('0' + wa[2:] if wa else ''), 'email': dk.get('EMAIL_PUBLIK', ''),
              'area': dk.get('AREA', ''),
              # Nomor kedua klien (user 2026-10-01); situs yang sudah ter-deploy tetap satu nomor.
              'wa2': '' if SITUS_LAMA else dk.get('WA2', ''),
              'wa2_tampil': '' if SITUS_LAMA else (dk.get('TELP2', '') or ('0' + dk['WA2'][2:] if dk.get('WA2') else ''))}
    if kontak['telp'] and wa and re.sub(r'\D', '', kontak['telp']).lstrip('0') in (wa[2:], kontak['wa2'][2:]):
        kontak['telp'] = ''  # nomor yang sama cukup tampil sebagai WhatsApp
    print(f"tampilan: kontak alamat={'ya' if kontak['alamat'] else '-'} wa={'ya' if wa else '-'} "
          f"email={'publik' if kontak['email'] else 'tidak_ada'}")
    logo_klien = logo_klien_asli(domain)
    klien_judul = ([re.sub(r'[-_]+', ' ', p.stem).strip().title() or f'Logo klien {i}' for i, p in enumerate(logo_klien, 1)]
                   or [f'Logo klien {i} (contoh)' for i in range(1, KLIEN_CONTOH + 1)])
    print(f"tampilan: logo_klien={'asli:' + str(len(logo_klien)) if logo_klien else 'contoh:' + str(KLIEN_CONTOH)}")
    data = susun(domain, cfg, isi, kontak, len(klien_judul))
    data['berita'] = isi.get('jenis') == 'berita'
    data['template'] = {}

    # Tema aktif dibaca dari server: adaptor buatan tangan dulu, AI untuk tema yang belum dikenal.
    sys.path.insert(0, str(HERE))
    import adaptor_tema as at
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    finish = muat('site_finish', HERE / 'site-finish')
    klien = foto_klien(domain)
    simpan = TEMBOLOK / domain
    galeri = [f'galeri-{i}' for i in range(1, GALERI_MAKS + 1)
              if i <= len(klien) or (simpan / f'galeri-{i}.jpg').is_file()]
    info, catatan_ai, ctx = None, None, konteks_adaptor(cfg, domain, isi, kontak, len(galeri), klien_judul)
    if key and Path(key).is_file():
        try:
            info = at.baca_tema(finish.ssh_command(cfg, key), finish.docroot(domain, cfg.get('da_user', '')), cfg.get('da_user', ''))
        except Exception as e:
            print(f'tampilan: baca_tema_gagal:{e}')
    tema = (info or {}).get('tema', '')
    # Panduan pembuat tema (Paket F): widget sidebar, ukuran logo, jumlah galeri, petunjuk adaptor.
    panduan = None
    if info and tema not in at.BUKAN_ANAK:
        try:
            panduan = panduan_paket_f(manifest, cfg, info)
        except Exception as e:  # panduan tidak boleh menggagalkan langkah tampilan
            print(f'tampilan: panduan_tema:gagal:{type(e).__name__}:{str(e)[:120]}')
    if panduan:
        data['panduan'] = {'sidebar': panduan['sidebar']}
        if panduan['galeri_min'] and len(galeri) < panduan['galeri_min']:
            # Foto klien kurang dari minimal panduan: sisanya foto contoh bebas lisensi (di bawah).
            galeri = [f'galeri-{i}' for i in range(1, panduan['galeri_min'] + 1)]
            ctx = konteks_adaptor(cfg, domain, isi, kontak, len(galeri), klien_judul)
            print(f"tampilan: panduan_galeri_min:{panduan['galeri_min']} foto_klien={len(klien)}")
        n_layanan = len([l for l in isi.get('layanan') or [] if l.get('judul')])
        if panduan['layanan_min'] and n_layanan < panduan['layanan_min']:
            print(f"tampilan: panduan_layanan_kurang:{n_layanan}/{panduan['layanan_min']}")
    maks = LAYANAN_BERANDA_MAKS.get(tema)
    if maks and not SITUS_LAMA and len(ctx['daftar']['layanan']) > maks:
        print(f"tampilan: layanan_beranda_maks:{len(ctx['daftar']['layanan'])}->{maks}")
        ctx['daftar']['layanan'] = ctx['daftar']['layanan'][:maks]
    paksa_ai = '--paksa-ai' in sys.argv
    if info and tema not in at.BUKAN_ANAK and (tema not in data['mods'] or paksa_ai):
        catatan_ai = adaptor_ai(manifest, at, info, (panduan or {}).get('adaptor', ''))
        if catatan_ai:
            ad = catatan_ai['adaptor']
            data['mods'][tema] = at.isi_nilai(ad['mods'], ctx)
            data['bawaan'][tema] = ad.get('bawaan') or {}
            data['template'][tema] = ad.get('template') or ''
            data['cadangan'] = True

    # Gambar: foto klien dulu, lalu foto contoh bank foto, lalu banner polos.
    kerja = Path(tempfile.mkdtemp(prefix=f'theme-paket-biasa-{domain}-'))
    SEMENTARA.append(kerja)
    layanan = [l for l in isi.get('layanan') or [] if l.get('judul')]
    pendamping = ['foto1', 'foto2', 'foto3']
    kunci_perlu = ['hero', 'tentang'] + [f'layanan-{l["slug"]}' for l in layanan] + pendamping + galeri
    if all((simpan / f'{k}.jpg').is_file() for k in kunci_perlu):
        klien = []  # semua gambar sudah pernah disiapkan
        sumber = {k: simpan / f'{k}.jpg' for k in kunci_perlu}
        print('tampilan: gambar_tembolok')
    else:
        sumber = {}
    if klien:
        # Foto klien dipakai bergilir untuk semua slot: foto bank yang mengisi sisa slot pernah
        # berupa pindaian arsip tua di situs yang punya lima foto armada sendiri.
        for i, kunci in enumerate(k for k in kunci_perlu if k not in galeri):
            sumber[kunci] = klien[i % len(klien)][0]
        for i, kunci in enumerate(galeri[:len(klien)]):
            sumber[kunci] = klien[i][0]
    for kunci in galeri:
        if kunci not in sumber and (simpan / f'{kunci}.jpg').is_file():
            sumber[kunci] = simpan / f'{kunci}.jpg'
    slot = []
    if 'hero' in sumber and 'tentang' in sumber and all(k in sumber for k in kunci_perlu):
        pass
    elif 'hero' not in sumber:
        slot.append(('hero', isi.get('hero_foto') or '', 'Banner beranda'))
    if 'tentang' not in sumber:
        slot.append(('tentang', isi.get('tentang_foto') or '', 'Foto tentang kami'))
    slot += [(f'layanan-{l["slug"]}', l.get('foto') or l['judul'], l['judul'])
             for l in layanan if f'layanan-{l["slug"]}' not in sumber]
    slot += [(k, isi.get('hero_foto') or '', f'Foto {i}') for i, k in enumerate(pendamping, 1) if k not in sumber]
    if panduan and panduan['galeri_min']:
        # Galeri minimal panduan (Paket F): slot yang tidak terisi foto klien/tembolok pakai kata kunci isi contoh.
        kata = [g for g in isi.get('galeri') or [] if isinstance(g, dict)]
        slot += [(k, (kata[i]['foto'] if i < len(kata) and kata[i].get('foto') else isi.get('hero_foto') or ''),
                  kata[i].get('judul') or f'Galeri {i + 1}' if i < len(kata) else f'Galeri {i + 1}')
                 for i, k in enumerate(galeri) if k not in sumber]
    slot = [s for s in slot if s[1]]
    if klien:
        print(f'tampilan: foto_klien={len(klien)}')
    slot = [s for s in slot if s[0] not in sumber]
    sumber.update({k: v for k, v in foto_contoh(manifest, isi, slot).items() if k not in sumber})
    aset = {}
    ukuran = {'hero': (1800, 800), 'tentang': (800, 900), **{k: (800, 800) for k in pendamping + galeri}}
    for kunci, berkas in sumber.items():
        w, h = ukuran.get(kunci, (600, 600))
        try:
            if Path(berkas).parent == simpan:
                tujuan = kerja / f'{kunci}.jpg'
                tujuan.write_bytes(Path(berkas).read_bytes())
            else:
                tujuan = potong(berkas, w, h, kerja / f'{kunci}.jpg')
        except Exception as e:
            print(f'tampilan: gambar_gagal:{kunci}:{type(e).__name__}')
            continue
        aset[kunci] = tujuan
    if 'hero' not in aset:
        aset['hero'] = banner_polos(data['nama'], (isi.get('warna') or {}).get('utama'), kerja / 'hero.jpg')
        print('tampilan: banner_polos')
    for i, kunci in enumerate(pendamping):
        cadangan = [k for k in ['tentang'] + [f'layanan-{l["slug"]}' for l in layanan] + ['hero'] if k in aset]
        if kunci not in aset and cadangan:
            aset[kunci] = potong(aset[cadangan[i % len(cadangan)]], 800, 800, kerja / f'{kunci}.jpg')
    # Logo klien asli, atau logo contoh. Hasilnya selalu sama per sumber, jadi sidik md5-nya tetap
    # dan run ulang memakai lampiran yang sudah ada (tanpa tembolok: logo asli yang dikirim
    # belakangan langsung menggantikan contoh).
    for i in range(1, len(klien_judul) + 1):
        kunci = f'klien-{i}'
        try:
            if logo_klien:
                aset[kunci] = kanvas_logo(logo_klien[i - 1], kerja / f'{kunci}.jpg')
            else:
                aset[kunci] = logo_contoh(i, kerja / f'{kunci}.jpg')
        except Exception as e:
            print(f'tampilan: logo_klien_gagal:{kunci}:{type(e).__name__}')
    if not coba:
        simpan.mkdir(parents=True, exist_ok=True)
        for kunci, berkas in aset.items():
            if Path(berkas).parent != simpan:
                (simpan / f'{kunci}.jpg').write_bytes(Path(berkas).read_bytes())
    judul = {'hero': f"Banner {data['nama']}", 'tentang': f"Tentang {data['nama']}"}
    judul.update({f'layanan-{l["slug"]}': l['judul'] for l in layanan})
    judul.update({k: f"Foto {data['nama']}" for k in pendamping})
    judul.update({k: f"Galeri {data['nama']} {k.split('-')[1]}" for k in galeri})
    judul.update({f'klien-{i}': j for i, j in enumerate(klien_judul, 1)})
    iklan = []
    if data['berita']:
        # Halaman Redaksi & Pedoman Media Siber untuk semua tema berita (user 2026-09-30).
        data['berita_halaman'] = halaman_berita(data['nama'], kontak['email'])
    if data['berita'] and not coba:
        # Banner "Ruang Iklan" untuk setiap ukuran slot iklan tema berita aktif.
        data['berita_iklan'] = slot_iklan(cfg, domain)
        ukuran = {v['ukuran'] for v in data['berita_iklan'].values()}
        data['widget_demo'] = widget_demo(tema)
        ukuran |= {i['ukuran'] for daftar in data['widget_demo'].values() for i in daftar if i.get('jenis') == 'iklan'}
        if data['widget_demo']:
            print(f"tampilan: widget_demo={tema} area={','.join(data['widget_demo'])}")
        for u in sorted(ukuran):
            w, h = (int(x) for x in u.split('x'))
            kunci = f'iklan-{u}'
            aset[kunci] = banner_iklan(w, h, data['nama'], (isi.get('warna') or {}).get('utama'),
                                       kontak['email'] or (f"WA {kontak['wa_tampil']}" if kontak['wa_tampil'] else ''),
                                       kerja / f'{kunci}.jpg')
            judul[kunci] = f"Ruang iklan {u} {data['nama']}"
            iklan.append(kunci)
        print(f"tampilan: slot_iklan={len(data['berita_iklan'])} ukuran={','.join(sorted(ukuran)) or '-'}")
    # Hanya slot yang dirujuk pengaturan tema yang diunggah, dan potongan yang isinya sama
    # diunggah sekali: wisesayasatidar.com (Paket E, 2026-09-18) mendapat 16 lampiran dari
    # 7 foto klien, padahal velocity-pakete hanya memakai hero, tentang, dan gambar layanan.
    # Tema yang tidak terbaca: semua adaptor dipindai, karena server memilih mods dari tema aktifnya.
    rujukan = json.dumps([data['mods'].get(tema), data['bawaan'].get(tema)] if tema in data['mods']
                         else [data['mods'], data['bawaan']], ensure_ascii=False)
    dipakai = set(re.findall(r'\{\{(?:id|url):([a-z0-9-]+)\}\}', rujukan)) | set(iklan)
    if data['situs_baru']:
        dipakai.add('hero')  # Header Image tema (banner halaman dalam), lihat langkah 6c PHP
    data['aset'], per_md5 = {}, {}
    for k, p in aset.items():
        if k not in dipakai:
            continue
        md5 = hashlib.md5(p.read_bytes()).hexdigest()
        data['aset'][k] = {'file': f'{k}.jpg', 'judul': judul.get(k, k), 'sidik': f'{domain}:{k}:{md5}'}
        if md5 in per_md5:
            data['aset'][k]['sama'] = per_md5[md5]
        else:
            per_md5[md5] = k
    (kerja / 'data.json').write_text(json.dumps(data, ensure_ascii=False))
    print(f"tampilan: siap aset={','.join(sorted(aset))} layanan={len(layanan)} folder={kerja}")
    print(f"tampilan: aset_dipakai={','.join(sorted(data['aset'])) or '-'} unggah={len(per_md5)}")
    if coba:
        (kerja / 'mods.json').write_text(json.dumps(data['mods'].get(tema), indent=1, ensure_ascii=False))
        return 0
    keluar = kirim(cfg, kerja, REMOTE_PHP, domain)
    if not keluar or 'tampilan: selesai' not in keluar:
        print('tampilan: gagal')
        return 1
    if catatan_ai and 'tampilan: beranda_diisi' in keluar:
        slug = (re.search(r'tampilan: beranda_slug=(\S*)', keluar) or [None, ''])[1]
        lulus, alasan = at.periksa_beranda(domain, slug, ctx, catatan_ai['adaptor'])
        if lulus:
            at.simpan_adaptor(info, {**catatan_ai, 'status': 'terverifikasi', 'alasan': ''})
            print('tampilan: adaptor_ai_terverifikasi')
        elif lulus is None:
            # Beranda tak terjangkau (SSL/jaringan/maintenance) bukan bukti adaptornya salah:
            # hasil dibiarkan terpasang, status adaptor tidak diubah.
            print(f'tampilan: adaptor_ai_tidak_bisa_diperiksa:{alasan}')
        else:
            print(f'tampilan: adaptor_ai_gagal_diperiksa:{alasan}')
            (kerja / 'data.json').write_text(json.dumps({'tema': tema}))
            for f in kerja.glob('*.jpg'):
                f.unlink()
            kirim(cfg, kerja, KEMBALIKAN_PHP, domain)
            at.simpan_adaptor(info, {**catatan_ai, 'status': 'gagal', 'alasan': alasan})
    if not SITUS_LAMA:
        try:
            rapikan_logo(cfg, manifest, domain, keluar, (panduan or {}).get('logo'))
        except Exception as e:  # pemeriksaan tampilan tidak boleh menggagalkan langkah ini
            print(f'tampilan: logo_cek_gagal:{type(e).__name__}:{str(e)[:120]}')
    return 0


if __name__ == '__main__':
    try:
        kode = main()
    finally:
        # WP-CLI di langkah ini berjalan sebagai root: kembalikan pemilik wp-content (scripts/pemilik_wp.py).
        import pemilik_wp
        pemilik_wp.rapikan()
    if '--coba' not in sys.argv:
        import shutil
        for folder in SEMENTARA:
            shutil.rmtree(folder, ignore_errors=True)
    sys.exit(kode)
