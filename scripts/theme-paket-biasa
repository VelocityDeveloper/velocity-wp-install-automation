            // Menu baku installer yang digantikan tidak dipakai lokasi mana pun: dibuang supaya daftar menu bersih.
            if ($utama_id && $utama_id !== $mb && !in_array($utama_id, array_map('intval', $lokasi), true)) {
                wp_delete_nav_menu($utama_id); echo "tampilan: berita_menu_lama_dihapus:$utama_id\n";
            }
            echo 'tampilan: berita_menu:' . count($kat_menu) . '_kategori' . ($kat_lain ? ':lainnya=' . count($kat_lain) : '') . "\n";
        }
    } elseif (!$menu_baku && empty($st['berita_menu'])) { echo "tampilan: berita_menu_dibiarkan:disunting\n"; }
    // Halaman Redaksi & Pedoman Media Siber (demo beritab1): isi contoh bila klien belum mengirim
    // materinya; halaman yang sudah disunting orang dibiarkan.
    foreach ((array) ($d['berita_halaman'] ?? []) as $h) {
        $ada = get_posts(['post_type' => 'page', 'name' => $h['slug'], 'post_status' => 'any', 'numberposts' => 1]);
        if (!$ada) {
            $id = wp_insert_post(['post_type' => 'page', 'post_status' => 'publish', 'post_title' => $h['judul'],
                                  'post_name' => $h['slug'], 'post_content' => $h['isi']], true);
            if (!is_wp_error($id)) { $tandai($id); echo "tampilan: berita_halaman_dibuat:{$h['slug']}:$id\n"; }
        } elseif ($milik_installer($ada[0]->ID) && $ada[0]->post_content !== $h['isi']) {
            wp_update_post(['ID' => $ada[0]->ID, 'post_content' => $h['isi']]); $tandai($ada[0]->ID);
            echo "tampilan: berita_halaman_diperbarui:{$h['slug']}\n";
        }
    }
    // Menu sekunder semua tema berita (demo beritab1: Tentang Kami, Redaksi, Kontak, Pedoman Media Siber).
    // Lokasinya 'secondary-menu' di beritab1, 'secondary' di tema berita lain; dulu hanya menu lama
    // (halaman profil tanpa Redaksi/Pedoman) yang dipindah ke 'secondary', dan bar atas sidoarjopos.id
    // kosong. Tema tanpa lokasi sekunder (berita6/15/17) dilewati. Lokasi yang diisi orang dibiarkan.
    $lok2 = array_values(array_intersect(['secondary-menu', 'secondary'], array_keys(get_registered_nav_menus())))[0] ?? '';
    $lokasi = get_nav_menu_locations();
    // Hanya diisi selama lokasinya kosong: menu yang sudah terpasang (termasuk item yang sengaja dibuang
    // orang, sidoarjopos.id 2026-09-30) tidak dilengkapi ulang.
    if ($lok2 && empty($lokasi[$lok2])) {
        $obj = wp_get_nav_menu_object('Menu Profil');
        $m2 = $obj ? (int) $obj->term_id : (int) wp_create_nav_menu('Menu Profil');
        $ada_id = array_map(fn($it) => (int) $it->object_id, array_filter(wp_get_nav_menu_items($m2) ?: [], fn($it) => $it->object === 'page'));
        $n = count(wp_get_nav_menu_items($m2) ?: []) + 1; $tambah = [];
        // berita4: ikon rumah di depan seperti demo (Bootstrap Icons dari tema induk).
        if ($b4 && $n === 1) {
            wp_update_nav_menu_item($m2, 0, ['menu-item-title' => '<i class="bi bi-house-door fs-6"></i>', 'menu-item-attr-title' => 'Beranda',
                'menu-item-url' => home_url('/'), 'menu-item-classes' => 'align-middle', 'menu-item-type' => 'custom',
                'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
            $tambah[] = 'ikon_home';
        }
        // Tentang Kami, Redaksi, Pedoman Media Siber + 4 kategori pokok khusus beritab1 (terbanyak artikel = urutan form klien);
        // dulu Galeri, Hubungi Kami, Kebijakan Privasi (user 2026-10-06, cybernasional24.com).
        foreach (['tentang-kami', 'redaksi', 'pedoman-media-siber'] as $slug) {
            $p = get_posts(['post_type' => 'page', 'name' => $slug, 'post_status' => 'publish', 'numberposts' => 1]);
            if (!$p || in_array($p[0]->ID, $ada_id, true)) { continue; }
            wp_update_nav_menu_item($m2, 0, ['menu-item-object-id' => $p[0]->ID, 'menu-item-object' => 'page', 'menu-item-type' => 'post_type',
                'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
            $ada_id[] = $p[0]->ID; $tambah[] = $slug;
        }
        $ada_kat = array_map(fn($it) => (int) $it->object_id, array_filter(wp_get_nav_menu_items($m2) ?: [], fn($it) => $it->object === 'category'));
        // 4 kategori di menu sekunder hanya untuk beritab1; tema berita lain cukup 3 halaman profil
        // (user 2026-10-07, faktualekonomi.com).
        foreach (get_stylesheet() === 'velocity-beritab1' ? array_slice($kategori, 0, 4) : [] as $k) {
            if (in_array((int) $k->term_id, $ada_kat, true)) { continue; }
            wp_update_nav_menu_item($m2, 0, ['menu-item-title' => $k->name, 'menu-item-object-id' => $k->term_id, 'menu-item-object' => 'category',
                'menu-item-type' => 'taxonomy', 'menu-item-status' => 'publish', 'menu-item-position' => $n++]);
            $tambah[] = $k->slug;
        }
        $lokasi[$lok2] = $m2; set_theme_mod('nav_menu_locations', $lokasi);
        echo "tampilan: berita_menu_sekunder:$lok2" . ($tambah ? ':' . implode(',', $tambah) : '') . "\n";
    } elseif ($lok2) { echo "tampilan: berita_menu_sekunder_dibiarkan:terpasang\n"; }
    else {
        // Tema tanpa lokasi menu sekunder (berita6/15/17): Tentang Kami, Redaksi, Pedoman Media Siber
        // masuk menu primary buatan installer sesudah kategori (user 2026-09-30). Sekali saja, supaya
        // item yang dibuang orang tidak kembali.
        $mb = (int) ($st['berita_menu'] ?? 0);
        if ($mb && empty($st['berita_menu_profil']) && (int) (get_nav_menu_locations()['primary'] ?? 0) === $mb) {
            $items = wp_get_nav_menu_items($mb) ?: [];
            $ada_id = array_map(fn($it) => (int) $it->object_id, array_filter($items, fn($it) => $it->object === 'page'));
            $n = count($items) + 1; $tambah = [];
            // Menu yang rubriknya sudah dipecah ke dropdown "Lainnya" (lebar penuh): halaman profil ikut ke dropdown itu.
            $lain = array_values(array_filter($items, fn($it) => $it->type === 'custom' && $it->title === 'Lainnya' && !(int) $it->menu_item_parent));
            $induk = $lain ? (int) $lain[0]->ID : 0;
            foreach (['tentang-kami', 'redaksi', 'pedoman-media-siber'] as $slug) {
                $p = get_posts(['post_type' => 'page', 'name' => $slug, 'post_status' => 'publish', 'numberposts' => 1]);
                if (!$p || in_array($p[0]->ID, $ada_id, true)) { continue; }
                wp_update_nav_menu_item($mb, 0, ['menu-item-object-id' => $p[0]->ID, 'menu-item-object' => 'page', 'menu-item-type' => 'post_type',
                    'menu-item-status' => 'publish', 'menu-item-position' => $n++, 'menu-item-parent-id' => $induk]);
                $tambah[] = $slug;
            }
            $st['berita_menu_profil'] = gmdate('c');
            echo 'tampilan: berita_menu_profil_di_primary:' . (implode(',', $tambah) ?: '-') . "\n";
        }
    }
}

// 3. Beranda: template + pengaturan tema
$depan = $berita_depan ? 0 : (int) get_option('page_on_front');
if ($berita_depan) {
    echo "tampilan: beranda_tema_berita\n";
} elseif (isset($d['mods'][$tema]) && $depan) {
    $tpl = get_post_meta($depan, '_wp_page_template', true);
    echo 'tampilan: beranda_slug=' . get_post_field('post_name', $depan) . "\n";
    $file = '';
    if (array_key_exists($tema, $d['template'] ?? [])) {
        // Adaptor AI menyebut templatenya sendiri ('' = beranda tema tidak memakai template halaman).
        $file = (string) $d['template'][$tema];
        if ($file !== '' && !is_file(get_stylesheet_directory() . '/' . $file)) { $file = ''; }
    } else {
        foreach (glob(get_stylesheet_directory() . '/*.php') as $f) {
            if (preg_match('/Template Name:\s*Home Template/i', (string) file_get_contents($f, false, null, 0, 600))) { $file = basename($f); break; }
        }
    }
    if ($file && in_array($tpl, ['', 'default', $file], true)) {
        update_post_meta($depan, '_wp_page_template', $file); echo "tampilan: template_beranda:$file\n";
    }
    $mods = $ganti($d['mods'][$tema]);
    // Kolom alamat header (address/alamat) memakai alamat ringkas; alamat lengkap tetap di footer & kontak.
    if (!empty($d['situs_baru']) && (string) ($d['alamat_pendek'] ?? '') !== '' && $d['alamat_pendek'] !== $d['alamat']) {
        foreach ($mods as $k => $v) {
            if (is_string($v) && preg_match('/address|alamat/i', (string) $k) && trim($v) === trim((string) $d['alamat'])) {
                $mods[$k] = $d['alamat_pendek']; echo "tampilan: alamat_ringkas:$k\n";
            }
        }
    }
    $kini = []; foreach (array_keys($mods) as $k) { $kini[$k] = get_theme_mod($k, null); }
    $bawaan = $d['bawaan'][$tema] ?? [];
    $sama = fn($x, $y) => (is_scalar($x) || $x === null) && (is_scalar($y) || $y === null) ? (string) $x === (string) $y : wp_json_encode($x) === wp_json_encode($y);
    $kosong = !array_filter($kini, fn($v, $k) => $v !== null && $v !== '' && $v !== [] && !(array_key_exists($k, $bawaan) && $sama($v, $bawaan[$k])),
                            ARRAY_FILTER_USE_BOTH);
    $sidik_kini = md5(wp_json_encode($kini));
    if ($kosong || ($st['mods'][$tema] ?? '') === $sidik_kini) {
        if (!empty($d['cadangan']) && empty($st['cadangan'][$tema])) {
            // Keadaan sebelum adaptor AI pertama kali menulis: dipulihkan kalau beranda gagal diperiksa.
            $st['cadangan'][$tema] = ['mods' => $kini, 'tpl' => $tpl];
        }
        foreach ($mods as $k => $v) { set_theme_mod($k, $v); }
        $baca = []; foreach (array_keys($mods) as $k) { $baca[$k] = get_theme_mod($k, null); }
        $st['mods'][$tema] = md5(wp_json_encode($baca));
        echo 'tampilan: beranda_diisi:' . implode(',', array_keys($mods)) . "\n";
    } else { echo "tampilan: beranda_dibiarkan:pengaturan_tema_disunting\n"; }
} else {
    echo "tampilan: beranda_tema_belum_didukung:$tema\n";
}
$tanpa_template = !isset($d['mods'][$tema]) || (array_key_exists($tema, $d['template'] ?? []) && (string) $d['template'][$tema] === '');
if ($depan && $tanpa_template && $d['beranda_blok'] !== '') {
    if (!$milik_installer($depan)) { echo "tampilan: beranda_blok_dibiarkan:disunting\n"; }
    else {
        $isi_b = get_post_field('post_content', $depan);
        $blok_b = "<!-- velocity-beranda -->\n" . $akar($d['beranda_blok']) . "\n<!-- /velocity-beranda -->";
        $baru_b = strpos($isi_b, '<!-- velocity-beranda -->') !== false
            ? preg_replace('#<!-- velocity-beranda -->.*?<!-- /velocity-beranda -->#s', str_replace('$', '\\$', $blok_b), $isi_b)
            : rtrim($isi_b) . "\n" . $blok_b;
        if ($baru_b !== $isi_b) { wp_update_post(['ID' => $depan, 'post_content' => $baru_b]); $tandai($depan); echo "tampilan: beranda_blok_ditulis\n"; }
    }
}

// 3b. Tema toko berberanda index.php (toko8 dkk., unggaslailadjaya.com 2026-10-18): slider + produk + blog
// hanya tampil bila beranda = tulisan terbaru; halaman statis "Beranda" membuatnya cuma teks. Tema
// berberanda page-home.php (toko15 dkk.) dibiarkan. Instalasi baru saja (situs lama mungkin disunting).
// Mods di atas tetap ditulis lewat halaman depan lama; sesudahnya beranda dialihkan, menu Beranda ke "/",
// dan Berita (bukan lagi Posts page) diisi blok Latest Posts selama isinya masih bawaan installer.
if (!empty($d['situs_baru']) && strpos($tema, 'velocity-toko') === 0 && is_file("$sd/index.php")
    && !is_file("$sd/front-page.php") && !is_file("$sd/page-home.php")) {
    $pof = (int) get_option('page_on_front');
    if (get_option('show_on_front') !== 'posts' || $pof) {
        $pfp = (int) get_option('page_for_posts');
        update_option('show_on_front', 'posts'); update_option('page_on_front', 0); update_option('page_for_posts', 0);
        echo "tampilan: toko_beranda_tulisan_terbaru\n";
        $menu_utama = (int) (get_nav_menu_locations()['primary'] ?? 0);
        foreach ($menu_utama && $pof ? wp_get_nav_menu_items($menu_utama) : [] as $it) {
            if ($it->type !== 'post_type' || (int) $it->object_id !== $pof) { continue; }
            wp_update_nav_menu_item($menu_utama, $it->ID, ['menu-item-type' => 'custom', 'menu-item-url' => home_url('/'),
                'menu-item-title' => $it->title, 'menu-item-status' => 'publish', 'menu-item-position' => $it->menu_order,
                'menu-item-parent-id' => (int) $it->menu_item_parent]);
            echo "tampilan: toko_menu_beranda_ke_akar\n";
        }
        $hal_berita = $pfp ?: (int) (get_page_by_path('berita', OBJECT, 'page')->ID ?? 0);
        if ($hal_berita && trim(wp_strip_all_tags(get_post_field('post_content', $hal_berita))) === 'Halaman arsip berita.') {
            wp_update_post(['ID' => $hal_berita, 'post_content' => '<!-- wp:latest-posts {"postsToShow":12,"displayPostContent":true,'
                . '"excerptLength":25,"displayPostDate":true,"displayFeaturedImage":true,"featuredImageSizeSlug":"thumbnail",'
                . '"featuredImageAlign":"left","featuredImageSizeWidth":120,"featuredImageSizeHeight":120,'
                . '"addLinkToFeaturedImage":true} /-->']);
            $tandai($hal_berita); echo "tampilan: toko_berita_latest_posts\n";
        }
    }
}

// 4. Blok kontak di Hubungi Kami
$kontak = get_page_by_path('hubungi-kami', OBJECT, 'page');
if ($kontak) {
    $isi = $kontak->post_content;
