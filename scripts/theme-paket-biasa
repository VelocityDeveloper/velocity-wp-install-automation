    $baru = ["recent-posts-$n"];
    $sb[$kiri] = $baru; $ubah[] = $kiri; $semua = array_merge($semua, $baru);
}
$kaki = [['footer-widget-1', 'footer_tentang'], ['footer-widget-2', 'footer_kontak'], ['footer-widget-3', 'footer_statistik']];
// Tema dengan acuan footer sendiri (velocity-toko21: kosong, persis demo — keputusan user 2026-09-24):
// widget footer buatan installer/bawaan WordPress dicabut, footer hanya hak cipta dari tema.
if (function_exists('velocity_tema_widget_footer') && !velocity_tema_widget_footer()) {
    foreach (['footer-widget-1', 'footer-widget-2', 'footer-widget-3', 'footer-widget-4'] as $id) {
        if (!isset($wp_registered_sidebars[$id]) || empty($sb[$id]) || !$boleh($sb[$id])) { continue; }
        $hapus_bawaan($sb[$id]); $sb[$id] = []; $ubah[] = $id;
    }
    echo "tampilan: footer_acuan_tema:kosong\n";
    $kaki = [];
} elseif ($demo_w) {
    // Footer tema berita mengikuti demonya (disusun di atas); demo tanpa widget footer = footer kosong.
    $kaki = [];
}
foreach ($kaki as [$id, $k]) {
    if (!isset($wp_registered_sidebars[$id]) || !$boleh($sb[$id] ?? [])) { continue; }
    if (empty($W[$k])) {
        // Tanpa isi (mis. kontak publik tidak ada): widget buatan installer sebelumnya dicabut.
        if (!empty($sb[$id])) { $hapus_bawaan($sb[$id]); $sb[$id] = []; $ubah[] = $id; echo "tampilan: widget_dikosongkan:$id\n"; }
        continue;
    }
    $hapus_bawaan($sb[$id] ?? []);
    if ($k === 'footer_statistik') {
        $n = 300; while (isset($tx[$n])) { $n++; }
        $tx[$n] = ['title' => $W[$k][0], 'text' => $W[$k][1], 'filter' => 'content', 'visual' => true];
        $sb[$id] = ["text-$n"];
    } else { $sb[$id] = [$buat_html($W[$k][0], $W[$k][1])]; }
    $ubah[] = $id; $semua = array_merge($semua, $sb[$id]);
}
foreach (['_multiwidget'] as $x) { $ch[$x] = 1; $tx[$x] = 1; $rp[$x] = 1; $sr[$x] = 1; $blok_w[$x] = 1; }
update_option('widget_block', $blok_w); update_option('widget_custom_html', $ch); update_option('widget_text', $tx); update_option('widget_recent-posts', $rp); update_option('widget_search', $sr);
foreach ($lain as $jenis => $o) { $o['_multiwidget'] = 1; update_option("widget_$jenis", $o); }
foreach ($opsi_pd as $base => $o) { update_option($nama_pd[$base], $o); }
wp_set_sidebars_widgets($sb);
$daftar_milik = [];
foreach ($ubah as $id) { $daftar_milik[md5(wp_json_encode(array_values($sb[$id])))] = array_values($sb[$id]); }
$st['widget'] = ['__semua' => array_values(array_unique(array_merge((array) ($milik['__semua'] ?? []), $semua))), '__daftar' => $daftar_milik];
echo 'tampilan: widget=' . ($ubah ? implode(',', $ubah) : 'dibiarkan') . "\n";

// 6. CSS di antara penanda
$css = wp_get_custom_css();
