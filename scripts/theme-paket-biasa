import shlex
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

from PIL import Image, ImageDraw, ImageOps

HERE = Path(__file__).resolve().parent
SEMENTARA = []  # folder kerja yang dihapus di akhir run (bukan --coba)
GENERATED_DIR = Path('/var/lib/velocity/ai/generated')
# Gambar yang sudah disiapkan per domain: run ulang (mode finish) memakai berkas yang sama,
# jadi foto bank tidak dipilih ulang dan media situs tidak menumpuk.
TEMBOLOK = Path('/var/lib/velocity/tampilan')
ON_PROGRESS = Path('/home/On Progress')
PAKET_CUSTOM = ('paketg', 'paketportalberitacustom', 'pakettokoonlinecustom')
SOSMED = (('facebook', 'https://www.facebook.com/', 'Facebook'), ('instagram', 'https://www.instagram.com/', 'Instagram'),
          ('twitter-x', 'https://x.com/', 'X'), ('youtube', 'https://www.youtube.com/', 'YouTube'),
          ('tiktok', 'https://www.tiktok.com/', 'TikTok'))


def muat(nama, berkas):
    loader = importlib.machinery.SourceFileLoader(nama, str(berkas))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def read_manifest(path):
    cfg = {}
    for baris in Path(path).read_text(errors='replace').splitlines():
        baris = baris.strip()
        if baris and not baris.startswith('#') and '=' in baris:
            k, v = baris.split('=', 1)
            cfg[re.sub(r'\s', '', k)] = v.strip()
    return cfg


e = lambda s: html.escape(str(s or ''), quote=True)


def pendek(teks, batas):
    """Potong di batas kalimat/kata tanpa memotong kata."""
    teks = re.sub(r'\s+', ' ', str(teks or '')).strip()
    if len(teks) <= batas:
        return teks
    kalimat = re.match(r'^(.{40,%d}?[.!?])\s' % batas, teks + ' ')
    if kalimat:
        return kalimat.group(1)
    return teks[:batas].rsplit(' ', 1)[0].rstrip(',;:') + '…'


# ---------- gambar ----------

def potong(sumber, lebar, tinggi, tujuan):
    im = ImageOps.exif_transpose(Image.open(sumber)).convert('RGB')
    ImageOps.fit(im, (lebar, tinggi), Image.LANCZOS, centering=(0.5, 0.45)).save(tujuan, quality=85, optimize=True)
    return tujuan


def banner_polos(nama, warna, tujuan, lebar=1800, tinggi=800):
    """Cadangan terakhir bila tidak ada foto klien maupun foto contoh: gradasi warna utama."""
    try:
        r, g, b = (int(warna[i:i + 2], 16) for i in (1, 3, 5))
    except (TypeError, ValueError):
        r, g, b = (30, 64, 124)
    gelap = (max(r // 3, 0), max(g // 3, 0), max(b // 3, 0))
    im = Image.new('RGB', (lebar, tinggi))
    d = ImageDraw.Draw(im)
    for x in range(lebar):
        t = x / (lebar - 1)
        d.line([(x, 0), (x, tinggi)], fill=tuple(int(gelap[i] + ((r, g, b)[i] - gelap[i]) * t) for i in range(3)))
    lapis = Image.new('RGBA', (lebar, tinggi), (0, 0, 0, 0))
    dl = ImageDraw.Draw(lapis)
    for k in range(-tinggi, lebar, 46):
        dl.line([(k, tinggi), (k + tinggi, 0)], fill=(255, 255, 255, 12), width=2)
    Image.alpha_composite(im.convert('RGBA'), lapis).convert('RGB').save(tujuan, quality=86)
    return tujuan


def sampul_kategori(judul, nama, warna, tujuan):
    """Sampul artikel bertuliskan kategori & nama situs di atas gradasi warna utama."""
    from PIL import ImageFont
    banner_polos(nama, warna, tujuan, 1200, 800)
    im = Image.open(tujuan).convert('RGB')
    d = ImageDraw.Draw(im)
    def huruf(nama_berkas, besar):
        for f in (f'/usr/share/fonts/urw-base35/{nama_berkas}', '/usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf'):
            try:
                return ImageFont.truetype(f, besar)
            except OSError:
                continue
        return ImageFont.load_default()
    fb, fs = huruf('C059-Bold.otf', 70), huruf('C059-Roman.otf', 30)
    kata, baris, kini = judul.split(), [], ''
    for k in kata:
        uji = (kini + ' ' + k).strip()
        if d.textlength(uji, font=fb) > 980 and kini:
            baris.append(kini)
            kini = k
        else:
            kini = uji
    baris.append(kini)
    y = 400 - (len(baris) * 86 + 70) // 2
    for b in baris:
        d.text(((1200 - d.textlength(b, font=fb)) / 2, y), b, font=fb, fill=(255, 255, 255))
        y += 86
    d.line([(540, y + 14), (660, y + 14)], fill=(255, 255, 255), width=3)
    d.text(((1200 - d.textlength(nama, font=fs)) / 2, y + 34), nama, font=fs, fill=(235, 240, 250))
    im.save(tujuan, quality=86)
    return tujuan


def foto_klien(domain):
    finish = muat('site_finish', HERE / 'site-finish')
    _, foto = finish.client_assets(ON_PROGRESS / domain)
    hasil = []
    for p in foto:
        try:
            with Image.open(p) as im:
                w, h = ImageOps.exif_transpose(im).size
        except Exception:
            continue
        if min(w, h) >= 500:
            hasil.append((p, w, h))
    # Lanskap besar dulu untuk banner.
    return sorted(hasil, key=lambda x: (x[1] / x[2] < 1.2, -(x[1] * x[2])))


def foto_contoh(manifest, isi, slot):
    """Foto bank bebas lisensi (CC0/PDM) lewat pemilih paket-g-foto; {kunci: berkas lokal}."""
    if not slot:
        return {}
    try:
        pgf = muat('paket_g_foto', HERE / 'paket-g-foto')
        ai = pgf.muat_ai(manifest)
        pilihan = pgf.pilih_foto(slot, isi, pgf.Openverse(), ai)
    except Exception as e:
        print(f'tampilan: foto_contoh_gagal:{type(e).__name__}')
        return {}
    hasil = {}
    folder = Path(tempfile.mkdtemp(prefix='theme-paket-biasa-foto-'))
    SEMENTARA.append(folder)
    for kunci, (r, _) in pilihan.items():
        berkas = folder / f'{kunci}.img'
        try:
            pgf.unduh(r['url'], berkas)
            hasil[kunci] = berkas
            print(f"tampilan: foto_contoh:{kunci}: {pgf.judul_foto(r)[:60]}")
        except Exception as e:
            print(f'tampilan: foto_contoh_gagal_unduh:{kunci}:{type(e).__name__}')
    return hasil


# ---------- isi ----------

def ikon_sosial():
    return ('<ul class="vk-sosmed">' + ''.join(
        f'<li><a href="{u}" target="_blank" rel="noopener" aria-label="{n}"><i class="bi bi-{i}" aria-hidden="true"></i></a></li>'
        for i, u, n in SOSMED) + '</ul>')


def tautan_email(email):
    # <wbr> sebelum @: kolom sempit (sidebar) memotong di situ, bukan di tengah kata.
    user, _, dom = email.partition('@')
    return f'<a href="mailto:{e(email)}">{e(user)}<wbr>@{e(dom)}</a>'


def daftar_kontak(k, alamat=True):
    baris = []
    if alamat and k['alamat']:
        baris.append(f'<li><i class="bi bi-geo-alt" aria-hidden="true"></i> <span>{e(k["alamat"])}</span></li>')
    if k['telp']:
        digit = re.sub(r'\D', '', k['telp'])
        tel = '+62' + digit[1:] if digit.startswith('0') else '+' + digit
        baris.append(f'<li><i class="bi bi-telephone" aria-hidden="true"></i> <a href="tel:{tel}">{e(k["telp"])}</a></li>')
    if k['wa']:
        baris.append(f'<li><i class="bi bi-whatsapp" aria-hidden="true"></i> <a href="https://wa.me/{k["wa"]}" target="_blank" rel="noopener">WhatsApp {e(k["wa_tampil"])}</a></li>')
    if k['email']:
        baris.append(f'<li><i class="bi bi-envelope" aria-hidden="true"></i> {tautan_email(k["email"])}</li>')
    return '<ul class="vk-kontak">' + ''.join(baris) + '</ul>' if baris else ''


def susun(domain, cfg, isi, kontak):
    nama = cfg.get('site_title') or domain
    layanan = [l for l in isi.get('layanan') or [] if l.get('judul')]
    js = isi.get('judul_seksi') or {}
    halaman_layanan = ''
    if layanan:
        halaman_layanan = (f'<p>{e(js.get("layanan_sub") or "Layanan yang kami sediakan untuk kebutuhan Anda.")}</p>\n'
            + '\n'.join(f'''<section class="vk-layanan" id="{e(l["slug"])}">
<h2>{e(l["judul"])}</h2>
<p>{e(l.get("teks"))}</p>''' + ('<ul>' + ''.join(f'<li>{e(r)}</li>' for r in l.get('rincian') or []) + '</ul>' if l.get('rincian') else '')
                        + '\n</section>' for l in layanan)
            + f'\n<p class="vk-ajakan">Butuh informasi lebih lanjut? <a href="/hubungi-kami/">Hubungi {e(nama)}</a>.</p>')
    blok_kontak = (f'<div class="vk-kartu vk-kontak-utama">\n<h2>Informasi Kontak</h2>\n{daftar_kontak(kontak)}\n{ikon_sosial()}\n</div>')
    tentang = pendek(isi.get('profil') or isi.get('hero_teks'), 170)
    widget = {
        'konsultasi': ('Hubungi Kami', daftar_kontak(kontak, alamat=False)
                       + (f'<p><a class="btn btn-sm vk-tombol w-100 mt-2" href="https://wa.me/{kontak["wa"]}" target="_blank" rel="noopener">Chat via WhatsApp</a></p>' if kontak['wa'] else '')),
        'layanan': (js.get('layanan') or 'Layanan Kami',
                    '<ul>' + ''.join(f'<li><a href="/layanan/#{e(l["slug"])}">{e(l["judul"])}</a></li>' for l in layanan) + '</ul>') if layanan else None,
        'footer_tentang': (nama, f'<p>{e(tentang)}</p>'
                           + (f'<p class="vk-email"><i class="bi bi-envelope" aria-hidden="true"></i> {tautan_email(kontak["email"])}</p>'
                              if kontak['email'] else '')
                           + ikon_sosial()),
        'footer_kontak': ('Kontak', daftar_kontak({**kontak, 'email': ''})),
        'footer_statistik': ('Statistik Pengunjung', '[velocity-statistics style="list"]'),
    }
    widget = {k: v for k, v in widget.items() if v}
    # Tema tanpa template beranda / tanpa adaptor: kartu layanan + ajakan ditambahkan ke isi halaman Beranda.
    beranda_blok = ''
    if layanan:
        beranda_blok = (f'<h2>{e(js.get("layanan") or "Layanan Kami")}</h2>\n<div class="vk-kartu-grid">'
                        + ''.join(f'<div class="vk-kartu"><h3>{e(l["judul"])}</h3><p>{e(pendek(l.get("teks"), 140))}</p>'
                                  f'<p><a href="/layanan/#{e(l["slug"])}">Selengkapnya</a></p></div>' for l in layanan)
                        + '</div>')
    beranda_blok += (f'\n<p class="vk-ajakan">Hubungi {e(nama)} untuk informasi dan pemesanan: '
                     f'<a href="/hubungi-kami/">Hubungi Kami</a>'
                     + (f' atau <a href="https://wa.me/{kontak["wa"]}" target="_blank" rel="noopener">WhatsApp</a>' if kontak['wa'] else '')
                     + '.</p>')
    mods = {
        'velocity-pakete': {
            'banner_image': '{{url:hero}}',
            'banner_title': pendek(isi.get('hero_judul') or nama, 60),
            'banner_desc': pendek(isi.get('hero_teks'), 110),
            'judul_layanan': js.get('layanan') or 'Layanan Kami',
            'services_list': [{'service_title': l['judul'], 'service_desc': pendek(l.get('teks'), 110),
                               'service_text_link': 'Selengkapnya', 'service_link': f'/layanan/#{l["slug"]}'} for l in layanan],
        },
        'velocity-perusahaan2': {
            'home_banner': '{{id:hero}}',
            'subtitle_banner': 'Selamat Datang di',
            'title_banner': e(nama),
            'content_banner': e(pendek(isi.get('hero_teks'), 130)),  # teks rata kanan-kiri renggang di HP bila panjang
            'button1_banner': 'Hubungi Kami', 'link1_banner': '/hubungi-kami/',
            'button2_banner': 'Layanan' if layanan else '', 'link2_banner': '/layanan/' if layanan else '',
            'sambutan': (f'<h2>{e(js.get("tentang") or "Tentang " + nama)}</h2><p>{e(isi.get("profil") or isi.get("hero_teks"))}</p>'
                         + ('<ul class="vk-poin">' + ''.join(f'<li><strong>{e(k["judul"])}</strong> &mdash; {e(k.get("teks"))}</li>'
                                                             for k in (isi.get('keunggulan') or [])[:4]) + '</ul>' if isi.get('keunggulan') else '')),
            'sambutan_image': '{{id:tentang}}',
            'layanan_repeater': [{'layanan_image': '{{id:layanan-%s}}' % l['slug'], 'layanan_title': l['judul'],
                                  'layanan_content': e(pendek(l.get('teks'), 150)), 'layanan_linktext': 'Selengkapnya',
                                  'layanan_link': f'/layanan/#{l["slug"]}'} for l in layanan],
            'title_homelogo': '',
            'logo_repeater': [],
        },
    }
    # Nilai yang disimpan tema sendiri saat diaktifkan: dianggap belum diisi orang.
    bawaan = {
        'velocity-pakete': {'banner_image': '', 'banner_title': '', 'banner_desc': '', 'judul_layanan': 'Layanan Kami',
                            'services_list': []},
        'velocity-perusahaan2': {'home_banner': 0, 'subtitle_banner': 'Selamat Datang di',
                                 'title_banner': 'Perusahaan 2<br>Velocity Developer', 'content_banner': '',
                                 'button1_banner': 'Hubungi Kami', 'link1_banner': '#', 'button2_banner': 'Layanan',
                                 'link2_banner': '#', 'sambutan': '', 'sambutan_image': 0, 'layanan_repeater': [],
                                 'title_homelogo': 'Klien Kami', 'logo_repeater': []},
    }
    return {
        'domain': domain, 'nama': nama, 'bawaan': bawaan, 'beranda_blok': beranda_blok,
        'halaman_layanan': halaman_layanan,
        'blok_kontak': blok_kontak,
        'widget': widget,
        'mods': mods,
        'css': CSS,
    }


