          ('twitter-x', 'https://x.com/', 'X'), ('youtube', 'https://www.youtube.com/', 'YouTube'),
          ('tiktok', 'https://www.tiktok.com/', 'TikTok'))


def muat(nama, berkas):
    loader = importlib.machinery.SourceFileLoader(nama, str(berkas))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def read_manifest(path):
    cfg = {}
    for baris in Path(path).read_text(errors='replace').splitlines():
        baris = baris.strip()
        if baris and not baris.startswith('#') and '=' in baris:
            k, v = baris.split('=', 1)
            cfg[re.sub(r'\s', '', k)] = v.strip()
    return cfg


e = lambda s: html.escape(str(s or ''), quote=True)


def pendek(teks, batas):
    """Potong di batas kalimat/kata tanpa memotong kata."""
    teks = re.sub(r'\s+', ' ', str(teks or '')).strip()
    if len(teks) <= batas:
        return teks
    kalimat = re.match(r'^(.{40,%d}?[.!?])\s' % batas, teks + ' ')
    if kalimat:
        return kalimat.group(1)
    return teks[:batas].rsplit(' ', 1)[0].rstrip(',;:') + '…'


def alamat_pendek(alamat, area='', batas=48):
    """Alamat ringkas untuk kolom sempit header tema (Address velocity-perusahaan1 terpotong
    setelah ±3 baris, bintanglasjayakontruksi.com 2026-10-01): nama jalan + nomor, lalu kota.
    Alamat lengkap tetap di footer & halaman kontak."""
    alamat = re.sub(r'\s+', ' ', str(alamat or '')).strip(' ,.')
    if len(alamat) <= batas:
        return alamat
    jalan = re.split(r',|\s(?=(?:rt|rw)(?=[\s.:/\d])|(?:kec|kel|kecamatan|kelurahan|desa|kab|kabupaten|kota|depan|samping|belakang|dekat|sebelah)\b)',
                     alamat, maxsplit=1, flags=re.I)[0].strip(' ,.')
    jalan = re.sub(r'^jalan\b\.?', 'Jl.', jalan, flags=re.I)
    jalan = ' '.join(k.capitalize() if re.fullmatch(r'[a-z]+', k) else k for k in jalan.split(' '))
    area = re.sub(r'\s+', ' ', str(area or '')).strip()
    if area.lower() in ('', 'sekitarnya') or area.lower() in jalan.lower():
        area = ''
    hasil = ', '.join(x for x in (jalan, area.title() if area == area.lower() else area) if x)
    return hasil if len(hasil) <= batas + 15 else pendek(hasil, batas + 15)


# ---------- gambar ----------

def potong(sumber, lebar, tinggi, tujuan):
    im = ImageOps.exif_transpose(Image.open(sumber)).convert('RGB')
    ImageOps.fit(im, (lebar, tinggi), Image.LANCZOS, centering=(0.5, 0.45)).save(tujuan, quality=85, optimize=True)
    return tujuan


def banner_polos(nama, warna, tujuan, lebar=1800, tinggi=800):
    """Cadangan terakhir bila tidak ada foto klien maupun foto contoh: gradasi warna utama."""
    try:
        r, g, b = (int(warna[i:i + 2], 16) for i in (1, 3, 5))
    except (TypeError, ValueError):
        r, g, b = (30, 64, 124)
    gelap = (max(r // 3, 0), max(g // 3, 0), max(b // 3, 0))
    im = Image.new('RGB', (lebar, tinggi))
    d = ImageDraw.Draw(im)
    for x in range(lebar):
        t = x / (lebar - 1)
        d.line([(x, 0), (x, tinggi)], fill=tuple(int(gelap[i] + ((r, g, b)[i] - gelap[i]) * t) for i in range(3)))
    lapis = Image.new('RGBA', (lebar, tinggi), (0, 0, 0, 0))
    dl = ImageDraw.Draw(lapis)
    for k in range(-tinggi, lebar, 46):
        dl.line([(k, tinggi), (k + tinggi, 0)], fill=(255, 255, 255, 12), width=2)
    Image.alpha_composite(im.convert('RGBA'), lapis).convert('RGB').save(tujuan, quality=86)
    return tujuan


def sampul_kategori(judul, nama, warna, tujuan):
    """Sampul artikel bertuliskan kategori & nama situs di atas gradasi warna utama."""
    from PIL import ImageFont
    banner_polos(nama, warna, tujuan, 1200, 800)
    im = Image.open(tujuan).convert('RGB')
    d = ImageDraw.Draw(im)
    def huruf(nama_berkas, besar):
        for f in (f'/usr/share/fonts/urw-base35/{nama_berkas}', '/usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf'):
            try:
                return ImageFont.truetype(f, besar)
            except OSError:
                continue
        return ImageFont.load_default()
    fb, fs = huruf('C059-Bold.otf', 70), huruf('C059-Roman.otf', 30)
    kata, baris, kini = judul.split(), [], ''
    for k in kata:
        uji = (kini + ' ' + k).strip()
        if d.textlength(uji, font=fb) > 980 and kini:
            baris.append(kini)
            kini = k
        else:
            kini = uji
    baris.append(kini)
    y = 400 - (len(baris) * 86 + 70) // 2
    for b in baris:
        d.text(((1200 - d.textlength(b, font=fb)) / 2, y), b, font=fb, fill=(255, 255, 255))
        y += 86
    d.line([(540, y + 14), (660, y + 14)], fill=(255, 255, 255), width=3)
    d.text(((1200 - d.textlength(nama, font=fs)) / 2, y + 34), nama, font=fs, fill=(235, 240, 250))
    im.save(tujuan, quality=86)
    return tujuan


# Banner "Ruang Iklan" polos yang siap diganti pemilik, satu per ukuran slot iklan tema berita aktif
# (permintaan user 2026-09-30, sidoarjopos.id). Demo tema memakai iklan merek sungguhan, jadi tidak
# disalin. Widget iklan di sidebar/footer memakai ukuran iklan demo temanya (widget-demo.json).


def widget_demo(tema):
    """Susunan widget demo tema berita aktif ({id area: [item]}) tanpa item bertanda lewati."""
    try:
        semua = json.loads((HERE.parent / 'templates' / 'portal-berita' / 'widget-demo.json').read_text())
    except (OSError, ValueError):
        return {}
    areas = (semua.get(tema) or {}).get('areas') or {}
    return {a: [i for i in daftar if not i.get('lewati')] for a, daftar in areas.items()}


def banner_iklan(lebar, tinggi, nama, warna, kontak, tujuan):
    """Banner "Ruang Iklan" di atas gradasi warna utama; teks menyesuaikan bentuk slot."""
    from PIL import ImageFont
    banner_polos(nama, warna, tujuan, lebar, tinggi)
    im = Image.open(tujuan).convert('RGB')
    d = ImageDraw.Draw(im)
    def huruf(tebal, besar):
        berkas = 'DejaVuSans-Bold.ttf' if tebal else 'DejaVuSans.ttf'
        try:
            return ImageFont.truetype(f'/usr/share/fonts/dejavu-sans-fonts/{berkas}', max(besar, 8))
        except OSError:
            return ImageFont.load_default()
    ajakan = f'Pasang iklan Anda di {nama}'
    d.rectangle([3, 3, lebar - 4, tinggi - 4], outline=(255, 255, 255), width=2)
    if lebar / tinggi >= 4:
        # Pita mendatar: "RUANG IKLAN | ajakan · kontak" dalam satu baris, huruf mengecil sampai muat.
        # Kontak dibuang bila membuat tulisan terlalu kecil untuk dibaca (slot 500x65).
        for sisi in [' · '.join(x for x in (ajakan, kontak) if x), ajakan]:
            for besar in range(int(tinggi * .34), 7, -1):
                fb, fs = huruf(True, besar), huruf(False, int(besar * .62))
                lb, ls = d.textlength('RUANG IKLAN', font=fb), d.textlength(sisi, font=fs)
                if lb + ls + besar * 1.6 <= lebar * .92:
                    break
            if fs.size >= 12:
                break
        x = (lebar - lb - ls - besar * 1.6) / 2
        d.text((x, tinggi / 2), 'RUANG IKLAN', font=fb, fill=(255, 255, 255), anchor='lm')
        x += lb + besar * .8
        d.line([(x, tinggi * .28), (x, tinggi * .72)], fill=(255, 255, 255), width=2)
        d.text((x + besar * .8, tinggi / 2), sisi, font=fs, fill=(235, 242, 252), anchor='lm')
    else:
        # Kotak/tegak: judul besar di tengah, ajakan & kontak dibungkus per kata di bawahnya.
        fb = huruf(True, int(min(lebar * .15, tinggi * .16)))
        fs = huruf(False, int(min(lebar * .075, tinggi * .075)))
        # Alamat email tidak bisa dibungkus: huruf kecil diperkecil sampai kontak muat selebar slot.
        while kontak and fs.size > 9 and d.textlength(kontak, font=fs) > lebar * .86:
            fs = huruf(False, fs.size - 1)
        if kontak and d.textlength(kontak, font=fs) > lebar * .9:
            kontak = ''  # slot terlalu sempit (150x500): kontak tidak ditampilkan daripada terpotong
        def bungkus(teks, font):
            baris, kini = [], ''
            for k in teks.split():
                uji = (kini + ' ' + k).strip()
                if d.textlength(uji, font=font) > lebar * .84 and kini:
                    baris.append(kini)
                    kini = k
                else:
                    kini = uji
            return baris + [kini] if kini else baris
        judul = bungkus('RUANG IKLAN', fb) if d.textlength('RUANG IKLAN', font=fb) > lebar * .84 else ['RUANG IKLAN']
        kecil = bungkus(ajakan, fs) + ([''] + bungkus(kontak, fs) if kontak else [])
        tb, ts = fb.size * 1.2, fs.size * 1.45
        y = (tinggi - len(judul) * tb - fs.size - len(kecil) * ts) / 2
        for b in judul:
            d.text((lebar / 2, y), b, font=fb, fill=(255, 255, 255), anchor='ma')
            y += tb
        d.line([(lebar * .38, y + fs.size * .4), (lebar * .62, y + fs.size * .4)], fill=(255, 255, 255), width=2)
        y += fs.size
        for b in kecil:
            d.text((lebar / 2, y), b, font=fs, fill=(235, 242, 252), anchor='ma')
            y += ts
    im.save(tujuan, quality=88)
    return tujuan


def halaman_berita(nama, email):
    """Halaman Redaksi & Pedoman Media Siber seperti demo beritab1, dipakai bila klien belum
    mengirim materinya. Judul bagian <p><strong> (pola halaman situs berita buatan webmaster)."""
    peran = ('Pemimpin Redaksi', 'Redaktur Pelaksana', 'Redaktur Desk', 'Kontributor', 'Fotografer', 'Desainer', 'Tim Digital')
    redaksi = (f'<p>Berikut adalah susunan redaksi {e(nama)}:</p>\n'
               + ''.join(f'<p><strong>{p}</strong></p>\n<ul>\n<li>–</li>\n</ul>\n' for p in peran)
               + (f'<p><strong>Alamat Email Redaksi</strong></p>\n<p>{tautan_email(email)}</p>\n' if email else '')
               + '<p>Struktur redaksi ini mencakup berbagai peran dalam manajemen dan produksi konten portal berita, '
                 'mulai dari pemimpin redaksi, redaktur desk, kontributor, fotografer, desainer, hingga tim digital.</p>')
    pedoman = (HERE.parent / 'templates' / 'portal-berita' / 'pedoman-media-siber.html').read_text()
    return [{'judul': 'Redaksi', 'slug': 'redaksi', 'isi': redaksi},
            {'judul': 'Pedoman Media Siber', 'slug': 'pedoman-media-siber', 'isi': pedoman}]


def foto_klien(domain):
    finish = muat('site_finish', HERE / 'site-finish')
    _, foto = finish.client_assets(folder_klien(domain))
    hasil = []
    folder = folder_klien(domain)
    for p in foto:
        try:
            if any(LOGO_KLIEN_RE.search(b) for b in p.relative_to(folder).parts):
                continue  # logo klien/mitra: dipasang di seksi Klien Kami (logo_klien_asli)
        except ValueError:
            pass
        try:
            with Image.open(p) as im:
                w, h = ImageOps.exif_transpose(im).size
        except Exception:
            continue
        # 400 px (bukan 500): foto proyek kiriman WhatsApp yang ditempel di Word umumnya ±470x600
        # (cahayaratupetir.com 2026-09-24: ambang 500 membuang 33 dari 36 foto klien). Banner tetap
        # memakai foto lanskap terbesar karena urutan di bawah.
        if min(w, h) >= 400:
            hasil.append((p, w, h))
    # Lanskap besar dulu untuk banner.
    return sorted(hasil, key=lambda x: (x[1] / x[2] < 1.2, -(x[1] * x[2])))


# Logo klien/mitra kiriman klien: berkas atau folder bernama klien/client/mitra/partner/customer.
LOGO_KLIEN_RE = re.compile(r'klien|client|customer|pelanggan|mitra|partner|rekanan', re.I)
KLIEN_MAKS = 12
KLIEN_CONTOH = 6


def logo_klien_asli(domain):
    """Logo klien/mitra dari folder klien (bukan logo situs sendiri)."""
    folder = folder_klien(domain)
    if not folder.is_dir():
        return []
    hasil = []
    for p in sorted(folder.rglob('*')):
        if not p.is_file() or p.suffix.lower() not in ('.png', '.jpg', '.jpeg', '.webp'):
            continue
        if not any(LOGO_KLIEN_RE.search(b) for b in p.relative_to(folder).parts):
            continue
        try:
            with Image.open(p) as im:
                if min(im.size) < 40:
                    continue
        except Exception:
            continue
        hasil.append(p)
    return hasil[:KLIEN_MAKS]


def kanvas_logo(sumber, tujuan, lebar=360, tinggi=200):
    """Logo dipasang utuh (tidak dipotong) di tengah kanvas putih."""
    im = ImageOps.exif_transpose(Image.open(sumber)).convert('RGBA')
    im.thumbnail((lebar - 60, tinggi - 50), Image.LANCZOS)
    kanvas = Image.new('RGB', (lebar, tinggi), (255, 255, 255))
    kanvas.paste(im, ((lebar - im.width) // 2, (tinggi - im.height) // 2), im)
    kanvas.save(tujuan, quality=88, optimize=True)
    return tujuan


def logo_contoh(nomor, tujuan, lebar=360, tinggi=200):
    """Logo CONTOH abu-abu (bentuk + "Logo Klien N") selama klien belum mengirim logo kliennya;
    seksi Klien Kami tema tidak kosong dan PM tinggal menggantinya (permintaan user 2026-09-29)."""
    from PIL import ImageFont
    def huruf(besar):
        for f in ('/usr/share/fonts/urw-base35/NimbusSans-Bold.otf', '/usr/share/fonts/dejavu-sans-fonts/DejaVuSans-Bold.ttf'):
            try:
                return ImageFont.truetype(f, besar)
            except OSError:
                continue
        return ImageFont.load_default()
    abu, muda = (150, 156, 164), (205, 209, 214)
    im = Image.new('RGB', (lebar, tinggi), (255, 255, 255))
    d = ImageDraw.Draw(im)
    teks, f = f'Logo Klien {nomor}', huruf(30)
    lebar_teks = d.textlength(teks, font=f)
    x0 = int((lebar - (56 + 16 + lebar_teks)) / 2)
    y0, s = tinggi // 2 - 28, 56
    bentuk = nomor % 4
    if bentuk == 1:
        d.ellipse((x0, y0, x0 + s, y0 + s), fill=abu)
        d.ellipse((x0 + 16, y0 + 16, x0 + s - 16, y0 + s - 16), fill=(255, 255, 255))
    elif bentuk == 2:
        d.rounded_rectangle((x0, y0, x0 + s, y0 + s), radius=12, fill=abu)
        d.rectangle((x0 + 14, y0 + 14, x0 + s - 14, y0 + s - 14), fill=muda)
    elif bentuk == 3:
        d.polygon([(x0 + s // 2, y0), (x0 + s, y0 + s), (x0, y0 + s)], fill=abu)
    else:
        d.polygon([(x0 + s // 2, y0), (x0 + s, y0 + s // 2), (x0 + s // 2, y0 + s), (x0, y0 + s // 2)], fill=abu)
        d.ellipse((x0 + 20, y0 + 20, x0 + s - 20, y0 + s - 20), fill=(255, 255, 255))
    d.text((x0 + s + 16, tinggi // 2 - 17), teks, font=f, fill=abu)
    im.save(tujuan, quality=88, optimize=True)
    return tujuan


def foto_contoh(manifest, isi, slot):
    """Foto bank bebas lisensi (CC0/PDM) lewat pemilih paket-g-foto; {kunci: berkas lokal}."""
    if not slot:
        return {}
    try:
        pgf = muat('paket_g_foto', HERE / 'paket-g-foto')
        ai = pgf.muat_ai(manifest)
        pilihan = pgf.pilih_foto(slot, isi, pgf.Openverse(), ai)
    except Exception as e:
        print(f'tampilan: foto_contoh_gagal:{type(e).__name__}')
        return {}
    hasil = {}
    folder = Path(tempfile.mkdtemp(prefix='theme-paket-biasa-foto-'))
    SEMENTARA.append(folder)
    for kunci, (r, _) in pilihan.items():
        berkas = folder / f'{kunci}.img'
        try:
            pgf.unduh(r['url'], berkas)
            hasil[kunci] = berkas
            print(f"tampilan: foto_contoh:{kunci}: {pgf.judul_foto(r)[:60]}")
        except Exception as e:
            print(f'tampilan: foto_contoh_gagal_unduh:{kunci}:{type(e).__name__}')
    return hasil


# ---------- isi ----------

def ikon_sosial():
    return ('<ul class="vk-sosmed">' + ''.join(
        f'<li><a href="{u}" target="_blank" rel="noopener" aria-label="{n}"><i class="bi bi-{i}" aria-hidden="true"></i></a></li>'
        for i, u, n in SOSMED) + '</ul>')


def tautan_email(email):
    # <wbr> sebelum @: kolom sempit (sidebar) memotong di situ, bukan di tengah kata.
    user, _, dom = email.partition('@')
    return f'<a href="mailto:{e(email)}">{e(user)}<wbr>@{e(dom)}</a>'


def tombol_wa(k):
    if not k.get('wa2'):
        return f'<p><a class="btn btn-sm vk-tombol w-100 mt-2" href="https://wa.me/{k["wa"]}" target="_blank" rel="noopener">Chat via WhatsApp</a></p>'
    return ('<p>' + ''.join(f'<a class="btn btn-sm vk-tombol w-100 mt-2" href="https://wa.me/{n}" target="_blank" rel="noopener">Chat WhatsApp Admin {i}</a>'
                            for i, n in enumerate((k['wa'], k['wa2']), 1)) + '</p>')


def daftar_kontak(k, alamat=True):
    baris = []
    if alamat and k['alamat']:
        baris.append(f'<li><i class="bi bi-geo-alt" aria-hidden="true"></i> <span>{e(k["alamat"])}</span></li>')
    if k['telp']:
        digit = re.sub(r'\D', '', k['telp'])
        tel = '+62' + digit[1:] if digit.startswith('0') else '+' + digit
        baris.append(f'<li><i class="bi bi-telephone" aria-hidden="true"></i> <a href="tel:{tel}">{e(k["telp"])}</a></li>')
    if k['wa']:
        baris.append(f'<li><i class="bi bi-whatsapp" aria-hidden="true"></i> <a href="https://wa.me/{k["wa"]}" target="_blank" rel="noopener">WhatsApp {e(k["wa_tampil"])}</a></li>')
    if k.get('wa2'):
        # Klien mengirim 2 nomor: keduanya tampil (user 2026-10-01).
        baris.append(f'<li><i class="bi bi-whatsapp" aria-hidden="true"></i> <a href="https://wa.me/{k["wa2"]}" target="_blank" rel="noopener">WhatsApp {e(k["wa2_tampil"])}</a></li>')
    if k['email']:
        baris.append(f'<li><i class="bi bi-envelope" aria-hidden="true"></i> {tautan_email(k["email"])}</li>')
    return '<ul class="vk-kontak">' + ''.join(baris) + '</ul>' if baris else ''


# Situs yang sudah ter-deploy tetap memakai aturan kartu lama (feedback 2026-09-23); diisi main().
SITUS_LAMA = False


def kartu_beranda(layanan):
    """Kartu layanan di beranda: 4 layanan → 3 kartu saja (satu kartu sisa di baris kedua tampak
    ganjil); 5 = 3 + 2 di tengah, 6 = 3 + 3 lewat CSS. Halaman Layanan & widget tetap memuat semua
    (permintaan user 2026-09-30, lbhdkm.or.id)."""
    return layanan[:3] if len(layanan) == 4 and not SITUS_LAMA else layanan


# Kartu layanan beranda maksimal per tema, apa pun jumlah layanannya (velocity-perusahaan1 mencetak
# semua isi repeater: 5 layanan = 5 kartu; user 2026-10-02, marsealtic.com). Hanya instalasi baru.
LAYANAN_BERANDA_MAKS = {'velocity-perusahaan1': 3}


def susun(domain, cfg, isi, kontak, klien_n=KLIEN_CONTOH):
    nama = cfg.get('site_title') or domain
    layanan = [l for l in isi.get('layanan') or [] if l.get('judul')]
    js = isi.get('judul_seksi') or {}
    halaman_layanan = ''
    if layanan:
        halaman_layanan = (f'<p>{e(js.get("layanan_sub") or "Layanan yang kami sediakan untuk kebutuhan Anda.")}</p>\n'
            + '\n'.join(f'''<section class="vk-layanan" id="{e(l["slug"])}">
<h2>{e(l["judul"])}</h2>
<p>{e(l.get("teks"))}</p>''' + ('<ul>' + ''.join(f'<li>{e(r)}</li>' for r in l.get('rincian') or []) + '</ul>' if l.get('rincian') else '')
                        + '\n</section>' for l in layanan)
            + f'\n<p class="vk-ajakan">Butuh informasi lebih lanjut? <a href="/hubungi-kami/">Hubungi {e(nama)}</a>.</p>')
    blok_kontak = (f'<div class="vk-kartu vk-kontak-utama">\n<h2>Informasi Kontak</h2>\n{daftar_kontak(kontak)}\n{ikon_sosial()}\n</div>')
    tentang = pendek(isi.get('profil') or isi.get('hero_teks'), 170)
    widget = {
        # Tanpa kontak publik widget ini dilewati; dulu terpasang judul "Hubungi Kami" tanpa isi
        # (wisesayasatidar.com, mulawarmantv.com 2026-09-18).
        'konsultasi': ('Hubungi Kami', daftar_kontak(kontak, alamat=False)
                       + (tombol_wa(kontak) if kontak['wa'] else ''))
                      if daftar_kontak(kontak, alamat=False) else None,
        'layanan': (js.get('layanan') or 'Layanan Kami',
                    '<ul>' + ''.join(f'<li><a href="/layanan/#{e(l["slug"])}">{e(l["judul"])}</a></li>' for l in layanan) + '</ul>') if layanan else None,
        'footer_tentang': (nama, f'<p>{e(tentang)}</p>'
                           + (f'<p class="vk-email"><i class="bi bi-envelope" aria-hidden="true"></i> {tautan_email(kontak["email"])}</p>'
                              if kontak['email'] else '')
                           + ikon_sosial()),
        'footer_kontak': ('Kontak', daftar_kontak({**kontak, 'email': ''})) if daftar_kontak({**kontak, 'email': ''}) else None,
        'footer_statistik': ('Statistik Pengunjung', '[velocity-statistics style="list"]'),
    }
    widget = {k: v for k, v in widget.items() if v}
    # Tema tanpa template beranda / tanpa adaptor: kartu layanan + ajakan ditambahkan ke isi halaman Beranda.
    beranda_blok = ''
    if layanan:
        beranda_blok = (f'<h2>{e(js.get("layanan") or "Layanan Kami")}</h2>\n<div class="vk-kartu-grid">'
                        + ''.join(f'<div class="vk-kartu"><h3>{e(l["judul"])}</h3><p>{e(pendek(l.get("teks"), 140))}</p>'
                                  f'<p><a href="/layanan/#{e(l["slug"])}">Selengkapnya</a></p></div>' for l in kartu_beranda(layanan))
                        + '</div>')
    beranda_blok += (f'\n<p class="vk-ajakan">Hubungi {e(nama)} untuk informasi dan pemesanan: '
                     f'<a href="/hubungi-kami/">Hubungi Kami</a>'
                     + (f' atau <a href="https://wa.me/{kontak["wa"]}" target="_blank" rel="noopener">WhatsApp</a>' if kontak['wa'] else '')
                     + '.</p>')
    mods = {
        'velocity-pakete': {
            'banner_image': '{{url:hero}}',
            'banner_title': pendek(isi.get('hero_judul') or nama, 60),
            'banner_desc': pendek(isi.get('hero_teks'), 110),
            'judul_layanan': js.get('layanan') or 'Layanan Kami',
            'services_list': [{'service_title': l['judul'], 'service_desc': pendek(l.get('teks'), 110),
                               'service_text_link': 'Selengkapnya', 'service_link': f'/layanan/#{l["slug"]}'} for l in kartu_beranda(layanan)],
        },
        'velocity-perusahaan2': {
            'home_banner': '{{id:hero}}',
            'subtitle_banner': 'Selamat Datang di',
            'title_banner': e(nama),
            'content_banner': e(pendek(isi.get('hero_teks'), 130)),  # teks rata kanan-kiri renggang di HP bila panjang
            'button1_banner': 'Hubungi Kami', 'link1_banner': '/hubungi-kami/',
            'button2_banner': 'Layanan' if layanan else '', 'link2_banner': '/layanan/' if layanan else '',
            'sambutan': (f'<h2>{e(js.get("tentang") or "Tentang " + nama)}</h2><p>{e(isi.get("profil") or isi.get("hero_teks"))}</p>'
                         + ('<ul class="vk-poin">' + ''.join(f'<li><strong>{e(k["judul"])}</strong> &mdash; {e(k.get("teks"))}</li>'
                                                             for k in (isi.get('keunggulan') or [])[:4]) + '</ul>' if isi.get('keunggulan') else '')),
            'sambutan_image': '{{id:tentang}}',
            'layanan_repeater': [{'layanan_image': '{{id:layanan-%s}}' % l['slug'], 'layanan_title': l['judul'],
                                  'layanan_content': e(pendek(l.get('teks'), 150)), 'layanan_linktext': 'Selengkapnya',
                                  'layanan_link': f'/layanan/#{l["slug"]}'} for l in kartu_beranda(layanan)],
            # Klien Kami tidak dikosongkan: logo klien asli atau logo contoh (user 2026-09-29).
            'title_homelogo': 'Klien Kami',
            'logo_repeater': [{'logo_image': '{{id:klien-%d}}' % i} for i in range(1, klien_n + 1)],
        },
    }
    # Nilai yang disimpan tema sendiri saat diaktifkan: dianggap belum diisi orang.
    bawaan = {
        'velocity-pakete': {'banner_image': '', 'banner_title': '', 'banner_desc': '', 'judul_layanan': 'Layanan Kami',
                            'services_list': []},
        'velocity-perusahaan2': {'home_banner': 0, 'subtitle_banner': 'Selamat Datang di',
                                 'title_banner': 'Perusahaan 2<br>Velocity Developer', 'content_banner': '',
                                 'button1_banner': 'Hubungi Kami', 'link1_banner': '#', 'button2_banner': 'Layanan',
                                 'link2_banner': '#', 'sambutan': '', 'sambutan_image': 0, 'layanan_repeater': [],
                                 'title_homelogo': 'Klien Kami', 'logo_repeater': []},
    }
    return {
        'domain': domain, 'nama': nama, 'bawaan': bawaan, 'beranda_blok': beranda_blok,
        'halaman_layanan': halaman_layanan,
        'blok_kontak': blok_kontak,
        'widget': widget,
        'mods': mods,
        'css': CSS,
        'alamat': kontak['alamat'],
        'alamat_pendek': alamat_pendek(kontak['alamat'], kontak.get('area')),
        'situs_baru': not SITUS_LAMA,
    }


# Banner (.velocity-banner-*) & gambar selebar layar (div.text-center.my-5>img.w-100): velocity-perusahaan1
# menaruh kotak teks banner start-10 + w-100 (meluber ke kanan), judul 6.7vw !important (karena itu
# aturan di bawah juga !important), dan banner kedua setinggi fotonya — dengan
# judul panjang & foto potret klien, subjudul tertimpa kartu layanan dan foto setinggi ±1.366 px
# (cahayaratupetir.com 2026-09-24).
