# Ikon kartu layanan menurut kata di judul/teks layanan (user 2026-10-05, marsealtic.com: semua kartu
# perusahaan1 berikon koper). Nama = Bootstrap Icons 1.11.3; urutan menentukan, yang pertama cocok menang.
IKON_LAYANAN = (
