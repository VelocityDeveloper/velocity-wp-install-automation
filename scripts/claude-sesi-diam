#!/usr/bin/env python3
"""Hentikan sesi Claude yang lama menganggur supaya RAM PC lokal tidak habis.

Dipanggil claude-sesi-diam.timer tiap jam. Setiap jalan mencatat waktu CPU
tiap proses Claude; proses yang CPU-nya naik >= --ambang-cpu detik sejak
pengecekan sebelumnya dianggap aktif. Pada jam --jam-hentikan, proses yang
menganggur >= --batas-jam jam dihentikan (SIGTERM).

Tidak disentuh: bot Telegram (claude-tg, di-restart terpisah) dan job
otomatis `claude -p`, yang selesai sendiri.
"""
import argparse
import json
import os
import signal
import time

STATE = "/var/lib/claude-sesi-diam/state.json"
TICK = os.sysconf("SC_CLK_TCK")


def sesi_claude():
    """Yield (pid, kunci, cpu_detik, ringkas) untuk sesi Claude interaktif/remote."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            with open(f"/proc/{pid}/stat") as f:
                kolom = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue
        if not argv:
            continue
        nama = os.path.basename(argv[0])
        remote = "/.claude/remote/ccd-cli/" in argv[0]
        if not (remote or nama == "claude"):
            continue
        if "-p" in argv or "--print" in argv or any("telegram-session" in a for a in argv):
            continue
        # utime=14, stime=15, starttime=22 (1-based) → indeks 11, 12, 19 setelah ")".
        cpu = (int(kolom[11]) + int(kolom[12])) / TICK
        kunci = f"{pid}:{kolom[19]}"
        yield int(pid), kunci, cpu, ("remote " if remote else "") + " ".join(argv[:3])[:80]


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--batas-jam", type=float, default=6)
    ap.add_argument("--ambang-cpu", type=float, default=30, help="detik CPU per pengecekan agar dianggap aktif")
    ap.add_argument("--jam-hentikan", type=int, default=3)
    ap.add_argument("--hentikan-sekarang", action="store_true")
    ap.add_argument("--uji", action="store_true", help="tampilkan saja, jangan hentikan/simpan")
    a = ap.parse_args()

    try:
        with open(STATE) as f:
            lama = json.load(f)
    except (OSError, ValueError):
        lama = {}

    sekarang = time.time()
    hentikan = a.hentikan_sekarang or time.localtime().tm_hour == a.jam_hentikan
    baru = {}
    for pid, kunci, cpu, ringkas in sesi_claude():
        s = lama.get(kunci)
        if s is None or cpu - s["cpu"] >= a.ambang_cpu:
            s = {"cpu": cpu, "sejak": sekarang}
        else:
            s = {"cpu": cpu, "sejak": s["sejak"]}
        diam = (sekarang - s["sejak"]) / 3600
        if hentikan and diam >= a.batas_jam:
            print(f"hentikan pid={pid} diam={diam:.1f}j {ringkas}")
            if not a.uji:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                continue
        elif a.uji:
            print(f"pid={pid} diam={diam:.1f}j cpu={cpu:.0f}s {ringkas}")
        baru[kunci] = s

    if not a.uji:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump(baru, f)
        os.replace(STATE + ".tmp", STATE)


if __name__ == "__main__":
    main()
