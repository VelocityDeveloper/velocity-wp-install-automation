#!/usr/bin/env python3
"""Hentikan sesi Claude yang lama menganggur supaya RAM PC lokal tidak habis.

Dipanggil claude-sesi-diam.timer tiap 15 menit. Sesi remote (ccd-cli
--resume=<id>) dinilai dari timestamp terakhir di transkrip
~/.claude/projects/*/<id>.jsonl — tetap benar walau PC reboot dan aplikasi
membuka ulang semua sesi. Sesi tanpa transkrip (claude CLI) memakai waktu CPU:
naik >= --ambang-cpu detik sejak pengecekan sebelumnya = aktif.
Sesi yang menganggur >= --batas-jam jam dihentikan (SIGTERM). --jam-hentikan
membatasi penghentian ke satu jam tertentu (default: setiap jalan).

Tidak disentuh: bot Telegram (claude-tg, di-restart terpisah), job
otomatis `claude -p` yang selesai sendiri, dan proses di KECUALI
(--kecualikan PID; dilepas --lepas-induk dari hook SessionStart "clear").
"""
import argparse
import glob
import json
import os
import signal
import time
from datetime import datetime

STATE = "/var/lib/claude-sesi-diam/state.json"
KECUALI = "/var/lib/claude-sesi-diam/kecuali.json"  # {"pid:starttime": catatan}
TICK = os.sysconf("SC_CLK_TCK")
with open("/proc/stat") as _f:
    BOOT = next(int(b.split()[1]) for b in _f if b.startswith("btime"))


def aktivitas_transkrip(argv):
    """Epoch timestamp terakhir di transkrip sesi remote, atau None."""
    sid = next((x.split("=", 1)[1] for x in argv if x.startswith("--resume=")), None)
    if not sid:
        return None
    berkas = glob.glob(f"/root/.claude/projects/*/{sid}.jsonl")
    if not berkas:
        return None
    try:
        with open(berkas[0], "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 262144))
            ekor = f.read().decode(errors="replace").splitlines()
    except OSError:
        return None
    terakhir = None
    for baris in ekor:
        try:
            ts = json.loads(baris).get("timestamp")
            t = datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError, TypeError):
            continue
        terakhir = t if terakhir is None else max(terakhir, t)
    return terakhir


def sesi_claude():
    """Yield (pid, kunci, cpu_detik, ringkas) untuk sesi Claude interaktif/remote."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            with open(f"/proc/{pid}/stat") as f:
                kolom = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue
        if not argv:
            continue
        nama = os.path.basename(argv[0])
        remote = "/.claude/remote/ccd-cli/" in argv[0]
        if not (remote or nama == "claude"):
            continue
        if "-p" in argv or "--print" in argv or any("telegram-session" in a for a in argv):
            continue
        # utime=14, stime=15, starttime=22 (1-based) → indeks 11, 12, 19 setelah ")".
        cpu = (int(kolom[11]) + int(kolom[12])) / TICK
        kunci = f"{pid}:{kolom[19]}"
        transkrip = aktivitas_transkrip(argv) if remote else None
        if transkrip is not None:
            # Sesi yang baru dibuka di aplikasi dihitung aktif sejak dibuka,
            # kecuali yang dibuka ulang otomatis saat PC menyala.
            mulai = BOOT + int(kolom[19]) / TICK
            if mulai - BOOT > 900:
                transkrip = max(transkrip, mulai)
        yield int(pid), kunci, cpu, transkrip, ("remote " if remote else "") + " ".join(argv[:3])[:80]


def kunci_pid(pid):
    with open(f"/proc/{pid}/stat") as f:
        return f"{pid}:{f.read().rsplit(')', 1)[1].split()[19]}"


def ubah_kecuali(fn):
    try:
        with open(KECUALI) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    fn(data)
    os.makedirs(os.path.dirname(KECUALI), exist_ok=True)
    with open(KECUALI + ".tmp", "w") as f:
        json.dump(data, f)
    os.replace(KECUALI + ".tmp", KECUALI)
    return data


def leluhur_claude():
    """PID proses `claude` terdekat di atas proses ini (hook dijalankan oleh sesi itu)."""
    pid = os.getppid()
    while pid > 1:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")
            with open(f"/proc/{pid}/stat") as f:
                induk = int(f.read().rsplit(")", 1)[1].split()[1])
        except OSError:
            return None
        if os.path.basename(argv[0]) == "claude" or "/.claude/remote/ccd-cli/" in argv[0]:
            return pid
        pid = induk
    return None


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--batas-jam", type=float, default=6)
    ap.add_argument("--ambang-cpu", type=float, default=30, help="detik CPU per pengecekan agar dianggap aktif")
    ap.add_argument("--jam-hentikan", type=int, default=None, help="hanya hentikan pada jam ini (default: setiap jalan)")
    ap.add_argument("--hentikan-sekarang", action="store_true")
    ap.add_argument("--uji", action="store_true", help="tampilkan saja, jangan hentikan/simpan")
    ap.add_argument("--kecualikan", type=int, metavar="PID", help="jangan hentikan proses sesi ini")
    ap.add_argument("--lepas-induk", action="store_true", help="dari hook: lepas pengecualian sesi pemanggil")
    a = ap.parse_args()
    if a.kecualikan:
        k = kunci_pid(a.kecualikan)
        print(ubah_kecuali(lambda d: d.__setitem__(k, time.strftime("%Y-%m-%d %H:%M"))))
        return
    if a.lepas_induk:
        pid = leluhur_claude()
        if pid:
            k = kunci_pid(pid)
            ubah_kecuali(lambda d: d.pop(k, None))
        return
    try:
        with open(KECUALI) as f:
            kecuali = json.load(f)
    except (OSError, ValueError):
        kecuali = {}

    try:
        with open(STATE) as f:
            lama = json.load(f)
    except (OSError, ValueError):
        lama = {}

    sekarang = time.time()
    hentikan = a.hentikan_sekarang or a.jam_hentikan is None or time.localtime().tm_hour == a.jam_hentikan
    baru = {}
    for pid, kunci, cpu, transkrip, ringkas in sesi_claude():
        if kunci in kecuali:
            if a.uji:
                print(f"pid={pid} dikecualikan sejak {kecuali[kunci]} {ringkas}")
            continue
        s = lama.get(kunci)
        if s is None or cpu - s["cpu"] >= a.ambang_cpu:
            s = {"cpu": cpu, "sejak": sekarang}
        else:
            s = {"cpu": cpu, "sejak": s["sejak"]}
        if transkrip is not None:
            s["sejak"] = transkrip
        diam = (sekarang - s["sejak"]) / 3600
        if hentikan and diam >= a.batas_jam:
            print(f"hentikan pid={pid} diam={diam:.1f}j {ringkas}")
            if not a.uji:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                continue
        elif a.uji:
            print(f"pid={pid} diam={diam:.1f}j cpu={cpu:.0f}s {ringkas}")
        baru[kunci] = s

    if not a.uji:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump(baru, f)
        os.replace(STATE + ".tmp", STATE)


if __name__ == "__main__":
    main()
