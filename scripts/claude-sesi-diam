#!/usr/bin/env python3
"""Hentikan sesi Claude yang lama menganggur supaya RAM PC lokal tidak habis.

Dipanggil claude-sesi-diam.timer tiap 15 menit. Sesi (remote & CLI) dinilai
dari ~/.claude/sessions/<pid>.json (status busy = aktif; sessionId) dan
timestamp terakhir di transkrip
~/.claude/projects/*/<id>.jsonl — tetap benar walau PC reboot dan aplikasi
membuka ulang semua sesi. Sesi tanpa keduanya memakai waktu CPU:
naik >= --ambang-cpu detik sejak pengecekan sebelumnya = aktif.
Sesi yang menganggur >= --batas-jam jam dihentikan (SIGTERM). --jam-hentikan
membatasi penghentian ke satu jam tertentu (default: setiap jalan).

Sesi bot Telegram (claude-tg@<id>) yang diam >= --batas-jam-telegram jam
di-stop lewat systemd; router menyalakannya lagi saat ada pesan masuk.

Tidak disentuh: job
otomatis `claude -p` yang selesai sendiri, dan proses di KECUALI
(--kecualikan PID; dilepas --lepas-induk dari hook SessionStart "clear").
"""
import argparse
import glob
import json
import os
import signal
import subprocess
import time
import urllib.parse
import urllib.request
from datetime import datetime

STATE = "/var/lib/claude-sesi-diam/state.json"
KECUALI = "/var/lib/claude-sesi-diam/kecuali.json"  # {"pid:starttime": catatan}
TICK = os.sysconf("SC_CLK_TCK")
with open("/proc/stat") as _f:
    BOOT = next(int(b.split()[1]) for b in _f if b.startswith("btime"))


def info_sesi(pid, starttime):
    """Isi ~/.claude/sessions/<pid>.json (sessionId, status) bila milik proses ini."""
    try:
        with open(f"/root/.claude/sessions/{pid}.json") as f:
            d = json.load(f)
    except (OSError, ValueError):
        return {}
    return d if str(d.get("procStart")) == starttime else {}


def aktivitas_transkrip(argv, info):
    """Epoch aktivitas terakhir (transkrip / status sesi), atau None."""
    if info.get("status") == "busy":
        return time.time()
    # statusUpdatedAt berubah tiap giliran mulai/selesai, juga sebelum transkrip ada.
    terakhir = max(info.get(k, 0) / 1000 for k in ("updatedAt", "statusUpdatedAt")) or None
    sid = info.get("sessionId") or next((x.split("=", 1)[1] for x in argv if x.startswith("--resume=")), None)
    berkas = glob.glob(f"/root/.claude/projects/*/{sid}.jsonl") if sid else []
    if not berkas:
        return terakhir
    try:
        with open(berkas[0], "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 262144))
            ekor = f.read().decode(errors="replace").splitlines()
    except OSError:
        return terakhir
    for baris in ekor:
        try:
            ts = json.loads(baris).get("timestamp")
            t = datetime.fromisoformat(ts.replace("Z", "+00:00")).timestamp()
        except (ValueError, AttributeError, TypeError):
            continue
        terakhir = t if terakhir is None else max(terakhir, t)
    return terakhir


def sesi_claude():
    """Yield (pid, kunci, cpu_detik, ringkas) untuk sesi Claude interaktif/remote."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            with open(f"/proc/{pid}/stat") as f:
                kolom = f.read().rsplit(")", 1)[1].split()
        except OSError:
            continue
        if not argv:
            continue
        nama = os.path.basename(argv[0])
        remote = "/.claude/remote/ccd-cli/" in argv[0]
        if not (remote or nama == "claude"):
            continue
        if "-p" in argv or "--print" in argv or any("telegram-session" in a for a in argv):
            continue
        # utime=14, stime=15, starttime=22 (1-based) → indeks 11, 12, 19 setelah ")".
        cpu = (int(kolom[11]) + int(kolom[12])) / TICK
        kunci = f"{pid}:{kolom[19]}"
        transkrip = aktivitas_transkrip(argv, info_sesi(pid, kolom[19]))
        if transkrip is not None:
            # Sesi yang baru dibuka di aplikasi dihitung aktif sejak dibuka,
            # kecuali yang dibuka ulang otomatis saat PC menyala.
            mulai = BOOT + int(kolom[19]) / TICK
            if mulai - BOOT > 900:
                transkrip = max(transkrip, mulai)
        yield int(pid), kunci, cpu, transkrip, ("remote " if remote else "") + " ".join(argv[:3])[:80]


def kunci_pid(pid):
    with open(f"/proc/{pid}/stat") as f:
        return f"{pid}:{f.read().rsplit(')', 1)[1].split()[19]}"


def ubah_kecuali(fn):
    try:
        with open(KECUALI) as f:
            data = json.load(f)
    except (OSError, ValueError):
        data = {}
    fn(data)
    os.makedirs(os.path.dirname(KECUALI), exist_ok=True)
    with open(KECUALI + ".tmp", "w") as f:
        json.dump(data, f)
    os.replace(KECUALI + ".tmp", KECUALI)
    return data


def leluhur_claude():
    """PID proses `claude` terdekat di atas proses ini (hook dijalankan oleh sesi itu)."""
    pid = os.getppid()
    while pid > 1:
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")
            with open(f"/proc/{pid}/stat") as f:
                induk = int(f.read().rsplit(")", 1)[1].split()[1])
        except OSError:
            return None
        if os.path.basename(argv[0]) == "claude" or "/.claude/remote/ccd-cli/" in argv[0]:
            return pid
        pid = induk
    return None


TG_ENV = "/root/.claude/channels/telegram/.env"
PESAN_TG = ("💤 Sesi Claude kamu dimatikan karena diam lebih dari {jam} jam, supaya RAM PC kantor tidak habis.\n"
            "Kirim pesan apa saja untuk menyalakannya lagi — percakapan terakhir dilanjutkan otomatis "
            "(balasan pertama butuh ±30 detik).")


def kabari_telegram(uid, jam):
    """Kirim pemberitahuan sesi dimatikan ke user Telegram; galat hanya dicetak."""
    try:
        with open(TG_ENV) as f:
            token = next(b.split("=", 1)[1].strip() for b in f if b.startswith("TELEGRAM_BOT_TOKEN="))
        data = urllib.parse.urlencode({"chat_id": uid, "text": PESAN_TG.format(jam=f"{jam:g}")}).encode()
        urllib.request.urlopen(f"https://api.telegram.org/bot{token}/sendMessage", data, timeout=15).read()
    except Exception as e:
        print(f"kabari telegram {uid} gagal: {e}")


def hentikan_telegram(batas_jam, uji):
    """Stop unit claude-tg@<id> yang diam >= batas_jam; router menyalakannya lagi saat ada pesan.

    Lewat systemctl stop, bukan SIGTERM: unit memakai Restart=always.
    """
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().decode(errors="replace").split("\0")[:-1]
            if not argv or os.path.basename(argv[0]) != "claude" or not any("telegram-session" in x for x in argv):
                continue
            with open(f"/proc/{pid}/stat") as f:
                starttime = f.read().rsplit(")", 1)[1].split()[19]
            with open(f"/proc/{pid}/environ", "rb") as f:
                env = dict(x.split("=", 1) for x in f.read().decode(errors="replace").split("\0") if "=" in x)
        except OSError:
            continue
        state = env.get("TELEGRAM_STATE_DIR", "")
        uid = os.path.basename(state)
        if not uid.isdigit():
            continue
        try:
            if os.listdir(os.path.join(state, "spool")):
                continue  # ada pesan yang belum diambil
        except OSError:
            pass
        mulai = BOOT + int(starttime) / TICK
        # Dinyalakan saat boot (bukan karena chat) → nilai dari chat terakhir saja.
        info = {k: v for k, v in info_sesi(pid, starttime).items() if k in ("status", "sessionId")}
        terakhir = aktivitas_transkrip(argv, info) or 0
        if mulai - BOOT > 900:
            terakhir = max(terakhir, mulai)
        diam = (time.time() - terakhir) / 3600
        if diam < batas_jam:
            if uji:
                print(f"telegram {uid} pid={pid} diam={diam:.1f}j")
            continue
        print(f"hentikan telegram {uid} pid={pid} diam={diam:.1f}j")
        if not uji:
            subprocess.run(["systemctl", "--user", "stop", f"claude-tg@{uid}.service"],
                           env={**os.environ, "XDG_RUNTIME_DIR": "/run/user/0"}, check=False)
            kabari_telegram(uid, batas_jam)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--batas-jam", type=float, default=6)
    ap.add_argument("--batas-jam-telegram", type=float, default=2)
    ap.add_argument("--ambang-cpu", type=float, default=30, help="detik CPU per pengecekan agar dianggap aktif")
    ap.add_argument("--jam-hentikan", type=int, default=None, help="hanya hentikan pada jam ini (default: setiap jalan)")
    ap.add_argument("--hentikan-sekarang", action="store_true")
    ap.add_argument("--uji", action="store_true", help="tampilkan saja, jangan hentikan/simpan")
    ap.add_argument("--kecualikan", type=int, metavar="PID", help="jangan hentikan proses sesi ini")
    ap.add_argument("--lepas-induk", action="store_true", help="dari hook: lepas pengecualian sesi pemanggil")
    ap.add_argument("--kabari-telegram", metavar="ID", nargs="+", help="kirim pemberitahuan sesi dimatikan saja")
    a = ap.parse_args()
    if a.kabari_telegram:
        for uid in a.kabari_telegram:
            kabari_telegram(uid, a.batas_jam_telegram)
        return
    if a.kecualikan:
        k = kunci_pid(a.kecualikan)
        print(ubah_kecuali(lambda d: d.__setitem__(k, time.strftime("%Y-%m-%d %H:%M"))))
        return
    if a.lepas_induk:
        pid = leluhur_claude()
        if pid:
            k = kunci_pid(pid)
            ubah_kecuali(lambda d: d.pop(k, None))
        return
    try:
        with open(KECUALI) as f:
            kecuali = json.load(f)
    except (OSError, ValueError):
        kecuali = {}

    try:
        with open(STATE) as f:
            lama = json.load(f)
    except (OSError, ValueError):
        lama = {}

    sekarang = time.time()
    hentikan = a.hentikan_sekarang or a.jam_hentikan is None or time.localtime().tm_hour == a.jam_hentikan
    baru = {}
    for pid, kunci, cpu, transkrip, ringkas in sesi_claude():
        if kunci in kecuali:
            if a.uji:
                print(f"pid={pid} dikecualikan sejak {kecuali[kunci]} {ringkas}")
            continue
        s = lama.get(kunci)
        if s is None or cpu - s["cpu"] >= a.ambang_cpu:
            s = {"cpu": cpu, "sejak": sekarang}
        else:
            s = {"cpu": cpu, "sejak": s["sejak"]}
        if transkrip is not None:
            s["sejak"] = transkrip
        diam = (sekarang - s["sejak"]) / 3600
        if hentikan and diam >= a.batas_jam:
            print(f"hentikan pid={pid} diam={diam:.1f}j {ringkas}")
            if not a.uji:
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                continue
        elif a.uji:
            print(f"pid={pid} diam={diam:.1f}j cpu={cpu:.0f}s {ringkas}")
        baru[kunci] = s

    if hentikan:
        hentikan_telegram(a.batas_jam_telegram, a.uji)

    if not a.uji:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f:
            json.dump(baru, f)
        os.replace(STATE + ".tmp", STATE)


if __name__ == "__main__":
    main()
