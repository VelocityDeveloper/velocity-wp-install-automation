HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import laravel_proyek as L  # noqa: E402

TUGAS = HERE.parent / 'templates' / 'laravel' / 'agen-fitur.md'
# Batas waktu satu sesi agen = jam_agen x3, dijepit 30–90 menit. Data nyata (audit 1 Okt, 26 fitur): median 8,5 menit,
# 90% fitur <= 19 menit, terlama 52 menit (6 sesi ulang) — dulu 150 menit hanya memperlambat deteksi agen macet.
MENIT_MIN, MENIT_MAKS = 30, 90
# Jam mesin Local PC (nyala 07.00–22.00): fitur harus selesai sebelum BATAS_MULAI, agen dipotong di BATAS_KERAS
BATAS_MULAI = (21, 45)
BATAS_KERAS = (21, 55)
PERKIRAAN_BAWAAN = 20  # menit per fitur bila belum ada data aktual sama sekali (lihat L.kalibrasi_agen)
KUOTA_RE = re.compile(r'usage limit|limit reached|rate.?limit|overloaded|\b429\b', re.I)
SKEMA = {
    'type': 'object', 'required': ['ringkasan', 'kriteria', 'cara_cek', 'catatan_webmaster', 'berkas'],
    'properties': {
        'ringkasan': {'type': 'string'},
        'kriteria': {'type': 'array', 'items': {
