                           'bukti': {'type': 'string'}}}},
        'cara_cek': {'type': 'array', 'items': {'type': 'string'}},
        'catatan_webmaster': {'type': 'string'},
        'berkas': {'type': 'array', 'items': {'type': 'string'}},
    },
}


def muat(nama, path):
    loader = importlib.machinery.SourceFileLoader(nama, str(path))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def ip_lan():
    """IP LAN saat ini (rute default), hanya untuk teks log; cek kesehatan tetap lewat 127.0.0.1."""
    try:
        r = subprocess.run(['ip', '-4', 'route', 'get', '1.1.1.1'], capture_output=True, text=True, timeout=5)
        m = re.search(r'\bsrc (\S+)', r.stdout)
        return m.group(1) if m else '127.0.0.1'
    except (OSError, subprocess.SubprocessError):
        return '127.0.0.1'


def log(pesan):
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {pesan}", flush=True)


def sh(perintah, cwd, timeout=900, env=None):
    """-> (kode, keluaran gabungan). Tidak melempar galat."""
    try:
        r = subprocess.run(perintah, cwd=cwd, shell=isinstance(perintah, str), capture_output=True, text=True,
                           timeout=timeout, env=env)
        return r.returncode, L.bersih_terminal(r.stdout + r.stderr).strip()
    except subprocess.TimeoutExpired:
        return 124, f'timeout {timeout} dtk'
    except OSError as e:
        return 127, str(e)


def ekor(teks, n=40):
    return '\n'.join(teks.splitlines()[-n:])


LOCK_BASI_MENIT = 10  # operasi index git normal selesai dalam detik; lock setua ini pasti tertinggal


def pemegang_git(app_dir):
    """PID yang mungkin sedang memakai repo: proses git ber-cwd di app_dir, atau proses apa pun yang membuka
    berkas di app_dir/.git. Proses ber-cwd app_dir lain (artisan serve, queue:work) tidak dihitung."""
    akar = os.path.realpath(app_dir)
    dot_git = os.path.join(akar, '.git')
    hasil = []
    for pid in os.listdir('/proc'):
        if not pid.isdigit() or int(pid) == os.getpid():
            continue
        try:
            cwd = os.path.realpath(f'/proc/{pid}/cwd')
            nama = Path(f'/proc/{pid}/comm').read_text().strip()
            if nama.startswith('git') and (cwd == akar or cwd.startswith(akar + '/')):
                hasil.append(f'{pid}:{nama}')
                continue
            for fd in os.listdir(f'/proc/{pid}/fd'):
                tujuan = os.readlink(f'/proc/{pid}/fd/{fd}')
                if tujuan == dot_git or tujuan.startswith(dot_git + '/'):
                    hasil.append(f'{pid}:{nama}')
                    break
        except OSError:
            continue  # proses sudah selesai / tidak bisa dibaca
    return hasil


def lepas_lock_basi(app_dir):
    """.git/index.lock tertinggal (git mati di tengah jalan: mesin mati, restart layanan) membuat setiap
    `git add/commit` gagal berulang dan agen tidak bisa menghapusnya (project-017 F05, 2026-10-07).
    Hanya dipindah (bukan dihapus) bila lock sudah >= LOCK_BASI_MENIT dan tak ada proses yang memakai repo."""
    lock = Path(app_dir) / '.git' / 'index.lock'
    try:
        umur = (time.time() - lock.stat().st_mtime) / 60
    except FileNotFoundError:
        return
    if umur < LOCK_BASI_MENIT:
        log(f'index.lock ada ({umur:.1f} menit) — terlalu baru untuk dianggap basi, dibiarkan.')
        return
    pemakai = pemegang_git(app_dir)
    if pemakai:
        log(f'index.lock ada ({umur:.0f} menit) tetapi repo masih dipakai {", ".join(pemakai)} — dibiarkan.')
        return
    tujuan = lock.with_name(f"index.lock.basi-{datetime.now().strftime('%Y%m%d-%H%M%S')}")
    try:
        lock.rename(tujuan)
        log(f'index.lock basi ({umur:.0f} menit, tanpa proses pemakai) dipindah ke {tujuan.name}.')
    except FileNotFoundError:
        pass  # sudah dilepas pemiliknya


def ringkas_langkah(blok):
    if blok.get('type') == 'text':
        teks = ' '.join(str(blok.get('text') or '').split())
        return f'agen › {teks[:240]}' if teks else None
    if blok.get('type') != 'tool_use':
        return None
    alat, masuk = blok.get('name', ''), blok.get('input') or {}
    berkas = str(masuk.get('file_path') or '')
    if alat == 'Read':
        return f'agen › membaca {berkas}'
    if alat in ('Write', 'Edit', 'MultiEdit'):
        return f'agen › menulis {berkas}'
    if alat == 'Bash':
        return f"agen › $ {' '.join(str(masuk.get('command') or '').split())[:200]}"
    if alat in ('Glob', 'Grep'):
        return f"agen › mencari {masuk.get('pattern', '')}"
    return f'agen › {alat}'


def menit_sampai(jam_menit):
    kini = datetime.now()
    batas = kini.replace(hour=jam_menit[0], minute=jam_menit[1], second=0, microsecond=0)
    return (batas - kini).total_seconds() / 60


def perkiraan_menit(fitur):
    """Perkiraan lama satu fitur dari data aktual project ini (rata-rata x1,2); project baru memakai median semua
    project x1,5 (L.kalibrasi_agen), bawaan 20 menit."""
    aktual = [float(x['hasil']['menit']) for x in fitur
              if x.get('status') in ('dites', 'ok') and (x.get('hasil') or {}).get('menit')]
    if aktual:
        return max(15, sum(aktual) / len(aktual) * 1.2)
    k = L.kalibrasi_agen()
    return max(15, k['menit_median'] * 1.5) if k else PERKIRAAN_BAWAAN


def bagian_md(teks, tingkat):
    """Pecah Markdown per judul tingkat tertentu -> [(judul, isi lengkap termasuk baris judul)]; [('', pembuka)] di depan."""
    tanda, hasil, judul, isi = '#' * tingkat + ' ', [], '', []
    for baris in teks.splitlines():
        if baris.startswith(tanda):
            hasil.append((judul, '\n'.join(isi)))
            judul, isi = baris[len(tanda):].strip(), [baris]
        else:
            isi.append(baris)
    hasil.append((judul, '\n'.join(isi)))
    return hasil


def kata(teks):
    return {k for k in re.findall(r'[a-z0-9_]{4,}', teks.lower())}


def cocok(bagian, kf, maks):
    """Bagian yang judulnya paling bersinggungan dengan kata fitur: minimal 2 kata sama (atau semua kata judul bila
    judulnya pendek) dan ≥ 50% kata judul; ambil `maks` skor tertinggi."""
    nilai = []
    for j, isi in bagian:
        kj = kata(j) - {'fase', 'admin', 'halaman', 'data', 'fitur'}
        sama = len(kj & kf)
        if kj and sama >= min(2, len(kj)) and sama * 2 >= len(kj):
            nilai.append((sama / len(kj) + sama * 0.1, j, isi))
    return [(j, isi) for _, j, isi in sorted(nilai, key=lambda x: -x[0])[:maks]]


def bahan_dokumen(app_dir, fitur, f):
    """Potongan PRD/DESIGN/DATABASE/FLOWCHART yang relevan untuk satu fitur, supaya agen tidak membaca dokumen utuh
    di tiap sesi (konteks per giliran ±100 rb token, 3 Okt). Fondasi tetap dapat DESIGN lengkap."""
    baca = lambda nama: (app_dir / nama).read_text(errors='ignore') if (app_dir / nama).is_file() else ''
    prd, design, db, alur = baca('docs/PRD.md'), baca('DESIGN.md'), baca('docs/DATABASE.md'), baca('docs/FLOWCHART.md')
    if not (prd or design or db):
        return ''
    teks_fitur = ' '.join([f['judul'], f.get('deskripsi') or ''] + [k['teks'] for k in f['kriteria']]
                          + [h['halaman'] for h in f.get('halaman') or []])
    kf = kata(teks_fitur)
    fondasi = fitur and fitur[0]['id'] == f['id'] or 'fondasi' in f['judul'].lower()
    out = []
    # PRD: pembuka (ringkasan) + Peran pengguna; fitur PRD dipilih yang judulnya bersinggungan dengan fitur ini
    if prd:
        b2 = bagian_md(prd, 2)
        pilih = [b2[0][1].strip()] + [isi.strip() for j, isi in b2[1:] if j.lower().startswith('peran pengguna')]
        for j, isi in b2[1:]:
            if j.lower().startswith('fitur'):
                pilih += [i.strip() for _, i in cocok(bagian_md(isi, 3)[1:], kf, 3)]
        out.append('### docs/PRD.md (potongan)\n\n' + '\n\n'.join(x for x in pilih if x))
    # DESIGN: Fondasi lengkap; fitur lain cukup token (front matter) + Do's and Don'ts
    if design:
        if fondasi:
            out.append('### DESIGN.md (lengkap, fitur Fondasi)\n\n' + design.strip())
        else:
            # Token sudah diterapkan ke tema oleh Fondasi: cukup aturan Do's & Don'ts, ikuti komponen/kelas yang ada
            dd = [isi.strip() for j, isi in bagian_md(design, 2)[1:] if j.lower().startswith('do')]
            out.append('### DESIGN.md (aturan; token warna/font/radius sudah diterapkan di tema oleh Fondasi — pakai '
                       'kelas & komponen yang ada, Grep DESIGN.md bila butuh nilai token)\n\n' + '\n\n'.join(dd))
    # DATABASE: daftar semua tabel + rincian tabel yang disebut fitur ini + aturan integritas
    if db:
        tabel = [(j, isi) for jj, blok in bagian_md(db, 2)[1:] if jj.lower().startswith('tabel')
                 for j, isi in bagian_md(blok, 3)[1:]]
        nama = [j.strip('` ').split()[0] for j, _ in tabel if j.strip('` ')]
        dipakai = [isi.strip() for (j, isi), n in zip(tabel, nama) if n.lower() in kf or n.rstrip('s').lower() in kf
                   or any(n.lower() in k for k in kf)]
        aturan = [isi.strip() for j, isi in bagian_md(db, 2)[1:] if j.lower().startswith('aturan')]
        if not tabel and len(db) <= 15000:  # format bebas tanpa ### per tabel: kecil -> sertakan utuh
            dipakai, aturan, nama = [db.strip()], [], []
        out.append('### docs/DATABASE.md (potongan)\n\nSemua tabel: ' + ', '.join(f'`{n}`' for n in nama)
                   + '\n\n' + ('\n\n'.join(dipakai) if dipakai else '(tidak ada tabel yang disebut langsung oleh fitur ini; '
                                 'Grep DATABASE.md untuk tabel yang dibutuhkan)') + ('\n\n' + '\n\n'.join(aturan) if aturan else ''))
    # FLOWCHART: hanya proses yang judulnya bersinggungan dengan fitur ini
    if alur:
        pilih = [isi.strip() for _, isi in cocok([(j, i) for j, i in bagian_md(alur, 2)[1:]
                                                 if not j.lower().startswith('alur umum')], kf, 2)]
        if pilih:
            out.append('### docs/FLOWCHART.md (potongan)\n\n' + '\n\n'.join(pilih))
    return '## Bahan dokumen (potongan relevan)\n\n' + '\n\n'.join(out) + '\n'


# Contoh tampilan untuk klien (proyek/<id>/contoh, dibuat di tahap Brief) = acuan visual agen (permintaan user 5 Okt:
# beranda project-003 dibangun tanpa melihat contoh). Kata kunci teks fitur → halaman contoh yang disertakan.
CONTOH_KATA = {'index.html': ('beranda', 'landing', 'halaman depan', 'halaman publik', 'homepage', 'welcome'),
               'dashboard.html': ('dashboard',)}


def halaman_contoh(p, fitur, f):
    """Halaman contoh tampilan (index.html/dashboard.html) yang jadi acuan fitur ini, [] bila tak ada."""
    slug = p.get('slug')
    src = L.folder_contoh(slug) if slug else None
    if not src or not (src / 'index.html').is_file():
        return []
    info = L.baca_json(L.folder(slug) / 'contoh.json', {}) or {}
    if info.get('platform', 'laravel') != 'laravel':
        return []
    teks = ' '.join([f['judul'], f.get('deskripsi') or ''] + [k['teks'] for k in f['kriteria']]
                    + [h['halaman'] for h in f.get('halaman') or []]).lower()
    fondasi = fitur and fitur[0]['id'] == f['id'] or 'fondasi' in f['judul'].lower()
    return [n for n, kk in CONTOH_KATA.items() if (src / n).is_file() and (fondasi or any(k in teks for k in kk))]


def bahan_contoh(p, app_dir, fitur, f):
    """Salin contoh tampilan terbaru ke docs/contoh/ (tidak di-commit) dan beri tahu agen halaman mana yang jadi acuan;
    beri peringatan bila brief berubah sesudah contoh dibuat."""
    halaman = halaman_contoh(p, fitur, f)
    if not halaman:
        return ''
    slug = p['slug']
    src = L.folder_contoh(slug)
    info = L.baca_json(L.folder(slug) / 'contoh.json', {}) or {}
    tujuan = app_dir / 'docs' / 'contoh'
    shutil.rmtree(tujuan, ignore_errors=True)
    shutil.copytree(src, tujuan)
    if L.folder_referensi(slug).is_dir():
        shutil.copytree(L.folder_referensi(slug), tujuan / 'referensi')
    exclude = app_dir / '.git' / 'info' / 'exclude'
    if exclude.parent.is_dir() and '/docs/contoh/' not in (exclude.read_text() if exclude.is_file() else ''):
        with exclude.open('a') as fh:
            fh.write('\n/docs/contoh/\n')
    usang = L.info_versi_brief(slug, p)['keluaran'].get('contoh', {}).get('usang') or []
    waktu = datetime.fromtimestamp(info['waktu']).strftime('%d %b %H:%M') if info.get('waktu') else '?'
    log(f"contoh tampilan disertakan: {', '.join(halaman)} (brief v{info.get('brief_versi', '?')}"
        + (f", usang: {', '.join(usang)})" if usang else ')'))
    t = ('### Contoh tampilan untuk klien (acuan visual — WAJIB diikuti)\n\n'
         f"Mockup yang sudah dipamerkan ke klien (dibuat {waktu}, brief v{info.get('brief_versi', '?')}), disalin ke "
         '`docs/contoh/` (tidak di-commit). Read berkas berikut sebelum membuat tampilannya:\n'
         + '\n'.join(f"- `docs/contoh/{n}` — {L.CONTOH_HALAMAN.get(n, n)}" for n in halaman) + '\n\n'
         'Tiru susunan seksi, urutan, komposisi hero/kolom, hierarki teks, jarak, dan gaya komponennya ke Vue memakai '
         'komponen & token tema yang ada (jangan menyalin CSS mentah). Warna/font/radius tetap mengikuti token DESIGN.md '
         'yang berlaku; teks & angka di mockup hanya ilustrasi (ambil dari data/terjemahan aplikasi); pita '
         '"Pratinjau desain" jangan ditiru. Gambar di `docs/contoh/aset/` boleh dipakai bila dibutuhkan.\n')
    if usang:
        t += (f"\n⚠ Contoh ini dibuat SEBELUM perubahan brief berikut: {', '.join(usang)}. Bila bertentangan (warna, "
              'menu, isi seksi), ikuti Bahan dokumen di atas; sisanya tetap ikuti susunan contoh.\n')
    # 15 Okt (user): referensi klien = acuan UTAMA, contoh Claude hanya pelengkap (kadang kurang tepat meniru)
    peta = [x for x in (info.get('referensi') or {}).get('peta') or [] if x.get('halaman') in halaman]
    if peta:
        K = muat('laravel_kemiripan', HERE / 'laravel-kemiripan')
        baris = []
        for x in peta:
            acuan = [K.gambar_sumber(slug, x['sumber'], hp) for hp in (False, True)]
            acuan = [f"`docs/contoh/referensi/{g.name}`" if g.parent == L.folder_referensi(slug) else f"`docs/contoh/aset/{g.name}`"
                     for g in dict.fromkeys(a for a in acuan if a)]
            baris.append(f"- {L.CONTOH_HALAMAN[x['halaman']]} · **{x['blok']}** ← {x['sumber']} ({x.get('unsur') or '-'})"
                         + (f": {', '.join(acuan)}" if acuan else ''))
        t += ('\n### Referensi desain klien (ACUAN UTAMA — di atas contoh tampilan)\n\n'
              'Klien memberi referensi untuk blok berikut. Untuk blok ini tiru REFERENSI (Read screenshot-nya, potong yang '
              'panjang), bukan contoh tampilan, bila keduanya berbeda; blok lain ikuti contoh tampilan. Merek, teks, dan '
              'warna brand tetap milik klien. Hasil landing akan dinilai otomatis kemiripannya dengan referensi ini.\n'
              + '\n'.join(baris) + '\n')
    return t


def prompt_fitur(p, fitur, f, app_dir=None):
    kriteria = '\n'.join(f"{i}. {k['teks']}" for i, k in enumerate(f['kriteria'], 1))
    revisi = ''
    if f.get('revisi'):
        revisi = '## REVISI dari webmaster (wajib ditangani; fitur ini sudah pernah dikerjakan & di-commit)\n\n' + '\n'.join(
            f"- ({datetime.fromtimestamp(r['waktu']).strftime('%d %b %H:%M')}, {r['oleh']}) {r['catatan']}"
            for r in f['revisi'][-5:]) + '\n'
        if any(k.get('revisi') for k in f['kriteria']):
            revisi += ('\nSetiap revisi juga tercantum di kriteria terima sebagai "Revisi N: …" — laporkan status & buktinya '
                       'seperti kriteria lain.\n')
    galat = ''
    if (f.get('hasil') or {}).get('galat'):
        galat = ('## Percobaan sebelumnya GAGAL diverifikasi runner\n\nPerubahan percobaan itu masih ada (belum di-commit). '
                 'Lanjutkan dan perbaiki. Keluaran terakhir:\n```\n' + f['hasil']['galat'][-3000:] + '\n```\n')
    if f.get('terputus'):
        galat += ('## Sesi sebelumnya untuk fitur ini TERPUTUS (mesin dimatikan)\n\nPerubahan yang belum di-commit masih ada. '
                  'Periksa `git status` / `git diff` dulu, lanjutkan dari situ, jangan mulai dari nol.\n')
    selesai = '\n'.join(f"- {x['id']} {x['judul']}" for x in fitur if x['status'] in ('dites', 'ok')) or '- (belum ada)'
    halaman = ''
    if f.get('halaman'):
        halaman = ('**Halaman & peran yang wajib ada di fitur ini** (dari Matriks peran × halaman di PRD; setiap peran '
                   'harus bisa membuka halamannya dari menu navigasi peran itu, dengan hak akses sesuai matriks):\n'
                   + '\n'.join(f"- {h['halaman']}: {', '.join(h['peran'])}" for h in f['halaman']) + '\n')
    ganti = {'{{JUDUL}}': p['judul'], '{{ID}}': f['id'], '{{JUDUL_FITUR}}': f['judul'], '{{DESKRIPSI}}': f.get('deskripsi') or '',
             '{{KRITERIA}}': kriteria, '{{HALAMAN}}': halaman, '{{REVISI}}': revisi, '{{GALAT_LALU}}': galat, '{{SELESAI}}': selesai,
             '{{BAHAN}}': (bahan_dokumen(app_dir, fitur, f) + bahan_contoh(p, app_dir, fitur, f)) if app_dir else ''}
    t = TUGAS.read_text()
    for k, v in ganti.items():
        t = t.replace(k, v)
    return t


def jalankan_claude(DC, app_dir, prompt, menit, env):
    env = {k: v for k, v in env.items() if k != 'ANTHROPIC_DEFAULT_OPUS_MODEL'}
    opus = DC.opus_terbaru(env)
    env.update(ANTHROPIC_DEFAULT_HAIKU_MODEL=opus, ANTHROPIC_DEFAULT_SONNET_MODEL=opus,
               ANTHROPIC_SMALL_FAST_MODEL=opus, CLAUDE_CODE_SUBAGENT_MODEL=opus)
    log(f'model agen: {opus}, batas {menit} menit')
    perintah = [
        DC.CLAUDE, '-p', prompt, '--model', 'opus',
        '--output-format', 'stream-json', '--verbose', '--no-session-persistence',
        '--permission-mode', 'acceptEdits', '--json-schema', json.dumps(SKEMA),
        '--allowedTools', 'Read', 'Write', 'Edit', 'MultiEdit', 'Glob', 'Grep', 'TodoWrite',
        'Bash(php artisan:*)', 'Bash(php -l:*)', 'Bash(composer:*)', 'Bash(npm:*)', 'Bash(npx:*)',
        'Bash(vendor/bin/pint:*)', 'Bash(vendor/bin/pest:*)', 'Bash(vendor/bin/phpstan:*)',
        'Bash(git status:*)', 'Bash(git diff:*)', 'Bash(git log:*)', 'Bash(git show:*)', 'Bash(ls:*)',
        # Rahasia (kredensial DB root, token GitHub, .env) & data project lain tidak boleh dibaca
        '--disallowedTools', 'WebFetch', 'WebSearch', 'Bash(git push:*)', 'Bash(git commit:*)', 'Bash(git reset:*)',
        'Bash(git checkout:*)', 'Read(//etc/**)', 'Read(//root/**)', 'Read(//var/lib/velocity/**)',
        'Read(./.env)', 'Edit(./.env)', 'Write(./.env)',
    ]
    mulai = time.time()
    hasil, permintaan = {}, set()
    proses = subprocess.Popen(perintah, cwd=app_dir, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, env=env)
    habis = threading.Timer(menit * 60, proses.kill)
    habis.start()
    try:
        for baris in proses.stdout:
            try:
                ev = json.loads(baris)
            except ValueError:
                continue
            if ev.get('type') == 'assistant':
                pesan = ev.get('message') or {}
                permintaan.add(pesan.get('id'))
                for blok in pesan.get('content') or []:
                    r = ringkas_langkah(blok)
                    if r:
                        log(r)
            elif ev.get('type') == 'result':
                hasil = ev
        kode = proses.wait()
    finally:
        habis.cancel()
    hasil['menit'] = round((time.time() - mulai) / 60, 1)
    hasil['timeout'] = not hasil.get('type') and time.time() - mulai >= menit * 60 - 5
    hasil['kode_keluar'] = kode
    hasil['permintaan'] = len(permintaan)
    return hasil


def catat_pemakaian(DC, slug, fid, hasil):
    for model, u in (hasil.get('modelUsage') or {}).items():
        masuk, baca, buat = (int(u.get(k) or 0) for k in ('inputTokens', 'cacheReadInputTokens', 'cacheCreationInputTokens'))
        keluar = int(u.get('outputTokens') or 0)
        baris = {
            'ts': datetime.now(timezone.utc).isoformat(timespec='seconds'), 'domain': slug,
            'run': f'laravel-agen-{slug}-{fid}', 'mode': 'agen', 'peran': 'laravel_agen', 'script': 'laravel-agen',
            'sumber': 'claude', 'model_id': 'claude-code', 'model': model, 'permintaan': hasil.get('permintaan') or 1,
            'prompt_tokens': masuk + baca + buat, 'completion_tokens': keluar, 'total_tokens': masuk + baca + buat + keluar,
            'input_tokens': masuk, 'cache_read_tokens': baca, 'cache_creation_tokens': buat,
            'biaya_usd': round(float(u.get('costUSD') or 0), 4), 'ok': not hasil.get('is_error'),
            'giliran': hasil.get('num_turns'),
        }
        try:
            with open(DC.AI_USAGE, 'a') as f:
                fcntl.flock(f, fcntl.LOCK_EX)
                f.write(json.dumps(baris, ensure_ascii=False) + '\n')
        except OSError:
            pass


def hasil_tes(keluaran):
    """Boost membuat `php artisan test` mencetak satu baris JSON {"tool":"pest","result":..,"passed":..}."""
    for baris in reversed(keluaran.splitlines()):
        baris = baris.strip()
        if baris.startswith('{') and '"tool"' in baris:
            try:
                j = json.loads(baris)
                return int(j.get('passed') or 0), int(j.get('failed') or 0) + int(j.get('errors') or 0)
            except ValueError:
                pass
    m = re.search(r'Tests:\s+(?:(\d+) failed[^\d]*)?(\d+) passed', keluaran)
    return (int(m.group(2)), int(m.group(1) or 0)) if m else (0, 0)


def cek_seeder(app_dir, info):
    """Setiap model di app/Models wajib terisi oleh seeder (templates/laravel/cek-seeder.php).
    migrate:fresh --seed di SQLite sementara, jadi database dev tidak tersentuh. -> galat ('' = lolos)"""
    log('verifikasi: seeder setiap model (migrate:fresh --seed di SQLite sementara)')
    with tempfile.TemporaryDirectory(prefix='cek-seeder-') as tmp:
        db = Path(tmp, 'seed.sqlite')
        db.touch()
        env = dict(os.environ, DB_CONNECTION='sqlite', DB_DATABASE=str(db), DB_URL='', APP_ENV='local',
                   MAIL_MAILER='array', CACHE_STORE='array', SESSION_DRIVER='array', QUEUE_CONNECTION='sync')
        kode, keluar = sh(['php', str(HERE.parent / 'templates/laravel/cek-seeder.php')], app_dir, 600, env)
    hasil = {}
    for baris in reversed(keluar.splitlines()):
        if baris.startswith('{'):
            try:
                hasil = json.loads(baris)
                break
            except ValueError:
                pass
    info['seeder'] = hasil.get('jumlah') or {}
    if kode == 0 and hasil.get('ok'):
        log(f"  seeder: {len(info['seeder'])} model terisi")
        return ''
    return 'Cek seeder gagal: ' + (hasil.get('galat') or ekor(keluar, 30)) + \
        '\nSetiap model wajib punya factory + seeder yang dipanggil DatabaseSeeder (lihat CLAUDE.md, bagian Seeder).'


def verifikasi(app, app_dir, pengguna, port):
    """Runner memeriksa sendiri hasil agen. -> (lolos, info, galat)"""
    info = {}
    langkah = [
        ('pint', 'vendor/bin/pint', 300),
        ('migrate', 'php artisan migrate --force', 300),
        ('tes', 'php artisan test --compact', 900),
        ('build', 'npm run build', 600),
    ]
    for nama, perintah, batas in langkah:
        log(f'verifikasi: {perintah}')
        kode, keluar = sh(perintah, app_dir, timeout=batas)
        if nama == 'tes':
            info['tes_lulus'], info['tes_gagal'] = hasil_tes(keluar)
            log(f"  tes: {info['tes_lulus']} lolos, {info['tes_gagal']} gagal")
        if kode != 0:
            return False, info, f'$ {perintah} (kode {kode})\n{ekor(keluar, 60)}'
        if nama == 'tes':
            galat = cek_seeder(app_dir, info)
            if galat:
                return False, info, galat
    sh(['chown', '-R', f'{pengguna}:{pengguna}', 'storage', 'bootstrap/cache'], app_dir)
    sh(['php', 'artisan', 'optimize:clear', '-q'], app_dir)
    sh(['chown', '-R', f'{pengguna}:{pengguna}', 'storage', 'bootstrap/cache'], app_dir)
    sh(['systemctl', 'restart', f'{app}-dev', f'{app}-queue'], app_dir)
    kode_http = '000'
    for _ in range(20):
        time.sleep(1)
        _, kode_http = sh(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', f'http://127.0.0.1:{port}/login'], app_dir, 15)
        if kode_http == '200':
            break
    log(f'  dev /login HTTP {kode_http}')
    if kode_http != '200':
        return False, info, f'Aplikasi dev tidak menjawab (GET /login HTTP {kode_http}); cek journalctl -u {app}-dev'
    return True, info, ''


def deploy_dev(slug, app, app_dir, port):
    """Deploy dev sesudah semua fitur selesai, sebelum Review. -> lolos (bool); hasil dicatat di agen.deploy."""
    log('')
    log('===== DEPLOY DEV (sebelum Review) =====')
    galat, http = '', ''
    _, commit = sh(['git', 'rev-parse', '--short', 'HEAD'], app_dir)
    skrip = Path('/root', app, 'deploy-dev.sh')
    _, kotor = sh(['git', 'status', '--porcelain'], app_dir)
    if kotor:
        galat = 'Salinan kerja punya perubahan belum di-commit:\n' + ekor(kotor, 20)
    if not galat:
        sh(['git', 'fetch', '-q', 'origin'], app_dir, 120)
        _, belum = sh(['git', 'rev-list', '--count', 'origin/main..HEAD'], app_dir)
        if belum.strip() not in ('', '0'):
            kode, keluar = sh(['git', 'push', '-q', 'origin', 'main'], app_dir, 180)
            log(f'push {belum.strip()} commit tertinggal: ' + ('ok' if kode == 0 else 'GAGAL'))
            if kode != 0:
                galat = f'git push gagal: {ekor(keluar, 5)}'
    if not galat and not skrip.is_file():
        galat = f'{skrip} tidak ada (dibuat installer langkah 8)'
    if not galat:
        log(f'$ {skrip}')
        kode, keluar = sh([str(skrip)], app_dir, 1800)
        for b in ekor(keluar, 25).splitlines():
            log(f'  {b}')
        if kode != 0:
            galat = f'$ {skrip} (kode {kode})\n{ekor(keluar, 60)}'
    if not galat:
        for _ in range(20):
            _, http = sh(['curl', '-s', '-o', '/dev/null', '-w', '%{http_code}', f'http://127.0.0.1:{port}/login'], app_dir, 15)
            if http == '200':
                break
            time.sleep(1)
        if http != '200':
            galat = f'Aplikasi dev tidak menjawab sesudah deploy (GET /login HTTP {http}); cek journalctl -u {app}-dev'
    _, commit = sh(['git', 'rev-parse', '--short', 'HEAD'], app_dir)
    hasil = {'waktu': L.sekarang(), 'ok': not galat, 'commit': commit, 'http': http, 'galat': galat[-6000:]}
    L.ubah_proyek(slug, lambda x: x.setdefault('agen', {}).update(deploy=hasil))
    if galat:
        log(f'DEPLOY DEV GAGAL: {galat.splitlines()[0][:300]}')
        L.catat(slug, 'Agen Claude', f'deploy dev gagal (commit {commit})')
    else:
        log(f'Deploy dev lolos: commit {commit}, /login HTTP 200. Lanjut ke Review webmaster.')
        L.catat(slug, 'Agen Claude', f'deploy dev lolos (commit {commit})')
    return not galat


def cek_kemiripan(DC, slug, fid, f, port):
    """Landing aplikasi dev vs referensi klien (atau contoh ACC). Belum mirip -> fitur otomatis jadi revisi sekali
    dengan daftar perbaikan, supaya PM/webmaster tak perlu mencocokkan sendiri (15 Okt)."""
    K = muat('laravel_kemiripan', HERE / 'laravel-kemiripan')
    log('cek kemiripan landing dengan referensi desain…')
    k = K.nilai(DC, K.env_claude(DC), slug, 'app', f'http://127.0.0.1:{port}')
    if not k:
        return
    otomatis = not k['lolos'] and k['arahan'] and not f.get('kemiripan_otomatis')

    def ubah(fs):
        x = next(x for x in fs if x['id'] == fid)
        x['hasil']['kemiripan'] = {a: k[a] for a in ('waktu', 'skor', 'lolos', 'ambang', 'ringkasan', 'blok')}
        if otomatis:
            x['status'] = 'revisi'
            x['kemiripan_otomatis'] = True
            x.setdefault('revisi', []).append({'catatan': 'Tampilan belum mirip referensi desain klien (skor '
                                               f"{k['skor']}/{k['ambang']}). Perbaiki:\n{k['arahan']}",
                                               'oleh': 'Cek kemiripan otomatis', 'waktu': L.sekarang()})
    L.ubah_fitur(slug, ubah)
    if otomatis:
        log(f"{fid} belum mirip referensi (skor {k['skor']}); diantrekan revisi otomatis sekali.")
        L.catat(slug, 'Agen Claude', f"{fid} direvisi otomatis: skor kemiripan {k['skor']} di bawah {k['ambang']}")


def main():
    hanya_deploy = sys.argv[2:] == ['--deploy']
    if len(sys.argv) not in (2, 3) or not L.ID_RE.match(sys.argv[1]) or (len(sys.argv) == 3 and not hanya_deploy):
        print(__doc__)
        return 2
    slug = sys.argv[1]
    p = L.baca_json(L.folder(slug) / 'proyek.json', {})
    inst = L.install_state(slug)
    app = p.get('app')
    if not app or inst.get('status') != 'ok':
        log('Project belum terpasang; agen tidak bisa mulai.')
        return 1
    app_dir, pengguna, port = Path('/home', app), app.replace('-', ''), inst['port']
    if hanya_deploy:
        # status 'jalan' supaya mesin mati di tengah deploy tercatat 'terputus' dan dilanjutkan laravel-agen-lanjut
        L.ubah_proyek(slug, lambda x: x.setdefault('agen', {}).update(status='jalan', fitur=None, deploy=None))
        lolos = deploy_dev(slug, app, app_dir, port)
        L.ubah_proyek(slug, lambda x: x.setdefault('agen', {}).update(status='selesai' if lolos else 'deploy_gagal'))
        return 0 if lolos else 1
    DC = muat('desain_claude', HERE / 'desain-claude')
    env = dict(os.environ)
    # AGEN_PAKAI_PAKET=1: pakai login langganan Claude Code (OAuth) alih-alih saldo API, mis. saat kredit API habis
    if os.environ.get('AGEN_PAKAI_PAKET') == '1':
        env.pop('ANTHROPIC_API_KEY', None)
    elif DC.KUNCI_API.is_file() and DC.KUNCI_API.read_text().strip():
        env['ANTHROPIC_API_KEY'] = DC.KUNCI_API.read_text().strip()
    # Fitur yang tertinggal "jalan" dari run yang mati mendadak (mesin mati) diantrekan lagi dan ditandai terputus
    L.ubah_fitur(slug, lambda fs: [x.update(status='antre', terputus=True) for x in fs if x.get('status') == 'jalan'])
    L.ubah_proyek(slug, lambda x: x.setdefault('agen', {}).update(status='jalan', mulai=L.sekarang(), fitur=None))
    log(f'Agen mulai untuk {p["judul"]} ({app_dir}, dev http://{ip_lan()}:{port}); '
        f'jatah hari ini {L.jatah_agen_harian(slug):.1f} jam, terpakai {L.menit_agen_hari_ini(L.baca_json(L.folder(slug) / "fitur.json", [])):.0f} menit')
    akhir = 'selesai'
    while True:
        p = L.baca_json(L.folder(slug) / 'proyek.json', {})
        if (p.get('agen') or {}).get('minta_berhenti'):
            log('Dihentikan atas permintaan (sesudah fitur terakhir selesai).')
            akhir = 'berhenti'
            break
        fitur = L.baca_json(L.folder(slug) / 'fitur.json', [])
        gagal = next((f for f in fitur if f['status'] == 'gagal'), None)
        if gagal:
            log(f"{gagal['id']} masih GAGAL — tekan Ulangi di tab Agen atau perbaiki manual dulu. Agen berhenti.")
            akhir = 'gagal'
            break
        f = next((f for f in fitur if f['status'] in ('antre', 'revisi')), None)
        if not f:
            log('Semua fitur sudah dikerjakan agen.')
            if not deploy_dev(slug, app, app_dir, port):
                akhir = 'deploy_gagal'
            break
        gerbang = L.gerbang_review(fitur)
        if gerbang and f['status'] != 'revisi' and f['id'] not in [x['id'] for x in fitur[:L.konfig_jadwal()['fitur_gerbang_review']]]:
            log(f"Fitur fondasi {', '.join(gerbang)} belum direview webmaster. Agen berhenti sebelum {f['id']} supaya "
                f"masukan soal struktur dasar masuk dulu; lanjut otomatis sesudah semuanya direview (OK atau Revisi).")
            akhir = 'menunggu_review'
            break
        fid = f['id']
        perkiraan = perkiraan_menit(fitur)
        jatah = L.jatah_agen_harian(slug) * 60
        terpakai = L.menit_agen_hari_ini(fitur)
        if terpakai > 0 and terpakai + perkiraan > jatah:
            log(f"Jatah agen hari ini untuk project ini habis ({terpakai:.0f} dari {jatah:.0f} menit; perkiraan {fid} "
                f"{perkiraan:.0f} menit). Kuota Claude dipakai bersama — dilanjutkan otomatis besok pagi.")
            L.ubah_proyek(slug, lambda x: x['agen'].update(jatah_tanggal=datetime.now().strftime('%Y-%m-%d')))
            akhir = 'jatah_habis'
            break
        sisa_menit = menit_sampai(BATAS_MULAI)
        if sisa_menit < perkiraan:
            log(f"Waktu mesin hari ini tidak cukup untuk {fid} (perkiraan {perkiraan:.0f} menit, sisa {max(0, sisa_menit):.0f} menit "
                f"sebelum 21.45). Dilanjutkan otomatis saat mesin nyala besok pagi.")
            akhir = 'menunggu_pagi'
            break
        log('')
        log(f"===== {fid} {f['judul']}{' (REVISI)' if f['status'] == 'revisi' else ''} =====")
        adalah_revisi = f['status'] == 'revisi'
        L.ubah_fitur(slug, lambda fs: next(x for x in fs if x['id'] == fid).update(status='jalan', mulai=L.sekarang()))
        L.ubah_proyek(slug, lambda x: x['agen'].update(fitur=fid, deploy=None))

        lepas_lock_basi(app_dir)
        kode, keluar = sh(['git', 'status', '--porcelain', '--untracked-files=no'], app_dir)
        if kode == 0 and not keluar:
            kode, keluar = sh(['git', 'pull', '-q', '--ff-only', 'origin', 'main'], app_dir, 120)
            log('git pull: ' + ('ok' if kode == 0 else f'gagal ({ekor(keluar, 3)})'))
        else:
            log('Salinan kerja punya perubahan belum di-commit; dilanjutkan tanpa pull.')

        menit = int(min(MENIT_MAKS, max(MENIT_MIN, float(f.get('jam_agen') or 1) * 60 * 3), menit_sampai(BATAS_KERAS)))
        L.DASAR.mkdir(parents=True, exist_ok=True)
        with open('/var/lib/velocity/desain-claude.lock', 'w') as kunci:
            try:
                fcntl.flock(kunci, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                log('Menunggu antrean agen Claude (agen lain sedang bekerja)…')
                fcntl.flock(kunci, fcntl.LOCK_EX)
            hasil = jalankan_claude(DC, app_dir, prompt_fitur(p, fitur, f, app_dir), menit, env)
        catat_pemakaian(DC, slug, fid, hasil)
        hari_ini = datetime.now().strftime('%Y-%m-%d')
        L.ubah_fitur(slug, lambda fs: next(x for x in fs if x['id'] == fid).setdefault('riwayat_menit', []).append(
            {'hari': hari_ini, 'menit': hasil['menit']}))
        laporan = hasil.get('structured_output') if isinstance(hasil.get('structured_output'), dict) else None
        biaya = round(float(hasil.get('total_cost_usd') or 0), 2)
        log(f"agen selesai: {hasil['menit']} menit, {hasil.get('num_turns') or '?'} giliran, setara API ${biaya}")

        galat = ''
        info = {}
        teks_hasil = f"{hasil.get('result') or ''} {hasil.get('subtype') or ''} {hasil.get('api_error_status') or ''}"
        if hasil.get('is_error') and KUOTA_RE.search(teks_hasil):
            # Kuota langganan habis (dipakai bersama webmaster & agen lain): tunggu, jangan dianggap gagal
            log(f'{fid} tertunda: kuota Claude habis ({teks_hasil.strip()[:160]}). Dicoba lagi otomatis tiap jam.')
            L.ubah_fitur(slug, lambda fs: next(x for x in fs if x['id'] == fid).update(status='antre', terputus=True))
            akhir = 'menunggu_kuota'
            break
        if hasil.get('timeout') and menit_sampai(BATAS_KERAS) <= 1:
            # Dipotong karena jam mesin, bukan karena fiturnya bermasalah: lanjutkan besok, bukan "gagal"
            log(f'{fid} dipotong karena mesin segera mati; dilanjutkan besok pagi dari perubahan yang sudah ada.')
            L.ubah_fitur(slug, lambda fs: next(x for x in fs if x['id'] == fid).update(status='antre', terputus=True))
            akhir = 'menunggu_pagi'
            break
        if hasil.get('timeout'):
            galat = f'Agen melewati batas {menit} menit.'
        elif hasil.get('is_error') or not laporan:
            galat = 'Agen berhenti tanpa laporan: ' + str(hasil.get('result') or hasil.get('subtype') or 'tanpa keluaran')[:1500]
        else:
            lolos, info, galat = verifikasi(app, app_dir, pengguna, port)

        commit = ''
        if not galat:
            lepas_lock_basi(app_dir)
            sh(['git', 'add', '-A'], app_dir)
            pesan = f"feat({fid.lower()}): {f['judul']}" + (' (revisi)' if adalah_revisi else '') + \
                f"\n\n{laporan['ringkasan']}\n\nDikerjakan agen Claude Code (installer Velocity)."
            kode, keluar = sh(['git', '-c', f'user.name={L.GIT_NAMA}', '-c', f'user.email={L.GIT_EMAIL}',
                               'commit', '-q', '-m', pesan], app_dir)
            if kode != 0 and 'nothing to commit' not in keluar:
                galat = f'git commit gagal: {ekor(keluar, 10)}'
            else:
                _, commit = sh(['git', 'rev-parse', '--short', 'HEAD'], app_dir)
                kode, keluar = sh(['git', 'push', '-q', 'origin', 'main'], app_dir, 180)
                log(f'commit {commit}, push: ' + ('ok' if kode == 0 else f'GAGAL ({ekor(keluar, 3)})'))

        def simpan(fs):
            x = next(x for x in fs if x['id'] == fid)
            x['hasil'] = {'waktu': L.sekarang(), 'menit': hasil['menit'], 'biaya_usd': biaya, 'giliran': hasil.get('num_turns'),
                          'commit': commit, **info, 'galat': galat[-6000:] if galat else ''}
            if laporan:
                x['hasil'].update(ringkasan=laporan['ringkasan'], cara_cek=laporan['cara_cek'],
                                  catatan_webmaster=laporan['catatan_webmaster'], berkas=laporan['berkas'][:60])
                per_no = {k.get('no'): k for k in laporan['kriteria']}
                for i, k in enumerate(x['kriteria'], 1):
                    a = per_no.get(i) or {}
                    k['agen'] = {'status': a.get('status', 'belum'), 'bukti': str(a.get('bukti') or '')[:600]}
                    k['cek'] = False
            x['status'] = 'gagal' if galat else 'dites'
            x.pop('terputus', None)
        L.ubah_fitur(slug, simpan)
        if galat:
            log(f'{fid} GAGAL: {galat.splitlines()[0][:300]}')
            L.catat(slug, 'Agen Claude', f'{fid} gagal diverifikasi')
            akhir = 'gagal'
            break
        L.catat(slug, 'Agen Claude', f"{fid} selesai ({info.get('tes_lulus', 0)} tes lolos, commit {commit})")
        if 'index.html' in halaman_contoh(p, fitur, f):
            cek_kemiripan(DC, slug, fid, f, port)
    L.ubah_proyek(slug, lambda x: x['agen'].update(status=akhir, fitur=None, selesai=L.sekarang()))
    return 0 if akhir != 'gagal' else 1


def _sigterm(*_):
    # Mesin dimatikan: keluar lewat finally supaya status tercatat 'terputus' (dilanjutkan otomatis)
    raise SystemExit(143)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, _sigterm)
    try:
        sys.exit(main())
    finally:
        if len(sys.argv) > 1 and L.ID_RE.match(sys.argv[1]):
            def _(p):
                p.pop('job', None)
                # Runner berhenti di tengah (SIGTERM mesin mati / galat) -> terputus, dilanjutkan laravel-agen-lanjut
                p.setdefault('agen', {})
                if p['agen'].get('status') == 'jalan':
                    p['agen'].update(status='terputus', fitur=None)
            L.ubah_proyek(sys.argv[1], _)
            L.ubah_fitur(sys.argv[1], lambda fs: [x.update(status='antre', terputus=True) for x in fs if x.get('status') == 'jalan'])
