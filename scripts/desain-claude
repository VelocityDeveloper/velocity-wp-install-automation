#!/usr/bin/env python3
"""Agen desain Claude untuk paket custom (keputusan user 2026-09-18, opsi B).

Generator deterministik (fse-apply) hanya punya komponen tetap, jadi situs yang belum mirip
referensi tidak membaik walau diulang. Di sini Claude Code (headless, mode agen) mengambil alih
pembacaan referensi & penyusunan desain di atas tema velocity-fse, lalu mengaudit dan mengulang
sendiri sampai mirip:

  1. prasyarat: referensi ada, tema velocity-fse aktif, bukan portal berita / gaya_beranda manual
  2. bahan: hasil generator sekarang (titik awal), template part tema, palet, isi & foto situs
  3. audit awal (fse-audit-kemiripan) = skor pembanding
  4. `claude -p` dengan templates/desain-claude/tugas.md; alat shell satu-satunya =
     scripts/desain-claude-alat (cek/pasang/audit/potret/potong) yang terkunci ke situs ini
  5. audit akhir; skor total TURUN dibanding awal -> hasil Claude dicabut (folder dipindah ke
     claude.ditolak-<waktu>, situs kembali ke hasil generator)

Hasil kerja ada di fse-rencana/<domain>/claude/ dan dipakai lagi oleh `fse-apply --isi` pada run
berikutnya (halaman_claude:<slug>). Satu agen berjalan dalam satu waktu (kunci berkas).

Dua tahap (keputusan user 2026-09-21: agen hadir sejak referensi dibaca, langkah Tema FSE
dikerjakan agen):
  tema     langsung sesudah `fse-apply --tema` (velocity-fse + palet + data situs sebagai dasar):
           agen menyusun header, footer & gaya.css dari referensi. Halaman belum ada, jadi `pasang`
           tidak menyentuh halaman dan skor hanya header+footer+gaya. Log berawalan
           `desain_claude_tema:` supaya bagan tidak mengira tahap halaman sudah berjalan.
  halaman  (bawaan) sesudah konten, foto & halaman generator siap: beranda + halaman dalam,
           melanjutkan header/footer/CSS dari tahap tema (catatan di claude/kerja/rencana.md).

  desain-claude <manifest> [--tahap=tema|halaman] [--paksa] [--putaran=N] [--menit=N]
     --paksa   jalan walau audit awal sudah sesuai
Env: DESAIN_CLAUDE_MODEL (bawaan opus), DESAIN_CLAUDE_MENIT (90; tahap tema 45),
DESAIN_CLAUDE_PUTARAN (8; tahap tema 5).
Biaya: login langganan Claude di server; /etc/velocity/secrets/anthropic_api_key (600) ada = pakai API key itu.
Keluaran baris terakhir: desain_claude: <status> ... ; kode 0 selesai (apa pun hasilnya), 2 gagal jalan.
"""
import fcntl
import importlib.machinery
import importlib.util
import json
import re
import os
import shutil
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
ALAT = HERE / 'desain-claude-alat'
TEMA = ROOT / 'templates' / 'tema-fse'
TUGAS = ROOT / 'templates' / 'desain-claude' / 'tugas.md'
TOKO = ROOT / 'templates' / 'desain-claude' / 'toko-vd-store.md'
# Blok ala page builder (keputusan user 2026-09-26): seksi halaman disusun dari Velocity Blocks
# (vb/*) yang dipasang fse-apply --tema, supaya klien bisa drag-drop, pilih ikon & tautan di kanvas.
VB = ROOT / 'templates' / 'plugins' / 'velocity-blocks'
KUNCI = Path('/var/lib/velocity/desain-claude.lock')
AI_USAGE = Path('/var/lib/velocity/ai/usage.jsonl')
CLAUDE = shutil.which('claude') or '/root/.local/bin/claude'
KUNCI_API = Path('/etc/velocity/secrets/anthropic_api_key')
# Model agen (keputusan user 2026-09-18): Opus, tidak boleh lebih rendah. Nilai selain Opus
# di DESAIN_CLAUDE_MODEL diabaikan, dan model kecil internal Claude Code (judul, ringkasan —
# bawaannya Haiku) ikut dipaksa ke Opus lewat env di jalankan_claude().
# Selalu Opus TERBARU (permintaan user 2026-09-23, saat Opus 5.5 rilis): ID tidak ditulis
# mati — dulu 'claude-opus-5' tertinggal di model internal walau alias `opus` sudah 5.5.
# opus_terbaru() meresolve alias `opus` CLI ini lewat satu request kecil, disimpan per versi CLI
# (claude-update.timer memperbarui CLI tiap pagi -> versi baru -> dicek ulang).
MODEL_TEMBOLOK = Path('/var/lib/velocity/desain-claude-model.json')
# Hanya dipakai bila resolusi gagal DAN belum pernah ada hasil tersimpan.
OPUS_CADANGAN = 'claude-opus-5-5'


def model_agen():
    pilihan = os.environ.get('DESAIN_CLAUDE_MODEL', 'opus').strip()
    return pilihan if 'opus' in pilihan.lower() else 'opus'


def opus_terbaru(env):
    """ID model Opus terbaru yang dikenal CLI Claude di server ini (mis. claude-opus-5-5)."""
    paksa = os.environ.get('DESAIN_CLAUDE_MODEL_ID', '').strip()
    if 'opus' in paksa.lower():
        return paksa
    try:
        versi = subprocess.run([CLAUDE, '--version'], capture_output=True, text=True, timeout=30).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        versi = ''
    try:
        lama = json.loads(MODEL_TEMBOLOK.read_text())
    except (OSError, ValueError):
        lama = {}
    if versi and lama.get('versi') == versi and 'opus' in str(lama.get('model', '')).lower():
        return lama['model']
    model = ''
    try:
        run = subprocess.run([CLAUDE, '-p', 'Balas satu kata: ok', '--model', 'opus', '--output-format', 'json',
                              '--no-session-persistence', '--tools', ''],
                             capture_output=True, text=True, timeout=180, env=env, cwd='/tmp')
        model = next((m for m in (json.loads(run.stdout).get('modelUsage') or {}) if 'opus' in m.lower()), '')
    except (OSError, subprocess.SubprocessError, ValueError):
        model = ''
    if model:
        try:
            MODEL_TEMBOLOK.write_text(json.dumps({'versi': versi, 'model': model, 'dicek': datetime.now()
                                                  .astimezone().isoformat(timespec='seconds')}))
        except OSError:
            pass
        return model
    return lama.get('model') if 'opus' in str(lama.get('model', '')).lower() else OPUS_CADANGAN
STATE = Path('/var/lib/velocity/installer')
# Penanda "agen sedang berjalan" yang dibaca installer_status.py: situs tampil RUNNING di /installer/.
AKTIF_DIR = STATE / 'desain-claude'
# Dijalankan manual (bukan dari installer-runner yang sudah mengalirkan keluaran ke log domain):
# baris log ikut ditulis ke <domain>.log supaya bagan & panel pantau /installer/ mengikutinya.
LOG_DOMAIN = None
# Run manual (bukan dari installer-runner) tetap satu kelompok run sendiri di halaman /ai/.
RUN_MANUAL = 'desain-claude-' + datetime.now().strftime('%Y%m%d-%H%M%S')
# Tahap kerja (lihat docstring). Diisi main() dari --tahap; alat membacanya dari VELOCITY_DESAIN_TAHAP.
TAHAP = 'halaman'
# Bagian yang dinilai di tahap tema: halaman belum disusun, jadi beranda & halaman dalam diabaikan.
BAGIAN_TEMA = ('header', 'footer', 'gaya')
AMBANG = 80


def muat(nama, path):
    loader = importlib.machinery.SourceFileLoader(nama, str(path))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


FA = muat('fse_apply', HERE / 'fse-apply')


def awalan():
    return 'desain_claude_tema' if TAHAP == 'tema' else 'desain_claude'


def log(pesan, tanpa_waktu=False):
    baris = f'{awalan()}: {pesan}' if tanpa_waktu else \
        f'[{datetime.now().astimezone().isoformat(timespec="seconds")}] {awalan()}: {pesan}'
    print(baris, flush=True)
    if LOG_DOMAIN:
        try:
            with open(LOG_DOMAIN, 'a') as f:
                f.write(baris + '\n')
        except OSError:
            pass


PHP_BAHAN = r'''
$palet = wp_get_global_settings(array('color', 'palette', 'theme'));
$situs = (array) get_option('velocity_situs', array());
// Email pemilik = penerima form (internal), bukan kontak publik.
unset($situs['email']);
$foto = array();
foreach ((array) get_option('vfse_images', array()) as $k => $v) {
    $u = is_numeric($v) ? wp_get_attachment_url((int) $v) : (string) $v;
    if ($u) { $foto[$k] = $u; }
}
$halaman = array();
foreach (get_pages(array('post_status' => 'publish')) as $p) {
    $halaman[] = array('slug' => get_page_uri($p), 'judul' => $p->post_title, 'url' => get_permalink($p));
}
$logo = (int) get_option('site_logo');
// Toko ber-VD Store (bukan WooCommerce): aturan produk store_product disisipkan ke prompt.
vfse_keluar(array('vd_store' => defined('WP_STORE_VERSION') && !class_exists('WooCommerce'), 'tema' => get_stylesheet(), 'palet' => $palet, 'situs' => $situs, 'foto' => $foto,
    'halaman' => $halaman, 'logo' => $logo ? wp_get_attachment_url($logo) : '', 'nama' => get_bloginfo('name'),
    'slogan' => get_bloginfo('description'), 'home' => home_url('/')));
'''


def skor_total(folder):
    try:
        d = json.loads((folder / 'audit-kemiripan.json').read_text())
    except (OSError, ValueError):
        return None, {}
    s = d.get('skor') or {}
    if TAHAP == 'tema':
        # Beranda & halaman dalam belum disusun: yang dinilai hanya header, footer, gaya.
        s = {k: v for k, v in s.items() if k in BAGIAN_TEMA}
        d = dict(d, skor=s, belum_mirip=[k for k, v in s.items() if int(v) < AMBANG])
        d['sesuai'] = bool(s) and not d['belum_mirip']
    return sum(int(v) for v in s.values()), d


def jalankan_alat(env, *argumen, timeout=1500):
    run = subprocess.run([sys.executable, str(ALAT)] + list(argumen), capture_output=True, text=True,
                         timeout=timeout, env=env)
    return run.returncode, run.stdout + run.stderr


def siapkan(cfg, folder):
    """Bahan kerja agen. Titik awal (kerja/awal) hanya dibuat sekali: run berikutnya melanjutkan."""
    kerja = folder / 'claude' / 'kerja'
    awal = kerja / 'awal'
    (awal / 'tema-parts').mkdir(parents=True, exist_ok=True)
    for berkas in folder.glob('*.html'):
        if not berkas.name.endswith('.tersimpan.html') and not (awal / berkas.name).exists():
            shutil.copy2(berkas, awal / berkas.name)
    for bagian in ('header', 'footer'):
        shutil.copy2(TEMA / 'parts' / f'{bagian}.html', awal / 'tema-parts' / f'{bagian}.html')
    bahan = FA.Situs(cfg).php(PHP_BAHAN)
    (kerja / 'palet.json').write_text(json.dumps(bahan.pop('palet'), ensure_ascii=False, indent=1))
    (kerja / 'isi.json').write_text(json.dumps(bahan, ensure_ascii=False, indent=1))
    (kerja / 'velocity-blocks.md').write_text(ringkasan_vb(cfg))
    return bahan


def blok_vb(cfg):
    """Blok vb/* yang terdaftar di situs ini (blok modul yang dimatikan tidak ada di editor)."""
    if not (VB / 'blocks').is_dir():
        return []
    mati = {k for k, v in FA.modul_vb(cfg, 'perusahaan').items() if not v}
    peta = {'products': 'produk', 'product-details': 'produk', 'rfq-form': 'rfq', 'portfolio': 'portofolio',
            'rentals': 'sewa', 'booking-form': 'sewa', 'posts': 'berita', 'news-heading': 'berita'}
    hasil = []
    for d in sorted((VB / 'blocks').iterdir()):
        if (d / 'block.json').is_file() and peta.get(d.name) not in mati:
            hasil.append(json.loads((d / 'block.json').read_text()))
    return hasil


def ringkasan_vb(cfg):
    """Kamus blok untuk agen: nama, fungsi, wadah/bukan, atribut + bawaan, nama ikon."""
    js = (VB / 'assets' / 'editor.js').read_text() if (VB / 'assets' / 'editor.js').is_file() else ''
    daftar = list(re.finditer(r"(?:daftarkan|pratinjau)\(\s*'(vb/[a-z0-9-]+)'", js))
    wadah = {m.group(1) for i, m in enumerate(daftar)
             if 'InnerBlocks.Content' in js[m.start():daftar[i + 1].start() if i + 1 < len(daftar) else len(js)]}
    baris = ['# Velocity Blocks (vb/*) yang terpasang di situs ini', '',
             f'Sumber lengkap (baca saja): `{VB}` — `blocks/<nama>/render.php` (HTML keluaran & kelas CSS),',
             '`assets/editor.js` (pilihan nilai tiap atribut: cari `Pilih(` / `options` di blok itu), `assets/blok.css`.',
             '', 'WADAH = tulis `<!-- wp:vb/x {...} -->` + blok anak + `<!-- /wp:vb/x -->` TANPA HTML pembungkus.',
             'Bukan wadah = self-closing `<!-- wp:vb/x {...} /-->`. Atribut yang sama dengan bawaan tidak perlu ditulis.', '']
    for j in blok_vb(cfg):
        nama = j['name']
        attrs = ', '.join(f"{k}={json.dumps(v.get('default', ''), ensure_ascii=False)}"
                          for k, v in (j.get('attributes') or {}).items())
        induk = f" · hanya di dalam {', '.join(j['parent'])}" if j.get('parent') else ''
        baris.append(f"- **{nama}** ({j.get('title', '')}{' · WADAH' if nama in wadah else ''}{induk}): "
                     f"{j.get('description', '')}\n  atribut: {attrs}")
    try:
        ikon = sorted(json.loads((VB / 'assets' / 'ikon.json').read_text()))
        baris += ['', 'Nama ikon (atribut `icon`): ' + ', '.join(ikon)]
    except (OSError, ValueError):
        pass
    return '\n'.join(baris) + '\n'


TAHAP_TEKS = {
    'tema': """## Tahap ini: TEMA (awal instalasi, langsung sesudah referensi dibaca)

Kamu yang mengerjakan langkah Tema FSE. Dasarnya sudah terpasang: tema velocity-fse, palet warna
klien, data situs. Halaman, konten, foto, dan menu BELUM ada — installer membuatnya sesudah tahap ini,
lalu memanggilmu lagi (tahap halaman) untuk beranda & halaman dalam.

- Kerjakan HANYA `bagian-header.html`, `bagian-footer.html`, dan `gaya.css` (tipografi, jarak, wadah,
  tombol, kartu, judul seksi, header & footer) semirip referensi. JANGAN menulis `<slug>.html`.
- `pasang` di tahap ini hanya memasang header, footer & CSS. Menu utama masih kosong/sementara —
  jangan menilai isi menunya; nilai bentuk header-nya.
- Dari audit, yang dinilai hanya header, footer, gaya. Abaikan skor beranda & halaman.
- Wajib tulis `kerja/rencana.md`: keputusan desain (font, ukuran, jarak, bentuk tombol/kartu, gaya
  header/footer) + rencana per seksi beranda & halaman dalam dari referensi. Tahap halaman nanti
  melanjutkan dari catatan ini.
- Berhenti lebih cepat: maksimal {{PUTARAN}} putaran pasang+audit.
""",
    'halaman': """## Tahap ini: HALAMAN (akhir instalasi)

Konten, foto, menu, dan halaman generator sudah terpasang. Bila `kerja/rencana.md` sudah ada, header,
footer & `gaya.css` sudah kamu susun di tahap tema: pertahankan dan lanjutkan dari catatan itu
(sesuaikan seperlunya, mis. menu kini sudah terisi). Fokus: beranda dan halaman dalam.
""",
}


def prompt_tugas(cfg, domain, folder, putaran, referensi, vd_store=False):
    blok_tema = ', '.join(f'velocity/{p.name}' for p in sorted((TEMA / 'blocks').iterdir()) if (p / 'block.json').is_file())
    blok_tema += ', Velocity Blocks: ' + ', '.join(j['name'] for j in blok_vb(cfg))
    target = sorted({p.stem for p in folder.glob('*.html') if '.' not in p.stem and p.stem != 'menu'})
    ganti = {
        '{{DOMAIN}}': domain, '{{PAKET}}': cfg.get('paket', ''), '{{REFERENSI}}': referensi,
        '{{FOLDER}}': str(folder / 'claude'), '{{RENCANA}}': str(folder), '{{ALAT}}': str(ALAT),
        '{{TEMA}}': str(TEMA), '{{VB}}': str(VB), '{{BLOK_TEMA}}': blok_tema, '{{PUTARAN}}': str(putaran),
        '{{HALAMAN}}': ', '.join(t.replace('__', '/') for t in target) or 'beranda, tentang-kami, galeri, hubungi-kami',
    }
    prompt = TUGAS.read_text().replace('{{TAHAP}}', TAHAP_TEKS[TAHAP])
    # Hanya Toko Online Custom yang memakai VD Store (bukan WooCommerce): aturan produk store_product
    # disisipkan; toko online biasa tidak lewat jalur ini (keputusan user 2026-09-23).
    prompt = prompt.replace('{{TOKO}}', TOKO.read_text() if FA.toko_custom(cfg) and vd_store else '')
    for k, v in ganti.items():
        prompt = prompt.replace(k, v)
    return prompt


def ringkas_langkah(blok):
    """Satu baris log untuk satu langkah agen (stream-json): yang dibaca, ditulis, dijalankan."""
    if blok.get('type') == 'text':
        teks = ' '.join(str(blok.get('text') or '').split())
        return f'agen › {teks[:220]}' if teks else None
    if blok.get('type') != 'tool_use':
        return None
    alat, masuk = blok.get('name', ''), blok.get('input') or {}
    berkas = Path(str(masuk.get('file_path') or '')).name
    if alat == 'Read':
        return f"agen › {'melihat gambar' if berkas.lower().endswith(('.png', '.jpg', '.jpeg', '.webp')) else 'membaca'} {berkas}"
    if alat in ('Write', 'Edit', 'MultiEdit'):
        return f'agen › menulis {berkas}'
    if alat == 'Bash':
        perintah = str(masuk.get('command') or '').replace(str(ALAT), 'alat')
        return f"agen › {' '.join(perintah.split())[:200]}"
    if alat in ('Glob', 'Grep'):
        return f"agen › mencari {masuk.get('pattern', '')}"
    return f'agen › {alat}'


def jalankan_claude(folder, env, menit, prompt):
    # Alias `opus` dibiarkan milik CLI (ANTHROPIC_DEFAULT_OPUS_MODEL dari luar tidak boleh
    # membelokkannya ke versi lama); model internal dipaksa ke ID Opus terbaru yang sama.
    env = {k: v for k, v in env.items() if k != 'ANTHROPIC_DEFAULT_OPUS_MODEL'}
    opus = opus_terbaru(env)
    log(f'model agen: {opus} (Opus terbaru yang dikenal CLI ini)')
    perintah = [
        CLAUDE, '-p', prompt,
        '--model', model_agen(),
        # stream-json: tiap langkah agen langsung masuk log domain (modal log /installer/ live).
        '--output-format', 'stream-json', '--verbose',
        '--no-session-persistence',
        '--permission-mode', 'acceptEdits',
        '--add-dir', str(folder), str(TEMA), str(VB),
        '--allowedTools', 'Read', 'Write', 'Edit', 'Glob', 'Grep', f'Bash({ALAT}:*)',
        # Rahasia klien (password DA/DB/WP, kunci SSH, token) & kredensial Claude tidak boleh dibaca.
        '--disallowedTools', 'WebFetch', 'WebSearch', 'Agent', 'Read(//etc/**)', 'Read(//root/**)',
        'Read(//home/**)', 'Read(//var/lib/velocity/secret/**)', 'Read(//var/lib/velocity/installer/**)',
    ]
    mulai = time.time()
    hasil, kode = {}, None
    permintaan = {}  # model -> id respons API (satu id = satu request)
    env = dict(env, ANTHROPIC_DEFAULT_HAIKU_MODEL=opus, ANTHROPIC_DEFAULT_SONNET_MODEL=opus,
               ANTHROPIC_SMALL_FAST_MODEL=opus, CLAUDE_CODE_SUBAGENT_MODEL=opus)
    proses = subprocess.Popen(perintah, cwd=folder / 'claude', stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              text=True, env=env)
    # Batas waktu: readline bisa menunggu lama, jadi penjaga terpisah yang mematikan proses.
    habis = threading.Timer(menit * 60, proses.kill)
    habis.start()
    try:
        for baris in proses.stdout:
            try:
                ev = json.loads(baris)
            except ValueError:
                continue
            if ev.get('type') == 'assistant':
                pesan = ev.get('message') or {}
                permintaan.setdefault(pesan.get('model') or '-', set()).add(pesan.get('id'))
                for blok in (ev.get('message') or {}).get('content') or []:
                    ringkas = ringkas_langkah(blok)
                    if ringkas:
                        log(ringkas)
            elif ev.get('type') == 'result':
                hasil = ev
        kode = proses.wait()
    finally:
        habis.cancel()
    if not hasil and kode not in (0, None):
        kode = 'timeout' if time.time() - mulai >= menit * 60 - 5 else kode
    durasi = round((time.time() - mulai) / 60, 1)
    hasil['permintaan_per_model'] = {m: len(i) for m, i in permintaan.items()}
    hasil['opus_terbaru'] = opus
    (folder / 'claude' / 'sesi.json').write_text(json.dumps(
        dict(hasil, kode_keluar=kode, menit=durasi), ensure_ascii=False, indent=1))
    return kode, durasi, hasil


def catat_pemakaian(domain, hasil):
    """Pemakaian agen ke usage.jsonl (halaman /ai/): satu baris per model yang benar-benar dipakai,
    sumber=claude (dibedakan dari endpoint custom), jumlah request API, rincian token & biaya."""
    per_model = hasil.get('modelUsage') or {}
    minta = hasil.get('permintaan_per_model') or {}
    if not per_model:
        u = hasil.get('usage') or {}
        per_model = {model_agen(): {'inputTokens': u.get('input_tokens'), 'outputTokens': u.get('output_tokens'),
                                     'cacheReadInputTokens': u.get('cache_read_input_tokens'),
                                     'cacheCreationInputTokens': u.get('cache_creation_input_tokens'),
                                     'costUSD': hasil.get('total_cost_usd')}}
    bukan_opus = [m for m in per_model if 'opus' not in m.lower()]
    if bukan_opus:
        log('PERINGATAN model_bukan_opus:' + ','.join(bukan_opus))
    terbaru = hasil.get('opus_terbaru') or ''
    lawas = [m for m in per_model if 'opus' in m.lower() and terbaru and not m.startswith(terbaru)]
    if lawas:
        log(f'PERINGATAN opus_bukan_terbaru:{",".join(lawas)} (terbaru {terbaru})')
    for model, u in per_model.items():
        masuk, baca, buat = (int(u.get(k) or 0) for k in ('inputTokens', 'cacheReadInputTokens', 'cacheCreationInputTokens'))
        keluar = int(u.get('outputTokens') or 0)
        n = minta.get(model) or (1 if masuk + baca + buat + keluar else 0)
        baris = {
            'ts': datetime.now(timezone.utc).isoformat(timespec='seconds'), 'domain': domain,
            'run': os.environ.get('VELOCITY_RUN_ID') or RUN_MANUAL, 'mode': os.environ.get('INSTALL_MODE', '') or 'desain-claude',
            'peran': 'desain_claude', 'script': 'desain-claude', 'sumber': 'claude', 'model_id': 'claude-code',
            'tahap': TAHAP,
            'model': model, 'permintaan': n, 'prompt_tokens': masuk + baca + buat, 'completion_tokens': keluar,
            'total_tokens': masuk + baca + buat + keluar, 'input_tokens': masuk, 'cache_read_tokens': baca,
            'cache_creation_tokens': buat, 'biaya_usd': round(float(u.get('costUSD') or 0), 4),
            'ok': not hasil.get('is_error'), 'giliran': hasil.get('num_turns'),
        }
        try:
            with open(AI_USAGE, 'a') as f:
                fcntl.flock(f, fcntl.LOCK_EX)
                f.write(json.dumps(baris, ensure_ascii=False) + '\n')
        except OSError as e:
            log(f'pemakaian_tidak_tercatat:{e}')


BERKAS_TEMA = ('bagian-header.html', 'bagian-footer.html', 'gaya.css')


def simpan_tema_lama(folder):
    """Tahap tema pada situs yang sudah pernah dikerjakan agen: header/footer/CSS sebelumnya
    disalin dulu supaya pencabutan hanya mengembalikan tiga berkas itu, bukan halaman."""
    cadang = folder / 'claude' / 'kerja' / 'sebelum-tema'
    shutil.rmtree(cadang, ignore_errors=True)
    cadang.mkdir(parents=True)
    for nama in BERKAS_TEMA:
        if (folder / 'claude' / nama).is_file():
            shutil.copy2(folder / 'claude' / nama, cadang / nama)


def cabut(folder, env):
    """Hasil Claude lebih buruk dari generator: situs dikembalikan, berkasnya disimpan untuk dipelajari."""
    simpan = folder / f"claude.ditolak-{datetime.now().strftime('%Y%m%d-%H%M')}"
    if TAHAP == 'tema':
        simpan.mkdir(parents=True, exist_ok=True)
        cadang = folder / 'claude' / 'kerja' / 'sebelum-tema'
        for nama in BERKAS_TEMA:
            if (folder / 'claude' / nama).is_file():
                shutil.move(str(folder / 'claude' / nama), simpan / nama)
            if (cadang / nama).is_file():
                shutil.copy2(cadang / nama, folder / 'claude' / nama)
    else:
        (folder / 'claude').rename(simpan)
        (folder / 'claude').mkdir()
    _, teks = jalankan_alat(env, 'pasang')
    log('cabut: ' + ' | '.join(b for b in teks.splitlines() if b.startswith(('pasang:', 'fse: halaman', 'cek:')))[:600])
    jalankan_alat(env, 'audit')
    return simpan


def portal_berita(domain):
    berkas = FA.GENERATED_DIR / f'{domain}-tema.json'
    return berkas.is_file() and '"jenis": "berita"' in berkas.read_text()


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    opsi = dict(a[2:].split('=', 1) if '=' in a else (a[2:], '1') for a in sys.argv[1:] if a.startswith('--'))
    if len(args) != 1:
        print(__doc__)
        return 2
    global TAHAP
    TAHAP = opsi.get('tahap') or 'halaman'
    if TAHAP not in TAHAP_TEKS:
        print(f'desain_claude: gagal:tahap_tidak_dikenal:{TAHAP}')
        return 2
    manifest = str(Path(args[0]).resolve())
    cfg = FA.read_manifest(manifest)
    domain = cfg.get('domain', '').lower()
    folder = FA.RENCANA_DIR / domain
    tema = TAHAP == 'tema'
    putaran = int(opsi.get('putaran') or os.environ.get('DESAIN_CLAUDE_PUTARAN') or (5 if tema else 8))
    menit = int(opsi.get('menit') or os.environ.get('DESAIN_CLAUDE_MENIT') or (45 if tema else 90))

    try:
        ref = json.loads((folder / 'desain-referensi.json').read_text())
    except (OSError, ValueError):
        ref = {}
    if not ref.get('url'):
        print(f'{awalan()}: lewati:tanpa_referensi')
        return 0
    if cfg.get('gaya_beranda') and cfg['gaya_beranda'] != 'referensi':
        print(f"{awalan()}: lewati:gaya_beranda_manual:{cfg['gaya_beranda']}")
        return 0
    if portal_berita(domain):
        print(f'{awalan()}: lewati:portal_berita')
        return 0
    if not Path(CLAUDE).exists():
        print(f'{awalan()}: gagal:claude_cli_tidak_ada')
        return 2

    global LOG_DOMAIN
    if not os.environ.get('VELOCITY_RUN_ID'):
        LOG_DOMAIN = STATE / f'{domain}.log'
    env = dict(os.environ, VELOCITY_DESAIN_MANIFEST=manifest, VELOCITY_DOMAIN=domain, VELOCITY_DESAIN_TAHAP=TAHAP)
    # Biaya (keputusan user 2026-09-18): sementara langganan yang login di server ini; kalau berkas
    # API key terpisah sudah ada, agen memakainya (tagihan per token, tidak menghabiskan limit langganan).
    if KUNCI_API.is_file() and KUNCI_API.read_text().strip():
        env['ANTHROPIC_API_KEY'] = KUNCI_API.read_text().strip()
    KUNCI.parent.mkdir(parents=True, exist_ok=True)
    with open(KUNCI, 'w') as kunci:
        batas = time.time() + 3 * 3600
        while True:
            try:
                fcntl.flock(kunci, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.time() > batas:
                    print(f'{awalan()}: lewati:antrean_agen_penuh_3_jam')
                    return 0
                time.sleep(30)

        aktif = AKTIF_DIR / f'{domain}.json'
        AKTIF_DIR.mkdir(parents=True, exist_ok=True)
        aktif.write_text(json.dumps({'pid': os.getpid(), 'domain': domain, 'mulai': datetime.now().astimezone()
                                     .isoformat(timespec='seconds'), 'referensi': ref.get('url'), 'tahap': TAHAP}))
        try:
            return kerja(cfg, domain, folder, env, ref, opsi, putaran, menit)
        finally:
            aktif.unlink(missing_ok=True)


def kerja(cfg, domain, folder, env, ref, opsi, putaran, menit):
    (folder / 'claude').mkdir(parents=True, exist_ok=True)
    try:
        bahan = siapkan(cfg, folder)
    except Exception as e:
        log(f'gagal:bahan:{type(e).__name__}:{e}'[:300], tanpa_waktu=True)
        return 2
    if bahan.get('tema') != FA.SLUG:
        log(f"lewati:tema_aktif_{bahan.get('tema')}", tanpa_waktu=True)
        return 0

    log('audit awal')
    jalankan_alat(env, 'audit')
    awal, d_awal = skor_total(folder)
    if awal is None:
        log(f'gagal:audit_awal', tanpa_waktu=True)
        return 2
    if d_awal.get('sesuai') and 'paksa' not in opsi:
        log(f'lewati:sudah_mirip skor={awal}', tanpa_waktu=True)
        return 0
    (folder / 'claude' / 'kerja' / 'tugas.json').write_text(json.dumps({
        'domain': domain, 'referensi': ref.get('url'), 'skor_awal': d_awal.get('skor'),
        'tahap': TAHAP, 'belum_mirip': d_awal.get('belum_mirip'),
        'ambang': {'header/footer/gaya': AMBANG} if TAHAP == 'tema' else {'header/footer/beranda/gaya': AMBANG, 'halaman_*': 70},
        'maks_putaran': putaran, 'batas_menit': menit}, ensure_ascii=False, indent=1))

    if TAHAP == 'tema':
        simpan_tema_lama(folder)
    log(f'agen mulai (skor awal {awal}, maks {putaran} putaran / {menit} menit)')
    kode, durasi, hasil = jalankan_claude(folder, env, menit, prompt_tugas(cfg, domain, folder, putaran, ref['url'],
                                                                         bool(bahan.get('vd_store'))))
    catat_pemakaian(domain, hasil)
    minta = hasil.get('permintaan_per_model') or {}
    log(f"agen selesai kode={kode} menit={durasi} model={','.join(hasil.get('modelUsage') or minta) or '-'} "
        f"request={sum(minta.values())} biaya_usd={round(float(hasil.get('total_cost_usd') or 0), 2)}")

    # Audit akhir sendiri: jawaban agen tidak dipercaya begitu saja.
    jalankan_alat(env, 'audit')
    akhir, d_akhir = skor_total(folder)
    status = 'sesuai' if d_akhir.get('sesuai') else 'belum_mirip:' + '+'.join(d_akhir.get('belum_mirip') or [])
    if akhir is None or akhir < awal:
        simpan = cabut(folder, env)
        status = f'ditolak_skor_turun (disimpan di {simpan.name})'
    (folder / 'claude' / ('hasil-tema.json' if TAHAP == 'tema' else 'hasil.json')).write_text(json.dumps({
        'tahap': TAHAP,
        'waktu': datetime.now().astimezone().isoformat(timespec='seconds'), 'status': status,
        'skor_awal': d_awal.get('skor'), 'skor_akhir': d_akhir.get('skor'), 'menit': durasi,
        'kode_agen': kode, 'ringkasan_agen': (hasil.get('result') or '')[:4000]}, ensure_ascii=False, indent=1))
    log(f'{status} skor={awal}->{akhir} menit={durasi}', tanpa_waktu=True)
    return 0


if __name__ == '__main__':
    sys.exit(main())
