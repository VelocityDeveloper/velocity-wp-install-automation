#!/usr/bin/env python3
"""Pasang / ganti mode / copot Velocity WAF di satu server hosting (DirectAdmin + LiteSpeed).

  velocity-waf-pasang <server> [--mode deteksi|blokir] [opsi velocity-waf-build…]   pasang/perbarui
  velocity-waf-pasang <server> --copot                                             lepas include (berkas tetap)
  velocity-waf-pasang <server> --status                                            hanya baca status

<server> = nama atau host dari daftar server dashboard (mis. Wulan).

Langkah pasang (di server, lewat `ssh … python3 -`):
 1. Salin /etc/velocity-waf → /etc/velocity-waf.bak-<waktu> (bila ada), tulis berkas baru satu per satu (bukan tar:
    lihat jebakan izin folder), izin 644, folder 755.
 2. /etc/modsecurity.d/velocity-waf.conf = "Include /etc/velocity-waf/velocity-waf.conf" (dimuat LiteSpeed lewat
    loadApacheConf → httpd-modsecurity.conf → IncludeOptional /etc/modsecurity.d/*.conf, berdampingan dengan cPGuard).
 3. Restart LiteSpeed graceful (lswsctrl restart), tunggu, lalu periksa:
    - error.log LiteSpeed sejak restart: tidak ada galat parse yang menyebut velocity-waf;
    - situs pertama di server tetap menjawab (bukan 5xx);
    - request uji ber-UA "sqlmap" ke situs itu tercatat "Velocity WAF" (deteksi) / dijawab 429 (blokir).
 4. Gagal di langkah 3 → include dihapus, berkas lama dikembalikan, LiteSpeed direstart lagi.
"""
import argparse
import json
import sys
from pathlib import Path

AKAR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(AKAR / 'services'))
sys.path.insert(0, str(AKAR / 'scripts'))
import installer_status as ist  # noqa: E402
import velocity_waf  # noqa: E402  (REMOTE, rakit berkas, setelan dashboard)


def server(nama):
    for item in ist.load_servers():
        if isinstance(item, dict):
            s, err = ist.clean_server(item)
            if not err and nama.lower() in (s['name'].lower(), s['host']):
                return s
    raise SystemExit(f'server tidak dikenal: {nama}')


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument('server')
    ap.add_argument('--mode', choices=['deteksi', 'blokir'], default='deteksi')
    ap.add_argument('--copot', action='store_true')
    ap.add_argument('--status', action='store_true')
    ap.add_argument('--tanpa-seo', action='store_true')
    ap.add_argument('--tanpa-ai', action='store_true')
    ap.add_argument('--perplexity', choices=['blokir', 'catat'])
    ap.add_argument('--oai-maks', type=int)
    a = ap.parse_args()
    s = server(a.server)
    perintah = {'aksi': 'status' if a.status else 'copot' if a.copot else 'pasang', 'mode': a.mode}
    if perintah['aksi'] == 'pasang':
        # Setelan dashboard (Server > WAF > Setelan) sebagai dasar; opsi baris perintah menimpa
        setelan = velocity_waf.baca_setelan()
        setelan.update({k: v for k, v in (('seo', False if a.tanpa_seo else None), ('ai', False if a.tanpa_ai else None),
                                           ('perplexity', a.perplexity), ('oai_maks', a.oai_maks)) if v is not None})
        perintah['berkas'], _, _ = velocity_waf.rakit_berkas(a.mode, setelan)
    hasil = velocity_waf.jalankan(s, ist.ssh_key_file(), perintah)
    print(json.dumps(hasil, indent=2, ensure_ascii=False))
    sys.exit(0 if hasil.get('ok') else 1)


if __name__ == '__main__':
    main()
