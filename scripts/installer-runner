#!/usr/bin/env bash
set -Eeuo pipefail
DOMAIN=${1:?domain_required}
# dry-run | apply | finish (rapikan ulang situs terpasang: konten, aset klien,
# pemeriksaan — tanpa memasang ulang WordPress dan tanpa notifikasi) |
# maintenance (hanya nyalakan maintenance mode untuk situs terpasang) |
# child-theme (hanya pasang/aktifkan tema desain custom di situs terpasang) |
# audit (periksa situs terpasang dari dalam; tidak mengubah apa pun)
MODE=${INSTALL_MODE:-dry-run}
ROOT=/home/project
SCRIPTS=/opt/velocity-wp-install-automation/scripts
MANIFEST="$ROOT/$DOMAIN/$DOMAIN.txt"
# Berapa kali langkah tema FSE boleh diulang saat hasilnya belum sesuai referensi.
FSE_CEK_MAKS=${FSE_CEK_MAKS:-3}
# Berapa kali tema + halaman FSE boleh digenerate (termasuk yang pertama) selama tampilan
# situs jadi belum mirip referensi menurut audit kemiripan.
FSE_MIRIP_MAKS=${FSE_MIRIP_MAKS:-3}
STATE_DIR=/var/lib/velocity/installer
STATE="$STATE_DIR/$DOMAIN.json"
LOG="$STATE_DIR/$DOMAIN.log"
# Pencatatan token AI (/var/lib/velocity/ai/usage.jsonl): semua script AI di run ini
# tercatat atas domain & run yang sama.
export VELOCITY_DOMAIN="$DOMAIN"
export VELOCITY_RUN_ID="${VELOCITY_RUN_ID:-$(date +%Y%m%d-%H%M%S)-$MODE}"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

state() {
  python3 - "$STATE" "$DOMAIN" "$1" "$2" <<'PY'
import json, os, sys, tempfile
path, domain, status, stage = sys.argv[1:]
data={'domain':domain,'status':status,'stage':stage,'message':stage,'updated_at':__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat()}
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(path)); os.close(fd)
with open(tmp,'w') as f: json.dump(data,f,separators=(',',':'))
os.chmod(tmp,0o600); os.replace(tmp,path)
PY
  printf '[%s] %s: %s\n' "$(date -Is)" "$1" "$2" >> "$LOG"
}
notify() {
  # Notifikasi tidak boleh menggagalkan instalasi.
  [[ "$MODE" == "apply" ]] || return 0
  /usr/bin/python3 "$SCRIPTS/notify-telegram.py" "$DOMAIN" "$1" "${2:-}" >> "$LOG" 2>&1 || true
}
# Mode child-theme hanya menambah tema desain ke situs yang sudah jadi: status
# instalasi (COMPLETE) tidak boleh ikut berubah karenanya.
paket_desain_custom() {
  [[ -f "$MANIFEST" ]] || return 1
  local paket
  paket=$(sed -n 's/^paket=//p' "$MANIFEST" | head -1 | tr '[:upper:]' '[:lower:]' | tr -d ' ')
  # Paket Portal Berita Custom juga desain custom (keputusan user 2026-09-14);
  # tampilannya varian berita dari template yang sama. Paket Toko Online Custom ikut
  # jalur FSE sejak 2026-09-15 (produk dari VD Store).
  [[ "$paket" == "paketg" || "$paket" == "paketportalberitacustom" || "$paket" == "pakettokoonlinecustom" ]]
}
# Masa pembelajaran tanpa maintenance hanya Paket G & Portal Berita Custom (keputusan
# user 2026-09-13/14). Toko Online Custom tetap ditutup maintenance seperti paket toko lain.
paket_masa_pembelajaran() {
  paket_desain_custom && ! grep -qiE '^paket=.*toko *online' "$MANIFEST"
}

# Jalur tema paket desain custom. Keputusan user 2026-09-15: HANYA FSE — block
# theme velocity-fse (scripts/fse-apply); jalur child theme klasik sudah dibuang.
# Situs lama yang child theme klasiknya masih aktif tidak disentuh (lewati) sampai
# manifest-nya diberi tema_desain=fse.
#   fse | lewati (block theme buatan tangan / child klasik lama) | gagal (situs tak terbaca)
JALUR_TEMA=""
jalur_tema() {
  JALUR_TEMA=$(/usr/bin/python3 "$SCRIPTS/fse-apply" --deteksi "$MANIFEST" 2>>"$LOG" | tail -1 || true)
  printf '[%s] Jalur tema: %s\n' "$(date -Is)" "${JALUR_TEMA:-gagal}" >> "$LOG"
}
portal_berita() {
  grep -q '"jenis": *"berita"' "/var/lib/velocity/ai/generated/$DOMAIN-tema.json" 2>/dev/null
}

# Alur paket desain custom (Paket G, Portal Berita Custom, Toko Online Custom), disepakati
# user 2026-09-13/14/15. Urutan adalah bagian dari kebenaran:
#   paket_g_tema  0. referensi_desain   cek isian website referensi di FORM ISIAN; kalau ada,
#                                       tata letak & gaya referensi diukur = acuan utama FSE
#                 1. compro-klien       baca company profile PDF
#                 2. paket-g-konten     isi contoh (perusahaan atau portal berita)
#                 3. fse-apply --tema   pasang tema FSE, data situs, palet, rubrik
#   (konten AI & site-finish di mode apply/finish berjalan DI ANTARA keduanya:
#    generator artikel membaca layanan/rubrik dari tema yang sudah terpasang —
#    di situs lama tanpa tema desain, urutan terbalik membuat artikel tetap "Blog")
#   paket_g_isi   4. paket-g-foto       foto per slot desain perusahaan (hero, tentang, layanan, galeri)
#                 4b. fse-dealer        situs dealer mobil: unit CPT mobil + foto seksi (gaya_beranda=dealer)
#                 5. fse-apply --isi    halaman berupa blok + menu (SESUDAH site-finish)
#                 6. paket-g-foto       foto utama artikel portal berita
#                 7. paket-g-cek-visual screenshot desktop/HP untuk dicek mata
#                 8. fse-audit-kemiripan tampilan situs jadi vs referensi, per bagian & per seksi
#                                       (header, footer, beranda, gaya, halaman dalam); belum mirip
#                                       -> generate ulang tema + halaman FSE lalu audit lagi
#                                       (audit_kemiripan, maks FSE_MIRIP_MAKS)
paket_g_tema() {
  # Keputusan user 2026-09-15: setelah paket dicek, periksa desain referensi di form. Hasilnya
  # (fse-rencana/<domain>/desain-referensi.json) dibaca fse-apply --tema & --isi.
  printf '[%s] Paket custom: cek referensi desain di form\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/referensi_desain.py" "$MANIFEST" >> "$LOG" 2>&1 || true
  printf '[%s] Paket custom: company profile & isi contoh\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/compro-klien" "$DOMAIN" >> "$LOG" 2>&1 || true
  /usr/bin/python3 "$SCRIPTS/paket-g-konten" "$MANIFEST" >> "$LOG" 2>&1 || true
  if [[ "$JALUR_TEMA" != fse ]]; then
    printf '[%s] Paket custom: tema dilewati (jalur=%s)\n' "$(date -Is)" "${JALUR_TEMA:-gagal}" >> "$LOG"
    return 0
  fi
  printf '[%s] Paket custom: tema FSE (velocity-fse)\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/fse-apply" --tema "$MANIFEST" >> "$LOG" 2>&1
  cek_tema_referensi
}

# Gerbang sebelum konten AI (keputusan user 2026-09-16): hasil langkah tema dibandingkan
# dengan rencana referensi desain klien (tema & versinya, gaya beranda, font, token
# header/footer/tombol/kartu, palet). Belum sesuai -> langkah tema diulang; sesuai ->
# alur lanjut ke konten AI. Tidak pernah menggagalkan instalasi: sesudah FSE_CEK_MAKS
# percobaan alur tetap lanjut dengan catatan, dan situs tanpa referensi langsung lolos.
cek_tema_referensi() {
  local percobaan=1 kode
  while :; do
    /usr/bin/python3 "$SCRIPTS/fse-cek-referensi" "$MANIFEST" >> "$LOG" 2>&1 && kode=0 || kode=$?
    if [[ "$kode" == 0 ]]; then
      return 0
    fi
    if [[ "$kode" != 1 ]]; then
      printf '[%s] fse_cek: tidak bisa diperiksa (kode %s), lanjut\n' "$(date -Is)" "$kode" >> "$LOG"
      return 0
    fi
    if (( percobaan >= FSE_CEK_MAKS )); then
      printf '[%s] fse_cek: masih belum sesuai setelah %s percobaan, lanjut ke konten AI\n' \
        "$(date -Is)" "$percobaan" >> "$LOG"
      return 0
    fi
    percobaan=$(( percobaan + 1 ))
    printf '[%s] Paket custom: tema FSE diulang (percobaan %s)\n' "$(date -Is)" "$percobaan" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/fse-apply" --tema "$MANIFEST" >> "$LOG" 2>&1 || true
  done
}
# Paket biasa (child theme klasik): beranda dari template child theme, halaman Layanan, blok
# kontak, widget sidebar/footer, CSS (scripts/theme-paket-biasa), lalu foto utama artikel. Harus
# SESUDAH site-finish: finishing menulis halaman Hubungi Kami (peta) dan CSS warna.
tampilan_klasik() {
  echo "[$(date -Is)] Tampilan tema klasik" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/theme-paket-biasa" "$MANIFEST" >> "$LOG" 2>&1 || true
  if ! portal_berita; then
    echo "[$(date -Is)] Foto utama artikel" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/paket-g-foto" --artikel "$MANIFEST" >> "$LOG" 2>&1 || true
    # Sisa artikel tanpa foto bank yang layak: foto klien bergilir atau sampul kategori.
    /usr/bin/python3 "$SCRIPTS/theme-paket-biasa" --foto-artikel "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
}
paket_g_isi() {
  [[ "$JALUR_TEMA" == fse ]] || return 0
  if ! portal_berita; then
    # Beranda perusahaan bergaya referensi memuat URL foto slot: foto harus ada SEBELUM halaman disusun.
    printf '[%s] Paket custom: foto per slot desain\n' "$(date -Is)" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/paket-g-foto" "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  # Situs dealer mobil: unit (CPT mobil) + foto seksinya harus ada SEBELUM beranda disusun,
  # karena kartu model unit dibaca dari CPT dan seksi beranda memuat URL foto slot.
  if grep -q '^gaya_beranda=dealer' "$MANIFEST" 2>/dev/null; then
    printf '[%s] Paket custom: unit mobil & foto dealer\n' "$(date -Is)" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/fse-dealer" "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  # Gaya klinik: foto seksi dari mockup desain klien (fse-klinik/<domain>/foto) masuk slot
  # sebelum beranda disusun, sama alasannya dengan dealer.
  if grep -q '^gaya_beranda=klinik' "$MANIFEST" 2>/dev/null; then
    printf '[%s] Paket custom: foto seksi klinik\n' "$(date -Is)" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/fse-klinik" "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  printf '[%s] Paket custom: halaman blok & menu (FSE)\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/fse-apply" --isi "$MANIFEST" >> "$LOG" 2>&1 || true
  # Foto utama artikel (ber-caption kredit foto): portal berita dan situs perusahaan.
  printf '[%s] Paket custom: foto utama artikel\n' "$(date -Is)" >> "$LOG"
  if portal_berita; then
    /usr/bin/python3 "$SCRIPTS/paket-g-foto" "$MANIFEST" >> "$LOG" 2>&1 || true
  else
    /usr/bin/python3 "$SCRIPTS/paket-g-foto" --artikel "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  # Sisa artikel tanpa foto (Pexels & bank foto tak memberi yang layak / API gagal): foto klien
  # bergilir atau sampul kategori, sama seperti paket biasa — tiap artikel pasti berfoto utama.
  /usr/bin/python3 "$SCRIPTS/theme-paket-biasa" --foto-artikel "$MANIFEST" >> "$LOG" 2>&1 || true
  printf '[%s] Paket custom: cek visual\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/paket-g-cek-visual" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Permintaan user 2026-09-17: pastikan desain yang dibuat mirip referensi yang diminta,
  # dicek detail per seksi (terutama header, footer, beranda). Tidak menggagalkan instalasi:
  # hasil belum mirip ikut dilaporkan sebagai "perlu dicek" (lihat masalah_kemiripan).
  audit_kemiripan
}

# Permintaan user 2026-09-17: desain yang belum mirip referensi digenerate ulang, dan yang
# perlu diperbaiki dikirim di laporan. Setiap putaran: audit -> belum mirip -> fse-apply
# --tema (+ gerbang token) -> fse-apply --isi -> audit lagi. Berhenti kalau sudah mirip,
# FSE_MIRIP_MAKS tercapai, atau skor tidak naik (generator deterministik: input yang sama
# menghasilkan desain yang sama, jadi putaran berikutnya tidak akan mengubah apa pun —
# sisa beda harus diperbaiki di kode/tema, dan daftarnya ikut laporan Telegram).
# Halaman yang sudah disunting orang tidak ditimpa (md5 di fse-apply).
skor_kemiripan() {
  python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
s = d.get("skor") or {}
print(sum(int(s.get(k, 0)) for k in ("header", "footer", "beranda")))' \
    "/var/lib/velocity/fse-rencana/$DOMAIN/audit-kemiripan.json" 2>/dev/null || echo 0
}
audit_kemiripan() {
  local percobaan=1 kode skor skor_lalu=-1
  while :; do
    printf '[%s] Paket custom: audit kemiripan desain vs referensi (percobaan %s)\n' "$(date -Is)" "$percobaan" >> "$LOG"
    VELOCITY_KEMIRIPAN_PERCOBAAN=$percobaan /usr/bin/python3 "$SCRIPTS/fse-audit-kemiripan" "$MANIFEST" >> "$LOG" 2>&1 \
      && kode=0 || kode=$?
    # 0 mirip / tanpa referensi, 2 tidak bisa diperiksa: tidak ada yang bisa diulang.
    [[ "$kode" == 1 ]] || return 0
    skor=$(skor_kemiripan)
    if (( percobaan >= FSE_MIRIP_MAKS )); then
      printf '[%s] kemiripan_ulang: masih belum mirip setelah %s kali generate, dilaporkan\n' \
        "$(date -Is)" "$percobaan" >> "$LOG"
      return 0
    fi
    if (( skor <= skor_lalu )); then
      printf '[%s] kemiripan_ulang: skor tidak naik (%s), generate ulang dihentikan, dilaporkan\n' \
        "$(date -Is)" "$skor" >> "$LOG"
      return 0
    fi
    skor_lalu=$skor
    percobaan=$(( percobaan + 1 ))
    printf '[%s] Paket custom: desain belum mirip, tema & halaman FSE digenerate ulang (percobaan %s)\n' \
      "$(date -Is)" "$percobaan" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/fse-apply" --tema "$MANIFEST" >> "$LOG" 2>&1 || true
    cek_tema_referensi
    /usr/bin/python3 "$SCRIPTS/fse-apply" --isi "$MANIFEST" >> "$LOG" 2>&1 || true
  done
}

# Bagian yang belum mirip referensi dari audit run ini (kosong kalau mirip/tanpa referensi).
masalah_kemiripan() {
  local berkas="/var/lib/velocity/fse-rencana/$DOMAIN/audit-kemiripan.json"
  [[ -f "$berkas" && "$berkas" -nt "$LOG_AWAL_RUN" ]] || return 0
  python3 -c 'import json, sys
d = json.load(open(sys.argv[1]))
if not d.get("sesuai") and d.get("belum_mirip"):
    print("desain_belum_mirip_referensi:" + "+".join(d["belum_mirip"]))' "$berkas" 2>/dev/null || true
}

# Situs yang sudah dipindah ke block theme buatan tangan (birutourtravel.com,
# layananhipnoterapi.com) dikelola lewat Site Editor: apply/finish/child-theme akan
# menulis ulang tema & isi halamannya. Tandai dengan `tema_fse=<slug>` di manifest.
# Audit tetap boleh karena hanya membaca. (Tema FSE installer, velocity-fse, tidak
# memakai penanda ini.)
if [[ "$MODE" != "audit" && -f "$MANIFEST" ]] && grep -q '^tema_fse=' "$MANIFEST"; then
  printf '[%s] %s dilewati: situs memakai block theme (%s)\n' "$(date -Is)" "$MODE" \
    "$(sed -n 's/^tema_fse=//p' "$MANIFEST" | head -1)" >> "$LOG"
  exit 0
fi

# Audit hanya membaca: status instalasi & notifikasi tidak disentuh.
if [[ "$MODE" == "audit" ]]; then
  [[ -f "$MANIFEST" ]] || { printf '[%s] audit: manifest_missing\n' "$(date -Is)" >> "$LOG"; exit 2; }
  printf '[%s] Audit situs\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/site-audit" "$MANIFEST" >> "$LOG" 2>&1
  exit $?
fi

if [[ "$MODE" == "child-theme" ]]; then
  [[ -f "$MANIFEST" ]] || { printf '[%s] child_theme: manifest_missing\n' "$(date -Is)" >> "$LOG"; exit 2; }
  printf '[%s] Tema desain\n' "$(date -Is)" >> "$LOG"
  if paket_desain_custom; then
    jalur_tema
    paket_g_tema
    rc=$?
    # Artikel per layanan/rubrik dari tema yang baru terpasang; konten tersimpan
    # dipakai ulang, jadi hanya yang belum ada yang dibuat.
    INSTALL_MODE=apply /usr/bin/python3 "$SCRIPTS/ai-content-generator.py" "$MANIFEST" >> "$LOG" 2>&1 || true
    paket_g_isi
  else
    /usr/bin/python3 "$SCRIPTS/child-theme-apply" "$MANIFEST" >> "$LOG" 2>&1 && rc=0 || rc=$?
    /usr/bin/python3 "$SCRIPTS/paket-g-konten" "$MANIFEST" >> "$LOG" 2>&1 || true
    tampilan_klasik
  fi
  exit $rc
fi

trap 'state FAILED "installer_error"; notify FAILED installer_error' ERR
state RUNNING VALIDATING
# Dibaca bagan alur halaman /installer/: cabang mode run & paket tanpa menebak dari penanda log.
printf '[%s] Mode run: %s | paket: %s\n' "$(date -Is)" "$MODE" \
  "$(sed -n 's/^paket=//p' "$MANIFEST" 2>/dev/null | head -1 || true)" >> "$LOG"
[[ -f "$MANIFEST" ]] || { state FAILED manifest_missing; notify FAILED manifest_missing; exit 2; }
state RUNNING RUNNING_INSTALLER
# Awal log run ini: dipakai untuk tahu apakah run ini memasang WordPress dari awal.
run_start=$(( $(wc -l < "$LOG") + 1 ))
# Penanda waktu awal run: hasil audit yang lebih tua dari ini bukan milik run ini.
LOG_AWAL_RUN=$(mktemp /tmp/velocity-run.XXXXXX)
trap 'rm -f "$LOG_AWAL_RUN"' EXIT
if [[ "$MODE" != "finish" && "$MODE" != "maintenance" ]]; then
  INSTALL_MODE="$MODE" MANIFEST="$MANIFEST" "$SCRIPTS/website-install-from-manifest" >> "$LOG" 2>&1
fi
problems=""
if [[ "$MODE" == "apply" || "$MODE" == "finish" ]]; then
  # Sukses di server belum tentu situsnya bisa dibuka: 2026-09-11 dua situs lolos
  # sebagai COMPLETE padahal semua URL 404. File statis inti WordPress ini selalu
  # ada dan dilayani webserver langsung, tanpa bergantung tema/plugin.
  code=$(curl -sk -o /dev/null -m 30 -L --max-redirs 3 -w '%{http_code}' \
    "https://$DOMAIN/wp-includes/css/dashicons.min.css" || true)
  printf '[%s] http_check: %s\n' "$(date -Is)" "$code" >> "$LOG"
  if [[ "$code" != 200 ]]; then
    state FAILED "http_check_$code"
    notify FAILED "http_check_$code"
    exit 4
  fi
  # Generator memakai ulang konten tersimpan saat apply ulang, jadi aman
  # dijalankan lagi tanpa biaya AI dan tanpa menggandakan artikel. Mode finish
  # menimpa ulang halaman target dengan konten yang sudah dibersihkan.
  refresh=0
  [[ "$MODE" == "finish" ]] && refresh=1
  # Paket desain custom: referensi desain dibaca & diukur dulu, baru tema FSE (lihat paket_g_tema).
  if paket_desain_custom; then
    jalur_tema
    paket_g_tema || true
  fi
  # Paket toko online: plugin VD Store SESUDAH tema (keputusan user 2026-09-16). Toko Online Custom
  # memakai tema FSE yang disusun dari referensi desain, jadi urutannya referensi -> tema -> plugin
  # toko; toko online biasa tidak punya langkah tema di sini sehingga urutannya tidak berubah.
  # Aman dibalik: fse-apply tidak memanggil WP-CLI dan membaca jenis paket dari manifest, bukan
  # dari produk/plugin di database. WordPress awal tetap hanya memasang core; setting toko bukan
  # bagian website-install-from-manifest.
  echo "[$(date -Is)] VD Store" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/vd-store" "$MANIFEST" >> "$LOG" 2>&1 || true
  echo "[$(date -Is)] VD Store settings (sesudah plugin/API)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/vd-store-settings" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Paket biasa (child theme klasik): isi contoh terstruktur dulu — layanannya jadi kategori
  # artikel dan isi beranda/Layanan di langkah tampilan (permintaan user 2026-09-17).
  if ! paket_desain_custom; then
    echo "[$(date -Is)] Isi contoh (tema klasik)" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/paket-g-konten" "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  echo "[$(date -Is)] Starting AI content generation" >> "$LOG"
  INSTALL_MODE=apply VELOCITY_CONTENT_REFRESH=$refresh /usr/bin/python3 "$SCRIPTS/ai-content-generator.py" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Tembolok compro: murah kalau sudah pernah dibaca, perlu untuk situs lama (mode finish).
  /usr/bin/python3 "$SCRIPTS/compro-klien" "$DOMAIN" >> "$LOG" 2>&1 || true
  echo "[$(date -Is)] Finishing: aset & pengaturan dari data klien" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/site-finish" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Hapus tema & plugin bawaan yang tidak dipakai — hanya kalau run ini memasang
  # WordPress dari awal; apply ulang situs lama tidak menyentuh isinya. Sebelum
  # QA, supaya kerusakan akibat penghapusan ikut tertangkap.
  if [[ "$MODE" == "apply" ]] && grep -q 'Success: WordPress installed successfully' <(tail -n +"$run_start" "$LOG"); then
    echo "[$(date -Is)] Bersihkan tema & plugin bawaan" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --cleanup "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  # Paket berdesain custom: halaman, menu, foto, cek visual. Harus SESUDAH
  # site-finish — finishing menulis ulang halaman Galeri & Hubungi Kami (galeri +
  # peta), yang akan hilang kalau urutannya dibalik. Detail di paket_g_isi.
  if paket_desain_custom; then
    paket_g_isi || true
  else
    tampilan_klasik
  fi
  qa=$(/usr/bin/python3 "$SCRIPTS/site-qa" "$DOMAIN" 2>>"$LOG" | tail -1 || true)
  echo "qa_result: $qa" >> "$LOG"
  problems=$(python3 -c 'import json, sys
try:
    print(",".join(json.loads(sys.argv[1]).get("problems", [])))
except Exception:
    print("qa_gagal_dijalankan")' "$qa")
  if paket_desain_custom; then
    mirip=$(masalah_kemiripan)
    if [[ -n "$mirip" ]]; then
      problems="${problems:+$problems,}$mirip"
    fi
  fi
fi
if [[ "$MODE" == "apply" || "$MODE" == "maintenance" ]]; then
  # Langkah terakhir: tutup situs dengan maintenance mode velocity-addons sampai PM
  # menyerahkannya ke klien. Sesudah QA, karena QA membaca situs sebagai pengunjung.
  #
  # Paket G sedang dalam masa pembelajaran (keputusan user 2026-09-13): situsnya
  # dibiarkan terbuka supaya hasil otomatisasi mudah dipantau langsung. Nyalakan
  # lagi dengan PAKET_G_MAINTENANCE=1 (mis. di /etc/velocity/installer-autopilot.env).
  if paket_masa_pembelajaran && [[ "${PAKET_G_MAINTENANCE:-0}" != 1 ]]; then
    echo "[$(date -Is)] maintenance: maintenance_dilewati:paket_g_masa_pembelajaran" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --tandai-tanpa-maintenance "$MANIFEST" >> "$LOG" 2>&1 || true
  else
    echo "[$(date -Is)] Maintenance mode" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --maintenance "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
fi
if [[ "$MODE" == "dry-run" ]]; then
  state SUCCESS DRY_RUN_OK
else
  # Stage tetap COMPLETE (situs terpasang; antrean & autopilot memakainya).
  # Temuan pemeriksaan akhir dilaporkan terpisah sebagai "perlu dicek".
  state SUCCESS COMPLETE
  if [[ -n "$problems" ]]; then
    notify CHECK "$problems"
  else
    notify SUCCESS COMPLETE
  fi
fi
