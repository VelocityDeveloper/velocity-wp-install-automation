#!/usr/bin/env bash
set -Eeuo pipefail
DOMAIN=${1:?domain_required}
# dry-run | apply | finish (rapikan ulang situs terpasang: konten, aset klien,
# pemeriksaan — tanpa memasang ulang WordPress dan tanpa notifikasi) |
# maintenance (hanya nyalakan maintenance mode untuk situs terpasang) |
# child-theme (hanya pasang/aktifkan tema desain custom di situs terpasang) |
# audit (periksa situs terpasang dari dalam; tidak mengubah apa pun)
MODE=${INSTALL_MODE:-dry-run}
ROOT=/home/project
SCRIPTS=/opt/velocity-wp-install-automation/scripts
MANIFEST="$ROOT/$DOMAIN/$DOMAIN.txt"
STATE_DIR=/var/lib/velocity/installer
STATE="$STATE_DIR/$DOMAIN.json"
LOG="$STATE_DIR/$DOMAIN.log"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

state() {
  python3 - "$STATE" "$DOMAIN" "$1" "$2" <<'PY'
import json, os, sys, tempfile
path, domain, status, stage = sys.argv[1:]
data={'domain':domain,'status':status,'stage':stage,'message':stage,'updated_at':__import__('datetime').datetime.now(__import__('datetime').timezone.utc).isoformat()}
fd,tmp=tempfile.mkstemp(dir=os.path.dirname(path)); os.close(fd)
with open(tmp,'w') as f: json.dump(data,f,separators=(',',':'))
os.chmod(tmp,0o600); os.replace(tmp,path)
PY
  printf '[%s] %s: %s\n' "$(date -Is)" "$1" "$2" >> "$LOG"
}
notify() {
  # Notifikasi tidak boleh menggagalkan instalasi.
  [[ "$MODE" == "apply" ]] || return 0
  /usr/bin/python3 "$SCRIPTS/notify-telegram.py" "$DOMAIN" "$1" "${2:-}" >> "$LOG" 2>&1 || true
}
# Mode child-theme hanya menambah tema desain ke situs yang sudah jadi: status
# instalasi (COMPLETE) tidak boleh ikut berubah karenanya.
paket_desain_custom() {
  [[ -f "$MANIFEST" ]] || return 1
  local paket
  paket=$(sed -n 's/^paket=//p' "$MANIFEST" | head -1 | tr '[:upper:]' '[:lower:]' | tr -d ' ')
  # Paket Portal Berita Custom juga desain custom (keputusan user 2026-09-14);
  # tampilannya varian berita dari template yang sama.
  [[ "$paket" == "paketg" || "$paket" == "paketportalberitacustom" ]]
}

# Jalur tema paket desain custom. Keputusan user 2026-09-15: HANYA FSE — block
# theme velocity-fse (scripts/fse-apply); jalur child theme klasik sudah dibuang.
# Situs lama yang child theme klasiknya masih aktif tidak disentuh (lewati) sampai
# manifest-nya diberi tema_desain=fse.
#   fse | lewati (block theme buatan tangan / child klasik lama) | gagal (situs tak terbaca)
JALUR_TEMA=""
jalur_tema() {
  JALUR_TEMA=$(/usr/bin/python3 "$SCRIPTS/fse-apply" --deteksi "$MANIFEST" 2>>"$LOG" | tail -1 || true)
  printf '[%s] Jalur tema: %s\n' "$(date -Is)" "${JALUR_TEMA:-gagal}" >> "$LOG"
}
portal_berita() {
  grep -q '"jenis": *"berita"' "/var/lib/velocity/ai/generated/$DOMAIN-tema.json" 2>/dev/null
}

# Alur paket desain custom (Paket G & Portal Berita Custom), disepakati user
# 2026-09-13/14. Urutan adalah bagian dari kebenaran:
#   paket_g_tema  1. compro-klien       baca company profile PDF
#                 2. paket-g-konten     isi contoh (perusahaan atau portal berita)
#                 3. fse-apply --tema   pasang tema FSE, data situs, palet, rubrik
#   (konten AI & site-finish di mode apply/finish berjalan DI ANTARA keduanya:
#    generator artikel membaca layanan/rubrik dari tema yang sudah terpasang —
#    di situs lama tanpa tema desain, urutan terbalik membuat artikel tetap "Blog")
#   paket_g_isi   4. fse-apply --isi    halaman berupa blok + menu (SESUDAH site-finish)
#                 5. paket-g-foto       foto utama artikel portal berita
#                 6. paket-g-cek-visual screenshot desktop/HP untuk dicek mata
paket_g_tema() {
  printf '[%s] Paket custom: company profile & isi contoh\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/compro-klien" "$DOMAIN" >> "$LOG" 2>&1 || true
  /usr/bin/python3 "$SCRIPTS/paket-g-konten" "$MANIFEST" >> "$LOG" 2>&1 || true
  if [[ "$JALUR_TEMA" != fse ]]; then
    printf '[%s] Paket custom: tema dilewati (jalur=%s)\n' "$(date -Is)" "${JALUR_TEMA:-gagal}" >> "$LOG"
    return 0
  fi
  printf '[%s] Paket custom: tema FSE (velocity-fse)\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/fse-apply" --tema "$MANIFEST" >> "$LOG" 2>&1
}
paket_g_isi() {
  [[ "$JALUR_TEMA" == fse ]] || return 0
  printf '[%s] Paket custom: halaman blok & menu (FSE)\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/fse-apply" --isi "$MANIFEST" >> "$LOG" 2>&1 || true
  if portal_berita; then
    printf '[%s] Paket custom: foto utama artikel\n' "$(date -Is)" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/paket-g-foto" "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  printf '[%s] Paket custom: cek visual\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/paket-g-cek-visual" "$MANIFEST" >> "$LOG" 2>&1 || true
}

# Situs yang sudah dipindah ke block theme buatan tangan (birutourtravel.com,
# layananhipnoterapi.com) dikelola lewat Site Editor: apply/finish/child-theme akan
# menulis ulang tema & isi halamannya. Tandai dengan `tema_fse=<slug>` di manifest.
# Audit tetap boleh karena hanya membaca. (Tema FSE installer, velocity-fse, tidak
# memakai penanda ini.)
if [[ "$MODE" != "audit" && -f "$MANIFEST" ]] && grep -q '^tema_fse=' "$MANIFEST"; then
  printf '[%s] %s dilewati: situs memakai block theme (%s)\n' "$(date -Is)" "$MODE" \
    "$(sed -n 's/^tema_fse=//p' "$MANIFEST" | head -1)" >> "$LOG"
  exit 0
fi

# Audit hanya membaca: status instalasi & notifikasi tidak disentuh.
if [[ "$MODE" == "audit" ]]; then
  [[ -f "$MANIFEST" ]] || { printf '[%s] audit: manifest_missing\n' "$(date -Is)" >> "$LOG"; exit 2; }
  printf '[%s] Audit situs\n' "$(date -Is)" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/site-audit" "$MANIFEST" >> "$LOG" 2>&1
  exit $?
fi

if [[ "$MODE" == "child-theme" ]]; then
  [[ -f "$MANIFEST" ]] || { printf '[%s] child_theme: manifest_missing\n' "$(date -Is)" >> "$LOG"; exit 2; }
  printf '[%s] Tema desain\n' "$(date -Is)" >> "$LOG"
  if paket_desain_custom; then
    jalur_tema
    paket_g_tema
    rc=$?
    # Artikel per layanan/rubrik dari tema yang baru terpasang; konten tersimpan
    # dipakai ulang, jadi hanya yang belum ada yang dibuat.
    INSTALL_MODE=apply /usr/bin/python3 "$SCRIPTS/ai-content-generator.py" "$MANIFEST" >> "$LOG" 2>&1 || true
    paket_g_isi
  else
    /usr/bin/python3 "$SCRIPTS/child-theme-apply" "$MANIFEST" >> "$LOG" 2>&1
    rc=$?
  fi
  exit $rc
fi

trap 'state FAILED "installer_error"; notify FAILED installer_error' ERR
state RUNNING VALIDATING
[[ -f "$MANIFEST" ]] || { state FAILED manifest_missing; notify FAILED manifest_missing; exit 2; }
state RUNNING RUNNING_INSTALLER
# Awal log run ini: dipakai untuk tahu apakah run ini memasang WordPress dari awal.
run_start=$(( $(wc -l < "$LOG") + 1 ))
if [[ "$MODE" != "finish" && "$MODE" != "maintenance" ]]; then
  INSTALL_MODE="$MODE" MANIFEST="$MANIFEST" "$SCRIPTS/website-install-from-manifest" >> "$LOG" 2>&1
fi
problems=""
if [[ "$MODE" == "apply" || "$MODE" == "finish" ]]; then
  # Sukses di server belum tentu situsnya bisa dibuka: 2026-09-11 dua situs lolos
  # sebagai COMPLETE padahal semua URL 404. File statis inti WordPress ini selalu
  # ada dan dilayani webserver langsung, tanpa bergantung tema/plugin.
  code=$(curl -sk -o /dev/null -m 30 -L --max-redirs 3 -w '%{http_code}' \
    "https://$DOMAIN/wp-includes/css/dashicons.min.css" || true)
  printf '[%s] http_check: %s\n' "$(date -Is)" "$code" >> "$LOG"
  if [[ "$code" != 200 ]]; then
    state FAILED "http_check_$code"
    notify FAILED "http_check_$code"
    exit 4
  fi
  # Generator memakai ulang konten tersimpan saat apply ulang, jadi aman
  # dijalankan lagi tanpa biaya AI dan tanpa menggandakan artikel. Mode finish
  # menimpa ulang halaman target dengan konten yang sudah dibersihkan.
  refresh=0
  [[ "$MODE" == "finish" ]] && refresh=1
  # Paket desain custom: tema dipasang/diperbarui dulu (lihat paket_g_tema).
  if paket_desain_custom; then
    jalur_tema
    paket_g_tema || true
  fi
  echo "[$(date -Is)] Starting AI content generation" >> "$LOG"
  INSTALL_MODE=apply VELOCITY_CONTENT_REFRESH=$refresh /usr/bin/python3 "$SCRIPTS/ai-content-generator.py" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Tembolok compro: murah kalau sudah pernah dibaca, perlu untuk situs lama (mode finish).
  /usr/bin/python3 "$SCRIPTS/compro-klien" "$DOMAIN" >> "$LOG" 2>&1 || true
  echo "[$(date -Is)] Finishing: aset & pengaturan dari data klien" >> "$LOG"
  /usr/bin/python3 "$SCRIPTS/site-finish" "$MANIFEST" >> "$LOG" 2>&1 || true
  # Hapus tema & plugin bawaan yang tidak dipakai — hanya kalau run ini memasang
  # WordPress dari awal; apply ulang situs lama tidak menyentuh isinya. Sebelum
  # QA, supaya kerusakan akibat penghapusan ikut tertangkap.
  if [[ "$MODE" == "apply" ]] && grep -q 'Success: WordPress installed successfully' <(tail -n +"$run_start" "$LOG"); then
    echo "[$(date -Is)] Bersihkan tema & plugin bawaan" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --cleanup "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
  # Paket berdesain custom: halaman, menu, foto, cek visual. Harus SESUDAH
  # site-finish — finishing menulis ulang halaman Galeri & Hubungi Kami (galeri +
  # peta), yang akan hilang kalau urutannya dibalik. Detail di paket_g_isi.
  if paket_desain_custom; then
    paket_g_isi || true
  fi
  qa=$(/usr/bin/python3 "$SCRIPTS/site-qa" "$DOMAIN" 2>>"$LOG" | tail -1 || true)
  echo "qa_result: $qa" >> "$LOG"
  problems=$(python3 -c 'import json, sys
try:
    print(",".join(json.loads(sys.argv[1]).get("problems", [])))
except Exception:
    print("qa_gagal_dijalankan")' "$qa")
fi
if [[ "$MODE" == "apply" || "$MODE" == "maintenance" ]]; then
  # Langkah terakhir: tutup situs dengan maintenance mode velocity-addons sampai PM
  # menyerahkannya ke klien. Sesudah QA, karena QA membaca situs sebagai pengunjung.
  #
  # Paket G sedang dalam masa pembelajaran (keputusan user 2026-09-13): situsnya
  # dibiarkan terbuka supaya hasil otomatisasi mudah dipantau langsung. Nyalakan
  # lagi dengan PAKET_G_MAINTENANCE=1 (mis. di /etc/velocity/installer-autopilot.env).
  if paket_desain_custom && [[ "${PAKET_G_MAINTENANCE:-0}" != 1 ]]; then
    echo "[$(date -Is)] maintenance: maintenance_dilewati:paket_g_masa_pembelajaran" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --tandai-tanpa-maintenance "$MANIFEST" >> "$LOG" 2>&1 || true
  else
    echo "[$(date -Is)] Maintenance mode" >> "$LOG"
    /usr/bin/python3 "$SCRIPTS/site-finish" --maintenance "$MANIFEST" >> "$LOG" 2>&1 || true
  fi
fi
if [[ "$MODE" == "dry-run" ]]; then
  state SUCCESS DRY_RUN_OK
else
  # Stage tetap COMPLETE (situs terpasang; antrean & autopilot memakainya).
  # Temuan pemeriksaan akhir dilaporkan terpisah sebagai "perlu dicek".
  state SUCCESS COMPLETE
  if [[ -n "$problems" ]]; then
    notify CHECK "$problems"
  else
    notify SUCCESS COMPLETE
  fi
fi
