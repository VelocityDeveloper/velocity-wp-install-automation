$teks = '';
// Shortcode yang dipakai halaman tapi tidak ada fungsinya akan tercetak apa
// adanya ke pengunjung, mis. "[jasa_kontak]". Penyebab tersering: awalan tema
// berubah, atau blok desain disalin dari situs lain.
global $shortcode_tags;
$sc_hilang = array();
foreach (get_pages(array('post_status' => 'publish')) as $p) {
    $teks .= $p->post_content;
    // Komentar blok dibuang dulu: atribut JSON seperti "category":[8] bukan shortcode.
    if (preg_match_all('/\[([a-zA-Z0-9_-]+)[^\]]*\]/', (string) preg_replace('/<!--.*?-->/s', '', (string) $p->post_content), $m)) {
        foreach (array_unique($m[1]) as $tag) {
            if (!isset($shortcode_tags[$tag]) && !in_array($tag, array('caption', 'embed'), true)) {
                $sc_hilang[] = $tag . '@' . $p->post_name;
            }
        }
    }
}
$tema_dir = get_stylesheet_directory();
foreach (array('theme-data.php') as $f) {
    if (is_readable($tema_dir . '/inc/' . $f)) { $teks .= file_get_contents($tema_dir . '/inc/' . $f); }
}
function velocity_audit_judul_ganda($p)
{
    $GLOBALS['post'] = $p;
    setup_postdata($p);
    $html = (string) apply_filters('the_content', $p->post_content);
    wp_reset_postdata();
    if (!preg_match_all('#<h[12][^>]*>(.*?)</h[12]>#is', $html, $m)) {
        return '';
    }
    $hitung = array_count_values(array_filter(array_map(function ($t) {
        return strtolower(trim(preg_replace('/\s+/', ' ', html_entity_decode(wp_strip_all_tags($t), ENT_QUOTES))));
    }, $m[1])));
    foreach ($hitung as $judul => $n) {
        if ($n > 1) {
            return substr($judul, 0, 40);
        }
    }
    return '';
}

function velocity_audit_isi_tema($dir)
{
    // Footer & isi tema yang tampil di semua halaman: part footer (termasuk versi
    // Site Editor) untuk block theme, berkas footer/inc untuk tema klasik.
    $isi = '';
    if (function_exists('wp_is_block_theme') && wp_is_block_theme()) {
        $part = get_block_template(get_stylesheet() . '//footer', 'wp_template_part');
        $isi .= $part ? (string) $part->content : '';
        foreach ((array) glob($dir . '/{inc,blocks}/*.php', GLOB_BRACE) as $f) {
            $isi .= (string) @file_get_contents($f);
        }
        foreach ((array) glob($dir . '/blocks/*/*.php') as $f) {
            $isi .= (string) @file_get_contents($f);
        }
    } else {
        foreach (array_merge(array($dir . '/footer.php'), (array) glob($dir . '/inc/*.php')) as $f) {
            $isi .= is_readable($f) ? (string) @file_get_contents($f) : '';
        }
        ob_start();
        do_action('justg_do_footer');
        $isi .= (string) ob_get_clean();
    }
    return $isi;
}

function velocity_audit_captcha_form($dir)
{
    // Semua berkas tema diperiksa, bukan berhenti di yang pertama ber-$_POST: di
    // velocity-fse `inc/dealer.php` (simpan metabox wp-admin) datang lebih dulu secara
    // alfabet daripada `inc/form.php`, sehingga form yang justru berkaptcha dilaporkan
    // "form_tanpa_captcha" (bumiairchemitech.com 2026-09-16). POST milik wp-admin —
    // ada save_post/current_user_can/is_admin — bukan form pengunjung.
    $form_publik = false;
    $captcha = false;
    foreach (array_merge(array($dir . '/functions.php'), (array) glob($dir . '/inc/*.php')) as $f) {
        if (!is_readable($f)) {
            continue;
        }
        $kode = @php_strip_whitespace($f);
        if (!$kode) {
            continue;
        }
        if (preg_match('/velocity_captcha|Velocity_Addons_Captcha|velocity_fse_captcha/', $kode)) {
            $captcha = true;
        }
        if (preg_match('/\$_POST/', $kode) && !preg_match('/save_post|current_user_can|is_admin\(/', $kode)) {
            $form_publik = true;
        }
    }
    return (int) (!$form_publik || $captcha);
}

function velocity_audit_kategori()
{
    $hasil = array();
    foreach ((array) get_categories(array('hide_empty' => false)) as $k) {
        $hasil[$k->name] = (int) $k->count;
    }
    return $hasil;
}

function velocity_audit_kontak_publik()
{
    // Kontak yang tampil di situs menurut child theme: telepon/WA dan email publik.
    global $shortcode_tags;
    foreach (array_keys($shortcode_tags) as $t) {
        if (preg_match('/^([a-z0-9]+)_kontak$/', $t, $m) && function_exists($m[1] . '_data')) {
            $f = $m[1] . '_data';
            $telp = trim((string) $f('telp'));
            return array('telp' => $telp === '-' ? '' : $telp, 'email' => trim((string) $f('email_publik')));
        }
    }
    return null;
}

function velocity_audit_layanan()
{
    // Judul layanan dari child theme yang terpasang — sumber kebenaran untuk
    // kategori artikel. Awalannya dicari lewat shortcode yang terdaftar.
    global $shortcode_tags;
    foreach (array_keys($shortcode_tags) as $t) {
        if (preg_match('/^([a-z0-9]+)_layanan$/', $t, $m) && function_exists($m[1] . '_data')) {
            $judul = array();
            foreach ((array) (call_user_func($m[1] . '_data', 'jenis') === 'berita' ? call_user_func($m[1] . '_data', 'rubrik') : call_user_func($m[1] . '_data', 'layanan')) as $l) {
                if (!empty($l['judul'])) {
                    $judul[] = (string) $l['judul'];
                }
            }
            return $judul;
        }
    }
    return array();
}

function velocity_audit_wa_label()
{
    $kontak = (array) get_option('nomor_whatsapp_contacts', array());
    $pertama = reset($kontak);
    return is_array($pertama) && !empty($pertama['name']) ? (string) $pertama['name'] : '';
}

function velocity_audit_pemesanan()
{
    // Tipe post arsip pemesanan ikut awalan tema, jadi dicari di situs — bukan
    // ditebak dari nama domain seperti yang dulu bikin shortcode nyasar.
    foreach (get_post_types() as $tipe) {
        if (substr($tipe, -10) === '_pemesanan') {
            return array_sum((array) get_object_vars(wp_count_posts($tipe)));
        }
    }
    return 0;
}

function velocity_audit_wa_tema($dir)
{
    $berkas = array_merge(array($dir . '/functions.php'), (array) glob($dir . '/inc/*.php'));
    foreach ($berkas as $f) {
        if (!is_readable($f)) {
            continue;
        }
        $kode = @php_strip_whitespace($f);
        if ($kode && preg_match('/add_action\s*\(\s*[\'"]wp_footer/', $kode)
            && preg_match('/wa\.me|api\.whatsapp/i', $kode)) {
            return 1;
        }
    }
    return 0;
}

function velocity_audit_kredit_footer()
{
    // Baris hak cipta wajib memuat "Design by Velocity Developer" (keputusan user 2026-09-14).
    if (function_exists('wp_is_block_theme') && wp_is_block_theme()) {
        // Termasuk versi DB dari Site Editor yang menimpa parts/footer.html.
        $part = get_block_template(get_stylesheet() . '//footer', 'wp_template_part');
        return (int) ($part && stripos((string) $part->content, 'velocitydeveloper.com') !== false);
    }
    $footer = locate_template('footer.php');
    $kode = $footer ? (string) @file_get_contents($footer) : '';
    if ($kode !== '' && strpos($kode, 'justg_do_footer') === false) {
        return (int) (stripos($kode, 'velocitydeveloper.com') !== false);
    }
    // Footer tema induk: dirender lewat kait, termasuk sisipan mu-plugin installer.
    ob_start();
    do_action('justg_do_footer');
    return (int) (stripos((string) ob_get_clean(), 'velocitydeveloper.com') !== false);
}

