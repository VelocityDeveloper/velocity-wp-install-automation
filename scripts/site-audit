#!/usr/bin/env python3
"""Audit situs terpasang: apa yang dijanjikan automation vs apa yang ada di situs.

Pemakaian: site-audit <domain|manifest> [--json]
Baris terakhir: JSON {"audit": "ok"|"temuan", "temuan": [...], "info": {...}}

Bedanya dengan `site-qa`: QA adalah gerbang saat instalasi (dilihat dari luar,
lewat HTTP/REST), sedangkan audit ini memeriksa dari DALAM situs lewat WP-CLI —
jadi tetap terbaca meski situs sedang maintenance, tepat ketika QA buta.

Yang diaudit: tema aktif, halaman wajib, menu, form pemesanan, logo & favicon
(termasuk apakah masih logo contoh), widget, foto, sisa teks contoh dari
template, maintenance mode, serta SSL & HTTP dari luar.
"""
import html
import json
import os
import re
import shlex
import ssl
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = Path('/home/project')
CHILD_THEME = HERE / 'velocity-child-theme'
UA = {'User-Agent': 'velocity-installer-audit/1.0'}
INSECURE = ssl._create_unverified_context()
# Teks bawaan template Paket G; kalau masih ada berarti belum disunting isinya.
TEKS_CONTOH = ('Layanan Utama', 'Layanan Kedua', 'Produk Pertama', 'Dokumentasi 1',
               'Jelaskan layanan utama', 'Keterangan singkat produk', 'Rincian pertama')

REMOTE = r'''
set -e
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done
[[ -n "$WP_BIN" ]] || { echo '{"gagal":"wp-cli_missing"}'; exit 0; }
wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root 2>/dev/null; }
cat > /tmp/velocity-audit.php <<'PHP'
<?php
/** Kumpulkan keadaan situs apa adanya; penilaian dilakukan di sisi installer. */
$tema = wp_get_theme();
$halaman = array();
foreach (get_pages(array('post_status' => 'publish,draft,private')) as $p) {
    $halaman[$p->post_name] = array('id' => $p->ID, 'status' => $p->post_status,
                                    'isi' => strlen((string) $p->post_content),
                                    'shortcode' => (bool) preg_match('/\[[a-z0-9_]+_(pemesanan|layanan|produk|galeri|kontak|alur)\]/', (string) $p->post_content));
}
$menu_items = array();
foreach (get_nav_menu_locations() as $lokasi => $term_id) {
    if (!$term_id) { continue; }
    foreach ((array) wp_get_nav_menu_items($term_id) as $item) {
        $menu_items[] = $item->title;
    }
}
$teks = '';
// Shortcode yang dipakai halaman tapi tidak ada fungsinya akan tercetak apa
// adanya ke pengunjung, mis. "[jasa_kontak]". Penyebab tersering: awalan tema
// berubah, atau blok desain disalin dari situs lain.
global $shortcode_tags;
$sc_hilang = array();
foreach (get_pages(array('post_status' => 'publish')) as $p) {
    $teks .= $p->post_content;
    if (preg_match_all('/\[([a-zA-Z0-9_-]+)[^\]]*\]/', (string) $p->post_content, $m)) {
        foreach (array_unique($m[1]) as $tag) {
            if (!isset($shortcode_tags[$tag]) && !in_array($tag, array('caption', 'embed'), true)) {
                $sc_hilang[] = $tag . '@' . $p->post_name;
            }
        }
    }
}
$tema_dir = get_stylesheet_directory();
foreach (array('theme-data.php') as $f) {
    if (is_readable($tema_dir . '/inc/' . $f)) { $teks .= file_get_contents($tema_dir . '/inc/' . $f); }
}
function velocity_audit_wa_label()
{
    $kontak = (array) get_option('nomor_whatsapp_contacts', array());
    $pertama = reset($kontak);
    return is_array($pertama) && !empty($pertama['name']) ? (string) $pertama['name'] : '';
}

function velocity_audit_pemesanan()
{
    // Tipe post arsip pemesanan ikut awalan tema, jadi dicari di situs — bukan
    // ditebak dari nama domain seperti yang dulu bikin shortcode nyasar.
    foreach (get_post_types() as $tipe) {
        if (substr($tipe, -10) === '_pemesanan') {
            return array_sum((array) get_object_vars(wp_count_posts($tipe)));
        }
    }
    return 0;
}

function velocity_audit_wa_tema($dir)
{
    $berkas = array_merge(array($dir . '/functions.php'), (array) glob($dir . '/inc/*.php'));
    foreach ($berkas as $f) {
        if (!is_readable($f)) {
            continue;
        }
        $kode = @php_strip_whitespace($f);
        if ($kode && preg_match('/add_action\s*\(\s*[\'"]wp_footer/', $kode)
            && preg_match('/wa\.me|api\.whatsapp/i', $kode)) {
            return 1;
        }
    }
    return 0;
}

global $wp_registered_sidebars;
$widget_nyasar = 0;
foreach ((array) get_option('sidebars_widgets', array()) as $sb => $isi) {
    if ($sb === 'array_version' || !is_array($isi)) { continue; }
    $widget_nyasar += count($isi);
}
$gambar = get_option(substr(wp_get_theme()->get('TextDomain'), 0, 12) . '_images');
echo wp_json_encode(array(
    'tema'            => get_stylesheet(),
    'tema_nama'       => $tema->get('Name'),
    // get('Stylesheet') selalu kosong — itu bukan header tema, melainkan metode.
    'tema_induk'      => $tema->parent() ? $tema->parent()->get_stylesheet() : '',
    'wp'              => get_bloginfo('version'),
    'blogname'        => get_bloginfo('name'),
    'tagline'         => get_bloginfo('description'),
    'halaman'         => $halaman,
    'menu'            => $menu_items,
    'logo'            => (int) get_theme_mod('custom_logo'),
    'logo_contoh'     => (int) get_option('velocity_logo_contoh'),
    'favicon'         => (int) get_option('site_icon'),
    'favicon_contoh'  => (int) get_option('velocity_icon_contoh'),
    'maintenance'     => (int) get_option('maintenance_mode'),
    'maintenance_installer' => (string) get_option('velocity_installer_maintenance'),
    'wa_float'        => (string) get_option('floating_whatsapp', '1'),
    'wa_nomor'        => (string) get_option('nomor_whatsapp'),
    // Untuk satu kontak, plugin mencetak nama kontak sebagai tulisan tombol.
    'wa_label'        => (string) (velocity_audit_wa_label() ?: get_option('whatsapp_text')),
    // Tema tidak boleh membuat tombol WA sendiri: plugin sudah punya, dan
    // hasilnya dua tombol menumpuk yang salah satunya tak bisa diatur PM.
    // Komentar dibuang dulu (php_strip_whitespace) — kalau tidak, penjelasan
    // "plugin yang menyediakannya" ikut terbaca sebagai kode.
    'wa_tema'         => (int) velocity_audit_wa_tema($tema_dir),
    'shortcode_hilang' => array_values(array_unique($sc_hilang)),
    'widget_nyasar'   => $widget_nyasar,
    'widget_bersih'   => (string) get_option('velocity_widget_bersih'),
    'sidebar_aktif'   => count((array) $wp_registered_sidebars),
    'artikel'         => (int) wp_count_posts('post')->publish,
    'pemesanan_masuk' => velocity_audit_pemesanan(),
    'media'           => (int) wp_count_posts('attachment')->inherit,
    'teks'            => $teks,
));
PHP
wp eval-file /tmp/velocity-audit.php
rm -f /tmp/velocity-audit.php
'''


def read_manifest(path):
    cfg = {}
    for line in Path(path).read_text(errors='replace').splitlines():
        key, sep, value = line.partition('=')
        if sep and re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key.strip()):
            cfg[key.strip()] = value.strip()
    return cfg


def info_tema(domain, cfg):
    """Slug & awalan child theme yang SEHARUSNYA dipakai situs ini."""
    try:
        run = subprocess.run([sys.executable, str(CHILD_THEME), domain, '--no-download',
                              '--paket', cfg.get('paket', ''),
                              '--prefix', cfg.get('velocity_child_prefix', '')],
                             capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return {}
    hasil = {}
    for line in run.stdout.splitlines():
        key, sep, value = line.partition('=')
        if sep:
            hasil[key.strip()] = value.strip()
    return hasil


def http(url, method='GET', timeout=20):
    req = urllib.request.Request(url, headers=UA, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=INSECURE) as resp:
            return resp.status, resp.read() if method == 'GET' else b''
    except urllib.error.HTTPError as e:
        return e.code, e.read() if method == 'GET' else b''
    except (urllib.error.URLError, OSError):
        return 0, b''


def ssl_valid(domain):
    try:
        urllib.request.urlopen(urllib.request.Request(f'https://{domain}/', headers=UA), timeout=20)
        return True, ''
    except urllib.error.HTTPError:
        return True, ''          # 503 maintenance tetap berarti SSL-nya lolos
    except urllib.error.URLError as e:
        if isinstance(getattr(e, 'reason', None), ssl.SSLError):
            return False, str(e.reason)[:120]
        return True, ''
    except OSError:
        return True, ''


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    hanya_json = '--json' in sys.argv[1:]
    if len(args) != 1:
        print('usage: site-audit <domain|manifest> [--json]', file=sys.stderr)
        return 2
    target = args[0]
    manifest = Path(target) if target.endswith('.txt') else ROOT / target.lower() / f'{target.lower()}.txt'
    if not manifest.is_file():
        print(json.dumps({'audit': 'temuan', 'temuan': ['manifest_tidak_ada'], 'info': {}}))
        return 1
    cfg = read_manifest(manifest)
    domain = cfg.get('domain', '').lower()
    da_user = cfg.get('da_user', '')
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain) or not re.match(r'^[a-z][a-z0-9]*$', da_user):
        print(json.dumps({'audit': 'temuan', 'temuan': ['manifest_tidak_valid'], 'info': {}}))
        return 1
    if not key or not Path(key).is_file():
        print(json.dumps({'audit': 'temuan', 'temuan': ['kunci_ssh_tidak_ada'], 'info': {}}))
        return 1

    harapan = info_tema(domain, cfg)
    paket = cfg.get('paket', '')
    paket_custom = re.sub(r'[^a-z]', '', paket.lower()) == 'paketg'

    ssh = ['ssh', '-i', key, '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
           '-o', 'ConnectTimeout=15', '-p', str(cfg.get('ssh_port') or 22),
           f"{cfg.get('ssh_user') or 'root'}@{cfg['target_host']}"]
    header = f'DOCROOT={shlex.quote(f"/home/{da_user}/domains/{domain}/public_html")}'
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE,
                         capture_output=True, text=True, timeout=300)
    baris = [l for l in run.stdout.splitlines() if l.strip().startswith('{')]
    if not baris:
        pesan = (run.stderr or run.stdout).strip().splitlines()[-1:] or ['tidak_ada_keluaran']
        print(json.dumps({'audit': 'temuan', 'temuan': ['situs_tidak_terbaca:' + pesan[0][:80]], 'info': {}}))
        return 1
    situs = json.loads(baris[-1])

    temuan, info = [], {}
    teks = situs.pop('teks', '')

    # --- tema ---
    info['tema'] = situs['tema']
    info['paket'] = paket or '-'
    if paket_custom:
        if situs['tema'] != harapan.get('slug'):
            temuan.append(f"tema_bukan_child_theme:{situs['tema']}")
        elif not situs['tema_induk']:
            temuan.append('child_theme_tanpa_induk')

    # --- halaman & menu ---
    wajib = ['beranda', 'tentang-kami', 'galeri', 'berita', 'hubungi-kami']
    if paket_custom:
        wajib += ['layanan', 'produk', 'pemesanan']
    hilang = [s for s in wajib if s not in situs['halaman']]
    draft = [s for s in wajib if situs['halaman'].get(s, {}).get('status') not in (None, 'publish')]
    if hilang:
        temuan.append('halaman_hilang:' + ','.join(hilang))
    if draft:
        temuan.append('halaman_belum_terbit:' + ','.join(draft))
    info['halaman'] = len(situs['halaman'])
    info['menu'] = len(situs['menu'])
    if len(situs['menu']) < 3:
        temuan.append(f"menu_terlalu_sedikit:{len(situs['menu'])}")

    # --- form pemesanan (permintaan tetap Paket G) ---
    if paket_custom:
        pemesanan = situs['halaman'].get('pemesanan') or {}
        if not pemesanan.get('shortcode'):
            temuan.append('form_pemesanan_tidak_terpasang')
        info['pemesanan_masuk'] = situs.get('pemesanan_masuk', 0)

    # --- identitas ---
    info['logo'] = 'contoh' if situs['logo'] and situs['logo'] == situs['logo_contoh'] else (
        'ada' if situs['logo'] else 'tidak ada')
    info['favicon'] = 'contoh' if situs['favicon'] and situs['favicon'] == situs['favicon_contoh'] else (
        'ada' if situs['favicon'] else 'tidak ada')
    if not situs['logo']:
        temuan.append('logo_belum_terpasang')
    if not situs['favicon']:
        temuan.append('favicon_belum_terpasang')
    if not situs['tagline']:
        temuan.append('tagline_kosong')

    # --- shortcode tanpa fungsi ---
    hilang = situs.get('shortcode_hilang') or []
    info['shortcode_hilang'] = len(hilang)
    if hilang:
        # Tercetak apa adanya ke pengunjung, jadi ini masalah yang terlihat.
        temuan.append('shortcode_tanpa_fungsi:' + ','.join(hilang[:4]))

    # --- tombol WhatsApp (milik velocity-addons, bukan tema) ---
    info['wa'] = (('aktif:' + situs['wa_nomor']) if situs['wa_float'] == '1' and situs['wa_nomor']
                  else ('mati' if situs['wa_float'] != '1' else 'nomor kosong'))
    if situs['wa_float'] == '1' and not situs['wa_nomor']:
        temuan.append('whatsapp_plugin_belum_diisi')
    if situs.get('wa_tema'):
        temuan.append('tombol_whatsapp_ganda:tema_membuat_sendiri')
    # Tulisan tombol harus ajakan ("Hubungi Kami", "Konsultasi"), bukan nama
    # situs — pengunjung sudah tahu sedang membuka situs siapa.
    def sederhana(teks):
        # WordPress menyimpan blogname dengan entitas ("&amp;"), jadi harus
        # di-decode dulu — tanpa ini perbandingannya selalu meleset.
        return re.sub(r'[^a-z0-9]', '', html.unescape(str(teks or '')).lower())

    label = sederhana(situs.get('wa_label'))
    nama_situs = sederhana(situs.get('blogname'))
    label_domain = re.sub(r'[^a-z0-9]', '', domain.split('.')[0])
    bernama_situs = bool(label) and (
        label == nama_situs
        or label == label_domain
        # Label panjang yang memuat/termuat nama situs juga berarti nama web,
        # mis. "Jasa Kontraktor Indo" di situs "Jasa Kontraktor & Interior ...".
        or (len(label) >= 12 and nama_situs and (label in nama_situs or nama_situs in label))
    )
    if bernama_situs:
        temuan.append(f'tombol_whatsapp_bernama_situs:{situs.get("wa_label", "")[:40]}')
    info['wa_label'] = label or '-'

    # --- widget ---
    info['widget_nyasar'] = situs['widget_nyasar']
    if paket_custom and situs['widget_nyasar']:
        temuan.append(f"widget_bawaan_tersisa:{situs['widget_nyasar']}")

    # --- isi yang belum disunting ---
    sisa = sorted({t for t in TEKS_CONTOH if t in teks})
    if sisa:
        temuan.append('teks_contoh_belum_diganti:' + ','.join(sisa[:3]))
    info['media'] = situs['media']
    info['artikel'] = situs['artikel']
    if paket_custom and situs['media'] < 5:
        temuan.append(f"foto_terlalu_sedikit:{situs['media']}")

    # --- maintenance ---
    info['maintenance'] = bool(situs['maintenance'])
    if situs['maintenance_installer'] and not situs['maintenance']:
        # Installer pernah menyalakannya, sekarang mati: entah PM sudah serah
        # terima, entah mati sendiri. Wajib dikonfirmasi manusia.
        temuan.append('maintenance_mati_setelah_dinyalakan_installer')

    # --- dari luar ---
    ok_ssl, pesan_ssl = ssl_valid(domain)
    info['ssl'] = 'valid' if ok_ssl else pesan_ssl
    if not ok_ssl:
        temuan.append('ssl_tidak_valid')
    kode, _ = http(f'https://{domain}/wp-includes/css/dashicons.min.css', method='HEAD')
    info['aset_http'] = kode
    if kode != 200:
        temuan.append(f'aset_inti_http_{kode}')

    hasil = {'audit': 'temuan' if temuan else 'ok', 'temuan': temuan, 'info': info}
    if not hanya_json:
        print(f'Audit {domain} — paket {info["paket"]}')
        for k, v in info.items():
            print(f'  {k:18}: {v}')
        print('  temuan            : ' + (', '.join(temuan) if temuan else 'tidak ada'))
    print(json.dumps(hasil))
    return 0


if __name__ == '__main__':
    sys.exit(main())
