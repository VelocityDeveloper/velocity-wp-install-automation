def read_manifest(path):
    cfg = {}
    for line in Path(path).read_text(errors='replace').splitlines():
        key, sep, value = line.partition('=')
        if sep and re.match(r'^[A-Za-z_][A-Za-z0-9_]*$', key.strip()):
            cfg[key.strip()] = value.strip()
    return cfg


def info_tema(domain, cfg):
    """Slug & awalan child theme yang SEHARUSNYA dipakai situs ini."""
    try:
        run = subprocess.run([sys.executable, str(CHILD_THEME), domain, '--no-download',
                              '--paket', cfg.get('paket', ''),
                              '--prefix', cfg.get('velocity_child_prefix', '')],
                             capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return {}
    hasil = {}
    for line in run.stdout.splitlines():
        key, sep, value = line.partition('=')
        if sep:
            hasil[key.strip()] = value.strip()
    return hasil


def referensi_form(domain):
    """Referensi desain menurut FORM ISIAN (logika yang sama dengan referensi_desain.py)."""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location('referensi_desain', HERE / 'referensi_desain.py')
        modul = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(modul)
        return modul.referensi_form(domain) or {}
    except Exception:
        return {}


def dokumen_klien(domain):
    """Teks dokumen klien selain FORM ISIAN (company profile, katalog), '' bila tak terbaca."""
    try:
        sys.path.insert(0, str(HERE))
        from client_docs import collect_client_docs
        return '\n'.join(t for n, t in collect_client_docs(Path('/home/On Progress') / domain, 10 ** 7, 10 ** 7).get('sources', [])
                         if not n.upper().startswith('FORM ISIAN'))
    except Exception:
        return ''


def biodata_pemilik(domain):
    """Email & alamat dari bagian BIODATA PEMILIK FORM ISIAN (+ kolom kontak untuk web)."""
    try:
        sys.path.insert(0, str(HERE))
        from client_form import read_client_form
        form = read_client_form(Path('/home/On Progress') / domain)
    except Exception:
        return {}
    teks = form.get('text') or ''
    m = re.search(r'BIO\s*A?DATA\s+PEMILIK(.*?)(FORM\s*3|DESAIN\s+WEBSITE|$)', teks, re.I | re.S)
    bagian = m.group(1) if m else ''
    email = re.search(r'[\w.+-]+@[\w-]+\.[\w.]+', bagian)
    alamat = re.search(r'Alamat\s+lengkap\s*:\s*([^\n]+)', bagian, re.I)
    kontak = next((str(v) for k, v in (form.get('fields') or {}).items() if re.search(r'kontak utk di web|kontak untuk di web', k, re.I)), '')
    return {'email': email.group(0) if email else '', 'alamat': alamat.group(1).strip() if alamat else '', 'kontak_web': kontak}


def http(url, method='GET', timeout=20):
    req = urllib.request.Request(url, headers=UA, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=INSECURE) as resp:
            return resp.status, resp.read() if method == 'GET' else b''
    except urllib.error.HTTPError as e:
        return e.code, e.read() if method == 'GET' else b''
    except (urllib.error.URLError, OSError):
        return 0, b''


def ssl_valid(domain):
    try:
        urllib.request.urlopen(urllib.request.Request(situs_url(domain) + '/', headers=UA), timeout=20)
        return True, ''
    except urllib.error.HTTPError:
        return True, ''          # 503 maintenance tetap berarti SSL-nya lolos
    except urllib.error.URLError as e:
        if isinstance(getattr(e, 'reason', None), ssl.SSLError):
            return False, str(e.reason)[:120]
        return True, ''
    except OSError:
        return True, ''


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    hanya_json = '--json' in sys.argv[1:]
    if len(args) != 1:
        print('usage: site-audit <domain|manifest> [--json]', file=sys.stderr)
        return 2
    target = args[0]
    manifest = Path(target) if target.endswith('.txt') else ROOT / target.lower() / f'{target.lower()}.txt'
    if not manifest.is_file():
        print(json.dumps({'audit': 'temuan', 'temuan': ['manifest_tidak_ada'], 'info': {}}))
        return 1
    cfg = read_manifest(manifest)
    domain = cfg.get('domain', '').lower()
    da_user = cfg.get('da_user', '')
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain) or not re.match(r'^[a-z][a-z0-9]*$', da_user):
        print(json.dumps({'audit': 'temuan', 'temuan': ['manifest_tidak_valid'], 'info': {}}))
        return 1
    if not key or not Path(key).is_file():
        print(json.dumps({'audit': 'temuan', 'temuan': ['kunci_ssh_tidak_ada'], 'info': {}}))
        return 1

    harapan = info_tema(domain, cfg)
    paket = cfg.get('paket', '')
    paket_custom = re.sub(r'[^a-z]', '', paket.lower()) in ('paketg', 'paketportalberitacustom', 'pakettokoonlinecustom')
    paket_berita = 'berita' in paket.lower()

    # Situs di lokasi tidak baku (staging velocitydeveloper.co): pengganti ssh + docroot
    # lewat VELOCITY_LOKAL_*, sama seperti scripts/fse-apply & scripts/site-finish.
    lokal = os.environ.get('VELOCITY_LOKAL_SSH', ''), os.environ.get('VELOCITY_LOKAL_DOCROOT', '')
    ssh = [lokal[0]] if all(lokal) else [
        'ssh', '-i', key, '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
        '-o', 'ConnectTimeout=15', '-p', str(cfg.get('ssh_port') or 22),
        f"{cfg.get('ssh_user') or 'root'}@{cfg['target_host']}"]
    header = f'DOCROOT={shlex.quote(lokal[1] or f"/home/{da_user}/domains/{domain}/public_html")}'
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE,
                         capture_output=True, text=True, timeout=300)
    baris = [l for l in run.stdout.splitlines() if l.strip().startswith('{')]
    if not baris:
        pesan = (run.stderr or run.stdout).strip().splitlines()[-1:] or ['tidak_ada_keluaran']
        print(json.dumps({'audit': 'temuan', 'temuan': ['situs_tidak_terbaca:' + pesan[0][:80]], 'info': {}}))
        return 1
    situs = json.loads(baris[-1])

    temuan, info = [], {}
    teks = situs.pop('teks', '')

    # --- tema ---
    info['tema'] = situs['tema']
    info['paket'] = paket or '-'
    # Paket custom hanya FSE (keputusan user 2026-09-15): velocity-fse, atau block
    # theme buatan tangan yang dicatat `tema_fse=` di manifest.
    tema_fse = situs['tema'] == 'velocity-fse'
    if paket_custom and not tema_fse and situs['tema'] != cfg.get('tema_fse'):
        temuan.append(f"tema_bukan_fse:{situs['tema']}")

    # --- referensi desain di FORM ISIAN tertangkap installer? ---
    # jasakontraktorindo.com (2026-09-17): klien menulis "kontraktorhijau.com" tanpa
    # http://, installer mencatat tanpa_referensi, dan situs jadi tidak mirip pilihan klien.
    if paket_custom:
        ref_form = referensi_form(domain)
        try:
            rencana = json.loads((Path('/var/lib/velocity/fse-rencana') / domain / 'referensi.json').read_text())
        except (OSError, ValueError):
            rencana = {}
        info['referensi'] = ref_form.get('url') or '-'
        if ref_form.get('url') and not cfg.get('tema_fse') and (
                not rencana.get('url') or rencana.get('sumber') == 'tanpa_referensi'):
            temuan.append('referensi_form_terlewat:' + re.sub(r'^\w+://', '', ref_form['url'])[:60])

    # --- tampilan mengikuti company profile & tombol WhatsApp ---
    if paket_custom:
        kode_beranda, beranda = http(f'{situs_url(domain)}/?audit={int(time.time())}')
        try:
            compro = json.loads((Path('/var/lib/velocity/compro') / domain / 'compro.json').read_text())
        except (OSError, ValueError):
            compro = {}
        prefix = harapan.get('prefix', '')
        if kode_beranda == 200 and tema_fse:
            info['gaya'] = 'fse'
        elif kode_beranda == 200:
            info['gaya'] = ('compro' if prefix and f'{prefix}--compro'.encode() in beranda
                            else 'berita' if prefix and f'{prefix}--berita'.encode() in beranda else 'bawaan')
            if compro.get('seksi') and info['gaya'] != 'compro':
                temuan.append('tema_belum_mengikuti_compro')
            # Tanpa nomor publik tombol WA jatuh ke mailto/nomor kosong; tema
            # harus menyembunyikannya (pelajaran ptmitraajegselaras.com).
            if not situs.get('wa_nomor') and b'wa.me/' in beranda:
                temuan.append('tombol_whatsapp_tanpa_nomor')
        # Hasil scripts/paket-g-cek-visual terakhir (screenshot untuk dicek mata).
        run_visual = sorted((Path('/var/lib/velocity/visual') / domain).glob('*/ringkasan.json'))
        if run_visual:
            try:
                visual = json.loads(run_visual[-1].read_text())
                info['visual'] = f"{run_visual[-1].parent} ({', '.join(visual.get('temuan') or []) or 'ok'})"
                temuan += [f'visual:{t}' for t in visual.get('temuan') or []]
            except (OSError, ValueError):
                pass
        else:
            info['visual'] = 'belum pernah dicek'

    # --- halaman & menu ---
    # Situs dealer mobil: unit tinggal di CPT `mobil` (arsip /model-unit/), halaman wajibnya
    # Test Drive & Simulasi Kredit — bukan Layanan/Produk/Pemesanan.
    dealer = (situs.get('gaya') or cfg.get('gaya_beranda', '')).strip().lower() == 'dealer'
    wajib = ['beranda', 'tentang-kami', 'galeri', 'berita', 'hubungi-kami']
    if paket_custom:
        wajib += (['redaksi'] if paket_berita else ['test-drive', 'simulasi-kredit'] if dealer
                  else ['layanan', 'produk', 'pemesanan'])
    # Slug padanan: situs FSE mengikuti menu referensi/desain klien (centralimpex.com
    # about/contact/products, jasakontraktorindo.com portofolio), bukan slug baku Paket G.
    padanan = {
        'tentang-kami': ['tentang-kami', 'profil', 'about', 'about-us', 'tentang'],
        'galeri': ['galeri', 'portofolio', 'portfolio', 'gallery', 'galeri-foto', 'proyek'],
        'berita': ['berita', 'blog', 'artikel', 'insights', 'news'],
        'hubungi-kami': ['hubungi-kami', 'kontak', 'contact', 'kontak-kami'],
        'layanan': ['layanan', 'services', 'jasa', 'solutions'],
        'produk': ['produk', 'products', 'katalog', 'product'],
        'pemesanan': ['pemesanan', 'order', 'rfq'],
    }
    def cari_halaman(slug):
        calon = [x for x in padanan.get(slug, [slug]) if x in situs['halaman']]
        terbit = [x for x in calon if situs['halaman'][x].get('status') == 'publish']
        return (terbit or calon or [None])[0]
    if slug_arsip := next((k for k, v in situs['halaman'].items() if v.get('id') == situs.get('halaman_artikel')), None):
        padanan['berita'].insert(0, slug_arsip)
    # Tema FSE buatan tangan boleh tanpa halaman Produk (digabung ke layanan).
    # Tema FSE buatan tangan (manifest tema_fse=) mengikuti susunan halaman desain klien/
    # referensi — yang dituntut hanya halaman kontak.
    if cfg.get('tema_fse'):
        wajib = ['hubungi-kami']
    hilang = [s for s in wajib if not cari_halaman(s)]
    draft = [s for s in wajib if cari_halaman(s) and situs['halaman'][cari_halaman(s)].get('status') != 'publish']
    if hilang:
        temuan.append('halaman_hilang:' + ','.join(hilang))
    if draft:
        temuan.append('halaman_belum_terbit:' + ','.join(draft))
    info['halaman'] = len(situs['halaman'])
    info['menu'] = len(situs['menu'])
    if len(situs['menu']) < 3:
        temuan.append(f"menu_terlalu_sedikit:{len(situs['menu'])}")

    # --- form pemesanan (permintaan tetap Paket G) ---
    if paket_custom:
        # Portal berita memasang form "Kirim Pesan ke Redaksi" di Hubungi Kami.
        slug_form = 'hubungi-kami' if (paket_berita or dealer) else 'pemesanan'
        # Form boleh berada di halaman padanan mana pun (Kontak/Contact/RFQ).
        if not any((situs['halaman'].get(x) or {}).get('shortcode') for x in padanan.get(slug_form, [slug_form]) + padanan['hubungi-kami']):
            temuan.append('form_pemesanan_tidak_terpasang')
        info['pemesanan_masuk'] = situs.get('pemesanan_masuk', 0)

    # --- identitas ---
    info['logo'] = 'contoh' if situs['logo'] and situs['logo'] == situs['logo_contoh'] else (
        'ada' if situs['logo'] else 'tidak ada')
    info['favicon'] = 'contoh' if situs['favicon'] and situs['favicon'] == situs['favicon_contoh'] else (
        'ada' if situs['favicon'] else 'tidak ada')
    if not situs['logo']:
        temuan.append('logo_belum_terpasang')
    if not situs['favicon']:
        temuan.append('favicon_belum_terpasang')
    # Wajib: halaman kebijakan privasi (Privacy Policy) ada, ditetapkan di
    # Pengaturan → Privasi, dan berstatus terbit (keputusan user 2026-09-14).
    privasi = situs.get('privasi') or {}
    info['privasi'] = f"{privasi.get('judul')} ({privasi.get('status')})" if privasi.get('status') else 'tidak ada'
    if not privasi.get('status') or privasi.get('status') == 'trash':
        temuan.append('halaman_privasi_tidak_ada')
    elif privasi.get('status') != 'publish':
        temuan.append(f"halaman_privasi_belum_terbit:{privasi.get('status')}")
    # Wajib: foto utama setiap post ber-caption (keputusan user 2026-09-14).
    foto_utama = situs.get('foto_utama') or {}
    info['foto_utama'] = f"{foto_utama.get('ada', 0)} post, {foto_utama.get('tanpa_caption', 0)} tanpa caption"
    if foto_utama.get('tanpa_caption'):
        temuan.append(f"foto_utama_tanpa_caption:{foto_utama['tanpa_caption']}")
    if not situs['tagline']:
        temuan.append('tagline_kosong')
    # Artikel tanpa foto utama tidak ikut terhitung di atas (hanya yang punya foto):
    # jasakontraktorindo.com tercatat "0 post, 0 tanpa caption" dengan 8 artikel tanpa foto.
    if situs.get('artikel_tanpa_foto'):
        info['foto_utama'] += f", {situs['artikel_tanpa_foto']} tanpa foto"
        temuan.append(f"artikel_tanpa_foto_utama:{situs['artikel_tanpa_foto']}")

    # --- wajib footer: statistik pengunjung & ikon sosmed; SEO dasar ---
    isi_tema = situs.get('isi_tema') or ''
    if 'velocity-statistics' not in isi_tema and 'velocity-list-stats' not in isi_tema:
        temuan.append('statistik_footer_tidak_ada')
    if not re.search(r'wp:social-links|facebook\.com|instagram\.com', isi_tema):
        temuan.append('sosmed_footer_tidak_ada')
    seo = situs.get('seo') or {}
    seo_kosong = [k for k in ('home_title', 'home_description') if not seo.get(k)]
    if seo.get('logo') and not seo.get('share_image'):
        seo_kosong.append('share_image')
    if seo_kosong:
        temuan.append('seo_dasar_kosong:' + ','.join(seo_kosong))

    # --- isi halaman: catatan AI & judul ganda ---
    try:
        sys.path.insert(0, str(HERE))
        from content_sanitize import PENOLAKAN
        catatan = PENOLAKAN.findall(html.unescape(re.sub(r'<[^>]+>', ' ', teks)))
        if catatan:
            temuan.append(f'teks_catatan_ai:{len(catatan)}')
    except ImportError:
        pass
    ganda = [f"{k}({v['judul_ganda']})" for k, v in situs['halaman'].items() if v.get('judul_ganda')]
    if ganda:
        temuan.append('judul_ganda:' + ','.join(ganda[:3]))

    # --- shortcode tanpa fungsi ---
    hilang = situs.get('shortcode_hilang') or []
    info['shortcode_hilang'] = len(hilang)
    if hilang:
        # Tercetak apa adanya ke pengunjung, jadi ini masalah yang terlihat.
        temuan.append('shortcode_tanpa_fungsi:' + ','.join(hilang[:4]))

    # --- biodata pemilik tampil sebagai kontak publik? ---
    # Email & alamat di FORM 2 (BIODATA PEMILIK) hanya untuk administrasi; boleh tampil
    # hanya kalau juga ditulis di "Kontak utk di web" atau disetujui (manifest email_publik).
    biodata = biodata_pemilik(domain)
    # Yang dinilai = HTML yang dilihat pengunjung (beranda + halaman kontak). Berkas tema
    # memuat email PENERIMA form yang memang boleh email pemilik, jadi tidak dipakai.
    # Situs maintenance (503) jatuh ke isi halaman + Data Situs FSE.
    tampil = ''
    for jalur in ('/', f"/{cari_halaman('hubungi-kami') or 'hubungi-kami'}/"):
        kode_h, isi_h = http(f'{situs_url(domain)}{jalur}?audit={int(time.time())}')
        if kode_h == 200:
            tampil += isi_h.decode('utf-8', 'replace')
    if not tampil:
        tampil = teks + ' ' + json.dumps(situs.get('situs_kontak') or {})
    tampil = html.unescape(tampil)
    bocor = []
    alamat_kunci = re.sub(r'\W+', ' ', biodata.get('alamat', '')).strip().lower()[:25]
    calon = []
    if biodata.get('email') and biodata['email'].lower() in tampil.lower() \
            and biodata['email'].lower() not in (biodata.get('kontak_web', '') + cfg.get('email_publik', '')).lower():
        calon.append('email')
    if len(alamat_kunci) >= 12 and alamat_kunci in re.sub(r'\W+', ' ', tampil).lower() \
            and not cfg.get('alamat_publik'):
        calon.append('alamat')
    if calon:
        # Nilai yang juga tertulis di dokumen klien selain FORM ISIAN (company profile,
        # medikaklinikteknologi.com) memang kontak publik klien, bukan sekadar biodata.
        dokumen = dokumen_klien(domain).lower()
        dokumen_rata = re.sub(r'\W+', ' ', dokumen)
        bocor = [c for c in calon if not (
            (c == 'email' and biodata['email'].lower() in dokumen)
            or (c == 'alamat' and alamat_kunci in dokumen_rata))]
    if bocor:
        temuan.append('kontak_biodata_tampil:' + ','.join(bocor))

    # --- kontak publik ---
    kontak = situs.get('kontak_publik')
    if isinstance(kontak, dict):
        info['kontak_publik'] = ' | '.join(x for x in (kontak.get('telp'), kontak.get('email')) if x) or '-'
        if not kontak.get('telp') and not kontak.get('email'):
            # Form hanya memuat kontak pribadi pemilik (tidak boleh tampil) dan
            # dokumen klien tidak menyebut kontak usaha: PM perlu melengkapinya.
            temuan.append('kontak_publik_kosong')

    # --- artikel & kategori layanan ---
    kategori = situs.get('kategori') or {}
    layanan = situs.get('layanan') or []
    def ringkas(teks):
        return re.sub(r'[^a-z0-9]', '', html.unescape(str(teks or '')).lower())

    # WordPress menyimpan nama kategori dengan entitas ("Renovasi &amp; Kantor"),
    # jadi pencocokan dengan judul layanan harus lewat bentuk yang sudah didecode.
    jumlah = {ringkas(k): v for k, v in kategori.items()}
    cocok = [l for l in layanan if ringkas(l) in jumlah]
    info['kategori'] = ', '.join(f'{html.unescape(k)} ({v})' for k, v in sorted(kategori.items())
                                 if v or ringkas(k) in {ringkas(l) for l in layanan})[:110] or '-'
    if layanan:
        info['artikel_per_layanan'] = f'{len(cocok)}/{len(layanan)} layanan punya kategori'
        if not cocok:
            # Artikel semua menumpuk di satu kategori umum: pengunjung tidak
            # bisa menelusuri tulisan per layanan.
            temuan.append('artikel_tanpa_kategori_layanan')
        else:
            kosong = [l for l in cocok if not jumlah.get(ringkas(l))]
            if kosong:
                temuan.append('kategori_layanan_tanpa_artikel:' + ','.join(kosong[:3]))

    # --- arsip artikel ---
    arsip, berita = situs.get('halaman_artikel', 0), situs.get('halaman_berita', 0)
    info['arsip_artikel'] = f'halaman {arsip}' if arsip else 'belum ditentukan'
    if situs['artikel'] and not arsip:
        # Tanpa page_for_posts, halaman "Berita" hanya halaman biasa berisi satu
        # kalimat: artikelnya ada tapi tidak pernah tampil di sana.
        temuan.append('arsip_artikel_belum_ditentukan')
    elif berita and arsip and arsip != berita:
        temuan.append(f'arsip_artikel_bukan_halaman_berita:{arsip}')

    # --- peta lokasi ---
    peta = situs.get('peta') or {}
    info['peta'] = f"{peta.get('status', '-')}: {peta.get('label') or peta.get('q') or '-'}"[:70]
    if not peta:
        temuan.append('peta_belum_ditentukan')
    elif peta.get('status') == 'negara':
        # Peta selebar Indonesia tidak berguna untuk pengunjung; alamat klien
        # perlu diperbaiki atau titiknya diisi manual.
        temuan.append('peta_tidak_spesifik:alamat_tidak_dikenali')

    # --- captcha (milik velocity-addons) ---
    captcha = situs.get('captcha') or {}
    penyedia = str(captcha.get('provider') or 'image')
    aktif = str(captcha.get('aktif') or '') not in ('', '0')
    punya_kunci = bool(captcha.get('sitekey')) and bool(captcha.get('secretkey'))
    info['captcha'] = (f'{penyedia}:aktif' if aktif else f'{penyedia}:mati') if captcha else 'belum diatur'
    if not captcha or not aktif:
        temuan.append('captcha_tidak_aktif')
    elif penyedia == 'google' and not punya_kunci:
        # Plugin mematikan sendiri captcha Google tanpa kunci, jadi form jadi
        # tanpa penyaring sama sekali padahal pengaturannya tampak menyala.
        temuan.append('recaptcha_google_tanpa_kunci')
    if not situs.get('captcha_form', 1):
        temuan.append('form_tanpa_captcha')

    # --- tombol WhatsApp (milik velocity-addons, bukan tema) ---
    info['wa'] = (('aktif:' + situs['wa_nomor']) if situs['wa_float'] == '1' and situs['wa_nomor']
                  else ('mati' if situs['wa_float'] != '1' else 'nomor kosong'))
    if situs['wa_float'] == '1' and not situs['wa_nomor']:
        temuan.append('whatsapp_plugin_belum_diisi')
    if situs.get('wa_tema'):
        temuan.append('tombol_whatsapp_ganda:tema_membuat_sendiri')
    # Tulisan tombol harus ajakan ("Hubungi Kami", "Konsultasi"), bukan nama
    # situs — pengunjung sudah tahu sedang membuka situs siapa.
    def sederhana(teks):
        # WordPress menyimpan blogname dengan entitas ("&amp;"), jadi harus
        # di-decode dulu — tanpa ini perbandingannya selalu meleset.
        return re.sub(r'[^a-z0-9]', '', html.unescape(str(teks or '')).lower())

    label = sederhana(situs.get('wa_label'))
    nama_situs = sederhana(situs.get('blogname'))
    label_domain = re.sub(r'[^a-z0-9]', '', domain.split('.')[0])
    bernama_situs = bool(label) and (
        label == nama_situs
        or label == label_domain
        # Label panjang yang memuat/termuat nama situs juga berarti nama web,
        # mis. "Jasa Kontraktor Indo" di situs "Jasa Kontraktor & Interior ...".
        or (len(label) >= 12 and nama_situs and (label in nama_situs or nama_situs in label))
    )
    if bernama_situs:
        temuan.append(f'tombol_whatsapp_bernama_situs:{situs.get("wa_label", "")[:40]}')
    # Tampilkan label apa adanya, bukan hasil normalisasi untuk perbandingan.
    info['wa_label'] = html.unescape(situs.get('wa_label') or '') or '-'

    # --- widget ---
    info['widget_nyasar'] = situs['widget_nyasar']
    if paket_custom and situs['widget_nyasar'] and not tema_fse and not cfg.get('tema_fse'):
        temuan.append(f"widget_bawaan_tersisa:{situs['widget_nyasar']}")

    # --- kredit footer "Design by Velocity Developer" ---
    info['kredit_footer'] = 'ada' if situs.get('kredit_footer') else 'tidak ada'
    if not situs.get('kredit_footer'):
        temuan.append('kredit_footer_tidak_ada')

    # --- isi yang belum disunting ---
    sisa = sorted({t for t in TEKS_CONTOH if t in teks})
    if sisa:
        temuan.append('teks_contoh_belum_diganti:' + ','.join(sisa[:3]))
    info['media'] = situs['media']
    info['artikel'] = situs['artikel']
    if paket_custom and situs['media'] < 5:
        temuan.append(f"foto_terlalu_sedikit:{situs['media']}")

    # --- maintenance ---
    info['maintenance'] = bool(situs['maintenance'])
    if situs.get('maintenance_paket_g') and not situs['maintenance']:
        # Sengaja dibiarkan terbuka selama masa pembelajaran Paket G.
        info['maintenance'] = 'mati (sengaja, masa pembelajaran Paket G)'
    elif situs['maintenance_installer'] and not situs['maintenance']:
        # Installer pernah menyalakannya, sekarang mati: entah PM sudah serah
        # terima, entah mati sendiri. Wajib dikonfirmasi manusia.
        temuan.append('maintenance_mati_setelah_dinyalakan_installer')

    # --- dari luar ---
    ok_ssl, pesan_ssl = ssl_valid(domain)
    info['ssl'] = 'valid' if ok_ssl else pesan_ssl
    if not ok_ssl:
        temuan.append('ssl_tidak_valid')
    kode, _ = http(f'{situs_url(domain)}/wp-includes/css/dashicons.min.css', method='HEAD')
    info['aset_http'] = kode
    if kode != 200:
        temuan.append(f'aset_inti_http_{kode}')

    hasil = {'audit': 'temuan' if temuan else 'ok', 'temuan': temuan, 'info': info}
    if not hanya_json:
        print(f'Audit {domain} — paket {info["paket"]}')
        for k, v in info.items():
            print(f'  {k:18}: {v}')
        print('  temuan            : ' + (', '.join(temuan) if temuan else 'tidak ada'))
    print(json.dumps(hasil))
    return 0


if __name__ == '__main__':
    sys.exit(main())
