    $nav = get_posts(array('post_type' => 'wp_navigation', 'post_status' => 'publish', 'numberposts' => 1, 'orderby' => 'date', 'order' => 'DESC'));
    if ($nav && preg_match_all('/<!-- wp:navigation-(?:link|submenu) (\{.*?\}) \/?-->/', $nav[0]->post_content, $m)) {
        foreach ($m[1] as $j) {
            $a = json_decode($j, true);
            if (!empty($a['label'])) { $menu_items[] = $a['label']; }
        }
