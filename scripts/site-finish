REMOTE_MAINT = r'''
set -e
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done
[[ -n "$WP_BIN" ]] || { echo "wp-cli_missing"; exit 10; }
wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root; }
# Hanya sekali per situs: PM mematikan maintenance saat serah terima ke klien, dan
# apply ulang sesudahnya tidak boleh menyalakannya lagi.
if [[ -n "$(wp option get velocity_installer_maintenance 2>/dev/null || true)" ]]; then
  echo "maintenance_skip:sudah_pernah_diaktifkan_installer"
elif wp option get maintenance_mode >/dev/null 2>&1; then
  echo "maintenance_skip:sudah_diatur_manual"
elif ! wp plugin is-active velocity-addons >/dev/null 2>&1; then
  echo "maintenance_skip:velocity_addons_tidak_aktif"
else
  wp option update maintenance_mode_data "$MAINT_DATA" --format=json >/dev/null
  wp option update maintenance_mode 1 >/dev/null
  wp option update velocity_installer_maintenance "$(date -Is)" >/dev/null
  echo "maintenance_enabled"
fi
'''


REMOTE_CLEANUP = r'''
set -e
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done
[[ -n "$WP_BIN" ]] || { echo "wp-cli_missing"; exit 10; }
wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root; }
# Hanya bawaan WordPress yang tidak dipakai. Tema aktif dan induknya (velocity
# untuk child theme) wajib tetap ada; tema/plugin lain tidak disentuh.
active=$(wp theme list --status=active --field=name 2>/dev/null | head -1 || true)
parent=$(wp theme get "$active" --field=template 2>/dev/null || true)
for t in $(wp theme list --field=name 2>/dev/null || true); do
  [[ "$t" == "$active" || "$t" == "$parent" ]] && continue
  case "$t" in
    twenty*) wp theme delete "$t" >/dev/null 2>&1 && echo "theme_deleted:$t" || echo "theme_delete_failed:$t" ;;
  esac
done
for p in akismet hello hello-dolly; do
  if wp plugin is-installed "$p" >/dev/null 2>&1 && ! wp plugin is-active "$p" >/dev/null 2>&1; then
    wp plugin delete "$p" >/dev/null 2>&1 && echo "plugin_deleted:$p" || echo "plugin_delete_failed:$p"
  fi
done
echo "cleanup_done"
'''


REMOTE_WIDGET = r'''
set -e
export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
WP_BIN=""; for p in /usr/local/bin/wp /usr/bin/wp; do [[ -x "$p" ]] && WP_BIN="$p" && break; done
[[ -n "$WP_BIN" ]] || { echo "wp-cli_missing"; exit 10; }
wp() { php -d memory_limit=512M "$WP_BIN" "$@" --path="$DOCROOT" --allow-root; }
# Sekali per situs: kalau PM sudah menata widget sendiri sesudah ini, jangan diulang.
if [[ -n "$(wp option get velocity_widget_bersih 2>/dev/null || true)" ]]; then
  echo "widget_skip:sudah_pernah_dibersihkan"
else
  cat > /tmp/velocity-widget.php <<'PHP'
<?php
/**
 * Hapus widget yang tidak tertampil di mana pun: isi sidebar yang tidak lagi
 * terdaftar tema aktif, plus widget nonaktif. Widget di sidebar yang MASIH
 * terdaftar tidak disentuh, jadi tema yang memang memakai widget tetap aman.
 */
global $wp_registered_sidebars;
$aktif = array_keys((array) $wp_registered_sidebars);
$peta  = (array) get_option('sidebars_widgets', array());
$buang = array();
foreach ($peta as $sidebar => $isi) {
    if ($sidebar === 'array_version' || !is_array($isi)) {
        continue;
    }
    if ($sidebar !== 'wp_inactive_widgets' && in_array($sidebar, $aktif, true)) {
        continue;
    }
    foreach ($isi as $widget_id) {
        $buang[] = $widget_id;
    }
    $peta[$sidebar] = array();
}
$hapus = 0;
foreach ($buang as $widget_id) {
    if (!preg_match('/^(.+)-(\d+)$/', $widget_id, $m)) {
        continue;
    }
    $opsi = get_option('widget_' . $m[1]);
    if (is_array($opsi) && isset($opsi[(int) $m[2]])) {
        unset($opsi[(int) $m[2]]);
        update_option('widget_' . $m[1], $opsi);
        $hapus++;
    }
}
update_option('sidebars_widgets', $peta);
update_option('velocity_widget_bersih', date('c'));
echo 'widget_dihapus:' . $hapus . ':' . implode(',', array_slice($buang, 0, 12));
PHP
  wp eval-file /tmp/velocity-widget.php
  echo
  rm -f /tmp/velocity-widget.php
fi
'''


def bersihkan_widget(domain, da_user, ssh):
    """Buang widget bawaan WordPress yang tidak dipakai desain custom."""
    header = f'DOCROOT={shlex.quote(f"/home/{da_user}/domains/{domain}/public_html")}'
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE_WIDGET,
                         capture_output=True, text=True, timeout=180)
    for line in (run.stdout + '\n' + run.stderr).splitlines():
        if line.strip() and not line.startswith('Warning:'):
            print(f'widget: {line.strip()[:200]}')
    return 0 if run.returncode == 0 else 1


def cleanup_defaults(domain, da_user, ssh):
    """Hapus tema & plugin bawaan WordPress yang tidak dipakai (instalasi baru saja)."""
    header = f'DOCROOT={shlex.quote(f"/home/{da_user}/domains/{domain}/public_html")}'
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE_CLEANUP,
                         capture_output=True, text=True, timeout=300)
    for line in (run.stdout + '\n' + run.stderr).splitlines():
        if line.strip() and not line.startswith('Warning:'):
            print(f'cleanup: {line.strip()[:200]}')
    return 0 if run.returncode == 0 else 1


def titik_peta(domain, alamat):
    """Koordinat untuk iframe peta; kegagalan tidak boleh menghentikan finishing."""
    kosong = {'status': 'negara', 'lat': '-2.5489', 'lon': '118.0149',
              'zoom': '5', 'label': 'Indonesia', 'q': '-2.5489,118.0149'}
    try:
        hasil = subprocess.run([sys.executable, str(HERE / 'velocity-map'), domain,
                                '--alamat', alamat or ''],
                               capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.SubprocessError):
        return kosong
    nilai = {}
    for baris in hasil.stdout.splitlines():
        kunci, pisah, isi = baris.partition('=')
        if pisah:
            nilai[kunci.strip()] = isi.strip()
    return nilai if nilai.get('q') else kosong


def logo_media_key(logo, folder, contoh):
    """Kunci penanda media di WordPress supaya berkas yang sama tidak diunggah dua kali."""
    if not logo:
        return ''
    if contoh:
        return 'logo-contoh:' + str(logo.stat().st_size)
    return f'{logo.relative_to(folder)}:{logo.stat().st_size}'


def buat_logo_contoh(domain, nama, warna):
    """Panggil scripts/velocity-logo; kegagalan tidak boleh menghentikan finishing."""
    perintah = [sys.executable, str(HERE / 'velocity-logo'), domain, '--nama', nama]
    if warna:
        perintah += ['--primary', warna[0]]
        if len(warna) > 1:
            perintah += ['--accent', warna[1]]
    try:
        hasil = subprocess.run(perintah, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        print(f'finish: logo_contoh_gagal:{type(e).__name__}')
        return None
    nilai = {}
    for baris in hasil.stdout.splitlines():
        kunci, pisah, isi = baris.partition('=')
        if pisah:
            nilai[kunci.strip()] = isi.strip()
    logo = Path(nilai.get('png', '')) if nilai.get('png') else None
    if not logo or not logo.is_file():
        print(f'finish: logo_contoh_gagal:{nilai.get("error") or "png_tidak_ada"}')
        return None
    icon = Path(nilai['icon_png']) if nilai.get('icon_png') and Path(nilai['icon_png']).is_file() else None
    print(f'finish: logo_contoh_dibuat:{nilai.get("inisial", "")}')
    return {'logo': logo, 'icon': icon, 'svg': nilai.get('svg', '')}


def ssh_command(cfg, key):
    return ['ssh', '-i', key, '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
            '-o', 'ConnectTimeout=15', '-p', str(cfg.get('ssh_port') or 22),
            f"{cfg.get('ssh_user') or 'root'}@{cfg['target_host']}"]


def enable_maintenance(cfg, domain, da_user, ssh):
    """Langkah terakhir instalasi: tutup situs dengan maintenance mode velocity-addons
    sampai PM menyerahkannya ke klien."""
    title = cfg.get('site_title') or domain
    data = {'header': 'Website Sedang Disiapkan',
            'body': f'{title} sedang dalam tahap pengerjaan. Silakan kunjungi kembali dalam waktu dekat.',
            'background': 0}
    header = '\n'.join([f'DOCROOT={shlex.quote(f"/home/{da_user}/domains/{domain}/public_html")}',
                        f'MAINT_DATA={shlex.quote(json.dumps(data))}'])
    run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE_MAINT,
                         capture_output=True, text=True, timeout=180)
    out = [l.strip() for l in (run.stdout + '\n' + run.stderr).splitlines()
           if l.strip() and not l.startswith('Warning:')]
    for line in out:
        print(f'maintenance: {line[:200]}')
    if any('maintenance_enabled' in l for l in out):
        # Pastikan pengunjung tanpa login benar-benar melihat halaman perawatan.
        req = urllib.request.Request(f'https://{domain}/', headers={'User-Agent': 'velocity-installer/1.0'})
        try:
            try:
                with urllib.request.urlopen(req, timeout=25, context=ssl._create_unverified_context()) as resp:
                    page = resp.read().decode('utf-8', 'replace')
            except urllib.error.HTTPError as e:
                page = e.read().decode('utf-8', 'replace')
            print('maintenance: ' + ('maintenance_active' if 'maintenance-shell' in page else 'maintenance_not_visible'))
        except (urllib.error.URLError, OSError) as e:
            print(f'maintenance: maintenance_check_failed:{type(e).__name__}')
    return 0 if run.returncode == 0 else 1


def main():
    args = sys.argv[1:]
    maintenance = bool(args) and args[0] == '--maintenance'
    cleanup = bool(args) and args[0] == '--cleanup'
    widget = bool(args) and args[0] == '--widget'
    if maintenance or cleanup or widget:
        args = args[1:]
    if not args:
        print('usage: site-finish [--maintenance|--cleanup|--widget] <manifest>', file=sys.stderr)
        return 2
    cfg = read_manifest(args[0])
    domain = cfg.get('domain', '').lower()
    da_user = cfg.get('da_user', '')
    key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain) or not re.match(r'^[a-z][a-z0-9]*$', da_user):
        print('finish: manifest tidak valid')
        return 2
    if not key or not Path(key).is_file():
        print('finish: kunci SSH tidak ada')
        return 2
    ssh = ssh_command(cfg, key)
    if maintenance:
        return enable_maintenance(cfg, domain, da_user, ssh)
    if cleanup:
        return cleanup_defaults(domain, da_user, ssh)
    if widget:
        return bersihkan_widget(domain, da_user, ssh)
    folder = ON_PROGRESS / domain
    form = read_client_form(folder) if folder.is_dir() else {'fields': {}, 'text': ''}
    fields = form['fields']
    title = cfg.get('site_title') or domain
    wa = wa_number(field(fields, r'kontak utk di web|kontak untuk di web'))
    address = ', '.join(p for p in (field(fields, r'^alamat'), field(fields, r'^kota'), field(fields, r'^prop')) if p)
    tagline = slogan(form['text']) or ai_tagline(domain)
    css = colors_css(pick_colors(field(fields, r'warna tema')))
    logo, photos = client_assets(folder)
    # Klien sering menulis "logo menyusul". Supaya situs tidak tampil tanpa
    # identitas sama sekali, dibuatkan logo contoh dari nama + warna tema —
    # penanda sementara yang gampang diganti PM/desainer, bukan logo final.
    logo_contoh = None if logo else buat_logo_contoh(domain, title, pick_colors(field(fields, r'warna tema')))
    if logo_contoh:
        logo = logo_contoh.get('logo')
    size = image_size(logo) if logo else None
    icon_ok = bool(size and min(size) >= 256 and 0.8 <= size[0] / max(size[1], 1) <= 1.25)

    # Titik peta dicari sekali di sini (alamat -> kota -> provinsi -> Indonesia).
    peta = titik_peta(domain, address)
    print(f'finish: peta={peta["status"]} ({peta["label"] or peta["q"]})')

    stage = Path(tempfile.mkdtemp(prefix='velocity-finish-'))
    try:
        logo_file = icon_file = icon_key = ''
        if logo:
            logo_file = 'logo' + logo.suffix.lower()
            shutil.copy2(logo, stage / logo_file)
        if logo_contoh and logo_contoh.get('icon'):
            icon_file = 'icon' + logo_contoh['icon'].suffix.lower()
            shutil.copy2(logo_contoh['icon'], stage / icon_file)
            icon_key = 'logo-contoh-icon:' + str(logo_contoh['icon'].stat().st_size)
        photo_files, photo_keys = [], []
        for i, photo in enumerate(photos, 1):
            name = f'photo-{i:02d}{photo.suffix.lower()}'
            shutil.copy2(photo, stage / name)
            photo_files.append(name)
            photo_keys.append(f'{photo.relative_to(folder)}:{photo.stat().st_size}')
        remote_dir = f'/tmp/velocity-finish-{domain}'
        header = '\n'.join([
            f'DOCROOT={shlex.quote(f"/home/{da_user}/domains/{domain}/public_html")}',
            f'M={shlex.quote(remote_dir)}',
            f'DOMAIN={shlex.quote(domain)}',
            f'ADMIN={shlex.quote(cfg.get("admin_user") or da_user)}',
            f'LOGO_FILE={shlex.quote(logo_file)}',
            f'LOGO_KEY={shlex.quote(logo_media_key(logo, folder, bool(logo_contoh)))}',
            f'LOGO_CONTOH={1 if logo_contoh else 0}',
            f'ICON_FILE={shlex.quote(icon_file)}',
            f'ICON_KEY={shlex.quote(icon_key)}',
            f'ICON_OK={1 if icon_ok else 0}',
            'PHOTO_FILES=(' + ' '.join(shlex.quote(n) for n in photo_files) + ')',
            'PHOTO_KEYS=(' + ' '.join(shlex.quote(k) for k in photo_keys) + ')',
            f'MAP_QUERY={shlex.quote(peta["q"])}',
            f'MAP_ZOOM={shlex.quote(peta["zoom"])}',
            f'MAP_STATUS={shlex.quote(peta["status"])}',
            f'MAP_DATA={shlex.quote(json.dumps(peta))}',
            f'WA={shlex.quote(wa)}',
            # Nama kontak = LABEL AJAKAN, bukan nama situs. Untuk satu kontak,
            # plugin mencetak nama kontak itu sebagai tulisan tombol mengambang
            # ($contact['name'] ?: $whatsapp_text), jadi mengisinya dengan nama
            # perusahaan membuat tombolnya berbunyi nama web — bukan ajakan.
            # Pengunjung sudah tahu sedang membuka situs siapa.
            f'WA_LABEL={shlex.quote(WA_LABEL)}',
            f'WA_CONTACTS={shlex.quote(json.dumps([{"name": WA_LABEL, "number": wa}]) if wa else "")}',
            f'WA_MESSAGE={shlex.quote(f"Halo {title}, saya ingin bertanya.")}',
            f'TAGLINE={shlex.quote(tagline)}',
            f'CSS={shlex.quote(css)}',
        ])
        # Hanya secret per domain yang disalin dari catatan hosting PM; file password
        # bersama lama tidak boleh dipasang lagi. Dikirim lewat stdin, tidak dicetak.
        pw_file = cfg.get('da_password_file', '')
        if pw_file.startswith(f'/etc/velocity/secrets/da_password_{domain}') and Path(pw_file).is_file():
            password = Path(pw_file).read_text(errors='replace').strip()
            if password:
                header += f'\nexport WP_ADMIN_PASSWORD={shlex.quote(password)}'
        print(f'finish: logo={("contoh:" + logo.name) if logo_contoh else (logo.name if logo else "-")} foto={len(photos)} wa={"ya" if wa else "-"} '
              f'alamat={"ya" if address else "-"} tagline={"ya" if tagline else "-"} warna={"ya" if css else "-"}')
        tar = subprocess.Popen(['tar', '-czf', '-', '-C', str(stage), '.'], stdout=subprocess.PIPE)
        up = subprocess.run(ssh + [f'rm -rf {shlex.quote(remote_dir)} && mkdir -p {shlex.quote(remote_dir)} '
                                   f'&& tar -xzf - -C {shlex.quote(remote_dir)}'],
                            stdin=tar.stdout, capture_output=True, text=True, timeout=300)
        tar.wait()
        if up.returncode != 0:
            print(f'finish: gagal kirim aset ({up.stderr.strip()[:200]})')
            return 1
        run = subprocess.run(ssh + ['bash', '-s'], input=header + '\n' + REMOTE,
                             capture_output=True, text=True, timeout=600)
        for line in (run.stdout + '\n' + run.stderr).splitlines():
            if line.strip() and not line.startswith('Warning:'):
                print(f'finish: {line.strip()[:200]}')
        return 0 if run.returncode == 0 else 1
    finally:
        shutil.rmtree(stage, ignore_errors=True)


if __name__ == '__main__':
    sys.exit(main())
