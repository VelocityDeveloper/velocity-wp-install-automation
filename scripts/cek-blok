#!/usr/bin/env node
/*
 * Validasi markup blok memakai parser editor WordPress sendiri (@wordpress/blocks
 * + block-library): templates/parts/patterns tema FSE dan isi halaman buatan
 * scripts/fse-apply. Blok yang tidak valid di sini tampil "Blok ini berisi konten
 * yang tidak terduga" di editor — dan atribut yang tidak lagi dikenal dibuang
 * diam-diam, jadi hanya ketahuan dari tampilan (pelajaran birutourtravel.com).
 *
 * Pemakaian: cek-blok <berkas.html|.php> ...
 * Keluaran : "ok <berkas>" / "tidak_valid <berkas>: <blok>: <alasan>"
 * Kode keluar: 0 semua valid, 1 ada yang tidak valid, 3 alat belum terpasang.
 * Modul node dibaca dari VELOCITY_BLOCKVAL (bawaan /var/lib/velocity/tools/blockval).
 */
const fs = require('fs');
const path = require('path');
const util = require('util');

const akar = process.env.VELOCITY_BLOCKVAL || '/var/lib/velocity/tools/blockval';
const modul = (nama) => require(path.join(akar, 'node_modules', nama));
if (!fs.existsSync(path.join(akar, 'node_modules', '@wordpress', 'blocks'))) {
  console.log('cek_blok:alat_tidak_ada');
  process.exit(3);
}

const tulis = console.log.bind(console);
// Parser mencetak peringatan validasi sendiri; alasannya diambil dari validationIssues.
console.error = console.warn = console.info = console.log = () => {};

modul('global-jsdom')();
window.matchMedia = window.matchMedia || (() => ({ matches: false, addListener() {}, removeListener() {}, addEventListener() {}, removeEventListener() {} }));
global.requestAnimationFrame = global.requestAnimationFrame || ((cb) => setTimeout(cb, 0));

const blocks = modul('@wordpress/blocks');
modul('@wordpress/block-library').registerCoreBlocks();
// Blok dinamis tema (render.php): markupnya selalu self-closing. Daftarnya dibaca dari
// templates/tema-fse/blocks/*/block.json supaya blok baru tidak perlu ditulis dua kali.
const blokTema = path.join(__dirname, '..', 'templates', 'tema-fse', 'blocks');
const namaBlok = (fs.existsSync(blokTema) ? fs.readdirSync(blokTema) : [])
  .map((d) => path.join(blokTema, d, 'block.json'))
  .filter((f) => fs.existsSync(f))
  .map((f) => JSON.parse(fs.readFileSync(f, 'utf8')).name)
  .filter(Boolean);
for (const nama of namaBlok.length ? namaBlok : ['velocity/topbar', 'velocity/populer', 'velocity/kontak', 'velocity/form-kirim', 'velocity/hak-cipta', 'velocity/judul-arsip']) {
  blocks.registerBlockType(nama, { apiVersion: 3, title: nama, category: 'theme', edit: () => null, save: () => null });
}
// Blok Velocity Blocks (vb/*, templates/plugins/velocity-blocks): semua dirender PHP. Wadah
// menyimpan InnerBlocks.Content (tanpa pembungkus), sisanya save() null (self-closing).
// Daftar wadah dibaca dari assets/editor.js supaya blok baru tidak perlu ditulis dua kali.
const vbAkar = path.join(__dirname, '..', 'templates', 'plugins', 'velocity-blocks');
if (fs.existsSync(path.join(vbAkar, 'blocks'))) {
  const edJs = fs.readFileSync(path.join(vbAkar, 'assets', 'editor.js'), 'utf8');
  const wadah = new Set();
  const daftar = [...edJs.matchAll(/(?:daftarkan|pratinjau)\(\s*'(vb\/[a-z0-9-]+)'/g)];
  daftar.forEach((m, i) => {
    const akhir = i + 1 < daftar.length ? daftar[i + 1].index : edJs.length;
    if (edJs.slice(m.index, akhir).includes('InnerBlocks.Content')) wadah.add(m[1]);
  });
  const { InnerBlocks } = modul('@wordpress/block-editor');
  for (const d of fs.readdirSync(path.join(vbAkar, 'blocks'))) {
    const f = path.join(vbAkar, 'blocks', d, 'block.json');
    if (!fs.existsSync(f)) continue;
    const j = JSON.parse(fs.readFileSync(f, 'utf8'));
    blocks.registerBlockType(j.name, {
      apiVersion: 3, title: j.name, category: 'widgets', attributes: j.attributes || {},
      supports: j.supports || {}, parent: j.parent, edit: () => null,
      save: wadah.has(j.name) ? () => modul('@wordpress/element').createElement(InnerBlocks.Content) : () => null,
    });
  }
}
// Blok Contact Form 7 (formulir situs sejak 2026-09-19): save() disalin dari plugin
// (includes/block-editor/index.js) — div berisi shortcode form.
const el = modul('@wordpress/element');
blocks.registerBlockType('contact-form-7/contact-form-selector', {
  apiVersion: 3, title: 'Contact Form 7', category: 'widgets',
  attributes: { id: { type: 'integer' }, hash: { type: 'string' }, title: { type: 'string' },
    htmlId: { type: 'string' }, htmlName: { type: 'string' }, htmlTitle: { type: 'string' },
    htmlClass: { type: 'string' }, output: { enum: ['form', 'raw_form'], default: 'form' } },
  edit: () => null,
  save: ({ attributes: t }) => {
    let e = '[contact-form-7]';
    const tambah = (s) => { e = e.replace(/\]$/, ` ${s}]`); };
    if (t.hash) tambah(`id="${t.hash}"`); else if (t.id) tambah(`id="${t.id}"`);
    if (t.title) tambah(`title="${t.title}"`);
    if (t.htmlId) tambah(`html_id="${t.htmlId}"`);
    if (t.htmlName) tambah(`html_name="${t.htmlName}"`);
    if (t.htmlTitle) tambah(`html_title="${t.htmlTitle}"`);
    if (t.htmlClass) tambah(`html_class="${t.htmlClass}"`);
    if (t.output === 'raw_form') tambah(`output="${t.output}"`);
    return el.createElement('div', { className: 'wp-block-contact-form-7-contact-form-selector' }, e);
  },
});

function periksa(daftar, jejak, masalah) {
  for (const b of daftar) {
    if (!b.name) continue;
    if (b.name === 'core/missing') {
      masalah.push(b.attributes.originalName
        ? `${jejak}${b.attributes.originalName}: blok tidak dikenal`
        : `${jejak}HTML di luar blok: ${String(b.attributes.originalContent || '').trim().slice(0, 80)}`);
    } else if (b.name === 'core/freeform' && String(b.attributes.content || '').trim()) {
      masalah.push(`${jejak}HTML di luar blok: ${String(b.attributes.content).trim().slice(0, 80)}`);
    } else if (!b.isValid) {
      const alasan = (b.validationIssues || []).map((i) => util.format(...(i.args || []))).join(' | ');
      masalah.push(`${jejak}${b.name}: ${alasan.replace(/\s+/g, ' ').slice(0, 400)}`);
    }
    periksa(b.innerBlocks || [], `${jejak}${b.name} > `, masalah);
  }
}

let gagal = 0;
for (const berkas of process.argv.slice(2)) {
  let isi = fs.readFileSync(berkas, 'utf8');
  if (berkas.endsWith('.php')) {
    // Pattern: buang kepala docblock, ganti sisipan PHP dengan teks biasa.
    isi = isi.replace(/^<\?php[\s\S]*?\?>\s*/, '').replace(/<\?php[\s\S]*?\?>/g, 'x');
  }
  const masalah = [];
  periksa(blocks.parse(isi), '', masalah);
  if (masalah.length) {
    gagal = 1;
    for (const m of masalah) tulis(`tidak_valid ${berkas}: ${m}`);
  } else {
    tulis(`ok ${berkas}`);
  }
}
process.exit(gagal);
