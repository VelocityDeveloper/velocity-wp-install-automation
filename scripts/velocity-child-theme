#!/usr/bin/env python3
"""Tentukan child theme Velocity dari referensi desain di FORM ISIAN klien.

Pemakaian: velocity-child-theme <domain> [--paket NAMA] [--override SLUG] [--no-download]

Klien menulis pilihannya di form, mis. "Template yang dipilih:
https://beritab2.velocitydeveloper.com/" atau "DESIGN YANG DIPILIH: ...".
Referensi itu dicocokkan dengan daftar tema di api.velocitydeveloper.co; kalau
ada, zip-nya diunduh (disimpan per slug + versi) untuk dipasang installer.
`--override` (dari manifest `velocity_child_theme=`) memilih slug secara langsung.

Paket E tidak memilih template juga: child theme-nya sudah baku (`velocity-pakete`),
jadi slug itu langsung dicari di API tanpa membaca referensi di form.

Paket G tidak memilih template: desainnya dibuat khusus per project, jadi
form-nya tidak pernah memuat referensi. Untuk paket itu child theme kosong
bernama project dibuat di sini (`velocity-<label domain>`) supaya desainer
langsung punya tempat kerja dan situs tidak berhenti di tema induk.

Keluaran baris key=value: status (matched | generated | not_found | no_ref |
api_error | download_failed), ref, slug, version, zip, error.
"""
import argparse
import datetime
import hashlib
import json
import re
import shutil
import struct
import sys
import urllib.request
import zipfile
import zlib
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
from client_form import read_client_form  # noqa: E402

API_URL = 'https://api.velocitydeveloper.co/api/v1/themes'
ON_PROGRESS = Path('/home/On Progress')
CACHE = Path('/var/lib/velocity/packages/child-themes')
GENERATED_DIR = Path('/var/lib/velocity/ai/generated')
# Signature API = md5(dmY) menurut tanggal kantor (WIB).
WIB = datetime.timezone(datetime.timedelta(hours=7))
DOMAIN_RE = re.compile(r'^[a-z0-9.-]+\.[a-z]{2,}$')
SLUG_RE = re.compile(r'^[a-z0-9-]+$')
HEX_RE = re.compile(r'^#[0-9a-fA-F]{6}$')
SUB = re.compile(r'([a-z0-9-]+)\.velocitydeveloper\.com', re.I)
LABEL = re.compile(r'(template|design|desain)\s+yang\s+(di)?pilih', re.I)
UA = {'User-Agent': 'velocity-installer/1.0'}
# Paket yang desainnya custom per project: child theme-nya digenerate, bukan
# dicocokkan ke API. norm() dipakai supaya "Paket G" / "paket g" sama saja.
# Paket desain custom: child theme digenerate bernama project. Portal Berita Custom
# memakai template yang sama dengan varian berita (keputusan user 2026-09-14).
SCAFFOLD_PAKET = {'paketg', 'paketportalberitacustom'}
SCAFFOLD_VERSION = '1.1.0'
# Paket yang child theme-nya sudah baku: paketnya sendiri yang menentukan tema,
# bukan referensi desain di form (keputusan user 2026-09-16). Slug diambil apa
# adanya dari API tema Velocity, jadi versi barunya ikut tanpa mengubah kode.
PAKET_SLUG = {'pakete': 'velocity-pakete'}
# Kerangka desain Paket G: berkas tema lengkap dengan placeholder {{KUNCI}}.
TEMPLATE_DIR = HERE.parent / 'templates' / 'child-theme-paket-g'
PREFIX_RE = re.compile(r'^[a-z][a-z0-9]{1,11}$')
WARNA_DEFAULT = {'primary': '#14213d', 'aksen': '#fca311', 'ink': '#1b1b1f'}
# Ambang kontras teks badan menurut WCAG AA. Latar yang tidak mencapainya
# digeser sampai lolos — situs klien tidak boleh terbit dengan teks samar.
KONTRAS_MINIMAL = 4.5


def norm(value):
    return re.sub(r'[^a-z0-9]', '', str(value or '').lower())


def design_ref(text):
    """Subdomain desain pilihan klien, atau '' kalau tidak jelas.

    Form juga memuat daftar contoh desain bawaan template (bisnis1, perusahaan1,
    berita1..18, dst.) yang identik di semua form, jadi hanya nilai di label
    "... yang dipilih" yang dipercaya."""
    lines = [l.strip() for l in text.splitlines()]
    for i, line in enumerate(lines):
        label = LABEL.search(line)
        if not label:
            continue
        m = SUB.search(line[label.end():])
        if m and m.group(1).lower() != 'www':
            return m.group(1).lower()
        # Nilai kadang jatuh ke baris berikutnya (hyperlink Word jadi paragraf
        # sendiri); sesudahnya form berisi daftar contoh, jadi berhenti di sana.
        for nxt in lines[i + 1:i + 5]:
            if not nxt or nxt.upper().startswith('HYPERLINK'):
                continue
            if 'pilihannya' in nxt.lower() or nxt.lower().startswith('www.'):
                break
            m = re.match(r'https?://([a-z0-9-]+)\.velocitydeveloper\.com', nxt, re.I)
            if m and m.group(1).lower() != 'www':
                return m.group(1).lower()
            break
    # Form paket khusus (mis. SIA) hanya menyebut satu desain tanpa label.
    subs = {s.lower() for s in SUB.findall(text)} - {'www'}
    return subs.pop() if len(subs) == 1 else ''


def fetch_themes():
    signature = hashlib.md5(datetime.datetime.now(WIB).strftime('%d%m%Y').encode()).hexdigest()
    headers = dict(UA, signature=signature, Accept='application/json')
    items, page = [], 1
    while True:
        req = urllib.request.Request(f'{API_URL}?page={page}', headers=headers)
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.load(resp)
        items.extend(data.get('data') or [])
        meta = data.get('meta') or {}
        if page >= int(meta.get('last_page') or 1) or page >= 20:
            return items
        page += 1


def theme_keys(theme):
    slug = str(theme.get('slug') or '').lower()
    name = re.sub(r'\b(velocity|child)\b', '', str(theme.get('name') or ''), flags=re.I)
    return {norm(re.sub(r'^velocity-|-child$', '', slug)), norm(name)} - {''}


def zip_tembolok(slug):
    """Zip tema yang pernah diunduh, versi terbaru (mtime). Kosong = belum pernah."""
    if not CACHE.is_dir():
        return None
    zips = sorted(CACHE.glob(f'{slug}-*.zip'), key=lambda f: f.stat().st_mtime)
    return zips[-1] if zips else None


def download(theme):
    slug, version = theme['slug'], str(theme.get('version') or '0')
    url = theme.get('package_file_url') or theme.get('package_external_url')
    if not url:
        raise ValueError('tidak ada link unduhan')
    CACHE.mkdir(parents=True, exist_ok=True)
    dest = CACHE / f'{slug}-{re.sub(r"[^0-9A-Za-z.]", "", version)}.zip'
    if dest.is_file():
        return dest
    tmp = dest.with_suffix('.tmp')
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=120) as resp, \
            open(tmp, 'wb') as out:
        shutil.copyfileobj(resp, out)
    try:
        with zipfile.ZipFile(tmp) as z:
            tops = {n.split('/')[0] for n in z.namelist() if n.strip('/')}
        # install_from_zip memasang ke wp-content/themes/<slug>, jadi folder di
        # dalam zip harus bernama slug yang sama.
        if tops != {slug}:
            raise ValueError(f'isi zip tidak sesuai slug: {sorted(tops)[:3]}')
    except (zipfile.BadZipFile, ValueError):
        tmp.unlink(missing_ok=True)
        raise
    tmp.replace(dest)
    return dest


def paket_from_folder(domain):
    """Paket dari nama file form di folder klien, mis. "FORM ISIAN WEBSITE - paket g.doc".

    Penopang kalau manifest tidak punya `paket=` (CRM tak terbaca saat manifest
    dibuat). Diperiksa 2026-09-12 atas 22 folder antrean: 5 file bernama "paket g",
    4 di antaranya memang Paket G di CRM dan sisanya paketnya kosong — tidak ada
    paket lain (E/F/Portal/Toko) yang filenya bernama begitu."""
    folder = ON_PROGRESS / domain
    if not folder.is_dir():
        return ''
    for item in folder.iterdir():
        m = item.is_file() and re.search(r'paket[ _-]*([a-z])\b', item.name, re.I)
        if m:
            return f'paket {m.group(1).lower()}'
    return ''


def scaffold_slug(domain):
    """`velocity-<label domain>`: nama folder child theme sesuai nama project."""
    label = re.sub(r'-{2,}', '-', re.sub(r'[^a-z0-9-]+', '-', domain.split('.')[0])).strip('-')
    return f'velocity-{label}'[:62].rstrip('-')


def scaffold_png(width=1200, height=900, rgb=(31, 42, 68)):
    """Screenshot polos supaya child theme tidak tampil tanpa gambar di
    Appearance > Themes. PIL tidak ada di server ini, jadi PNG-nya ditulis langsung."""
    raw = b''.join(b'\x00' + bytes(rgb) * width for _ in range(height))

    def chunk(tag, data):
        body = tag + data
        return struct.pack('>I', len(data)) + body + struct.pack('>I', zlib.crc32(body) & 0xffffffff)

    return (b'\x89PNG\r\n\x1a\n'
            + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0))
            + chunk(b'IDAT', zlib.compress(raw, 9))
            + chunk(b'IEND', b''))


def hex_ke_rgb(nilai):
    nilai = nilai.lstrip('#')
    return tuple(int(nilai[i:i + 2], 16) for i in (0, 2, 4))


def geser_terang(nilai, faktor):
    """Versi lebih terang (faktor>0) atau lebih gelap (faktor<0) dari satu warna."""
    r, g, b = hex_ke_rgb(nilai)
    if faktor >= 0:
        r, g, b = (round(c + (255 - c) * faktor) for c in (r, g, b))
    else:
        r, g, b = (round(c * (1 + faktor)) for c in (r, g, b))
    return '#%02x%02x%02x' % (max(0, min(255, r)), max(0, min(255, g)), max(0, min(255, b)))


def kanal_linear(nilai):
    nilai = nilai / 255
    return nilai / 12.92 if nilai <= 0.03928 else ((nilai + 0.055) / 1.055) ** 2.4


def luminansi(warna):
    """Luminansi relatif WCAG; dipakai untuk menghitung rasio kontras."""
    r, g, b = (kanal_linear(c) for c in hex_ke_rgb(warna))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def kontras(a, b):
    terang, gelap = sorted((luminansi(a), luminansi(b)), reverse=True)
    return (terang + 0.05) / (gelap + 0.05)


def teks_di_atas(latar, gelap=None):
    """Putih atau tinta — mana yang lebih terbaca di atas warna latar ini."""
    gelap = gelap or WARNA_DEFAULT['ink']
    return '#ffffff' if kontras(latar, '#ffffff') >= kontras(latar, gelap) else gelap


def perbaiki_kontras(latar, minimal=KONTRAS_MINIMAL, gelap=None):
    """Geser latar sampai teks di atasnya terbaca.

    Warna pilihan klien kadang berada di tengah rentang terang-gelap, sehingga
    teks putih maupun hitam sama-sama tipis di atasnya. Daripada menerbitkan
    situs yang sulit dibaca, warnanya digelapkan/diterangkan secukupnya — dan
    penyesuaiannya dilaporkan supaya bisa dilihat manusia.
    """
    gelap = gelap or WARNA_DEFAULT['ink']
    warna = latar
    for _ in range(14):
        depan = teks_di_atas(warna, gelap)
        if kontras(warna, depan) >= minimal:
            return warna, depan
        # Arah penyesuaian mengikuti sisi terdekat: yang sudah gelap digelapkan.
        warna = geser_terang(warna, -0.08 if depan == '#ffffff' else 0.08)
    return warna, teks_di_atas(warna, gelap)


NOMOR_RE = re.compile(r'(?:\+?62|0)8[\d\s.-]{7,14}\d')
EMAIL_RE = re.compile(r'[\w.+-]+@[\w-]+\.[\w.-]+')


def nomor_wa(teks):
    """Nomor pertama dalam format 628…; '' kalau tidak ada nomor yang sah.

    Isian klien bisa berisi beberapa nomor ("0812… / 0821…"): menggabung digitnya
    menghasilkan nomor rusak, jadi yang diambil nomor pertama saja."""
    cocok = NOMOR_RE.search(str(teks or ''))
    if not cocok:
        return '', ''
    tampil = re.sub(r'\s+', ' ', cocok.group(0)).strip()
    digit = re.sub(r'\D', '', tampil)
    wa = '62' + digit[1:] if digit.startswith('0') else digit
    return (wa, tampil) if re.match(r'^628\d{7,11}$', wa) else ('', '')


def data_compro(domain):
    """Hasil scripts/compro-klien, kalau folder klien punya company profile."""
    try:
        return json.loads((Path('/var/lib/velocity/compro') / domain / 'compro.json').read_text())
    except (OSError, ValueError):
        return {}


def alamat_kontak_web(teks):
    """Baris beralamat dari isian "Kontak utk di web" (bukan biodata pemilik)."""
    pola = re.compile(r'\b(jl|jalan|kabupaten|kab|kecamatan|kec|desa|kelurahan|kota|rt|rw|blok|perumahan|gedung|ruko)\b', re.I)
    baris = [b.strip(' ,.') for b in re.split(r'[\n;]+', str(teks or '')) if pola.search(b)]
    return ', '.join(baris)


def data_klien(domain, nama=''):
    """Nama, kontak, dan alamat dari FORM ISIAN, untuk mengisi inc/theme-data.php.

    Kontak PUBLIK hanya dari "Kontak utk di web" atau dokumen tambahan klien
    (company profile). WhatsApp & email di biodata pemilik adalah data
    administrasi ("untuk pemberitahuan perpanjangan") dan tidak pernah tampil
    di situs — email pemilik hanya dipakai sebagai penerima form pemesanan.
    """
    folder = ON_PROGRESS / domain
    try:
        form = read_client_form(folder)
    except Exception:
        form = {'fields': {}, 'text': ''}
    fields, teks_form = form.get('fields') or {}, form.get('text') or ''

    def field(pola):
        return next((str(v).strip() for k, v in fields.items() if re.search(pola, k, re.I)), '')

    # Dokumen tambahan (bukan form): company profile, katalog, konsep.
    dokumen = ''
    try:
        from client_docs import collect_client_docs
        dokumen = '\n'.join(t for n, t in collect_client_docs(folder).get('sources', [])
                            if not n.upper().startswith('FORM ISIAN'))
    except Exception:
        pass

    nama = nama.strip() or field(r'nama perusahaan|nama media') or domain.split('.')[0].replace('-', ' ').title()
    kontak_web = field(r'kontak utk di web|kontak untuk di web')
    wa, telp = nomor_wa(kontak_web)
    if not wa:
        wa, telp = nomor_wa(dokumen)

    calon_email = [e for e in EMAIL_RE.findall(kontak_web) + EMAIL_RE.findall(dokumen)
                   if not re.search(r'velocity|example', e, re.I)]
    # Dari daftar kotak surat (mis. catatan email domain buatan PM), alamat peran
    # seperti info@/cs@ lebih pantas tampil daripada kotak surat perorangan.
    peran = [e for e in calon_email if re.match(r'^(info|cs|hello|halo|kontak|contact|sales|marketing|admin)@', e, re.I)]
    email_publik = (peran or calon_email or [''])[0]
    # Penerima pesanan boleh email pemilik: tidak ditampilkan ke pengunjung.
    penerima = email_publik or next((e for e in EMAIL_RE.findall(field(r'^e-?mail') + ' ' + teks_form)
                                     if not re.search(r'velocity|example', e, re.I)), '')

    kota = re.sub(r'^\s*(kota(\s+adm(inistrasi)?\.?)?|kab(upaten)?\.?)\s+', '', field(r'^kota'), flags=re.I).strip()
    provinsi = field(r'^prop|^provinsi')
    kodepos = field(r'^kode ?pos')
    alamat = re.sub(r'\s*,\s*(,\s*)+', ', ', field(r'^alamat')).strip(' ,')
    if not kota:
        cocok = re.search(r'(?:Kota(?:\s+Adm\.?)?|Kab(?:upaten)?\.?)\s+([A-Za-z .]+?)(?:,|$)', alamat)
        kota = cocok.group(1).strip() if cocok else ''
    bagian = [alamat]
    for tambahan in (kota, ' '.join(x for x in (provinsi, kodepos) if x)):
        if tambahan and tambahan.lower() not in alamat.lower():
            bagian.append(tambahan)
    # Alamat usaha di kaki halaman company profile memang untuk publik; alamat
    # biodata FORM ISIAN adalah data administrasi pemilik dan hanya cadangan.
    alamat_compro = data_compro(domain).get('alamat', '')
    return {
        'NAMA': nama[:80],
        'WA': wa,
        'TELP': telp[:25],
        'EMAIL': penerima or f'admin@{domain}',
        'EMAIL_PUBLIK': email_publik,
        # Alamat biodata FORM ISIAN ("Alamat lengkap" pemilik) hanya dipakai kalau
        # memang tidak ada bagian biodata terpisah; anaksegalabangsa.com sempat
        # menampilkan alamat rumah pemilik di footer. Kota tetap dipakai untuk peta.
        'ALAMAT': (alamat_compro or alamat_kontak_web(kontak_web)
                   or ('' if re.search(r'BIO\s*A?DATA|data ini kami gunakan untuk administrasi', teks_form, re.I)
                       else ', '.join(b for b in bagian if b)))[:200],
        'AREA': kota or provinsi or 'sekitarnya',
    }


def php_nilai(nilai, indent=5):
    """Literal array PHP dari data Python (string di-escape untuk kutip tunggal)."""
    jarak = '    ' * indent
    if isinstance(nilai, str):
        return "'" + nilai.replace('\\', '\\\\').replace("'", "\\'") + "'"
    if isinstance(nilai, bool):
        return 'true' if nilai else 'false'
    if isinstance(nilai, (int, float)):
        return str(nilai)
    if isinstance(nilai, list):
        if all(isinstance(v, str) for v in nilai):
            return 'array(' + ', '.join(php_nilai(v) for v in nilai) + ')'
        isi = ',\n'.join(jarak + '    ' + php_nilai(v, indent + 1) for v in nilai)
        return 'array(\n' + isi + ',\n' + jarak + ')'
    if isinstance(nilai, dict):
        aman = lambda k: str(k).replace('\\', '\\\\').replace("'", "\\'")
        return 'array(' + ', '.join(f"'{aman(k)}' => {php_nilai(v, indent)}" for k, v in nilai.items()) + ')'
    return "''"


def isi_netral(area):
    """Cadangan terakhir kalau isi contoh AI tidak tersedia (mis. model AI mati)."""
    return {
        'hero_judul': '', 'hero_teks': 'Sampaikan kebutuhan Anda dan tim kami akan menindaklanjutinya.',
        'hero_poin': ['Ditangani tim sendiri', 'Penawaran tertulis sebelum pengerjaan', f'Area layanan {area}'],
        'layanan': [{'slug': s, 'judul': j, 'teks': 'Jelaskan layanan ini di sini.',
                     'rincian': ['Rincian pertama', 'Rincian kedua', 'Rincian ketiga']}
                    for s, j in (('satu', 'Layanan Utama'), ('dua', 'Layanan Kedua'),
                                 ('tiga', 'Layanan Ketiga'), ('empat', 'Layanan Keempat'))],
        'produk': [{'slug': f'produk-{i}', 'judul': j, 'teks': 'Keterangan singkat produk.'}
                   for i, j in enumerate(('Produk Pertama', 'Produk Kedua', 'Produk Ketiga', 'Produk Keempat'), 1)],
        'keunggulan': [{'ikon': 'area', 'judul': 'Area Layanan Jelas', 'teks': f'Melayani wilayah {area}.'},
                       {'ikon': 'satu', 'judul': 'Satu Pintu', 'teks': 'Ditangani satu tim dari awal sampai selesai.'},
                       {'ikon': 'rab', 'judul': 'Lingkup Tertulis', 'teks': 'Ruang lingkup disepakati sebelum pengerjaan.'},
                       {'ikon': 'chat', 'judul': 'Konsultasi Dulu', 'teks': 'Sampaikan rencana Anda lewat WhatsApp.'}],
        'alur': [{'judul': j, 'teks': t} for j, t in (('Konsultasi', 'Ceritakan kebutuhan Anda.'),
                 ('Peninjauan', 'Kebutuhan diperiksa.'), ('Penawaran', 'Rincian disusun tertulis.'),
                 ('Pengerjaan', 'Pekerjaan berjalan terpantau.'), ('Serah Terima', 'Pemeriksaan akhir bersama.'))],
        'galeri': [{'slug': f'galeri-{i}', 'judul': f'Dokumentasi {i}'} for i in range(1, 7)],
        # Data perusahaan tidak pernah dicontohkan: kosong berarti seksinya disembunyikan.
        'slogan': '', 'profil': '', 'visi': '', 'misi': [], 'moto': '',
        'struktur': [], 'customer': [], 'legalitas': [], 'target': [],
        # Judul seksi netral; paket-g-konten menggantinya dengan judul sesuai bidang usaha.
        'judul_seksi': {}, 'form_kolom_tambahan': [],
    }


def muat_isi_contoh(domain):
    """Isi contoh hasil scripts/paket-g-konten, atau None kalau belum ada."""
    berkas = GENERATED_DIR / f'{domain}-tema.json'
    try:
        return json.loads(berkas.read_text()) if berkas.is_file() else None
    except (OSError, ValueError):
        return None


def blok_isi(domain, nama, area):
    """Baris PHP untuk kunci isi di theme-data.php."""
    isi = muat_isi_contoh(domain) or isi_netral(area)
    kunci = ('hero_judul', 'hero_teks', 'hero_poin', 'layanan', 'produk', 'keunggulan', 'alur', 'galeri',
             'slogan', 'profil', 'visi', 'misi', 'moto', 'struktur', 'customer', 'legalitas', 'target',
             'judul_seksi', 'form_kolom_tambahan', 'prakata', 'gaya', 'subjudul', 'seksi', 'hero_opasitas',
             'jenis', 'rubrik', 'tentang', 'redaksi')
    kosong = {'misi': [], 'struktur': [], 'customer': [], 'legalitas': [], 'target': [],
              'judul_seksi': {}, 'form_kolom_tambahan': [], 'prakata': {}, 'seksi': [],
              'rubrik': [], 'redaksi': []}
    # Company profile menentukan gaya & urutan beranda: 'seksi' kosong berarti
    # template memakai susunan bawaan (situs tanpa compro tidak berubah).
    compro = data_compro(domain)
    if compro.get('seksi'):
        isi = dict(isi)
        isi.setdefault('gaya', 'compro')
        isi.setdefault('subjudul', compro.get('subjudul', ''))
        isi.setdefault('seksi', [{'jenis': x['jenis'], 'judul': x['judul'], 'kunci': x['kunci']}
                                 for x in compro['seksi'] if x.get('jenis')])
        if not isi.get('prakata') and (compro.get('prakata') or {}).get('paragraf'):
            isi['prakata'] = compro['prakata']
        sampul = next((x for x in compro['seksi'] if x.get('jenis') == 'sampul'), {})
        foto_sampul = next((f for f in compro.get('foto') or []
                            if Path(f.get('berkas', '')).name in (sampul.get('foto') or [])[:1]), {})
        if foto_sampul.get('opasitas'):
            isi.setdefault('hero_opasitas', str(foto_sampul['opasitas']))
    baris = []
    for k in kunci:
        nilai = isi.get(k, kosong.get(k, ''))
        if k == 'hero_judul' and not nilai:
            nilai = nama
        if k in ('layanan', 'produk', 'galeri'):
            # Kata kunci foto hanya untuk pencari foto, bukan untuk tema.
            nilai = [{kk: vv for kk, vv in item.items() if kk != 'foto'} for item in nilai]
        baris.append(f"                '{k}' => {php_nilai(nilai, 4)},")
    return '\n'.join(baris)


GELAP = '#161616'


def depan_terbaca(warna, latar, arah):
    """Geser warna teks/ikon (arah -1 gelap, +1 terang) sampai terbaca di semua latar."""
    for _ in range(16):
        if all(kontras(warna, l) >= KONTRAS_MINIMAL for l in latar):
            return warna
        warna = geser_terang(warna, 0.1 * arah)
    return warna


def gaya_warna(domain, primary, aksen, di_primary):
    """Warna tambahan: latar halaman, sorot, dan versi terbaca aksen/sorot.

    Aksen merah di atas navy (menu aktif, label hero, ikon) pernah lolos terbit
    dengan rasio di bawah 4.5 — penjaganya hanya menguji teks putih di latar
    berwarna. Sekarang setiap pemakaian warna sebagai TEKS punya versinya sendiri."""
    compro = data_compro(domain)
    warna = compro.get('warna') or {}
    latar = compro.get('latar') if HEX_RE.match(compro.get('latar') or '') else '#f7f8fa'
    # Sorot jadi latar tab nomor: digeser seperlunya supaya angka di atasnya terbaca.
    sorot = perbaiki_kontras(warna['sorot'])[0] if HEX_RE.match(warna.get('sorot') or '') else aksen
    sorot_2 = warna.get('sorot_2') if HEX_RE.match(warna.get('sorot_2') or '') else sorot
    di_primary_aksen = depan_terbaca(aksen, [primary], +1)
    if kontras(di_primary_aksen, primary) < KONTRAS_MINIMAL:
        di_primary_aksen = di_primary
    return {
        'LATAR': latar,
        'GELAP': GELAP,
        'SOROT': sorot,
        'DI_SOROT': teks_di_atas(sorot),
        'SOROT_TEKS': depan_terbaca(sorot, ['#ffffff', latar], -1),
        'SOROT_DI_GELAP': depan_terbaca(sorot_2, [GELAP], +1),
        'AKSEN_TEKS': depan_terbaca(aksen, ['#ffffff', latar], -1),
        'AKSEN_DI_PRIMARY': di_primary_aksen,
    }


def nilai_template(slug, domain, nama, prefix, primary, aksen, ink):
    data = data_klien(domain, nama)
    # Nama media/usaha yang di form ditulis menyambung ("anaksegalabangsa") boleh
    # ditampilkan berspasi dari isi contoh — hanya kalau huruf & urutannya sama.
    tampil = str((muat_isi_contoh(domain) or {}).get('nama_tampil') or '')
    if tampil and re.sub(r'[^a-z0-9]', '', tampil.lower()) == re.sub(r'[^a-z0-9]', '', data['NAMA'].lower()):
        data['NAMA'] = tampil[:80]
    # Latar berwarna dipastikan cukup kontras dulu, baru warna teksnya dipilih.
    primary, di_primary = perbaiki_kontras(primary, gelap=ink)
    aksen, di_aksen = perbaiki_kontras(aksen, gelap=ink)
    data['DATA_ISI'] = blok_isi(domain, data['NAMA'], data['AREA'])
    data.update({
        'ON_PRIMARY': di_primary,
        'ON_PRIMARY_RGB': ', '.join(str(c) for c in hex_ke_rgb(di_primary)),
        'ON_AKSEN': di_aksen,
        'PREFIX': prefix,
        'PREFIX_UPPER': prefix.upper(),
        'SLUG': slug,
        'THEME_NAME': ' '.join(w.capitalize() for w in slug.split('-')),
        'DOMAIN': domain,
        'PRIMARY': primary,
        'PRIMARY_2': selaraskan(geser_terang(primary, 0.12), di_primary),
        'PRIMARY_3': selaraskan(geser_terang(primary, -0.28), di_primary),
        'AKSEN': aksen,
        'AKSEN_2': selaraskan(geser_terang(aksen, -0.14), di_aksen),
        'INK': ink,
        'PRIMARY_RGB': ', '.join(str(c) for c in hex_ke_rgb(primary)),
        'PRIMARY_3_RGB': ', '.join(str(c) for c in hex_ke_rgb(selaraskan(geser_terang(primary, -0.28), di_primary))),
        'AKSEN_RGB': ', '.join(str(c) for c in hex_ke_rgb(aksen)),
    })
    data.update(gaya_warna(domain, primary, aksen, di_primary))
    return data


def isi_template(teks, nilai):
    """Ganti {{KUNCI}} dengan nilainya; yang tidak dikenal dibiarkan agar ketahuan."""
    def ganti(m):
        kunci = m.group(1)
        if kunci not in nilai:
            raise KeyError(f'placeholder tidak dikenal: {kunci}')
        return str(nilai[kunci])
    return re.sub(r'\{\{([A-Z0-9_]+)\}\}', ganti, teks)


def berkas_template(nilai):
    """Semua berkas child theme hasil render, siap dibungkus jadi zip."""
    if not TEMPLATE_DIR.is_dir():
        raise FileNotFoundError(f'template hilang: {TEMPLATE_DIR}')
    hasil = {}
    for sumber in sorted(TEMPLATE_DIR.rglob('*')):
        if not sumber.is_file():
            continue
        nama = str(sumber.relative_to(TEMPLATE_DIR))
        hasil[nama] = isi_template(sumber.read_text(), nilai)
    if not hasil:
        raise FileNotFoundError('template kosong')
    hasil['screenshot.png'] = scaffold_png(rgb=hex_ke_rgb(nilai['PRIMARY']))
    return hasil


def laporan_kontras(primary, aksen, domain=''):
    """Ringkasan "warna -> warna teks (rasio)" untuk dibaca operator."""
    bagian = []
    for nama, minta in (('utama', primary), ('aksen', aksen)):
        awal = minta if HEX_RE.match(minta or '') else WARNA_DEFAULT['primary' if nama == 'utama' else 'aksen']
        akhir, depan = perbaiki_kontras(awal)
        turunan = (selaraskan(geser_terang(akhir, 0.12), depan),
                   selaraskan(geser_terang(akhir, -0.28), depan))
        paling_tipis = min(kontras(akhir, depan), *(kontras(t, depan) for t in turunan))
        catatan = f'{nama}:{akhir}/{depan}:{paling_tipis:.1f}'
        if akhir.lower() != awal.lower():
            catatan += f'(disesuaikan dari {awal})'
        bagian.append(catatan)
    # Warna yang dipakai sebagai TEKS/ikon (bukan latar) juga diukur: aksen merah
    # di atas navy dan subjudul biru muda di atas krem tidak tertangkap uji latar.
    p, dp = perbaiki_kontras(primary if HEX_RE.match(primary or '') else WARNA_DEFAULT['primary'])
    a, _ = perbaiki_kontras(aksen if HEX_RE.match(aksen or '') else WARNA_DEFAULT['aksen'])
    g = gaya_warna(domain, p, a, dp)
    for nama, depan, latar in (('aksen-teks', g['AKSEN_TEKS'], ('#ffffff', g['LATAR'])),
                               ('aksen-di-utama', g['AKSEN_DI_PRIMARY'], (p,)),
                               ('sorot-teks', g['SOROT_TEKS'], ('#ffffff', g['LATAR'])),
                               ('di-sorot', g['DI_SOROT'], (g['SOROT'],)),
                               ('slogan-pita', g['SOROT_DI_GELAP'], (g['GELAP'],))):
        bagian.append(f"{nama}:{depan}:{min(kontras(depan, l) for l in latar):.1f}")
    return ' '.join(bagian)


def selaraskan(latar, depan, minimal=KONTRAS_MINIMAL):
    """Geser turunan warna sampai kontras dengan warna teks yang sudah dipilih.

    Turunan gelap/terang dipakai sebagai latar juga (footer, panel menu, gradasi
    hero). Warna teksnya mengikuti warna utama, jadi turunannya yang harus
    menyesuaikan diri — bukan sebaliknya."""
    arah = -0.08 if depan == '#ffffff' else 0.08
    for _ in range(14):
        if kontras(latar, depan) >= minimal:
            return latar
        latar = geser_terang(latar, arah)
    return latar


def prefix_dari(domain, diminta=''):
    """Awalan fungsi & kelas CSS child theme; cukup unik dalam satu situs."""
    if diminta and PREFIX_RE.match(diminta):
        return diminta
    label = re.sub(r'[^a-z0-9]', '', domain.split('.')[0])[:4] or 'site'
    return label if label[0].isalpha() else 'v' + label


def warna_tema(domain, primary='', aksen=''):
    """Warna: manifest → pilihan klien di form (dibaca paket-g-konten) → warna
    company profile (scripts/compro-klien) → bawaan. Penjaga kontras tetap berlaku."""
    warna_klien = (muat_isi_contoh(domain) or {}).get('warna') or {}
    try:
        warna_compro = json.loads((Path('/var/lib/velocity/compro') / domain / 'compro.json').read_text()).get('warna') or {}
    except (OSError, ValueError):
        warna_compro = {}
    pilih = lambda *calon: next((w for w in calon if HEX_RE.match(w or '')), '')
    return (pilih(primary, warna_klien.get('utama'), warna_compro.get('utama')) or WARNA_DEFAULT['primary'],
            pilih(aksen, warna_klien.get('aksen'), warna_compro.get('aksen')) or WARNA_DEFAULT['aksen'])


def scaffold(domain, nama='', prefix='', primary='', aksen=''):
    """Bikin (atau pakai ulang) zip child theme Paket G bernama project."""
    slug = scaffold_slug(domain)
    if not SLUG_RE.match(slug):
        raise ValueError(f'slug tidak valid: {slug}')
    CACHE.mkdir(parents=True, exist_ok=True)
    dest = CACHE / f'{slug}-{SCAFFOLD_VERSION}.zip'
    # Selalu dirender ulang: zip lama di cache dulu dipakai terus sehingga
    # perbaikan template & isi compro terbaru tidak pernah sampai ke situs.
    # Render murah dan hasilnya deterministik (tanggal zip dipatok).
    utama, warna_aksen = warna_tema(domain, primary, aksen)
    nilai = nilai_template(
        slug, domain, nama, prefix_dari(domain, prefix), utama, warna_aksen,
        WARNA_DEFAULT['ink'],
    )
    tmp = dest.with_suffix('.tmp')
    berkas = berkas_template(nilai)
    # Sidik tiap berkas hasil render ikut dipasang di tema. child-theme-apply
    # --perbarui memakainya untuk tahu berkas mana yang belum disunting orang
    # (aman diperbarui) dan mana yang sudah (dipertahankan).
    berkas['.velocity-render.json'] = json.dumps({
        'slug': slug, 'versi': SCAFFOLD_VERSION,
        'berkas': {n: hashlib.sha256(d if isinstance(d, bytes) else d.encode()).hexdigest()
                   for n, d in sorted(berkas.items())},
    }, indent=1, sort_keys=True)
    with zipfile.ZipFile(tmp, 'w', zipfile.ZIP_DEFLATED) as z:
        for name, data in berkas.items():
            # Tanggal dipatok supaya zip yang digenerate ulang isinya identik.
            info = zipfile.ZipInfo(f'{slug}/{name}', date_time=(2026, 1, 1, 0, 0, 0))
            info.external_attr = 0o644 << 16
            z.writestr(info, data)
    periksa_fungsi(tmp, prefix_dari(domain, prefix))
    tmp.replace(dest)
    return slug, dest


def periksa_fungsi(zip_path, prefix):
    """Tolak zip yang memanggil fungsi tema yang tidak didefinisikan (HTTP 500 di situs).

    `php -l` tidak menangkapnya; lihat scripts/cek-fungsi-tema."""
    import subprocess
    import tempfile
    penjaga = Path(__file__).resolve().parent / 'cek-fungsi-tema'
    if not penjaga.is_file():
        return
    with tempfile.TemporaryDirectory() as folder:
        with zipfile.ZipFile(zip_path) as z:
            z.extractall(folder)
        tema = next((d for d in Path(folder).iterdir() if d.is_dir()), Path(folder))
        hasil = subprocess.run([sys.executable, str(penjaga), str(tema), prefix],
                               capture_output=True, text=True, timeout=60)
    if hasil.returncode != 0:
        Path(zip_path).unlink(missing_ok=True)
        raise ValueError('fungsi tema hilang: ' + ' '.join(hasil.stdout.split())[:200])


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument('domain')
    ap.add_argument('--paket', default='')
    ap.add_argument('--nama', default='', help='nama situs (site_title di manifest)')
    ap.add_argument('--prefix', default='', help='awalan fungsi & kelas CSS child theme')
    ap.add_argument('--primary', default='', help='warna utama, mis. #14213d')
    ap.add_argument('--accent', default='', help='warna aksen, mis. #fca311')
    ap.add_argument('--override', default='')
    ap.add_argument('--cache', default='', help='folder zip hasil render (bawaan cache paket)')
    ap.add_argument('--no-download', action='store_true')
    args = ap.parse_args()
    if args.cache:
        global CACHE
        CACHE = Path(args.cache)
    out = {'status': '', 'ref': '', 'slug': '', 'prefix': '', 'version': '', 'zip': '',
           'kontras': '', 'error': ''}

    def emit():
        print('\n'.join(f'{k}={v}' for k, v in out.items()))
        return 0

    domain = args.domain.lower()
    override = args.override.strip().lower()
    if not DOMAIN_RE.match(domain) or (override and not SLUG_RE.match(override)):
        out.update(status='no_ref', error='argumen_tidak_valid')
        return emit()

    def generate():
        """Jalan keluar Paket G: child theme sendiri, tidak lewat API tema."""
        try:
            # Awalan fungsi & kelas CSS ikut dilaporkan: langkah lain (halaman,
            # menu, audit) perlu tahu nama shortcode yang dipakai tema ini.
            out['prefix'] = prefix_dari(domain, args.prefix)
            if args.no_download:
                # Hanya menjawab "slug-nya apa": jangan tulis zip apa pun ke disk.
                slug = scaffold_slug(domain)
                if not SLUG_RE.match(slug):
                    raise ValueError(f'slug tidak valid: {slug}')
                out.update(status='generated', slug=slug, version=SCAFFOLD_VERSION)
            else:
                out['slug'], zip_path = scaffold(domain, args.nama, args.prefix,
                                                  args.primary, args.accent)
                out.update(status='generated', version=SCAFFOLD_VERSION, zip=str(zip_path))
                out['kontras'] = laporan_kontras(*warna_tema(domain, args.primary, args.accent), domain=domain)
        except Exception as e:
            out.update(status='download_failed', error=f'{type(e).__name__}: {e}'[:120])
        return emit()

    # Override manual selalu menang: kalau PM menyebut slug, itu yang dipakai.
    paket = args.paket.strip() or paket_from_folder(domain)
    custom_paket = norm(paket) in SCAFFOLD_PAKET and not override
    # Paket dengan child theme baku (Paket E): slug ditentukan paketnya, form tidak dibaca.
    paket_slug = '' if override else PAKET_SLUG.get(norm(paket), '')
    if paket_slug:
        # Log installer berformat child_theme:<status>:<ref>:<slug> — ref tidak boleh
        # memuat titik dua, jadi "Paket E" ditulis "paket-e".
        out['ref'] = re.sub(r'[^a-z0-9]+', '-', paket.strip().lower()).strip('-')
    elif not override:
        out['ref'] = design_ref(read_client_form(ON_PROGRESS / domain)['text'])
        if not out['ref']:
            # Paket G memang tidak pernah memuat referensi — bukan kegagalan.
            if custom_paket:
                return generate()
            out['status'] = 'no_ref'
            return emit()
    try:
        themes = fetch_themes()
    except Exception as e:  # API mati tidak boleh menggagalkan instalasi
        if custom_paket:
            return generate()
        out.update(status='api_error', error=type(e).__name__)
        return emit()
    children = [t for t in themes if t.get('type') == 'wp_theme_child'
                and SLUG_RE.match(str(t.get('slug') or ''))]
    slug_diminta = override or paket_slug
    if slug_diminta:
        match = next((t for t in children if t['slug'] == slug_diminta), None)
    else:
        match = next((t for t in children if norm(out['ref']) in theme_keys(t)), None)
    if not match:
        # Referensi ada tapi belum ada di API: Paket G tetap dapat child theme
        # sendiri, paket lain jatuh ke tema induk seperti sebelumnya.
        if custom_paket:
            return generate()
        out['status'] = 'not_found'
        return emit()
    out.update(slug=match['slug'], version=str(match.get('version') or ''))
    if args.no_download:
        out['status'] = 'matched'
        return emit()
    try:
        out.update(status='matched', zip=str(download(match)))
    except Exception as e:
        # Unduhan gagal (mis. rilis GitHub-nya privat) tidak perlu menjatuhkan situs
        # ke tema induk kalau zip versi lama tema yang sama masih ada di tembolok.
        cache_zip = zip_tembolok(match['slug'])
        if cache_zip:
            out.update(status='matched', zip=str(cache_zip),
                       error=f'unduhan_gagal_pakai_tembolok:{type(e).__name__}')
        else:
            out.update(status='download_failed', error=f'{type(e).__name__}: {e}'[:120])
    return emit()


if __name__ == '__main__':
    sys.exit(main())
