#!/usr/bin/env python3
"""Pantau transkrip sesi Claude Code untuk halaman /brain/ (animasi "sel menyala").

Dibaca dari ~/.claude/projects/**/*.jsonl (termasuk subagent), hanya blok tool_use:
  - Skill {skill}                         -> skill dipakai
  - Read/Edit/Write/MultiEdit {file_path} -> memory/skill dibaca atau ditulis
  - Bash {command} yang menyebut berkas memory -> dibaca (atau ditulis bila ada >, sed -i, tee)
  - input tool apa pun yang menyebut domain proyek (dari data.json) -> proyek disentuh
  - setiap tool_use -> statistik tool (hari ini / 7 hari) + aliran "alat"

Sesi dikenali dari ~/.claude/sessions/<pid>.json (sessionId, tmux claude-tg-<id> = Telegram).

Hasil: /usr/share/nginx/html/brain/aktivitas.json
  {now, events:[{t,sesi,id|skill|domain,aksi}], alat:[{t,sesi,tool}], tools:{nama:{hari,minggu,terakhir}},
   sesi:[{id,label,jenis,hidup,mulai,terakhir,jumlah}]}
Hanya nama tool, id simpul, domain & potongan id sesi yang ditulis; isi percakapan tidak ikut.
"""
import argparse
import json
import math
import os
import re
import tempfile
import time
from collections import defaultdict
from datetime import datetime
from pathlib import Path

CLAUDE = Path(os.environ.get("CLAUDE_HOME", "/root/.claude"))
OUT = "/usr/share/nginx/html/brain/aktivitas.json"
DATA = "/usr/share/nginx/html/brain/data.json"
SIMPAN = 400          # kejadian memory/skill/proyek terakhir yang disimpan
SIMPAN_ALAT = 200     # pemakaian tool terakhir yang disimpan
AWAL_DETIK = 7 * 86400
# Nama orang per sesi, ditulis claude-pakai tiap menit (lihat scripts/claude-pakai)
IDENTITAS = Path("/var/lib/velocity/claude-pakai/identitas.json")
SESI_TAMPIL = 3 * 3600  # sesi mati tetap tampil bila aktif 3 jam terakhir
# Sinaps: dua simpul yang dipakai sesi yang sama dalam JENDELA detik saling menguat;
# bobot meluruh eksponensial (TAU) sehingga jalur yang lama tak dipakai memudar.
JENDELA = 1800
TAU = 3 * 86400 / math.log(2)   # paruh waktu 3 hari
MEM_RE = re.compile(r"/\.claude/projects/([^/]+)/memory/([^/\s'\"]+)\.md")
SKILL_RE = re.compile(r"/\.claude/(?:skills/(?:synced/[^/]+/)?|plugins/cache/[^/]+/[^/]+/[^/]+/skills/)([^/\s'\"]+)/")
BERKAS_MEM_RE = re.compile(r"\b((?:project|feedback|user|reference)_[\w-]+)\.md\b")
TULIS_BASH_RE = re.compile(r"(>>?|\btee\b|sed\s+-i|\bmv\b|\bcp\b|\brm\b)")


def waktu(iso):
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return time.time()


def keterangan_alat(nama, inp):
    """Keterangan singkat untuk log realtime /brain: nama berkas, deskripsi perintah, atau pola.
    Isi perintah Bash TIDAK ditulis (bisa memuat sandi); hanya `description` yang ditulis Claude."""
    if not isinstance(inp, dict):
        return ""
    if inp.get("file_path") or inp.get("notebook_path"):
        return Path(str(inp.get("file_path") or inp.get("notebook_path"))).name[:80]
    if nama == "Bash":
        return str(inp.get("description") or "")[:90]
    if nama in ("Grep", "Glob"):
        return str(inp.get("pattern") or "")[:60]
    if nama == "Skill":
        return str(inp.get("skill") or "")[:60]
    if nama in ("Agent", "Task"):
        return str(inp.get("description") or "")[:80]
    if nama in ("WebFetch", "WebSearch"):
        u = str(inp.get("url") or inp.get("query") or "")
        return (re.sub(r"^https?://([^/]+).*", r"\1", u) if nama == "WebFetch" else u)[:60]
    return ""


class Pemantau:
    def __init__(self):
        self.posisi = {}      # path -> offset byte
        self.sisa = {}        # path -> potongan baris belum lengkap
        self.events = []
        self.alat = []
        self.harian = defaultdict(lambda: defaultdict(int))   # "YYYY-MM-DD" -> tool -> jumlah
        self.tool_terakhir = {}
        self.sesi_aktif = {}  # sesi8 -> {terakhir, jumlah, full}
        self.domain_re = None
        self.data_mtime = 0
        self.jejak_domain = {}  # (sesi, domain) -> t terakhir dicatat
        self.sinaps = {}        # "a|b" -> [bobot, t]
        self.pakai = {}         # kunci simpul -> [bobot, t]
        self.baru_sesi = defaultdict(list)  # sesi -> [(t, kunci)] dalam JENDELA

    @staticmethod
    def perkuat(d, k, t):
        w, t0 = d.get(k, (0.0, t))
        if t >= t0:
            w, t0 = w * math.exp(-(t - t0) / TAU) + 1, t
        else:  # kejadian lebih tua dari yang sudah tercatat (urutan antarberkas)
            w += math.exp(-(t0 - t) / TAU)
        d[k] = [w, t0]

    def serap(self, e):
        k = e.get("id") or ("skill:" + e["skill"] if e.get("skill") else "p:" + e.get("domain", ""))
        t, s = e["t"], e["sesi"]
        self.perkuat(self.pakai, k, t)
        self.perkuat(self.sinaps, f"sesi:{s}|{k}", t)
        daftar = [x for x in self.baru_sesi[s] if t - x[0] < JENDELA]
        lain = []
        for _, k2 in reversed(daftar):
            if k2 != k and k2 not in lain:
                lain.append(k2)
            if len(lain) >= 15:
                break
        for k2 in lain:
            self.perkuat(self.sinaps, "|".join(sorted((k, k2))), t)
        daftar.append((t, k))
        self.baru_sesi[s] = daftar[-40:]

    def bobot_kini(self, d, batas=0.3):
        now = time.time()
        hasil = {}
        for k, (w, t0) in list(d.items()):
            v = w * math.exp(-max(0, now - t0) / TAU)
            if v < 0.05:
                del d[k]
            elif v >= batas:
                hasil[k] = round(v, 2)
        return hasil

    # ---- domain proyek dari data.json buatan brain-data ----
    def muat_domain(self):
        try:
            mt = os.stat(DATA).st_mtime
        except OSError:
            return
        if mt == self.data_mtime:
            return
        self.data_mtime = mt
        try:
            d = json.load(open(DATA))
        except (OSError, ValueError):
            return
        dom = sorted({n["label"] for n in d.get("nodes", []) if n.get("kind") == "proyek"}, key=len, reverse=True)
        self.domain_re = re.compile(r"(?<![\w.-])(" + "|".join(map(re.escape, dom)) + r")(?![\w-])", re.I) if dom else None

    def kejadian_dari(self, baris, sesi):
        try:
            d = json.loads(baris)
        except ValueError:
            return []
        if d.get("type") != "assistant":
            return []
        isi = (d.get("message") or {}).get("content")
        if not isinstance(isi, list):
            return []
        t = waktu(d.get("timestamp"))
        hasil = []
        for blok in isi:
            if not isinstance(blok, dict) or blok.get("type") != "tool_use":
                continue
            nama, inp = blok.get("name") or "?", blok.get("input") or {}
            # statistik & aliran tool
            hari = datetime.fromtimestamp(t).strftime("%Y-%m-%d")
            self.harian[hari][nama] += 1
            self.tool_terakhir[nama] = max(self.tool_terakhir.get(nama, 0), t)
            self.alat.append({"t": t, "sesi": sesi, "tool": nama, "ket": keterangan_alat(nama, inp)})
            s = self.sesi_aktif.setdefault(sesi, {"terakhir": 0, "jumlah": 0, "mulai": t})
            s["terakhir"] = max(s["terakhir"], t)
            s["mulai"] = min(s["mulai"], t)
            s["jumlah"] += 1

            if nama == "Skill" and inp.get("skill"):
                hasil.append({"t": t, "skill": str(inp["skill"]).split(":")[-1], "aksi": "skill", "sesi": sesi})
            elif nama in ("Read", "Edit", "Write", "MultiEdit") and inp.get("file_path"):
                p, aksi = inp["file_path"], ("baca" if nama == "Read" else "tulis")
                m = MEM_RE.search(p)
                if m and m.group(2) != "MEMORY":
                    hasil.append({"t": t, "id": f"m:{m.group(1)}/{m.group(2)}", "aksi": aksi, "sesi": sesi})
                elif m:
                    hasil.append({"t": t, "id": "hub:memory", "aksi": aksi, "sesi": sesi})
                else:
                    sk = SKILL_RE.search(p)
                    if sk:
                        hasil.append({"t": t, "skill": sk.group(1), "aksi": aksi, "sesi": sesi})
            elif nama == "Bash" and inp.get("command"):
                cmd = inp["command"]
                if "/memory" in cmd or BERKAS_MEM_RE.search(cmd):
                    aksi = "tulis" if TULIS_BASH_RE.search(cmd) else "baca"
                    proyek = MEM_RE.search(cmd)
                    proyek = proyek.group(1) if proyek else "-root"
                    for stem in dict.fromkeys(BERKAS_MEM_RE.findall(cmd)):
                        hasil.append({"t": t, "id": f"m:{proyek}/{stem}", "aksi": aksi, "sesi": sesi})
            # domain proyek yang disebut di input tool mana pun
            if self.domain_re:
                teks = json.dumps(inp, ensure_ascii=False)[:6000]
                for dm in dict.fromkeys(x.lower() for x in self.domain_re.findall(teks)):
                    k = (sesi, dm)
                    if t - self.jejak_domain.get(k, 0) < 20:
                        continue
                    self.jejak_domain[k] = t
                    hasil.append({"t": t, "domain": dm, "aksi": "proyek", "sesi": sesi})
        return hasil

    def sesi_dari(self, p):
        # <proyek>/<sesi>.jsonl atau <proyek>/<sesi>/subagents/agent-x.jsonl
        rel = p.relative_to(CLAUDE / "projects").parts
        return (rel[1] if len(rel) > 2 else p.stem)[:8]

    def pindai(self, awal=False):
        batas = time.time() - AWAL_DETIK
        baru, n_alat = [], len(self.alat)
        for p in CLAUDE.glob("projects/**/*.jsonl"):
            try:
                st = p.stat()
            except OSError:
                continue
            if p not in self.posisi and awal and st.st_mtime < batas:
                # transkrip lama: mulai dari ujungnya, jadi kalau sesi itu
                # dilanjutkan nanti riwayat lamanya tidak diputar ulang
                self.posisi[p] = st.st_size
                continue
            # berkas yang belum dikenal setelah start = sesi baru, baca dari awal
            pos = self.posisi.get(p, 0)
            if st.st_size < pos:
                pos = 0
            if st.st_size == pos:
                self.posisi[p] = pos
                continue
            sesi = self.sesi_dari(p)
            try:
                with open(p, "rb") as f:
                    f.seek(pos)
                    sisa = self.sisa.pop(p, b"")
                    for b in f:
                        if not b.endswith(b"\n"):
                            sisa += b
                            break
                        b, sisa = sisa + b, b""
                        if b'"tool_use"' in b:
                            baru += self.kejadian_dari(b.decode("utf-8", "replace"), sesi)
                    if sisa:
                        self.sisa[p] = sisa
                    self.posisi[p] = f.tell()
            except OSError:
                continue
        for e in sorted(baru, key=lambda e: e["t"]):
            self.serap(e)
        if baru:
            self.events = sorted(self.events + baru, key=lambda e: e["t"])[-SIMPAN:]
        ada_alat = len(self.alat) > n_alat
        if ada_alat:
            self.alat = sorted(self.alat, key=lambda e: e["t"])[-SIMPAN_ALAT:]
        return bool(baru) or ada_alat

    # ---- sesi: dari registri proses Claude ----
    def identitas(self):
        """Nama orang per sesi dari claude-pakai (kunci SSH authorized_keys / ID Telegram)."""
        try:
            mt = IDENTITAS.stat().st_mtime
            if mt != getattr(self, "_idt_mt", None):
                d = json.loads(IDENTITAS.read_text())
                self._idt = ({k[:8]: v for k, v in d.get("sesi", {}).items()}, d.get("telegram", {}))
                self._idt_mt = mt
        except (OSError, ValueError):
            pass
        return getattr(self, "_idt", ({}, {}))

    def daftar_sesi(self):
        per_sesi, per_tg = self.identitas()
        kenal = {}
        for f in CLAUDE.glob("sessions/*.json"):
            try:
                d = json.load(open(f))
            except (OSError, ValueError):
                continue
            sid = str(d.get("sessionId", ""))[:8]
            if not sid:
                continue
            hidup = Path(f"/proc/{d.get('pid')}").exists()
            tmux = d.get("tmux") or ""
            m = re.match(r"claude-tg-(\d+)", tmux)
            if m:
                jenis, label = "telegram", f"TG {m.group(1)}"
            elif d.get("entrypoint") == "claude-desktop":
                jenis, label = "desktop", f"desktop {sid}"
            else:
                jenis, label = "terminal", f"terminal {sid}"
            lama = kenal.get(sid)
            if lama and lama["hidup"] and not hidup:
                continue
            kenal[sid] = {"id": sid, "label": label, "jenis": jenis, "hidup": hidup,
                          "mulai": (d.get("startedAt") or 0) / 1000}
        now = time.time()
        hasil = []
        for sid in set(kenal) | set(self.sesi_aktif):
            k = kenal.get(sid, {"id": sid, "label": f"sesi {sid}", "jenis": "lain", "hidup": False, "mulai": 0})
            a = self.sesi_aktif.get(sid, {})
            k = dict(k, terakhir=a.get("terakhir", 0), jumlah=a.get("jumlah", 0))
            m = re.match(r"TG (\d+)$", k["label"])
            orang = per_sesi.get(sid) or (per_tg.get(m.group(1)) if m else None)
            if orang and not orang.startswith(("Belum teridentifikasi", "Otomasi")):
                pendek = {"telegram": "TG", "desktop": "desktop", "terminal": "terminal"}.get(k["jenis"], "sesi")
                k["orang"] = orang
                k["label"] = f"{orang.replace('SSH password ', 'pw ')} · {pendek}"
            if not k["mulai"]:
                k["mulai"] = a.get("mulai", 0)
            if k["hidup"] or now - k["terakhir"] < SESI_TAMPIL:
                hasil.append(k)
        return sorted(hasil, key=lambda s: -s["terakhir"])

    def statistik_tool(self):
        now = time.time()
        hari_ini = datetime.fromtimestamp(now).strftime("%Y-%m-%d")
        batas = datetime.fromtimestamp(now - 6 * 86400).strftime("%Y-%m-%d")
        for h in [h for h in self.harian if h < batas]:
            del self.harian[h]
        tot = defaultdict(lambda: {"hari": 0, "minggu": 0, "terakhir": 0})
        for h, per in self.harian.items():
            for nama, n in per.items():
                tot[nama]["minggu"] += n
                if h == hari_ini:
                    tot[nama]["hari"] += n
        for nama in tot:
            tot[nama]["terakhir"] = self.tool_terakhir.get(nama, 0)
        return tot

    def tulis(self, out):
        out = Path(out)
        out.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=out.parent, prefix=".akt-")
        with os.fdopen(fd, "w") as f:
            json.dump({"now": time.time(), "events": self.events, "alat": self.alat[-SIMPAN_ALAT:],
                       "tools": self.statistik_tool(), "sesi": self.daftar_sesi(),
                       "sinaps": dict(sorted(self.bobot_kini(self.sinaps).items(), key=lambda x: -x[1])[:800]), "pakai": self.bobot_kini(self.pakai)}, f, separators=(",", ":"))
        os.chmod(tmp, 0o644)
        os.replace(tmp, out)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--sekali", action="store_true", help="pindai sekali lalu keluar (uji)")
    a = ap.parse_args()
    pm = Pemantau()
    pm.muat_domain()
    t0 = time.time()
    pm.pindai(awal=True)
    pm.tulis(a.out)
    if a.sekali:
        print(f"brain-aktivitas: {len(pm.events)} kejadian, {len(pm.alat)} alat, pindai awal {time.time()-t0:.1f}s")
        for e in pm.events[-6:]:
            print(e)
        print(dict(sorted(((k, v["minggu"]) for k, v in pm.statistik_tool().items()), key=lambda x: -x[1])[:12]))
        sn = pm.bobot_kini(pm.sinaps)
        print(len(sn), "sinaps;", sorted(sn.items(), key=lambda x: -x[1])[:8])
        return
    terakhir_tulis = 0
    while True:
        time.sleep(2)
        pm.muat_domain()
        if pm.pindai() or time.time() - terakhir_tulis > 15:
            pm.tulis(a.out)
            terakhir_tulis = time.time()


if __name__ == "__main__":
    main()
