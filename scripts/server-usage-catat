#!/usr/bin/env python3
"""Catat pemakaian resource tiap server hosting (timer server-usage-catat, tiap 5 menit).

Satu baris JSON per server ke /var/lib/velocity/server-usage/riwayat.jsonl:
{"t", "host", "name", "cpu", "ram", "swap", "disk" (persen), "load", "core", "req" (request/dtk LiteSpeed),
"conn" (koneksi live LiteSpeed, cadangan: TCP established :80/:443), "net_in"/"net_out" (Mbps kartu jaringan utama)}.
Sampel = installer_status.usage_sampel (RESOURCE_CMD + baris tambahan, hanya baca: /proc, df, .rtreport LiteSpeed, ss).
Traffic dihitung dari selisih counter /proc/net/dev dengan catatan sebelumnya (net-state.json). Riwayat disimpan 31 hari;
dibaca GET /api/servers/riwayat untuk grafik di /server/monitoring.
"""
import json
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'services'))
import installer_status as ist  # noqa: E402

BERKAS = Path('/var/lib/velocity/server-usage/riwayat.jsonl')
STATE_NET = BERKAS.parent / 'net-state.json'

SIMPAN_HARI = 31


def catat():
    key = ist.ssh_key_file()
    if not key:
        sys.exit('kunci SSH installer tidak ada')
    servers = ist.server_dipantau()
    hasil = [None] * len(servers)

    def kerja(i):
        hasil[i] = ist.usage_sampel(servers[i], key)
    utas = [threading.Thread(target=kerja, args=(i,), daemon=True) for i in range(len(servers))]
    for t in utas:
        t.start()
    for t in utas:
        t.join(40)

    now = int(time.time())
    try:
        state = json.loads(STATE_NET.read_text())
    except (OSError, ValueError):
        state = {}
    baris = []
    for srv, r in zip(servers, hasil):
        b = {'t': now, 'host': srv['host'], 'name': srv['name']}
        if r and r.get('ok'):
            b.update(ist.usage_titik(r))
            net = r.get('net')
            if net:
                b.update(ist.usage_net(net, state.get(srv['host']), now, 900))
                state[srv['host']] = {'t': now, **net}
        else:
            b['ok'] = False  # titik kosong = server tak terjangkau (grafik putus di sini)
        baris.append(json.dumps(b, separators=(',', ':')))

    BERKAS.parent.mkdir(parents=True, exist_ok=True)
    STATE_NET.write_text(json.dumps(state))
    with BERKAS.open('a') as f:
        f.write('\n'.join(baris) + '\n')
    pangkas(now)


def pangkas(now):
    """Buang baris lebih tua dari SIMPAN_HARI; hanya menulis ulang bila baris pertama sudah kedaluwarsa."""
    batas = now - SIMPAN_HARI * 86400
    with BERKAS.open() as f:
        pertama = f.readline()
    try:
        if json.loads(pertama)['t'] >= batas:
            return
    except (ValueError, KeyError):
        pass
    sisa = []
    with BERKAS.open() as f:
        for b in f:
            try:
                if json.loads(b)['t'] >= batas:
                    sisa.append(b)
            except (ValueError, KeyError):
                continue
    tmp = BERKAS.with_suffix('.tmp')
    tmp.write_text(''.join(sisa))
    tmp.replace(BERKAS)


if __name__ == '__main__':
    catat()
