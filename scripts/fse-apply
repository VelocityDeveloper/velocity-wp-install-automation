def referensi_form(domain):
    """URL "website yang ingin dicontoh" + catatan klien dari FORM ISIAN.

    anaksegalabangsa.com: "Untuk desain halaman depan versi PC seperti
    ourgrandfatherstory.com, sedangkan desain halaman lain, halaman mobile dan
    fiturnya mengikuti kami". Contoh isian template form (alamatWebContoh.com) dan
    tautan syarat & ketentuan Velocity bukan referensi. Pembacanya tinggal di
    scripts/referensi_desain.py (langkah installer "referensi desain")."""
    return muat_modul('referensi_desain', HERE / 'referensi_desain.py').referensi_form(domain)


def ciri_referensi(url):
    """Ciri tata letak halaman referensi yang terbaca dari HTML-nya."""
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    with urllib.request.urlopen(req, timeout=40, context=ssl._create_unverified_context()) as r:
        h = r.read(800_000).decode(errors='ignore')
    fonts = []
    for kelompok in re.findall(r'fonts\.googleapis\.com/css2?\?family=([^"\'>]+)', h):
        for bagian in re.split(r'\||&(?:amp;)?family=', urllib.parse.unquote(kelompok.split('&display')[0])):
            nama = bagian.split(':')[0].replace('+', ' ').strip()
            if nama and nama not in fonts:
                fonts.append(nama)
    badan = re.sub(r'<script.*?</script>|<style.*?</style>|<svg.*?</svg>', '', h[h.find('<body'):], flags=re.S | re.I)
    kelas = ' '.join(re.findall(r'class="([^"]+)"', badan)).lower()
    garis = [f'{m.group(1)}.{m.group(2)[:60]}' for m in
             re.finditer(r'<(header|nav|main|section|article|aside|footer)\b[^>]*class="([^"]+)"', badan)][:100]
    return {'fonts': fonts[:4],
            'sidebar': bool(re.search(r'\b(sidebar|widget-area)\b', kelas)) or '<aside' in badan.lower(),
            'kartu_penuh': len(re.findall(r'\b(full|fullwidth|full-width|hero|cover)\b', kelas)),
            'kolom_dua': bool(re.search(r'two-by|col-md-6|columns-2|\bhalf\b', kelas)),
            'garis': garis}


def muat_ai(manifest):
    try:
        gen = muat_modul('ai_content_generator', HERE / 'ai-content-generator.py')
        model = gen.get_model('fse')
        return (gen, model) if model else None
    except Exception:
        return None


def gaya_perusahaan(url, domain):
    """Gaya beranda perusahaan dari screenshot beranda referensi klien -> (gaya, alasan, font).

    Referensi Paket G (2026-09-15) dibangun Beaver Builder: kelas HTML-nya
    (fl-builder-content-27) tidak menggambarkan tata letak, dan AI installer hanya
    menerima teks — jadi yang diukur piksel. Terang rata-rata pita hero (y 120–620,
    lebar 1366): foto berlapis gelap L 70–127 (erhaeschemical, jatrascale,
    tasseminarpalupi, jasabongkarbangunanbali), hero putih teks+foto L 234 (jasarilismedia)."""
    fonts = []
    try:
        fonts = ciri_referensi(url).get('fonts') or []
    except (OSError, ValueError, urllib.error.URLError):
        pass
    folder = RENCANA_DIR / domain
    folder.mkdir(parents=True, exist_ok=True)
    potret = folder / 'referensi-potret.png'
    potret.unlink(missing_ok=True)
    try:
        subprocess.run(['node', str(HERE / 'potret-halaman'), url, str(potret), '1366', '900'],
                       capture_output=True, text=True, timeout=200)
        ck = muat_modul('compro_klien', HERE / 'compro-klien')
        lebar, tinggi, kanal, baris = ck.baca_png(potret)
    except Exception as e:  # situs referensi berat/mati: gaya paling umum di referensi klien
        return 'korporat', f'referensi_tidak_terpotret:{type(e).__name__}', fonts
    nilai = [0.2126 * r[x * kanal] + 0.7152 * r[x * kanal + 1] + 0.0722 * r[x * kanal + 2]
             for r in list(baris)[120:min(620, tinggi):4] for x in range(0, lebar, 6)]
    if not nilai:
        return 'korporat', 'potret_terlalu_pendek', fonts
    terang = sum(nilai) / len(nilai)
    if terang >= 190:
        return 'terbelah', f'hero terang L={terang:.0f}', fonts
    return 'korporat', f'hero berfoto/gelap L={terang:.0f}', fonts


def referensi_desain(cfg, domain, jenis='berita'):
    """Referensi klien + gaya beranda terpilih (manifest `gaya_beranda=` menang).

    Portal berita memilih dari GAYA (AI membaca kerangka HTML referensi); situs
    perusahaan dari GAYA_PERUSAHAAN lewat screenshot referensi (gaya_perusahaan).
    Disimpan di fse-rencana/<domain>/referensi.json supaya --tema dan --isi sepakat
    dan halaman referensi/AI tidak dipanggil ulang setiap run."""
    katalog = GAYA if jenis == 'berita' else GAYA_PERUSAHAAN
    berkas = RENCANA_DIR / domain / 'referensi.json'
    try:
        lama = json.loads(berkas.read_text())
    except (OSError, ValueError):
        lama = {}
    ref = referensi_form(domain)
    paksa = cfg.get('gaya_beranda', '').strip().lower()
    # Referensi web klien = ACUAN UTAMA (keputusan user 2026-09-15). Rencana desain diukur dari
    # DOM situs referensi oleh scripts/referensi_desain.py — langkah installer-runner sendiri;
    # di sini dibaca dari tembolok, atau diukur kalau belum ada. Gaya dari manifest tetap menang.
    desain = None
    # Gaya "dealer" punya susunan beranda sendiri, tetapi header/footer/font/tombol tetap
    # mengikuti hasil ukur referensi — jadi rencana desainnya ikut dibaca.
    if ref.get('url') and (paksa not in katalog or paksa in ('referensi', 'dealer')):
        desain, status = muat_modul('referensi_desain', HERE / 'referensi_desain.py').periksa(domain)
        if not desain:
            print(f'fse: desain_referensi_{status}')
    if paksa in katalog and paksa != 'referensi':
        # Font tetap ikut referensi walau susunan beranda dipilih lewat manifest.
        fonts = lama.get('fonts') or ([f for f in (desain['font']['teks'], desain['font']['judul']) if f] if desain else [])
        hasil = dict(ref, gaya=paksa, sumber='manifest', fonts=fonts)
    elif not ref:
        hasil = {'gaya': 'klasik', 'sumber': 'tanpa_referensi'}
    elif jenis != 'berita' and desain:
        hasil = dict(ref, gaya='referensi', sumber='ukur_dom',
                     fonts=[f for f in (desain['font']['teks'], desain['font']['judul']) if f])
    elif (lama.get('url') == ref['url'] and lama.get('gaya') in katalog and lama.get('gaya') != 'referensi'
          and lama.get('sumber') != 'manifest' and lama.get('jenis', 'berita') == jenis):
        hasil = dict(lama)
    elif jenis != 'berita':
        gaya, alasan, fonts = gaya_perusahaan(ref['url'], domain)
        hasil = dict(ref, gaya=gaya, alasan=alasan, sumber='screenshot', fonts=fonts)
    else:
        try:
            ciri = ciri_referensi(ref['url'])
        except (OSError, ValueError, urllib.error.URLError) as e:
            print(f'fse: referensi_tidak_terbaca:{type(e).__name__}')
            ciri = {}
        gaya, alasan, sumber = '', '', 'heuristik'
        ai = muat_ai(cfg.get('_manifest', ''))
        if ai and ciri:
            modul, model = ai
            prompt = ('Pilih gaya beranda portal berita yang PALING mirip tata letak halaman depan situs referensi klien.\n'
                      f"URL: {ref['url']}\nCatatan klien: {ref.get('catatan') or '-'}\n"
                      f"Ciri HTML: kolom_samping={ciri['sidebar']}, kelas_kartu_selebar_layar={ciri['kartu_penuh']}, "
                      f"grid_dua_kolom={ciri['kolom_dua']}, font={ciri['fonts']}\n"
                      'Kerangka elemen halaman depan (tag.kelas, berurutan):\n' + '\n'.join(ciri['garis'][:80])
                      + '\n\nPilihan gaya:\n' + '\n'.join(f'- {k}: {v}' for k, v in GAYA.items())
                      + '\n\nJawab JSON {"gaya": "<kunci pilihan>", "alasan": "<satu kalimat>"}')
            jawab = modul.ai_call('You classify website homepage layouts. Output ONLY valid JSON.', prompt, model) or ''
            try:
                pilih = json.loads(jawab[jawab.find('{'):jawab.rfind('}') + 1])
                gaya, alasan, sumber = str(pilih.get('gaya', '')), str(pilih.get('alasan', ''))[:200], 'ai'
            except ValueError:
                pass
        if gaya not in GAYA:
            gaya = ('sorotan' if ciri and not ciri['sidebar'] and (ciri['kartu_penuh'] >= 3 or ciri['kolom_dua'])
                    else 'klasik')
            sumber = 'heuristik'
        hasil = dict(ref, gaya=gaya, alasan=alasan, sumber=sumber, fonts=ciri.get('fonts', []))
    hasil['jenis'] = jenis
    # Portal berita tetap memakai gaya beranda berita, tetapi header/font/tombol/footer ikut referensi.
    hasil.pop('desain', None)
    if desain:
        hasil['desain'] = desain
    berkas.parent.mkdir(parents=True, exist_ok=True)
    berkas.write_text(json.dumps(hasil, ensure_ascii=False, indent=1))
    return hasil


def font_situs(fonts):
    """(font teks, font judul) dari font referensi yang dibawa tema; '' = bawaan tema."""
    lokal = [(f.lower(), FONT_LOKAL[f.lower()]) for f in fonts if f.lower() in FONT_LOKAL]
    serif = next((slug for nama, slug in lokal if 'serif' in nama and 'sans' not in nama), '')
    teks = next((slug for nama, slug in lokal if slug != serif), '')
    return teks, serif or teks


# ---------------------------------------------------------------------------
# Akses situs
# ---------------------------------------------------------------------------

PHP_AWAL = r'''<?php
// Admin sebagai pengguna aktif & kses dimatikan: tanpa ini WordPress membuang
// iframe peta dan markup blok secara diam-diam (pelajaran birutourtravel.com).
$velocity_admin = get_users(array('role' => 'administrator', 'number' => 1, 'orderby' => 'ID', 'fields' => 'ID'));
if ($velocity_admin) { wp_set_current_user((int) $velocity_admin[0]); }
kses_remove_filters();
$d = json_decode((string) file_get_contents(getenv('VELOCITY_FSE_DATA')), true);
$d = is_array($d) ? $d : array();
function vfse_keluar($data) { echo PHP_EOL . 'VFSE:' . wp_json_encode($data) . PHP_EOL; }
'''


class Situs:
    """Satu situs klien lewat SSH + WP-CLI."""

    def __init__(self, cfg):
        key = os.environ.get('WP_INSTALL_SSH_KEY_FILE', '')
        if not key or not Path(key).is_file():
            raise RuntimeError('kunci SSH tidak ada')
        self.domain = cfg['domain'].lower()
        self.docroot = f"/home/{cfg['da_user']}/domains/{self.domain}/public_html"
        self.ssh = ['ssh', '-i', key, '-o', 'BatchMode=yes', '-o', 'StrictHostKeyChecking=accept-new',
                    '-o', 'ConnectTimeout=15', '-p', str(cfg.get('ssh_port') or 22),
                    f"{cfg.get('ssh_user') or 'root'}@{cfg['target_host']}"]
        # Uji desain di WordPress lokal: VELOCITY_LOKAL_SSH = pengganti ssh yang menjalankan
        # perintah di mesin ini, VELOCITY_LOKAL_DOCROOT = folder WordPress uji.
        if os.environ.get('VELOCITY_LOKAL_SSH') and os.environ.get('VELOCITY_LOKAL_DOCROOT'):
            self.ssh = [os.environ['VELOCITY_LOKAL_SSH']]
            self.docroot = os.environ['VELOCITY_LOKAL_DOCROOT']

    def bash(self, skrip, timeout=300):
        return subprocess.run(self.ssh + ['bash', '-s'], input=skrip, capture_output=True, text=True, timeout=timeout)

    def php(self, kode, data=None, timeout=300):
        """PHP di dalam WordPress; hasilnya JSON pada baris berawalan VFSE:."""
        muatan = base64.b64encode(json.dumps(data or {}, ensure_ascii=False).encode()).decode()
        skrip = (
            'set -e\n'
            'T=$(mktemp -d /tmp/velocity-fse.XXXXXX)\n'
            "trap 'rm -rf \"$T\"' EXIT\n"
            "cat > \"$T/skrip.php\" <<'VELOCITY_FSE_PHP'\n" + PHP_AWAL + kode + '\nVELOCITY_FSE_PHP\n'
            "base64 -d > \"$T/data.json\" <<'VELOCITY_FSE_DATA'\n" + muatan + '\nVELOCITY_FSE_DATA\n'
            f'VELOCITY_FSE_DATA="$T/data.json" php -d memory_limit=512M /usr/local/bin/wp eval-file "$T/skrip.php" '
            f'--path={shlex.quote(self.docroot)} --allow-root 2>&1\n'
        )
        run = self.bash(skrip, timeout=timeout)
        for baris in reversed(run.stdout.splitlines()):
            if baris.startswith('VFSE:'):
                return json.loads(baris[5:])
        raise RuntimeError('php_gagal: ' + re.sub(r'\s+', ' ', run.stdout + run.stderr).strip()[-300:])


PHP_DETEKSI = r'''
global $shortcode_tags;
$prefix = '';
foreach (array_keys($shortcode_tags) as $t) {
    if (preg_match('/^([a-z0-9]+)_pemesanan$/', $t, $m)) { $prefix = $m[1]; break; }
}
$fse = wp_get_theme('velocity-fse');
vfse_keluar(array('tema' => get_stylesheet(), 'induk' => get_template(), 'blok' => (bool) wp_is_block_theme(), 'prefix' => $prefix,
    'versi' => $fse->exists() ? (string) $fse->get('Version') : ''));
'''


def deteksi(cfg, situs):
    """Jalur tema untuk installer-runner.

    fse    tema velocity-fse sudah aktif, situs belum punya desain custom, atau
           manifest tema_desain=fse (memindahkan situs child klasik lama)
    lewati block theme lain yang dibuat tangan (mis. birutourtravel.com), atau
           child theme klasik Paket G lama yang belum diputuskan dipindah

    Tidak ada lagi jalur child (keputusan user 2026-09-15, paket custom FSE saja).
    """
    if cfg.get('tema_desain', '').strip().lower() == 'fse':
        return 'fse', 'manifest'
    k = situs.php(PHP_DETEKSI)
    if k['tema'] == SLUG:
        return 'fse', 'tema_aktif'
    if k['prefix']:
        # Memindahkan mengganti desain yang sudah jadi (compro, foto per slot belum
        # ada di velocity-fse) — keputusan per situs, bukan otomatis.
        return 'lewati', f"child_klasik_belum_dipindah:{k['tema']}"
    if k.get('induk') == 'velocity' and k['tema'] != 'velocity':
        # Child theme klasik lain dari tema velocity (mis. toko lama velocity-traffits sejak
        # Toko Online Custom ikut jalur FSE 2026-09-15): desain yang sudah dikerjakan orang.
        return 'lewati', f"child_klasik_belum_dipindah:{k['tema']}"
    # Tema bawaan WordPress (twentytwentyfive dst.) juga block theme, dan sejak tema
    # induk velocity tidak dipasang lagi itulah tema situs baru — bukan buatan tangan.
    # Tanpa pengecualian ini glcagro.com (2026-09-15) terpasang tanpa velocity-fse.
    if k['blok'] and not k['tema'].startswith('twenty'):
        return 'lewati', f"block_theme_lain:{k['tema']}"
    return 'fse', f"tema_awal:{k['tema']}"


# ---------------------------------------------------------------------------
# --tema
# ---------------------------------------------------------------------------

def versi_tuple(versi):
    return tuple(int(x) for x in re.findall(r'\d+', versi or '')) or (0,)


def versi_template():
    cocok = re.search(r'^Version:\s*(\S+)', (TEMA / 'style.css').read_text(), re.M)
    return cocok.group(1) if cocok else '0'


def periksa_template():
    """Markup blok & sintaks PHP tema. Tema rusak tidak boleh sampai ke situs klien."""
    berkas = sorted(str(p) for p in TEMA.glob('templates/*.html')) + sorted(str(p) for p in TEMA.glob('parts/*.html')) \
        + sorted(str(p) for p in TEMA.glob('patterns/*.php'))
    run = subprocess.run(['node', str(HERE / 'cek-blok')] + berkas, capture_output=True, text=True, timeout=180)
    if run.returncode == 3:
        print('fse: cek_blok_dilewati:alat_tidak_ada')
    elif run.returncode != 0:
        for baris in run.stdout.splitlines():
            if baris.startswith('tidak_valid'):
                print('fse: ' + baris[:300])
        return False
    for php in TEMA.rglob('*.php'):
        lint = subprocess.run(['php', '-l', str(php)], capture_output=True, text=True)
        if lint.returncode != 0:
            print(f'fse: php_rusak:{php.relative_to(TEMA)}')
            return False
    return True


def buat_zip(tujuan):
    with zipfile.ZipFile(tujuan, 'w', zipfile.ZIP_DEFLATED) as z:
        for berkas in sorted(TEMA.rglob('*')):
            if berkas.is_file():
                z.write(berkas, f'{SLUG}/{berkas.relative_to(TEMA)}')


def hitung_palet(vct, primary, aksen, gelap=False):
    """Palet klien dengan penjaga kontras WCAG yang sama dengan child theme Paket G.

    `gelap` untuk situs bergaya dealer: seluruh halaman berlatar gelap (warna klien
    "black, silver, biru elektrik" dan referensinya memang hitam), jadi slug yang
    sama diisi nilai gelap — nama tampilnya disesuaikan supaya tidak menyesatkan PM
    di Site Editor."""
    utama, di_primary = vct.perbaiki_kontras(primary)
    aksen, di_aksen = vct.perbaiki_kontras(aksen)
    aksen_teks = aksen
    for _ in range(14):
        if vct.kontras(aksen_teks, '#ffffff') >= 4.5:
            break
        aksen_teks = vct.geser_terang(aksen_teks, -0.08)
    # Topbar & footer memakai versi gelap dengan teks yang sama seperti di atas warna utama.
    gelap = vct.geser_terang(utama, -0.3 if di_primary == '#ffffff' else -0.1)
    for _ in range(14):
        if vct.kontras(gelap, di_primary) >= 4.5:
            break
        gelap = vct.geser_terang(gelap, -0.08 if di_primary == '#ffffff' else 0.08)
    # Menu aktif: aksen di atas warna utama hanya kalau masih terbaca.
    aksen_di_primary = aksen if vct.kontras(aksen, utama) >= 3 else di_primary
    if gelap:
        # Warna klien yang terlalu terang tidak bisa jadi permukaan situs gelap.
        permukaan = utama if vct.kontras(utama, '#ffffff') >= 7 else '#101318'
        terang_aksen = aksen
        for _ in range(10):
            if vct.kontras(terang_aksen, '#0d0f12') >= 4.5:
                break
            terang_aksen = vct.geser_terang(terang_aksen, 0.08)
        return [
            {'slug': 'primary', 'color': permukaan, 'name': 'Permukaan gelap'},
            {'slug': 'primary-gelap', 'color': vct.geser_terang(permukaan, -0.35), 'name': 'Hitam'},
            {'slug': 'aksen', 'color': aksen, 'name': 'Aksen'},
            {'slug': 'aksen-teks', 'color': terang_aksen, 'name': 'Aksen untuk teks'},
            {'slug': 'aksen-di-primary', 'color': terang_aksen, 'name': 'Aksen di atas permukaan gelap'},
            {'slug': 'di-primary', 'color': '#ffffff', 'name': 'Teks di atas permukaan gelap'},
            {'slug': 'di-aksen', 'color': di_aksen, 'name': 'Teks di atas aksen'},
            {'slug': 'ink', 'color': '#ffffff', 'name': 'Judul'},
            {'slug': 'teks', 'color': '#c4cad3', 'name': 'Teks'},
            {'slug': 'abu', 'color': '#98a1ad', 'name': 'Teks redup'},
            {'slug': 'latar', 'color': '#16191e', 'name': 'Latar seksi'},
            {'slug': 'garis', 'color': '#2b3037', 'name': 'Garis'},
            {'slug': 'putih', 'color': '#0d0f12', 'name': 'Latar halaman'},
        ]
    return [
        {'slug': 'primary', 'color': utama, 'name': 'Utama'},
        {'slug': 'primary-gelap', 'color': gelap, 'name': 'Utama gelap'},
        {'slug': 'aksen', 'color': aksen, 'name': 'Aksen'},
        {'slug': 'aksen-teks', 'color': aksen_teks, 'name': 'Aksen untuk teks'},
        {'slug': 'aksen-di-primary', 'color': aksen_di_primary, 'name': 'Aksen di atas warna utama'},
        {'slug': 'di-primary', 'color': di_primary, 'name': 'Teks di atas warna utama'},
        {'slug': 'di-aksen', 'color': di_aksen, 'name': 'Teks di atas aksen'},
        {'slug': 'ink', 'color': '#14171f', 'name': 'Judul'},
        {'slug': 'teks', 'color': '#454b57', 'name': 'Teks'},
        {'slug': 'abu', 'color': '#5f6570', 'name': 'Teks redup'},
        {'slug': 'latar', 'color': '#f7f8fa', 'name': 'Latar abu'},
        {'slug': 'garis', 'color': '#e3e6ec', 'name': 'Garis'},
        {'slug': 'putih', 'color': '#ffffff', 'name': 'Putih'},
    ]


def data_situs(cfg, domain, isi, vct, ref=None):
    """Isi opsi velocity_situs. Kontak publik hanya dari "Kontak utk di web" /
    dokumen klien (data_klien) — biodata pemilik tidak pernah ikut."""
    klien = vct.data_klien(domain, isi.get('nama_tampil') or '')
    area = klien.get('AREA', '')
    teks = lambda nilai, batas: re.sub(r'\s+', ' ', str(nilai or '')).strip()[:batas]
    return {
        'jenis': 'berita' if isi.get('jenis') == 'berita' else 'perusahaan',
        'nama': teks(isi.get('nama_tampil') or klien.get('NAMA') or cfg.get('site_title') or domain, 80),
        'slogan': teks(isi.get('slogan'), 90),
        'tentang': teks(isi.get('tentang'), 600),
        'email': klien.get('EMAIL', ''),
        # Kontak publik biasanya dari "Kontak utk di web". Kalau klien hanya memberi email/alamat
        # di biodata, keputusannya ada di user (bukan otomatis) — hasilnya ditulis di manifest.
        'email_publik': klien.get('EMAIL_PUBLIK', '') or cfg.get('email_publik', ''),
        'wa': klien.get('WA', ''),
        'telp': klien.get('TELP', ''),
        'alamat': klien.get('ALAMAT', '') or cfg.get('alamat_publik', ''),
        'area': '' if area == 'sekitarnya' else area,
        # Gaya beranda & font mengikuti referensi desain klien (referensi_desain).
        'gaya': (ref or {}).get('gaya') or 'klasik',
        'referensi': (ref or {}).get('url', ''),
        'font_teks': font_situs((ref or {}).get('fonts') or [])[0],
        'font_judul': font_situs((ref or {}).get('fonts') or [])[1],
        'rubrik': [{'slug': r.get('slug', ''), 'judul': teks(r.get('judul'), 60), 'teks': teks(r.get('teks'), 200)}
                   for r in isi.get('rubrik') or [] if isinstance(r, dict) and r.get('judul')],
        'layanan': [{'judul': teks(l.get('judul'), 80), 'teks': teks(l.get('teks'), 300),
                     'rincian': [teks(x, 120) for x in l.get('rincian') or []][:6]}
                    for l in isi.get('layanan') or [] if isinstance(l, dict) and l.get('judul')],
    }


PHP_TEMA = r'''
$hasil = array();
$sebelum = get_stylesheet();
if ($sebelum !== 'velocity-fse') {
    // Logo tersimpan sebagai theme mod tema lama; block theme membaca opsi site_logo.
    $logo = (int) get_theme_mod('custom_logo');
    switch_theme('velocity-fse');
    update_option('velocity_fse_tema_sebelumnya', $sebelum, false);
    if ($logo && !(int) get_option('site_logo')) { update_option('site_logo', $logo); }
    $hasil[] = 'tema_diaktifkan:' . $sebelum . '->velocity-fse';
} else {
    $hasil[] = 'tema_aktif:velocity-fse';
}

// Data situs: ditimpa hanya selama belum disunting di Tampilan → Data Situs.
$lama = get_option('velocity_situs');
if (!is_array($lama) || (string) get_option('velocity_situs_md5') === md5(wp_json_encode($lama))) {
    update_option('velocity_situs', $d['situs']);
    update_option('velocity_situs_md5', md5(wp_json_encode(get_option('velocity_situs'))), false);
    $hasil[] = 'data_situs_ditulis';
} else {
    // Suntingan PM dipertahankan; susunan rubrik/layanan tetap mengikuti installer.
    foreach (array('jenis', 'rubrik', 'layanan') as $k) { $lama[$k] = $d['situs'][$k]; }
    update_option('velocity_situs', $lama);
    $hasil[] = 'data_situs_disunting_dipertahankan';
}

// Palet klien di wp_global_styles (origin pengguna) — bukan salinan tema per klien.
$gaya = WP_Theme_JSON_Resolver::get_user_data_from_wp_global_styles(wp_get_theme('velocity-fse'), true);
$gaya_id = isset($gaya['ID']) ? (int) $gaya['ID'] : 0;
if ($gaya_id) {
    $isi = json_decode((string) get_post_field('post_content', $gaya_id), true);
    $isi = is_array($isi) ? $isi : array();
    $isi += array('version' => 3, 'isGlobalStylesUserThemeJSON' => true);
    $kini = isset($isi['settings']['color']['palette']['theme']) ? $isi['settings']['color']['palette']['theme'] : null;
    if ($kini === null || (string) get_option('velocity_fse_warna_md5') === md5(wp_json_encode($kini))) {
        $isi['settings']['color']['palette']['theme'] = $d['palet'];
        wp_update_post(array('ID' => $gaya_id, 'post_content' => wp_slash(wp_json_encode($isi))));
        $baca = json_decode((string) get_post_field('post_content', $gaya_id), true);
        $tulis = isset($baca['settings']['color']['palette']['theme']) ? $baca['settings']['color']['palette']['theme'] : array();
        update_option('velocity_fse_warna_md5', md5(wp_json_encode($tulis)), false);
        $hasil[] = $tulis === $d['palet'] ? 'palet_ditulis:' . $gaya_id : 'palet_gagal_terbaca';
    } else {
        $hasil[] = 'palet_disunting_dipertahankan';
    }
    if (function_exists('wp_clean_theme_json_cache')) { wp_clean_theme_json_cache(); }
} else {
    $hasil[] = 'palet_gagal:global_styles_tidak_ada';
}

// Token desain dari referensi web klien (keputusan user 2026-09-15, dibaca functions.php):
// header, font, tombol, kartu, footer. Ditimpa hanya selama belum diubah orang (md5).
$desain_lama = get_option('velocity_fse_desain', null);
if ($desain_lama === null || (string) get_option('velocity_fse_desain_md5') === md5(wp_json_encode($desain_lama))) {
    update_option('velocity_fse_desain', isset($d['desain']) ? (array) $d['desain'] : array());
    update_option('velocity_fse_desain_md5', md5(wp_json_encode(get_option('velocity_fse_desain'))), false);
    $hasil[] = empty($d['desain']) ? 'desain_referensi:tidak_ada' : 'desain_referensi_ditulis';
} else {
    $hasil[] = 'desain_referensi_disunting_dipertahankan';
}

// Rubrik portal berita = kategori dengan slug yang sama.
foreach ((array) $d['situs']['rubrik'] as $r) {
    if (empty($r['slug'])) { continue; }
    $t = get_term_by('slug', $r['slug'], 'category');
    if (!$t && ($t = get_term_by('name', $r['judul'], 'category'))) {
        wp_update_term($t->term_id, 'category', array('slug' => $r['slug']));
    }
    if (!$t) {
        $baru = wp_insert_term($r['judul'], 'category', array('slug' => $r['slug'], 'description' => $r['teks']));
        $hasil[] = is_wp_error($baru) ? 'rubrik_gagal:' . $r['slug'] : 'rubrik_dibuat:' . $r['slug'];
    }
}
vfse_keluar(array('hasil' => $hasil));
'''


def warna_situs(vct, domain, desain):
    """(utama, aksen, sumber). Warna klien menang (keputusan user 2026-09-15): pilihan di
    FORM ISIAN (paket-g-konten) atau company profile/logo (compro-klien). Warna situs
    referensi hanya dipakai kalau klien tidak punya warna sama sekali."""
    primary, aksen = vct.warna_tema(domain)
    klien = (vct.muat_isi_contoh(domain) or {}).get('warna') or {}
    try:
        compro = json.loads((Path('/var/lib/velocity/compro') / domain / 'compro.json').read_text()).get('warna') or {}
    except (OSError, ValueError):
        compro = {}
    if any(vct.HEX_RE.match(w or '') for w in (klien.get('utama'), klien.get('aksen'), compro.get('utama'), compro.get('aksen'))):
        return primary, aksen, 'klien'
    ref = [w for w in (desain or {}).get('warna_referensi') or [] if vct.HEX_RE.match(w or '')]
    if not ref:
        return primary, aksen, 'bawaan'
    return ref[0], (ref[1] if len(ref) > 1 else aksen), 'referensi'


def token_desain(ref):
    """Token tampilan dari rencana referensi -> opsi velocity_fse_desain (dibaca functions.php)."""
    desain = (ref or {}).get('desain')
    if not desain:
        return {}
    modul = muat_modul('referensi_desain', HERE / 'referensi_desain.py')
    f, h = desain['font'], desain['header']
    boleh = lambda nama, google: nama if nama and (google or nama.lower() in modul.FONT_SISTEM) else ''
    teks, judul_font = boleh(f['teks'], f['teks_google']), boleh(f['judul'], f['judul_google'])
    return {
        'url': desain['url'],
        # Gaya "sorotan" portal berita punya header & footer sendiri yang sudah disepakati.
        'terapkan_header': ref.get('gaya') != 'sorotan',
        'header_gelap': h['gelap'], 'logo_posisi': h['logo_posisi'], 'menu_posisi': h['menu_posisi'],
        'header_ajakan': h['tombol_ajakan'], 'header_lengket': h['lengket'], 'menu_kapital': h['menu_kapital'],
        'topbar': h['topbar'], 'footer_gelap': desain['footer']['gelap'],
        'tombol_radius': desain['tombol']['radius'], 'tombol_kapital': desain['tombol']['kapital'],
        'kartu_radius': desain['kartu']['radius'], 'kartu_bayangan': desain['kartu']['bayangan'],
        'judul_tebal': f['judul_tebal'],
        # Gaya dealer menulis judul seksinya sendiri (huruf besar semua membuat judul panjang sulit dibaca).
        'judul_kapital': f['judul_kapital'] and ref.get('gaya') != 'dealer', 'serif_judul': f['serif_judul'],
        'font_teks': teks, 'font_judul': judul_font,
        # Font yang sudah dibawa tema (assets/fonts) dipakai lokal lewat velocity_situs font_*,
        # jadi tidak diminta lagi ke Google Fonts.
        'font_google': sorted({n for n, g in ((f['teks'], f['teks_google']), (f['judul'], f['judul_google']))
                               if n and g and n.lower() not in FONT_LOKAL}),
    }


def langkah_tema(cfg, situs, coba):
    domain = situs.domain
    if not periksa_template():
        print('fse: template tema tidak lolos pemeriksaan, tidak dipasang')
        return 1
    isi = baca_isi(domain)
    if not isi:
        print('fse: isi contoh belum ada (paket-g-konten), data situs memakai FORM ISIAN saja')
    vct = muat_modul('velocity_child_theme', HERE / 'velocity-child-theme')
    ref = referensi_desain(cfg, domain, 'berita' if isi.get('jenis') == 'berita' else 'perusahaan')
    primary, aksen, sumber_warna = warna_situs(vct, domain, ref.get('desain'))
    if ref.get('url'):
        print(f"fse: referensi={ref['url']} gaya={ref['gaya']} ({ref.get('sumber')}) "
              f"font={','.join(ref.get('fonts') or []) or '-'}" + (f" alasan={ref['alasan']}" if ref.get('alasan') else ''))
    data = {'situs': data_situs(cfg, domain, isi, vct, ref),
            'palet': hitung_palet(vct, primary, aksen, gelap=ref.get('gaya') == 'dealer'),
            'desain': token_desain(ref)}
    print(f"fse: jenis={data['situs']['jenis']} nama={data['situs']['nama']} warna={primary}/{aksen} ({sumber_warna}) "
          f"kontak_publik={'ada' if any(data['situs'][k] for k in ('wa', 'email_publik', 'alamat')) else 'tidak ada'}")

    keadaan = situs.php(PHP_DETEKSI)
    versi = versi_template()
    perlu_pasang = versi_tuple(keadaan['versi']) < versi_tuple(versi)
    print(f"fse: tema_terpasang={keadaan['versi'] or '-'} template={versi} aktif={keadaan['tema']}")
    if coba:
        print('fse: coba — ' + ('tema akan dipasang' if perlu_pasang else 'tema sudah terbaru'))
        print('fse: palet ' + ' '.join(f"{w['slug']}={w['color']}" for w in data['palet'][:7]))
        return 0

    if perlu_pasang:
        tujuan = f'/tmp/{SLUG}-{versi}.zip'
        with tempfile.TemporaryDirectory() as tmp:
            zip_lokal = Path(tmp) / f'{SLUG}.zip'
            buat_zip(zip_lokal)
            kirim = subprocess.run(situs.ssh + [f'cat > {tujuan}'], input=zip_lokal.read_bytes(),
                                   capture_output=True, timeout=180)
        if kirim.returncode != 0:
            print('fse: gagal mengirim zip tema')
            return 1
        d = shlex.quote(situs.docroot)
        pasang = situs.bash(
            f'php -d memory_limit=512M /usr/local/bin/wp theme install {tujuan} --force --path={d} --allow-root 2>&1 | tail -2; '
            f'rm -f {tujuan}; chown -R --reference={d}/wp-content/themes {d}/wp-content/themes/{SLUG} 2>/dev/null || true')
        print('fse: ' + re.sub(r'\s+', ' ', pasang.stdout).strip()[:200])
        keadaan = situs.php(PHP_DETEKSI)
        if keadaan['versi'] != versi:
            print(f"fse: tema_gagal_terpasang (terbaca {keadaan['versi'] or '-'})")
            return 1

    for baris in situs.php(PHP_TEMA, data)['hasil']:
        print(f'fse: {baris}')
    # Baca ulang dari proses baru: exit code sukses belum berarti tema aktif.
    akhir = situs.php(PHP_DETEKSI)
    if akhir['tema'] != SLUG or not akhir['blok']:
        print(f"fse: tema_tidak_aktif (aktif={akhir['tema']})")
        return 1
    print(f"fse: tema_siap:{SLUG}:{akhir['versi']}")
    return 0


# ---------------------------------------------------------------------------
# Markup blok
# ---------------------------------------------------------------------------

def atribut(data):
    """JSON atribut blok dengan escape yang sama seperti serializer editor."""
    teks = json.dumps(data, ensure_ascii=False, separators=(',', ':'))
    return (teks.replace('\\"', '\\u0022').replace('--', '\\u002d\\u002d').replace('<', '\\u003c')
            .replace('>', '\\u003e').replace('&', '\\u0026'))


def blok(nama, attrs=None, isi=None):
    a = f' {atribut(attrs)}' if attrs else ''
    if isi is None:
        return f'<!-- wp:{nama}{a} /-->'
    return f'<!-- wp:{nama}{a} -->\n{isi}\n<!-- /wp:{nama} -->'


def esc(teks):
    return html.escape(str(teks or ''), quote=False)


def esc_attr(teks):
    return html.escape(str(teks or ''), quote=True)


def paragraf(dalam):
    return blok('paragraph', None, f'<p>{dalam}</p>')


def judul(dalam, level=2, kelas=None):
    attrs = {}
    if level != 2:
        attrs['level'] = level
    if kelas:
        attrs['className'] = kelas
    cls = 'wp-block-heading' + (f' {kelas}' if kelas else '')
    return blok('heading', attrs or None, f'<h{level} class="{cls}">{dalam}</h{level}>')


def grup(anak, kelas=None, layout=None, align=None, teks=None, latar=None, padding=None):
    attrs, cls, gaya = {}, ['wp-block-group'], []
    if align:
        attrs['align'] = align
        cls.append(f'align{align}')
    if kelas:
        attrs['className'] = kelas
        cls.append(kelas)
    if latar:
        attrs['backgroundColor'] = latar
    if teks:
        attrs['textColor'] = teks
    if padding:
        attrs['style'] = {'spacing': {'padding': {'top': padding, 'bottom': padding}}}
        css = f"var(--wp--preset--spacing--{padding.rsplit('|', 1)[-1]})" if padding.startswith('var:') else padding
        gaya = [f'padding-top:{css}', f'padding-bottom:{css}']
    if teks:
        cls.append(f'has-{teks}-color')
    if latar:
        cls.append(f'has-{latar}-background-color')
    if teks:
        cls.append('has-text-color')
    if latar:
        cls.append('has-background')
    attrs['layout'] = layout or {'type': 'default'}
    style = f' style="{";".join(gaya)}"' if gaya else ''
    return blok('group', attrs, f'<div class="{" ".join(cls)}"{style}>' + '\n\n'.join(anak) + '</div>')


def kolom(anak, lebar=None):
    style = f' style="flex-basis:{lebar}"' if lebar else ''
    return blok('column', {'width': lebar} if lebar else None, f'<div class="wp-block-column"{style}>' + '\n\n'.join(anak) + '</div>')


def barisan(daftar, kelas=None, align=None):
    attrs, cls = {}, ['wp-block-columns']
    if align:
        attrs['align'] = align
        cls.append(f'align{align}')
    if kelas:
        attrs['className'] = kelas
        cls.append(kelas)
    return blok('columns', attrs or None, f'<div class="{" ".join(cls)}">' + '\n\n'.join(daftar) + '</div>')


def daftar_poin(butir, kelas=None, bernomor=False):
    tag = 'ol' if bernomor else 'ul'
    attrs = {}
    if bernomor:
        attrs['ordered'] = True
    if kelas:
        attrs['className'] = kelas
    li = ''.join(blok('list-item', None, f'<li>{b}</li>') for b in butir)
    cls = 'wp-block-list' + (f' {kelas}' if kelas else '')
    return blok('list', attrs or None, f'<{tag} class="{cls}">{li}</{tag}>')


def tombol(label, url):
    satu = blok('button', None, f'<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" '
                                f'href="{esc_attr(url)}">{esc(label)}</a></div>')
    return blok('buttons', None, f'<div class="wp-block-buttons">{satu}</div>')


# Aturan user 2026-09-14 (semua build): Kontak Kami & footer memuat email dan ikon
# media sosial saja, tautan bawaan ke beranda tiap platform (diganti PM bila klien punya akun).
SOSMED = (('facebook', 'https://www.facebook.com/'), ('instagram', 'https://www.instagram.com/'),
          ('x', 'https://x.com/'), ('youtube', 'https://www.youtube.com/'), ('tiktok', 'https://www.tiktok.com/'))


def ikon_sosmed():
    ikon = '\n\n'.join(blok('social-link', {'url': url, 'service': layanan}) for layanan, url in SOSMED)
    return blok('social-links', {'className': 'is-style-logos-only vf-sosmed'},
                f'<ul class="wp-block-social-links is-style-logos-only vf-sosmed">{ikon}</ul>')


def bar(teks, tautan=None):
    anak = [judul(esc(teks))]
    if tautan:
        anak.append(paragraf(f'<a href="{esc_attr(tautan[1])}">{esc(tautan[0])}</a>'))
    return grup(anak, kelas='vf-rubrik-bar', layout={'type': 'flex', 'flexWrap': 'nowrap', 'justifyContent': 'space-between'})


KARTU = '\n\n'.join([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '16/10'}),
    blok('post-terms', {'term': 'category', 'className': 'vf-label'}),
    blok('post-title', {'level': 3, 'isLink': True}),
    blok('post-date'),
])
DAFTAR = '\n\n'.join([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '4/3'}),
    grup([blok('post-title', {'level': 3, 'isLink': True}), blok('post-date')], kelas='vf-daftar__teks'),
])
PRODUCT_CARD = '\n\n'.join([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '1'}),
    blok('post-terms', {'term': 'category-product', 'className': 'vf-product-card__category'}),
    blok('post-title', {'level': 3, 'isLink': True, 'className': 'vf-product-card__title'}),
    blok('post-excerpt', {'moreText': 'Lihat Produk'}),
])

def query_produk(q, per=8):
    q.nomor += 1
    attrs = {'queryId': q.nomor, 'query': {'perPage': per, 'pages': 0, 'offset': 0,
        'postType': 'product', 'order': 'desc', 'orderBy': 'date', 'inherit': False}}
    tpl = {'className': 'vf-product-grid', 'layout': {'type': 'grid', 'columnCount': 4,
        'minimumColumnWidth': '14rem'}}
    return blok('query', attrs, '<div class="wp-block-query">' + blok('post-template', tpl, PRODUCT_CARD) + '</div>')
UTAMA = grup([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '16/10'}),
    grup([blok('post-terms', {'term': 'category', 'className': 'vf-label'}),
          blok('post-title', {'level': 2, 'isLink': True}),
          blok('post-date'),
          blok('post-excerpt', {'excerptLength': 26})], kelas='vf-utama__teks'),
], kelas='vf-utama__kartu')


class Query:
    def __init__(self):
        self.nomor = 100

    def __call__(self, per, offset, kelas, isi, kategori=None, grid=None, min_lebar='12rem', align=None, taksonomi='category',
                 jenis=None, urut='date', arah='desc'):
        self.nomor += 1
        q = {'perPage': per, 'pages': 0, 'offset': offset,
             'postType': jenis or ('product' if kategori == 'product' else 'post'), 'order': arah, 'orderBy': urut,
             'author': '', 'search': '', 'exclude': [], 'sticky': '', 'inherit': False}
        if kategori:
            # Format taxQuery WP 7.0+ (build_query_vars_from_query_block).
            q['taxQuery'] = {'include': {'category': [int(kategori)]}}
        tpl = {'className': kelas}
        if grid:
            tpl['layout'] = {'type': 'grid', 'columnCount': grid}
            if min_lebar:
                tpl['layout']['minimumColumnWidth'] = min_lebar
        attrs, cls = {'queryId': self.nomor, 'query': q}, 'wp-block-query'
        if align:
            attrs['align'] = align
            cls += f' align{align}'
        return blok('query', attrs, f'<div class="{cls}">' + blok('post-template', tpl, isi) + '</div>')


# ---------------------------------------------------------------------------
# Isi halaman
# ---------------------------------------------------------------------------

BLOK_HTML = re.compile(r'<(h[1-6]|p|ul|ol|blockquote|figure|table)\b[^>]*>.*?</\1\s*>'
                       r'|(?:<!--\s*velocity-map\s*-->\s*)?<iframe\b.*?</iframe\s*>'
                       r'|\[[a-z][a-z0-9_-]*(?:\s[^\]]*)?\]', re.S | re.I)


def dalam_tag(teks):
    return re.sub(r'^<[^>]+>|</[^>]+>$', '', teks.strip()).strip()


def html_ke_blok(isi, topik_dibuang=()):
    """Tulisan AI (HTML polos) → blok core yang bisa disunting per bagian.

    <h1> dibuang karena judul halaman sudah dicetak template; bagian ber-<h2>
    yang topiknya kini ditampilkan dari data company profile ikut dibuang."""
    isi = SHORTCODE_LAMA.sub('', isi)
    for j in JUDUL_LAMA:
        isi = isi.replace(j, '')
    isi = re.sub(r'</?(?:section|div|article|main|header)\b[^>]*>', '\n', isi, flags=re.I)
    hasil, pos, lewati = [], 0, False

    def teks_lepas(potongan):
        potongan = potongan.strip()
        if potongan and not lewati:
            hasil.append(paragraf(potongan) if not re.search(r'<(?!/?(?:a|strong|em|b|i|br)\b)[a-z]', potongan, re.I)
                         else blok('html', None, potongan))

    for m in BLOK_HTML.finditer(isi):
        teks_lepas(isi[pos:m.start()])
        pos = m.end()
        potong, tag = m.group(0).strip(), (m.group(1) or '').lower()
        if tag[:1] == 'h':
            level, dalam = int(tag[1]), dalam_tag(potong)
            if level == 1:
                continue
            if level == 2:
                polos = re.sub(r'<[^>]+>', '', dalam)
                lewati = any(re.search(p, polos, re.I) for p in topik_dibuang)
            if not lewati:
                hasil.append(judul(dalam, level))
        elif lewati:
            continue
        elif tag == 'p':
            if dalam_tag(potong):
                hasil.append(paragraf(dalam_tag(potong)))
        elif tag in ('ul', 'ol'):
            butir = re.findall(r'<li\b[^>]*>(.*?)</li\s*>', potong, re.S | re.I)
            if butir and not re.search(r'<(?:ul|ol)\b', ''.join(butir), re.I):
                hasil.append(daftar_poin([b.strip() for b in butir], bernomor=tag == 'ol'))
            else:
                hasil.append(blok('html', None, potong))
        elif potong.startswith('['):
            hasil.append(blok('shortcode', None, potong))
        else:
            hasil.append(blok('html', None, potong))
    teks_lepas(isi[pos:])
    return '\n\n'.join(hasil)


def kartu_isi(butir):
    """Kartu judul + teks (+ rincian) dalam baris tiga kolom."""
    baris = []
    for i in range(0, len(butir), 3):
        kolom_baris = []
        for b in butir[i:i + 3]:
            anak = [judul(esc(b.get('judul')), 3)]
            if b.get('teks'):
                anak.append(paragraf(esc(b['teks'])))
            if b.get('rincian'):
                anak.append(daftar_poin([esc(r) for r in b['rincian']]))
            kolom_baris.append(kolom([grup(anak, kelas='vf-kotak vf-kartu-isi')]))
        baris.append(barisan(kolom_baris))
    return baris


def beranda_berita(q, sd, info):
    arsip = (info['halaman'].get('berita') or {}).get('url') or info['home'] + 'berita/'
    atas = barisan([kolom([q(1, 0, 'vf-utama', UTAMA)], '62%'), kolom([q(4, 1, 'vf-daftar', DAFTAR)])],
                   kelas='vf-utama-baris', align='wide')
    seksi = [grup([bar('Berita Terbaru', ('Indeks berita →', arsip)), q(6, 5, 'vf-kartu', KARTU, grid=3)], kelas='vf-seksi')]
    for r in sd['rubrik']:
        t = info['kategori'].get(r['slug'])
        if not t:
            continue
        seksi.append(grup([
            bar(r['judul'], ('Lihat semua →', t['url'])),
            barisan([kolom([q(1, 0, 'vf-kartu', KARTU, t['id'])], '53%'), kolom([q(3, 1, 'vf-daftar', DAFTAR, t['id'])])],
                    kelas='vf-utama-baris'),
        ], kelas='vf-seksi'))
    tata = barisan([kolom(seksi, '68%'), kolom([blok('template-part', {'slug': 'sidebar'})], '32%')],
                   kelas='vf-tata', align='wide')
    return '\n\n'.join([judul(esc(sd['nama']), 1, 'screen-reader-text'), atas, tata])


SAMPUL = '\n\n'.join([
    blok('post-featured-image'),
    grup([blok('post-title', {'level': 2, 'isLink': True}), blok('post-terms', {'term': 'category'})], kelas='vf-sampul__teks'),
])


def beranda_sorotan(q, sd, info):
    """Gaya "sorotan": pita pembuka + 5 kartu foto selebar layar, lalu per rubrik
    pita judul berikon + grid 2x2 kartu foto (referensi majalah foto, mis.
    ourgrandfatherstory.com untuk anaksegalabangsa.com). Tanpa kolom samping."""
    bagian = [judul(esc(sd['nama']), 1, 'screen-reader-text'),
              grup([judul('Sorotan Pekan Ini')], kelas='vf-masthead vf-masthead--hot', align='full'),
              q(5, 0, 'vf-sampul', SAMPUL, align='full')]
    for r in sd['rubrik']:
        t = info['kategori'].get(r['slug'])
        if not t:
            continue
        pita = [judul(esc(r['judul']))]
        if r.get('teks'):
            pita.append(paragraf(esc(r['teks'])))
        pita.append(paragraf(f'<a href="{esc_attr(t["url"])}">Lihat semua →</a>'))
        bagian += [grup(pita, kelas='vf-masthead', align='full'),
                   q(4, 0, 'vf-sampul vf-sampul--dua', SAMPUL, t['id'], grid=2, min_lebar=None, align='full')]
    return '\n\n'.join(bagian)


def paragraf_kelas(dalam, kelas):
    return blok('paragraph', {'className': kelas}, f'<p class="{kelas}">{dalam}</p>')


def tombol_ganda(daftar):
    """Tombol berdampingan: [(label, url, garis)] — garis=True memakai gaya outline."""
    anak = []
    for label, url, garis in daftar:
        cls = 'wp-block-button' + (' is-style-outline' if garis else '')
        anak.append(blok('button', {'className': 'is-style-outline'} if garis else None,
                         f'<div class="{cls}"><a class="wp-block-button__link wp-element-button" '
                         f'href="{esc_attr(url)}">{esc(label)}</a></div>'))
    return blok('buttons', None, '<div class="wp-block-buttons">' + '\n\n'.join(anak) + '</div>')


def gambar(foto, kelas=None, aspek='4/3'):
    """core/image dari foto slot (opsi vfse_images, diisi paket-g-foto); '' kalau slot kosong."""
    if not foto:
        return ''
    attrs = {'id': int(foto['id']), 'sizeSlug': 'large', 'linkDestination': 'none', 'aspectRatio': aspek, 'scale': 'cover'}
    cls = 'wp-block-image size-large'
    if kelas:
        attrs['className'] = kelas
        cls += f' {kelas}'
    return blok('image', attrs, f'<figure class="{cls}"><img src="{esc_attr(foto["url"])}" alt="{esc_attr(foto.get("alt"))}" '
                               f'class="wp-image-{int(foto["id"])}" style="aspect-ratio:{aspek};object-fit:cover"/></figure>')


def sampul(foto, anak, kelas, redup=60, tinggi=520):
    """core/cover berfoto berlapis warna utama gelap (hero & pita ajakan)."""
    attrs = {'url': foto['url'], 'id': int(foto['id']), 'dimRatio': redup, 'overlayColor': 'primary-gelap',
             'isUserOverlayColor': True, 'minHeight': tinggi, 'minHeightUnit': 'px', 'align': 'full',
             'className': kelas, 'layout': {'type': 'default'}}
    return blok('cover', attrs,
                f'<div class="wp-block-cover alignfull {kelas}" style="min-height:{tinggi}px">'
                f'<img class="wp-block-cover__image-background wp-image-{int(foto["id"])}" alt="" '
                f'src="{esc_attr(foto["url"])}" data-object-fit="cover"/>'
                f'<span aria-hidden="true" class="wp-block-cover__background has-primary-gelap-background-color '
                f'has-background-dim-{redup} has-background-dim"></span>'
                '<div class="wp-block-cover__inner-container">' + '\n\n'.join(anak) + '</div></div>')


def kepala_seksi(teks, sub='', label=''):
    anak = [paragraf_kelas(esc(label), 'vf-label-seksi')] if label else []
    anak.append(judul(esc(teks)))
    if sub:
        anak.append(paragraf(esc(sub)))
    return grup(anak, kelas='vf-kepala-seksi')


def kartu_foto(daftar, foto, kunci, kolom_grid=None):
    """Kartu berfoto (layanan/produk) dalam grid; kunci[i] = slot foto butir ke-i.
    kolom_grid: jumlah kolom dari referensi klien (bawaan 4 untuk 4 butir, selain itu 3)."""
    kartu = []
    for i, b in enumerate(daftar):
        g = gambar(foto.get(kunci[i]) if i < len(kunci) else None, 'vf-kartu-foto__gambar')
        isi_kartu = [judul(esc(b.get('judul')), 3)]
        if b.get('teks'):
            isi_kartu.append(paragraf(esc(b['teks'])))
        if b.get('rincian'):
            isi_kartu.append(daftar_poin([esc(r) for r in b['rincian'][:4]]))
        kartu.append(grup(([g] if g else []) + [grup(isi_kartu, kelas='vf-kartu-foto__isi')],
                          kelas='vf-kartu-foto' + ('' if g else ' vf-kartu-foto--tanpa')))
    return grup(kartu, kelas='vf-grid-kartu', align='wide',
                layout={'type': 'grid', 'columnCount': kolom_grid or (4 if len(daftar) == 4 else 3), 'minimumColumnWidth': '15rem'})


def beranda_perusahaan_foto(q, sd, isi, info, gaya):
    """Beranda perusahaan mengikuti pola referensi klien (permintaan user 2026-09-15:
    "pastikan untuk desain sesuai referensi dari klien").

      korporat  hero foto selebar layar berlapis gelap, keunggulan di pita gelap
      terbelah  hero terang teks kiri + foto kanan, layanan di pita warna aksen

    Slot foto kosong tidak meninggalkan bingkai kosong: hero jatuh ke gradasi warna,
    kartu tanpa foto diberi garis aksen, galeri dilewati."""
    js = isi.get('judul_seksi') or {}
    foto = info.get('foto') or {}

    def tautan(slug):
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    kontak = tautan('hubungi-kami')
    bagian = []

    teks_hero = []
    if isi.get('hero_judul'):
        teks_hero.append(paragraf_kelas(esc(sd['slogan'] or sd['nama']), 'vf-label-seksi'))
    teks_hero.append(judul(esc(isi.get('hero_judul') or sd['nama']), 1))
    if isi.get('hero_teks'):
        teks_hero.append(paragraf(esc(isi['hero_teks'])))
    teks_hero.append(tombol_ganda([('Layanan Kami', tautan('layanan'), False), ('Hubungi Kami', kontak, True)]
                                  if sd['layanan'] else [('Hubungi Kami', kontak, False)]))
    if gaya == 'korporat' and foto.get('hero'):
        bagian.append(sampul(foto['hero'], teks_hero, 'vf-hero-foto', 60, 560))
    elif gaya == 'terbelah':
        kolom_hero = [kolom(teks_hero, '55%')]
        if foto.get('hero'):
            kolom_hero.append(kolom([gambar(foto['hero'], 'vf-foto-bingkai', '4/3')]))
        bagian.append(grup([barisan(kolom_hero, kelas='vf-hero-terang__baris', align='wide')], kelas='vf-hero-terang',
                           align='full', latar='latar', padding='var:preset|spacing|60', layout={'type': 'constrained'}))
    else:
        bagian.append(grup(teks_hero, kelas='vf-hero', align='full', teks='di-primary', padding='var:preset|spacing|70',
                           layout={'type': 'constrained'}))

    # Katalog produk mengikuti referensi: tampil dekat setelah hero, bukan tersembunyi di halaman Produk.
    bagian.append(grup([kepala_seksi(js.get('produk') or 'Produk Kami', 'Pilihan produk dan merchandise custom.'),
                        query_produk(q, 8), tombol('Lihat Semua Produk', tautan('produk'))],
                       kelas='vf-seksi vf-produk-unggulan', align='wide'))

    # Ringkasan tentang: Data Situs, atau paragraf pertama halaman Tentang Kami tulisan AI
    # (glcagro.com: velocity_situs.tentang kosong, seksi tampil hanya judul + tombol).
    ringkas = sd.get('tentang') or ''
    if not ringkas:
        for p in re.findall(r'<p\b[^>]*>(.*?)</p>', (info['halaman'].get('tentang-kami') or {}).get('isi', ''), re.S):
            p = re.sub(r'\s+', ' ', html.unescape(re.sub(r'<[^>]+>', '', p))).strip()
            if len(p) >= 60:
                ringkas = p if len(p) <= 320 else p[:320].rsplit(' ', 1)[0] + '…'
                break
    if ringkas or foto.get('tentang'):
        teks = [paragraf_kelas(esc(js.get('tentang') or 'Tentang Kami'), 'vf-label-seksi'), judul(esc(sd['nama']))]
        if ringkas:
            teks.append(paragraf(esc(ringkas)))
        teks.append(tombol('Selengkapnya', tautan('tentang-kami')))
        kolom_tentang = [kolom([gambar(foto['tentang'], 'vf-foto-bingkai', '4/3')])] if foto.get('tentang') else []
        bagian.append(barisan(kolom_tentang + [kolom(teks)], kelas='vf-tentang', align='wide'))

    if sd['layanan']:
        kunci = [f"layanan-{l.get('slug', '')}" for l in isi.get('layanan') or []]
        isi_seksi = [kepala_seksi(js.get('layanan') or 'Layanan Kami', js.get('layanan_sub', '')),
                     kartu_foto(sd['layanan'], foto, kunci)]
        if gaya == 'terbelah':
            bagian.append(grup(isi_seksi, kelas='vf-pita vf-pita--aksen', align='full', latar='aksen', teks='di-aksen',
                               padding='var:preset|spacing|60', layout={'type': 'constrained'}))
        else:
            bagian.append(grup(isi_seksi, kelas='vf-seksi', align='wide'))

    if isi.get('keunggulan'):
        kotak = [grup([judul(esc(k.get('judul')), 3), paragraf(esc(k.get('teks')))],
                      kelas='vf-kotak-ikon vf-ikon--' + (re.sub(r'[^a-z]', '', str(k.get('ikon') or '')) or 'satu'))
                 for k in isi['keunggulan'][:4]]
        isi_seksi = [kepala_seksi(js.get('keunggulan') or 'Mengapa Memilih Kami'),
                     grup(kotak, kelas='vf-grid-ikon', align='wide',
                          layout={'type': 'grid', 'columnCount': 4, 'minimumColumnWidth': '13rem'})]
        if gaya == 'korporat':
            bagian.append(grup(isi_seksi, kelas='vf-pita vf-pita--gelap', align='full', latar='primary', teks='di-primary',
                               padding='var:preset|spacing|60', layout={'type': 'constrained'}))
        else:
            bagian.append(grup(isi_seksi, kelas='vf-seksi', align='wide'))

    if isi.get('produk'):
        bagian.append(grup([kepala_seksi(js.get('produk') or 'Produk Kami'),
                            kartu_foto(isi['produk'], foto, [p.get('slug', '') for p in isi['produk']])],
                           kelas='vf-seksi', align='wide'))

    foto_galeri = [foto[k] for k in sorted(foto) if k.startswith('galeri-')][:6]
    if foto_galeri:
        bagian.append(grup([kepala_seksi(js.get('galeri') or 'Galeri Kegiatan', js.get('galeri_sub', '')),
                            grup([gambar(f, 'vf-galeri__foto', '1/1') for f in foto_galeri], kelas='vf-galeri', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '12rem'}),
                            tombol('Lihat Galeri', tautan('galeri'))],
                           kelas='vf-seksi vf-seksi--galeri', align='wide'))

    arsip = tautan('berita')
    bagian.append(grup([bar('Artikel Terbaru', ('Lihat semua →', arsip)), q(3, 0, 'vf-kartu', KARTU, grid=3)],
                       kelas='vf-seksi', align='wide'))

    ajakan = [judul(esc(js.get('pemesanan') or 'Siap membantu kebutuhan Anda')),
              paragraf(esc(js.get('pemesanan_sub') or f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
              tombol('Hubungi Kami', kontak)]
    foto_ajakan = foto.get('galeri-1') or foto.get('tentang') or foto.get('hero')
    if gaya == 'korporat' and foto_ajakan:
        bagian.append(sampul(foto_ajakan, ajakan, 'vf-ajakan-foto', 70, 320))
    else:
        bagian.append(grup(ajakan, kelas='vf-ajakan', align='wide', teks='di-primary', latar='primary',
                           padding='var:preset|spacing|50', layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


KATALOG_DIR = Path(os.environ.get('VELOCITY_FSE_KATALOG') or '/var/lib/velocity/fse-katalog')


def katalog_data(domain, sd, isi):
    """Isi beranda gaya katalog. Berkas <KATALOG_DIR>/<domain>.json (disusun dari katalog &
    company profile klien) didahulukan; tanpa berkas itu isi diturunkan dari data AI situs."""
    berkas = KATALOG_DIR / f'{domain}.json'
    if domain and berkas.is_file():
        return json.loads(berkas.read_text())
    nama = sd['nama']
    return {
        'hero': {'judul': isi.get('hero_judul') or nama, 'teks': isi.get('hero_teks') or '',
                 'panel_judul': 'Layanan Kami', 'panel': [l.get('judul') for l in sd.get('layanan') or []][:4]},
        'keunggulan': {'judul': f'Kenapa Memilih {nama}?',
                       'butir': [{'judul': k.get('judul'), 'teks': k.get('teks')} for k in (isi.get('keunggulan') or [])[:5]]},
        'koleksi': {'judul': 'Produk Pilihan',
                    'butir': [{'judul': p.get('judul'), 'sub': p.get('teks')} for p in isi.get('produk') or []]},
        'cta': {'judul': 'Siap membantu kebutuhan Anda',
                'teks': f'Ceritakan kebutuhan Anda, tim {nama} akan segera menghubungi kembali.'},
    }


def ikon(nama):
    """Kelas ikon CSS (mask SVG di style.css, bagian gaya katalog)."""
    return 'vf-ik vf-ik--' + (re.sub(r'[^a-z]', '', str(nama or '')) or 'bintang')


def lipat(tanya, jawab, kelas):
    return blok('details', {'className': kelas},
                f'<details class="wp-block-details {kelas}"><summary>{esc(tanya)}</summary>'
                + paragraf(esc(jawab)) + '</details>')


def beranda_katalog(q, sd, isi, info):
    """Beranda katalog merchandise mengikuti pola referensi klien (user 2026-09-15, contoh
    tasseminarpalupi.com): hero gelap + panel layanan, deret media cetak, fakta workshop + angka,
    split desain custom, keunggulan berikon 3+2, koleksi 3 kolom, ubin kategori, FAQ akordeon,
    teks SEO, CTA gelap. Tanpa foto produk: kartu & ubin memakai ikon. Teks dari katalog_data."""
    d = katalog_data(info.get('domain', ''), sd, isi)
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'
    produk = ((info.get('semua') or {}).get('produk') or {}).get('url') or info['home'] + 'produk/'
    bagian = []

    h = d.get('hero') or {}
    kiri = [paragraf_kelas('★★★★★&nbsp; ' + esc(h['trust']), 'vf-kat-trust')] if h.get('trust') else []
    kiri.append(judul(esc(h.get('judul') or sd['nama']), 1))
    if h.get('sorot'):
        kiri.append(paragraf_kelas(esc(h['sorot']), 'vf-kat-sorot'))
    if h.get('teks'):
        kiri.append(paragraf(esc(h['teks'])))
    kiri.append(tombol_ganda([(h.get('tombol') or 'Hubungi Kami', kontak, False), ('Lihat Produk', produk, True)]))
    kanan = []
    if h.get('panel'):
        kanan.append(grup([paragraf_kelas(esc(h.get('panel_judul') or 'Layanan Kami'), 'vf-kat-panel__judul')]
                          + [paragraf_kelas(esc(p), 'vf-kat-panel__item') for p in h['panel']], kelas='vf-kat-panel'))
    bagian.append(grup([barisan([kolom(kiri, '58%'), kolom(kanan, '42%')], kelas='vf-kat-hero__baris', align='wide')],
                       kelas='vf-kat-hero', align='full', layout={'type': 'constrained'}))

    m = d.get('media') or {}
    if m.get('butir'):
        bagian.append(grup([kepala_seksi(m.get('judul') or 'Media Cetak', m.get('teks', ''), m.get('label', '')),
                            grup([paragraf_kelas(esc(b), 'vf-kat-media__item') for b in m['butir']], kelas='vf-kat-media',
                                 layout={'type': 'flex', 'flexWrap': 'wrap', 'justifyContent': 'center'})],
                           kelas='vf-seksi vf-kat-media-seksi', align='wide'))

    f = d.get('fakta') or {}
    if f.get('butir'):
        kiri = [judul(esc(f['judul']))] + ([paragraf(esc(f['teks']))] if f.get('teks') else [])
        if f.get('poin'):
            kiri.append(daftar_poin([esc(p) for p in f['poin']], kelas='vf-kat-cek'))
        kanan = [grup([paragraf_kelas(esc(a), 'vf-kat-angka'), paragraf_kelas(esc(b), 'vf-kat-angka__label')],
                      kelas='vf-kat-fakta__item') for a, b in f['butir']]
        bagian.append(grup([barisan([kolom(kiri, '60%'), kolom(kanan, '40%')], kelas='vf-kat-fakta', align='wide')],
                           kelas='vf-seksi', align='wide'))

    c = d.get('custom') or {}
    if c.get('judul'):
        kiri = [paragraf_kelas(esc(c['label']), 'vf-label-seksi')] if c.get('label') else []
        tanda = f'<span class="vf-kat-tanda">{esc(c["tanda"])}</span><br>' if c.get('tanda') else ''
        kiri += [judul(tanda + esc(c['judul'])), paragraf(esc(c.get('teks', '')))]
        langkah = c.get('langkah') or [(a.get('judul'), a.get('teks')) for a in (isi.get('alur') or [])[:3]]
        kanan = [grup([paragraf_kelas(str(i), 'vf-kat-langkah__no'),
                       grup([judul(esc(a), 3), paragraf(esc(b))], kelas='vf-kat-langkah__teks')],
                      kelas='vf-kat-langkah') for i, (a, b) in enumerate(langkah, 1)]
        bagian.append(grup([barisan([kolom(kiri, '50%'), kolom(kanan, '50%')], kelas='vf-kat-custom', align='wide')],
                           kelas='vf-seksi', align='wide'))

    k = d.get('keunggulan') or {}
    if k.get('butir'):
        kartu = [grup([judul(esc(b.get('judul')), 3), paragraf(esc(b.get('teks')))],
                      kelas='vf-kat-unggul ' + ikon(b.get('ikon'))) for b in k['butir'][:5]]
        bagian.append(grup([kepala_seksi(k.get('judul') or 'Keunggulan Kami'),
                            grup(kartu, kelas='vf-kat-unggul-grid', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '14rem'})],
                           kelas='vf-kat-band', align='full', layout={'type': 'constrained'}))

    ko = d.get('koleksi') or {}
    if ko.get('butir'):
        kartu = []
        for b in ko['butir']:
            anak = [grup([], kelas='vf-kat-koleksi__ikon ' + ikon(b.get('ikon'))), judul(esc(b.get('judul')), 3)]
            if b.get('sub'):
                anak.append(paragraf(esc(b['sub'])))
            if b.get('tag'):
                anak.append(paragraf_kelas(esc(b['tag']), 'vf-kat-tag'))
            kartu.append(grup(anak, kelas='vf-kat-koleksi__kartu'))
        bagian.append(grup([kepala_seksi(ko.get('judul') or 'Produk Pilihan', ko.get('sub', '')),
                            grup(kartu, kelas='vf-kat-koleksi__grid', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '14rem'}),
                            tombol('Lihat Semua Produk', produk)],
                           kelas='vf-seksi vf-kat-koleksi', align='wide'))

    band = []
    ka = d.get('kategori') or {}
    if ka.get('butir'):
        ubin = [grup([paragraf_kelas(f'<a href="{esc_attr(produk)}">{esc(b.get("judul"))}</a>', 'vf-kat-ubin__label')],
                     kelas='vf-kat-ubin ' + ikon(b.get('ikon'))) for b in ka['butir']]
        band.append(grup([kepala_seksi(ka.get('judul') or 'Kategori Produk'),
                          grup(ubin, kelas='vf-kat-ubin-grid', align='wide',
                               layout={'type': 'grid', 'columnCount': 5, 'minimumColumnWidth': '9rem'}),
                          tombol('Lihat Semua Kategori', produk)], kelas='vf-kat-kategori', align='wide'))
    fq = d.get('faq') or {}
    if fq.get('butir'):
        band.append(grup([kepala_seksi(fq.get('judul') or 'Pertanyaan Umum')]
                         + [lipat(t, j, 'vf-kat-faq__item') for t, j in fq['butir']], kelas='vf-kat-faq', align='wide'))
    if band:
        bagian.append(grup(band, kelas='vf-kat-band vf-kat-band--bawah', align='full', layout={'type': 'constrained'}))

    s = d.get('seo') or {}
    if s.get('judul'):
        bagian.append(grup([judul(esc(s['judul']), kelas='vf-kat-seo__judul'), paragraf(esc(s.get('teks', ''))),
                            tombol_ganda([('Hubungi Kami', kontak, True)])], kelas='vf-seksi vf-kat-seo', align='wide'))

    ct = d.get('cta') or {}
    bagian.append(grup([judul(esc(ct.get('judul') or 'Hubungi Kami')), paragraf(esc(ct.get('teks', ''))),
                        tombol(ct.get('tombol') or 'Hubungi Kami', kontak)],
                       kelas='vf-kat-cta', align='wide', layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


# ---------------------------------------------------------------------------
# Beranda mengikuti referensi web klien (gaya "referensi")
# ---------------------------------------------------------------------------

def paket_toko(cfg):
    """Paket Toko Online (custom maupun biasa): produk dari plugin VD Store."""
    return 'tokoonline' in re.sub(r'\s+', '', str(cfg.get('paket', '')).lower())


def vd_store(kode):
    return blok('shortcode', None, kode)


def ringkasan_tentang(sd, info):
    """Data Situs, atau paragraf pertama halaman Tentang Kami tulisan AI."""
    if sd.get('tentang'):
        return sd['tentang']
    for p in re.findall(r'<p\b[^>]*>(.*?)</p>', (info['halaman'].get('tentang-kami') or {}).get('isi', ''), re.S):
        p = re.sub(r'\s+', ' ', html.unescape(re.sub(r'<[^>]+>', '', p))).strip()
        if len(p) >= 60:
            return p if len(p) <= 320 else p[:320].rsplit(' ', 1)[0] + '…'
    return ''


def seksi_berlatar(anak, s, foto=None):
    """Bungkus satu seksi sesuai latar seksi referensi: terang | abu | aksen | gelap | foto."""
    latar = s.get('latar')
    kelas = f"vf-ref-seksi vf-ref-{s['jenis']}" + (' vf-rata-tengah' if s.get('rata') == 'tengah' else '')
    penuh = {'type': 'constrained'}
    if latar == 'foto' and foto:
        # dimRatio core/cover hanya kelipatan 10 (kelas has-background-dim-NN), selain itu blok tidak valid.
        return sampul(foto, anak, kelas + ' vf-pita-foto', 70, 420)
    if latar in ('gelap', 'foto'):
        return grup(anak, kelas=kelas + ' vf-pita vf-pita--gelap', align='full', latar='primary', teks='di-primary',
                    padding='var:preset|spacing|60', layout=penuh)
    if latar == 'aksen':
        return grup(anak, kelas=kelas + ' vf-pita vf-pita--aksen', align='full', latar='aksen', teks='di-aksen',
                    padding='var:preset|spacing|60', layout=penuh)
    if latar == 'abu':
        return grup(anak, kelas=kelas + ' vf-pita', align='full', latar='latar', padding='var:preset|spacing|60', layout=penuh)
    return grup(anak, kelas=kelas + ' vf-seksi', align='wide')


def kotak_ikon(butir, kolom_grid):
    kotak = [grup([judul(esc(k.get('judul')), 3), paragraf(esc(k.get('teks')))],
                  kelas='vf-kotak-ikon vf-ikon--' + (re.sub(r'[^a-z]', '', str(k.get('ikon') or '')) or 'satu'))
             for k in butir]
    return grup(kotak, kelas='vf-grid-ikon', align='wide',
                layout={'type': 'grid', 'columnCount': kolom_grid, 'minimumColumnWidth': '13rem'})


def beranda_referensi(q, sd, isi, info):
    """Beranda disusun mengikuti referensi web klien (keputusan user 2026-09-15: referensi =
    ACUAN UTAMA; tata letak & gaya mirip, konten milik klien).

    Urutan & jenis seksi, varian hero, latar tiap seksi, dan jumlah kolom kartu dibaca dari
    rencana scripts/referensi_desain.py (info['desain']). Isi tiap seksi dari data klien.
    Seksi yang tidak punya data jujur — testimoni, angka pencapaian, FAQ, video, logo klien
    tanpa daftar pelanggan — dilewati dan dicatat, tidak dikarang. Toko online: produk
    memakai shortcode VD Store dan selalu tampil di beranda."""
    desain = info['desain']
    js = isi.get('judul_seksi') or {}
    foto = info.get('foto') or {}
    toko = bool(info.get('toko'))
    kontak = ((info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/')
    produk_url = info['home'] + 'produk/'
    foto_galeri = [foto[k] for k in sorted(foto) if k.startswith('galeri-')]

    def tautan(slug):
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    def kolom_ref(s, bawaan, jumlah):
        return max(1, min(int(s.get('kolom') or bawaan), jumlah or bawaan, 6))

    def kategori(s):
        return s['jenis'] == 'produk' and re.search(r'kategori|category', s.get('judul_referensi', ''), re.I)

    def hero(s):
        teks_hero = []
        if sd.get('slogan'):
            teks_hero.append(paragraf_kelas(esc(sd['slogan']), 'vf-label-seksi'))
        teks_hero.append(judul(esc(isi.get('hero_judul') or sd['nama']), 1))
        if isi.get('hero_teks'):
            teks_hero.append(paragraf(esc(isi['hero_teks'])))
        if toko:
            aksi = [('Lihat Produk', produk_url, False), ('Hubungi Kami', kontak, True)]
        elif sd['layanan']:
            aksi = [('Layanan Kami', tautan('layanan'), False), ('Hubungi Kami', kontak, True)]
        else:
            aksi = [('Hubungi Kami', kontak, False)]
        teks_hero.append(tombol_ganda(aksi))
        varian = s.get('varian') or 'foto'
        rata = ' vf-rata-tengah' if s.get('rata') == 'tengah' or varian == 'terang' else ''
        if varian == 'foto' and foto.get('hero'):
            return sampul(foto['hero'], teks_hero, 'vf-hero-foto vf-ref-hero' + rata, 60, 560)
        if varian == 'terbelah':
            kol = [kolom(teks_hero, '55%')] + ([kolom([gambar(foto['hero'], 'vf-foto-bingkai', '4/3')])] if foto.get('hero') else [])
            return grup([barisan(kol, kelas='vf-hero-terang__baris', align='wide')], kelas='vf-hero-terang vf-ref-hero',
                        align='full', latar='latar', padding='var:preset|spacing|60', layout={'type': 'constrained'})
        if varian == 'terang':
            return grup(teks_hero, kelas='vf-hero-terang vf-ref-hero' + rata, align='full', latar='latar',
                        padding='var:preset|spacing|70', layout={'type': 'constrained'})
        # warna, atau hero berfoto yang slot fotonya masih kosong: gradasi warna utama.
        return grup(teks_hero, kelas='vf-hero vf-ref-hero' + rata, align='full', teks='di-primary',
                    padding='var:preset|spacing|70', layout={'type': 'constrained'})

    def tentang(s):
        ringkas = ringkasan_tentang(sd, info)
        if not (ringkas or foto.get('tentang')):
            return ''
        teks = [paragraf_kelas(esc(js.get('tentang') or 'Tentang Kami'), 'vf-label-seksi'), judul(esc(sd['nama']))]
        if ringkas:
            teks.append(paragraf(esc(ringkas)))
        teks.append(tombol('Selengkapnya', tautan('tentang-kami')))
        kol = [kolom([gambar(foto['tentang'], 'vf-foto-bingkai', '4/3')])] if foto.get('tentang') else []
        return seksi_berlatar([barisan(kol + [kolom(teks)], kelas='vf-tentang', align='wide')], s)

    def layanan(s):
        if not sd['layanan']:
            return ''
        n = kolom_ref(s, 3, len(sd['layanan']))
        if s.get('kartu_ikon') and not s.get('kartu_foto'):
            grid = kotak_ikon(sd['layanan'], n)
        else:
            grid = kartu_foto(sd['layanan'], foto, [f"layanan-{l.get('slug', '')}" for l in isi.get('layanan') or []], n)
        return seksi_berlatar([kepala_seksi(js.get('layanan') or 'Layanan Kami', js.get('layanan_sub', '')), grid], s,
                              foto.get('galeri-1'))

    def produk(s):
        if toko:
            n = kolom_ref(s, 4, 6)
            if kategori(s):
                return seksi_berlatar([kepala_seksi('Kategori Produk'),
                                       vd_store(f'[wp_store_taxonomies_carousel columns="{max(n, 4)}" rows="1"]')], s)
            kode = (f'[wp_store_products_carousel per_row="{n}"]' if s.get('slider')
                    else f'[wp_store_shop per_page="{n * 2}"]')
            return seksi_berlatar([kepala_seksi(js.get('produk') or 'Produk Terbaru'), vd_store(kode),
                                   tombol('Lihat Semua Produk', produk_url)], s)
        if not isi.get('produk'):
            return ''
        return seksi_berlatar([kepala_seksi(js.get('produk') or 'Produk Kami'),
                               kartu_foto(isi['produk'], foto, [p.get('slug', '') for p in isi['produk']],
                                          kolom_ref(s, 3, len(isi['produk'])))], s)

    def keunggulan(s):
        if not isi.get('keunggulan'):
            return ''
        butir = isi['keunggulan'][:6]
        return seksi_berlatar([kepala_seksi(js.get('keunggulan') or 'Mengapa Memilih Kami'),
                               kotak_ikon(butir, kolom_ref(s, 4, len(butir)))], s, foto.get('galeri-2'))

    def alur(s):
        if not isi.get('alur'):
            return ''
        langkah = [kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))]) for a in isi['alur'][:5]]
        return seksi_berlatar([kepala_seksi(js.get('alur') or 'Alur Kerja'), barisan(langkah, kelas='vf-langkah', align='wide')], s)

    def galeri(s):
        if not foto_galeri:
            return ''
        n = kolom_ref(s, 3, len(foto_galeri))
        return seksi_berlatar([kepala_seksi(js.get('galeri') or 'Galeri', js.get('galeri_sub', '')),
                               grup([gambar(f, 'vf-galeri__foto', '1/1') for f in foto_galeri[:max(n * 2, 4)]],
                                    kelas='vf-galeri', align='wide',
                                    layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '11rem'}),
                               tombol('Lihat Galeri', tautan('galeri'))], s)

    def klien(s):
        nama = [c if isinstance(c, str) else c.get('nama', '') for c in isi.get('customer') or []]
        nama = [n for n in nama if n][:24]
        if not nama:
            return ''
        return seksi_berlatar([kepala_seksi('Klien Kami'),
                               grup([paragraf_kelas(esc(n), 'vf-klien__nama') for n in nama], kelas='vf-klien', align='wide',
                                    layout={'type': 'grid', 'columnCount': kolom_ref(s, 4, len(nama)), 'minimumColumnWidth': '10rem'})], s)

    def artikel(s):
        n = kolom_ref(s, 3, 4)
        return seksi_berlatar([bar('Artikel Terbaru', ('Lihat semua →', tautan('berita'))), q(n, 0, 'vf-kartu', KARTU, grid=n)], s)

    def kontak_seksi(s):
        return seksi_berlatar([kepala_seksi('Hubungi Kami'), blok('velocity/kontak'), tombol('Hubungi Kami', kontak)], s)

    def ajakan(s):
        anak = [judul(esc(js.get('pemesanan') or 'Siap membantu kebutuhan Anda')),
                paragraf(esc(js.get('pemesanan_sub') or f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
                tombol('Hubungi Kami', kontak)]
        return seksi_berlatar(anak, dict(s, rata='tengah'), foto.get('galeri-1') or foto.get('tentang') or foto.get('hero'))

    pembuat = {'hero': hero, 'tentang': tentang, 'layanan': layanan, 'produk': produk, 'keunggulan': keunggulan,
               'alur': alur, 'galeri': galeri, 'klien': klien, 'artikel': artikel, 'kontak': kontak_seksi, 'ajakan': ajakan}
    susunan = [dict(s) for s in desain.get('seksi') or []]
    if toko and not any(s['jenis'] == 'produk' and not kategori(s) for s in susunan):
        # Toko online: daftar produk VD Store wajib ada di beranda walau referensi tidak memuatnya.
        letak = next((i + 1 for i, s in enumerate(susunan) if kategori(s)), 1 if susunan and susunan[0]['jenis'] == 'hero' else 0)
        susunan.insert(letak, {'jenis': 'produk', 'latar': 'terang', 'kolom': 4, 'rata': 'tengah', 'judul_referensi': ''})
    bagian, dilewati, dipakai = [], [], set()
    for s in susunan:
        kunci = s['jenis'] + (':kategori' if kategori(s) else '')
        if kunci in dipakai and s['jenis'] != 'ajakan':
            continue  # isi yang sama tidak dicetak dua kali (referensi mengulang jenis seksi)
        markup = pembuat[s['jenis']](s) if s['jenis'] in pembuat else ''
        if markup:
            bagian.append(markup)
            dipakai.add(kunci)
        else:
            dilewati.append(s['jenis'])
    if len(bagian) < 3:
        # Referensi yang hampir seluruhnya berisi seksi tanpa data klien: tetap beranda utuh.
        for s in ({'jenis': 'layanan', 'latar': 'terang'}, {'jenis': 'artikel', 'latar': 'terang'},
                  {'jenis': 'ajakan', 'latar': 'gelap'}):
            if s['jenis'] not in dipakai and (markup := pembuat[s['jenis']](s)):
                bagian.append(markup)
    info['dilewati'] = dilewati
    return '\n\n'.join(bagian)


DEALER_DIR = Path(os.environ.get('VELOCITY_FSE_DEALER') or '/var/lib/velocity/fse-dealer')


def dealer_data(domain, sd, isi):
    """Isi beranda dealer mobil. Berkas <DEALER_DIR>/<domain>.json (disusun dari FORM ISIAN,
    katalog/company profile, dan data unit yang dipastikan dealer) didahulukan; tanpa berkas itu
    isi diturunkan dari data AI situs supaya beranda tidak pernah kosong."""
    berkas = DEALER_DIR / f'{domain}.json'
    if domain and berkas.is_file():
        return json.loads(berkas.read_text())
    nama = sd['nama']
    return {
        'hero': {'judul': isi.get('hero_judul') or nama, 'teks': isi.get('hero_teks') or '',
                 'panel_judul': sd.get('slogan') or 'Mobil listrik untuk keseharian Anda',
                 'panel': isi.get('tentang') or ''},
        'intro': {'judul': nama, 'teks': isi.get('tentang') or ''},
        'teknologi': {'judul': 'Teknologi Unggulan',
                      'butir': [{'judul': l.get('judul'), 'ikon': 'kilat'} for l in (sd.get('layanan') or [])[:8]]},
        'keunggulan': {'judul': 'Mengapa Memilih Kami',
                       'butir': [{'judul': k.get('judul'), 'teks': k.get('teks'), 'ikon': 'bintang'}
                                 for k in (isi.get('keunggulan') or [])[:4]]},
    }


def blok_peta(peta):
    """Peta lokasi (core/html + iframe) dari titik hasil scripts/velocity-map (opsi velocity_map).
    Penanda <!-- velocity-map --> sama dengan milik site-finish supaya petanya tidak dobel."""
    if not peta or not peta.get('q'):
        return ''
    src = (f"https://www.google.com/maps?q={urllib.parse.quote(str(peta['q']))}"
           f"&amp;z={int(peta.get('zoom') or 16)}&amp;output=embed")
    return blok('html', None, '<!-- velocity-map -->\n'
                f'<iframe src="{src}" width="100%" height="380" style="border:0" loading="lazy" '
                'title="Peta lokasi"></iframe>')


def galeri_slot(foto, batas=12):
    """core/gallery dari foto slot (vfse_images). Dipakai halaman Galeri situs yang fotonya
    berasal dari installer, bukan kiriman klien."""
    daftar = [foto[k] for k in sorted(foto) if foto.get(k)][:batas]
    if not daftar:
        return ''
    anak = '\n\n'.join(gambar(f, None, '4/3') for f in daftar)
    return blok('gallery', {'columns': 3, 'linkTo': 'none', 'className': 'vf-galeri'},
                '<figure class="wp-block-gallery has-nested-images columns-3 is-cropped vf-galeri">'
                + anak + '</figure>')


def beranda_dealer(q, sd, isi, info):
    """Beranda dealer mobil mengikuti susunan referensi klien (xpengsurabayaofficial.com):
    hero foto + kartu keterangan, pengantar, kartu model unit (CPT mobil), ubin nilai berfoto,
    foto jajaran unit, teknologi berikon dua kolom, pita promo, keunggulan berikon, kartu
    test drive & simulasi kredit, panel artikel.

    Angka unit (tenaga, torsi, jarak tempuh, harga) TIDAK ditulis di halaman: semuanya dari
    Data Unit di CPT mobil, jadi PM mengubahnya di wp-admin dan halaman tidak perlu disusun ulang."""
    d = dealer_data(info.get('domain', ''), sd, isi)
    foto = info.get('foto') or {}
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'

    def dua_warna(teks, level=2):
        """Judul dua warna seperti referensi ("Teknologi XPENG"): bagian setelah "|" memakai
        warna aksen. <strong> dipakai karena format itu sah di core/heading (span dibuang editor)."""
        bagian = str(teks or '').split('|', 1)
        dalam = esc(bagian[0].strip())
        if len(bagian) > 1 and bagian[1].strip():
            dalam += f' <strong>{esc(bagian[1].strip())}</strong>'
        tag = f'h{level}'
        return blok('heading', {'level': level} if level != 2 else None,
                    f'<{tag} class="wp-block-heading">{dalam}</{tag}>')

    def kepala(teks, sub='', level=2):
        anak = [dua_warna(teks, level)]
        if sub:
            anak.append(paragraf(esc(sub)))
        return grup(anak, kelas='vf-kepala-seksi')

    def tautan(slug):
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    model_url = info['home'] + 'model-unit/'
    test_drive, kredit = tautan('test-drive'), tautan('simulasi-kredit')
    bagian = []

    # 1. Hero: judul besar di kiri, kartu keterangan di kanan (susunan referensi).
    h = d.get('hero') or {}
    teks_hero = []
    if h.get('label'):
        teks_hero.append(paragraf_kelas(esc(h['label']), 'vf-label-seksi'))
    teks_hero.append(dua_warna(h.get('judul') or sd['nama'], 1))
    if h.get('teks'):
        teks_hero.append(paragraf(esc(h['teks'])))
    teks_hero.append(tombol_ganda([('Test Drive', test_drive, False), ('Model Unit', model_url, True)]))
    kartu = []
    if h.get('panel_judul'):
        kartu.append(paragraf_kelas(esc(h['panel_judul']), 'vf-dealer-kartu__judul'))
    if h.get('panel'):
        kartu.append(paragraf(esc(h['panel'])))
    isi_hero = [barisan([kolom(teks_hero, '58%')] + ([kolom([grup(kartu, kelas='vf-dealer-kartu')])] if kartu else []),
                        kelas='vf-dealer-hero__baris', align='wide')]
    if foto.get('hero'):
        bagian.append(sampul(foto['hero'], isi_hero, 'vf-dealer-hero', 60, 620))
    else:
        bagian.append(grup(isi_hero, kelas='vf-dealer-hero vf-dealer-hero--polos', align='full', latar='primary',
                           teks='di-primary', padding='var:preset|spacing|70', layout={'type': 'constrained'}))

    # 2. Pengantar di tengah.
    intro = d.get('intro') or {}
    if intro.get('judul') or intro.get('teks'):
        bagian.append(grup([kepala(intro.get('judul') or sd['nama'], intro.get('teks', ''))],
                           kelas='vf-seksi vf-dealer-intro vf-rata-tengah', align='wide'))

    # 3. Model unit: satu kartu per unit dari CPT mobil (blok velocity/mobil-kartu).
    model = d.get('model') or {}
    bagian.append(grup([
        kepala(model.get('judul') or 'Model Unit', model.get('teks', '')),
        # Urutan unit ditentukan kolom "Urutan" WordPress (menu_order), bukan tanggal buat.
        q(model.get('jumlah') or 6, 0, 'vf-dealer-model', blok('velocity/mobil-kartu'), jenis='mobil',
          urut='menu_order', arah='asc'),
        tombol('Lihat Semua Model', model_url),
    ], kelas='vf-seksi vf-dealer-model__seksi', align='wide'))

    # 4. Ubin nilai berfoto (tiga ubin di referensi).
    nilai = [n for n in (d.get('nilai') or []) if n.get('judul')][:3]
    if nilai:
        ubin = []
        for i, n in enumerate(nilai, 1):
            teks_ubin = [judul(esc(n['judul']), 3)]
            if n.get('teks'):
                teks_ubin.append(paragraf(esc(n['teks'])))
            anak = ([gambar(foto[f'nilai-{i}'], 'vf-nilai__foto', '4/3')] if foto.get(f'nilai-{i}') else [])
            ubin.append(grup(anak + [grup(teks_ubin, kelas='vf-nilai__teks')], kelas='vf-nilai__ubin'))
        bagian.append(grup(ubin, kelas='vf-nilai', align='full',
                           layout={'type': 'grid', 'columnCount': len(ubin), 'minimumColumnWidth': '16rem'}))

    # 5. Foto jajaran unit selebar isi.
    if foto.get('lineup'):
        bagian.append(grup([gambar(foto['lineup'], 'vf-dealer-lineup__foto', '21/9')],
                           kelas='vf-seksi vf-dealer-lineup', align='wide'))

    # 6. Teknologi: daftar berikon dua kolom.
    tek = d.get('teknologi') or {}
    butir_tek = [b for b in (tek.get('butir') or []) if b.get('judul')][:8]
    if butir_tek:
        bagian.append(grup([kepala(tek.get('judul') or 'Teknologi', tek.get('teks', '')),
                            kotak_ikon(butir_tek, 2)],
                           kelas='vf-seksi vf-dealer-teknologi vf-rata-tengah', align='wide'))

    # 7. Pita promo berfoto + ajakan hubungi.
    promo = d.get('promo') or {}
    if promo.get('judul'):
        anak = [dua_warna(promo['judul'])]
        if promo.get('teks'):
            anak.append(paragraf(esc(promo['teks'])))
        anak.append(tombol_ganda([('Hubungi Kami', kontak, False), ('Simulasi Kredit', kredit, True)]))
        if foto.get('promo'):
            bagian.append(sampul(foto['promo'], anak, 'vf-dealer-promo', 70, 420))
        else:
            bagian.append(grup(anak, kelas='vf-dealer-promo vf-pita vf-pita--gelap', align='full', latar='primary',
                               teks='di-primary', padding='var:preset|spacing|60', layout={'type': 'constrained'}))

    # 8. Keunggulan dealer berikon.
    unggul = d.get('keunggulan') or {}
    butir_unggul = [b for b in (unggul.get('butir') or []) if b.get('judul')][:4]
    if butir_unggul:
        bagian.append(grup([kepala(unggul.get('judul') or 'Mengapa Memilih Kami', unggul.get('teks', '')),
                            kotak_ikon(butir_unggul, len(butir_unggul))],
                           kelas='vf-seksi vf-dealer-unggul vf-rata-tengah', align='wide'))

    # 9. Dua kartu layanan: test drive & simulasi kredit (seperti referensi).
    kartu_layanan = []
    for l in (d.get('layanan') or [{'judul': 'Test Drive', 'url': 'test-drive', 'tombol': 'Jadwalkan Test Drive'},
                                   {'judul': 'Simulasi Kredit', 'url': 'simulasi-kredit', 'tombol': 'Hitung Simulasi Kredit'}]):
        url = tautan(l.get('url') or 'hubungi-kami')
        anak = [judul(esc(l['judul']), 3)]
        if l.get('teks'):
            anak.append(paragraf(esc(l['teks'])))
        anak.append(tombol(l.get('tombol') or 'Selengkapnya', url))
        kartu_layanan.append(kolom([grup(anak, kelas='vf-dealer-layanan__kartu vf-ikon--' + (l.get('ikon') or 'kilat'))]))
    bagian.append(grup([barisan(kartu_layanan, kelas='vf-dealer-layanan', align='wide')],
                       kelas='vf-seksi', align='wide'))

    # 10. Panel artikel + kartu tulisan terbaru.
    panel = [dua_warna((d.get('artikel') or {}).get('judul') or 'Info Terbaru')]
    if (d.get('artikel') or {}).get('teks'):
        panel.append(paragraf(esc(d['artikel']['teks'])))
    panel.append(blok('search', {'label': 'Cari', 'showLabel': False, 'placeholder': 'Temukan info…',
                                 'buttonText': 'Cari', 'buttonPosition': 'button-outside', 'buttonUseIcon': True,
                                 'className': 'vf-dealer-cari'}))
    bagian.append(grup([grup(panel, kelas='vf-dealer-panel'),
                        q(3, 0, 'vf-kartu vf-dealer-artikel', KARTU, grid=3),
                        tombol('Semua Artikel', tautan('berita'))],
                       kelas='vf-seksi vf-dealer-info', align='wide'))
    return '\n\n'.join(bagian)


def beranda_perusahaan(q, sd, isi, info):
    if sd.get('gaya') == 'referensi' and info.get('desain'):
        return beranda_referensi(q, sd, isi, info)
    if sd.get('gaya') == 'katalog':
        return beranda_katalog(q, sd, isi, info)
    if sd.get('gaya') in ('korporat', 'terbelah'):
        return beranda_perusahaan_foto(q, sd, isi, info, sd['gaya'])
    js = isi.get('judul_seksi') or {}
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'
    hero = [judul(esc(isi.get('hero_judul') or sd['nama']), 1)]
    if isi.get('hero_teks'):
        hero.append(paragraf(esc(isi['hero_teks'])))
    if isi.get('hero_poin'):
        hero.append(daftar_poin([esc(p) for p in isi['hero_poin']], kelas='vf-hero__poin'))
    hero.append(tombol('Hubungi Kami', kontak))
    bagian = [grup(hero, kelas='vf-hero', align='full', teks='di-primary', padding='var:preset|spacing|70',
                   layout={'type': 'constrained'})]
    if sd['layanan']:
        anak = [judul(esc(js.get('layanan') or 'Layanan Kami'))]
        if js.get('layanan_sub'):
            anak.append(paragraf(esc(js['layanan_sub'])))
        bagian.append(grup(anak + kartu_isi(sd['layanan']), kelas='vf-seksi', align='wide', padding='var:preset|spacing|50'))
    if isi.get('keunggulan'):
        bagian.append(grup([judul(esc(js.get('keunggulan') or 'Mengapa Memilih Kami'))] + kartu_isi(isi['keunggulan']),
                           kelas='vf-seksi', align='wide'))
    if isi.get('alur'):
        langkah = [kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))]) for a in isi['alur'][:5]]
        bagian.append(grup([judul('Alur Kerja'), barisan(langkah, kelas='vf-langkah')], kelas='vf-seksi', align='wide'))
    arsip = (info['halaman'].get('berita') or {}).get('url') or info['home'] + 'berita/'
    bagian.append(grup([bar('Artikel Terbaru', ('Lihat semua →', arsip)), q(3, 0, 'vf-kartu', KARTU, grid=3)],
                       kelas='vf-seksi', align='wide'))
    bagian.append(grup([judul('Siap membantu kebutuhan Anda'),
                        paragraf(esc(f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
                        tombol('Hubungi Kami', kontak)],
                       kelas='vf-ajakan', align='wide', teks='di-primary', latar='primary', padding='var:preset|spacing|50',
                       layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


def halaman_redaksi(sd, isi, info):
    kepala = f"<strong>{esc(sd['nama'])}</strong>" + (f"<br><em>{esc(sd['slogan'])}</em>" if sd['slogan'] else '')
    anak = [paragraf(kepala)]
    if sd['tentang']:
        anak.append(paragraf(esc(sd['tentang'])))
    pedoman = [p for p in isi.get('redaksi') or [] if str(p).strip()]
    if pedoman:
        anak.append(judul('Pedoman Redaksi'))
        anak += [paragraf(esc(p)) for p in pedoman]
    # Nama awak redaksi tidak dikarang: dilengkapi PM bila klien mengirimnya.
    anak += [judul('Kontak Redaksi'), blok('velocity/kontak')]
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url')
    if kontak:
        anak.append(paragraf(f'<a href="{esc_attr(kontak)}">Kirim pesan ke redaksi →</a>'))
    return '\n\n'.join(anak)


def profil_perusahaan(isi):
    """Data company profile di Tentang Kami (keputusan user 2026-09-13: semua kiriman klien tampil)."""
    anak, topik = [], []
    if isi.get('visi') or isi.get('misi'):
        topik.append(TOPIK_PROFIL['visi'])
        anak.append(judul('Visi &amp; Misi'))
        if isi.get('visi'):
            anak.append(paragraf(f"<strong>Visi:</strong> {esc(isi['visi'])}"))
        if isi.get('misi'):
            anak += [paragraf('<strong>Misi:</strong>'), daftar_poin([esc(m) for m in isi['misi']])]
    if isi.get('struktur'):
        topik.append(TOPIK_PROFIL['struktur'])
        anak += [judul('Struktur Organisasi'),
                 daftar_poin([f"<strong>{esc(s.get('jabatan'))}</strong>: {esc(s.get('nama'))}" for s in isi['struktur']])]
    if isi.get('customer'):
        topik.append(TOPIK_PROFIL['customer'])
        anak += [judul('Pelanggan Kami'), daftar_poin([esc(c if isinstance(c, str) else c.get('nama', '')) for c in isi['customer']])]
    if isi.get('legalitas'):
        topik.append(TOPIK_PROFIL['legalitas'])
        anak += [judul('Legalitas'),
                 daftar_poin([f"<strong>{esc(l.get('label'))}</strong>: {esc(l.get('nilai'))}" for l in isi['legalitas']])]
    return (grup(anak, kelas='vf-profil') if anak else ''), topik


def milik_installer(hal):
    """Boleh ditimpa: kosong/placeholder, atau isinya masih persis tulisan installer."""
    isi = hal['isi']
    if not isi.strip() or isi.strip() in PLACEHOLDER:
        return True
    if hal['fse_md5']:
        return hal['fse_md5'] == md5(isi)
    bersih = SHORTCODE_LAMA.sub('', isi)
    for j in JUDUL_LAMA:
        bersih = bersih.replace(j, '')
    if not bersih.strip():
        return True
    # _velocity_content_md5 dari generator AI/site-finish = md5 keluaran WP-CLI (isi + "\n").
    return bool(hal['isi_md5']) and hal['isi_md5'] in (md5(isi), md5(isi + '\n'), md5(bersih), md5(bersih + '\n'))


PHP_BACA = r'''
$hal = array();
foreach ((array) $d['slug'] as $s) {
    $p = get_page_by_path($s, OBJECT, 'page');
    if (!$p || $p->post_status === 'trash') { $hal[$s] = null; continue; }
    $hal[$s] = array('id' => $p->ID, 'judul' => $p->post_title, 'status' => $p->post_status, 'isi' => $p->post_content,
        'url' => get_permalink($p), 'fse_md5' => (string) get_post_meta($p->ID, '_velocity_fse_md5', true),
        'isi_md5' => (string) get_post_meta($p->ID, '_velocity_content_md5', true));
}
$sisa = array();
foreach (get_pages(array('post_status' => 'publish,draft,private')) as $p) {
    if (!isset($hal[$p->post_name]) && preg_match('/\[[a-z][a-z0-9]{0,11}_(redaksi|kontak|pemesanan|layanan|produk|galeri|alur|profil|struktur|customer|legalitas|visimisi)\]/', $p->post_content)) {
        $sisa[$p->post_name] = array('id' => $p->ID, 'judul' => $p->post_title, 'isi' => $p->post_content);
    }
}
$kat = array();
foreach ((array) $d['rubrik'] as $s) {
    $t = get_term_by('slug', $s, 'category');
    if ($t) { $kat[$s] = array('id' => (int) $t->term_id, 'nama' => $t->name, 'url' => get_category_link($t->term_id)); }
}
$menu = array();
foreach (get_nav_menu_locations() as $lokasi => $tid) {
    if (!$tid) { continue; }
    foreach ((array) wp_get_nav_menu_items($tid) as $it) {
        if ((int) $it->menu_item_parent) { continue; }
        $menu[] = array('judul' => $it->title, 'jenis' => $it->type, 'objek' => $it->object, 'id' => (int) $it->object_id, 'url' => $it->url);
    }
    break;
}
$nav = array();
foreach (get_posts(array('post_type' => 'wp_navigation', 'post_status' => 'publish', 'numberposts' => 20, 'orderby' => 'date', 'order' => 'DESC')) as $n) {
    $nav[] = array('id' => $n->ID, 'judul' => $n->post_title, 'milik' => (string) get_post_meta($n->ID, '_velocity_fse_md5', true), 'md5' => md5($n->post_content));
}
$halaman_id = array();
foreach (get_pages(array('post_status' => 'publish')) as $p) { $halaman_id[$p->post_name] = array('id' => $p->ID, 'url' => get_permalink($p)); }
// Foto per slot desain (hero, tentang, layanan-*, produk-*, galeri-*) dari paket-g-foto.
$foto = array();
foreach ((array) get_option('vfse_images', array()) as $slot => $id) {
    $url = $id ? wp_get_attachment_image_url((int) $id, 'large') : '';
    if ($url) {
        $foto[$slot] = array('id' => (int) $id, 'url' => $url, 'alt' => (string) get_post_meta((int) $id, '_wp_attachment_image_alt', true));
    }
}
$peta = get_option('velocity_map');
vfse_keluar(array('tema' => get_stylesheet(), 'halaman' => $hal, 'sisa' => $sisa, 'kategori' => $kat, 'menu' => $menu,
    'peta' => is_array($peta) ? $peta : null,
    'nav' => $nav, 'semua' => $halaman_id, 'home' => home_url('/'), 'depan' => (int) get_option('page_on_front'),
    'foto' => (object) $foto));
'''

PHP_TULIS = r'''
$hasil = array();
$ubah = array();
foreach ((array) $d['halaman'] as $h) {
    $data = array('post_content' => wp_slash($h['isi']));
    if (!empty($h['id'])) {
        $data['ID'] = (int) $h['id'];
        $id = wp_update_post($data, true);
        $aksi = 'diisi';
    } else {
        $data += array('post_type' => 'page', 'post_status' => 'publish', 'post_title' => wp_slash($h['judul']), 'post_name' => $h['slug']);
        $id = wp_insert_post($data, true);
        $aksi = 'dibuat';
    }
    if (is_wp_error($id) || !$id) { $hasil[] = 'halaman_gagal:' . $h['slug']; continue; }
    // md5 dari isi yang BENAR-BENAR tersimpan: filter simpan WordPress bisa mengubahnya.
    $simpan = (string) get_post_field('post_content', $id, 'raw');
    update_post_meta($id, '_velocity_fse_md5', md5($simpan));
    update_post_meta($id, '_velocity_content_md5', md5($simpan . "\n"));
    if (!empty($h['tata'])) { update_post_meta($id, '_velocity_fse_layout', '1'); }
    if ($simpan !== $h['isi']) { $ubah[$h['slug']] = $simpan; }
    $hasil[] = 'halaman_' . $aksi . ':' . $h['slug'] . ':' . $id;
}
if (!empty($d['nav'])) {
    $n = $d['nav'];
    $data = array('post_content' => wp_slash($n['isi']));
    if (!empty($n['id'])) {
        $data['ID'] = (int) $n['id'];
        $id = wp_update_post($data, true);
    } else {
        $data += array('post_type' => 'wp_navigation', 'post_status' => 'publish', 'post_title' => 'Menu Utama');
        $id = wp_insert_post($data, true);
    }
    if (is_wp_error($id) || !$id) {
        $hasil[] = 'menu_gagal';
    } else {
        update_post_meta($id, '_velocity_fse_md5', md5((string) get_post_field('post_content', $id, 'raw')));
        $hasil[] = 'menu_ditulis:' . $id;
    }
}
if (!empty($d['depan']) && !(int) get_option('page_on_front')) {
    update_option('show_on_front', 'page');
    update_option('page_on_front', (int) $d['depan']);
    $hasil[] = 'halaman_depan_diatur';
}
vfse_keluar(array('hasil' => $hasil, 'ubah' => $ubah));
'''


def tautan_menu(info, sd, slugs_ada):
    """Menu utama: susunan menu klasik yang sudah disepakati (paket-g-setup) dibawa apa adanya."""
    butir = []
    for m in info['menu']:
        if m['jenis'] == 'post_type' and m['objek'] == 'page':
            butir.append({'label': m['judul'], 'type': 'page', 'id': m['id'], 'url': m['url'], 'kind': 'post-type'})
        elif m['jenis'] == 'taxonomy' and m['objek'] == 'category':
            butir.append({'label': m['judul'], 'type': 'category', 'id': m['id'], 'url': m['url'], 'kind': 'taxonomy'})
        else:
            butir.append({'label': m['judul'], 'url': m['url'], 'kind': 'custom', 'isTopLevelLink': True})
    if not butir:
        semua = info['semua']
        halaman = lambda slug, label: butir.append({'label': label, 'type': 'page', 'id': semua[slug]['id'],
                                                    'url': semua[slug]['url'], 'kind': 'post-type'}) if slug in semua else None
        if sd.get('gaya') == 'dealer' and sd['jenis'] != 'berita':
            halaman('beranda', 'Beranda')
            butir.append({'label': 'Model Unit', 'url': info['home'] + 'model-unit/', 'kind': 'custom',
                          'isTopLevelLink': True})
            for slug, label in (('test-drive', 'Test Drive'), ('simulasi-kredit', 'Simulasi Kredit'),
                                ('galeri', 'Galeri'), ('tentang-kami', 'Tentang Kami'), ('berita', 'Artikel')):
                halaman(slug, label)
        elif sd['jenis'] == 'berita':
            halaman('beranda', 'Home')
            for r in sd['rubrik']:
                t = info['kategori'].get(r['slug'])
                if t:
                    butir.append({'label': r['judul'], 'type': 'category', 'id': t['id'], 'url': t['url'], 'kind': 'taxonomy'})
            halaman('redaksi', 'Redaksi')
        else:
            for slug, label in (('beranda', 'Beranda'), ('tentang-kami', 'Profil'), ('layanan', 'Layanan'),
                                ('produk', 'Produk'), ('pemesanan', 'Pemesanan'), ('galeri', 'Galeri Foto'), ('berita', 'Berita')):
                if slug == 'produk' and info.get('toko'):
                    # Arsip produk VD Store (store_product), bukan halaman.
                    butir.append({'label': 'Produk', 'url': info['home'] + 'produk/', 'kind': 'custom', 'isTopLevelLink': True})
                else:
                    halaman(slug, label)
        halaman('hubungi-kami', 'Kontak Kami')
    return '\n\n'.join(blok('navigation-link', b) for b in butir)


def cek_markup(berkas):
    run = subprocess.run(['node', str(HERE / 'cek-blok')] + [str(b) for b in berkas], capture_output=True, text=True, timeout=180)
    if run.returncode == 3:
        print('fse: cek_blok_dilewati:alat_tidak_ada')
        return set()
    return {Path(b.split(' ', 1)[1].split(':', 1)[0]).stem for b in run.stdout.splitlines() if b.startswith('tidak_valid')} | (
        set() if run.returncode in (0, 1) else {'*'}), run.stdout


def cek_http(url):
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    try:
        with urllib.request.urlopen(req, timeout=30, context=ssl._create_unverified_context()) as r:
            return r.status, r.read().decode(errors='ignore')
    except urllib.error.HTTPError as e:
        return e.code, ''
    except (urllib.error.URLError, OSError):
        return 0, ''


def langkah_isi(cfg, situs, coba):
    domain = situs.domain
    isi = baca_isi(domain)
    vct = muat_modul('velocity_child_theme', HERE / 'velocity-child-theme')
    ref = referensi_desain(cfg, domain, 'berita' if isi.get('jenis') == 'berita' else 'perusahaan')
    sd = data_situs(cfg, domain, isi, vct, ref)
    berita = sd['jenis'] == 'berita'
    # Toko Online Custom: produk dari VD Store (arsip /produk/). Halaman "produk" tidak dibuat:
    # VD Store memindahkan arsipnya ke /produk-list/ kalau ada halaman berslug itu.
    toko = paket_toko(cfg)
    # Situs dealer mobil: unit tinggal di CPT mobil (arsip /model-unit/), jadi tidak ada halaman
    # Layanan/Produk/Pemesanan — yang dipakai pengunjung adalah Test Drive & Simulasi Kredit.
    dealer = sd['gaya'] == 'dealer' and not berita
    target = ['beranda', 'tentang-kami', 'galeri', 'hubungi-kami', 'berita'] + (
        ['redaksi'] if berita else ['test-drive', 'simulasi-kredit'] if dealer
        else ['layanan', 'pemesanan'] + ([] if toko else ['produk']))
    info = situs.php(PHP_BACA, {'slug': target, 'rubrik': [r['slug'] for r in sd['rubrik']]})
    info['desain'] = ref.get('desain')
    info['toko'] = toko
    if info['tema'] != SLUG:
        print(f"fse: isi_dilewati:tema_aktif_{info['tema']}")
        return 1

    q = Query()
    rencana = {}  # slug -> (id, judul, isi, tata)

    def rencanakan(slug, judul_hal, isi_baru, tata=False):
        hal = info['halaman'].get(slug)
        if hal and not milik_installer(hal):
            print(f'fse: halaman_dibiarkan:{slug} (sudah disunting orang)')
            return
        if hal and hal['isi'] == isi_baru:
            print(f'fse: halaman_sama:{slug}')
            return
        rencana[slug] = ((hal or {}).get('id', 0), (hal or {}).get('judul') or judul_hal, isi_baru, tata)

    def lanjutan(slug, tambahan):
        """Halaman tulisan AI: diubah jadi blok, lalu blok wajib ditambahkan kalau belum ada."""
        hal = info['halaman'].get(slug)
        lama = (hal or {}).get('isi', '')
        topik = []
        profil = ''
        if slug == 'tentang-kami' and not berita:
            profil, topik = profil_perusahaan(isi)
        dasar = lama.strip() if '<!-- wp:' in lama else html_ke_blok('' if lama.strip() in PLACEHOLDER else lama, topik)
        bagian = [dasar] if dasar else []
        if profil and 'vf-profil' not in dasar:
            bagian.append(profil)
        for penanda, markup in tambahan:
            if penanda not in dasar:
                bagian.append(markup)
        return '\n\n'.join(bagian)

    # Beranda: tata letak penuh (Query Loop per rubrik / seksi perusahaan).
    if berita:
        beranda = beranda_sorotan(q, sd, info) if sd['gaya'] == 'sorotan' else beranda_berita(q, sd, info)
    else:
        # Gaya "sorotan" baru ada untuk portal berita; perusahaan tetap susunan bawaan.
        info['domain'] = domain
        beranda = beranda_dealer(q, sd, isi, info) if dealer else beranda_perusahaan(q, sd, isi, info)
    rencanakan('beranda', 'Beranda', beranda, tata=True)
    if sd.get('gaya') == 'referensi':
        print(f"fse: beranda_ikut_referensi:{(info.get('desain') or {}).get('url', '')}"
              + (f" seksi_dilewati_tanpa_data={','.join(info['dilewati'])}" if info.get('dilewati') else ''))
    rencanakan('tentang-kami', 'Tentang Kami', lanjutan('tentang-kami', []))
    # Situs dealer belum tentu punya foto kiriman klien: galeri diisi foto unit & suasana
    # yang sudah dipasang installer (semuanya ber-caption kredit foto).
    galeri_tambahan = [('wp:gallery', galeri_slot(info.get('foto') or {}))] if dealer else []
    rencanakan('galeri', 'Galeri', lanjutan('galeri', [t for t in galeri_tambahan if t[1]]))
    judul_form = 'Kirim Pesan ke Redaksi' if berita else 'Kirim Pesan' if dealer else 'Ajukan Pemesanan'
    tambahan_kontak = [
        ('wp:velocity/kontak', judul('Kontak') + '\n\n' + blok('velocity/kontak')),
        ('wp:social-links', judul('Media Sosial') + '\n\n' + ikon_sosmed()),
        ('wp:velocity/form-kirim', judul(judul_form) + '\n\n' + blok('velocity/form-kirim')),
    ]
    if dealer and (petak := blok_peta(info.get('peta'))):
        # Klien dealer mengirim titik Google Maps untuk web; petanya ikut di halaman kontak.
        tambahan_kontak.insert(1, ('velocity-map', judul('Lokasi') + '\n\n' + petak))
    rencanakan('hubungi-kami', 'Hubungi Kami', lanjutan('hubungi-kami', tambahan_kontak))
    if berita:
        rencanakan('redaksi', 'Redaksi', halaman_redaksi(sd, isi, info))
    elif dealer:
        rencanakan('test-drive', 'Test Drive', '\n\n'.join([
            paragraf('Isi formulir di bawah untuk menjadwalkan test drive. Tim kami menghubungi Anda untuk memastikan '
                     'unit, tanggal, dan titik temu.'),
            blok('velocity/form-kirim')]))
        rencanakan('simulasi-kredit', 'Simulasi Kredit', '\n\n'.join([
            paragraf('Atur harga unit, uang muka, tenor, dan bunga untuk melihat estimasi cicilan bulanan. '
                     'Hasilnya bisa langsung dikonsultasikan ke tim kami.'),
            blok('velocity/simulasi-kredit', {'align': 'wide'})]))
    else:
        if sd['layanan']:
            anak = [paragraf('Kebutuhan Anda ditangani satu tim — mulai dari peninjauan, penawaran tertulis, pengerjaan, sampai serah terima.')]
            anak += kartu_isi(sd['layanan'])
            if isi.get('alur'):
                anak += [judul('Alur Kerja'), barisan([kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))])
                                                      for a in isi['alur'][:5]], kelas='vf-langkah')]
            rencanakan('layanan', 'Layanan', '\n\n'.join(anak))
        if isi.get('produk') and not toko:
            rencanakan('produk', 'Produk', '\n\n'.join([paragraf('Pekerjaan dan produk yang paling sering diminta pelanggan.')]
                                                       + kartu_isi(isi['produk'])))
        rencanakan('pemesanan', 'Pemesanan', '\n\n'.join([
            paragraf('Isi formulir di bawah ini untuk mengajukan pemesanan atau konsultasi. Permintaan Anda kami terima langsung melalui email.'),
            blok('velocity/form-kirim')]))
    # Halaman lain yang masih berisi shortcode desain child theme lama.
    for slug, hal in (info.get('sisa') or {}).items():
        bersih = SHORTCODE_LAMA.sub('', hal['isi'])
        for j in JUDUL_LAMA:
            bersih = bersih.replace(j, '')
        rencana[slug] = (hal['id'], hal['judul'], bersih.strip(), False)
        print(f'fse: shortcode_lama_dibuang:{slug}')

    # Menu utama (wp_navigation).
    nav_isi = tautan_menu(info, sd, set(info['semua']))
    milik = next((n for n in info['nav'] if n['milik']), None)
    nav = None
    if milik and milik['milik'] != milik['md5']:
        print('fse: menu_dibiarkan (sudah disunting orang)')
    elif milik and milik['md5'] == md5(nav_isi):
        print('fse: menu_sama')
    elif nav_isi:
        nav = {'id': milik['id'] if milik else 0, 'isi': nav_isi}

    # Validasi semua markup sebelum menyentuh situs.
    folder = RENCANA_DIR / domain
    folder.mkdir(parents=True, exist_ok=True)
    berkas = []
    for slug, (_, _, isi_baru, _) in rencana.items():
        (folder / f'{slug}.html').write_text(isi_baru)
        berkas.append(folder / f'{slug}.html')
    if nav:
        (folder / 'menu.html').write_text(nav['isi'])
        berkas.append(folder / 'menu.html')
    if berkas:
        tidak_valid, keluaran = cek_markup(berkas)
        for baris in keluaran.splitlines():
            if baris.startswith('tidak_valid'):
                print('fse: ' + baris[:300])
        if '*' in tidak_valid:
            print('fse: cek_blok_gagal_dijalankan, tidak ada yang ditulis')
            return 1
        for slug in tidak_valid:
            print(f'fse: {slug}_tidak_ditulis:markup_tidak_valid')
            rencana.pop(slug, None)
            if slug == 'menu':
                nav = None
    print(f"fse: rencana halaman={','.join(rencana) or '-'} menu={'ya' if nav else 'tidak'} (berkas di {folder})")
    if coba or (not rencana and not nav):
        return 0

    depan = (info['halaman'].get('beranda') or {}).get('id', 0)
    kirim = {'halaman': [{'slug': s, 'id': v[0], 'judul': v[1], 'isi': v[2], 'tata': v[3]} for s, v in rencana.items()],
             'nav': nav, 'depan': depan}
    tulis = situs.php(PHP_TULIS, kirim)
    for baris in tulis['hasil']:
        print(f'fse: {baris}')
    # Filter simpan WordPress mengubah isi: markup yang tersimpan diperiksa ulang.
    if tulis.get('ubah'):
        ulang = []
        for slug, simpan in tulis['ubah'].items():
            (folder / f'{slug}.tersimpan.html').write_text(simpan)
            ulang.append(folder / f'{slug}.tersimpan.html')
        tidak_valid, keluaran = cek_markup(ulang)
        print(f"fse: isi_diubah_wp:{','.join(tulis['ubah'])} -> "
              + ('tetap valid' if not tidak_valid else 'TIDAK VALID: ' + ','.join(sorted(tidak_valid))))

    # Situs dibaca sebagai pengunjung: shortcode mentah & blok tak terender tidak boleh lolos.
    gagal = 0
    for slug in ['beranda'] + [s for s in rencana if s != 'beranda']:
        url = info['home'] if slug == 'beranda' else (info['semua'].get(slug) or {}).get('url') or f"{info['home']}{slug}/"
        kode, badan = cek_http(url + ('&' if '?' in url else '?') + 'vfse=cek')
        mentah = sorted(set(SHORTCODE_LAMA.findall(badan)))
        belum = 'wp:velocity/' in badan or '<!-- wp:' in badan
        status = 'ok' if kode == 200 and not mentah and not belum else 'MASALAH'
        gagal += status != 'ok'
        print(f"fse: http {slug}={kode} {status}" + (f" shortcode_mentah={','.join(mentah)}" if mentah else '')
              + (' blok_tidak_terender' if belum else ''))
    return 1 if gagal else 0


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    mode = next((m for m in ('--deteksi', '--tema', '--isi') if m in sys.argv), '')
    coba = '--coba' in sys.argv
    if len(args) != 1 or not mode:
        print('usage: fse-apply --deteksi|--tema|--isi <manifest> [--coba]', file=sys.stderr)
        return 2
    cfg = read_manifest(args[0])
    cfg['_manifest'] = args[0]
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', cfg.get('domain', '').lower()) \
            or not re.match(r'^[a-z][a-z0-9]*$', cfg.get('da_user', '')):
        print('fse: manifest tidak valid')
        return 2
    try:
        situs = Situs(cfg)
        if mode == '--deteksi':
            jalur, alasan = deteksi(cfg, situs)
            print(f'fse: jalur={jalur} ({alasan})', file=sys.stderr)
            print(jalur)
            return 0
        if mode == '--tema':
            return langkah_tema(cfg, situs, coba)
        return langkah_isi(cfg, situs, coba)
    except (RuntimeError, subprocess.SubprocessError, OSError, ValueError, KeyError) as e:
        print(f'fse: gagal:{type(e).__name__}:{e}'[:300])
        if mode == '--deteksi':
            print('gagal')
        return 1


if __name__ == '__main__':
    sys.exit(main())
