def palet_versi(cfg):
    """Versi aturan palet dari manifest; situs lama tanpa baris itu tetap versi 1."""
    try:
        return int(str((cfg or {}).get('velocity_palet_versi', '1')).strip() or 1)
    except ValueError:
        return 1


def warna_situs(vct, domain, desain, cfg=None):
    """(utama, aksen, sumber). Warna klien menang (keputusan user 2026-09-15): pilihan di
    FORM ISIAN (paket-g-konten) atau company profile/logo (compro-klien). Warna situs
    referensi hanya dipakai kalau klien tidak punya warna sama sekali.

    `velocity_warna_utama=` / `velocity_warna_aksen=` di manifest menang atas semuanya —
    jalur child theme sudah begitu sejak awal, jalur FSE dulu tidak membacanya sehingga
    warna yang dipilih manusia untuk satu situs tidak bisa dipaksakan."""
    cfg = cfg or {}
    manifest_utama = cfg.get('velocity_warna_utama', '')
    manifest_aksen = cfg.get('velocity_warna_aksen', '')
    primary, aksen = vct.warna_tema(domain, manifest_utama, manifest_aksen)
    if vct.HEX_RE.match(manifest_utama or '') or vct.HEX_RE.match(manifest_aksen or ''):
        return primary, aksen, 'manifest'
    klien = (vct.muat_isi_contoh(domain) or {}).get('warna') or {}
    try:
        compro = json.loads((Path('/var/lib/velocity/compro') / domain / 'compro.json').read_text()).get('warna') or {}
    except (OSError, ValueError):
        compro = {}
    if any(vct.HEX_RE.match(w or '') for w in (klien.get('utama'), klien.get('aksen'), compro.get('utama'), compro.get('aksen'))):
        return primary, aksen, 'klien'
    if klien_minta_warna_beda(domain):
        # FORM ISIAN "WARNA TEMA WEB: dibedakan dari web contoh" (jasakontraktorindo.com
        # 2026-09-17): tata letak tetap mengikuti referensi, warnanya tidak.
        return primary, aksen, 'bawaan:klien_minta_beda_dari_referensi'
    ref = [w for w in (desain or {}).get('warna_referensi') or [] if vct.HEX_RE.match(w or '')]
    if not ref:
        return primary, aksen, 'bawaan'
    return ref[0], (ref[1] if len(ref) > 1 else aksen), 'referensi'


def klien_minta_warna_beda(domain):
    """Kolom warna FORM ISIAN meminta warna berbeda dari web contoh/referensi?"""
    try:
        sys.path.insert(0, str(HERE))
        from client_form import read_client_form
        form = read_client_form(Path('/home/On Progress') / domain)
    except Exception:
        return False
    warna = ' '.join(str(v) for k, v in (form.get('fields') or {}).items() if re.search(r'warna', k, re.I))
    teks = form.get('text') or ''
    m = re.search(r'WARNA\s+TEMA[^:\n]*:?\s*([^\n]{0,160})', teks, re.I)
    warna += ' ' + (m.group(1) if m else '')
    return bool(re.search(r'\b(beda|berbeda|dibedakan|bedakan|jangan\s+sama|selain)\b', warna, re.I))


def aksen_netral(warna):
    """Aksen abu/hitam/putih (yukpergimancing.com: biru dongker-abu-hitam -> aksen #808080):
    tombol berlatar aksen tampak mati, jadi tombol situs berreferensi memakai warna utama."""
    m = re.match(r'^#?([0-9a-f]{6})$', str(warna or '').strip(), re.I)
    if not m:
        return False
    rgb = [int(m.group(1)[i:i + 2], 16) for i in (0, 2, 4)]
    return max(rgb) - min(rgb) < 25


def banner_desain(desain):
    """Banner judul halaman dalam dari halaman referensi yang terukur (suara terbanyak)."""
    banner = [h['banner'] for h in (desain.get('halaman') or {}).values() if (h.get('banner') or {}).get('ada')]
    if not banner:
        return {}
    pilih = lambda kunci: max({b.get(kunci) for b in banner}, key=[b.get(kunci) for b in banner].count)
    return {'banner_latar': pilih('latar'), 'banner_rata': pilih('rata'), 'banner_tinggi': pilih('tinggi'),
            'banner_remah': bool(pilih('breadcrumb'))}


def token_desain(ref):
    """Token tampilan dari rencana referensi -> opsi velocity_fse_desain (dibaca functions.php).

    `tampilan_versi` ditambahkan pemanggil dari manifest (`velocity_palet_versi`): aturan
    tampilan baru hanya berlaku untuk build berikutnya, situs lama tetap seperti apa adanya.
    """
    desain = (ref or {}).get('desain')
    if not desain:
        return {}
    modul = muat_modul('referensi_desain', HERE / 'referensi_desain.py')
    f, h = desain['font'], desain['header']
    boleh = lambda nama, google: nama if nama and (google or nama.lower() in modul.FONT_SISTEM) else ''
    teks, judul_font = boleh(f['teks'], f['teks_google']), boleh(f['judul'], f['judul_google'])
    return {
        'url': desain['url'],
        # Gaya "sorotan" portal berita punya header & footer sendiri yang sudah disepakati.
        'terapkan_header': ref.get('gaya') != 'sorotan',
        'header_gelap': h['gelap'], 'logo_posisi': h['logo_posisi'], 'menu_posisi': h['menu_posisi'],
        'header_ajakan': h['tombol_ajakan'], 'header_lengket': h['lengket'], 'menu_kapital': h['menu_kapital'],
        'topbar': h['topbar'], 'footer_gelap': desain['footer']['gelap'],
        # Rencana VERSI >= 3 (2026-09-17): warna topbar, menu berwarna, keranjang toko di header,
        # jumlah kolom & pita hak cipta footer. Rencana lama tanpa kunci ini tidak berubah.
        'topbar_gelap': bool(h.get('topbar') and h.get('topbar_gelap')),
        'menu_berwarna': bool(h.get('menu_berwarna')),
        'header_keranjang': bool(h.get('keranjang')),
        'footer_kolom': int(desain['footer'].get('kolom') or 0),
        'footer_pita': bool(desain['footer'].get('pita')),
        # Rencana VERSI 4 (2026-09-17, centralimpex.com): kotak cari, logo & hak cipta footer,
        # banner judul halaman dalam. Kunci hanya ditulis bila rencananya memuatnya.
        # Header referensi tanpa garis/bayangan pemisah (northseaaconsulting.com): bawaan
        # tema memberi bayangan, jadi headernya terlihat lebih berat dari referensi.
        **({'header_tanpa_garis': True} if 'garis_bawah' in h and not h['garis_bawah'] else {}),
        **({'tanpa_cari': True} if 'cari' in h and not h['cari'] else {}),
        **({'footer_logo': bool(desain['footer'].get('logo')),
            'footer_bawah_rata': desain['footer'].get('bawah_rata') or '',
            'footer_judul_kapital': bool(desain['footer'].get('judul_kapital'))}
           if 'kolom_isi' in desain['footer'] else {}),
        **banner_desain(desain),
        'tombol_radius': desain['tombol']['radius'], 'tombol_kapital': desain['tombol']['kapital'],
        'kartu_radius': desain['kartu']['radius'], 'kartu_bayangan': desain['kartu']['bayangan'],
        'judul_tebal': f['judul_tebal'],
        # Gaya dealer menulis judul seksinya sendiri (huruf besar semua membuat judul panjang sulit dibaca).
        'judul_kapital': f['judul_kapital'] and ref.get('gaya') != 'dealer', 'serif_judul': f['serif_judul'],
        'font_teks': teks, 'font_judul': judul_font,
        # Font yang sudah dibawa tema (assets/fonts) dipakai lokal lewat velocity_situs font_*,
        # jadi tidak diminta lagi ke Google Fonts.
        'font_google': sorted({n for n, g in ((f['teks'], f['teks_google']), (f['judul'], f['judul_google']),
                                              (f.get('menu', ''), f.get('menu_google', False)))
                               if n and g and n.lower() not in FONT_LOKAL}),
        # Rencana VERSI 5 (2026-09-17, jasakontraktorindo.com -> kontraktorhijau.com): font menu,
        # bentuk tombol, bingkai & jarak kartu, lebar wadah, header melayang. Dibaca
        # inc/referensi-komponen.php; situs dengan rencana lama tidak menerima kunci ini.
        **({'referensi_versi': int(desain.get('versi') or 0),
            'font_menu': boleh(f.get('menu', ''), f.get('menu_google', False)),
            'tombol_padding': (desain.get('tombol') or {}).get('padding') or [],
            'tombol_tebal': int((desain.get('tombol') or {}).get('tebal') or 0),
            'tombol_ukuran': float((desain.get('tombol') or {}).get('ukuran') or 0),
            'kartu_border': float(desain['kartu'].get('border') or 0),
            'kartu_border_warna': desain['kartu'].get('border_warna') or '',
            'kartu_padding': int(desain['kartu'].get('padding') or 0),
            'kartu_jarak': int(desain['kartu'].get('jarak') or 0),
            'wadah': float(desain.get('wadah') or 0),
            'wadah_px': int(desain.get('wadah_px') or 0),
            # Seksi berwadah tetap (kotak menjorok, bukan pita selebar layar):
            # tema membuat seksi & footer jadi kartu selebar wadah bersudut kartu.
            'wadah_tetap': bool(desain.get('wadah_tetap')),
            'wadah_maks': int(desain.get('wadah_maks') or 0),
            'header_melayang': h.get('melayang') or {},
            # Header referensi melayang transparan di atas hero, lalu jadi bar berlatar
            # saat digulir (habercafeandresto.co.id).
            'header_transparan': bool(h.get('transparan'))}
           if int(desain.get('versi') or 0) >= 5 else {}),
    }


def langkah_tema(cfg, situs, coba):
    domain = situs.domain
    if not periksa_template():
        print('fse: template tema tidak lolos pemeriksaan, tidak dipasang')
        return 1
    isi = baca_isi(domain)
    if not isi:
        print('fse: isi contoh belum ada (paket-g-konten), data situs memakai FORM ISIAN saja')
    vct = muat_modul('velocity_child_theme', HERE / 'velocity-child-theme')
    ref = referensi_desain(cfg, domain, 'berita' if isi.get('jenis') == 'berita' else 'perusahaan')
    primary, aksen, sumber_warna = warna_situs(vct, domain, ref.get('desain'), cfg)
    if ref.get('url'):
        print(f"fse: referensi={ref['url']} gaya={ref['gaya']} ({ref.get('sumber')}) "
              f"font={','.join(ref.get('fonts') or []) or '-'}" + (f" alasan={ref['alasan']}" if ref.get('alasan') else ''))
    data = {'situs': data_situs(cfg, domain, isi, vct, ref),
            'palet': hitung_palet(vct, primary, aksen, gelap=ref.get('gaya') == 'dealer',
                                  versi=palet_versi(cfg)),
            'desain': dict(token_desain(ref), tampilan_versi=palet_versi(cfg))}
    if data['desain'] and aksen_netral(aksen):
        data['desain']['tombol_warna'] = 'primary'
    # Manifest `lebar_wadah=1200px` (yukpergimancing.com 2026-09-17): lebar wadah tetap pilihan user
    # menimpa hasil ukur referensi (wadah_px dibaca inc/referensi-komponen.php, kelas vf-ref-lebar).
    lebar = re.match(r'^\s*(\d{3,4})\s*(?:px)?\s*$', str(cfg.get('lebar_wadah', '')))
    if data['desain'] and lebar and 600 <= int(lebar.group(1)) <= 1600:
        data['desain'].update(wadah_px=int(lebar.group(1)), wadah=1.0, wadah_maks=0)
    print(f"fse: jenis={data['situs']['jenis']} nama={data['situs']['nama']} warna={primary}/{aksen} ({sumber_warna}) "
          f"kontak_publik={'ada' if any(data['situs'][k] for k in ('wa', 'email_publik', 'alamat')) else 'tidak ada'}")

    keadaan = situs.php(PHP_DETEKSI)
    versi = versi_template()
    perlu_pasang = versi_tuple(keadaan['versi']) < versi_tuple(versi)
    print(f"fse: tema_terpasang={keadaan['versi'] or '-'} template={versi} aktif={keadaan['tema']}")
    if coba:
        print('fse: coba — ' + ('tema akan dipasang' if perlu_pasang else 'tema sudah terbaru'))
        print('fse: palet ' + ' '.join(f"{w['slug']}={w['color']}" for w in data['palet'][:7]))
        return 0

    if perlu_pasang:
        tujuan = f'/tmp/{SLUG}-{versi}.zip'
        with tempfile.TemporaryDirectory() as tmp:
            zip_lokal = Path(tmp) / f'{SLUG}.zip'
            buat_zip(zip_lokal)
            kirim = subprocess.run(situs.ssh + [f'cat > {tujuan}'], input=zip_lokal.read_bytes(),
                                   capture_output=True, timeout=180)
        if kirim.returncode != 0:
            print('fse: gagal mengirim zip tema')
            return 1
        d = shlex.quote(situs.docroot)
        pasang = situs.bash(
            f'php -d memory_limit=512M /usr/local/bin/wp theme install {tujuan} --force --path={d} --allow-root 2>&1 | tail -2; '
            f'rm -f {tujuan}; chown -R --reference={d}/wp-content/themes {d}/wp-content/themes/{SLUG} 2>/dev/null || true')
        print('fse: ' + re.sub(r'\s+', ' ', pasang.stdout).strip()[:200])
        keadaan = situs.php(PHP_DETEKSI)
        if keadaan['versi'] != versi:
            print(f"fse: tema_gagal_terpasang (terbaca {keadaan['versi'] or '-'})")
            return 1

    for baris in situs.php(PHP_TEMA, data)['hasil']:
        print(f'fse: {baris}')
    # Baca ulang dari proses baru: exit code sukses belum berarti tema aktif.
    akhir = situs.php(PHP_DETEKSI)
    if akhir['tema'] != SLUG or not akhir['blok']:
        print(f"fse: tema_tidak_aktif (aktif={akhir['tema']})")
        return 1
    print(f"fse: tema_siap:{SLUG}:{akhir['versi']}")
    return 0


# ---------------------------------------------------------------------------
# Markup blok
# ---------------------------------------------------------------------------

def atribut(data):
    """JSON atribut blok dengan escape yang sama seperti serializer editor."""
    teks = json.dumps(data, ensure_ascii=False, separators=(',', ':'))
    return (teks.replace('\\"', '\\u0022').replace('--', '\\u002d\\u002d').replace('<', '\\u003c')
            .replace('>', '\\u003e').replace('&', '\\u0026'))


def blok(nama, attrs=None, isi=None):
    a = f' {atribut(attrs)}' if attrs else ''
    if isi is None:
        return f'<!-- wp:{nama}{a} /-->'
    return f'<!-- wp:{nama}{a} -->\n{isi}\n<!-- /wp:{nama} -->'


# Form situs = Contact Form 7 (keputusan user 2026-09-19: kolom bisa ditambah/diubah/dihapus
# sendiri, captcha tetap velocity-addons). Diisi siapkan_cf7(); kosong = blok form tema lama.
FORM_CF7 = {}
PHP_CF7 = r'''
vfse_keluar(function_exists('velocity_fse_cf7_pastikan') ? velocity_fse_cf7_pastikan() : null);
'''


def siapkan_cf7(situs, coba):
    """Pasang & aktifkan Contact Form 7, lalu form bawaan situs (dibuat tema, inc/cf7.php)."""
    FORM_CF7.clear()
    if coba:
        return
    wp = f'php /usr/local/bin/wp --path={shlex.quote(situs.docroot)} --allow-root'
    run = situs.bash(f'{wp} plugin is-installed contact-form-7 || {wp} plugin install contact-form-7 >/dev/null 2>&1\n'
                     f'{wp} plugin is-active contact-form-7 || {wp} plugin activate contact-form-7 >/dev/null 2>&1\n'
                     f'{wp} plugin is-active contact-form-7 && echo CF7_AKTIF\n', timeout=300)
    if 'CF7_AKTIF' not in run.stdout:
        print('fse: cf7_gagal_dipasang (form tema lama dipakai)')
        return
    hasil = situs.php(PHP_CF7)
    if isinstance(hasil, dict) and hasil.get('id') and hasil.get('hash'):
        FORM_CF7.update(hasil)
        print(f"fse: cf7_form:{hasil['id']}")
    else:
        print('fse: cf7_form_gagal (form tema lama dipakai)')


def blok_form():
    """Blok formulir: Contact Form 7 bila siap, selain itu blok form tema lama."""
    if not FORM_CF7:
        return blok('velocity/form-kirim')
    attrs = {'id': int(FORM_CF7['id']), 'hash': FORM_CF7['hash']}
    kode = f'[contact-form-7 id="{FORM_CF7["hash"]}"'
    # Judul hanya ikut kalau aman ditulis apa adanya: markup simpanan blok CF7 harus sama
    # persis dengan hasil editor, kalau tidak blok dianggap rusak.
    if re.fullmatch(r"[\w .,()-]+", FORM_CF7.get('title') or ''):
        attrs['title'] = FORM_CF7['title']
        kode += f' title="{FORM_CF7["title"]}"'
    return blok('contact-form-7/contact-form-selector', attrs,
                f'<div class="wp-block-contact-form-7-contact-form-selector">{kode}]</div>')


def esc(teks):
    return html.escape(str(teks or ''), quote=False)


def esc_attr(teks):
    return html.escape(str(teks or ''), quote=True)


def paragraf(dalam):
    return blok('paragraph', None, f'<p>{dalam}</p>')


def judul(dalam, level=2, kelas=None):
    attrs = {}
    if level != 2:
        attrs['level'] = level
    if kelas:
        attrs['className'] = kelas
    cls = 'wp-block-heading' + (f' {kelas}' if kelas else '')
    return blok('heading', attrs or None, f'<h{level} class="{cls}">{dalam}</h{level}>')


def grup(anak, kelas=None, layout=None, align=None, teks=None, latar=None, padding=None):
    attrs, cls, gaya = {}, ['wp-block-group'], []
    if align:
        attrs['align'] = align
        cls.append(f'align{align}')
    if kelas:
        attrs['className'] = kelas
        cls.append(kelas)
    if latar:
        attrs['backgroundColor'] = latar
    if teks:
        attrs['textColor'] = teks
    if padding:
        attrs['style'] = {'spacing': {'padding': {'top': padding, 'bottom': padding}}}
        css = f"var(--wp--preset--spacing--{padding.rsplit('|', 1)[-1]})" if padding.startswith('var:') else padding
        gaya = [f'padding-top:{css}', f'padding-bottom:{css}']
    if teks:
        cls.append(f'has-{teks}-color')
    if latar:
        cls.append(f'has-{latar}-background-color')
    if teks:
        cls.append('has-text-color')
    if latar:
        cls.append('has-background')
    attrs['layout'] = layout or {'type': 'default'}
    style = f' style="{";".join(gaya)}"' if gaya else ''
    return blok('group', attrs, f'<div class="{" ".join(cls)}"{style}>' + '\n\n'.join(anak) + '</div>')


def kolom(anak, lebar=None):
    style = f' style="flex-basis:{lebar}"' if lebar else ''
    return blok('column', {'width': lebar} if lebar else None, f'<div class="wp-block-column"{style}>' + '\n\n'.join(anak) + '</div>')


def barisan(daftar, kelas=None, align=None):
    attrs, cls = {}, ['wp-block-columns']
    if align:
        attrs['align'] = align
        cls.append(f'align{align}')
    if kelas:
        attrs['className'] = kelas
        cls.append(kelas)
    return blok('columns', attrs or None, f'<div class="{" ".join(cls)}">' + '\n\n'.join(daftar) + '</div>')


def daftar_poin(butir, kelas=None, bernomor=False):
    tag = 'ol' if bernomor else 'ul'
    attrs = {}
    if bernomor:
        attrs['ordered'] = True
    if kelas:
        attrs['className'] = kelas
    li = ''.join(blok('list-item', None, f'<li>{b}</li>') for b in butir)
    cls = 'wp-block-list' + (f' {kelas}' if kelas else '')
    return blok('list', attrs or None, f'<{tag} class="{cls}">{li}</{tag}>')


def tombol(label, url):
    satu = blok('button', None, f'<div class="wp-block-button"><a class="wp-block-button__link wp-element-button" '
                                f'href="{esc_attr(url)}">{esc(label)}</a></div>')
    return blok('buttons', None, f'<div class="wp-block-buttons">{satu}</div>')


# Aturan user 2026-09-14 (semua build): Kontak Kami & footer memuat email dan ikon
# media sosial saja, tautan bawaan ke beranda tiap platform (diganti PM bila klien punya akun).
SOSMED = (('facebook', 'https://www.facebook.com/'), ('instagram', 'https://www.instagram.com/'),
          ('x', 'https://x.com/'), ('youtube', 'https://www.youtube.com/'), ('tiktok', 'https://www.tiktok.com/'))


def ikon_sosmed():
    ikon = '\n\n'.join(blok('social-link', {'url': url, 'service': layanan}) for layanan, url in SOSMED)
    return blok('social-links', {'openInNewTab': True, 'className': 'is-style-logos-only vf-sosmed'},
                f'<ul class="wp-block-social-links is-style-logos-only vf-sosmed">{ikon}</ul>')


def bar(teks, tautan=None):
    anak = [judul(esc(teks))]
    if tautan:
        anak.append(paragraf(f'<a href="{esc_attr(tautan[1])}">{esc(tautan[0])}</a>'))
    return grup(anak, kelas='vf-rubrik-bar', layout={'type': 'flex', 'flexWrap': 'nowrap', 'justifyContent': 'space-between'})


KARTU = '\n\n'.join([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '16/10'}),
    blok('post-terms', {'term': 'category', 'className': 'vf-label'}),
    blok('post-title', {'level': 3, 'isLink': True}),
    blok('post-date'),
])
DAFTAR = '\n\n'.join([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '4/3'}),
    grup([blok('post-title', {'level': 3, 'isLink': True}), blok('post-date')], kelas='vf-daftar__teks'),
])
UTAMA = grup([
    blok('post-featured-image', {'isLink': True, 'aspectRatio': '16/10'}),
    grup([blok('post-terms', {'term': 'category', 'className': 'vf-label'}),
          blok('post-title', {'level': 2, 'isLink': True}),
          blok('post-date'),
          blok('post-excerpt', {'excerptLength': 26})], kelas='vf-utama__teks'),
], kelas='vf-utama__kartu')


class Query:
    def __init__(self):
        self.nomor = 100

    def __call__(self, per, offset, kelas, isi, kategori=None, grid=None, min_lebar='12rem', align=None, taksonomi='category',
                 jenis=None, urut='date', arah='desc'):
        self.nomor += 1
        q = {'perPage': per, 'pages': 0, 'offset': offset,
             'postType': jenis or ('product' if kategori == 'product' else 'post'), 'order': arah, 'orderBy': urut,
             'author': '', 'search': '', 'exclude': [], 'sticky': '', 'inherit': False}
        if kategori:
            # Format taxQuery WP 7.0+ (build_query_vars_from_query_block).
            q['taxQuery'] = {'include': {'category': [int(kategori)]}}
        tpl = {'className': kelas}
        if grid:
            tpl['layout'] = {'type': 'grid', 'columnCount': grid}
            if min_lebar:
                tpl['layout']['minimumColumnWidth'] = min_lebar
        attrs, cls = {'queryId': self.nomor, 'query': q}, 'wp-block-query'
        if align:
            attrs['align'] = align
            cls += f' align{align}'
        return blok('query', attrs, f'<div class="{cls}">' + blok('post-template', tpl, isi) + '</div>')


# ---------------------------------------------------------------------------
# Isi halaman
# ---------------------------------------------------------------------------

BLOK_HTML = re.compile(r'<(h[1-6]|p|ul|ol|blockquote|figure|table)\b[^>]*>.*?</\1\s*>'
                       r'|(?:<!--\s*velocity-map\s*-->\s*)?<iframe\b.*?</iframe\s*>'
                       r'|\[[a-z][a-z0-9_-]*(?:\s[^\]]*)?\]', re.S | re.I)


def dalam_tag(teks):
    return re.sub(r'^<[^>]+>|</[^>]+>$', '', teks.strip()).strip()


def html_ke_blok(isi, topik_dibuang=()):
    """Tulisan AI (HTML polos) → blok core yang bisa disunting per bagian.

    <h1> dibuang karena judul halaman sudah dicetak template; bagian ber-<h2>
    yang topiknya kini ditampilkan dari data company profile ikut dibuang."""
    isi = SHORTCODE_LAMA.sub('', isi)
    for j in JUDUL_LAMA:
        isi = isi.replace(j, '')
    # Pembungkus yang tidak membawa isi sendiri dibuang, <p> di dalamnya tetap.
    # <address> sempat lolos (bumiairchemitech.com 2026-09-16): penutupnya tertinggal
    # sebagai teks lepas, jadi <p></address></p> dan SELURUH halaman ditolak validator.
    isi = re.sub(r'</?(?:section|div|article|main|header|footer|aside|address)\b[^>]*>', '\n', isi, flags=re.I)
    hasil, pos, lewati = [], 0, False

    def teks_lepas(potongan):
        potongan = potongan.strip()
        # Sisa tag tanpa teks (penutup yatim dari pembungkus yang tidak dikenal) tidak
        # boleh jadi paragraf: markup-nya tidak valid dan halaman batal ditulis.
        if not re.sub(r'<[^>]*>|&nbsp;|\s', '', potongan):
            return
        if potongan and not lewati:
            hasil.append(paragraf(potongan) if not re.search(r'<(?!/?(?:a|strong|em|b|i|br)\b)[a-z]', potongan, re.I)
                         else blok('html', None, potongan))

    for m in BLOK_HTML.finditer(isi):
        teks_lepas(isi[pos:m.start()])
        pos = m.end()
        potong, tag = m.group(0).strip(), (m.group(1) or '').lower()
        if tag[:1] == 'h':
            level, dalam = int(tag[1]), dalam_tag(potong)
            if level == 1:
                continue
            if level == 2:
                polos = re.sub(r'<[^>]+>', '', dalam)
                lewati = any(re.search(p, polos, re.I) for p in topik_dibuang)
            if not lewati:
                hasil.append(judul(dalam, level))
        elif lewati:
            continue
        elif tag == 'p':
            if dalam_tag(potong):
                hasil.append(paragraf(dalam_tag(potong)))
        elif tag in ('ul', 'ol'):
            butir = re.findall(r'<li\b[^>]*>(.*?)</li\s*>', potong, re.S | re.I)
            if butir and not re.search(r'<(?:ul|ol)\b', ''.join(butir), re.I):
                hasil.append(daftar_poin([b.strip() for b in butir], bernomor=tag == 'ol'))
            else:
                hasil.append(blok('html', None, potong))
        elif potong.startswith('['):
            hasil.append(blok('shortcode', None, potong))
        else:
            hasil.append(blok('html', None, potong))
    teks_lepas(isi[pos:])
    return '\n\n'.join(hasil)


def kartu_isi(butir):
    """Kartu judul + teks (+ rincian) dalam baris tiga kolom."""
    baris = []
    for i in range(0, len(butir), 3):
        kolom_baris = []
        for b in butir[i:i + 3]:
            anak = [judul(esc(b.get('judul')), 3)]
            if b.get('teks'):
                anak.append(paragraf(esc(b['teks'])))
            if b.get('rincian'):
                anak.append(daftar_poin([esc(r) for r in b['rincian']]))
            kolom_baris.append(kolom([grup(anak, kelas='vf-kotak vf-kartu-isi')]))
        baris.append(barisan(kolom_baris))
    return baris


def beranda_berita(q, sd, info):
    arsip = (info['halaman'].get('berita') or {}).get('url') or info['home'] + 'berita/'
    atas = barisan([kolom([q(1, 0, 'vf-utama', UTAMA)], '62%'), kolom([q(4, 1, 'vf-daftar', DAFTAR)])],
                   kelas='vf-utama-baris', align='wide')
    seksi = [grup([bar('Berita Terbaru', ('Indeks berita →', arsip)), q(6, 5, 'vf-kartu', KARTU, grid=3)], kelas='vf-seksi')]
    for r in sd['rubrik']:
        t = info['kategori'].get(r['slug'])
        if not t:
            continue
        seksi.append(grup([
            bar(r['judul'], ('Lihat semua →', t['url'])),
            barisan([kolom([q(1, 0, 'vf-kartu', KARTU, t['id'])], '53%'), kolom([q(3, 1, 'vf-daftar', DAFTAR, t['id'])])],
                    kelas='vf-utama-baris'),
        ], kelas='vf-seksi'))
    tata = barisan([kolom(seksi, '68%'), kolom([blok('template-part', {'slug': 'sidebar'})], '32%')],
                   kelas='vf-tata', align='wide')
    return '\n\n'.join([judul(esc(sd['nama']), 1, 'screen-reader-text'), atas, tata])


SAMPUL = '\n\n'.join([
    blok('post-featured-image'),
    grup([blok('post-title', {'level': 2, 'isLink': True}), blok('post-terms', {'term': 'category'})], kelas='vf-sampul__teks'),
])


def beranda_sorotan(q, sd, info):
    """Gaya "sorotan": pita pembuka + 5 kartu foto selebar layar, lalu per rubrik
    pita judul berikon + grid 2x2 kartu foto (referensi majalah foto, mis.
    ourgrandfatherstory.com untuk anaksegalabangsa.com). Tanpa kolom samping."""
    bagian = [judul(esc(sd['nama']), 1, 'screen-reader-text'),
              grup([judul('Sorotan Pekan Ini')], kelas='vf-masthead vf-masthead--hot', align='full'),
              q(5, 0, 'vf-sampul', SAMPUL, align='full')]
    for r in sd['rubrik']:
        t = info['kategori'].get(r['slug'])
        if not t:
            continue
        pita = [judul(esc(r['judul']))]
        if r.get('teks'):
            pita.append(paragraf(esc(r['teks'])))
        pita.append(paragraf(f'<a href="{esc_attr(t["url"])}">Lihat semua →</a>'))
        bagian += [grup(pita, kelas='vf-masthead', align='full'),
                   q(4, 0, 'vf-sampul vf-sampul--dua', SAMPUL, t['id'], grid=2, min_lebar=None, align='full')]
    return '\n\n'.join(bagian)


def paragraf_kelas(dalam, kelas):
    return blok('paragraph', {'className': kelas}, f'<p class="{kelas}">{dalam}</p>')


def tombol_ganda(daftar):
    """Tombol berdampingan: [(label, url, garis)] — garis=True memakai gaya outline."""
    anak = []
    for label, url, garis in daftar:
        cls = 'wp-block-button' + (' is-style-outline' if garis else '')
        anak.append(blok('button', {'className': 'is-style-outline'} if garis else None,
                         f'<div class="{cls}"><a class="wp-block-button__link wp-element-button" '
                         f'href="{esc_attr(url)}">{esc(label)}</a></div>'))
    return blok('buttons', None, '<div class="wp-block-buttons">' + '\n\n'.join(anak) + '</div>')


def gambar(foto, kelas=None, aspek='4/3', perbesar=False):
    """core/image dari foto slot (opsi vfse_images, diisi paket-g-foto); '' kalau slot kosong.
    perbesar=True: klik untuk popup (lightbox bawaan core; WP 7.1 bisa berpindah antar-gambar
    dalam satu galeri). Markup simpanan tidak berubah — lightbox ditambahkan core saat render."""
    if not foto:
        return ''
    attrs = {'id': int(foto['id']), 'sizeSlug': 'large', 'linkDestination': 'none', 'aspectRatio': aspek, 'scale': 'cover'}
    if perbesar:
        attrs['lightbox'] = {'enabled': True}
    cls = 'wp-block-image size-large'
    if kelas:
        attrs['className'] = kelas
        cls += f' {kelas}'
    return blok('image', attrs, f'<figure class="{cls}"><img src="{esc_attr(foto["url"])}" alt="{esc_attr(foto.get("alt"))}" '
                               f'class="wp-image-{int(foto["id"])}" style="aspect-ratio:{aspek};object-fit:cover"/></figure>')


# Video latar contoh saat klien belum mengirim videonya sendiri. Diganti lewat manifest
# `hero_video=<URL YouTube>` (permintaan user 2026-09-18: hero memakai video autoplay
# seperti web referensi; "cari sample dulu sembarang").
VIDEO_HERO_CONTOH = 'https://www.youtube.com/watch?v=aqz-KE-bpKQ'


# Video klien dipasang sebagai TAUTAN EMBED, berkas videonya tidak pernah diunggah ke
# situs (keputusan user 2026-09-20; batas unggah hosting 8 MB dan video WhatsApp klien
# jauh lebih besar). Sumbernya: manifest `video_embed=<url,url>` lebih dulu, lalu berkas
# teks berisi tautan di folder klien Drive (mis. "video/link embet video.txt").
VIDEO_RE = re.compile(r'https?://(?:www\.|m\.)?(?:youtube\.com/(?:watch\?v=|shorts/|embed/|live/)'
                      r'|youtu\.be/)([A-Za-z0-9_-]{6,})', re.I)
# Shorts = video tegak 9:16; watch/embed biasa dianggap 16:9.
VIDEO_TEGAK_RE = re.compile(r'youtube\.com/shorts/', re.I)


def video_klien(cfg, domain):
    """Daftar video klien untuk seksi video: [{'url': <watch URL>, 'tegak': bool}].

    URL Shorts diubah ke bentuk watch?v= karena hanya bentuk itu yang pasti dikenali
    oEmbed WordPress; rasio tegaknya tetap dicatat supaya embed-nya tidak terpotong."""
    teks = str(cfg.get('video_embed', '') or '')
    if not teks and domain:
        folder = Path('/home/On Progress') / domain
        if folder.is_dir():
            for berkas in sorted(folder.rglob('*.txt')):
                try:
                    isi = berkas.read_text(errors='replace')
                except OSError:
                    continue
                if VIDEO_RE.search(isi):
                    teks += '\n' + isi
    hasil, terlihat = [], set()
    for m in VIDEO_RE.finditer(teks):
        kode = m.group(1)
        if kode in terlihat:
            continue
        terlihat.add(kode)
        hasil.append({'url': f'https://www.youtube.com/watch?v={kode}',
                      'tegak': bool(VIDEO_TEGAK_RE.search(m.group(0)))})
    return hasil[:12]


def blok_video(v):
    """core/embed YouTube responsif (bukan berkas video yang diunggah)."""
    aspek = 'wp-embed-aspect-9-16' if v.get('tegak') else 'wp-embed-aspect-16-9'
    kelas = f'vf-video__item {aspek} wp-has-aspect-ratio'
    return blok('embed', {'url': v['url'], 'type': 'video', 'providerNameSlug': 'youtube',
                          'responsive': True, 'className': kelas},
                f'<figure class="wp-block-embed is-type-video is-provider-youtube '
                f'wp-block-embed-youtube {kelas}"><div class="wp-block-embed__wrapper">\n'
                f'{esc(v["url"])}\n</div></figure>')


def sampul_video(url, anak, kelas, redup=60, tinggi=520):
    """core/cover dengan video latar YouTube (backgroundType embed-video).

    Core memutar embed tanpa kontrol; CSS tema (`.wp-block-cover__embed-background`)
    yang membuatnya menutupi seluruh cover di desktop maupun HP."""
    attrs = {'url': url, 'backgroundType': 'embed-video', 'dimRatio': redup,
             'overlayColor': 'primary-gelap', 'isUserOverlayColor': True,
             'minHeight': tinggi, 'minHeightUnit': 'px', 'align': 'full',
             'className': kelas, 'layout': {'type': 'default'}}
    # Urutan anak WAJIB: <figure> embed dulu, baru lapisan warna — kalau dibalik,
    # core/cover ditolak ("Expected tag name `figure`, instead saw `span`").
    return blok('cover', attrs,
                f'<div class="wp-block-cover alignfull {kelas}" style="min-height:{tinggi}px">'
                f'<figure class="wp-block-cover__video-background wp-block-cover__embed-background wp-block-embed">'
                f'<div class="wp-block-embed__wrapper">{esc(url)}</div></figure>'
                f'<span aria-hidden="true" class="wp-block-cover__background has-primary-gelap-background-color '
                f'has-background-dim-{redup} has-background-dim"></span>'
                '<div class="wp-block-cover__inner-container">' + '\n\n'.join(anak) + '</div></div>')


def sampul(foto, anak, kelas, redup=60, tinggi=520):
    """core/cover berfoto berlapis warna utama gelap (hero & pita ajakan).
    redup 50 = bawaan core (kelas tanpa angka) -> blok tidak valid; pakai kelipatan 10 selain 50."""
    attrs = {'url': foto['url'], 'id': int(foto['id']), 'dimRatio': redup, 'overlayColor': 'primary-gelap',
             'isUserOverlayColor': True, 'minHeight': tinggi, 'minHeightUnit': 'px', 'align': 'full',
             'className': kelas, 'layout': {'type': 'default'}}
    return blok('cover', attrs,
                f'<div class="wp-block-cover alignfull {kelas}" style="min-height:{tinggi}px">'
                f'<img class="wp-block-cover__image-background wp-image-{int(foto["id"])}" alt="" '
                f'src="{esc_attr(foto["url"])}" data-object-fit="cover"/>'
                f'<span aria-hidden="true" class="wp-block-cover__background has-primary-gelap-background-color '
                f'has-background-dim-{redup} has-background-dim"></span>'
                '<div class="wp-block-cover__inner-container">' + '\n\n'.join(anak) + '</div></div>')


def kepala_seksi(teks, sub='', label=''):
    return _kepala_seksi(teks, sub, label)


def _kepala_seksi(teks, sub='', label=''):
    anak = [paragraf_kelas(esc(label), 'vf-label-seksi')] if label else []
    anak.append(judul(esc(teks)))
    if sub:
        anak.append(paragraf(esc(sub)))
    return grup(anak, kelas='vf-kepala-seksi')


def judul_klien(judul, sd):
    """Judul bagian logo dari compro ("Our Partner"/"Our Client") jadi bahasa Indonesia."""
    t = re.sub(r'\s+', ' ', str(judul or '')).strip()
    if re.search(r'partner|mitra|rekan', t, re.I):
        return 'Mitra Kami'
    if re.search(r'client|klien|customer|pelanggan', t, re.I):
        return 'Klien Kami'
    return t or 'Klien Kami'


def kartu_foto(daftar, foto, kunci, kolom_grid=None, tanpa_foto=False, panah=False):
    """Kartu berfoto (layanan/produk) dalam grid; kunci[i] = slot foto butir ke-i.
    kolom_grid: jumlah kolom dari referensi klien (bawaan 4 untuk 4 butir, selain itu 3).

    tanpa_foto/panah: referensi berkartu polos (latar abu, tanpa gambar) dengan ikon panah
    di sudut — northseaaconsulting.com "Our Services" (permintaan user 2026-09-18)."""
    kartu = []
    for i, b in enumerate(daftar):
        g = None if tanpa_foto else gambar(foto.get(kunci[i]) if i < len(kunci) else None, 'vf-kartu-foto__gambar')
        isi_kartu = [judul(esc(b.get('judul')), 3)]
        if b.get('teks'):
            isi_kartu.append(paragraf(esc(b['teks'])))
        if b.get('rincian'):
            isi_kartu.append(daftar_poin([esc(r) for r in b['rincian'][:4]]))
        kelas = 'vf-kartu-foto'
        if not g:
            kelas += ' vf-kartu-foto--polos' if tanpa_foto else ' vf-kartu-foto--tanpa'
        if panah:
            kelas += ' vf-kartu-panah'
        kartu.append(grup(([g] if g else []) + [grup(isi_kartu, kelas='vf-kartu-foto__isi')], kelas=kelas))
    return grup(kartu, kelas='vf-grid-kartu', align='wide',
                layout={'type': 'grid', 'columnCount': kolom_grid or (4 if len(daftar) == 4 else 3), 'minimumColumnWidth': '15rem'})


def beranda_perusahaan_foto(q, sd, isi, info, gaya):
    """Beranda perusahaan mengikuti pola referensi klien (permintaan user 2026-09-15:
    "pastikan untuk desain sesuai referensi dari klien").

      korporat  hero foto selebar layar berlapis gelap, keunggulan di pita gelap
      terbelah  hero terang teks kiri + foto kanan, layanan di pita warna aksen

    Slot foto kosong tidak meninggalkan bingkai kosong: hero jatuh ke gradasi warna,
    kartu tanpa foto diberi garis aksen, galeri dilewati."""
    js = isi.get('judul_seksi') or {}
    foto = info.get('foto') or {}

    def tautan(slug):
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    kontak = tautan('hubungi-kami')
    bagian = []

    teks_hero = []
    if isi.get('hero_judul'):
        teks_hero.append(paragraf_kelas(esc(sd['slogan'] or sd['nama']), 'vf-label-seksi'))
    teks_hero.append(judul(esc(isi.get('hero_judul') or sd['nama']), 1))
    if isi.get('hero_teks'):
        teks_hero.append(paragraf(esc(isi['hero_teks'])))
    teks_hero.append(tombol_ganda([('Layanan Kami', tautan('layanan'), False), ('Hubungi Kami', kontak, True)]
                                  if sd['layanan'] else [('Hubungi Kami', kontak, False)]))
    if gaya == 'korporat' and foto.get('hero'):
        bagian.append(sampul(foto['hero'], teks_hero, 'vf-hero-foto', 60, 560))
    elif gaya == 'terbelah':
        kolom_hero = [kolom(teks_hero, '55%')]
        if foto.get('hero'):
            kolom_hero.append(kolom([gambar(foto['hero'], 'vf-foto-bingkai', '4/3')]))
        bagian.append(grup([barisan(kolom_hero, kelas='vf-hero-terang__baris', align='wide')], kelas='vf-hero-terang',
                           align='full', latar='latar', padding='var:preset|spacing|60', layout={'type': 'constrained'}))
    else:
        bagian.append(grup(teks_hero, kelas='vf-hero', align='full', teks='di-primary', padding='var:preset|spacing|70',
                           layout={'type': 'constrained'}))

    # Katalog produk mengikuti referensi: tampil dekat setelah hero, bukan tersembunyi di halaman Produk.
    # Hanya paket toko: query produk VD Store di situs perusahaan biasa tampil kosong
    # (judul + tombol saja, ptmitraajegselaras.com 2026-09-17).
    # Produk toko = `store_product` VD Store lewat shortcode-nya, arsipnya /produk/; Query Loop
    # `product` (CPT tema) selalu kosong di situs toko (kopibalidewiseri.com 2026-09-23).
    if info.get('toko'):
        bagian.append(grup([kepala_seksi(js.get('produk') or 'Produk Kami', 'Pilihan produk dan merchandise custom.'),
                            vd_store('[wp_store_shop per_page="8"]'),
                            tombol('Lihat Semua Produk', info['home'] + 'produk/')],
                           kelas='vf-seksi vf-produk-unggulan', align='wide'))

    # Ringkasan tentang: Data Situs, atau paragraf pertama halaman Tentang Kami tulisan AI
    # (glcagro.com: velocity_situs.tentang kosong, seksi tampil hanya judul + tombol).
    ringkas = sd.get('tentang') or ''
    if not ringkas:
        for p in re.findall(r'<p\b[^>]*>(.*?)</p>', (info['halaman'].get('tentang-kami') or {}).get('isi', ''), re.S):
            p = re.sub(r'\s+', ' ', html.unescape(re.sub(r'<[^>]+>', '', p))).strip()
            if len(p) >= 60:
                ringkas = p if len(p) <= 320 else p[:320].rsplit(' ', 1)[0] + '…'
                break
    if ringkas or foto.get('tentang'):
        teks = [paragraf_kelas(esc(js.get('tentang') or 'Tentang Kami'), 'vf-label-seksi'), judul(esc(sd['nama']))]
        if ringkas:
            teks.append(paragraf(esc(ringkas)))
        teks.append(tombol('Selengkapnya', tautan('tentang-kami')))
        kolom_tentang = [kolom([gambar(foto['tentang'], 'vf-foto-bingkai', '4/3')])] if foto.get('tentang') else []
        bagian.append(barisan(kolom_tentang + [kolom(teks)], kelas='vf-tentang', align='wide'))

    if sd['layanan']:
        kunci = [f"layanan-{l.get('slug', '')}" for l in isi.get('layanan') or []]
        isi_seksi = [kepala_seksi(js.get('layanan') or 'Layanan Kami', js.get('layanan_sub', '')),
                     kartu_foto(sd['layanan'], foto, kunci)]
        if gaya == 'terbelah':
            bagian.append(grup(isi_seksi, kelas='vf-pita vf-pita--aksen', align='full', latar='aksen', teks='di-aksen',
                               padding='var:preset|spacing|60', layout={'type': 'constrained'}))
        else:
            bagian.append(grup(isi_seksi, kelas='vf-seksi', align='wide'))

    if isi.get('keunggulan'):
        kotak = [grup([judul(esc(k.get('judul')), 3), paragraf(esc(k.get('teks')))],
                      kelas='vf-kotak-ikon vf-ikon--' + (re.sub(r'[^a-z]', '', str(k.get('ikon') or '')) or 'satu'))
                 for k in isi['keunggulan'][:4]]
        isi_seksi = [kepala_seksi(js.get('keunggulan') or 'Mengapa Memilih Kami'),
                     grup(kotak, kelas='vf-grid-ikon', align='wide',
                          layout={'type': 'grid', 'columnCount': 4, 'minimumColumnWidth': '13rem'})]
        if gaya == 'korporat':
            bagian.append(grup(isi_seksi, kelas='vf-pita vf-pita--gelap', align='full', latar='primary', teks='di-primary',
                               padding='var:preset|spacing|60', layout={'type': 'constrained'}))
        else:
            bagian.append(grup(isi_seksi, kelas='vf-seksi', align='wide'))

    if isi.get('produk'):
        bagian.append(grup([kepala_seksi(js.get('produk') or 'Produk Kami'),
                            kartu_foto(isi['produk'], foto, [p.get('slug', '') for p in isi['produk']])],
                           kelas='vf-seksi', align='wide'))

    foto_galeri = [foto[k] for k in sorted(foto) if k.startswith('galeri-')][:6]
    if foto_galeri:
        bagian.append(grup([kepala_seksi(js.get('galeri') or 'Galeri Kegiatan', js.get('galeri_sub', '')),
                            grup([gambar(f, 'vf-galeri__foto', '1/1') for f in foto_galeri], kelas='vf-galeri', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '12rem'}),
                            tombol('Lihat Galeri', tautan('galeri'))],
                           kelas='vf-seksi vf-seksi--galeri', align='wide'))

    arsip = tautan('berita')
    bagian.append(grup([bar('Artikel Terbaru', ('Lihat semua →', arsip)), q(3, 0, 'vf-kartu', KARTU, grid=3)],
                       kelas='vf-seksi', align='wide'))

    ajakan = [judul(esc(js.get('pemesanan') or 'Siap membantu kebutuhan Anda')),
              paragraf(esc(js.get('pemesanan_sub') or f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
              tombol('Hubungi Kami', kontak)]
    foto_ajakan = foto.get('galeri-1') or foto.get('tentang') or foto.get('hero')
    if gaya == 'korporat' and foto_ajakan:
        bagian.append(sampul(foto_ajakan, ajakan, 'vf-ajakan-foto', 70, 320))
    else:
        bagian.append(grup(ajakan, kelas='vf-ajakan', align='wide', teks='di-primary', latar='primary',
                           padding='var:preset|spacing|50', layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


KATALOG_DIR = Path(os.environ.get('VELOCITY_FSE_KATALOG') or '/var/lib/velocity/fse-katalog')


def katalog_data(domain, sd, isi):
    """Isi beranda gaya katalog. Berkas <KATALOG_DIR>/<domain>.json (disusun dari katalog &
    company profile klien) didahulukan; tanpa berkas itu isi diturunkan dari data AI situs."""
    berkas = KATALOG_DIR / f'{domain}.json'
    if domain and berkas.is_file():
        return json.loads(berkas.read_text())
    nama = sd['nama']
    return {
        'hero': {'judul': isi.get('hero_judul') or nama, 'teks': isi.get('hero_teks') or '',
                 'panel_judul': 'Layanan Kami', 'panel': [l.get('judul') for l in sd.get('layanan') or []][:4]},
        'keunggulan': {'judul': f'Kenapa Memilih {nama}?',
                       'butir': [{'judul': k.get('judul'), 'teks': k.get('teks')} for k in (isi.get('keunggulan') or [])[:5]]},
        'koleksi': {'judul': 'Produk Pilihan',
                    'butir': [{'judul': p.get('judul'), 'sub': p.get('teks')} for p in isi.get('produk') or []]},
        'cta': {'judul': 'Siap membantu kebutuhan Anda',
                'teks': f'Ceritakan kebutuhan Anda, tim {nama} akan segera menghubungi kembali.'},
    }


def ikon(nama):
    """Kelas ikon CSS (mask SVG di style.css, bagian gaya katalog)."""
    return 'vf-ik vf-ik--' + (re.sub(r'[^a-z]', '', str(nama or '')) or 'bintang')


def lipat(tanya, jawab, kelas):
    return blok('details', {'className': kelas},
                f'<details class="wp-block-details {kelas}"><summary>{esc(tanya)}</summary>'
                + paragraf(esc(jawab)) + '</details>')


def beranda_katalog(q, sd, isi, info):
    """Beranda katalog merchandise mengikuti pola referensi klien (user 2026-09-15, contoh
    tasseminarpalupi.com): hero gelap + panel layanan, deret media cetak, fakta workshop + angka,
    split desain custom, keunggulan berikon 3+2, koleksi 3 kolom, ubin kategori, FAQ akordeon,
    teks SEO, CTA gelap. Tanpa foto produk: kartu & ubin memakai ikon. Teks dari katalog_data."""
    d = katalog_data(info.get('domain', ''), sd, isi)
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'
    produk = ((info.get('semua') or {}).get('produk') or {}).get('url') or info['home'] + 'produk/'
    bagian = []

    h = d.get('hero') or {}
    kiri = [paragraf_kelas('★★★★★&nbsp; ' + esc(h['trust']), 'vf-kat-trust')] if h.get('trust') else []
    kiri.append(judul(esc(h.get('judul') or sd['nama']), 1))
    if h.get('sorot'):
        kiri.append(paragraf_kelas(esc(h['sorot']), 'vf-kat-sorot'))
    if h.get('teks'):
        kiri.append(paragraf(esc(h['teks'])))
    kiri.append(tombol_ganda([(h.get('tombol') or 'Hubungi Kami', kontak, False), ('Lihat Produk', produk, True)]))
    kanan = []
    if h.get('panel'):
        kanan.append(grup([paragraf_kelas(esc(h.get('panel_judul') or 'Layanan Kami'), 'vf-kat-panel__judul')]
                          + [paragraf_kelas(esc(p), 'vf-kat-panel__item') for p in h['panel']], kelas='vf-kat-panel'))
    bagian.append(grup([barisan([kolom(kiri, '58%'), kolom(kanan, '42%')], kelas='vf-kat-hero__baris', align='wide')],
                       kelas='vf-kat-hero', align='full', layout={'type': 'constrained'}))

    m = d.get('media') or {}
    if m.get('butir'):
        bagian.append(grup([kepala_seksi(m.get('judul') or 'Media Cetak', m.get('teks', ''), m.get('label', '')),
                            grup([paragraf_kelas(esc(b), 'vf-kat-media__item') for b in m['butir']], kelas='vf-kat-media',
                                 layout={'type': 'flex', 'flexWrap': 'wrap', 'justifyContent': 'center'})],
                           kelas='vf-seksi vf-kat-media-seksi', align='wide'))

    f = d.get('fakta') or {}
    if f.get('butir'):
        kiri = [judul(esc(f['judul']))] + ([paragraf(esc(f['teks']))] if f.get('teks') else [])
        if f.get('poin'):
            kiri.append(daftar_poin([esc(p) for p in f['poin']], kelas='vf-kat-cek'))
        kanan = [grup([paragraf_kelas(esc(a), 'vf-kat-angka'), paragraf_kelas(esc(b), 'vf-kat-angka__label')],
                      kelas='vf-kat-fakta__item') for a, b in f['butir']]
        bagian.append(grup([barisan([kolom(kiri, '60%'), kolom(kanan, '40%')], kelas='vf-kat-fakta', align='wide')],
                           kelas='vf-seksi', align='wide'))

    c = d.get('custom') or {}
    if c.get('judul'):
        kiri = [paragraf_kelas(esc(c['label']), 'vf-label-seksi')] if c.get('label') else []
        tanda = f'<span class="vf-kat-tanda">{esc(c["tanda"])}</span><br>' if c.get('tanda') else ''
        kiri += [judul(tanda + esc(c['judul'])), paragraf(esc(c.get('teks', '')))]
        langkah = c.get('langkah') or [(a.get('judul'), a.get('teks')) for a in (isi.get('alur') or [])[:3]]
        kanan = [grup([paragraf_kelas(str(i), 'vf-kat-langkah__no'),
                       grup([judul(esc(a), 3), paragraf(esc(b))], kelas='vf-kat-langkah__teks')],
                      kelas='vf-kat-langkah') for i, (a, b) in enumerate(langkah, 1)]
        bagian.append(grup([barisan([kolom(kiri, '50%'), kolom(kanan, '50%')], kelas='vf-kat-custom', align='wide')],
                           kelas='vf-seksi', align='wide'))

    k = d.get('keunggulan') or {}
    if k.get('butir'):
        kartu = [grup([judul(esc(b.get('judul')), 3), paragraf(esc(b.get('teks')))],
                      kelas='vf-kat-unggul ' + ikon(b.get('ikon'))) for b in k['butir'][:5]]
        bagian.append(grup([kepala_seksi(k.get('judul') or 'Keunggulan Kami'),
                            grup(kartu, kelas='vf-kat-unggul-grid', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '14rem'})],
                           kelas='vf-kat-band', align='full', layout={'type': 'constrained'}))

    ko = d.get('koleksi') or {}
    if ko.get('butir'):
        kartu = []
        for b in ko['butir']:
            anak = [grup([], kelas='vf-kat-koleksi__ikon ' + ikon(b.get('ikon'))), judul(esc(b.get('judul')), 3)]
            if b.get('sub'):
                anak.append(paragraf(esc(b['sub'])))
            if b.get('tag'):
                anak.append(paragraf_kelas(esc(b['tag']), 'vf-kat-tag'))
            kartu.append(grup(anak, kelas='vf-kat-koleksi__kartu'))
        bagian.append(grup([kepala_seksi(ko.get('judul') or 'Produk Pilihan', ko.get('sub', '')),
                            grup(kartu, kelas='vf-kat-koleksi__grid', align='wide',
                                 layout={'type': 'grid', 'columnCount': 3, 'minimumColumnWidth': '14rem'}),
                            tombol('Lihat Semua Produk', produk)],
                           kelas='vf-seksi vf-kat-koleksi', align='wide'))

    band = []
    ka = d.get('kategori') or {}
    if ka.get('butir'):
        ubin = [grup([paragraf_kelas(f'<a href="{esc_attr(produk)}">{esc(b.get("judul"))}</a>', 'vf-kat-ubin__label')],
                     kelas='vf-kat-ubin ' + ikon(b.get('ikon'))) for b in ka['butir']]
        band.append(grup([kepala_seksi(ka.get('judul') or 'Kategori Produk'),
                          grup(ubin, kelas='vf-kat-ubin-grid', align='wide',
                               layout={'type': 'grid', 'columnCount': 5, 'minimumColumnWidth': '9rem'}),
                          tombol('Lihat Semua Kategori', produk)], kelas='vf-kat-kategori', align='wide'))
    fq = d.get('faq') or {}
    if fq.get('butir'):
        band.append(grup([kepala_seksi(fq.get('judul') or 'Pertanyaan Umum')]
                         + [lipat(t, j, 'vf-kat-faq__item') for t, j in fq['butir']], kelas='vf-kat-faq', align='wide'))
    if band:
        bagian.append(grup(band, kelas='vf-kat-band vf-kat-band--bawah', align='full', layout={'type': 'constrained'}))

    s = d.get('seo') or {}
    if s.get('judul'):
        bagian.append(grup([judul(esc(s['judul']), kelas='vf-kat-seo__judul'), paragraf(esc(s.get('teks', ''))),
                            tombol_ganda([('Hubungi Kami', kontak, True)])], kelas='vf-seksi vf-kat-seo', align='wide'))

    ct = d.get('cta') or {}
    bagian.append(grup([judul(esc(ct.get('judul') or 'Hubungi Kami')), paragraf(esc(ct.get('teks', ''))),
                        tombol(ct.get('tombol') or 'Hubungi Kami', kontak)],
                       kelas='vf-kat-cta', align='wide', layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


# ---------------------------------------------------------------------------
# Beranda mengikuti referensi web klien (gaya "referensi")
# ---------------------------------------------------------------------------

def paket_toko(cfg):
    """Paket Toko Online (custom maupun biasa): produk dari plugin VD Store."""
    return 'tokoonline' in re.sub(r'\s+', '', str(cfg.get('paket', '')).lower())


def toko_custom(cfg):
    """Paket Toko Online Custom: satu-satunya paket toko di jalur FSE (produk = store_product VD Store).
    Toko Online biasa tetap child theme klasik (keputusan user 2026-09-23)."""
    return 'tokoonlinecustom' in re.sub(r'\s+', '', str(cfg.get('paket', '')).lower())


def vd_store(kode):
    return blok('shortcode', None, kode)


def ringkasan_tentang(sd, info):
    """Data Situs, atau paragraf pertama halaman Tentang Kami tulisan AI."""
    if sd.get('tentang'):
        return sd['tentang']
    for p in re.findall(r'<p\b[^>]*>(.*?)</p>', (info['halaman'].get('tentang-kami') or {}).get('isi', ''), re.S):
        p = re.sub(r'\s+', ' ', html.unescape(re.sub(r'<[^>]+>', '', p))).strip()
        if len(p) >= 60:
            return p if len(p) <= 320 else p[:320].rsplit(' ', 1)[0] + '…'
    return ''


def seksi_berlatar(anak, s, foto=None):
    """Bungkus satu seksi sesuai latar seksi referensi: terang | abu | aksen | gelap | foto."""
    latar = s.get('latar')
    # Rencana VERSI 4 (2026-09-17): judul seksi rata kiri seperti referensi (bawaan tema: tengah).
    rata = ' vf-rata-tengah' if s.get('rata') == 'tengah' else ' vf-rata-kiri' if s.get('rata') == 'kiri' and 'label' in s else ''
    kelas = f"vf-ref-seksi vf-ref-{s['jenis']}" + rata + (' vf-ref-kotak' if s.get('kotak') and s['jenis'] == 'tentang' else '')
    penuh = {'type': 'constrained'}
    if latar == 'foto' and foto:
        # dimRatio core/cover hanya kelipatan 10 (kelas has-background-dim-NN), selain itu blok tidak valid.
        return sampul(foto, anak, kelas + ' vf-pita-foto', 70, 420)
    if latar in ('gelap', 'foto'):
        return grup(anak, kelas=kelas + ' vf-pita vf-pita--gelap', align='full', latar='primary', teks='di-primary',
                    padding='var:preset|spacing|60', layout=penuh)
    if latar == 'aksen':
        return grup(anak, kelas=kelas + ' vf-pita vf-pita--aksen', align='full', latar='aksen', teks='di-aksen',
                    padding='var:preset|spacing|60', layout=penuh)
    if latar == 'abu':
        return grup(anak, kelas=kelas + ' vf-pita', align='full', latar='latar', padding='var:preset|spacing|60', layout=penuh)
    return grup(anak, kelas=kelas + ' vf-seksi', align='wide')


def ikon_tersedia():
    """Slug ikon yang benar-benar punya CSS di tema (.vf-ikon--<slug>).

    Slug tanpa definisi membuat --vf-ikon kosong sehingga kotak ikon tampil sebagai kotak
    polos tanpa gambar — pernah terjadi pada ikon "orang" di kartu keunggulan."""
    try:
        return set(re.findall(r'\.vf-ikon--([a-z]+)', (TEMA / 'style.css').read_text()))
    except OSError:
        return set()


def tombol_kelas(daftar, kelas):
    """Deret tombol berkelas: [(label, url, garis)]."""
    anak = []
    for label, url, garis in daftar:
        cls = 'wp-block-button' + (' is-style-outline' if garis else '')
        anak.append(blok('button', {'className': 'is-style-outline'} if garis else None,
                         f'<div class="{cls}"><a class="wp-block-button__link wp-element-button" '
                         f'href="{esc_attr(url)}">{esc(label)}</a></div>'))
    return blok('buttons', {'className': kelas}, f'<div class="wp-block-buttons {kelas}">' + '\n\n'.join(anak) + '</div>')


def slug_teks(teks):
    return re.sub(r'[^a-z0-9]+', '-', str(teks or '').lower()).strip('-')[:60]


def gambar_ket(foto, keterangan, kelas=None):
    """core/image berketerangan (galeri referensi berketerangan)."""
    if not foto:
        return ''
    attrs = {'id': int(foto['id']), 'sizeSlug': 'large', 'linkDestination': 'none'}
    cls = 'wp-block-image size-large'
    if kelas:
        attrs['className'] = kelas
        cls += f' {kelas}'
    ket = f'<figcaption class="wp-element-caption">{esc(keterangan)}</figcaption>' if keterangan else ''
    return blok('image', attrs, f'<figure class="{cls}"><img src="{esc_attr(foto["url"])}" alt="{esc_attr(foto.get("alt"))}" '
                               f'class="wp-image-{int(foto["id"])}"/>{ket}</figure>')


def akordeon(butir, kelas='vf-akordeon-grup'):
    """core/details bertumpuk; butir [(judul, teks)], yang pertama terbuka."""
    lipat = []
    for i, (j, t) in enumerate(butir):
        attrs = {'className': 'vf-akordeon'}
        if i == 0:
            attrs['showContent'] = True
        buka = ' open' if i == 0 else ''
        lipat.append(blok('details', attrs, f'<details class="wp-block-details vf-akordeon"{buka}><summary>{esc(j)}</summary>'
                                            + paragraf(esc(t)) + '</details>'))
    return grup(lipat, kelas=kelas)


def kotak_ikon(butir, kolom_grid, aksi=None):
    punya = ikon_tersedia()
    def slug(k):
        nama = re.sub(r'[^a-z]', '', str(k.get('ikon') or '')) or 'satu'
        if punya and nama not in punya:
            print(f'fse: ikon_tidak_ada:{nama} (dipakai "{k.get("judul")}", diganti ikon bawaan)')
            return 'satu'
        return nama
    # aksi: [(label, url)] per kartu — kartu layanan referensi bertombol "Lihat Layanan".
    kotak = [grup([judul(esc(k.get('judul')), 3), paragraf(esc(k.get('teks')))]
                  + ([tombol_kelas([(aksi[i][0], aksi[i][1], False)], 'vf-kartu-aksi')] if aksi and i < len(aksi) else []),
                  kelas='vf-kotak-ikon vf-ikon--' + slug(k))
             for i, k in enumerate(butir)]
    return grup(kotak, kelas=f'vf-grid-ikon vf-kolom-{kolom_grid}', align='wide',
                layout={'type': 'grid', 'columnCount': kolom_grid, 'minimumColumnWidth': '13rem'})


def beranda_referensi(q, sd, isi, info):
    """Beranda disusun mengikuti referensi web klien (keputusan user 2026-09-15: referensi =
    ACUAN UTAMA; tata letak & gaya mirip, konten milik klien).

    Urutan & jenis seksi, varian hero, latar tiap seksi, dan jumlah kolom kartu dibaca dari
    rencana scripts/referensi_desain.py (info['desain']). Isi tiap seksi dari data klien.
    Seksi yang tidak punya data jujur — testimoni, angka pencapaian, FAQ, video, logo klien
    tanpa daftar pelanggan — dilewati dan dicatat, tidak dikarang. Toko online: produk
    memakai shortcode VD Store dan selalu tampil di beranda."""
    desain = info['desain']
    js = isi.get('judul_seksi') or {}
    # Label kecil di atas judul seksi bila referensinya berlabel (rencana VERSI 4, centralimpex.com
    # 2026-09-17: "PRODUCT SCOPE", "WHY WORK WITH US"). Teksnya milik situs, bukan salinan referensi.
    sekarang = {}
    label_jenis = {'tentang': 'Tentang Kami', 'layanan': 'Layanan', 'produk': 'Produk', 'keunggulan': 'Keunggulan',
                   'alur': 'Alur Kerja', 'galeri': 'Galeri', 'klien': 'Klien', 'artikel': 'Artikel',
                   'kontak': 'Kontak', 'ajakan': sd['nama']}

    def kepala_seksi(teks, sub='', label=''):
        s = sekarang.get('s') or {}
        if not label and s.get('label'):
            label = label_jenis.get(s['jenis'], '')
            if label.strip().lower() == str(teks).strip().lower():
                label = ''
        return _kepala_seksi(teks, sub, label)

    foto = info.get('foto') or {}
    toko = bool(info.get('toko'))
    kontak = ((info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/')
    produk_url = info['home'] + 'produk/'
    foto_galeri = [foto[k] for k in sorted(foto) if k.startswith('galeri-')]

    def tautan(slug):
        if slug in (info.get('tanpa_halaman') or ()):
            return produk_url if toko else kontak
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    def tautan_layanan(l):
        # Halaman anak per layanan dibuat bila menu referensi punya submenu layanan (langkah_isi).
        if info.get('layanan_anak'):
            return f"{tautan('layanan').rstrip('/')}/{slug_teks(l.get('judul'))}/"
        return tautan('layanan')

    def kolom_ref(s, bawaan, jumlah):
        return max(1, min(int(s.get('kolom') or bawaan), jumlah or bawaan, 6))

    def kategori(s):
        return s['jenis'] == 'produk' and re.search(r'kategori|category', s.get('judul_referensi', ''), re.I)

    def hero(s):
        teks_hero = []
        # Label kecil di atas judul hanya kalau referensinya memang berlabel; dulu slogan
        # klien selalu dicetak sehingga hero kita punya baris yang tidak ada di referensi.
        berlabel = s.get('label', True) or not s.get('terukur', True)
        if berlabel and sd.get('slogan'):
            teks_hero.append(paragraf_kelas(esc(sd['slogan']), 'vf-label-seksi'))
        elif berlabel and isi.get('hero_judul'):
            # Referensi berlabel di atas judul hero: nama usaha klien sebagai label.
            teks_hero.append(paragraf_kelas(esc(sd['nama']), 'vf-label-seksi'))
        teks_hero.append(judul(esc(isi.get('hero_judul') or sd['nama']), 1))
        if isi.get('hero_teks'):
            teks_hero.append(paragraf(esc(isi['hero_teks'])))
        if toko:
            aksi = [('Lihat Produk', produk_url, False), ('Hubungi Kami', kontak, True)]
        elif sd['layanan']:
            aksi = [('Layanan Kami', tautan('layanan'), False), ('Hubungi Kami', kontak, True)]
        else:
            aksi = [('Hubungi Kami', kontak, False)]
        teks_hero.append(tombol_ganda(aksi))
        varian = s.get('varian') or 'foto'
        # Hero referensi yang teksnya tercatat `kontras_rendah` = tulisan putih di atas
        # foto: pengukur hanya melihat warna latar pembungkusnya (putih) lalu menyebutnya
        # "terang", sehingga hero kita jadi kotak polos padahal referensinya banner berfoto
        # (northseaaconsulting.com, solusicerdasconsulting.com 2026-09-18).
        if varian == 'terang' and foto.get('hero') and s.get('kontras_rendah'):
            varian = 'foto'
        # Rata teks mengikuti referensi; dulu hero terang SELALU dipaksa rata tengah.
        rata = ' vf-rata-tengah' if s.get('rata') == 'tengah' else ''
        slide = [k for k in ('hero-2', 'hero-3', 'hero-4') if foto.get(k)]
        if varian == 'foto' and foto.get('hero') and slide and (s.get('slider') or not s.get('terukur', True)):
            # Lapisan gelap tipis (20): foto slide berupa banner produk yang sisi teksnya sudah gelap.
            # Referensi ber-banner slider (kreditmotor.rmg.asia): slide 1 = hero klien, slide
            # berikutnya = layanan/produk klien berikutnya. Foto slide dari slot hero-2.. (paket-g-foto/PM).
            sampul_hero = [sampul(foto['hero'], teks_hero, 'vf-hero-foto vf-ref-hero' + rata, 20, 520)]
            layanan_slide = [l for l in sd['layanan'] if l.get('judul')]
            for i, k in enumerate(slide):
                l = layanan_slide[i] if i < len(layanan_slide) else {}
                teks_slide = [judul(esc(l.get('judul') or sd['nama']), 2, 'vf-ref-slider__judul')]
                if l.get('teks'):
                    teks_slide.append(paragraf(esc(l['teks'])))
                teks_slide.append(tombol_ganda([('Lihat Produk', produk_url, False)] if toko
                                               else [('Selengkapnya', tautan('layanan'), False)]))
                sampul_hero.append(sampul(foto[k], teks_slide, 'vf-hero-foto vf-ref-hero' + rata, 20, 520))
            return grup(sampul_hero, kelas='vf-ref-slider', align='full')
        if varian == 'foto' and foto.get('hero'):
            if s.get('bar_bawah'):
                # Referensi berbar putih di dasar hero (kontraktorhijau.com): ajakan konsultasi.
                bar_isi = [paragraf(f"Punya rencana bersama <strong>{esc(sd['nama'])}</strong>? Konsultasikan kebutuhan Anda."),
                           tombol('Konsultasi Sekarang', kontak)]
                tinggi = max(560, min(int(s.get('tinggi') or 0), 800))
                return sampul(foto['hero'], teks_hero + [grup(bar_isi, kelas='vf-ref-hero-bar', align='wide')],
                              'vf-hero-foto vf-ref-hero' + rata, 40, tinggi)
            # Referensi ber-video latar: hero klien juga memakai video (manifest
            # `hero_video=`, kalau kosong memakai video contoh untuk sementara).
            video = (info.get('hero_video') or '').strip() or (VIDEO_HERO_CONTOH if s.get('video_latar') else '')
            if video:
                isi_video = teks_hero
                if s.get('kolom') == 2 and len(teks_hero) >= 3:
                    pisah = next(i for i, b in enumerate(teks_hero) if '<h1' in b) + 1
                    isi_video = [barisan([kolom(teks_hero[:pisah]), kolom(teks_hero[pisah:])],
                                         kelas='vf-ref-hero__baris', align='wide')]
                return sampul_video(video, isi_video, 'vf-hero-foto vf-ref-hero' + rata, 60, 560)
            # Hero dua kolom seperti referensi: judul di kiri, keterangan & tombol di
            # kanan (northseaaconsulting.com). Tanpa ini semuanya menumpuk di satu kolom.
            if s.get('kolom') == 2 and len(teks_hero) >= 3:
                pisah = next(i for i, b in enumerate(teks_hero) if '<h1' in b) + 1
                isi_hero = [barisan([kolom(teks_hero[:pisah]), kolom(teks_hero[pisah:])],
                                    kelas='vf-ref-hero__baris', align='wide')]
                return sampul(foto['hero'], isi_hero, 'vf-hero-foto vf-ref-hero' + rata, 60, 560)
            return sampul(foto['hero'], teks_hero, 'vf-hero-foto vf-ref-hero' + rata, 60, 560)
        if varian == 'terbelah':
            kol = [kolom(teks_hero, '55%')] + ([kolom([gambar(foto['hero'], 'vf-foto-bingkai', '4/3')])] if foto.get('hero') else [])
            return grup([barisan(kol, kelas='vf-hero-terang__baris', align='wide')], kelas='vf-hero-terang vf-ref-hero',
                        align='full', latar='latar', padding='var:preset|spacing|60', layout={'type': 'constrained'})
        if varian == 'terang':
            return grup(teks_hero, kelas='vf-hero-terang vf-ref-hero' + rata, align='full', latar='latar',
                        padding='var:preset|spacing|70', layout={'type': 'constrained'})
        # warna, atau hero berfoto yang slot fotonya masih kosong: gradasi warna utama.
        return grup(teks_hero, kelas='vf-hero vf-ref-hero' + rata, align='full', teks='di-primary',
                    padding='var:preset|spacing|70', layout={'type': 'constrained'})

    def tentang(s):
        ringkas = ringkasan_tentang(sd, info)
        if not (ringkas or foto.get('tentang')):
            return ''
        teks = [paragraf_kelas(esc(js.get('tentang') or 'Tentang Kami'), 'vf-label-seksi'), judul(esc(sd['nama']))]
        if ringkas:
            teks.append(paragraf(esc(ringkas)))
        teks.append(tombol('Selengkapnya', tautan('tentang-kami')))
        kol = [kolom([gambar(foto['tentang'], 'vf-foto-bingkai', '4/3')])] if foto.get('tentang') else []
        # Foto di sisi yang sama dengan referensi (`foto_posisi`); dulu selalu di kiri.
        baris = (kol + [kolom(teks)]) if s.get('foto_posisi') != 'kanan' else ([kolom(teks)] + kol)
        return seksi_berlatar([barisan(baris, kelas='vf-tentang', align='wide')], s)

    def layanan(s):
        if not sd['layanan']:
            return ''
        n = kolom_ref(s, 3, len(sd['layanan']))
        kunci = [f"layanan-{l.get('slug', '')}" for l in isi.get('layanan') or []]
        if s.get('kartu_foto') and n == 2 and (s.get('kartu_radius') or 0) >= 8:
            # Kartu banner 2 kolom (referensi: foto selebar kartu memudar ke kiri, judul di kiri
            # atas, tombol pil di kanan bawah).
            kartu = []
            for i, l in enumerate(sd['layanan']):
                g = gambar(foto.get(kunci[i]) if i < len(kunci) else None, 'vf-kartu-banner__foto', '16/10')
                teks = [judul(esc(l.get('judul')), 3)]
                if l.get('teks'):
                    teks.append(paragraf(esc(l['teks'])))
                label_tombol = 'Lihat Produk' if toko and 'layanan' in (info.get('tanpa_halaman') or ()) else 'Selengkapnya'
                isi_kartu = [grup(teks, kelas='vf-kartu-banner__teks'),
                             tombol(label_tombol, tautan('layanan'))]
                kartu.append(grup(([g] if g else []) + [grup(isi_kartu, kelas='vf-kartu-banner__isi')],
                                  kelas='vf-kartu-banner' + ('' if g else ' vf-kartu-banner--tanpa')))
            grid = grup(kartu, kelas='vf-grid-banner', align='wide',
                        layout={'type': 'grid', 'columnCount': 2, 'minimumColumnWidth': '20rem'})
            # Referensi tanpa judul di seksi ini -> kartu langsung tampil (judul_referensi kosong).
            anak = ([kepala_seksi(js.get('layanan') or 'Layanan Kami', js.get('layanan_sub', ''))]
                    if s.get('judul_referensi') else []) + [grid]
            return seksi_berlatar(anak, s)
        if (s.get('kartu_ikon') or s.get('kartu_tombol')) and not s.get('kartu_foto'):
            aksi = [('Lihat Layanan', tautan_layanan(l)) for l in sd['layanan']] if s.get('kartu_tombol') else None
            grid = kotak_ikon(sd['layanan'], n, aksi)
        else:
            grid = kartu_foto(sd['layanan'], foto, kunci, n)
        anak = [kepala_seksi(js.get('layanan') or 'Layanan Kami', js.get('layanan_sub', ''))]
        if s.get('kepala_tombol'):
            # Judul seksi referensi diikuti tombol (kontraktorhijau.com: "Lihat Paket" | "Ajukan Proyek").
            anak.append(tombol_kelas([('Lihat Layanan', tautan('layanan'), False), ('Hubungi Kami', kontak, True)],
                                     'vf-ref-kepala-aksi'))
        return seksi_berlatar(anak + [grid], s, foto.get('galeri-1'))

    def produk(s):
        if toko:
            n = kolom_ref(s, 4, 6)
            if kategori(s):
                # Referensi ber-slider (kreditmotor.rmg.asia): satu baris 4 ubin, sisanya digeser panah.
                return seksi_berlatar([kepala_seksi('Kategori Produk'),
                                       vd_store(f'[wp_store_taxonomies_carousel columns="{4 if s.get("slider") else max(n, 4)}" rows="1"]')], s)
            kode = (f'[wp_store_products_carousel per_row="{n}"]' if s.get('slider')
                    else f'[wp_store_shop per_page="{n * 2}"]')
            return seksi_berlatar([kepala_seksi(js.get('produk') or 'Produk Terbaru'), vd_store(kode),
                                   tombol('Lihat Semua Produk', produk_url)], s)
        if not isi.get('produk'):
            return ''
        # Kartu mengikuti referensi: berfoto atau polos berpanah (rencana VERSI >= 4).
        polos = 'kartu_foto' in s and not s.get('kartu_foto')
        return seksi_berlatar([kepala_seksi(js.get('produk') or 'Produk Kami'),
                               kartu_foto(isi['produk'], foto, [p.get('slug', '') for p in isi['produk']],
                                          kolom_ref(s, 3, len(isi['produk'])),
                                          tanpa_foto=polos, panah=polos and bool(s.get('kartu_ikon')))], s)

    def keunggulan(s):
        if not isi.get('keunggulan'):
            return ''
        butir = isi['keunggulan'][:max(6, min(int(s.get('jumlah') or 0), 8))]
        return seksi_berlatar([kepala_seksi(js.get('keunggulan') or 'Mengapa Memilih Kami'),
                               kotak_ikon(butir, kolom_ref(s, 4, len(butir)))], s, foto.get('galeri-2'))

    def alur(s):
        if not isi.get('alur'):
            return ''
        if s.get('akordeon'):
            # Tahapan berbentuk akordeon (kontraktorhijau.com), foto di sisi lain bila berdampingan.
            butir = [(f"{i + 1}. {a.get('judul')}", a.get('teks') or '') for i, a in enumerate(isi['alur'][:6])]
            kiri = [kepala_seksi(js.get('alur') or 'Alur Kerja'), akordeon(butir)]
            f_alur = foto.get('galeri-6') or foto.get('tentang')
            if s.get('berdampingan') and f_alur:
                return seksi_berlatar([barisan([kolom(kiri, '50%'), kolom([gambar(f_alur, None, '3/4')])],
                                               kelas='vf-ref-alur-dua', align='wide')], s)
            return seksi_berlatar(kiri, s)
        langkah = [kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))]) for a in isi['alur'][:5]]
        return seksi_berlatar([kepala_seksi(js.get('alur') or 'Alur Kerja'), barisan(langkah, kelas='vf-langkah', align='wide')], s)

    def galeri(s):
        if not foto_galeri:
            return ''
        n = kolom_ref(s, 3, len(foto_galeri))
        if s.get('kartu_keterangan'):
            # Deret foto berketerangan + kepala dua kolom (judul | pengantar & tombol).
            kepala = barisan([kolom([judul(esc(js.get('galeri') or 'Galeri'))]),
                              kolom([paragraf(esc(js.get('galeri_sub') or f"Gambaran pekerjaan {sd['nama']}.")),
                                     tombol('Lihat Galeri', tautan('galeri'))])], kelas='vf-ref-kepala-dua', align='wide')
            ket = {k: v for k, v in foto.items() if k.startswith('galeri-')}
            fotos = [gambar_ket(ket[k], (ket[k].get('alt') or '').capitalize()) for k in sorted(ket)][:n]
            return seksi_berlatar([kepala, grup(fotos, kelas=f'vf-galeri-ket vf-kolom-{n}', align='wide',
                                               layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '12rem'})], s)
        return seksi_berlatar([kepala_seksi(js.get('galeri') or 'Galeri', js.get('galeri_sub', '')),
                               grup([gambar(f, 'vf-galeri__foto', '1/1') for f in foto_galeri[:max(n * 2, 4)]],
                                    kelas='vf-galeri', align='wide',
                                    layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '11rem'}),
                               tombol('Lihat Galeri', tautan('galeri'))], s)

    def klien(s):
        nama = [c if isinstance(c, str) else c.get('nama', '') for c in isi.get('customer') or []]
        nama = [n for n in nama if n][:24]
        # Logo mitra & klien dari company profile lebih baik daripada daftar nama: beranda
        # referensi pun memajang logonya (permintaan user 2026-09-18).
        if info.get('mitra'):
            bagian = []
            for g in info['mitra']:
                logo = [blok('image', {'id': l['id'], 'sizeSlug': 'medium', 'className': 'vf-klien__logo'},
                             f'<figure class="wp-block-image size-medium vf-klien__logo">'
                             f'<img src="{esc(l["url"])}" alt="{esc(l.get("alt") or g["judul"])}"/></figure>')
                        for l in g['logo'][:40]]
                if not logo:
                    continue
                if g['judul']:
                    bagian.append(kepala_seksi(judul_klien(g['judul'], sd)))
                # Blok `velocity/geser`: carousel berisi blok Gambar biasa, supaya pemilik
                # situs bisa menambah/mengganti logo lewat editor (permintaan user
                # 2026-09-18 — grup berkelas dulu sulit dikenali & disunting).
                bagian.append(blok('velocity/geser', {'tampilan': 'logo', 'align': 'wide'},
                                   '\n\n'.join(logo)))
            if bagian:
                return seksi_berlatar(bagian, s)
        if not nama:
            return ''
        return seksi_berlatar([kepala_seksi('Klien Kami'),
                               grup([paragraf_kelas(esc(n), 'vf-klien__nama') for n in nama], kelas='vf-klien', align='wide',
                                    layout={'type': 'grid', 'columnCount': kolom_ref(s, 4, len(nama)), 'minimumColumnWidth': '10rem'})], s)

    def artikel(s):
        n = kolom_ref(s, 3, 4)
        if 'kartu_radius' in s:
            # Rencana VERSI >= 3: judul seksi biasa (rata sesuai referensi) + kartu berfoto dengan
            # ringkasan & "Baca Selengkapnya", bukan pita tab berita.
            kartu = '\n\n'.join([
                blok('post-featured-image', {'isLink': True, 'aspectRatio': '16/10'}),
                blok('post-title', {'level': 3, 'isLink': True}),
                blok('post-excerpt', {'excerptLength': 20, 'moreText': 'Baca Selengkapnya…', 'showMoreOnNewLine': True}),
            ])
            kepala = grup([judul(esc(js.get('artikel') or 'Artikel Terbaru')),
                           paragraf(f'<a href="{esc_attr(tautan("berita"))}">Lihat semua →</a>')],
                          kelas='vf-kepala-baris', align='wide',
                          layout={'type': 'flex', 'flexWrap': 'wrap', 'justifyContent': 'space-between'})
            return seksi_berlatar([kepala, q(n, 0, 'vf-kartu vf-kartu-ringkas', kartu, grid=n, align='wide')], s)
        return seksi_berlatar([bar('Artikel Terbaru', ('Lihat semua →', tautan('berita'))), q(n, 0, 'vf-kartu', KARTU, grid=n)], s)

    def kontak_seksi(s):
        if s.get('form') and not info.get('tanpa_pemesanan'):
            # Seksi form referensi (judul berwarna + form satu kolom di tengah).
            return seksi_berlatar([kepala_seksi(js.get('pemesanan') or f"Konsultasikan Kebutuhan Anda bersama {sd['nama']}",
                                                js.get('pemesanan_sub') or 'Ceritakan rencana Anda; tim kami akan menghubungi untuk membahas langkah berikutnya.'),
                                   blok_form()], dict(s, jenis='form'))
        return seksi_berlatar([kepala_seksi('Hubungi Kami'), blok('velocity/kontak'), tombol('Hubungi Kami', kontak)], s)

    def ajakan(s):
        anak = ([paragraf_kelas('Hubungi Kami', 'vf-label-seksi')] if s.get('label') else []) + [
                judul(esc(js.get('pemesanan') or 'Siap membantu kebutuhan Anda')),
                paragraf(esc(js.get('pemesanan_sub') or f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
                tombol('Hubungi Kami', kontak)]
        f_ajak = foto.get('tentang') or foto.get('galeri-1') or foto.get('hero')
        if s.get('berdampingan') and f_ajak and 'jumlah' in s:
            # Pita gelap foto | teks (kontraktorhijau.com "Survei Dulu ..."): langkah kerja klien sebagai daftar.
            teks_ajak = [judul(esc(js.get('ajakan') or 'Konsultasi Dulu, Kerjakan Tanpa Ragu')),
                         paragraf(esc(js.get('ajakan_sub') or f"Sebelum pekerjaan dimulai, tim {sd['nama']} membahas kebutuhan Anda:"))]
            if isi.get('alur'):
                teks_ajak.append(daftar_poin([esc(a.get('judul')) for a in isi['alur'][:5]]))
            teks_ajak.append(tombol('Hubungi Kami', kontak))
            return seksi_berlatar([barisan([kolom([gambar(f_ajak, None, '612/685')], '45%'), kolom(teks_ajak)],
                                           kelas='vf-ajakan-terbelah', align='wide')], s)
        # Rencana lama (tanpa kunci label) tetap rata tengah seperti sebelumnya.
        rata = s.get('rata') if 'label' in s else 'tengah'
        return seksi_berlatar(anak, dict(s, rata=rata or 'tengah'), foto.get('galeri-1') or foto.get('tentang') or foto.get('hero'))

    def paket(s):
        # Paket harga referensi -> pilihan layanan tanpa harga/durasi (angka tidak dikarang).
        daftar = [l for l in sd['layanan'] if l.get('rincian')][:3]
        if len(daftar) < 2:
            return ''
        sorot = int(s.get('sorot', -1))
        kartu = []
        for i, l in enumerate(daftar):
            isi_kartu = [judul(esc(l['judul']), 3)]
            if l.get('teks'):
                isi_kartu.append(paragraf(esc(l['teks'])))
            isi_kartu += [paragraf_kelas('Cakupan pekerjaan', 'vf-pilihan__label'), daftar_poin([esc(r) for r in l['rincian'][:6]]),
                          tombol('Hubungi Kami', kontak)]
            kartu.append(grup(isi_kartu, kelas='vf-pilihan' + (' vf-pilihan--sorot' if i == sorot else '')))
        return seksi_berlatar([kepala_seksi(js.get('paket') or 'Pilih Layanan Sesuai Kebutuhan',
                                            js.get('paket_sub') or 'Pilih layanan yang paling sesuai, lalu konsultasikan detailnya bersama tim kami.'),
                               grup(kartu, kelas=f'vf-pilihan-grid vf-kolom-{len(kartu)}', align='wide',
                                    layout={'type': 'grid', 'columnCount': len(kartu), 'minimumColumnWidth': '15rem'})],
                              dict(s, rata='tengah'))

    def angka(s):
        """Seksi kartu bernomor referensi ("01 02 03 ..."). Referensi memberi nomor pada
        alasan/tahapan, bukan statistik: isinya alur kerja klien, jadi tidak ada angka
        capaian yang dikarang."""
        butir = isi.get('alur') or []
        if len(butir) < 3:
            return ''
        n = kolom_ref(s, 3, len(butir))
        kartu = []
        for i, a in enumerate(butir[:max(n * 2, 6)]):
            kartu.append(grup([paragraf_kelas(f'{i + 1:02d}', 'vf-nomor-kartu__angka'),
                               judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))],
                              kelas='vf-nomor-kartu'))
        return seksi_berlatar([kepala_seksi(js.get('alur') or 'Alur Kerja Kami',
                                            js.get('alur_sub') or f"Tahapan kerja {sd['nama']} dari awal sampai selesai."),
                               grup(kartu, kelas=f'vf-nomor-grid vf-kolom-{n}', align='wide',
                                    layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '15rem'})], s)

    def faq(s):
        butir = faq_butir(sd, isi)
        if len(butir) < 3:
            return ''
        return seksi_berlatar([kepala_seksi(js.get('faq') or 'Pertanyaan yang Sering Diajukan',
                                            js.get('faq_sub') or f"Hal yang paling sering ditanyakan seputar layanan {sd['nama']}."),
                               akordeon(butir, 'vf-akordeon-grup vf-faq-grup')], s)

    def testimoni(s):
        """Kartu ulasan. Sumbernya ulasan SUNGGUHAN dari klien (isi['testimoni']); ulasan tidak
        pernah dikarang diam-diam. Manifest `testimoni_contoh=1` (keputusan user per situs,
        sonarmuda99.com 2026-09-20: desain harus sama seperti referensi walau ulasan asli belum
        ada) mengisi slotnya dengan ulasan CONTOH yang ditandai jelas di teks & atribusinya,
        supaya klien/PM tinggal mengganti isinya lewat wp-admin."""
        butir = [t for t in (isi.get('testimoni') or []) if isinstance(t, dict) and t.get('teks')]
        contoh = not butir and info.get('testimoni_contoh')
        if contoh:
            butir = [{'teks': f"Contoh ulasan: kebutuhan {l['judul'].lower()} dibahas lebih dulu, "
                              f"barang ditinjau, lalu penanganannya dilakukan sesuai kesepakatan.",
                      'nama': 'Contoh ulasan pelanggan'} for l in sd['layanan'][:4]]
        if len(butir) < 2:
            return ''
        n = kolom_ref(s, 2, len(butir))
        kartu = [grup([paragraf_kelas(esc(t['teks']), 'vf-ulasan__teks'),
                       paragraf_kelas(esc(t.get('nama') or 'Pelanggan'), 'vf-ulasan__nama')],
                      kelas='vf-ulasan' + (' vf-ulasan--contoh' if contoh else '')) for t in butir[:max(n * 2, 4)]]
        sub = js.get('testimoni_sub') or ''
        if contoh:
            sub = 'Contoh tampilan ulasan — akan diganti dengan ulasan asli pelanggan.'
        return seksi_berlatar([kepala_seksi(js.get('testimoni') or 'Apa Kata Pelanggan Kami', sub),
                               grup(kartu, kelas=f'vf-ulasan-grid vf-kolom-{n}', align='wide',
                                    layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '18rem'})], s)

    def video(s):
        daftar = info.get('video') or []
        if not daftar:
            return ''
        n = kolom_ref(s, min(len(daftar), 4), len(daftar))
        grid = grup([blok_video(v) for v in daftar], kelas=f'vf-video vf-kolom-{n}', align='wide',
                    layout={'type': 'grid', 'columnCount': n, 'minimumColumnWidth': '13rem'})
        return seksi_berlatar([kepala_seksi(js.get('video') or 'Video Kegiatan Kami',
                                            js.get('video_sub') or f"Dokumentasi kegiatan {sd['nama']}."), grid], s)

    pembuat = {'paket': paket, 'hero': hero, 'tentang': tentang, 'layanan': layanan, 'produk': produk, 'keunggulan': keunggulan,
               'alur': alur, 'galeri': galeri, 'klien': klien, 'artikel': artikel, 'kontak': kontak_seksi, 'ajakan': ajakan,
               'video': video, 'angka': angka, 'faq': faq, 'testimoni': testimoni}
    susunan = [dict(s) for s in desain.get('seksi') or []]
    if toko and not any(s['jenis'] == 'produk' and not kategori(s) for s in susunan):
        # Toko online: daftar produk VD Store wajib ada di beranda walau referensi tidak memuatnya.
        letak = next((i + 1 for i, s in enumerate(susunan) if kategori(s)), 1 if susunan and susunan[0]['jenis'] == 'hero' else 0)
        susunan.insert(letak, {'jenis': 'produk', 'latar': 'terang', 'kolom': 4, 'rata': 'tengah', 'judul_referensi': ''})
    if info.get('video') and not any(x['jenis'] == 'video' for x in susunan):
        # Referensi tidak punya seksi video, tetapi videonya milik klien sendiri: ditaruh
        # sesudah galeri (dokumentasi berkumpul), selain itu sebelum seksi penutup.
        letak = next((i + 1 for i, x in enumerate(susunan) if x['jenis'] == 'galeri'), 0)
        if not letak:
            letak = next((i for i, x in enumerate(susunan) if x['jenis'] in ('kontak', 'ajakan')), len(susunan))
        acuan = next((x for x in susunan if x['jenis'] == 'galeri'), {})
        susunan.insert(letak, {'jenis': 'video', 'latar': 'terang' if acuan.get('latar') == 'abu' else 'abu',
                               'kolom': min(len(info['video']), 4), 'rata': acuan.get('rata') or 'tengah',
                               'label': acuan.get('label', '')})
    bagian, dilewati, dipakai = [], [], set()
    for s in susunan:
        kunci = s['jenis'] + (':kategori' if kategori(s) else '')
        if kunci in dipakai and s['jenis'] != 'ajakan':
            continue  # isi yang sama tidak dicetak dua kali (referensi mengulang jenis seksi)
        sekarang['s'] = s
        markup = pembuat[s['jenis']](s) if s['jenis'] in pembuat else ''
        if markup:
            bagian.append(markup)
            dipakai.add(kunci)
        else:
            dilewati.append(s['jenis'])
    if len(bagian) < 3:
        # Referensi yang hampir seluruhnya berisi seksi tanpa data klien: tetap beranda utuh.
        for s in ({'jenis': 'layanan', 'latar': 'terang'}, {'jenis': 'artikel', 'latar': 'terang'},
                  {'jenis': 'ajakan', 'latar': 'gelap'}):
            if s['jenis'] not in dipakai and (markup := pembuat[s['jenis']](s)):
                bagian.append(markup)
    info['dilewati'] = dilewati
    return '\n\n'.join(bagian)


DEALER_DIR = Path(os.environ.get('VELOCITY_FSE_DEALER') or '/var/lib/velocity/fse-dealer')


def dealer_data(domain, sd, isi):
    """Isi beranda dealer mobil. Berkas <DEALER_DIR>/<domain>.json (disusun dari FORM ISIAN,
    katalog/company profile, dan data unit yang dipastikan dealer) didahulukan; tanpa berkas itu
    isi diturunkan dari data AI situs supaya beranda tidak pernah kosong."""
    berkas = DEALER_DIR / f'{domain}.json'
    if domain and berkas.is_file():
        return json.loads(berkas.read_text())
    nama = sd['nama']
    return {
        'hero': {'judul': isi.get('hero_judul') or nama, 'teks': isi.get('hero_teks') or '',
                 'panel_judul': sd.get('slogan') or 'Mobil listrik untuk keseharian Anda',
                 'panel': isi.get('tentang') or ''},
        'intro': {'judul': nama, 'teks': isi.get('tentang') or ''},
        'teknologi': {'judul': 'Teknologi Unggulan',
                      'butir': [{'judul': l.get('judul'), 'ikon': 'kilat'} for l in (sd.get('layanan') or [])[:8]]},
        'keunggulan': {'judul': 'Mengapa Memilih Kami',
                       'butir': [{'judul': k.get('judul'), 'teks': k.get('teks'), 'ikon': 'bintang'}
                                 for k in (isi.get('keunggulan') or [])[:4]]},
    }


def blok_peta(peta):
    """Peta lokasi (core/html + iframe) dari titik hasil scripts/velocity-map (opsi velocity_map).
    Penanda <!-- velocity-map --> sama dengan milik site-finish supaya petanya tidak dobel."""
    if not peta or not peta.get('q'):
        return ''
    src = (f"https://www.google.com/maps?q={urllib.parse.quote(str(peta['q']))}"
           f"&amp;z={int(peta.get('zoom') or 16)}&amp;output=embed")
    return blok('html', None, '<!-- velocity-map -->\n'
                f'<iframe src="{src}" width="100%" height="380" style="border:0" loading="lazy" '
                'title="Peta lokasi"></iframe>')


def galeri_slot(foto, batas=12):
    """core/gallery dari foto slot (vfse_images). Dipakai halaman Galeri situs yang fotonya
    berasal dari installer, bukan kiriman klien."""
    daftar, id_ada = [], set()
    for k in sorted(foto):
        # Beberapa slot bisa menunjuk media yang sama: galeri tidak menampilkannya dua kali.
        if foto.get(k) and foto[k].get('id') not in id_ada:
            id_ada.add(foto[k].get('id'))
            daftar.append(foto[k])
    daftar = daftar[:batas]
    if not daftar:
        return ''
    # Halaman Galeri: tiap foto bisa diklik jadi popup & digeser ke foto berikutnya
    # (permintaan user 2026-09-19).
    anak = '\n\n'.join(gambar(f, None, '4/3', perbesar=True) for f in daftar)
    return blok('gallery', {'columns': 3, 'linkTo': 'none', 'className': 'vf-galeri'},
                '<figure class="wp-block-gallery has-nested-images columns-3 is-cropped vf-galeri">'
                + anak + '</figure>')


def tentang_dealer(sd, isi, info):
    """Halaman Tentang Kami situs dealer, mengikuti halaman "tentang kami" referensi klien:
    foto + teks berdampingan, "Mengapa Memilih Kami" berikon, lalu ajakan menghubungi."""
    d = dealer_data(info.get('domain', ''), sd, isi)
    foto = info.get('foto') or {}
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'
    t = d.get('tentang') or {}

    def dua_warna(teks, level=2):
        bagian = str(teks or '').split('|', 1)
        dalam = esc(bagian[0].strip())
        if len(bagian) > 1 and bagian[1].strip():
            dalam += f' <strong>{esc(bagian[1].strip())}</strong>'
        tag = f'h{level}'
        return blok('heading', {'level': level} if level != 2 else None,
                    f'<{tag} class="wp-block-heading">{dalam}</{tag}>')

    bagian = []
    # 1. Foto + teks berdampingan.
    paragraf_teks = [p for p in (t.get('paragraf') or []) if str(p).strip()]
    if not paragraf_teks:
        ringkas = ringkasan_tentang(sd, info)
        paragraf_teks = [ringkas] if ringkas else []
    kanan = [dua_warna(t.get('judul') or sd['nama'])]
    kanan += [paragraf(esc(x)) for x in paragraf_teks]
    slot = t.get('foto') or 'lineup'
    kiri = [kolom([gambar(foto[slot], 'vf-dealer-tentang__foto', '4/3')], '48%')] if foto.get(slot) else []
    bagian.append(grup([barisan(kiri + [kolom(kanan)], kelas='vf-dealer-tentang', align='wide')],
                       kelas='vf-seksi vf-dealer-tentang__seksi', align='wide'))

    # 2. Mengapa memilih kami (butir yang sama dengan beranda; satu sumber data).
    unggul = d.get('keunggulan') or {}
    butir = [b for b in (unggul.get('butir') or []) if b.get('judul')][:4]
    if butir:
        bagian.append(grup([kepala_seksi(unggul.get('judul') or 'Mengapa Memilih Kami', unggul.get('teks', '')),
                            kotak_ikon(butir, len(butir))],
                           kelas='vf-seksi vf-dealer-unggul vf-rata-tengah', align='wide'))

    # 3. Ajakan menghubungi.
    cta = d.get('cta') or {}
    if cta.get('judul'):
        anak = [dua_warna(cta['judul'])]
        if cta.get('teks'):
            anak.append(paragraf(esc(cta['teks'])))
        anak.append(tombol(cta.get('tombol') or 'Hubungi Kami', kontak))
        bagian.append(grup(anak, kelas='vf-seksi vf-dealer-cta vf-rata-tengah', align='wide'))
    return '\n\n'.join(bagian)


def beranda_dealer(q, sd, isi, info):
    """Beranda dealer mobil mengikuti susunan referensi klien (xpengsurabayaofficial.com):
    hero foto + kartu keterangan, pengantar, kartu model unit (CPT mobil), ubin nilai berfoto,
    foto jajaran unit, teknologi berikon dua kolom, pita promo, keunggulan berikon, kartu
    test drive & simulasi kredit, panel artikel.

    Angka unit (tenaga, torsi, jarak tempuh, harga) TIDAK ditulis di halaman: semuanya dari
    Data Unit di CPT mobil, jadi PM mengubahnya di wp-admin dan halaman tidak perlu disusun ulang."""
    d = dealer_data(info.get('domain', ''), sd, isi)
    foto = info.get('foto') or {}
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'

    def dua_warna(teks, level=2):
        """Judul dua warna seperti referensi ("Teknologi XPENG"): bagian setelah "|" memakai
        warna aksen. <strong> dipakai karena format itu sah di core/heading (span dibuang editor)."""
        bagian = str(teks or '').split('|', 1)
        dalam = esc(bagian[0].strip())
        if len(bagian) > 1 and bagian[1].strip():
            dalam += f' <strong>{esc(bagian[1].strip())}</strong>'
        tag = f'h{level}'
        return blok('heading', {'level': level} if level != 2 else None,
                    f'<{tag} class="wp-block-heading">{dalam}</{tag}>')

    def kepala(teks, sub='', level=2):
        anak = [dua_warna(teks, level)]
        if sub:
            anak.append(paragraf(esc(sub)))
        return grup(anak, kelas='vf-kepala-seksi')

    def tautan(slug):
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    model_url = info['home'] + 'model-unit/'
    test_drive, kredit = tautan('test-drive'), tautan('simulasi-kredit')
    bagian = []

    # 1. Hero: judul besar di kiri, kartu keterangan di kanan (susunan referensi).
    h = d.get('hero') or {}
    teks_hero = []
    if h.get('label'):
        teks_hero.append(paragraf_kelas(esc(h['label']), 'vf-label-seksi'))
    teks_hero.append(dua_warna(h.get('judul') or sd['nama'], 1))
    if h.get('teks'):
        teks_hero.append(paragraf(esc(h['teks'])))
    teks_hero.append(tombol_ganda([('Test Drive', test_drive, False), ('Model Unit', model_url, True)]))
    kartu = []
    if h.get('panel_judul'):
        kartu.append(paragraf_kelas(esc(h['panel_judul']), 'vf-dealer-kartu__judul'))
    if h.get('panel'):
        kartu.append(paragraf(esc(h['panel'])))
    isi_hero = [barisan([kolom(teks_hero, '58%')] + ([kolom([grup(kartu, kelas='vf-dealer-kartu')])] if kartu else []),
                        kelas='vf-dealer-hero__baris', align='wide')]
    if foto.get('hero'):
        bagian.append(sampul(foto['hero'], isi_hero, 'vf-dealer-hero', 60, 620))
    else:
        bagian.append(grup(isi_hero, kelas='vf-dealer-hero vf-dealer-hero--polos', align='full', latar='primary',
                           teks='di-primary', padding='var:preset|spacing|70', layout={'type': 'constrained'}))

    # 2. Pengantar di tengah.
    intro = d.get('intro') or {}
    if intro.get('judul') or intro.get('teks'):
        bagian.append(grup([kepala(intro.get('judul') or sd['nama'], intro.get('teks', ''))],
                           kelas='vf-seksi vf-dealer-intro vf-rata-tengah', align='wide'))

    # 3. Model unit: satu kartu per unit dari CPT mobil (blok velocity/mobil-kartu).
    model = d.get('model') or {}
    bagian.append(grup([
        kepala(model.get('judul') or 'Model Unit', model.get('teks', '')),
        # Urutan unit ditentukan kolom "Urutan" WordPress (menu_order), bukan tanggal buat.
        q(model.get('jumlah') or 6, 0, 'vf-dealer-model', blok('velocity/mobil-kartu'), jenis='mobil',
          urut='menu_order', arah='asc'),
        tombol('Lihat Semua Model', model_url),
    ], kelas='vf-seksi vf-dealer-model__seksi', align='wide'))

    # 4. Ubin nilai berfoto (tiga ubin di referensi).
    nilai = [n for n in (d.get('nilai') or []) if n.get('judul')][:3]
    if nilai:
        ubin = []
        for i, n in enumerate(nilai, 1):
            teks_ubin = [judul(esc(n['judul']), 3)]
            if n.get('teks'):
                teks_ubin.append(paragraf(esc(n['teks'])))
            anak = ([gambar(foto[f'nilai-{i}'], 'vf-nilai__foto', '4/3')] if foto.get(f'nilai-{i}') else [])
            ubin.append(grup(anak + [grup(teks_ubin, kelas='vf-nilai__teks')], kelas='vf-nilai__ubin'))
        bagian.append(grup(ubin, kelas='vf-nilai', align='full',
                           layout={'type': 'grid', 'columnCount': len(ubin), 'minimumColumnWidth': '16rem'}))

    # 5. Foto jajaran unit selebar isi.
    if foto.get('lineup'):
        bagian.append(grup([gambar(foto['lineup'], 'vf-dealer-lineup__foto', '21/9')],
                           kelas='vf-seksi vf-dealer-lineup', align='wide'))

    # 6. Teknologi: daftar berikon dua kolom.
    tek = d.get('teknologi') or {}
    butir_tek = [b for b in (tek.get('butir') or []) if b.get('judul')][:8]
    if butir_tek:
        bagian.append(grup([kepala(tek.get('judul') or 'Teknologi', tek.get('teks', '')),
                            kotak_ikon(butir_tek, 2)],
                           kelas='vf-seksi vf-dealer-teknologi vf-rata-tengah', align='wide'))

    # 7. Pita promo berfoto + ajakan hubungi.
    promo = d.get('promo') or {}
    if promo.get('judul'):
        anak = [dua_warna(promo['judul'])]
        if promo.get('teks'):
            anak.append(paragraf(esc(promo['teks'])))
        anak.append(tombol_ganda([('Hubungi Kami', kontak, False), ('Simulasi Kredit', kredit, True)]))
        if foto.get('promo'):
            bagian.append(sampul(foto['promo'], anak, 'vf-dealer-promo', 70, 420))
        else:
            bagian.append(grup(anak, kelas='vf-dealer-promo vf-pita vf-pita--gelap', align='full', latar='primary',
                               teks='di-primary', padding='var:preset|spacing|60', layout={'type': 'constrained'}))

    # 8. Keunggulan dealer berikon.
    unggul = d.get('keunggulan') or {}
    butir_unggul = [b for b in (unggul.get('butir') or []) if b.get('judul')][:4]
    if butir_unggul:
        bagian.append(grup([kepala(unggul.get('judul') or 'Mengapa Memilih Kami', unggul.get('teks', '')),
                            kotak_ikon(butir_unggul, len(butir_unggul))],
                           kelas='vf-seksi vf-dealer-unggul vf-rata-tengah', align='wide'))

    # 9. Dua kartu layanan: test drive & simulasi kredit (seperti referensi).
    kartu_layanan = []
    for l in (d.get('layanan') or [{'judul': 'Test Drive', 'url': 'test-drive', 'tombol': 'Jadwalkan Test Drive'},
                                   {'judul': 'Simulasi Kredit', 'url': 'simulasi-kredit', 'tombol': 'Hitung Simulasi Kredit'}]):
        url = tautan(l.get('url') or 'hubungi-kami')
        anak = [judul(esc(l['judul']), 3)]
        if l.get('teks'):
            anak.append(paragraf(esc(l['teks'])))
        anak.append(tombol(l.get('tombol') or 'Selengkapnya', url))
        kartu_layanan.append(kolom([grup(anak, kelas='vf-dealer-layanan__kartu vf-ikon--' + (l.get('ikon') or 'kilat'))]))
    bagian.append(grup([barisan(kartu_layanan, kelas='vf-dealer-layanan', align='wide')],
                       kelas='vf-seksi', align='wide'))

    # 10. Panel artikel + kartu tulisan terbaru.
    panel = [dua_warna((d.get('artikel') or {}).get('judul') or 'Info Terbaru')]
    if (d.get('artikel') or {}).get('teks'):
        panel.append(paragraf(esc(d['artikel']['teks'])))
    panel.append(blok('search', {'label': 'Cari', 'showLabel': False, 'placeholder': 'Temukan info…',
                                 'buttonText': 'Cari', 'buttonPosition': 'button-outside', 'buttonUseIcon': True,
                                 'className': 'vf-dealer-cari'}))
    bagian.append(grup([grup(panel, kelas='vf-dealer-panel'),
                        q(3, 0, 'vf-kartu vf-dealer-artikel', KARTU, grid=3),
                        tombol('Semua Artikel', tautan('berita'))],
                       kelas='vf-seksi vf-dealer-info', align='wide'))
    return '\n\n'.join(bagian)


KLINIK_DIR = Path(os.environ.get('VELOCITY_FSE_KLINIK') or '/var/lib/velocity/fse-klinik')


def klinik_berkas(domain):
    """Isi <KLINIK_DIR>/<domain>.json, atau {} bila tidak ada/rusak."""
    try:
        return json.loads((KLINIK_DIR / f'{domain}.json').read_text()) if domain else {}
    except (OSError, ValueError):
        return {}


def klinik_data(domain, sd, isi):
    """Isi beranda gaya klinik. Berkas <KLINIK_DIR>/<domain>.json (teks dari mockup desain klien)
    didahulukan; tanpa berkas itu isi diturunkan dari data AI situs supaya beranda tidak kosong."""
    berkas = klinik_berkas(domain)
    if berkas.get('hero'):
        return berkas
    js = isi.get('judul_seksi') or {}
    return {
        'hero': {'label': sd.get('slogan', ''), 'judul': isi.get('hero_judul') or sd['nama'],
                 'teks': isi.get('hero_teks') or '',
                 'tombol': [['Hubungi Kami', 'hubungi-kami', False], ['Layanan Kami', 'layanan', True]]},
        'tentang': {'label': js.get('tentang') or 'Tentang Kami', 'judul': sd['nama'], 'teks': sd.get('tentang', ''),
                    'tautan': ['Selengkapnya', 'tentang-kami']},
        'solusi': {'label': 'Layanan', 'judul': js.get('layanan') or 'Layanan Kami', 'teks': js.get('layanan_sub', ''),
                   'tautan': ['Semua Layanan', 'layanan'],
                   'butir': [{'judul': l['judul'], 'teks': l.get('teks', '')} for l in sd['layanan'][:5]]},
        'unggul': {'label': 'Keunggulan', 'judul': js.get('keunggulan') or 'Mengapa Memilih Kami',
                   'poin': [{'judul': k.get('judul'), 'teks': k.get('teks')} for k in (isi.get('keunggulan') or [])[:4]]},
        'artikel': {'label': 'Artikel', 'judul': 'Artikel Terbaru', 'tautan': ['Lihat Semua', 'berita']},
        'cta': {'label': 'Hubungi Kami', 'judul': js.get('pemesanan') or 'Siap membantu kebutuhan Anda',
                'teks': js.get('pemesanan_sub', ''), 'tombol': ['Hubungi Kami', 'hubungi-kami']},
    }


def beranda_klinik(q, sd, isi, info):
    """Beranda pengembang & pengelola klinik mengikuti mockup desain klien medikaklinikteknologi.com:
    hero foto berpudar putih, who we are + 3 poin + foto, 5 kartu solusi, kisah (foto kiri),
    kemitraan (foto kanan), keunggulan 4 poin + foto, kartu artikel terbaru, pita ajakan navy.

    Kontak di pita ajakan hanya dari Data Situs (WA/telepon/email publik) — nomor di mockup contoh."""
    d = klinik_data(info.get('domain', ''), sd, isi)
    foto = info.get('foto') or {}

    def tautan(slug):
        if re.match(r'^(https?:|/|#|mailto:)', str(slug)):
            return slug
        return ((info['halaman'].get(slug) or {}).get('url') or (info['semua'].get(slug) or {}).get('url')
                or f"{info['home']}{slug}/")

    def baris_judul(teks):
        return '<br>'.join(esc(b.strip()) for b in str(teks or '').split('\n') if b.strip())

    def kepala(s, level=2):
        anak = [paragraf_kelas(esc(s['label']), 'vf-label-seksi')] if s.get('label') else []
        anak.append(judul(baris_judul(s.get('judul')), level))
        if s.get('sub'):
            anak.append(paragraf_kelas(esc(s['sub']), 'vf-klinik-sub'))
        if s.get('teks'):
            anak.append(paragraf(esc(s['teks'])))
        return anak

    def tautan_panah(pasangan):
        label, slug = pasangan
        return paragraf_kelas(f'<a href="{esc_attr(tautan(slug))}">{esc(label)}</a>', 'vf-klinik-tautan')

    def poin(daftar, kelas):
        return [grup([judul(esc(p.get('judul')), 3)] + ([paragraf(esc(p['teks']))] if p.get('teks') else []),
                     kelas=f"{kelas} vf-ikon--{re.sub(r'[^a-z]', '', str(p.get('ikon') or '')) or 'satu'}")
                for p in daftar if p.get('judul')]

    def pita(anak, kelas):
        return grup(anak, kelas=f'vf-klinik-pita {kelas}', align='full', layout={'type': 'constrained'})

    def berdampingan(teks, slot, kiri, kelas):
        gbr = [kolom([gambar(foto[slot], 'vf-klinik-foto', '16/10')], '52%')] if foto.get(slot) else []
        kol = gbr + [kolom(teks)] if kiri else [kolom(teks)] + gbr
        return barisan(kol, kelas=f'vf-klinik-dua {kelas}', align='wide')

    bagian = []

    # 1. Hero: foto selebar layar, teks di kiri di atas pudaran putih.
    h = d.get('hero') or {}
    teks_hero = []
    if h.get('label'):
        teks_hero.append(paragraf_kelas(esc(h['label']), 'vf-label-seksi'))
    teks_hero.append(judul(baris_judul(h.get('judul') or sd['nama']), 1))
    if h.get('sub'):
        teks_hero.append(paragraf_kelas(esc(h['sub']), 'vf-klinik-sub'))
    if h.get('teks'):
        teks_hero.append(paragraf(esc(h['teks'])))
    if h.get('tombol'):
        teks_hero.append(tombol_ganda([(l, tautan(s), g) for l, s, g in h['tombol']]))
    isi_hero = [grup(teks_hero, kelas='vf-klinik-hero__teks')]
    if foto.get('klinik-hero'):
        f = foto['klinik-hero']
        bagian.append(blok('cover', {
            'url': f['url'], 'id': int(f['id']), 'dimRatio': 0, 'isUserOverlayColor': True, 'focalPoint': {'x': 0.75, 'y': 0.5},
            'minHeight': 560, 'minHeightUnit': 'px', 'isDark': False, 'align': 'full', 'className': 'vf-klinik-hero',
            'layout': {'type': 'constrained'}},
            f'<div class="wp-block-cover alignfull is-light vf-klinik-hero" style="min-height:560px">'
            f'<img class="wp-block-cover__image-background wp-image-{int(f["id"])}" alt="" src="{esc_attr(f["url"])}" '
            'style="object-position:75% 50%" data-object-fit="cover" data-object-position="75% 50%"/>'
            '<span aria-hidden="true" class="wp-block-cover__background has-background-dim-0 has-background-dim"></span>'
            '<div class="wp-block-cover__inner-container">' + '\n\n'.join(isi_hero) + '</div></div>'))
    else:
        bagian.append(grup(isi_hero, kelas='vf-klinik-hero vf-klinik-hero--polos', align='full',
                           padding='var:preset|spacing|70', layout={'type': 'constrained'}))

    # 2. Who we are: teks, tiga poin berikon, foto.
    t = d.get('tentang') or {}
    kiri = kepala(t) + ([tautan_panah(t['tautan'])] if t.get('tautan') else [])
    kol = [kolom(kiri, '36%')]
    butir = poin(t.get('poin') or [], 'vf-klinik-poin')
    if butir:
        kol.append(kolom([grup(butir, kelas='vf-klinik-poin__grid',
                               layout={'type': 'grid', 'columnCount': len(butir), 'minimumColumnWidth': '8rem'})]))
    if foto.get('klinik-tentang'):
        kol.append(kolom([gambar(foto['klinik-tentang'], 'vf-klinik-foto', '5/4')], '26%'))
    if t.get('judul') or t.get('teks'):
        bagian.append(grup([barisan(kol, kelas='vf-klinik-tentang', align='wide')], kelas='vf-klinik-seksi', align='wide'))

    # 3. Solusi: kepala + tautan sebaris, lima kartu berikon.
    s = d.get('solusi') or {}
    kartu = poin(s.get('butir') or [], 'vf-klinik-kartu')
    if kartu:
        kepala_baris = [grup(kepala(s), kelas='vf-klinik-kepala')]
        if s.get('tautan'):
            kepala_baris.append(tautan_panah(s['tautan']))
        bagian.append(pita([
            grup(kepala_baris, kelas='vf-klinik-kepala-baris', align='wide',
                 layout={'type': 'flex', 'flexWrap': 'wrap', 'justifyContent': 'space-between', 'verticalAlignment': 'bottom'}),
            grup(kartu, kelas='vf-klinik-kartu__grid', align='wide',
                 layout={'type': 'grid', 'columnCount': min(len(kartu), 5), 'minimumColumnWidth': '11rem'}),
        ], 'vf-klinik-solusi'))

    # 4. Kisah (foto kiri) dan 5. kemitraan (foto kanan, pita muda).
    k = d.get('kisah') or {}
    if k.get('judul'):
        teks = kepala(k) + ([tombol(k['tombol'][0], tautan(k['tombol'][1]))] if k.get('tombol') else [])
        bagian.append(grup([berdampingan(teks, 'klinik-kisah', True, 'vf-klinik-kisah')], kelas='vf-klinik-seksi', align='wide'))
    m = d.get('mitra') or {}
    if m.get('judul'):
        teks = kepala(m) + ([tombol(m['tombol'][0], tautan(m['tombol'][1]))] if m.get('tombol') else [])
        bagian.append(pita([berdampingan(teks, 'klinik-mitra', False, 'vf-klinik-mitra')], 'vf-klinik-pita--muda'))

    # 6. Keunggulan: teks + empat poin berikon, foto di kanan.
    u = d.get('unggul') or {}
    butir = poin(u.get('poin') or [], 'vf-klinik-poin')
    if butir:
        panjang = any(len(str(p.get('teks') or '')) > 60 for p in u.get('poin') or [])
        teks = kepala(u) + [grup(butir, kelas='vf-klinik-poin__grid' + (' vf-klinik-poin__grid--panjang' if panjang else ''),
                                 layout={'type': 'grid', 'columnCount': len(butir), 'minimumColumnWidth': '8rem'})]
        bagian.append(pita([berdampingan(teks, 'klinik-unggul', False, 'vf-klinik-unggul')], 'vf-klinik-unggul__pita'))

    # 7. Artikel terbaru.
    a = d.get('artikel') or {}
    kepala_baris = [grup(kepala(a), kelas='vf-klinik-kepala')]
    if a.get('tautan'):
        kepala_baris.append(tautan_panah(a['tautan']))
    bagian.append(grup([
        grup(kepala_baris, kelas='vf-klinik-kepala-baris', align='wide',
             layout={'type': 'flex', 'flexWrap': 'wrap', 'justifyContent': 'space-between', 'verticalAlignment': 'bottom'}),
        q(3, 0, 'vf-kartu vf-klinik-artikel', KARTU, grid=3),
    ], kelas='vf-klinik-seksi', align='wide'))

    # 8. Pita ajakan navy: teks kiri, tombol + kontak Data Situs di kanan.
    c = d.get('cta') or {}
    kanan = [tombol(c['tombol'][0], tautan(c['tombol'][1]))] if c.get('tombol') else []
    kontak = []
    wa = re.sub(r'\D', '', sd.get('wa') or '')
    if wa:
        wa = '62' + wa[1:] if wa.startswith('0') else wa
        kontak.append(f'<a class="vf-klinik-kontak__wa" href="https://wa.me/{wa}">{esc(sd.get("telp") or sd["wa"])}</a>')
    elif sd.get('telp'):
        kontak.append(f'<a class="vf-klinik-kontak__telp" href="tel:{esc_attr(re.sub(r"[^0-9+]", "", sd["telp"]))}">{esc(sd["telp"])}</a>')
    if sd.get('email_publik'):
        kontak.append(f'<a class="vf-klinik-kontak__email" href="mailto:{esc_attr(sd["email_publik"])}">{esc(sd["email_publik"])}</a>')
    if kontak:
        kanan.append(paragraf_kelas(' '.join(kontak), 'vf-klinik-kontak'))
    kol = [kolom(kepala(c))] + ([kolom(kanan, '42%')] if kanan else [])
    bagian.append(grup([barisan(kol, kelas='vf-klinik-cta__baris', align='wide')], kelas='vf-klinik-cta', align='full',
                       latar='primary', teks='di-primary', padding='var:preset|spacing|60', layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


def beranda_perusahaan(q, sd, isi, info):
    if sd.get('gaya') == 'referensi' and info.get('desain'):
        return beranda_referensi(q, sd, isi, info)
    if sd.get('gaya') == 'katalog':
        return beranda_katalog(q, sd, isi, info)
    if sd.get('gaya') in ('korporat', 'terbelah'):
        return beranda_perusahaan_foto(q, sd, isi, info, sd['gaya'])
    js = isi.get('judul_seksi') or {}
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url') or info['home'] + 'hubungi-kami/'
    hero = [judul(esc(isi.get('hero_judul') or sd['nama']), 1)]
    if isi.get('hero_teks'):
        hero.append(paragraf(esc(isi['hero_teks'])))
    if isi.get('hero_poin'):
        hero.append(daftar_poin([esc(p) for p in isi['hero_poin']], kelas='vf-hero__poin'))
    hero.append(tombol('Hubungi Kami', kontak))
    bagian = [grup(hero, kelas='vf-hero', align='full', teks='di-primary', padding='var:preset|spacing|70',
                   layout={'type': 'constrained'})]
    if sd['layanan']:
        anak = [judul(esc(js.get('layanan') or 'Layanan Kami'))]
        if js.get('layanan_sub'):
            anak.append(paragraf(esc(js['layanan_sub'])))
        bagian.append(grup(anak + kartu_isi(sd['layanan']), kelas='vf-seksi', align='wide', padding='var:preset|spacing|50'))
    if isi.get('keunggulan'):
        bagian.append(grup([judul(esc(js.get('keunggulan') or 'Mengapa Memilih Kami'))] + kartu_isi(isi['keunggulan']),
                           kelas='vf-seksi', align='wide'))
    if isi.get('alur'):
        langkah = [kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))]) for a in isi['alur'][:5]]
        bagian.append(grup([judul('Alur Kerja'), barisan(langkah, kelas='vf-langkah')], kelas='vf-seksi', align='wide'))
    arsip = (info['halaman'].get('berita') or {}).get('url') or info['home'] + 'berita/'
    bagian.append(grup([bar('Artikel Terbaru', ('Lihat semua →', arsip)), q(3, 0, 'vf-kartu', KARTU, grid=3)],
                       kelas='vf-seksi', align='wide'))
    bagian.append(grup([judul('Siap membantu kebutuhan Anda'),
                        paragraf(esc(f"Ceritakan kebutuhan Anda, tim {sd['nama']} akan segera menghubungi kembali.")),
                        tombol('Hubungi Kami', kontak)],
                       kelas='vf-ajakan', align='wide', teks='di-primary', latar='primary', padding='var:preset|spacing|50',
                       layout={'type': 'constrained'}))
    return '\n\n'.join(bagian)


def halaman_redaksi(sd, isi, info):
    kepala = f"<strong>{esc(sd['nama'])}</strong>" + (f"<br><em>{esc(sd['slogan'])}</em>" if sd['slogan'] else '')
    anak = [paragraf(kepala)]
    if sd['tentang']:
        anak.append(paragraf(esc(sd['tentang'])))
    pedoman = [p for p in isi.get('redaksi') or [] if str(p).strip()]
    if pedoman:
        anak.append(judul('Pedoman Redaksi'))
        anak += [paragraf(esc(p)) for p in pedoman]
    # Nama awak redaksi tidak dikarang: dilengkapi PM bila klien mengirimnya.
    anak += [judul('Kontak Redaksi'), blok('velocity/kontak')]
    kontak = (info['halaman'].get('hubungi-kami') or {}).get('url')
    if kontak:
        anak.append(paragraf(f'<a href="{esc_attr(kontak)}">Kirim pesan ke redaksi →</a>'))
    return '\n\n'.join(anak)


def profil_perusahaan(isi):
    """Data company profile di Tentang Kami (keputusan user 2026-09-13: semua kiriman klien tampil)."""
    anak, topik = [], []
    if isi.get('visi') or isi.get('misi'):
        topik.append(TOPIK_PROFIL['visi'])
        anak.append(judul('Visi &amp; Misi'))
        if isi.get('visi'):
            anak.append(paragraf(f"<strong>Visi:</strong> {esc(isi['visi'])}"))
        if isi.get('misi'):
            anak += [paragraf('<strong>Misi:</strong>'), daftar_poin([esc(m) for m in isi['misi']])]
    if isi.get('struktur'):
        topik.append(TOPIK_PROFIL['struktur'])
        anak += [judul('Struktur Organisasi'),
                 daftar_poin([f"<strong>{esc(s.get('jabatan'))}</strong>: {esc(s.get('nama'))}" for s in isi['struktur']])]
    if isi.get('customer'):
        topik.append(TOPIK_PROFIL['customer'])
        anak += [judul('Pelanggan Kami'), daftar_poin([esc(c if isinstance(c, str) else c.get('nama', '')) for c in isi['customer']])]
    if isi.get('legalitas'):
        topik.append(TOPIK_PROFIL['legalitas'])
        anak += [judul('Legalitas'),
                 daftar_poin([f"<strong>{esc(l.get('label'))}</strong>: {esc(l.get('nilai'))}" for l in isi['legalitas']])]
    return (grup(anak, kelas='vf-profil') if anak else ''), topik


def milik_installer(hal):
    """Boleh ditimpa: kosong/placeholder, atau isinya masih persis tulisan installer."""
    isi = hal['isi']
    if not isi.strip() or isi.strip() in PLACEHOLDER:
        return True
    if hal['fse_md5']:
        return hal['fse_md5'] == md5(isi)
    bersih = SHORTCODE_LAMA.sub('', isi)
    for j in JUDUL_LAMA:
        bersih = bersih.replace(j, '')
    if not bersih.strip():
        return True
    # Halaman paket-g-setup: pembuka baku + shortcode child (yang sudah dibuang di atas).
    sisa = bersih
    for p in PEMBUKA_LAMA:
        sisa = sisa.replace(p, '')
    if bersih != isi and not sisa.strip():
        return True
    # _velocity_content_md5 dari generator AI/site-finish = md5 keluaran WP-CLI (isi + "\n").
    return bool(hal['isi_md5']) and hal['isi_md5'] in (md5(isi), md5(isi + '\n'), md5(bersih), md5(bersih + '\n'))


