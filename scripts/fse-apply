LABEL_MENU_BAKU = {'beranda': 'Beranda', 'tentang-kami': 'Tentang Kami', 'layanan': 'Layanan',
                   'produk': 'Produk', 'galeri': 'Galeri', 'berita': 'Berita', 'faq': 'FAQ',
                   'hubungi-kami': 'Hubungi Kami'}
LABEL_MENU_INGGRIS = {'home', 'homepage', 'about', 'about us', 'company', 'who we are', 'profile',
                      'services', 'service', 'solutions', 'products', 'product', 'shop', 'store',
                      'gallery', 'portfolio', 'projects', 'news', 'blog', 'articles', 'insights',
                      'contact', 'contact us', 'get in touch'}


# Seksi beranda -> id jangkar untuk menu situs satu halaman (landing page). Nilainya
# dipakai sebagai id HTML sekaligus atribut `anchor` blok, jadi harus slug sederhana.
JANGKAR_SEKSI = {'tentang': ('tentang', 'Tentang'), 'angka': ('alur', 'Alur Kerja'),
                 'layanan': ('layanan', 'Layanan'), 'keunggulan': ('keunggulan', 'Keunggulan'),
                 'paket': ('pilihan', 'Pilihan Layanan'), 'produk': ('produk', 'Produk'),
                 'galeri': ('galeri', 'Galeri'), 'video': ('video', 'Video'),
                 'testimoni': ('ulasan', 'Ulasan'), 'faq': ('faq', 'FAQ'),
                 'kontak': ('kontak', 'Kontak')}
BLOK_SEKSI = re.compile(r'<!-- wp:(group|cover) (\{.*\}) -->\n<(div)\b')
KELAS_SEKSI = re.compile(r'vf-ref-([a-z]+)\b')
JUDUL_SEKSI_RE = re.compile(r'<h2[^>]*>(.*?)</h2>', re.S)


def beri_jangkar(markup):
    """Sisipkan id jangkar di seksi beranda (dipakai menu landing page).

    Berlaku untuk markup generator maupun halaman buatan agen desain: keduanya memakai
    kelas `vf-ref-<jenis>` pada blok seksi teratas. Mengembalikan (markup, [(id, label)]).
    Blok yang sudah punya anchor dibiarkan apa adanya."""
    hasil, jangkar, dipakai, pos = [], [], set(), 0
    for m in BLOK_SEKSI.finditer(markup):
        try:
            attrs = json.loads(m.group(2))
        except ValueError:
            continue
        # Kelas seksi selalu diawali `vf-ref-seksi`, jenisnya menyusul (vf-ref-tentang, dst.).
        kunci = next((JANGKAR_SEKSI[j] for j in KELAS_SEKSI.findall(str(attrs.get('className') or ''))
                      if j in JANGKAR_SEKSI), None)
        if not kunci or kunci[0] in dipakai or attrs.get('anchor'):
            continue
        # Judul seksi jadi label menu; tanpa judul memakai label baku.
        ekor = markup[m.end():m.end() + 4000]
        judul_teks = JUDUL_SEKSI_RE.search(ekor)
        label = re.sub(r'<[^>]+>', '', judul_teks.group(1)).strip() if judul_teks else ''
        label = re.sub(r'\s+', ' ', label)
        dipakai.add(kunci[0])
        jangkar.append((kunci[0], kunci[1], label))
        attrs['anchor'] = kunci[0]
        hasil.append(markup[pos:m.start()])
        hasil.append(f'<!-- wp:{m.group(1)} {atribut(attrs)} -->\n<div id="{kunci[0]}"')
        pos = m.end()
    hasil.append(markup[pos:])
    return ''.join(hasil), jangkar


def satu_halaman(info):
    """Referensi berupa situs SATU HALAMAN (landing page): menunya menggulir ke seksi
    beranda, bukan pindah halaman — habercafeandresto.co.id 2026-09-20 (`/faq/` di sana
    404). Ditandai kalau sebagian besar butir menu referensi menunjuk beranda."""
    desain = info.get('desain') or {}
    pohon = desain.get('menu') or []
    if len(pohon) < 4:
        return False
    beranda = sum(1 for m in pohon if (m.get('jenis') or '') == 'beranda')
    return beranda >= 3 and not (desain.get('halaman') or {})


def menu_jangkar(info, sd):
    """Menu landing page: Beranda + satu butir per seksi beranda (tautan #jangkar).
    Halaman yang tidak punya seksi di beranda (mis. Produk) tetap ikut sebagai halaman."""
    jangkar = info.get('jangkar') or []
    if len(jangkar) < 3:
        return ''
    semua = info['semua']
    ada = {j[0] for j in jangkar}
    # Halaman katalog Produk tidak punya seksi di beranda, tapi tetap perlu di menu.
    halaman_produk = ('produk' not in ada and 'produk' in semua
                      and 'produk' not in (info.get('tanpa_halaman') or ()))
    # Sepanjang menu referensi; kalau kepanjangan, seksi pendukung dibuang lebih dulu
    # dan Kontak (seksi terakhir) tidak pernah hilang.
    batas = max(6, len(info.get('desain', {}).get('menu') or [])) - (1 if halaman_produk else 0)
    dipilih = list(jangkar)
    for kurang in ('pilihan', 'keunggulan', 'alur', 'video', 'ulasan'):
        if len(dipilih) + 1 <= batas:
            break
        dipilih = [j for j in dipilih if j[0] != kurang] or dipilih
    butir = [{'label': 'Beranda', 'url': info['home'], 'kind': 'custom', 'isTopLevelLink': True}]
    for slug, baku, judul in dipilih[:max(1, batas - 1)]:
        # Judul seksi yang pendek lebih enak dibaca di menu daripada label baku.
        label = judul if judul and len(judul) <= 14 else baku
        butir.append({'label': label, 'url': f"{info['home']}#{slug}", 'kind': 'custom', 'isTopLevelLink': True})
    if halaman_produk:
        butir.insert(min(4, len(butir)), {'label': 'Produk', 'type': 'page', 'id': semua['produk']['id'],
                                          'url': semua['produk']['url'], 'kind': 'post-type'})
    # Halaman tulisan (blog) tidak punya seksi di beranda; tautannya ditaruh sebelum Kontak
    # supaya pengunjung tetap bisa membuka daftar artikel dari menu utama.
    if 'berita' in semua and 'berita' not in (info.get('tanpa_halaman') or ()):
        letak = next((i for i, x in enumerate(butir)
                      if isinstance(x, dict) and str(x.get('url', '')).endswith('#kontak')), len(butir))
        butir.insert(letak, {'label': 'Blog', 'type': 'page', 'id': semua['berita']['id'],
                             'url': semua['berita']['url'], 'kind': 'post-type'})
    return '\n\n'.join(blok('navigation-link', b) if isinstance(b, dict) else b for b in butir)


def menu_referensi(info, sd):
    """Menu mengikuti pohon menu web referensi (rencana VERSI 5), atau '' bila tidak berlaku.

    jasakontraktorindo.com (2026-09-17): klien menulis "susunan menu contoh seperti
    kontraktorhijau.com" -> Profil, Layanan (submenu per layanan), Portofolio, Blog (submenu
    kategori), FAQ, Kontak. Label dari referensi (kata umum), halaman milik situs klien."""
    desain = info.get('desain') or {}
    pohon = desain.get('menu') or []
    if int(desain.get('versi') or 0) < 5 or len(pohon) < 3 or sd['jenis'] == 'berita' or sd.get('gaya') != 'referensi':
        return ''
    # Menu yang sudah diatur manusia lewat manifest (label_menu / tanpa_halaman, yukpergimancing.com)
    # tetap memakai susunan bawaan tautan_menu, tidak digeser menu referensi.
    if info.get('label_menu') or info.get('tanpa_halaman_manifest'):
        return ''
    semua = info['semua']
    slug_jenis = {'beranda': 'beranda', 'tentang': 'tentang-kami', 'layanan': 'layanan', 'produk': 'produk',
                  'galeri': 'galeri', 'artikel': 'berita', 'faq': 'faq', 'kontak': 'hubungi-kami'}
    tanpa = set(info.get('tanpa_halaman') or ())
    label_menu = info.get('label_menu') or {}

    def halaman(slug, label):
        if slug not in semua or slug in tanpa:
            return None
        return {'label': label_menu.get(slug, label), 'type': 'page', 'id': semua[slug]['id'], 'url': semua[slug]['url'],
                'kind': 'post-type'}

    butir, dipakai = [], set()
    for m in pohon:
        slug = slug_jenis.get(m.get('jenis') or '')
        if not slug or slug in dipakai:
            continue
        label = re.sub(r'\s+', ' ', m.get('label') or '').strip()[:30]
        # "PROFIL" -> "Profil", singkatan pendek (FAQ) tetap huruf besar.
        label = (label if re.fullmatch(r'[A-Z]{2,4}', label) else label.title()) or slug.replace('-', ' ').title()
        # Referensi berbahasa Inggris: labelnya tidak boleh ikut ke situs klien yang
        # berbahasa Indonesia (solusicerdasconsulting.com, 2026-09-18 — menunya
        # terbaca "Home / Services / Company / Contact"). Susunan referensi tetap
        # dipakai, hanya kata-katanya yang dikembalikan ke label baku.
        if label.lower() in LABEL_MENU_INGGRIS:
            label = LABEL_MENU_BAKU.get(slug, label)
        if slug == 'produk' and info.get('toko'):
            butir.append(menu_produk(info, label))
            dipakai.add(slug)
            continue
        dasar = halaman(slug, label)
        if not dasar:
            continue
        anak = []
        if slug == 'layanan' and m.get('anak'):
            anak = [blok('navigation-link', h) for h in (halaman(a, l['judul']) for a, l in
                                                          ((slug_teks(l['judul']), l) for l in sd['layanan'])) if h]
        elif slug == 'berita' and m.get('anak'):
            anak = [blok('navigation-link', {'label': k['nama'], 'type': 'category', 'id': k['id'], 'url': k['url'],
                                             'kind': 'taxonomy'}) for k in info.get('kategori_isi') or []]
        butir.append(blok('navigation-submenu', dasar, '\n\n'.join(anak)) if anak else dasar)
        dipakai.add(slug)
    # Halaman situs yang tidak punya padanan di menu referensi tetap harus bisa dibuka
    # dari menu utama (permintaan user 2026-09-18): referensi northseaaconsulting.com
    # punya "Locations"/"Resources" yang tidak cocok, sehingga Produk, Galeri, Berita,
    # dan Pemesanan sempat tidak pernah masuk menu.
    for slug in ('produk', 'galeri', 'berita', 'pemesanan'):
        if slug in dipakai or slug in tanpa:
            continue
        tambahan = halaman(slug, LABEL_MENU_BAKU.get(slug, slug.replace('-', ' ').title()))
        if tambahan:
            butir.append(tambahan)
            dipakai.add(slug)
    if 'hubungi-kami' not in dipakai and (h := halaman('hubungi-kami', 'Kontak')):
        butir.append(h)
    if len(butir) < 3:
        return ''
    return '\n\n'.join(b if isinstance(b, str) else blok('navigation-link', b) for b in butir)


PHP_KATEGORI_ISI = r'''
$kat = array();
foreach (get_categories(array('hide_empty' => true)) as $t) {
    if ($t->slug === 'uncategorized') { continue; }
    $kat[] = array('id' => (int) $t->term_id, 'nama' => html_entity_decode($t->name), 'url' => get_category_link($t->term_id));
}
vfse_keluar(array('kategori' => $kat));
'''


def halaman_menu_referensi(desain, sd, isi):
    """{slug: (judul, markup)} halaman yang dituntut menu referensi: anak per layanan & FAQ.

    Isi hanya dari data klien (layanan, rincian, alur, area, kontak) — FAQ disusun dari fakta
    itu, bukan pertanyaan karangan. Tanpa rencana VERSI 5 / tanpa menu terkait = {}."""
    desain = desain or {}
    pohon = desain.get('menu') or []
    if int(desain.get('versi') or 0) < 5:
        return {}
    hasil = {}
    ada = {m.get('jenis'): m for m in pohon}
    if (ada.get('layanan') or {}).get('anak') and len(sd['layanan']) >= 2:
        for l in sd['layanan']:
            anak = [paragraf(esc(l.get('teks') or ''))] if l.get('teks') else []
            if l.get('rincian'):
                anak += [judul('Cakupan Pekerjaan'), grup([grup([judul(esc(r), 3)], kelas='vf-kotak-ikon vf-ikon--satu')
                                                          for r in l['rincian'][:6]],
                                                         kelas='vf-grid-ikon vf-kolom-2', align='wide',
                                                         layout={'type': 'grid', 'columnCount': 2, 'minimumColumnWidth': '14rem'})]
            if isi.get('alur'):
                anak += [judul('Alur Kerja'), akordeon([(f"{i + 1}. {a.get('judul')}", a.get('teks') or '')
                                                        for i, a in enumerate(isi['alur'][:6])])]
            anak.append(blok_form())
            hasil[f"layanan/{slug_teks(l['judul'])}"] = (l['judul'], '\n\n'.join(anak))
    if 'faq' in ada:
        tanya = faq_butir(sd, isi)
        if len(tanya) >= 3:
            hasil['faq'] = ('FAQ', '\n\n'.join([paragraf('Jawaban atas pertanyaan yang sering diajukan seputar layanan kami.'),
                                                  akordeon(tanya, 'vf-akordeon-grup vf-faq-grup')]))
    return hasil


def faq_butir(sd, isi):
    """[(pertanyaan, jawaban)] dari FAKTA klien saja — layanan, cakupan, area, alur, kontak.
    Tidak pernah mengarang pertanyaan. Dipakai halaman FAQ tersendiri maupun seksi FAQ di
    halaman Kontak (referensi northseaaconsulting.com menaruhnya di sana)."""
    tanya = []
    if sd['layanan']:
        tanya.append((f"Apa saja layanan {sd['nama']}?",
                      'Layanan kami meliputi ' + ', '.join(l['judul'] for l in sd['layanan']) + '.'))
    if sd.get('area'):
        tanya.append(('Wilayah mana saja yang dilayani?', f"Kami melayani wilayah {sd['area']}."))
    if isi.get('alur'):
        tanya.append(('Bagaimana alur pemesanannya?',
                      ' '.join(f"{i + 1}. {a.get('judul')}: {a.get('teks')}" for i, a in enumerate(isi['alur'][:6]))))
    if sd.get('wa') or sd.get('email_publik'):
        cara = ' atau '.join(x for x in (f"WhatsApp {sd['telp'] or sd['wa']}" if sd.get('wa') else '',
                                         f"email {sd['email_publik']}" if sd.get('email_publik') else '') if x)
        tanya.append(('Bagaimana cara menghubungi kami?', f'Hubungi kami melalui {cara}, atau isi formulir di halaman Kontak.'))
    for l in sd['layanan'][:4]:
        if l.get('rincian'):
            tanya.append((f"Apa saja cakupan {l['judul']}?", ', '.join(l['rincian'][:6]) + '.'))
    return tanya


def tautan_menu(info, sd, slugs_ada):
    """Menu utama: susunan menu klasik yang sudah disepakati (paket-g-setup) dibawa apa adanya."""
    if satu_halaman(info) and not (info.get('label_menu') or info.get('tanpa_halaman_manifest')):
        if jangkar_menu := menu_jangkar(info, sd):
            return jangkar_menu
    if ref_menu := menu_referensi(info, sd):
        return ref_menu
    butir = []
    for m in info['menu']:
        if m['jenis'] == 'post_type' and m['objek'] == 'page':
            butir.append({'label': m['judul'], 'type': 'page', 'id': m['id'], 'url': m['url'], 'kind': 'post-type'})
        elif m['jenis'] == 'taxonomy' and m['objek'] == 'category':
            butir.append({'label': m['judul'], 'type': 'category', 'id': m['id'], 'url': m['url'], 'kind': 'taxonomy'})
        else:
            butir.append({'label': m['judul'], 'url': m['url'], 'kind': 'custom', 'isTopLevelLink': True})
    if not butir:
        semua = info['semua']
        halaman = lambda slug, label: butir.append({'label': label, 'type': 'page', 'id': semua[slug]['id'],
                                                    'url': semua[slug]['url'], 'kind': 'post-type'}) if slug in semua else None
        if sd.get('gaya') == 'dealer' and sd['jenis'] != 'berita':
            halaman('beranda', 'Beranda')
            butir.append({'label': 'Model Unit', 'url': info['home'] + 'model-unit/', 'kind': 'custom',
                          'isTopLevelLink': True})
            for slug, label in (('test-drive', 'Test Drive'), ('simulasi-kredit', 'Simulasi Kredit'),
                                ('galeri', 'Galeri'), ('tentang-kami', 'Tentang Kami'), ('berita', 'Artikel')):
                halaman(slug, label)
        elif sd['jenis'] == 'berita':
            halaman('beranda', 'Home')
            for r in sd['rubrik']:
                t = info['kategori'].get(r['slug'])
                if t:
                    butir.append({'label': r['judul'], 'type': 'category', 'id': t['id'], 'url': t['url'], 'kind': 'taxonomy'})
            halaman('redaksi', 'Redaksi')
        else:
            label_menu = info.get('label_menu') or {}
            for slug, label in (('beranda', 'Beranda'), ('tentang-kami', 'Profil'), ('layanan', 'Layanan'),
                                ('produk', 'Produk'), ('pemesanan', 'Pemesanan'), ('galeri', 'Galeri Foto'), ('berita', 'Berita')):
                if slug in (info.get('tanpa_halaman') or ()):
                    continue
                if slug == 'produk' and info.get('toko'):
                    # Arsip produk VD Store (store_product), bukan halaman; kategori & subkategori
                    # produk jadi submenu bertingkat (yukpergimancing.com 2026-09-17).
                    butir.append(menu_produk(info, label_menu.get('produk', 'Produk')))
                else:
                    halaman(slug, label_menu.get(slug, label))
        halaman('hubungi-kami', (info.get('label_menu') or {}).get('hubungi-kami', 'Kontak Kami'))
    return '\n\n'.join(b if isinstance(b, str) else blok('navigation-link', b) for b in butir)


def menu_produk(info, label):
    """Produk -> kategori induk -> subkategori (taksonomi store_product_cat VD Store)."""
    url = info['home'] + 'produk/'
    kat = info.get('kategori_produk') or []
    def tautan_kat(t):
        return {'label': t['nama'], 'type': 'store_product_cat', 'id': t['id'], 'url': t['url'], 'kind': 'taxonomy'}
    anak = []
    for induk in [t for t in kat if not t['induk']]:
        sub = [blok('navigation-link', tautan_kat(t)) for t in kat if t['induk'] == induk['id']]
        if sub:
            anak.append(blok('navigation-submenu', dict(tautan_kat(induk)), '\n\n'.join(sub)))
        else:
            anak.append(blok('navigation-link', tautan_kat(induk)))
    if not anak:
        return {'label': label, 'url': url, 'kind': 'custom', 'isTopLevelLink': True}
    return blok('navigation-submenu', {'label': label, 'url': url, 'kind': 'custom', 'isTopLevelItem': True},
                '\n\n'.join(anak))


KONTAK_BLOK_INSTALLER = re.compile(
    r'\s*(?:<!-- wp:heading -->\s*<h2 class="wp-block-heading">(?:Kontak|Media Sosial|Lokasi|Ajukan Pemesanan|Kirim Pesan)</h2>\s*<!-- /wp:heading -->'
    r'|<!-- wp:velocity/kontak /-->|<!-- wp:velocity/form-kirim /-->'
    r'|<!-- wp:contact-form-7/contact-form-selector \{[^\n]*?\} -->.*?<!-- /wp:contact-form-7/contact-form-selector -->'
    r'|<!-- wp:social-links \{[^\n]*?\} -->.*?<!-- /wp:social-links -->'
    r'|<!-- wp:html -->\s*<!-- velocity-map -->.*?<!-- /wp:html -->)', re.S)


def kartu_kontak(sd, tampilan='kartu'):
    """Grid Kartu Ikon berisi kontak NYATA (bukan ditarik diam-diam dari Data Situs), supaya
    klien bisa mengubah ikon, judul, isi, dan tautannya langsung di editor — tambah kartu
    baru cukup duplikat/seret (permintaan user 2026-09-19). Kolom diatur blok Group (Grid)."""
    angka = lambda s: re.sub(r'^0', '62', re.sub(r'\D', '', str(s or '')))
    kartu = []
    if sd.get('alamat'):
        kartu.append(('alamat', 'Alamat', sd['alamat'],
                      'https://www.google.com/maps/search/?api=1&query=' + urllib.parse.quote(sd['alamat']), True))
    if sd.get('wa'):
        kartu.append(('whatsapp', 'WhatsApp', sd['wa'], 'https://wa.me/' + angka(sd['wa']), True))
    if sd.get('telp') and angka(sd['telp']) != angka(sd.get('wa')):
        kartu.append(('telepon', 'Telepon', sd['telp'], 'tel:' + re.sub(r'[^0-9+]', '', sd['telp']), False))
    if sd.get('email_publik'):
        kartu.append(('email', 'Email', sd['email_publik'], 'mailto:' + sd['email_publik'], False))
    if not kartu:
        return ''
    isi = '\n\n'.join(blok('velocity/kartu-ikon', {'ikon': ikon, 'judul': judul, 'isi': esc(nilai),
                                                    'tautan': url, 'tabBaru': baru, 'tampilan': tampilan})
                       for ikon, judul, nilai, url, baru in kartu)
    return blok('group', {'className': 'vf-kontak-grid',
                          'layout': {'type': 'grid', 'columnCount': min(4, len(kartu)), 'minimumColumnWidth': '14rem'}},
                f'<div class="wp-block-group vf-kontak-grid">{isi}</div>')


def kontak_dua_kolom(info, peta):
    """Hubungi Kami dua kolom: kiri teks pengantar (tulisan AI/PM) + kontak + media sosial,
    kanan peta. Formulir tidak dipasang. Teks pengantar diambil dari isi halaman yang ada:
    grup .vf-kontak-intro (run sebelumnya) atau isi lama tanpa blok bawaan installer."""
    lama = ((info['halaman'].get('hubungi-kami') or {}).get('isi') or '').strip()
    m = re.search(r'<!-- wp:group \{[^\n]*"className":"vf-kontak-intro"[^\n]*\} -->\s*<div class="[^"]*">(.*?)</div>\s*<!-- /wp:group -->', lama, re.S)
    if m:
        intro = m.group(1).strip()
    else:
        intro = KONTAK_BLOK_INSTALLER.sub('', lama if '<!-- wp:' in lama else html_ke_blok(lama)).strip()
    kiri = [grup([intro], kelas='vf-kontak-intro')] if intro else []
    kiri += [judul('Kontak', 3), blok('velocity/kontak'), judul('Media Sosial', 3), ikon_sosmed()]
    kanan = [judul('Lokasi', 3), peta] if peta else []
    kol = [kolom(kiri, '46%')] + ([kolom(kanan)] if kanan else [])
    return barisan(kol, kelas='vf-kontak-dua', align='wide')


def cek_markup(berkas):
    run = subprocess.run(['node', str(HERE / 'cek-blok')] + [str(b) for b in berkas], capture_output=True, text=True, timeout=180)
    if run.returncode == 3:
        print('fse: cek_blok_dilewati:alat_tidak_ada')
        return set()
    return {Path(b.split(' ', 1)[1].split(':', 1)[0]).stem for b in run.stdout.splitlines() if b.startswith('tidak_valid')} | (
        set() if run.returncode in (0, 1) else {'*'}), run.stdout


def cek_http(url):
    req = urllib.request.Request(url, headers={'User-Agent': UA})
    try:
        with urllib.request.urlopen(req, timeout=30, context=ssl._create_unverified_context()) as r:
            return r.status, r.read().decode(errors='ignore')
    except urllib.error.HTTPError as e:
        return e.code, ''
    except (urllib.error.URLError, OSError):
        return 0, ''


def langkah_isi(cfg, situs, coba):
    domain = situs.domain
    isi = baca_isi(domain)
    vct = muat_modul('velocity_child_theme', HERE / 'velocity-child-theme')
    ref = referensi_desain(cfg, domain, 'berita' if isi.get('jenis') == 'berita' else 'perusahaan')
    sd = data_situs(cfg, domain, isi, vct, ref)
    siapkan_cf7(situs, coba)
    berita = sd['jenis'] == 'berita'
    # Toko Online Custom: produk dari VD Store (arsip /produk/). Halaman "produk" tidak dibuat:
    # VD Store memindahkan arsipnya ke /produk-list/ kalau ada halaman berslug itu.
    toko = paket_toko(cfg)
    # Situs dealer mobil: unit tinggal di CPT mobil (arsip /model-unit/), jadi tidak ada halaman
    # Layanan/Produk/Pemesanan — yang dipakai pengunjung adalah Test Drive & Simulasi Kredit.
    dealer = sd['gaya'] == 'dealer' and not berita
    target = ['beranda', 'tentang-kami', 'galeri', 'hubungi-kami', 'berita'] + (
        ['redaksi'] if berita else ['test-drive', 'simulasi-kredit'] if dealer
        else ['layanan', 'pemesanan'] + ([] if toko else ['produk']))
    # Halaman anak layanan & FAQ dari menu referensi tidak dibuat bila menu diatur manual di manifest.
    diatur_manual = bool(str(cfg.get('tanpa_halaman', '')).strip() or str(cfg.get('label_menu', '')).strip())
    tambahan_ref = (halaman_menu_referensi(ref.get('desain'), sd, isi)
                    if not (berita or dealer or toko or diatur_manual) else {})
    target += list(tambahan_ref)
    info = situs.php(PHP_BACA, {'slug': target, 'rubrik': [r['slug'] for r in sd['rubrik']]})
    info['desain'] = ref.get('desain')
    info['halaman_referensi'] = tambahan_ref
    info['layanan_anak'] = any(k.startswith('layanan/') for k in tambahan_ref)
    if tambahan_ref:
        info['kategori_isi'] = situs.php(PHP_KATEGORI_ISI).get('kategori') or []
    info['toko'] = toko
    # Video latar hero dari manifest (`hero_video=<URL YouTube>`); kosong = video contoh
    # dipakai bila referensinya memang ber-video latar.
    info['hero_video'] = str(cfg.get('hero_video', '') or '').strip()
    # Video klien (tautan embed, bukan berkas): seksi video beranda.
    info['video'] = video_klien(cfg, domain)
    # Manifest `testimoni_contoh=1`: seksi ulasan diisi contoh berlabel (bukan ulasan asli).
    info['testimoni_contoh'] = str(cfg.get('testimoni_contoh', '')).strip().lower() in ('1', 'ya', 'true')
    if info['video']:
        print(f"fse: video_klien:{len(info['video'])}")
    # Manifest `tanpa_pemesanan=1` (yukpergimancing.com 2026-09-17: toko memakai checkout VD Store):
    # halaman & menu Pemesanan tidak dibuat dan formulir pemesanan tidak dipasang di Hubungi Kami.
    # `kontak_kolom=2`: Hubungi Kami dua kolom (teks + kontak + sosmed | peta).
    tanpa_pemesanan = str(cfg.get('tanpa_pemesanan', '')).strip().lower() in ('1', 'ya', 'true')
    info['tanpa_pemesanan'] = tanpa_pemesanan
    # Manifest `tanpa_halaman=layanan,galeri`: halaman yang sengaja dihapus tidak disusun ulang,
    # tidak masuk menu, dan tautan beranda ke sana dialihkan (produk untuk toko, kontak selainnya).
    # `label_menu=tentang-kami:Tentang Kami;...` mengganti label bawaan menu.
    tanpa_halaman = {x.strip().lower() for x in str(cfg.get('tanpa_halaman', '')).split(',') if x.strip()}
    if tanpa_pemesanan:
        tanpa_halaman.add('pemesanan')
    info['tanpa_halaman'] = tanpa_halaman
    info['tanpa_halaman_manifest'] = bool(str(cfg.get('tanpa_halaman', '')).strip())
    info['label_menu'] = dict(tuple(x.strip() for x in bagian.split(':', 1))
                              for bagian in str(cfg.get('label_menu', '')).split(';') if ':' in bagian)
    kontak_dua = str(cfg.get('kontak_kolom', '')).strip() == '2'
    if info['tema'] != SLUG:
        print(f"fse: isi_dilewati:tema_aktif_{info['tema']}")
        return 1

    q = Query()
    rencana = {}  # slug -> (id, judul, isi, tata)

    def rencanakan(slug, judul_hal, isi_baru, tata=False):
        # Halaman susunan agen desain Claude (scripts/desain-claude) menggantikan hasil generator.
        # Aturan md5 di bawah tetap berlaku: suntingan orang di wp-admin tidak ditimpa.
        timpa = RENCANA_DIR / domain / 'claude' / f"{slug.replace('/', '__')}.html"
        if timpa.is_file() and timpa.read_text().strip():
            isi_baru = timpa.read_text().strip()
            print(f'fse: halaman_claude:{slug}')
        # Situs satu halaman (referensi landing page): tiap seksi beranda diberi id jangkar
        # supaya menu bisa menggulir ke sana. Dilakukan di sini, sesudah susunan agen dipilih,
        # jadi halaman generator maupun halaman agen sama-sama dapat jangkarnya.
        if slug == 'beranda' and satu_halaman(info):
            isi_baru, jangkar = beri_jangkar(isi_baru)
            info['jangkar'] = jangkar
            if jangkar:
                print('fse: jangkar_beranda:' + ','.join(j[0] for j in jangkar))
        if slug in info['tanpa_halaman']:
            print(f'fse: halaman_dikecualikan:{slug} (manifest tanpa_halaman)')
            return
        hal = info['halaman'].get(slug)
        if hal and not milik_installer(hal):
            print(f'fse: halaman_dibiarkan:{slug} (sudah disunting orang)')
            return
        if hal and hal['isi'] == isi_baru:
            print(f'fse: halaman_sama:{slug}')
            return
        rencana[slug] = ((hal or {}).get('id', 0), (hal or {}).get('judul') or judul_hal, isi_baru, tata)

    def lanjutan(slug, tambahan):
        """Halaman tulisan AI: diubah jadi blok, lalu blok wajib ditambahkan kalau belum ada."""
        hal = info['halaman'].get(slug)
        lama = (hal or {}).get('isi', '')
        topik = []
        profil = ''
        if slug == 'tentang-kami' and not berita:
            profil, topik = profil_perusahaan(isi)
        dasar = lama.strip() if '<!-- wp:' in lama else html_ke_blok('' if lama.strip() in PLACEHOLDER else lama, topik)
        if slug == 'hubungi-kami':
            # Seksi FAQ milik installer disusun ulang tiap run (seperti galeri): tanpa ini
            # `lanjutan` melihat penanda lama di halaman lalu melewati versi barunya. FAQ
            # selalu bagian TERAKHIR halaman, jadi dipotong dari penanda pertamanya sampai
            # habis — regex ber-`.*?` salah potong karena grup FAQ punya grup di dalamnya
            # (menyisakan </div> yatim dan markup ditolak cek-blok).
            # Blok kontak milik installer juga disusun ulang tiap run (sejak ada varian
            # kartu berikon): tanpa ini `lanjutan` melihat penandanya lalu melewatkan
            # versi barunya. Judul "Kontak" di atasnya ikut dibuang supaya tidak dobel.
            dasar = re.sub(r'\s*<!-- wp:heading[^\n]*-->\s*<h2[^>]*>\s*Kontak\s*</h2>\s*<!-- /wp:heading -->'
                           r'(?=\s*<!-- wp:velocity/kontak)', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:velocity/kontak[^>]*/-->', '', dasar)
            dasar = re.sub(r'\s*<!-- wp:heading[^\n]*-->\s*<h2[^>]*>\s*Kontak\s*</h2>\s*<!-- /wp:heading -->'
                           r'(?=\s*<!-- wp:group \{[^\n]*vf-kontak-grid)', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:group \{[^\n]*?vf-kontak-grid[^\n]*?\} -->.*?<!-- /wp:group -->',
                           '', dasar, flags=re.S)
            # Peta juga milik installer: titiknya bisa berubah (kota dari alamat kantor
            # company profile), jadi bloknya disusun ulang, bukan dipertahankan.
            dasar = re.sub(r'\s*<!-- wp:heading[^\n]*-->\s*<h2[^>]*>\s*Lokasi\s*</h2>\s*<!-- /wp:heading -->'
                           r'(?=\s*<!-- wp:html)', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:html -->\s*<!-- velocity-map -->.*?<!-- /wp:html -->',
                           '', dasar, flags=re.S)
            # Media sosial & formulir ikut dibangun ulang: kalau hanya sebagian blok yang
            # disusun ulang, sisanya tetap di tempat lama dan urutan halaman jadi kacau
            # (Kontak & Lokasi sempat terdorong ke bawah formulir).
            dasar = re.sub(r'\s*<!-- wp:heading[^\n]*-->\s*<h2[^>]*>\s*Media Sosial\s*</h2>\s*<!-- /wp:heading -->'
                           r'(?=\s*<!-- wp:social-links)', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:social-links.*?<!-- /wp:social-links -->', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:heading[^\n]*-->\s*<h2[^>]*>[^<]*</h2>\s*<!-- /wp:heading -->'
                           r'(?=\s*<!-- wp:(?:velocity/form-kirim|contact-form-7/))', '', dasar, flags=re.S)
            dasar = re.sub(r'\s*<!-- wp:velocity/form-kirim[^>]*/-->', '', dasar)
            dasar = re.sub(r'\s*<!-- wp:contact-form-7/contact-form-selector.*?<!-- /wp:contact-form-7/contact-form-selector -->',
                           '', dasar, flags=re.S)
            # Baris kontak yang sekadar mengulang data situs (alamat/telepon/email) dibuang:
            # sejak kontak tampil sebagai kartu berikon, paragraf ini jadi duplikat.
            ulang = [x for x in (sd.get('alamat'), sd.get('telp'), sd.get('email_publik')) if x]
            if ulang:
                def _buang(m):
                    teks = re.sub(r'<[^>]+>', ' ', m.group(0))
                    teks = re.sub(r'\s+', ' ', teks).strip()
                    kena = sum(1 for x in ulang if x and x.lower()[:40] in teks.lower())
                    return '' if kena >= 2 and len(teks) < 400 else m.group(0)
                dasar = re.sub(r'<!-- wp:paragraph[^\n]*-->.*?<!-- /wp:paragraph -->', _buang, dasar, flags=re.S)
            dasar = dasar.strip()
            potong = min([i for i in (dasar.find('vf-ref-faq'), dasar.find('vf-faq-grup')) if i >= 0] or [-1])
            if potong >= 0:
                awal = dasar.rfind('<!-- wp:', 0, potong)
                kepala = dasar.rfind('Pertanyaan yang Sering Diajukan', 0, potong)
                if kepala >= 0:
                    awal = min(awal, dasar.rfind('<!-- wp:', 0, kepala))
                dasar = dasar[:max(awal, 0)].strip()
        if slug == 'galeri':
            # Galeri foto slot milik installer (kelas vf-galeri) disusun ulang dari peta foto
            # terbaru; galeri buatan orang tidak punya kelas itu dan tidak disentuh.
            dasar = re.sub(r'\s*<!-- wp:gallery \{[^\n]*?"className":"vf-galeri"[^\n]*?\} -->.*?<!-- /wp:gallery -->',
                           '', dasar, flags=re.S).strip()
        bagian = [dasar] if dasar else []
        if profil and 'vf-profil' not in dasar:
            bagian.append(profil)
        for penanda, markup in tambahan:
            if penanda not in dasar:
                bagian.append(markup)
        return '\n\n'.join(bagian)

    # Beranda: tata letak penuh (Query Loop per rubrik / seksi perusahaan).
    if berita:
        beranda = beranda_sorotan(q, sd, info) if sd['gaya'] == 'sorotan' else beranda_berita(q, sd, info)
    else:
        # Gaya "sorotan" baru ada untuk portal berita; perusahaan tetap susunan bawaan.
        info['domain'] = domain
        if dealer:
            beranda = beranda_dealer(q, sd, isi, info)
        elif sd['gaya'] == 'klinik':
            beranda = beranda_klinik(q, sd, isi, info)
        else:
            beranda = beranda_perusahaan(q, sd, isi, info)
    rencanakan('beranda', 'Beranda', beranda, tata=True)
    # Seksi referensi yang dilewati karena klien tidak punya datanya: audit kemiripan
    # (scripts/fse-audit-kemiripan) tidak menghitungnya sebagai seksi yang hilang.
    try:
        berkas_lewat = RENCANA_DIR / domain / 'beranda-dilewati.json'
        berkas_lewat.parent.mkdir(parents=True, exist_ok=True)
        berkas_lewat.write_text(json.dumps(info.get('dilewati') or [] if sd.get('gaya') == 'referensi' else []))
    except OSError:
        pass
    if sd.get('gaya') == 'referensi':
        print(f"fse: beranda_ikut_referensi:{(info.get('desain') or {}).get('url', '')}"
              + (f" seksi_dilewati_tanpa_data={','.join(info['dilewati'])}" if info.get('dilewati') else ''))
    if dealer:
        # Susunan halaman Tentang Kami dealer ditulis penuh (foto + teks, keunggulan, ajakan),
        # bukan sekadar tulisan AI yang diubah jadi blok.
        info['domain'] = domain
        rencanakan('tentang-kami', 'Tentang Kami', tentang_dealer(sd, isi, info))
    else:
        rencanakan('tentang-kami', 'Tentang Kami', lanjutan('tentang-kami', []))
    # Situs dealer belum tentu punya foto kiriman klien: galeri diisi foto unit & suasana
    # yang sudah dipasang installer (semuanya ber-caption kredit foto). Situs perusahaan lain
    # memakai slot galeri-* (foto kiriman klien didahulukan paket-g-foto): site-finish tidak
    # menyentuh halaman milik FSE, sehingga Galeri centralimpex.com (2026-09-17) hanya berisi
    # teks pengantar tanpa satu foto pun.
    foto_slot = info.get('foto') or {}
    if not dealer:
        foto_slot = {k: v for k, v in foto_slot.items() if k.startswith('galeri-')}
    galeri_tambahan = [] if berita else [('wp:gallery', galeri_slot(foto_slot))]
    rencanakan('galeri', 'Galeri', lanjutan('galeri', [t for t in galeri_tambahan if t[1]]))
    judul_form = 'Kirim Pesan ke Redaksi' if berita else 'Kirim Pesan' if dealer else 'Ajukan Pemesanan'
    tambahan_kontak = [
        # Halaman Hubungi Kami: grid Kartu Ikon berisi kontak nyata, disunting di tempat.
        ('vf-kontak-grid', judul('Kontak') + '\n\n' + (kartu_kontak(sd) or blok('velocity/kontak', {'tampilan': 'kartu'}))),
        ('wp:social-links', judul('Media Sosial') + '\n\n' + ikon_sosmed()),
    ]
    if not tanpa_pemesanan:
        tambahan_kontak.append(('wp:contact-form-7/' if FORM_CF7 else 'wp:velocity/form-kirim',
                                judul(judul_form) + '\n\n' + blok_form()))
    if petak := blok_peta(info.get('peta')):
        # Peta wajib ada di Hubungi Kami. Dulu hanya situs dealer yang memasangnya di sini
        # dan situs lain menunggu iframe dari site-finish — padahal suntingan site-finish
        # itu yang membuat halaman ini dianggap "sudah disunting orang" di run berikutnya.
        # Sekarang peta ikut disusun fse-apply, dan site-finish melewati halaman milik FSE.
        tambahan_kontak.insert(1, ('velocity-map', judul('Lokasi') + '\n\n' + petak))
    # Seksi FAQ di halaman Kontak bila halaman kontak referensi memang punya
    # (northseaaconsulting.com: kontak > faq). Pertanyaannya dari fakta klien.
    faq_kontak = ''
    seksi_kontak_ref = (((info.get('desain') or {}).get('halaman') or {}).get('kontak') or {}).get('seksi') or []
    if any((x or {}).get('jenis') == 'faq' for x in seksi_kontak_ref):
        butir_faq = faq_butir(sd, isi)
        if len(butir_faq) >= 3:
            # Dibungkus seksi berlatar abu supaya terbaca sebagai seksi tersendiri
            # (seperti di referensi), bukan lanjutan blok kontak.
            faq_kontak = seksi_berlatar([judul('Pertanyaan yang Sering Diajukan'),
                                         akordeon(butir_faq, 'vf-akordeon-grup vf-faq-grup')],
                                        {'jenis': 'faq', 'latar': 'abu', 'rata': 'kiri'})
    if kontak_dua and not berita:
        isi_kontak = kontak_dua_kolom(info, blok_peta(info.get('peta')))
        rencanakan('hubungi-kami', 'Hubungi Kami', isi_kontak + ('\n\n' + faq_kontak if faq_kontak else ''))
    else:
        if faq_kontak:
            tambahan_kontak.append(('vf-faq-grup', faq_kontak))
        rencanakan('hubungi-kami', 'Hubungi Kami', lanjutan('hubungi-kami', tambahan_kontak))
    if berita:
        rencanakan('redaksi', 'Redaksi', halaman_redaksi(sd, isi, info))
    elif dealer:
        rencanakan('test-drive', 'Test Drive', '\n\n'.join([
            paragraf('Isi formulir di bawah untuk menjadwalkan test drive. Tim kami menghubungi Anda untuk memastikan '
                     'unit, tanggal, dan titik temu.'),
            blok_form()]))
        rencanakan('simulasi-kredit', 'Simulasi Kredit', '\n\n'.join([
            paragraf('Atur harga unit, uang muka, tenor, dan bunga untuk melihat estimasi cicilan bulanan. '
                     'Hasilnya bisa langsung dikonsultasikan ke tim kami.'),
            blok('velocity/simulasi-kredit', {'align': 'wide'})]))
    else:
        if sd['layanan']:
            anak = [paragraf('Kebutuhan Anda ditangani satu tim — mulai dari peninjauan, penawaran tertulis, pengerjaan, sampai serah terima.')]
            anak += kartu_isi(sd['layanan'])
            if isi.get('alur'):
                anak += [judul('Alur Kerja'), barisan([kolom([judul(esc(a.get('judul')), 3), paragraf(esc(a.get('teks')))])
                                                      for a in isi['alur'][:5]], kelas='vf-langkah')]
            rencanakan('layanan', 'Layanan', '\n\n'.join(anak))
        if isi.get('produk') and not toko:
            rencanakan('produk', 'Produk', '\n\n'.join([paragraf('Pekerjaan dan produk yang paling sering diminta pelanggan.')]
                                                       + kartu_isi(isi['produk'])))
        if not tanpa_pemesanan:
            rencanakan('pemesanan', 'Pemesanan', '\n\n'.join([
                paragraf('Isi formulir di bawah ini untuk mengajukan pemesanan atau konsultasi. Permintaan Anda kami terima langsung melalui email.'),
                blok_form()]))
    # Halaman mengikuti menu referensi (rencana VERSI 5): anak per layanan & FAQ.
    for slug, (judul_hal, isi_hal) in (info.get('halaman_referensi') or {}).items():
        rencanakan(slug, judul_hal, isi_hal)
    # Halaman lain yang masih berisi shortcode desain child theme lama.
    for slug, hal in (info.get('sisa') or {}).items():
        bersih = SHORTCODE_LAMA.sub('', hal['isi'])
        for j in JUDUL_LAMA:
            bersih = bersih.replace(j, '')
        rencana[slug] = (hal['id'], hal['judul'], bersih.strip(), False)
        print(f'fse: shortcode_lama_dibuang:{slug}')

    # Menu utama (wp_navigation).
    nav_isi = tautan_menu(info, sd, set(info['semua']))
    milik = next((n for n in info['nav'] if n['milik']), None)
    nav = None
    if milik and milik['milik'] != milik['md5']:
        print('fse: menu_dibiarkan (sudah disunting orang)')
    elif milik and milik['md5'] == md5(nav_isi):
        print('fse: menu_sama')
    elif nav_isi:
        nav = {'id': milik['id'] if milik else 0, 'isi': nav_isi}

    # Validasi semua markup sebelum menyentuh situs.
    folder = RENCANA_DIR / domain
    folder.mkdir(parents=True, exist_ok=True)
    berkas = []
    for slug, (_, _, isi_baru, _) in rencana.items():
        nama_berkas = slug.replace('/', '__')
        (folder / f'{nama_berkas}.html').write_text(isi_baru)
        berkas.append(folder / f'{nama_berkas}.html')
    if nav:
        (folder / 'menu.html').write_text(nav['isi'])
        berkas.append(folder / 'menu.html')
    if berkas:
        tidak_valid, keluaran = cek_markup(berkas)
        for baris in keluaran.splitlines():
            if baris.startswith('tidak_valid'):
                print('fse: ' + baris[:300])
        if '*' in tidak_valid:
            print('fse: cek_blok_gagal_dijalankan, tidak ada yang ditulis')
            return 1
        for slug in tidak_valid:
            print(f'fse: {slug}_tidak_ditulis:markup_tidak_valid')
            rencana.pop(slug.replace('__', '/'), None)
            if slug == 'menu':
                nav = None
    print(f"fse: rencana halaman={','.join(rencana) or '-'} menu={'ya' if nav else 'tidak'} (berkas di {folder})")
    if coba or (not rencana and not nav):
        return 0

    depan = (info['halaman'].get('beranda') or {}).get('id', 0)
    kirim = {'halaman': [{'slug': s, 'id': v[0], 'judul': v[1], 'isi': v[2], 'tata': v[3]} for s, v in rencana.items()],
             'nav': nav, 'depan': depan}
    tulis = situs.php(PHP_TULIS, kirim)
    for baris in tulis['hasil']:
        print(f'fse: {baris}')
    # Menu referensi memuat halaman yang baru dibuat (anak layanan, FAQ): susun ulang sesudah
    # halaman ada, supaya build pertama langsung bermenu lengkap.
    if info.get('halaman_referensi') and any(b.startswith('halaman_dibuat:') for b in tulis['hasil']):
        info['semua'] = situs.php(PHP_BACA, {'slug': [], 'rubrik': []}).get('semua') or info['semua']
        nav_baru = tautan_menu(info, sd, set(info['semua']))
        milik = next((n for n in situs.php(PHP_BACA, {'slug': [], 'rubrik': []}).get('nav') or [] if n['milik']), None)
        if nav_baru and (not milik or milik['milik'] == milik['md5']) and (not milik or milik['md5'] != md5(nav_baru)):
            (folder / 'menu.html').write_text(nav_baru)
            if not cek_markup([folder / 'menu.html'])[0]:
                for baris in situs.php(PHP_TULIS, {'halaman': [], 'nav': {'id': milik['id'] if milik else 0, 'isi': nav_baru}, 'depan': 0})['hasil']:
                    print(f'fse: {baris} (menu disusun ulang)')
    # Filter simpan WordPress mengubah isi: markup yang tersimpan diperiksa ulang.
    if tulis.get('ubah'):
        ulang = []
        for slug, simpan in tulis['ubah'].items():
            (folder / f'{slug}.tersimpan.html').write_text(simpan)
            ulang.append(folder / f'{slug}.tersimpan.html')
        tidak_valid, keluaran = cek_markup(ulang)
        print(f"fse: isi_diubah_wp:{','.join(tulis['ubah'])} -> "
              + ('tetap valid' if not tidak_valid else 'TIDAK VALID: ' + ','.join(sorted(tidak_valid))))

    # Situs dibaca sebagai pengunjung: shortcode mentah & blok tak terender tidak boleh lolos.
    gagal = 0
    for slug in ['beranda'] + [s for s in rencana if s != 'beranda']:
        url = info['home'] if slug == 'beranda' else (info['semua'].get(slug) or {}).get('url') or f"{info['home']}{slug}/"
        kode, badan = cek_http(url + ('&' if '?' in url else '?') + 'vfse=cek')
        mentah = sorted(set(SHORTCODE_LAMA.findall(badan)))
        belum = 'wp:velocity/' in badan or '<!-- wp:' in badan
        status = 'ok' if kode == 200 and not mentah and not belum else 'MASALAH'
        gagal += status != 'ok'
        print(f"fse: http {slug}={kode} {status}" + (f" shortcode_mentah={','.join(mentah)}" if mentah else '')
              + (' blok_tidak_terender' if belum else ''))
    return 1 if gagal else 0


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    mode = next((m for m in ('--deteksi', '--tema', '--isi') if m in sys.argv), '')
    coba = '--coba' in sys.argv
    if len(args) != 1 or not mode:
        print('usage: fse-apply --deteksi|--tema|--isi <manifest> [--coba]', file=sys.stderr)
        return 2
    cfg = read_manifest(args[0])
    cfg['_manifest'] = args[0]
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', cfg.get('domain', '').lower()) \
            or not re.match(r'^[a-z][a-z0-9]*$', cfg.get('da_user', '')):
        print('fse: manifest tidak valid')
        return 2
    try:
        situs = Situs(cfg)
        if mode == '--deteksi':
            jalur, alasan = deteksi(cfg, situs)
            print(f'fse: jalur={jalur} ({alasan})', file=sys.stderr)
            print(jalur)
            return 0
        if mode == '--tema':
            return langkah_tema(cfg, situs, coba)
        return langkah_isi(cfg, situs, coba)
    except (RuntimeError, subprocess.SubprocessError, OSError, ValueError, KeyError) as e:
        print(f'fse: gagal:{type(e).__name__}:{e}'[:300])
        if mode == '--deteksi':
            print('gagal')
        return 1


if __name__ == '__main__':
    try:
        kode = main()
    finally:
        # WP-CLI di langkah ini berjalan sebagai root: kembalikan pemilik wp-content (scripts/pemilik_wp.py).
        import pemilik_wp
        pemilik_wp.rapikan()
    sys.exit(kode)
