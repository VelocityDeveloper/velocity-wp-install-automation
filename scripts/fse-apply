HERE = Path(__file__).resolve().parent
TEMA = HERE.parent / 'templates' / 'tema-fse'
SLUG = 'velocity-fse'
GENERATED_DIR = Path('/var/lib/velocity/ai/generated')
# Uji desain di WordPress lokal (VELOCITY_LOKAL_*) tidak boleh menulis cache rencana situs sungguhan.
RENCANA_DIR = Path(os.environ.get('VELOCITY_FSE_RENCANA') or '/var/lib/velocity/fse-rencana')
UA = 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'

# Shortcode desain child theme Paket G lama. Setelah tema diganti fungsinya tidak
# terdaftar lagi, sehingga tercetak mentah ("[anak_kontak]") ke pengunjung.
SHORTCODE_LAMA = re.compile(r'\[[a-z][a-z0-9]{0,11}_(?:redaksi|kontak|pemesanan|layanan|produk|galeri|alur|profil'
                            r'|struktur|customer|legalitas|visimisi)\]')
# Judul yang dulu ditambahkan paket-g-setup bersama shortcode di atas.
JUDUL_LAMA = ('<h2>Kirim Pesan ke Redaksi</h2>', '<h2>Ajukan Pemesanan</h2>', '<h2>Alur Kerja</h2>')
# Isi awal halaman buatan installer (belum pernah diisi siapa pun).
PLACEHOLDER = ('Selamat datang di website kami.', 'Halaman tentang kami.', 'Halaman galeri.',
               'Halaman hubungi kami.', 'Halaman arsip berita.')
# Bagian tulisan AI di Tentang Kami yang digantikan data company profile.
TOPIK_PROFIL = {
    'visi': r'\b(visi|misi|moto|motto)\b',
    'struktur': r'struktur|organisasi|manajemen|tim kami',
    'customer': r'customer|pelanggan|klien kami',
    'legalitas': r'legalitas|perizinan|dokumen legal',
}


def read_manifest(path):
    cfg = {}
    for line in Path(path).read_text(errors='ignore').splitlines():
        if '=' in line and not line.lstrip().startswith('#'):
            kunci, nilai = line.split('=', 1)
            cfg[kunci.strip()] = nilai.strip()
    return cfg


def muat_modul(nama, berkas):
    loader = importlib.machinery.SourceFileLoader(nama, str(berkas))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def md5(teks):
    return hashlib.md5(teks.encode()).hexdigest()


def baca_isi(domain):
    """Isi contoh hasil paket-g-konten (identitas, rubrik/layanan, warna)."""
    try:
        return json.loads((GENERATED_DIR / f'{domain}-tema.json').read_text())
    except (OSError, ValueError):
        return {}


