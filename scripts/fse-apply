FONT_LOKAL = {'plus jakarta sans': 'jakarta', 'montserrat': 'montserrat', 'pt serif': 'pt-serif'}
# Gaya beranda yang tersedia di tema; deskripsinya dipakai AI untuk memilih.
GAYA = {
    'klasik': 'Portal berita padat: berita utama besar dengan daftar berita kecil di sampingnya, grid kartu kecil '
              '(foto di atas judul), blok per rubrik, kolom samping (terpopuler, kategori), header berwarna.',
