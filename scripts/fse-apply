                            r'|struktur|customer|legalitas|visimisi)\]')
# Judul yang dulu ditambahkan paket-g-setup bersama shortcode di atas.
JUDUL_LAMA = ('<h2>Kirim Pesan ke Redaksi</h2>', '<h2>Ajukan Pemesanan</h2>', '<h2>Alur Kerja</h2>')
# Isi awal halaman buatan installer (belum pernah diisi siapa pun).
PLACEHOLDER = ('Selamat datang di website kami.', 'Halaman tentang kami.', 'Halaman galeri.',
               'Halaman hubungi kami.', 'Halaman arsip berita.')
# Bagian tulisan AI di Tentang Kami yang digantikan data company profile.
TOPIK_PROFIL = {
