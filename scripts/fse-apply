}


def read_manifest(path):
    cfg = {}
    for line in Path(path).read_text(errors='ignore').splitlines():
        if '=' in line and not line.lstrip().startswith('#'):
            kunci, nilai = line.split('=', 1)
            cfg[kunci.strip()] = nilai.strip()
    return cfg


def muat_modul(nama, berkas):
    loader = importlib.machinery.SourceFileLoader(nama, str(berkas))
    spec = importlib.util.spec_from_loader(nama, loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def md5(teks):
    return hashlib.md5(teks.encode()).hexdigest()


def baca_isi(domain):
    """Isi contoh hasil paket-g-konten (identitas, rubrik/layanan, warna)."""
    try:
        return json.loads((GENERATED_DIR / f'{domain}-tema.json').read_text())
    except (OSError, ValueError):
        return {}


