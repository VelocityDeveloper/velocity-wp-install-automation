#!/usr/bin/env python3
"""Screenshot situs Paket G sesudah automation, untuk dicek mata.

Pemakaian: paket-g-cek-visual <manifest | domain>

Pelajaran 2026-09-13 (ptmitraajegselaras.com): HTML yang "benar" tidak menjamin
tampilan benar — foto sampul gelap, menu terlipat dua baris, gambar teknik di
kartu layanan, dan tulisan merah di atas navy hanya ketahuan dari screenshot.
Langkah ini memotret beranda (desktop penuh + HP) dan halaman utama, memotong
gambar panjang jadi potongan ≤1500px supaya bisa dibuka, dan memeriksa hal yang
bisa diperiksa mesin: HTTP 200 dan layar tidak kosong.

Versi 2026-09-17 (pelajaran jasakontraktorindo.com & centralimpex.com):
  - semua halaman dipotret lewat scripts/potret-halaman (Playwright, viewport normal,
    digulir pelan sampai dasar) — jendela CLI 9000px merusak elemen ber-vh dan foto
    lazy-load tampil kosong;
  - halaman diambil dari MENU situs (bukan slug baku) supaya halaman hasil desain
    referensi (Profil, Portofolio, FAQ, halaman jasa) ikut terpotret;
  - HP: scroll horizontal, tombol menu HP ada & membuka menu, gambar rusak;
  - referensi dipotret desktop + HP dan digabung berdampingan dengan situs
    (banding-beranda-*.png, banding-beranda-hp-*.png) — dikirim ke Telegram.

Hasil: /var/lib/velocity/visual/<domain>/<waktu>/ (5 run terakhir disimpan),
berisi PNG + ringkasan.json. Tanpa Chromium langkah ini dilewati, tidak gagal.
"""
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
OUT_ROOT = Path('/var/lib/velocity/visual')
# UA biasa: aturan bot server menolak UA pendek/skrip dengan 403.
UA = 'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36'
UA_HP = 'Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Mobile Safari/537.36'
HALAMAN = (
    # (nama, path, lebar, tinggi jendela, UA)
    ('beranda', '/', 1366, 9000, UA),
    ('beranda-hp', '/', 390, 2600, UA_HP),
    ('tentang-kami', '/tentang-kami/', 1366, 4000, UA),
    ('layanan', '/layanan/', 1366, 3000, UA),
    ('galeri', '/galeri/', 1366, 4000, UA),
    ('hubungi-kami', '/hubungi-kami/', 1366, 3000, UA),
    # Portal berita: indeks berita & redaksi (situs perusahaan tidak punya -> dilewati).
    ('berita', '/berita/', 1366, 4000, UA),
    ('redaksi', '/redaksi/', 1366, 3000, UA),
)


def cari_chrome():
    calon = [os.environ.get('VELOCITY_CHROME', '')]
    calon += sorted(glob.glob('/root/.cache/ms-playwright/chromium-*/chrome-linux*/chrome'), reverse=True)
    calon += [shutil.which(n) or '' for n in ('chromium', 'chromium-browser', 'google-chrome')]
    return next((c for c in calon if c and os.access(c, os.X_OK)), '')


def png():
    """Pembaca/penulis PNG murni Python milik compro-klien (PIL tidak terpasang)."""
    loader = importlib.machinery.SourceFileLoader('compro_klien', str(HERE / 'compro-klien'))
    spec = importlib.util.spec_from_loader('compro_klien', loader)
    modul = importlib.util.module_from_spec(spec)
    loader.exec_module(modul)
    return modul


def http_kode(url):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': UA}), timeout=30) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except Exception:
        return 0


def potong(modul, berkas, tujuan, nama):
    """Buang bagian bawah yang kosong, lalu potong per 1500px. -> (jumlah potongan, beragam?)"""
    lebar, tinggi, kanal, baris = modul.baca_png(berkas)
    akhir = tinggi
    while akhir > 0 and len(set(baris[akhir - 1][::kanal * 40])) <= 1:
        akhir -= 1
    ragam = {baris[y][x:x + 3] for y in range(0, akhir, 97) for x in range(0, lebar * kanal, kanal * 53)}
    # Grid jarang di atas meleset dari teks tipis di halaman berlatar polos (tema FSE
    # anaksegalabangsa.com: Tentang Kami/Redaksi penuh teks tetap dinilai kosong).
    # Tambahan: berapa baris yang berisi lebih dari satu warna. Layar putih/galat ≈ 0.
    berisi = sum(1 for y in range(0, akhir, 5) if len({baris[y][x:x + 3] for x in range(0, lebar * kanal, kanal * 3)}) > 2)
    ubah = (lambda r: r) if kanal == 4 else (lambda r: b''.join(r[i:i + 3] + b'\xff' for i in range(0, len(r), 3)))
    jumlah, y = 0, 0
    while y < akhir:
        y1 = min(akhir, y + 1500)
        modul.tulis_png_rgba(tujuan / f'{nama}-{jumlah + 1}.png', lebar, y1 - y, [ubah(r) for r in baris[y:y1]])
        jumlah, y = jumlah + 1, y1
    berkas.unlink(missing_ok=True)
    return jumlah, len(ragam) > 20 or berisi * 5 >= 0.15 * max(akhir, 1)


def domain_dari(argumen):
    if Path(argumen).is_file():
        for baris in Path(argumen).read_text(errors='replace').splitlines():
            if baris.startswith('domain='):
                return baris.split('=', 1)[1].strip().lower()
        return ''
    return argumen.strip().lower()


def potret(url, keluaran, hp=False):
    """scripts/potret-halaman -> (berhasil, cek dict)."""
    perintah = ['node', str(HERE / 'potret-halaman'), url, str(keluaran)] + (['--hp'] if hp else []) + ['--cek']
    try:
        run = subprocess.run(perintah, capture_output=True, text=True, timeout=200)
    except (OSError, subprocess.TimeoutExpired):
        return False, {}
    cek = {}
    for baris in run.stdout.splitlines():
        if baris.startswith('cek:'):
            try:
                cek = json.loads(baris[4:])
            except ValueError:
                pass
    return Path(keluaran).is_file(), cek


def banding(kiri, kanan, awalan):
    try:
        run = subprocess.run(['node', str(HERE / 'banding-potret'), str(kiri), str(kanan), str(awalan), '0.4', '2600'],
                             capture_output=True, text=True, timeout=120)
        m = re.search(r'banding:ok:(\d+)', run.stdout)
        return int(m.group(1)) if m else 0
    except (OSError, subprocess.TimeoutExpired):
        return 0


def nama_halaman(path):
    return re.sub(r'[^a-z0-9]+', '-', path.strip('/').lower()).strip('-')[:40] or 'beranda'


def main():
    if len(sys.argv) != 2:
        print('usage: paket-g-cek-visual <manifest|domain>', file=sys.stderr)
        return 2
    domain = domain_dari(sys.argv[1])
    if not re.match(r'^[a-z0-9.-]+\.[a-z]{2,}$', domain):
        print('visual: domain tidak valid')
        return 2
    if not cari_chrome() or not (HERE / 'potret-halaman').is_file():
        print('visual: Chromium tidak ditemukan, langkah dilewati')
        return 0
    folder = OUT_ROOT / domain / time.strftime('%Y%m%d-%H%M%S')
    folder.mkdir(parents=True, exist_ok=True)
    modul = png()
    ringkasan, temuan = {'domain': domain, 'folder': str(folder), 'halaman': {}, 'banding': []}, []
    try:
        ref = json.loads((Path('/var/lib/velocity/fse-rencana') / domain / 'referensi.json').read_text())
    except (OSError, ValueError):
        ref = {}
    if not ref.get('url'):
        # Rencana belum ada / tercatat tanpa referensi: baca langsung dari FORM ISIAN.
        try:
            loader = importlib.machinery.SourceFileLoader('referensi_desain', str(HERE / 'referensi_desain.py'))
            spec = importlib.util.spec_from_loader('referensi_desain', loader)
            rd = importlib.util.module_from_spec(spec)
            loader.exec_module(rd)
            ref = rd.referensi_form(domain) or {}
        except Exception:
            ref = {}

    mentah_ref = {}
    if ref.get('url'):
        for nama, hp in (('referensi-beranda', False), ('referensi-beranda-hp', True)):
            mentah = folder / f'{nama}-mentah.png'
            ok, cek_ref = potret(ref['url'], mentah, hp)
            if cek_ref.get('potret_menu') and Path(cek_ref['potret_menu']).is_file():
                Path(cek_ref['potret_menu']).rename(folder / 'referensi-beranda-hp-menu.png')
            if ok:
                mentah_ref[hp] = mentah
            else:
                print(f"visual: referensi     {ref['url']} tidak terpotret ({'hp' if hp else 'desktop'})")
        ringkasan['referensi'] = {'url': ref['url'], 'gaya': ref.get('gaya'), 'catatan': ref.get('catatan', '')}

    daftar = [('beranda', '/', False), ('beranda-hp', '/', True)]
    for nama, path, hp in daftar:
        url = f'https://{domain}{path}?cekvisual={int(time.time())}'
        kode = http_kode(url)
        hasil = {'http': kode, 'potongan': 0, 'path': path}
        if kode == 404 and nama not in ('beranda', 'beranda-hp'):
            hasil['dilewati'] = True
        elif kode != 200:
            temuan.append(f'{nama}:http_{kode}')
        else:
            mentah = folder / f'{nama}-mentah.png'
            ok, cek = potret(url, mentah, hp)
            if not ok:
                temuan.append(f'{nama}:screenshot_gagal')
            else:
                if nama == 'beranda' and len(daftar) == 2:
                    # Halaman dalam = isi menu situs (maks 10), cadangan slug baku.
                    jalur = []
                    for tautan in cek.get('menu') or []:
                        p = urllib.parse.urlsplit(tautan).path or '/'
                        if p != '/' and p not in jalur and not re.search(r'/(category|tag|author|feed)/', p):
                            jalur.append(p)
                    if not jalur:
                        jalur = [h[1] for h in HALAMAN if h[1] != '/']
                    daftar += [(nama_halaman(p), p, False) for p in jalur[:10]]
                if cek.get('scroll_horizontal'):
                    temuan.append(f"{nama}:scroll_horizontal:{cek.get('lebar_dokumen')}px")
                if cek.get('gambar_rusak'):
                    temuan.append(f"{nama}:gambar_rusak:{len(cek['gambar_rusak'])}")
                if hp and nama == 'beranda-hp':
                    if not cek.get('tombol_menu_hp'):
                        temuan.append('beranda-hp:tombol_menu_tidak_ada')
                    elif not cek.get('menu_hp_terbuka'):
                        temuan.append('beranda-hp:menu_hp_tidak_terbuka')
                    if cek.get('potret_menu') and Path(cek['potret_menu']).is_file():
                        Path(cek['potret_menu']).rename(folder / 'beranda-hp-menu.png')
                # Perbandingan berdampingan sebelum PNG mentah dipotong & dihapus.
                if nama in ('beranda', 'beranda-hp') and mentah_ref.get(hp):
                    n = banding(mentah_ref[hp], mentah, folder / f'banding-{nama}')
                    ringkasan['banding'] += [str(folder / f'banding-{nama}-{i}.png') for i in range(1, n + 1)]
                try:
                    hasil['potongan'], beragam = potong(modul, mentah, folder, nama)
                    if not beragam:
                        temuan.append(f'{nama}:layar_kosong')
                except Exception as e:
                    temuan.append(f'{nama}:png_{type(e).__name__}')
        ringkasan['halaman'][nama] = hasil
        print(f"visual: {nama:13} http={kode} potongan={hasil['potongan']}")
    for hp, mentah in mentah_ref.items():
        try:
            potong(modul, mentah, folder, 'referensi-beranda-hp' if hp else 'referensi-beranda')
        except Exception:
            mentah.unlink(missing_ok=True)
    ringkasan['temuan'] = temuan
    (folder / 'ringkasan.json').write_text(json.dumps(ringkasan, indent=2, ensure_ascii=False))
    for lama in sorted((OUT_ROOT / domain).iterdir())[:-5]:
        shutil.rmtree(lama, ignore_errors=True)
    print(f"visual: banding={len(ringkasan['banding'])}")
    print(f'visual: folder={folder}')
    print(f"visual: temuan={','.join(temuan) or 'tidak ada'}")
    return 0


if __name__ == '__main__':
    sys.exit(main())
