#!/usr/bin/env python3
"""Kumpulkan skill & memory Claude Code jadi satu graf JSON untuk halaman /brain/.

Sumber:
  - memory : ~/.claude/projects/*/memory/*.md (kecuali MEMORY.md = indeks)
  - skill  : ~/.claude/skills/<nama>/SKILL.md (pribadi),
             ~/.claude/skills/synced/*/<nama>/SKILL.md (tersinkron dari claude.ai),
             ~/.claude/plugins/cache/<marketplace>/<plugin>/<versi>/skills/*/SKILL.md (plugin terpasang)

Tepi graf:
  - [[nama]] di badan memory          -> tautan antarmemory (tak ketemu = simpul "hantu")
  - nama berkas memory lain disebut    -> sebutan
  - nama skill disebut di memory       -> memakai skill
  - berkas references/ milik skill     -> bagian skill

Pemakaian: brain-data [--out /usr/share/nginx/html/brain/data.json]
"""
import argparse
import json
import os
import re
import sys
import tempfile
import time
from pathlib import Path

CLAUDE = Path(os.environ.get("CLAUDE_HOME", "/root/.claude"))
OUT = "/usr/share/nginx/html/brain/data.json"
BODY_MAX = 6000

# Token/kunci yang kebetulan tertulis di memory tidak ikut tampil di halaman.
RAHASIA = [
    re.compile(r"\b\d{8,10}:[A-Za-z0-9_-]{30,}\b"),            # token bot Telegram
    re.compile(r"\b(sk|pk|rk)-[A-Za-z0-9_-]{16,}\b"),           # kunci API gaya sk-...
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{20,}\b"),               # token GitHub
    re.compile(r"\b[A-Fa-f0-9]{32,}\b"),                          # hex panjang
    re.compile(r"(?i)((?:pass(?:word)?|sandi|kata sandi|token|secret|api[_ -]?key)\s*[:=]\s*)\S+"),
]


DOMAIN_RE = re.compile(r"\b((?:[a-z0-9-]+\.)+(?:com|net|org|id|co|io|asia|studio|biz|info|my\.id|co\.id|or\.id|ac\.id|sch\.id|web\.id))\b")
# Domain infrastruktur/alat, bukan proyek klien
BUKAN_PROYEK = ("velocitydeveloper.co", "velocitydeveloper.com", "velocitydeveloper.net", "velocitygrafis.com",
                "pckantor.my.id", "github.com", "google.com", "claude.ai", "anthropic.com", "pexels.com",
                "metabox.io", "wordpress.org", "wordpress.com", "cloudflare.com", "jsdelivr.net")


def sensor(teks):
    for pola in RAHASIA:
        if pola.groups:
            teks = pola.sub(lambda m: m.group(1) + "[disensor]", teks)
        else:
            teks = pola.sub("[disensor]", teks)
    return teks


def frontmatter(teks):
    """Parser YAML seadanya: cukup untuk name/description/type/metadata.type."""
    if not teks.startswith("---"):
        return {}, teks
    akhir = teks.find("\n---", 3)
    if akhir < 0:
        return {}, teks
    kepala, badan = teks[3:akhir], teks[akhir + 4:].lstrip("\n")
    data = {}
    for baris in kepala.splitlines():
        m = re.match(r"^(\s*)([A-Za-z_-]+):\s*(.*)$", baris)
        if not m:
            continue
        kunci, nilai = m.group(2), m.group(3).strip()
        if len(nilai) >= 2 and nilai[0] == nilai[-1] and nilai[0] in "\"'":
            nilai = nilai[1:-1]
        # metadata.type menang atas type level atas bila keduanya ada
        if kunci in data and not m.group(1):
            continue
        data[kunci] = nilai
    return data, badan


def mtime(p):
    try:
        return int(p.stat().st_mtime)
    except OSError:
        return 0


def normal(s):
    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")


def kumpul_memory():
    hasil = []
    for d in sorted(CLAUDE.glob("projects/*/memory")):
        proyek = d.parent.name
        for f in sorted(d.glob("*.md")):
            if f.name == "MEMORY.md":
                continue
            try:
                teks = f.read_text(errors="replace")
            except OSError:
                continue
            fm, badan = frontmatter(teks)
            tipe = fm.get("type") or "lain"
            if tipe not in ("user", "feedback", "project", "reference"):
                tipe = "lain"
            nama = fm.get("name") or f.stem
            hasil.append({
                "id": f"m:{proyek}/{f.stem}",
                "kind": "memory",
                "group": tipe,
                "label": nama,
                "file": f.name,
                "project": proyek,
                "desc": sensor(fm.get("description", "")),
                "body": sensor(badan[:BODY_MAX]) + ("\n…" if len(badan) > BODY_MAX else ""),
                "updated": mtime(f),
                "size": len(teks),
                "_raw": badan,
                "_keys": {normal(nama), normal(f.stem), normal(re.sub(r"^(project|feedback|user|reference)_", "", f.stem))},
            })
    return hasil


def kumpul_skill():
    hasil = []

    def tambah(skill_md, sumber, grup):
        try:
            teks = skill_md.read_text(errors="replace")
        except OSError:
            return
        fm, badan = frontmatter(teks)
        nama = fm.get("name") or skill_md.parent.name
        sid = f"s:{grup}/{nama}"
        # Hanya dokumen .md yang jadi simpul; berkas lain (skrip, skema) cukup dihitung
        refs, lain = [], 0
        for r in sorted(skill_md.parent.rglob("*")):
            if not r.is_file() or r.name == "SKILL.md" or "node_modules" in r.parts:
                continue
            if r.suffix == ".md":
                refs.append({"name": str(r.relative_to(skill_md.parent)), "size": r.stat().st_size, "updated": mtime(r)})
            else:
                lain += 1
        hasil.append({
            "id": sid,
            "kind": "skill",
            "group": grup,
            "label": nama,
            "source": sumber,
            "desc": sensor(fm.get("description", "")),
            "body": sensor(badan[:BODY_MAX]) + ("\n…" if len(badan) > BODY_MAX else ""),
            "updated": mtime(skill_md),
            "size": len(teks),
            "refs": refs,
            "files": lain,
        })

    for f in sorted(CLAUDE.glob("skills/*/SKILL.md")):
        tambah(f, "pribadi (~/.claude/skills)", "pribadi")
    for f in sorted(CLAUDE.glob("skills/synced/*/*/SKILL.md")):
        tambah(f, "tersinkron dari claude.ai", "claude.ai")
    # Plugin: ambil versi terbaru per plugin saja
    for plugin in sorted(CLAUDE.glob("plugins/cache/*/*")):
        versi = sorted([v for v in plugin.iterdir() if v.is_dir()], key=mtime)
        if not versi:
            continue
        for f in sorted(versi[-1].glob("skills/*/SKILL.md")):
            tambah(f, f"plugin {plugin.name} {versi[-1].name}", f"plugin:{plugin.name}")
    return hasil


def bangun():
    memori = kumpul_memory()
    skill = kumpul_skill()
    nodes, links = [], []

    nodes.append({"id": "core", "kind": "core", "label": "Claude", "group": "core"})
    nodes.append({"id": "hub:memory", "kind": "hub", "label": "Memory", "group": "memory"})
    nodes.append({"id": "hub:skill", "kind": "hub", "label": "Skills", "group": "skill"})
    links += [{"source": "core", "target": "hub:memory", "kind": "struktur"},
              {"source": "core", "target": "hub:skill", "kind": "struktur"}]

    for tipe in sorted({m["group"] for m in memori}):
        nodes.append({"id": f"hub:m:{tipe}", "kind": "hub", "label": tipe, "group": tipe})
        links.append({"source": "hub:memory", "target": f"hub:m:{tipe}", "kind": "struktur"})
    for grup in sorted({s["group"] for s in skill}):
        nodes.append({"id": f"hub:s:{grup}", "kind": "hub", "label": grup, "group": "skill"})
        links.append({"source": "hub:skill", "target": f"hub:s:{grup}", "kind": "struktur"})

    kunci_ke_id = {}
    for m in memori:
        for k in m["_keys"]:
            kunci_ke_id.setdefault(k, m["id"])
    berkas_ke_id = {m["file"]: m["id"] for m in memori}

    # Nama skill yang aman dicari di teks bebas: mengandung tanda hubung,
    # atau disebut sebagai skill ("skill pdf", "/pdf", "skills/pdf").
    pola_skill = []
    for s in skill:
        n = re.escape(s["label"])
        if "-" in s["label"] and len(s["label"]) >= 5:
            pola = rf"(?<![\w-]){n}(?![\w-])"
        else:
            pola = rf"(?:skills?/|skill\s+`?|(?<![\w/.])/){n}(?![\w-])"
        pola_skill.append((re.compile(pola, re.I), s["id"]))

    hantu = {}
    sudah = set()

    def sambung(a, b, jenis):
        kunci = (min(a, b), max(a, b), jenis)
        if a != b and kunci not in sudah:
            sudah.add(kunci)
            links.append({"source": a, "target": b, "kind": jenis})

    for m in memori:
        raw = m.pop("_raw")
        m.pop("_keys")
        links.append({"source": f"hub:m:{m['group']}", "target": m["id"], "kind": "struktur"})
        for t in re.findall(r"\[\[([^\]|#]+)", raw):
            if not re.search(r"[A-Za-z0-9]", t):
                continue
            tid = kunci_ke_id.get(normal(t))
            if not tid:
                gid = f"g:{normal(t)}"
                if gid not in hantu:
                    hantu[gid] = {"id": gid, "kind": "ghost", "label": t.strip(), "group": "hantu",
                                  "desc": "Disebut dengan [[...]] tapi memory-nya belum ditulis."}
                tid = gid
            sambung(m["id"], tid, "tautan")
        for berkas in re.findall(r"\b((?:project|feedback|user|reference)_[\w-]+\.md)\b", raw):
            if berkas in berkas_ke_id:
                sambung(m["id"], berkas_ke_id[berkas], "sebutan")
        for pola, sid in pola_skill:
            if pola.search(raw):
                sambung(m["id"], sid, "memakai")

    for s in skill:
        links.append({"source": f"hub:s:{s['group']}", "target": s["id"], "kind": "struktur"})
        for r in s["refs"]:
            rid = f"r:{s['id']}/{r['name']}"
            nodes.append({"id": rid, "kind": "ref", "label": r["name"], "group": "ref",
                          "desc": f"Berkas pendukung skill {s['label']}", "updated": r["updated"], "size": r["size"]})
            links.append({"source": s["id"], "target": rid, "kind": "bagian"})

    # Proyek/domain klien: domain di judul indeks MEMORY.md = proyek memory itu;
    # memory lain yang menyebut domain yang sama ikut disambungkan.
    proyek = {}
    for idx in CLAUDE.glob("projects/*/memory/MEMORY.md"):
        try:
            baris = idx.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for b in baris:
            m = re.match(r"\s*-\s*\[([^\]]+)\]\(([^)]+\.md)\)", b)
            if not m:
                continue
            mid = f"m:{idx.parent.parent.name}/{Path(m.group(2)).stem}"
            for dm in DOMAIN_RE.findall(m.group(1).lower()):
                if any(dm == x or dm.endswith("." + x) for x in BUKAN_PROYEK):
                    continue
                pr = proyek.setdefault(dm, {"id": f"p:{dm}", "kind": "proyek", "group": "proyek", "label": dm, "memory": []})
                if mid in {x["id"] for x in memori}:
                    pr["memory"].append(mid)
    if proyek:
        nodes.append({"id": "hub:proyek", "kind": "hub", "label": "Proyek", "group": "proyek"})
        links.append({"source": "core", "target": "hub:proyek", "kind": "struktur"})
    pola_dom = {dm: re.compile(r"(?<![\w.-])" + re.escape(dm) + r"(?![\w-])", re.I) for dm in proyek}
    teks_mem = {m["id"]: (m["desc"] + "\n" + m["body"]) for m in memori}
    for dm, pr in proyek.items():
        links.append({"source": "hub:proyek", "target": pr["id"], "kind": "struktur"})
        utama = set(pr["memory"])
        for mid in utama:
            sambung(pr["id"], mid, "tentang")
        for mid, teks in teks_mem.items():
            if mid not in utama and pola_dom[dm].search(teks):
                sambung(pr["id"], mid, "sebutan")
        pr["desc"] = f"Proyek/domain klien. {len(utama)} memory utama."
        del pr["memory"]

    nodes += memori + skill + list(hantu.values()) + list(proyek.values())
    return {
        "generated": int(time.time()),
        "counts": {
            "memory": len(memori),
            "skill": len(skill),
            "ref": sum(len(s["refs"]) for s in skill),
            "ghost": len(hantu),
            "proyek": len(proyek),
            "links": len([l for l in links if l["kind"] != "struktur"]),
        },
        "nodes": nodes,
        "links": links,
    }


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=OUT)
    a = ap.parse_args()
    data = bangun()
    out = Path(a.out)
    out.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=out.parent, prefix=".data-")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, ensure_ascii=False, separators=(",", ":"))
    os.chmod(tmp, 0o644)
    os.replace(tmp, out)
    c = data["counts"]
    print(f"brain-data: memory={c['memory']} skill={c['skill']} ref={c['ref']} hantu={c['ghost']} tepi={c['links']} -> {out}")


if __name__ == "__main__":
    sys.exit(main())
