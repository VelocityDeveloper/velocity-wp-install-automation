#!/usr/bin/env bash
# Salin folder project dari Google Drive "On Progress" ke /home/On Progress.
#
# Disalin BERKALA selama project masih berjalan, bukan sekali saat masuk antrean:
# klien kerap menambah berkas di Drive sesudah project diambil alih (permintaan
# user 2026-09-16). Dulu saringannya hanya status "belum diambil", jadi begitu
# autopilot mengklaim sebuah domain, foldernya berhenti disinkron dan tambahan
# data dari klien tidak pernah sampai ke server.
#
# Yang disalin sekarang: semua baris di daftar installer, KECUALI
#   - status RUNNING — jangan mengubah data sumber di tengah instalasi berjalan;
#     ikut lagi di putaran berikutnya (10 menit) begitu run-nya selesai.
#   - "belum diambil" yang deadline-nya lewat lebih dari AUTOPILOT_DEADLINE_GRACE_DAYS
#     — antrean basi yang tidak akan dikerjakan autopilot.
# Project yang sudah terpasang penuh (SUCCESS/COMPLETE) tidak muncul di daftar,
# jadi dengan sendirinya berhenti disinkron. Drive berisi ±10 ribu folder (puluhan
# GiB) yang tidak dibutuhkan installer, jadi tetap tidak ada sync penuh
# (keputusan user 2026-09-11): saringan ini ~33 folder, bukan 10 ribu.
#
# Selalu `rclone copy`, bukan `sync`: file lokal tidak pernah dihapus, dan remote
# gdrive memang read-only. Menyalin ulang folder yang sudah ada murah — rclone
# hanya memindahkan berkas yang baru atau berubah.
set -Eeuo pipefail

REMOTE='gdrive:On Progress'
DEST='/home/On Progress'
API=${INSTALLER_API:-http://127.0.0.1:9121}/api/installer

list=$(curl -fsS -m 180 "$API" | python3 -c '
import datetime, json, os, re, sys
ok = re.compile(r"^[a-z0-9.-]+\.[a-z]{2,}$")
today = datetime.date.today()
grace = datetime.timedelta(days=int(os.environ.get("AUTOPILOT_DEADLINE_GRACE_DAYS", "10")))
for r in json.load(sys.stdin).get("domains", []):
    status = r.get("status")
    if status == "RUNNING":
        continue
    if status == "belum diambil" and r.get("deadline"):
        # Tanpa deadline tidak dianggap terlewat, sama seperti halaman installer.
        try:
            telat = today - datetime.date.fromisoformat(r["deadline"])
        except ValueError:
            telat = datetime.timedelta(0)
        if telat > grace:
            continue
    d = str(r.get("domain") or "").lower()
    if ok.match(d) and ".." not in d:
        print(d)') || { echo "onprogress-sync: API installer tidak bisa diakses" >&2; exit 1; }

synced=0 missing=0 failed=0
for d in $list; do
  if out=$(rclone copy "$REMOTE/$d" "$DEST/$d" --retries 1 --log-level NOTICE 2>&1); then
    synced=$((synced + 1))
  else
    rc=$?
    # rc 3 = folder tidak ada di Drive; rclone tidak membuat folder lokal
    # kosong, jadi installer tidak akan mengira folder klien sudah ada.
    if [[ $rc -eq 3 ]]; then
      missing=$((missing + 1))
    else
      failed=$((failed + 1))
      printf 'onprogress-sync: %s gagal (rc=%s): %s\n' "$d" "$rc" "$(tail -1 <<<"$out")" >&2
    fi
  fi
done
printf 'onprogress-sync: tersinkron=%s tidak_ada_di_drive=%s gagal=%s\n' "$synced" "$missing" "$failed"
[[ $failed -eq 0 ]]
