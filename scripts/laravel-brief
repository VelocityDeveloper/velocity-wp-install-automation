def opsi_pilihan(slug):
    saran = L.baca_json(L.folder(slug) / 'saran.json', None) or {}
    pilihan = saran.get('pilihan') or {}
    o = next((o for o in saran.get('opsi') or [] if o.get('kunci') == pilihan.get('kunci')), {})
    return pilihan.get('jalur'), o.get('nama') or pilihan.get('jalur'), o.get('stack') or '-'


def platform_diagram(slug):
    """Paragraf pembuka prompt diagram: Laravel + Vue (bawaan & project lama) atau platform lain pilihan PM."""
    if L.jalur_laravel(slug):
        return DIAGRAM_LARAVEL
    jalur, nama, stack = opsi_pilihan(slug)
    return DIAGRAM_LAIN.format(nama=nama, stack=stack, cara=CARA_DIAGRAM.get(jalur, CARA_DIAGRAM['lainnya']))


def platform_susun(slug):
    """Paragraf platform untuk prompt susun: Laravel + Vue (bawaan & project lama) atau platform lain pilihan PM."""
    if L.jalur_laravel(slug):
        return PLATFORM_LARAVEL
    jalur, nama, stack = opsi_pilihan(slug)
    return PLATFORM_LAIN.format(nama=nama, stack=stack, cara=CARA_PLATFORM.get(jalur, CARA_PLATFORM['lainnya']))


