def ganti_estimasi(slug):
    """Placeholder prompt estimasi sesuai platform pilihan PM."""
    if L.jalur_laravel(slug):
        return {**ESTIMASI_LARAVEL, '{{JAM_AGEN}}': 'perkiraan waktu kerja agen (menulis kode + tes), angka desimal jam. '
                + teks_kalibrasi()}
    jalur, nama, stack = opsi_pilihan(slug)
    kunci = jalur if jalur in CARA_ESTIMASI else 'lainnya'
    return {
        '{{PLATFORM}}': ESTIMASI_LAIN.format(nama=nama, stack=stack, cara=CARA_ESTIMASI[kunci]),
        '{{FONDASI}}': FONDASI_LAIN[kunci],
        '{{UKURAN}}': 'cukup kecil untuk dikerjakan & diperiksa webmaster dalam satu kali kerja (±0,5–6 jam)',
        '{{UJI}}': 'dicek webmaster di browser, desktop & HP',
        '{{JAM_AGEN}}': 'SELALU 0 — tidak ada agen otomatis untuk platform ini (berlaku juga untuk `tambahan`).',
        '{{JAM_WEBMASTER}}': 'perkiraan waktu webmaster MENGERJAKAN fitur ini sampai jadi (pasang/atur plugin, kode custom '
                             'bila perlu, isi contoh, cek di browser & HP), angka desimal jam, realistis untuk webmaster '
                             'berpengalaman.',
        '{{DESKRIPSI}}': 'apa yang dibangun (halaman, jenis konten/field, plugin & pengaturannya, aturan bisnis), cukup '
                         'jelas untuk webmaster.',
    }


def teks_kalibrasi():
    """Data nyata lama kerja agen (L.kalibrasi_agen) supaya jam_agen tidak ditebak terlalu besar (dulu 8–17x)."""
    k = L.kalibrasi_agen()
    if not k:
        return 'Agen Claude Code bekerja cepat: fitur CRUD biasa ±10 menit (0,15 jam), fondasi/fitur besar ±20–30 menit.'
    return (f"DATA NYATA agen tim ({k['fitur']} fitur selesai, termasuk perbaikan & revisi): median {k['menit_median']:g} "
            f"menit per fitur, 90% fitur ≤ {k['menit_p90']:g} menit. Isi jam_agen dalam skala ini (mis. 0,15 jam untuk "
            f"CRUD sederhana, 0,3–0,5 jam untuk fondasi atau fitur dengan banyak aturan bisnis) — JANGAN jam-an seperti "
            f"estimasi programmer manusia.")


