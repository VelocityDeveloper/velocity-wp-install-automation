    'page_builder': 'PM menandai **Page builder** (WAJIB): klien menyusun halaman sendiri (membuat halaman baru, menambah/'
                    'mengurutkan seksi, mengedit teks & gambar) seperti project expedisi-vd: `@myissue/vue-website-page-'
                    'builder` di editor admin layar penuh, HTML disanitasi di server (symfony/html-sanitizer), pustaka '
                    'blok/seksi siap pakai sesuai DESIGN.md, media library, halaman publik dirender server (Blade) agar '
                    'SEO baik. Jadikan fitur tersendiri (boleh dipecah: editor & blok, halaman & menu, media) dengan '
                    'estimasi yang realistis besar.',
}


def teks_konten(p):
    mode = (p.get('konten') or {}).get('mode')
    if mode in KONTEN_TEKS:
        return ('## Kebutuhan konten halaman (ditandai PM)\n\n' + KONTEN_TEKS[mode]
                + ' Bila platform WordPress, abaikan bagian teknis ini (editor WordPress sudah memenuhinya).')
    return ('## Kebutuhan konten halaman\n\nPM belum menandai apakah klien perlu mengubah isi halaman sendiri. Jangan '
            'menambah fitur pengelolaan konten kecuali catatan klien memintanya; bila catatan mengisyaratkan klien ingin '
            'mengubah teks/halaman sendiri, tulis di Pertanyaan terbuka (statis / konten bersekat / page builder).')


def prompt_untuk(slug, jenis, p):
    t = (TEMPLATE / f'brief-{jenis}.md').read_text()
    if jenis == 'diagram':
        t = t.replace('{{PLATFORM}}', platform_diagram(slug))
    ganti = {'{{JUDUL}}': p.get('judul', ''), '{{KLIEN}}': p.get('klien') or '-', '{{DOMAIN}}': p.get('domain') or '-'}
    # Dokumen unggahan klien (dokumen/) ikut sebagai bahan di samping catatan diskusi
    catatan = (L.baca_teks(slug, 'catatan.md').strip() or '(PM tidak menulis catatan; pakai dokumen klien di bawah)') \
        + L.bahan_dok(slug)[0]
    if jenis == 'saran':
        ganti['{{CATATAN}}'] = catatan
    elif jenis == 'rangkuman':
        saran = L.baca_json(L.folder(slug) / 'saran.json', None) or {}
        o = next((o for o in saran.get('opsi') or [] if o.get('kunci') == (saran.get('pilihan') or {}).get('kunci')), None)
        ganti.update({'{{CATATAN}}': catatan,
                      '{{PLATFORM}}': f"{o['nama']} ({o['stack']})" if o else 'belum dipilih'})
    elif jenis == 'contoh':
        spek = []
        for nama, batas in (('DESIGN.md', 30_000), ('PRD.md', 40_000)):
            isi = L.baca_teks(slug, nama).strip()
            if isi:
                spek.append(f'<{nama}>\n{isi[:batas]}\n</{nama}>')
        r = L.baca_json(L.folder(slug) / 'rangkuman.json', None)
        if r and not spek:
            r = {k: v for k, v in r.items() if k not in ('belum_jelas', 'waktu', 'model')}
            spek.append('<rangkuman_konsep>\n' + json.dumps(r, ensure_ascii=False, indent=1) + '\n</rangkuman_konsep>')
        arahan = (p.get('contoh_arahan') or '').strip()
        aset = L.aset_contoh(slug)
        if L.platform_contoh(slug) == 'wordpress':
            ganti.update({
                '{{JUMLAH_HALAMAN}}': '1 halaman, yaitu **beranda (landing page) situs WordPress**',
                '{{PLATFORM}}': 'WordPress (situs company profile / toko / layanan, bukan aplikasi ber-login)',
                '{{HALAMAN}}': HALAMAN_WP, '{{KELUARAN_DASHBOARD}}': 'string kosong "" (situs WordPress tanpa dashboard).',
            })
        else:
            ganti.update({
                '{{JUMLAH_HALAMAN}}': '2 halaman, yaitu **Landing page** (halaman depan) dan **Dashboard** (halaman utama '
                                      'sesudah login)',
                '{{PLATFORM}}': 'Aplikasi custom Laravel + Vue (Inertia, shadcn-vue)',
                '{{HALAMAN}}': HALAMAN_LARAVEL.replace('{{GAYA_DASHBOARD}}', (TEMPLATE / 'gaya-dashboard-vd.md').read_text()),
                '{{KELUARAN_DASHBOARD}}': 'isi berkas HTML lengkap dashboard.',
            })
        ganti.update({
            '{{CATATAN}}': catatan,
            '{{SPESIFIKASI}}': ('Spesifikasi yang sudah disusun PM (utamakan ini bila berbeda dengan catatan):\n\n'
                                + '\n\n'.join(spek)) if spek else '(Belum ada DESIGN.md/PRD.md: simpulkan dari bahan di atas.)',
            '{{ARAHAN}}': f'## Arahan tambahan dari PM (WAJIB diikuti)\n\n{arahan}' if arahan else '',
            '{{TANGGAL}}': datetime.now().strftime('%d-%m-%Y'),
            '{{ANTISLOP_UI}}': (TEMPLATE / 'antislop-ui.md').read_text().strip(),
            '{{ASET}}': '\n'.join(f'  - `{tujuan}` = dokumen klien "{asal}"' for asal, tujuan in aset)
                        or '  - (tidak ada gambar klien; pakai logo teks/SVG buatan sendiri)',
        })
    elif jenis == 'susun':
        lama_prd, lama_design = L.baca_teks(slug, 'PRD.md').strip(), L.baca_teks(slug, 'DESIGN.md').strip()
        lama = ''
        if lama_prd or lama_design:
            lama = ('Sudah ada draf sebelumnya (mungkin sudah disunting PM). PERTAHANKAN suntingan PM, perbarui hanya '
                    'bagian yang berubah karena catatan baru.\n\n'
                    f'<prd_lama>\n{lama_prd}\n</prd_lama>\n\n<design_lama>\n{lama_design}\n</design_lama>')
        ganti.update({'{{CATATAN}}': catatan, '{{DOKUMEN_LAMA}}': lama, '{{PLATFORM}}': platform_susun(slug),
                      '{{CONTOH_DESIGN}}': (TEMPLATE / 'contoh-DESIGN.md').read_text()})
    elif jenis == 'diagram':
        lama_db, lama_flow = L.baca_teks(slug, 'DATABASE.md').strip(), L.baca_teks(slug, 'FLOWCHART.md').strip()
        lama = ''
        if lama_db or lama_flow:
            lama = ('Sudah ada versi sebelumnya (mungkin sudah disunting PM). PERTAHANKAN suntingan PM, perbarui hanya yang '
                    'berubah karena PRD.\n\n'
                    f'<database_lama>\n{lama_db}\n</database_lama>\n\n<flowchart_lama>\n{lama_flow}\n</flowchart_lama>')
        ganti.update({'{{PRD}}': L.baca_teks(slug, 'PRD.md'), '{{DOKUMEN_LAMA}}': lama})
    else:
        est = ganti_estimasi(slug)
        t = t.replace('{{PLATFORM}}', est.pop('{{PLATFORM}}'))  # lebih dulu: paragraf platform lain memuat {{JUDUL}}
        ganti.update({**est, '{{PRD}}': L.baca_teks(slug, 'PRD.md'), '{{DESIGN}}': L.baca_teks(slug, 'DESIGN.md'),
                      '{{DATABASE}}': L.baca_teks(slug, 'DATABASE.md') or '(belum ada)'})
    ganti['{{KONTEN}}'] = teks_konten(p)
    ganti['{{CAKUPAN}}'] = CAKUPAN
    for k, v in ganti.items():
        t = t.replace(k, v)
    return t


# Pita kecil di pojok: klien tahu ini pratinjau berisi data fiktif (bisa ditutup)
PITA = ('<div id="vd-pita" style="position:fixed;left:12px;bottom:12px;z-index:2147483647;display:flex;align-items:center;'
        'gap:8px;padding:6px 8px 6px 12px;border-radius:999px;background:rgba(15,23,42,.88);color:#fff;'
        'font:500 12px/1.2 system-ui,sans-serif;box-shadow:0 4px 14px rgba(0,0,0,.25)">Pratinjau desain · data contoh'
        '<button type="button" aria-label="Tutup" onclick="this.parentNode.remove()" style="border:0;background:none;'
        'color:#fff;font:16px/1 system-ui;cursor:pointer;padding:0 4px">&times;</button></div>')


def rapikan_html(html):
    html = html.strip()
    if '<head' in html.lower() and 'name="robots"' not in html:
        i = html.lower().index('<head')
        j = html.index('>', i) + 1
        html = html[:j] + '\n<meta name="robots" content="noindex, nofollow">' + html[j:]
    k = html.lower().rfind('</body>')
    html = html[:k] + PITA + '\n' + html[k:] if k >= 0 else html + PITA
    return html + '\n'


def simpan_contoh(slug, data, opus, dari):
    d = L.folder_contoh(slug)
    if d.is_dir():
        lama = d.with_name(f"contoh.{datetime.now().strftime('%Y%m%d-%H%M%S')}.bak")
        d.rename(lama)
    (d / 'aset').mkdir(parents=True)
    platform = L.platform_contoh(slug)
    for nama, kunci in (('index.html', 'landing_html'), ('dashboard.html', 'dashboard_html')):
        # WordPress: hanya beranda; dashboard dibuang walau Claude tetap mengisinya
        if data.get(kunci, '').strip() and (nama == 'index.html' or platform == 'laravel'):
            (d / nama).write_text(rapikan_html(data[kunci]))
    dipakai = set(data.get('aset') or [])
    teks = data['landing_html'] + data['dashboard_html']
    for asal, tujuan in L.aset_contoh(slug):
        if tujuan in dipakai or tujuan in teks:
            shutil.copy2(L.folder_dok(slug) / asal, d / tujuan)
    L.tulis_json(L.folder(slug) / 'contoh.json', {
        'nama_aplikasi': data['nama_aplikasi'], 'platform': platform, 'catatan': [str(c) for c in data.get('catatan') or []],
        'aset': sorted(x.name for x in (d / 'aset').iterdir()), 'waktu': L.sekarang(), 'model': opus,
        'arahan': (L.baca_json(L.folder(slug) / 'proyek.json', {}) or {}).get('contoh_arahan') or '',
        'brief_versi': dari,
    })


def catat_pemakaian(DC, slug, jenis, hasil):
    for model, u in (hasil.get('modelUsage') or {}).items():
        masuk, baca, buat = (int(u.get(k) or 0) for k in ('inputTokens', 'cacheReadInputTokens', 'cacheCreationInputTokens'))
        keluar = int(u.get('outputTokens') or 0)
        baris = {
            'ts': datetime.now(timezone.utc).isoformat(timespec='seconds'), 'domain': slug,
            'run': f'laravel-brief-{slug}', 'mode': jenis, 'peran': 'laravel_brief', 'script': 'laravel-brief',
            'sumber': 'claude', 'model_id': 'claude-code', 'model': model, 'permintaan': 1,
            'prompt_tokens': masuk + baca + buat, 'completion_tokens': keluar, 'total_tokens': masuk + baca + buat + keluar,
            'input_tokens': masuk, 'cache_read_tokens': baca, 'cache_creation_tokens': buat,
            'biaya_usd': round(float(u.get('costUSD') or 0), 4), 'ok': not hasil.get('is_error'),
            'giliran': hasil.get('num_turns'),
        }
        try:
            with open(DC.AI_USAGE, 'a') as f:
                fcntl.flock(f, fcntl.LOCK_EX)
                f.write(json.dumps(baris, ensure_ascii=False) + '\n')
        except OSError:
            pass


def main():
    if len(sys.argv) != 3 or sys.argv[2] not in SKEMA or not L.ID_RE.match(sys.argv[1]):
        print(__doc__)
        return 2
    slug, jenis = sys.argv[1], sys.argv[2]
    p = L.baca_json(L.folder(slug) / 'proyek.json', {})
    if not p:
        log('project tidak ada')
        return 1
    DC = muat('desain_claude', HERE / 'desain-claude')
    env = {k: v for k, v in os.environ.items() if k != 'ANTHROPIC_DEFAULT_OPUS_MODEL'}
    if DC.KUNCI_API.is_file() and DC.KUNCI_API.read_text().strip():
        env['ANTHROPIC_API_KEY'] = DC.KUNCI_API.read_text().strip()
    opus = DC.opus_terbaru(env)
    env.update(ANTHROPIC_DEFAULT_HAIKU_MODEL=opus, ANTHROPIC_DEFAULT_SONNET_MODEL=opus, ANTHROPIC_SMALL_FAST_MODEL=opus)
    prd_lama = L.baca_teks(slug, 'PRD.md').strip()
    if jenis == 'contoh' and os.environ.get('CONTOH_MODE') == 'revisi':
        return revisi_contoh(DC, env, opus, slug, p, os.environ.get('CONTOH_HALAMAN') or 'semua')
    kode = jalankan(DC, env, opus, slug, jenis, p)
    if kode == 0 and jenis == 'susun':
        log('')
        # Hemat token: diagram disusun ulang hanya bila struktur PRD (peran, data, alur) berubah
        alasan = lewati_diagram(slug, prd_lama)
        if alasan:
            log(f'Relasi database & flowchart TIDAK disusun ulang: {alasan}. Tombol "Susun ulang relasi & flowchart" tetap tersedia.')
            L.catat(slug, 'Claude', f'melewati penyusunan ulang diagram ({alasan})')
        else:
            kode = jalankan(DC, env, opus, slug, 'diagram', p)
    return kode


def lewati_diagram(slug, prd_lama):
    """Alasan melewati diagram sesudah susun, atau '' bila diagram perlu disusun (ulang)."""
    if not (L.baca_teks(slug, 'DATABASE.md').strip() and L.baca_teks(slug, 'FLOWCHART.md').strip()):
        return ''
    if L.baca_teks(slug, 'PRD.md').strip() == prd_lama:
        return 'PRD tidak berubah'
    if (L.baca_json(L.folder(slug) / 'proyek.json', {}) or {}).get('susun_diagram_ulang') is False:
        return 'menurut Claude perubahan PRD tidak menyentuh peran, data, maupun alur proses'
    return ''


SKEMA_REVISI = {
    'type': 'object', 'required': ['catatan', 'aset'],
    'properties': {'catatan': {'type': 'array', 'items': {'type': 'string'}},
                   'aset': {'type': 'array', 'items': {'type': 'string'}}},
}


def revisi_contoh(DC, env, opus, slug, p, halaman):
    """Revisi contoh tampilan yang sudah ada: Claude menyunting HTML di salinan kerja dengan alat Edit (potongan kecil),
    bukan membuat ulang kedua halaman dari nol — keluaran jauh lebih sedikit (permintaan user 10 Okt: hemat token)."""
    asal = L.folder_contoh(slug)
    arahan = (p.get('contoh_arahan') or '').strip()
    target = [n for n in L.CONTOH_HALAMAN if (asal / n).is_file() and halaman in ('semua', n)]
    if not arahan or not target:
        log('GAGAL: revisi butuh contoh yang sudah ada dan arahan PM')
        return 1
    kerja = L.folder(slug) / 'contoh-kerja'
    shutil.rmtree(kerja, ignore_errors=True)
    shutil.copytree(asal, kerja)
    (kerja / 'aset').mkdir(exist_ok=True)
    aset = L.aset_contoh(slug)
    for nama, tujuan in aset:
        if not (kerja / tujuan).exists():
            shutil.copy2(L.folder_dok(slug) / nama, kerja / tujuan)
    sebelum = {n: (kerja / n).read_text() for n in target}
    platform = 'WordPress (beranda situs)' if L.platform_contoh(slug) == 'wordpress' else 'Laravel + Vue (landing + dashboard)'
    ganti = {'{{JUDUL}}': p.get('judul', ''), '{{KLIEN}}': p.get('klien') or '-', '{{PLATFORM}}': platform,
             '{{ARAHAN}}': arahan, '{{TANGGAL}}': datetime.now().strftime('%d-%m-%Y'),
             '{{BERKAS}}': '\n'.join(f'- `{n}` ({L.CONTOH_HALAMAN[n]}, {len(sebelum[n]) // 1024} KB)' for n in target),
             '{{ASET}}': '\n'.join(f'  - `{t}` = dokumen klien "{a}"' for a, t in aset) or '  - (tidak ada)'}
    prompt = (TEMPLATE / 'brief-contoh-revisi.md').read_text()
    for k, v in ganti.items():
        prompt = prompt.replace(k, v)
    log(f"Claude ({opus}) merevisi contoh tampilan: {', '.join(L.CONTOH_HALAMAN[n] for n in target)}.")
    log(f'Arahan: {arahan[:300]}')
    log('Mode revisi: hanya bagian yang diminta disunting (lebih cepat & hemat dari buat ulang). Biasanya 1–4 menit.')
    mulai = time.time()
    try:
        run = subprocess.run([DC.CLAUDE, '-p', '--model', 'opus', '--output-format', 'json', '--no-session-persistence',
                              '--tools', 'Read,Edit', '--permission-mode', 'acceptEdits', '--max-turns', '40',
                              '--json-schema', json.dumps(SKEMA_REVISI)],
                             input=prompt, capture_output=True, text=True, timeout=1200, env=env, cwd=str(kerja))
        hasil = json.loads(run.stdout)
    except subprocess.TimeoutExpired:
        log('GAGAL: Claude tidak selesai dalam 20 menit')
        return 1
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        log(f'GAGAL: {type(e).__name__}: {str(e)[:300]}')
        return 1
    catat_pemakaian(DC, slug, 'contoh_revisi', hasil)
    data = hasil.get('structured_output')
    if not isinstance(data, dict) or hasil.get('is_error'):
        log(f"GAGAL: {str(hasil.get('result') or 'tanpa keluaran JSON')[:400]}")
        return 1
    berubah = []
    for n in target:
        html = (kerja / n).read_text()
        if '</html>' not in html.lower():
            log(f'GAGAL: {n} rusak sesudah disunting (tanpa </html>); contoh lama tetap dipakai.')
            return 1
        if 'id="vd-pita"' not in html:
            (kerja / n).write_text(rapikan_html(html))
        if html != sebelum[n]:
            berubah.append(n)
    biaya = round(float(hasil.get('total_cost_usd') or 0), 2)
    if not berubah:
        log(f'GAGAL: Claude tidak mengubah apa pun (setara API ${biaya}). {" ".join(data.get("catatan") or [])[:400]}')
        return 1
    # Gambar klien yang tak dirujuk halaman mana pun dibuang lagi
    teks = ''.join((kerja / n).read_text() for n in L.CONTOH_HALAMAN if (kerja / n).is_file())
    for g in (kerja / 'aset').iterdir():
        if f'aset/{g.name}' not in teks:
            g.unlink()
    asal.rename(asal.with_name(f"contoh.{datetime.now().strftime('%Y%m%d-%H%M%S')}.bak"))
    kerja.rename(asal)
    info = L.baca_json(L.folder(slug) / 'contoh.json', {}) or {}
    catatan = [str(c) for c in data.get('catatan') or []]
    info.update(catatan=catatan, waktu=L.sekarang(), arahan=arahan,
                aset=sorted(x.name for x in (asal / 'aset').iterdir()),
                revisi=(info.get('revisi') or []) + [{'waktu': L.sekarang(), 'halaman': berubah, 'arahan': arahan,
                                                      'biaya_usd': biaya}])
    L.tulis_json(L.folder(slug) / 'contoh.json', info)
    log(f"SELESAI dalam {round(time.time() - mulai)} dtk (setara API ${biaya}). Diubah: "
        f"{', '.join(L.CONTOH_HALAMAN[n] for n in berubah)}.")
    for c in catatan:
        log(f'  • {c}')
    L.catat(slug, 'Claude', 'merevisi contoh tampilan (' + ', '.join(L.CONTOH_HALAMAN[n] for n in berubah) + ')')
    if L.konfig_preview():
        log('Menerbitkan ke server preview…')
        t = L.terbitkan_contoh(slug)
        log(f"Tayang: {t['url']}" if t['ok'] else f"GAGAL terbit: {t['galat']}")
    return 0


JUDUL_KERJA = {'rangkuman': 'merangkum kebutuhan klien jadi Rangkuman Website Konsep (Word)',
               'contoh': 'membuat contoh tampilan untuk dipamerkan ke klien',
               'saran': 'membandingkan platform (WordPress / Laravel+Vue / lainnya) dari catatan diskusi',
               'susun': 'menyusun DESIGN.md + PRD.md dari catatan diskusi',
               'diagram': 'menyusun relasi database (ERD) + flowchart dari PRD',
               'estimasi': 'memecah PRD jadi fitur + estimasi'}


def jalankan(DC, env, opus, slug, jenis, p):
    # Versi brief yang menjadi bahan (dibaca sebelum Claude jalan; suntingan PM selama proses = versi berikutnya)
    dari = L.versi_brief(L.baca_json(L.folder(slug) / 'proyek.json', {}))
    prompt = prompt_untuk(slug, jenis, p)
    log(f'Bahan: brief v{dari}.')
    log(f"Claude ({opus}) {JUDUL_KERJA[jenis]}…")
    log(f'Panjang bahan: {len(prompt):,} karakter. Biasanya 2–6 menit.')
    # Gambar / PDF hasil scan dibaca Claude sendiri: alat Read saja, folder kerja = folder dokumen
    # (Read di luar folder kerja ditolak otomatis pada mode -p)
    visual = L.bahan_dok(slug)[1] if jenis in ('saran', 'susun', 'rangkuman', 'contoh') else []
    if visual:
        log(f'{len(visual)} dokumen gambar/scan dibaca Claude langsung: {", ".join(visual)}')
    mulai = time.time()
    try:
        # prompt lewat stdin: sebagai argumen, bahan >128 KB ditolak kernel (Argument list too long)
        run = subprocess.run([DC.CLAUDE, '-p', '--model', 'opus', '--output-format', 'json',
                              '--no-session-persistence', '--tools', 'Read' if visual else '',
                              '--json-schema', json.dumps(SKEMA[jenis])],
                             input=prompt, capture_output=True, text=True, timeout=1500, env=env,
                             cwd=str(L.folder_dok(slug)) if visual else '/tmp')
        hasil = json.loads(run.stdout)
    except subprocess.TimeoutExpired:
        log('GAGAL: Claude tidak selesai dalam 25 menit')
        return 1
    except (OSError, subprocess.SubprocessError, ValueError) as e:
        log(f'GAGAL: {type(e).__name__}: {str(e)[:300]}')
        return 1
    catat_pemakaian(DC, slug, jenis, hasil)
    data = hasil.get('structured_output')
    if not isinstance(data, dict) or hasil.get('is_error'):
        log(f"GAGAL: {str(hasil.get('result') or 'tanpa keluaran JSON')[:400]}")
        return 1
    detik = round(time.time() - mulai)
    biaya = round(float(hasil.get('total_cost_usd') or 0), 2)

    if jenis == 'contoh':
        simpan_contoh(slug, data, opus, dari)
        dash = f", dashboard {len(data['dashboard_html']) // 1024} KB" if L.platform_contoh(slug) == 'laravel' else ' (WordPress: beranda saja)'
        log(f"SELESAI dalam {detik} dtk (setara API ${biaya}). {data['nama_aplikasi']}: landing "
            f"{len(data['landing_html']) // 1024} KB{dash}.")
        for c in data.get('catatan') or []:
            log(f'  • {c}')
        L.catat(slug, 'Claude', 'membuat contoh tampilan ' + ('landing page + dashboard' if L.platform_contoh(slug) == 'laravel'
                                                              else 'beranda situs WordPress'))
        if L.konfig_preview():
            log('Menerbitkan ke server preview…')
            t = L.terbitkan_contoh(slug)
            log(f"Tayang: {t['url']}" if t['ok'] else f"GAGAL terbit: {t['galat']}")
        else:
            log(f'Server preview belum diatur ({L.CONTOH_ENV}); contoh hanya bisa dilihat di dashboard.')
    elif jenis == 'rangkuman':
        import rangkuman_docx
        data.update(waktu=L.sekarang(), model=opus, brief_versi=dari)
        cadangkan(slug, 'rangkuman.json')
        L.tulis_json(L.folder(slug) / 'rangkuman.json', data)
        # Gambar kiriman klien ikut di bagian Desain, seperti infografis di contoh SIMONTAK
        gambar = [(L.folder_dok(slug) / x['nama'], f"Referensi dari klien: {x['nama']}") for x in L.daftar_dok(slug)
                  if Path(x['nama']).suffix.lower() in L.DOK_GAMBAR]
        rangkuman_docx.bangun(data, gambar, L.folder(slug) / 'rangkuman.docx')
        log(f"SELESAI dalam {detik} dtk (setara API ${biaya}). {data['judul']}: {len(data['peran'])} peran, "
            f"{sum(len(k['poin']) for k in data['menu'])} menu, {len(gambar)} gambar klien.")
        for c in data.get('belum_jelas') or []:
            log(f'  ? {c}')
        L.catat(slug, 'Claude', 'menyusun Rangkuman Website Konsep (Word)')
    elif jenis == 'saran':
        saran = {**L.bersihkan_saran(data, opus), 'brief_versi': dari}
        cadangkan(slug, 'saran.json')
        L.tulis_json(L.folder(slug) / 'saran.json', saran)
        log(f'SELESAI dalam {detik} dtk (setara API ${biaya}). Rekomendasi: {saran["rekomendasi"]}.')
        for o in saran['opsi']:
            log(f"  {o['skor']}/10 {o['nama']} — {o['stack']}")
        L.catat(slug, 'Claude', 'menyarankan platform: ' + next(
            (o['nama'] for o in saran['opsi'] if o['kunci'] == saran['rekomendasi']), saran['rekomendasi']))
    elif jenis == 'susun':
        for nama, kunci in (('PRD.md', 'prd_md'), ('DESIGN.md', 'design_md')):
            cadangkan(slug, nama)
            L.tulis_teks(slug, nama, data[kunci].strip() + '\n')
        catatan_pm = [str(x) for x in data.get('ringkasan_pm') or []]
        L.ubah_proyek(slug, lambda x: x.update(ringkasan_brief=catatan_pm,
                                               susun_diagram_ulang=bool(data.get('diagram_perlu_ulang', True))))
        log(f'SELESAI dalam {detik} dtk (setara API ${biaya}). PRD {len(data["prd_md"]):,} karakter, '
            f'DESIGN {len(data["design_md"]):,} karakter.')
        for c in catatan_pm:
            log(f'  • {c}')
        L.catat(slug, 'Claude', f"menyusun draf DESIGN.md + PRD.md (brief v{L.naik_versi_brief(slug, 'Claude', ['prd', 'design'])})")
    elif jenis == 'diagram':
        for nama, kunci in (('DATABASE.md', 'database_md'), ('FLOWCHART.md', 'flowchart_md')):
            cadangkan(slug, nama)
            L.tulis_teks(slug, nama, data[kunci].strip() + '\n')
        blok = sum(data[k].count('```mermaid') for k in ('database_md', 'flowchart_md'))
        log(f'SELESAI dalam {detik} dtk (setara API ${biaya}). {blok} diagram Mermaid.')
        for c in data.get('catatan') or []:
            log(f'  • {c}')
        L.ubah_proyek(slug, lambda x: x.update(catatan_diagram=[str(c) for c in data.get('catatan') or []]))
        L.catat(slug, 'Claude', f"menyusun relasi database & flowchart (brief v{L.naik_versi_brief(slug, 'Claude', ['database', 'flowchart'])})")
    else:
        if not L.jalur_laravel(slug):
            # Platform non-Laravel: tak ada agen otomatis, semua jam dipegang webmaster
            for x in data['fitur'] + (data.get('tambahan') or []):
                x['jam_agen'] = 0
        fitur = L._bersihkan_fitur(data['fitur'])
        cadangkan(slug, 'fitur.json')
        L.ubah_fitur(slug, lambda f: f.__setitem__(slice(None), fitur))
        tambahan = L.bersihkan_tambahan(data.get('tambahan') or [])
        L.ubah_proyek(slug, lambda x: x.update(tambahan=tambahan, estimasi_brief_versi=dari))
        for t in tambahan:
            log(f"  + {t['judul']} — agen {t['jam_agen']} j, webmaster {t['jam_webmaster']} j")
        cak = L.cek_cakupan(L.baca_teks(slug, 'PRD.md'), fitur)
        if cak is None:
            log('  ! PRD tanpa "Matriks peran × halaman": cakupan halaman per peran tidak bisa dicek (susun ulang PRD).')
        elif cak['kurang']:
            log(f"  ! {len(cak['kurang'])} dari {cak['sel']} akses di matriks belum masuk fitur mana pun:")
            for x in cak['kurang']:
                log(f'    - {x}')
        else:
            log(f"  Cakupan matriks: semua {cak['sel']} akses peran × halaman masuk fitur.")
        log(f'SELESAI dalam {detik} dtk (setara API ${biaya}). {len(fitur)} fitur, '
            f'agen {sum(f["jam_agen"] for f in fitur):.1f} jam, webmaster {sum(f["jam_webmaster"] for f in fitur):.1f} jam.')
        for f in fitur:
            log(f"  {f['id']} {f['judul']} — {len(f['kriteria'])} kriteria, agen {f['jam_agen']} j, webmaster {f['jam_webmaster']} j")
        L.catat(slug, 'Claude', f'memecah PRD jadi {len(fitur)} fitur')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    finally:
        if len(sys.argv) > 1 and L.ID_RE.match(sys.argv[1]):
            L.ubah_proyek(sys.argv[1], lambda p: p.pop('job', None))
